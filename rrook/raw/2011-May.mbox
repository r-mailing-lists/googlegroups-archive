generateArrayOfInputs<-
function(ncols,nrows,colNames=NULL,rowNames=NULL,variable)
{
	res<-'<form method="POST">\n<table border="1">\n'
	if(!is.null(colNames))
	{
		res<-paste(res,'<TD></TD>',sep='')
		for(j in 1:ncols)
		{
			res<-paste(res,'<TD> ',colNames[j],' </TD>',sep='')
		}
	}
	for(i in 1:nrows)
	{
		res<-paste(res,'<TR>\n',sep='')
		if(!is.null(rowNames))
		{
			res<-paste(res,'<TD> ',rowNames[i],' </TD>')
		}
		for(j in 1:ncols)
		{
			res<-
paste(res,'<TD>',eval(parse(text=paste(variable,i,j,sep='_'))),'<input
type="value" NAME="',paste(variable,i,j,sep='_'),'"/></TD>',sep='')
		}
		res<-paste(res,'</TR>\n',sep='')
	}
	res<-paste(res,'</table>\n',sep='')
	res<-paste(res,'<div><input type="submit" value="submit"></
div>',sep='')
	res<-paste(res,'</form>')

	return(res)
}

