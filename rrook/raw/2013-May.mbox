This actually works, too:

Foo <- setRefClass(
   'Foo',

   methods = list(foo = function() 'foo'),
   where = environment()

)
Bar <- setRefClass(
   'Bar',
   methods = list(
     call = function(env) {
       req <- Rook::Request$new(env)
       res <- Rook::Response$new()

       Foo <- methods::getRefClass('Foo', where = globalenv())

       foo <- Foo$new()
       res$write(foo$foo())
       res$finish()
     }

   ),
   where = environment()
)

-- Jeremy

