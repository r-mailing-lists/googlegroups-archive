#Modified facet_wrap.r code
facet_wrap <- function(facets, nrow = NULL, ncol = NULL, scales = "fixed", shrink = TRUE, labeller = "label_value", as.table = TRUE, drop = TRUE) {
  scales <- match.arg(scales, c("fixed", "free_x", "free_y", "free"))
  free <- list(
    x = any(scales %in% c("free_x", "free")),
    y = any(scales %in% c("free_y", "free"))
  )

  facet(
    facets = as.quoted(facets), free = free, shrink = shrink,
    as.table = as.table, drop = drop,
    ncol = ncol, nrow = nrow, labeller = labeller,
    subclass = "wrap"
  )

}

facet_strips.wrap <- function(facet, panel, theme) {
  labeller <- match.fun(facet$labeller)

  labels_df <- panel$layout[names(facet$facets)]
  labels_df[] <- llply(labels_df, function(df) labeller(names(df), df))

  labels <- apply(labels_df, 1, paste, collapse=", ")

  list(t = llply(labels, ggstrip, theme = theme))
}

#Example

flabels <- paste("Y[", seq_along(levels(diamonds$color)), "]", sep = "")
diamonds$flabel <- factor(diamonds$color, labels = flabels)
qplot(price, carat, data = diamonds) + facet_wrap(~flabel, ncol = 4)
qplot(price, carat, data = diamonds) + facet_wrap(~flabel, ncol = 4, labeller = label_parsed)

