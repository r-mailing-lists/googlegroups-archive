autoplot.myClass <- function(data, ..., model) {
  ## some trick on model and data
  args <- as.list(match.call(call = sys.call(sys.parent()))[-1])

  ## fortify somehow to  transform the data to data.frame
  d <- fortify(model = model, data = data)

  args <- args[!names(args) %in% c("model", "data")]
  ## somehow make fortify return a data.frame for model and data
  do.call(qplot, c(list(data = d), args))
}

