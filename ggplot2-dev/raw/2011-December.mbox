>
>  data <- geom_data(geom, data)
>
>  munched <- geom_premunch(geom, data)
>  geom <- munched$geom
>  data <- munched$data
>
>  # grob <- geom_draw(geom, data)
>  grob <- geom_draw_for_coord_polar(geom, data)

Like this:

data <- geom_data(geom, data)

premunch <- geom_premunch(geom, data)
geom <- premunch$geom
data <- premunch$data

data <- coord_munch(coord_polar(), data)
grob <- geom_draw(geom, data)

coord_polar() knows nothing about geoms - it just knows how to
transform the data.

