     1,
     "here is the code <div><div style=\"color:rgb(204,204,204);background-color:rgb(31,31,31);font-family:Consolas,&quot;Courier New&quot;,monospace;line-height:19px;white-space:pre\"><div><span style=\"color:rgb(220,220,170)\">load</span>(<span style=\"color:rgb(206,145,120)\">&#39;climate_sentiment_last_last_with_new_Columns_indices.RData&#39;</span>)</div><div><span style=\"color:rgb(220,220,170)\">ls</span>()</div><div><span style=\"color:rgb(156,220,254)\">df</span></div><div><span style=\"color:rgb(156,220,254)\">T3</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(220,220,170)\">sum</span>(<span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">NTw</span>) <span style=\"color:rgb(212,212,212)\">/</span> <span style=\"color:rgb(220,220,170)\">sum</span>(<span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">TTw</span>)</div><div><span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">E</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">TTw</span><span style=\"color:rgb(212,212,212)\">*</span><span style=\"color:rgb(156,220,254)\">T3</span></div><br><div><span style=\"color:rgb(106,153,85)\">#When we run the model for more than two years </span></div><div><span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">FID_2</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">FID</span></div><br><div><span style=\"color:rgb(106,153,85)\"># Sort data1 by year, month and week</span></div><div><span style=\"color:rgb(220,220,170)\">library</span>(<span style=\"color:rgb(156,220,254)\">dplyr</span>)</div><div><span style=\"color:rgb(156,220,254)\">df</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">df</span> <span style=\"color:rgb(212,212,212)\">%&gt;%</span> <span style=\"color:rgb(156,220,254)\">arrange</span>(<span style=\"color:rgb(156,220,254)\">year_idx</span>, <span style=\"color:rgb(156,220,254)\">month_idx</span>, <span style=\"color:rgb(156,220,254)\">week_idx</span>)</div><br><div><span style=\"color:rgb(156,220,254)\">formula1</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">NTw</span> <span style=\"color:rgb(86,156,214)\">~</span> <span style=\"color:rgb(212,212,212)\">-</span><span style=\"color:rgb(181,206,168)\">1</span> <span style=\"color:rgb(212,212,212)\">+</span> <span style=\"color:rgb(156,220,254)\">f</span>(<span style=\"color:rgb(156,220,254)\">FID</span>, <span style=\"color:rgb(156,220,254)\">model</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;iid&quot;</span>, <span style=\"color:rgb(106,153,85)\"># FID_1, random effect in time weeks</span></div><div>                               <span style=\"color:rgb(156,220,254)\">group</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">week_idx</span>,</div><div>                               <span style=\"color:rgb(156,220,254)\">control.group</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">model</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(206,145,120)\">&#39;iid&#39;</span>),</div><div>                               <span style=\"color:rgb(156,220,254)\">constr</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">FALSE</span>) <span style=\"color:rgb(212,212,212)\">+</span></div><div>                         <span style=\"color:rgb(156,220,254)\">f</span>(<span style=\"color:rgb(156,220,254)\">FID_2</span>, <span style=\"color:rgb(156,220,254)\">model</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;iid&quot;</span>, <span style=\"color:rgb(106,153,85)\"># FID_2, random effect in time years</span></div><div>                         <span style=\"color:rgb(156,220,254)\">group</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">year_idx</span>,</div><div>                         <span style=\"color:rgb(156,220,254)\">control.group</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">model</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(206,145,120)\">&#39;iid&#39;</span>),</div><div>                         <span style=\"color:rgb(156,220,254)\">constr</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">FALSE</span>)</div><br><div>      <span style=\"color:rgb(156,220,254)\">time_variable1</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(220,220,170)\">c</span>(<span style=\"color:rgb(206,145,120)\">&quot;week_idx&quot;</span>, <span style=\"color:rgb(206,145,120)\">&quot;year_idx&quot;</span>)</div><br><div><span style=\"color:rgb(220,220,170)\">library</span>(<span style=\"color:rgb(156,220,254)\">INLA</span>)</div><br><div><span style=\"color:rgb(156,220,254)\">res</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">inla</span>(<span style=\"color:rgb(156,220,254)\">formula1</span>, <span style=\"color:rgb(156,220,254)\">family</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;poisson&quot;</span>, <span style=\"color:rgb(156,220,254)\">data</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">df</span>, <span style=\"color:rgb(156,220,254)\">E</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">E</span>,</div><div>                <span style=\"color:rgb(156,220,254)\">control.predictor</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">compute</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">TRUE</span>),</div><div>                <span style=\"color:rgb(156,220,254)\">control.compute</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">config</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">TRUE</span>))</div><br><br><div><span style=\"color:rgb(156,220,254)\">res</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(220,220,170)\">summary</span>(<span style=\"color:rgb(156,220,254)\">res</span>)</div><div><span style=\"color:rgb(220,220,170)\">save</span>(<span style=\"color:rgb(156,220,254)\">res</span>, <span style=\"color:rgb(156,220,254)\">file</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;summary_data_model1.RData&quot;</span>)</div></div><br></div>"
