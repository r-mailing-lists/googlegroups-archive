 <span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">FID</span></div>\r\n<br>\r\n<div><span style=\"color:rgb(106,153,85)\"># Sort data1 by year, month and week</span></div>\r\n<div><span style=\"color:rgb(220,220,170)\">library</span>(<span style=\"color:rgb(156,220,254)\">dplyr</span>)</div>\r\n<div><span style=\"color:rgb(156,220,254)\">df</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">df</span> <span style=\"color:rgb(212,212,212)\">%&gt;%</span> <span style=\"color:rgb(156,220,254)\">arrange</span>(<span style=\"color:rgb(156,220,254)\">year_idx</span>, <span style=\"color:rgb(156,220,254)\">month_idx</span>, <span style=\"color:rgb(156,220,254)\">week_idx</span>)</div>\r\n<br>\r\n<div><span style=\"color:rgb(156,220,254)\">formula1</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">NTw</span> <span style=\"color:rgb(86,156,214)\">~</span> <span style=\"color:rgb(212,212,212)\">-</span><span style=\"color:rgb(181,206,168)\">1</span> <span style=\"color:rgb(212,212,212)\">+</span> <span style=\"color:rgb(156,220,254)\">f</span>(<span style=\"color:rgb(156,220,254)\">FID</span>, <span style=\"color:rgb(156,220,254)\">model</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;iid&quot;</span>, <span style=\"color:rgb(106,153,85)\"># FID_1, random effect in time weeks</span></div>\r\n<div>                               <span style=\"color:rgb(156,220,254)\">group</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">week_idx</span>,</div>\r\n<div>                               <span style=\"color:rgb(156,220,254)\">control.group</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">model</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(206,145,120)\">&#39;iid&#39;</span>),</div>\r\n<div>                               <span style=\"color:rgb(156,220,254)\">constr</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">FALSE</span>) <span style=\"color:rgb(212,212,212)\">+</span></div>\r\n<div>                         <span style=\"color:rgb(156,220,254)\">f</span>(<span style=\"color:rgb(156,220,254)\">FID_2</span>, <span style=\"color:rgb(156,220,254)\">model</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;iid&quot;</span>, <span style=\"color:rgb(106,153,85)\"># FID_2, random effect in time years</span></div>\r\n<div>                         <span style=\"color:rgb(156,220,254)\">group</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">year_idx</span>,</div>\r\n<div>                         <span style=\"color:rgb(156,220,254)\">control.group</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">model</span><span style=\"color:rgb(212,212,212)\">=</span><span style=\"color:rgb(206,145,120)\">&#39;iid&#39;</span>),</div>\r\n<div>                         <span style=\"color:rgb(156,220,254)\">constr</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">FALSE</span>)</div>\r\n<br>\r\n<div>      <span style=\"color:rgb(156,220,254)\">time_variable1</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(220,220,170)\">c</span>(<span style=\"color:rgb(206,145,120)\">&quot;week_idx&quot;</span>, <span style=\"color:rgb(206,145,120)\">&quot;year_idx&quot;</span>)</div>\r\n<br>\r\n<div><span style=\"color:rgb(220,220,170)\">library</span>(<span style=\"color:rgb(156,220,254)\">INLA</span>)</div>\r\n<br>\r\n<div><span style=\"color:rgb(156,220,254)\">res</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(156,220,254)\">inla</span>(<span style=\"color:rgb(156,220,254)\">formula1</span>, <span style=\"color:rgb(156,220,254)\">family</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;poisson&quot;</span>, <span style=\"color:rgb(156,220,254)\">data</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">df</span>, <span style=\"color:rgb(156,220,254)\">E</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(156,220,254)\">df</span><span style=\"color:rgb(86,156,214)\">$</span><span style=\"color:rgb(156,220,254)\">E</span>,</div>\r\n<div>                <span style=\"color:rgb(156,220,254)\">control.predictor</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">compute</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">TRUE</span>),</div>\r\n<div>                <span style=\"color:rgb(156,220,254)\">control.compute</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">list</span>(<span style=\"color:rgb(156,220,254)\">config</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(86,156,214)\">TRUE</span>))</div>\r\n<br>\r\n<br>\r\n<div><span style=\"color:rgb(156,220,254)\">res</span> <span style=\"color:rgb(212,212,212)\">&lt;-</span> <span style=\"color:rgb(220,220,170)\">summary</span>(<span style=\"color:rgb(156,220,254)\">res</span>)</div>\r\n<div><span style=\"color:rgb(220,220,170)\">save</span>(<span style=\"color:rgb(156,220,254)\">res</span>, <span style=\"color:rgb(156,220,254)\">file</span> <span style=\"color:rgb(212,212,212)\">=</span> <span style=\"color:rgb(206,145,120)\">&quot;summary_data_model1.RData&quot;</span>)</div>\r\n</div>\r\n<br></div>\r\n<div class=\"gmail_quote\">\r\n<div dir=\"auto\" class=\"gmail_attr\">On Thursday, February 1, 2024 at 6:34:37 PM UTC+1 Helpdesk (Haavard Rue) wrote:<br></div>\r\n<blockquote class=\"gmail_quote\" style=\"margin:0 0 0 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\">I can rerun it here to check. you do not give much information...<br>\r\n<br>\r\n<br>\r\nOn Thu, 2024-02-01 at 07:46 -0800, T wrote:<br>\r\n&gt; I try to run my model for 8 years big data and every time it get<br>\r\n&gt; crushed. Do you have any tips?<br>\r\n&gt;<br>\r\n&gt; Thanks<br>\r\n&gt; --<br>\r\n&gt; You received this message because you are subscribed to the Google<br>\r\n&gt; Groups &quot;R-inla discussion group&quot; group.<br>\r\n&gt; To unsubscribe from this group and stop receiving emails from it, send<br>\r\n&gt; an email to <a rel=\"nofollow\">r-inla-discussion...@googlegroups.com</a>.<br>\r\n&gt; To view this discussion on the web, visit<br>\r\n&gt; <a href=\"https://groups.google.com/d/msgid/r-inla-discussion-group/b10bb4ea-9d99-4460-9a80-b5c86dbefbdfn%40googlegroups.com\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/r-inla-discussion-group/b10bb4ea-9d99-4460-9a80-b5c86dbefbdfn%2540googlegroups.com&amp;source=gmail&amp;ust=1792435858234000&amp;usg=AOvVaw0L733O0E-547NdSK3kRyJ6\">https://groups.google.com/d/msgid/r-inla-discussion-group/b10bb4ea-9d99-4460-9a80-b5c86dbefbdfn%40googlegroups.com</a><br>\r\n&gt; .<br>\r\n<br>\r\n--<br>\r\nHåvard Rue<br>\r\n<a rel=\"nofollow\">he...@r-inla.org</a><br></blockquote>\r\n</div>\r\n<p></p>\r\n--<br>\r\nYou received this message because you are subscribed to the Google Groups &quot;R-inla discussion group&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href data-email-masked rel=\"nofollow\">r-inla-discussion...@googlegroups.com</a>.<br></blockquote></div></div>"
