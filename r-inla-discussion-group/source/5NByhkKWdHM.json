-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\"><br></blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">m1.1.i &lt;- inla(C ~ 1 + urban + f(a.did, model=&quot;iid2d&quot;, n= 2*n.district) + f(b.did, urban, copy= &quot;a.did&quot;), data= d1.i, family = &quot;binomial&quot;, </blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">               Ntrials = 1, </blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">               control.fixed = list(</blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">                 mean= 0,</blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">                 prec= 1/(0.5^2), </blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">                 mean.intercept= 0, </blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">                 prec.intercept= 1),</blockquote>\r\n<blockquote style=\"border-left-color:rgb(26,188,156);margin:0px;padding-left:10px;border-left-width:thin;border-left-style:solid;padding-bottom:5px;padding-top:5px\">               control.family = list(control.link=list(model=&quot;logit&quot;)),</b