co,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#000\">spp</span></span><span style=\"color:rgb(0,0,0);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#000\"> </span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#660\">&lt;-</span></span><span style=\"color:rgb(0,0,0);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#000\"> </span></span><span style=\"color:rgb(0,0,0);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#606\">SpatialPoints</span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#660\">(</span></span><span style=\"color:rgb(0,0,0);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre;background-color:rgb(248,248,248)\"><span style=\"color:#000\">data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;w