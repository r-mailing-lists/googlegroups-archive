     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">2018-03-26 14:23 GMT+02:00 Tiago Marques <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">tiagoand...@gmail.com</a>&gt;</span>:<br></div></div>"
