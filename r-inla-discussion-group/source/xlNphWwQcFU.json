   "parts": [
    [
     1,
     "<p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">Dear all,</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;min-height:22px;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\"></span><br></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">I am developing a joint model with two copied spatial field. I am wondering if it is possible to specify same hyperparameters for sz0 and sz. The model form is:</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;min-height:22px;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\"></span><br></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">form &lt;- y ~ 0 + e.b0 + z.b0 + </span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">f（se0, model=spde) +</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">  f(se, model=spde, replicate=se.repl) +</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">  f(sz0, copy=“se0”, fixed=FALSE, hyper=hypercopy) +</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">  f(sz, copy=&quot;se&quot;, replicate=sz.repl, fixed=FALSE , hyper=hypercopy) </span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;min-height:22px;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\"></span><br></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">Thanks,</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\">Ruby</span></p><p style=\"margin:0px;font-stretch:normal;font-size:17px;line-height:normal;font-size-adjust:none;font-kerning:auto;font-variant-alternates:normal;font-variant-ligatures:normal;font-variant-numeric:normal;font-variant-east-asian:normal;font-feature-settings:normal;color:rgb(0,0,0)\"><span style=\"font-family:UICTFontTextStyleBody\"> </span></p>"
