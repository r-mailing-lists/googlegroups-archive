#066\">1</span><span style=\"color:#660\">)%%</span><span style=\"color:#000\">d</span><span style=\"color:#660\">+</span><span style=\"color:#066\">1</span><span style=\"color:#000\"><br>  j </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">m</span><span style=\"color:#660\">-</span><span style=\"color:#000\">i</span><span style=\"color:#660\">)/</span><span style=\"color:#000\">d</span><span style=\"color:#660\">+</span><span style=\"color:#066\">1</span><span style=\"color:#000\"><br>  </span><span style=\"color:#008\">return</span><span style=\"color:#660\">(</span><span style=\"color:#000\">cbind</span><span style=\"color:#660\">(</span><span style=\"color:#000\">i</span><span style=\"color:#660\">,</span><span style=\"color:#000\">j</span><span style=\"color:#660\">))</span></div></code></div></div></div>"
