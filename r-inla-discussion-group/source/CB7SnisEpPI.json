0\"><br>Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"> <br>  mutate</span><span style=\"color:#660\">(</span><span style=\"color:#000\">beta </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> idx2map</span><span style=\"color:#660\">(</span><span style=\"color:#000\">X</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> jdx</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> q</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>         gamma </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> idx2map</span><span style=\"color:#660\">(</span><span style=\"color:#000\">Z</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> jdx</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>         epsilon </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> idx2map</span><span style=\"color:#660\">(</span><span style=\"color:#000\">idx</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> jdx</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> n</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br><br>Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[,</span><span style=\"color:#080\">&quot;X&quot;</span><span style=\"color:#660\">]==</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;beta&quot;</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> NA<br>Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[,</span><span style=\"color:#080\">&quot;jdx&quot;</span><span style=\"color:#660\">]==</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;beta&quot;</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> NA<br>Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[,</span><span style=\"color:#080\">&quot;jdx&quot;</span><span style=\"color:#660\">]==</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;gamma&quot;</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> NA<br>Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">inla</span><span style=\"color:#660\">[,</span><span style=\"color:#080\">&quot;jdx&quot;</span><span style=\"color:#660\">]==</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;epsilon&quot;</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> NA<br><br><br>formula </span><span s