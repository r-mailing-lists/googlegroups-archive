Correction:
You need to separate X from the _Effect of X_, so you can access the
original X-values as well as X_Effect = beta*X

model_RSR3 <-   bru(~ -1 + X_Effect(X) + u(geometry, model = spde),
  formula = Y ~ X_Effect + u - X * sum(X * u) / sum(X^2),

  family = "gaussian", data = df_sf)

