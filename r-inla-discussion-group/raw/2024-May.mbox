Dear,

Thank you for your help, but that unfortunately didn't work out. How does this exactly work in relation to the Stack that is given to the INLA function? Because the poly matrix is not part of this stack, as it is produced with data coming from the stack.

N70 = nrow(strandline70)
X70 = data.frame(Intercept = rep(1, N70),

                 sanddynamics = strandline70$dyn_mean,
                 springtide = strandline70$spr_mean)

StackFit = inla.stack(tag = "Fit",
                          data = list(y = strandline70$Abundance_median),
                          A = list(A3, 1),
                          effects = list(w3.index, X70))
FIT = inla.stack(StackFit)

sanddynamics_poly2 = poly(X70$sanddynamics, 2)
colnames(sanddynamics_poly2) = c("sand1", "sand2")

springtide_poly2 = poly(X70$springtide, 2)
colnames(springtide_poly2) = c("spring1", "spring2")

#### null function
f0 = y ~ -1 + Intercept + sanddynamics_poly2 + springtide_poly2

inla0 = inla(f0,
            family = "zeroinflatedpoisson0",
            control.compute = list(waic = TRUE),
