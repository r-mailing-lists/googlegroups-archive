> > > > > fm_basis.fm_mesh_indexed <- function(x, loc, weights = NULL, ..., full = FALSE) {
> > > > >   loc_df <- as.data.frame(loc)
> > > > >   if (!all(c("x","y","mesh_id") %in% names(loc_df)))
> > > > >     stop("loc must contain 'x','y','mesh_id'")
