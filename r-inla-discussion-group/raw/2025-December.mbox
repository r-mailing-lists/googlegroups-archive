> > > > >                       crs = crs, ..., max_batch_size = max_batch_size)
> > > > >     tri[rows_k] <- bary_k$index
> > > > >     where[rows_k,] <- as.matrix(bary_k$where)
> > > > >   }
> > > > >   fm_bary(tibble(mesh_id = idx_mesh, index = tri, where = where),
> > > > >           extra_class = "fm_bary_indexed")
