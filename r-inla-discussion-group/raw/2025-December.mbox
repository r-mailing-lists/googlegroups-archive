> > > > >
> > > > >   idx <- (x > 0)
> > > > >   const <- (2^(1 - nu)) / gamma(nu)
> > > > >   Cor[idx] <- const * (x[idx]^nu) * besselK(x[idx], nu)
> > > > >
> > > > >   Sigma <- sigma2 * Cor
> > > > >
> > > > >   diag(Sigma) <- diag(Sigma) + nugget
> > > > >
> > > > >   Sigma
> > > > > }
