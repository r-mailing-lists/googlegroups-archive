> > > > > matern_cov_from_locs <- function(loc_mat, sigma2 = 1, rho = 1, nu = 1.0, nugget = 1e-8) {
> > > > >
> > > > >   D <- as.matrix(dist(loc_mat))
> > > > >
> > > > >   x <- D / rho
> > > > >
> > > > >   Cor <- matrix(0, nrow(D), ncol(D))
