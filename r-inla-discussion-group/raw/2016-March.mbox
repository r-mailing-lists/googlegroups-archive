I have figured it out. For anyone who may encounter the same challenge, say you wanted to use the Scotland map (provided in WinBUGS) in R-INLA. Open WinBUGS, go to map and slick on adjacency tool, select Scotland
map, click adj map. The Scotland map should appear. Go to map again and click on export Splus. Save the result as Scotland.txt etc document. Read the txt file in R as ken<- readSplus("C:/Users/Gem/Desktop/shpfiler/angola.txt")

Alternatively these codes may be of use too.
###############################################
# Creating a new shapefile for Angola
###############################################

library(maptools)

angola=readShapePoly("
# Reading the existing shapefile
class(angola)# Checking the class

plot(angola,axes=T)

angola@polygons[[18]]@Polygons[[1]]@coords

################################
# Extracting the regions
# so that we have 18 and not 34
#################################
region1=Polygon(angola@polygons[[1]]@Polygons[[1]]@coords)
region2=Polygon(angola@polygons[[2]]@Polygons[[1]]@coords)
region3=Polygon(angola@polygons[[3]]@Polygons[[1]]@coords)
region4=Polygon(angola@polygons[[4]]@Polygons[[1]]@coords)
region5=Polygon(angola@polygons[[5]]@Polygons[[1]]@coords)
region6=Polygon(angola@polygons[[6]]@Polygons[[1]]@coords)
region7=Polygon(angola@polygons[[7]]@Polygons[[1]]@coords)
region8=Polygon(angola@polygons[[8]]@Polygons[[1]]@coords)
region9=Polygon(angola@polygons[[9]]@Polygons[[1]]@coords)
region10=Polygon(angola@polygons[[10]]@Polygons[[1]]@coords)
region11=Polygon(angola@polygons[[11]]@Polygons[[1]]@coords)
region12=Polygon(angola@polygons[[16]]@Polygons[[1]]@coords)
region13=Polygon(angola@polygons[[17]]@Polygons[[1]]@coords)
region14=Polygon(angola@polygons[[18]]@Polygons[[1]]@coords)
region15=Polygon(angola@polygons[[19]]@Polygons[[1]]@coords)
region16=Polygon(angola@polygons[[20]]@Polygons[[1]]@coords)
region17=Polygon(angola@polygons[[22]]@Polygons[[1]]@coords)
region18=Polygon(angola@polygons[[23]]@Polygons[[1]]@coords)

#######################################
# Giving the Polygons ID
#######################################

region1 = Polygons(list(region1), ID=1)
region2 = Polygons(list(region2), ID=2)
region3 = Polygons(list(region3), ID=3)
region4 = Polygons(list(region4), ID=4)
region5 = Polygons(list(region5), ID=5)
region6 = Polygons(list(region6), ID=6)
region7 = Polygons(list(region7), ID=7)
region8 = Polygons(list(region8), ID=8)
region9 = Polygons(list(region9), ID=9)
region10 = Polygons(list(region10), ID=10)
region11 = Polygons(list(region11), ID=11)
region12 = Polygons(list(region12), ID=12)
region13 = Polygons(list(region13), ID=13)
region14 = Polygons(list(region14), ID=14)
region15 = Polygons(list(region15), ID=15)
region16 = Polygons(list(region16), ID=16)
region17 = Polygons(list(region17), ID=17)
region18 = Polygons(list(region18), ID=18)

#################################
# Create a SpatialPolygons object
#################################

crsnew=CRS("+proj=longlat +ellps=WGS84")

angolanew=SpatialPolygons(list(region1,region2,region3,region4,region5,region6,region7
,region8,region9,region10,region11,region12,region13,region14,region15,
region16,region17
,region18),1:18,proj4string=crsnew)
class(angolanew)
plot(angolanew,axes=T)

#############################################
# Create a SpatialPolygonsDataFrames object
#############################################

rnames=c("Bengo","Benguela","Bie","Cabinda","Cuanda Cubang",
"Canza Norte","Cuanza Sul","Cunene","Huambo","Huila","Luanda","Luanda Norte",
"Luanda Sul","Malanje","Moxico","Namibe","Uige","Zaire")

temp2=read.csv("temp2.csv")

temp2=data.frame(rnames,temp2)
row.names(temp2)=rnames

angola <- SpatialPolygonsDataFrame(angolanew,temp2)

plot(angolanew,axes=T)

######################################
# Creating a ESRI shapefile
######################################

library(rgdal)
drv= "ESRI Shapefile"
writeOGR(angola, dsn = ".", layer = "angola", driver = drv)
list.files(pattern = "^angola")

writeOGR(angola, dsn=".",layer = "angola", driver = drv)
list.files(pattern = "^angola")

