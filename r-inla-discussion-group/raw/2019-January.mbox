Sorry forgot to include my code:

formula.allcases = obTOT ~ 1 + f(ID, model="bym", graph="nb.sa.txt")

mod.allcases <- inla(formula.allcases, data=as.data.frame(SA), family="zeroinflatedpoisson1", E = exTOT,
                         control.predictor=list(compute=TRUE, link=1, cdf=c(0)),

                         control.compute=list(dic=TRUE, cpo=TRUE, config = TRUE), verbose=TRUE, num.threads = 10,

                     control.inla = list(int.strategy = "ccd") )

ysim.fun = function(...)
{
    args = list(...)
    prob = theta[1]
    n = length(Predictor)
    return (prob + (1-prob) * rpois(n, lambda = args$E *
                                        exp(Predictor)))
}

xx <- inla.posterior.sample(10000, mod.allcases)
yy <- inla.posterior.sample.eval(ysim.fun, xx, E = SA$exTOT)
y.mean = apply(yy, 1, mean)
SA$RRall <- y.mean / SA$exTOT

summary(SA$RRall)

     Min.   1st Qu.    Median      Mean   3rd Qu.      Max.
    1.144     2.448     2.976    10.524     4.175 10745.918
