> constr <- INLA:::inla.bym.constr.internal(L)
> constr.BYM <- list(A = cbind(Matrix::Matrix(0, nrow=4, ncol = 4*n),
>                              kronecker(diag(4), constr$constr$A)),
>                    e = c(0, 0, 0, 0))
>
> set.seed(11)
