> > > > > > >     return (pnbinom(Y, size = size, prob = prob))
> > > > > > > }
> > > > > > > ## here we insert complete data
> > > > > > > p <- rowMeans(inla.posterior.sample.eval(fun, xx, E = E, Y =
> > > > > > > y))
> > > > > > > plot(p, r$cpo$pit, pch = 19)
> > > > > > > abline(a = 0, b = 1, lwd = 3, col = "blue")
> > > > > > > hist(p,  breaks=10,main="test data",xlab="PIT")
> > > > > >
> > > > > > its easiest to compute it like this, for the complete data,
> > > > > > argument 'Y
> > > > > > = y', but you know which to predict, so you can just extract
> > > > > > that
> > > > > > part
> > > > > > of 'p'
