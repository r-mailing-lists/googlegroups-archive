I have this code to generate the decaying buffer zones [Not 100% sure yet it works as intended & if its correct i am 0% sure how to incorporate this in the INLA model]:

# Decaying buffer zone per geostatistical point
Distance <- matrix(0, nrow = nrow(Unsampled), ncol = nrow(Sampled))
            for (i in 1:nrow(Sampled)) {Distance[, i] <- sp::spDistsN1(Unsampled, Sampled[i,])}

Decay <- function(distance, buffer) {decay_rate <- 0.5
                                     exp(-decay_rate * (distance / buffer))}

Weight <- matrix(0, nrow = nrow(Unsampled), ncol = nrow(Sampled))
          for (i in 1:nrow(Sampled)) {Weight[, i] <- Decay(Distance[, i], Data$Range[i])}

