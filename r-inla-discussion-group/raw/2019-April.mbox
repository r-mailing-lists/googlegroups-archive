> group=timeRow, control.group=list(model = 'rw2'))

aah, this require some thought. the storage is linear, and its stored
as |timeRow| replications of geoRow. So with 3 groups, then the length
is 3 times the initial length, and its stored as

c(geoRow.group1, geoRow.group2, geoRow.group3)

the internal indexing, is available in the function 'inla.idx', and is
essetially

	idx + (group - 1) * n + (replicate - 1) * n * ngroup

n = 10
ng = 3
N = n*ng
idx = rep(1:n, ng)
g = rep(1:ng, each = n)

lcs = c()
for(i in 1:N) {
    w = rep(0, N) ## or w = rep(0, i)
    w[i] = 1
    lc = inla.make.lincomb(idx = w)
    names(lc) = paste0("idx", i)
    lcs = c(lcs, lc)
}
r = inla(y ~ -1 + f(idx, group=g,  ngroup=ng),
         data = data.frame(y = 1:N, g, idx),
         lincomb = lcs,
         control.family = list(
             hyper = list(prec = list(
                              initial = 12,
                              fixed=TRUE))))
plot(r$summary.lincomb.derived$mean, 1:N)

