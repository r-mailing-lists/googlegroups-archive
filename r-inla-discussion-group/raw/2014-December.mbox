Please advise the attached additional codes to estimate abundance using linear combination.

Thanks
dong

## make linear combination

ind <- inla.stack.index(stack.full,tag="pred")$data

lvec <- rep(NA,length(stack.full$data$data$y))
lvec[ind] <- 1
lc1 <- inla.make.lincomb(Predictor=lvec)
## fit model
geo.inla.full  <- inla(f.geo,family="gaussian",data=inla.stack.data(stack.full,spde=spde),lincomb=lc1,
                       control.predictor=list(A=inla.stack.A(stack.full),compute=T),verbose=T,
                       control.inla = list(lincomb.derived.only=FALSE))

## extract marginals

pred <- round(geo.inla.full$summary.linear.pred[ind,], 4)

## check
cat(sum(pred[,1]),geo.inla.full$summary.lincomb$mean)

