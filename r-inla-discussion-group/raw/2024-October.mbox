Date: Sat, 19 Oct 2024 09:35:35 +0000
Subject: Re: [r-inla] Potential Computational Speed up in INLA and inlabru
Message-ID: <i-aKRj7xDQU.jDJmFAHSAAAJ@r-inla-discussion-group.groups.google.com>
In-Reply-To: <i-aKRj7xDQU.yhNSmcanAAAJ@r-inla-discussion-group.groups.google.com>
References: <i-aKRj7xDQU.yhNSmcanAAAJ@r-inla-discussion-group.groups.google.com>
Archived-At: <https://groups.google.com/g/r-inla-discussion-group/c/i-aKRj7xDQU/m/jDJmFAHSAAAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

you can try something like this. takes from from 12s to 8s in the example below.

Germany = cbind(Germany,region.struct=Germany$region)

formula3 = Y ~ f(region.struct,model="besag",graph=g, constr = T) +
               f(region,model="iid") + f(x, model="rw2")

tref <- Sys.time()
for(i in 1:10) {
    r =  inla(formula3,
              family="poisson",
              data=Germany,
              E=E,
              verbose = !TRUE,
              num.threads = "1:1")
}
print(Sys.time() - tref)

tref <- Sys.time()
r.prev <- NULL
for(i in 1:10) {
    r =  inla(formula3,
              family="poisson",
              data=Germany,
              E=E,
              verbose = !TRUE,
              num.threads = "1:1",
              control.inla = list(int.strategy = "eb",
                                  control.vb = list(enable = FALSE)),
              control.compute = list(return.marginals = FALSE),
              control.mode = list(result = r.prev, restart = TRUE))
    r.prev <- r
}
print(Sys.time() - tref)

