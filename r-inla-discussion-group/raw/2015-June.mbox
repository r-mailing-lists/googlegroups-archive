On Mon, 2015-06-08 at 07:02 -0700, John Bell wrote:
> Hello,
>
> I have a model of the form:    Y = Covariate + X * b + Z * u     where
> the X * b + Z * u is a smoother.

I think this is what you want,
H

*********************

#Simulate data:
N  <- 100
X  <- matrix(rnorm(N * 5), ncol = 5)
Z  <- matrix(rnorm(N * 15), ncol = 15)
Covariate <- rnorm(N)
beta  <- c(1, 2)
b <- rnorm(5)
u <- rnorm(15)
eta <- beta[1] + beta[2] * Covariate + X %*% b + Z %*% u
Y <- rnorm(N, mean = eta, sd = 0.5)

#INLA model:
u <- 1:N
f <- Y ~ 1 + Covariate + X + f(u, model = 'z', Z = Z, constr = TRUE)

#Run inla:
Test <- data.frame(Y = Y, Covariate = Covariate)

lcs <- inla.make.lincombs(X1 = cbind(X[, 1]), X2 = cbind(X[, 2]))

Model1 <- inla(f,
               data = Test,
               lincomb = lcs,
                quantiles=c(0.025, 0.975))
summary(Model1)

r1= X[, 1] * Model1$summary.fixed["X1", "mean"] +
    X[, 2] * Model1$summary.fixed["X2", "mean"]
r2 = Model1$summary.lincomb.derived$mean

r1-r2

