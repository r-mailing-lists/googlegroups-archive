Hi all,

I have been building a joint model with continuous variables (slope, elevation and aspect. Everything is working fine, but I am not able to obtain the predictions for the joint model. I now that it's something I am missing, but I don't know how to put everything together.

I have added below the code and the error.

Thanks

Oscar

> cmp_ar1_joint <- ~ -1 + point_field(coordinates, model = matern) +
+   mark_field(coordinates,
+              group=ti,
+              group_mapper=bru_mapper_index(4),
+              model=matern,
+              control.group=list(model="ar1"))  +
+   Inter_point(1) + Inter_mark(1) + point_field_copy(copy = "point_field", fixed = FALSE) +
+   elev(f.elev(x, y), model = "linear")+
+   aspect(f.aspect(x, y), model = "linear") +
+   slope(f.slope(x, y), model = "linear")

> lik1_ar <- like("cp",
+                  formula = coordinates ~ .,
+                  data = data,
+                  ips = ips,
+                  include = c("point_field", "Inter_point"))

> lik2_ar <- like("poisson",
+                  formula = counts ~ .,
+                  data = data,
+                  exclude = c("point_field", "Inter_point","elev"))

> fit_iid_joint <- bru(cmp_iid_joint,
+                      lik1_ar,
+                      lik2_ar, options=list(verbose=TRUE))

> predjoint <- predict(fit_iid_joint,
+                      data,
+                      ~ (Inter_mark +
+                           Inter_point +
+                           point_field +
+                           point_field_copy +
+                           mark_field +
+                           aspect +
+                           elev +
+                           slope
+                           ),
+                      n.samples=100)

