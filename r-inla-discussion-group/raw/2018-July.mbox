> > > > > > > > > > > > stk.pred <- inla.stack(data = list(y = NA), #because we're making predictions
> > > > > > > > > > > >                        tag = "pred",
> > > > > > > > > > > >                        A = list(1),
> > > > > > > > > > > >                        effects = list(data.frame(b0 = 1,
> > > > > > > > > > > >                                                 gCovar = gCv)))
> > > > > > > > > > > >
