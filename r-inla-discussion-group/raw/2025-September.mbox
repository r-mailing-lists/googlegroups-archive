  SEX(DF_sf2$Sex, model = "factor_full") +
  YRS(DF_sf2$YrsInHome, model = "linear") +
  field2(geometry, model = spde)

Fit_bino <- bru(comps_1,
  bru_obs(
    family = "binomial", Ntrials = 1, control.family = list(link = "logit"),
    data = DF_sf2,
    formula = HTN_2 ~ Intercept + Height + Category + Surface + Volume +
      sWBT14 + Pop20 + PM + EVI + PN_Score + TS_Score + CAC_Score +
      WLTH + AGE + EMP + MAR + INC + EDU + SEX + YRS + field2
