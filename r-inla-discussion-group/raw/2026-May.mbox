> > > > > > > >   data = inla.stack.data(stk_joint),
> > > > > > > >   control.predictor = list(A = inla.stack.A(stk_joint), compute = TRUE),
> > > > > > > >   control.compute = list(dic = TRUE, waic = TRUE, config = TRUE)
> > > > > > > > )
> > > > > > > >
> > > > > > > >
> > > > > > > > #-------------------------------------------------------------------------------
