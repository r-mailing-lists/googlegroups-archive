 cmp <- ~ latent_field(main = coords, model = spde_spatially_coherent) + Intercept(1)
 formula <- observed_field ~  latent_field
 fit <- bru(
   cmp,
   like(
     formula = observed_field ~ .,
     family = "gaussian",
     data = list(observed_field = observed_field),
     domain = list(geometry = prmesh)
   )
 )

