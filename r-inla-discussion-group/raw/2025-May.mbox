        control.mode = control.mode(restart = TRUE),
        control.compute = compute_list,
        control.predictor = predictor_list,
        control.fixed = list(prec.intercept = 0.01),
        num.threads = 6,  # Prevent internal threading conflicts
        # verbose = T
