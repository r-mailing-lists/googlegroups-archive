Dear all,

I am new to R-inla. I am running a spatio-temporal model with interactions for disease mapping. The following are the codes which I have considered. In this case I want to know how to compare observed and predicted values.

R CODE:
rm(list=ls())

library(INLA)
inla.setOption(num.threads = "12:8", blas.num.threads = 4)
#inla.setOption(num.threads = "12:8", inla.call = "remote", blas.num.threads = 4)

library("ggregplot")
library("INLA")
library("ggplot2")
library("ggregplot")
library("tidyverse")
library("RColorBrewer")

library("raster")
library("sf")
library("rgdal")

library("spdep")
library("sp")
library("rgdal")
library("raster")

library("lme4")
library("reshape2")
library("dplyr")
Shp <- file.choose()
m<-readOGR(Shp)
plot(m)
head(m)
class(m)
nb <- poly2nb(m)

# translate to INLA format and save
nb2INLA("C:\\Users\\hp 542\\Desktop\\Spatio_temporal\\EM\\maps\\m.adj", nb)

# read in the INLA graph we just created

g <- inla.read.graph(filename = "C:\\Users\\hp 542\\Desktop\\Spatio_temporal\\EM\\maps\\m.adj")
data=read.csv("C:\\Users\\hp 542\\Desktop\\Spatio_temporal\\EM\\data\\EM_DATA 2013 to 2016_reduced.csv")
names(data)
fix(data)
ID.area<-data$block_id
ID.period<-data$period_id

ID.area.int <http://id.area.int/> <- data$block_id
ID.year.int <http://id.year.int/> <- data$period_id

S<-max(data$block_id)
T<-max(data$period_id)

sdunif = "expression:
 logdens = -log_precision/2;
 return(logdens)"

lunif = "expression:
  a = 1;
  b = 1;
  beta = exp(theta)/(1+exp(theta));
  logdens = lgamma(a+b)-lgamma(a)-lgamma(b)+(a-1)*beta+(b-1)*(1-beta);
  log_jacobian = log(beta*(1-beta));
  return(logdens+log_jacobian)"

# FOR FITTING LEROUX model, the first step is to create matrix M:

Q.xi <- matrix(0, g$n, g$n)

for (i in 1:g$n){
  Q.xi[i,i]=g$nnbs[[i]]
  Q.xi[i,g$nbs[[i]]]=-1}
Q.Leroux <- diag(S)-Q.xi

#NY8.mat <- as(nb2mat(NY8.nb, style = "B"), "Matrix")

nb.mat <- as(nb2mat(nb, style = "B"), "Matrix")

# We can check that the maximum eigenvalue, λmax, is one:

max(eigen(Q.Leroux)$values)

# Define the temporal structure matrix Q(gamma) of a random walk of first or second order as

D1 <- diff(diag(T),differences=1)
Q.gammaRW1 <- t(D1)%*%D1
D2 <- diff(diag(T),differences=2)
Q.gammaRW2 <- t(D2)%*%D2

# Type I interaction and RW1 prior for time
formula_1R1<- case_count ~ 1+Maximum_temp+EVI+Minimum_temp+BIO.1+BIO.3+BIO.12+popdens+Soil_moisture +
  f(block_id, model="generic1", Cmatrix=Q.Leroux, constr=TRUE,
    hyper=list(prec=list(prior=sdunif),beta=list(prior=lunif))) +
  f(period_id, model="rw1", constr=TRUE,hyper=list(prec=list(prior=sdunif))) +
  f(block.period, model="iid",constr=TRUE, hyper=list(prec=list(prior=sdunif)))

model_1R1<-inla(formula_1R1, family="nbinomial", data=data, E=E2,
                control.predictor=list(compute=TRUE),
                control.compute=list(dic=TRUE),verbose=TRUE,
                control.inla=list(strategy="simplified.laplace"))
#         control.inla=list(tolerance = 1e-9, diagonal=10))

summary(model_1R1)

Thanks in advance
Praba

