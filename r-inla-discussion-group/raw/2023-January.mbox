> > > > random
> > > > intercepts
> > > >                          f(Plot_ID_4INLA,model='iid', hyper =
> > > > prior.prec )+
> > > >                          f(Location_4INLA,model='iid', hyper =
> > > > prior.prec)+
> > > >                          f(Datasource_ID_4INLA,model='iid', hyper
> > > > =
> > > > prior.prec)+
> > > >                          f(Plot_ID_4INLAs,iYear,model='iid', hyper
> > > > =
> > > > prior.prec)+  # random slopes
