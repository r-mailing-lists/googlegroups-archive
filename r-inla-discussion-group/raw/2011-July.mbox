my responce is in the comments in this code
H

*************

library(INLA)

load("example_data.RData")
data=z
rm(z)

data$A = as.numeric(data$A)
data$B = as.numeric(data$B)
data$C = as.numeric(data$C)
data$D = as.numeric(data$D)

## as I understand, the index `j' is related to the levels of factor
## A.

## so what I think is you want this model; possible modifided with you
## own priors.

values = unique(sort(data$A))
formula = Y ~ 1 + f(A, model="iid", values = values) + B + C + D
r = inla(formula,  data = data,  family = "gaussian")

## and then I get
## > r$summary.fixed[,"mean"]
##     (Intercept)                B                C                D
## 1.572328359e-01 -9.760072135e-05 -1.094765887e-01 -1.809569821e-02

## and the \alpha_j's are here

##> head(cbind(values, alpha.mean = r$summary.random$A$mean))
##     values       alpha.mean
##[1,]      1  0.0035875644535
##[2,]      2 -0.0376122854650
##[3,]      3 -0.0369749180973
##[4,]      4  0.0009704529075
##[5,]      5 -0.0053196167573
##[6,]      6  0.0118992794305

##  I don't understand the notation B ~ N(., .)  and BX = ...  as you
##  give 'B' two meanings. I guess you mean that theta \beta's are the
##  B in B~N(., .) and X is rbind(B, C, D).

