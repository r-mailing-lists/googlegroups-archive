f(ID.year,model="rw2",constr=TRUE) +
f(ID.year1,model="iid",constr=TRUE) +
f(ID.year.int <http://ID.year.int>,model="iid", group=ID.area.int <http://ID.area.int>,
control.group=list(model="besag", graph=Georgia.adj),constr=TRUE)

