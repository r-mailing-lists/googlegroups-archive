[1] 1255 1256 1257 1258 1259 1260

the NAs arise in inla.stack.data:

> tail(inla.stack.data(stack3.yY)$fld.y.s)
[1] NA NA NA NA NA NA

with stack3.yY defined as:

> stack3.y = inla.stack(data = list(y = cbind(dat.i$y, rep(NA, n.i), rep(NA, n.i)), weights = dat.i$ca/weights0, scale = scale.ca.i),
+ A = list(A.y.s, A.y.st <http://A.y.st>, 1),
+ effects = list(id.y.s, id.y.st <http://id.y.st>, data.frame(y.const = rep(1,n.i), y.time = dat.i$time, y.p = dat.i$p, y.par = dat.i$par, y.d_k = dat.i$d_k, y.d_r = dat.i$d_r, y.d_m = dat.i$d_m, y.d_s = dat.i$d_s, y.d_g = dat.i$d_g, y.alt = dat.i$alt, y.age = dat.i$age)),
+ tag = "stack.y")
>
> stack3.Y = inla.stack(data = list(y = cbind(dat.k$Y, rep(NA, n.k), rep(NA, n.k)), weights = dat.k$CA/weights0, scale = scale.CA.k),
+ A = list(A.k.y.s, A.k.y.st <http://A.k.y.st>, 1),
+ effects = list(id.y.s, id.y.st <http://id.y.st>, data.frame(y.const = rep(1,n.k), y.time = dat.k$time, y.p = dat.k$P, y.par = dat.k$y.par, y.d_k = dat.k$y.d_k, y.d_r = dat.k$y.d_r, y.d_m = dat.k$y.d_m, y.d_s = dat.k$y.d_s, y.d_g = dat.k$y.d_g, y.alt = dat.k$y.alt, y.age = dat.k$y.age)),
+ tag = "stack.Y")
>
> stack3.yY = inla.stack(stack3.y, stack3.Y)
>

Of course, I can make a simpler stack and possibly come around the problem, but what are the mistakes in my stack command?

best Øyvind

