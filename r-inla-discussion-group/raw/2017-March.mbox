Took 8 hours to run, and the posterior prediction is all the same value for SD and mean. So I also don't understand why the predictions seem to be showing the mesh, because they're based on a regular lattice of coordinates:

model_mis <- inla(form_mis, data=inla.stack.data(stk), family=rep('binomial',2),

                  control.predictor=list(compute=FALSE, A=inla.stack.A(stk),
                                         link=inla.stack.data(stk)$link),

                  control.compute = list(dic = TRUE, waic = TRUE, config=TRUE, cpo = TRUE),

                  verbose = TRUE)

m.prd<-model_mis$summary.fitted.values[inla.stack.index(stk, "prediction")$data,"mean"]

sd.prd<- model_mis$summary.fitted.values[inla.stack.index(stk, "prediction")$data,"sd"]

> range(m.prd)
[1] 0.9983941 0.9983941
> range(sd.prd)
[1] 0.0004448642 0.0004448779

> ggplot(preds) +
+   geom_point(aes(x=long, y=lat, color = m.prd))+
+   geom_path(data = dc, aes(x = long, y = lat, group = group),
+             color = 'red', size = 1)

