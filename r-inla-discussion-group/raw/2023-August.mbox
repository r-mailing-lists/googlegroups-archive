To try to overcome this I've tried to use the starting point you've suggested - would you be able to check that I have implemented this correctly?
This is the code I have used without any starting point:

cmp3 <- coordinates ~

  Village(Covariates$Village, model = "linear") +
  mySPDE(coordinates, model = matern) +
  lsig(1) +
  Intercept(1)

fit3 <- lgcp(
  components = cmp3,

  data = nests,
  samplers = transects,
  domain = list(
    coordinates = mesh,
    distance = INLA::inla.mesh.1d(seq(0, W, length.out = 30))
  ),
  formula = form,
  options = list(bru_initial = list(lsig = 2),
                 bru_verbose=4)
)

summary(fit3)

And this is the code I have used trying to implement initial values.

cmp4 <- coordinates ~

  LRoad(Covariates$LRoad, model = "linear") +

  mySPDE(coordinates, model = matern) +
  lsig(1) +
  Intercept(1)

fit4 <- lgcp(
  components = cmp4,

  data = nests,
  samplers = transects,
  domain = list(
    coordinates = mesh,
    distance = INLA::inla.mesh.1d(seq(0, W, length.out = 30))
