Thank you for help. I now can run the Hieratical model, but now the problem is my model takes too many times to run, and I have no idea whether it's on going or stocked.

My formula looks like this Y2 ~ 0+ one_1+logvmt_1+roadtype2_1+roadtype3_1+

              f(idx.na1, model = "generic", Cmatrix = matrix(1, 1, 1)) +

              f(idx.na2, model = "generic", Cmatrix = matrix(1, 1, 1))+
              one_2+logvmt_2+
              one_3+logvmt_3+roadtype2_3+roadtype3_3+
              f(idx.na3, model = "generic", Cmatrix = matrix(1, 1, 1)) +
              f(idx.na4, model = "generic", Cmatrix = matrix(1, 1, 1))+
              one_4+logmvt_4+
              f(county, model = "iid4d",n=15*4,
                hyper = list(theta1 =list(param = c( 11, .01, .01, .01, .01, 0, 0, 0, 0, 0, 0))))+
              f(CoYr, model = "iid4d",n=75*4,
                hyper = list(theta1 =list(param = c( 11, .01, .01, .01, .01, 0, 0, 0, 0, 0, 0))))+
              f(MSLINK, model = "iid4d",n=88*4,
                hyper = list(theta1 =list(param = c( 11, .01, .01, .01, .01, 0, 0, 0, 0, 0, 0)))),
with

            family = c(rep("beta",15), "binomial", rep("beta",15), "binomial"),

            control.expert = list(jp = jpr)
that

jp = function(theta, theta.desc = NULL) {
  ##for(i in seq_along(theta.desc)) print(paste0("    theta[", i, "]=", theta.desc[i]))

  p.mean <- theta[31]
  p.lprec <- theta[32]
  p.mean.p <- theta[33]
  p.lprec.p <- theta[34]

  lprior <- (sum(dnorm(theta[1:15], mean = p.mean, sd = sqrt(1/exp(p.lprec)), log = TRUE)) +

               dnorm(p.mean, mean = 1.5, sd = sqrt(1/exp(p.lprec)), log = TRUE) +
               (dgamma(exp(p.lprec), shape = 10, rate = 10, log=TRUE) + p.lprec) +
               ## to correct normalizing constants in 'generic'
               (-dnorm(0, sd = 1/sqrt(exp(p.mean)), log = TRUE)) +
               (-dnorm(0, sd = 1/sqrt(exp(p.lprec)), log = TRUE)))+

    (sum(dnorm(theta[16:30], mean = p.mean.p, sd = sqrt(1/exp(p.lprec.p)), log = TRUE)) +
       dnorm(p.mean.p, mean = 1.5, sd = sqrt(1/exp(p.lprec.p)), log = TRUE) +
       (dgamma(exp(p.lprec.p), shape = 10, rate = 10, log=TRUE) + p.lprec.p) +

       ## to correct normalizing constants in 'generic'

       (-dnorm(0, sd = 1/sqrt(exp(p.mean.p)), log = TRUE)) +
       (-dnorm(0, sd = 1/sqrt(exp(p.lprec.p)), log = TRUE)))
  return (lprior)
}

