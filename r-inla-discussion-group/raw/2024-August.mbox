> >
> > you need to evaluate the t-noise at the same level as the predictor as they
> > are
> > dependent
> >
> > n <- 100
> > x <- rnorm(n)
> > df <- 5
> > y <- 1 + x + rt(n, df = df)/sqrt(df/(df-2))
> >
> > r <- inla(y ~ 1 + x,
> >           family = "t",
> >           data = data.frame(y, x),
> >           control.compute = list(config = TRUE))
> >
> > sim <- function(idx.prec, idx.df) {
> >     n <- length(Predictor)
> >     df <- theta[idx.df]
> >     y <- Predictor + rt(n, df = df) / sqrt(df/(df-2))
> >     return (y)
> > }
> >
> > xx <- inla.posterior.sample(10^4, r, intern = FALSE)
> > yy <- inla.posterior.sample.eval(sim, xx,
> >                                  ## index for the precision and df parameter
> >                                  idx.prec = 1, idx.df = 2)
> >
> >
> >
> >
> >
> > On Tue, 2024-08-27 at 12:13 -0700, Stanley Sayianka wrote:
> > > If I have a model fitted with the Student t-family response, and want to
> > > draw
> > > samples of the response from the fitted model, is this the correct way to
> > > do,
> > > specifically for how the t response is parametrised in inla.doc("T"):
> > >
> > > t_pp_draw <- function(inla_model, num_simulations) {
> > >   # generate samples from the posterior
> > >   samples <- inla.posterior.sample(n = num_simulations, result = inla_model)
> > >
> > >   nu_loc <- grep("degrees of freedom for student-t",
> > > names(samples[[1]]$hyperpar))
> > >   tau_loc <- grep("precision for the student-t observations",
> > > names(samples[[1]]$hyperpar))
> > >
> > >   # the linear predictor
> > >   eta <- inla.posterior.sample.eval("Predictor", samples)
> > >
> > >   # the degrees of freedom for the student t
> > >   nu <- inla.hyperpar.sample(n = num_simulations, result = inla_model)[,
> > > nu_loc]
> > >
> > >   # the precision parameter
> > >   tau <- inla.hyperpar.sample(n = num_simulations, result = inla_model)[,
> > > tau_loc]
> > >
> > >   yvals <- matrix(NA, nrow = nrow(eta), ncol = num_simulations)
> > >   for (i in 1:num_simulations) {
> > >     yvals[, i] <- as.numeric(eta[, i]) + (rt(nrow(eta), df = nu[i]) /
> > > sqrt(tau[i]))
> > >   }
> > >   return(yvals)
> > > }
> > >
> > >
> > > Code largely adapted from how inlatools::distribution_check() is styled
> > >
> > > Thanks.
