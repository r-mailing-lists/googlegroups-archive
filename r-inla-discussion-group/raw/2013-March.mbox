On 08/03/13 10:00, thierry....@gmail.com wrote:

> walk along year per location would be a good thing for this dataset.
> We sloved this by creating a new vector year2 = location * (nYear +
> 200) + year. So year2 looks like 1:20 for location 0,  201:220 for
> location 1, 401:420 for location 2, ... Then we added a f(year2, model
> = 'rw1') component to the model. Is this OK or is it rubbish? The
> example below seems to give reasonable results. Though the year2
> effects seems to have some positive bias.

Something like this should do the trick:

year2 = rep(1:20, times=nLocations)
repl = rep(1:nLocations, each=nYear)
f(year2, model="rw1", replicate=repl)

>
> Best regards,
>
> Thierry
>
> library(INLA)
> library(ggplot2)
> set.seed(12345)
> nLocation <- 20
> nYear <- 20
> nMonth <- 6
> Intercept <- 3
> Season <- 2
> sdYear <- 0.1
> sdTrend <- 0.05
> sdLocation <- 3
> rho <- 0.5
> burnin <- 50
> probMissing <- 0.2
>
> dataset <- expand.grid(year = seq_len(nYear), month = seq_len(nMonth),
> location = seq_len(nLocation))
> dataset$Fixed <- Intercept + Season * cos(pi * (dataset$month -
> round(mean(dataset$month))) / nMonth)
> Random <- matrix(rnorm(nLocation, mean = 0, sd = sdLocation), ncol =
> nYear + burnin, nrow = nLocation)
>
> Error <- matrix(rnorm((nYear + burnin) * nLocation, mean = 0, sd =
> sdYear), ncol = nYear + burnin)
> for(i in tail(seq_len(nYear + burnin), -1)){
>   Random[, i] <- rho * Random[, i - 1] + Error[, i]
> }
> Random <- Random[, -seq_len(burnin)]
> dataset$Random <- apply(dataset[, c("location", "year")], 1, function(x){
>   Random[x["location"], x["year"]]
> })
> dataset$Random <- dataset$Random + rnorm(nLocation, mean = 0, sd =
> sdTrend)[dataset$location] * dataset$year
> dataset$y <- rpois(nrow(dataset), lambda = exp(dataset$Fixed +
> dataset$Random))
> dataset$y0 <- dataset$y
> dataset$y[rbinom(nrow(dataset), prob = probMissing, size = 1) == 1] <- NA
> ggplot(subset(dataset, !is.na <http://is.na>(y)), aes(x = year, y = location)) +
> geom_point() + facet_wrap(~month)
> ggplot(dataset, aes(x = year, y = y0, colour = factor(month))) +
> geom_line() + facet_wrap(~location, scales = "free_y")
>
>
> dataset$year2 <- with(dataset, location * (nYear + 200) + year)
> link <- rep(NA, nrow(dataset))
> link[is.na <http://is.na>(dataset$y)] <- 1
> model3 <- inla(y ~ factor(month) + f(year2, model = "rw1"), family =
> "poisson", data = dataset, control.predictor = list(compute = TRUE,
> link = link))
> plot(model3)
> test <- merge(dataset, model3$summary.random$year2, by.x = "year2",
> by.y = "ID")
> colnames(test)[11:13] <- c("LCL", "Median", "UCL")
> ggplot(test, aes(x = year, y = Random)) + geom_ribbon(aes(ymin = LCL,
> ymax = UCL), alpha = 0.1, fill = "blue") + geom_line(aes(y = mean),
> colour = "blue") + geom_line() + facet_wrap(~location, scales = "free_y")
