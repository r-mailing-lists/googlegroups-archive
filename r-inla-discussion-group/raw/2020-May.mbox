Something like this:

data = data.frame(x=1:10,z=as.factor(rep(1:5,each=2)))

MM <- model.matrix( ~ -1 + x:z,data=data)
data$x_z1 <-  MM[,1]
data$x_z2 <-  MM[,2]
data$x_z3 <-  MM[,3]
data$x_z4 <-  MM[,4]
data$x_z5 <-  MM[,5]
components <- ~ Intercept + x_z1 + x_z2 + ...

Finn

