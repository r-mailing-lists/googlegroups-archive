> >     model  = spde1d[["eke_s"]],
> >     mapper = bru_mapper_fmesher(covmesh1d[["eke_s"]])
> >   ) +
> >
> >   ## Distance sampling model
> >   lsig0(1, model = "linear", mean.linear = 0, prec.linear = 1) +
