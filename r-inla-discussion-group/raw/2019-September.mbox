Date: Thu, 26 Sep 2019 19:44:36 +0000
Subject: Re: [r-inla] Fit model with one error term on original scale and one on log scale
Message-ID: <MnOULvUTttY.z4pjHjUrCQAJ@r-inla-discussion-group.groups.google.com>
In-Reply-To: <MnOULvUTttY.Dz7evMsqCQAJ@r-inla-discussion-group.groups.google.com>
References: <MnOULvUTttY.hzfAXVQqCQAJ@r-inla-discussion-group.groups.google.com> <MnOULvUTttY.Dz7evMsqCQAJ@r-inla-discussion-group.groups.google.com>
Archived-At: <https://groups.google.com/g/r-inla-discussion-group/c/MnOULvUTttY/m/z4pjHjUrCQAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

n = 300
x1 = rnorm(n, sd=0.2)
x2 = rnorm(n, sd=0.2)
eps = rnorm(n,  sd = 0.1)
eta = x1 + x2 + eps
y = exp(eta) + rnorm(n, sd = 0.1)

r = inla(y ~ -1 + x1 + x2 + f(idx),
         data = data.frame(y, x1, x2, idx = 1:n),
         control.family = list(
             control.link = list(
                 model = "log")))
summary(r)

