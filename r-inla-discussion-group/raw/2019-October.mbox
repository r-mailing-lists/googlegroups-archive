	tag=[INLA.Data1] component=[poisson]
section=[fixed]
	tag=[(Intercept)] component=[(Intercept)]
		beta:
			parameter=[(Intercept)]
			prior=[normal]
			param=[0, 0]
section=[random]
	tag=[region.struct] component=[region.struct]
		theta1:
			parameter=[log precision]
			prior=[loggamma]
			param=[1e+00, 5e-05]
		group.theta1:
			parameter=[logit correlation]
			prior=[normal]
			param=[0.0, 0.2]
	tag=[region] component=[region]
		theta1:
			parameter=[log precision]
			prior=[loggamma]
			param=[1e+00, 5e-05]
		group.theta1:
			parameter=[logit correlation]
			prior=[normal]
			param=[0.0, 0.2]

