formula <- outbreak_bin ~ 1 + nino.binary3.4  + summer + as.factor(region.natural) + bs(dengue$time, knots = (19*4-1)) + f(ubigeo.struct,model="besag", "ENSO.graph") + f(ubigeo.unstruct,model="iid")

N34 <- inla(formula, family="binomial", data=dengue, Ntrials=1, verbose=TRUE, num.threads = inla.getOption("num.threads"), control.predictor=list(compute=TRUE), control.inla=list(strategy="adaptive"))

