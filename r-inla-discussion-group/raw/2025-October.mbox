you can replace

a=$(readlink -f "$file")

with

a=$(myreadlink "$file")

using this sh-function that emulates the '-f' option.

myreadlink () {
    (

	tfile=$1
	cd $(dirname "$tfile")
	tfile=$(basename "$tfile")
	while [ -L "$tfile" ]
	do

	    tfile=$(readlink "$tfile")

	    cd $(dirname "$tfile")
	    tfile=$(basename "$tfile")
	done
	pdir=$(pwd -P)
	echo "$pdir/$tfile"
    )
}

