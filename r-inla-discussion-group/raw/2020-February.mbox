            lambda= as.matrix((A_pred[sIdx:eIdx,]%*%xSpace) + (Xm[sIdx:eIdx,]%*%xX) ) +xxTime     #Each column is a simulation so each row represents a location.
            #Extract quantiles
lambda2<-exp(lambda)
for (j in 1:NSim){
y[,j]<-rpois(nrow(lambda2),lambda=lambda2[,j])}
