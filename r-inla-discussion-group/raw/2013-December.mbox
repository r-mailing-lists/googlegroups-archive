formula <- y ~ 1
for (i1 in 0:1) {
  if (i1==1)
   formula = update(formula, '.~.+x1')
  for (i2 in 0:1) {

   if (i2==1)
    formula = update(formula, '.~.+x2')

   for (a in 0:1) {

    if (a==1)
     formula = update(formula, '.~.+f(i, model="ar1")')

    result <- inla(formula, data=dat,
                   control.compute=list(dic=TRUE))
    cat(i1, i2, a, result$dic$dic, '\n',
