Hi Håvard

I get an error, when doing this. Have kondenced to this small example code here:

dfTestData = data.frame(ResponseVar=NA, X = rep(1:100, times=100), Y = rep(1:100, each=100))
dfTestData$ResponseVar = dfTestData$X * dfTestData$Y
plot(Y~X, dfTestData, type="p", col=TemperatureColorPalette(10000)[dfTestData$ResponseVar], pch=19)

Loc <- cbind(dfTestData$X, dfTestData$Y)
mesh <- inla.mesh.2d(loc.domain = Loc, max.edge = 10)
par(mfrow=c(1,1), mar=c(0,0,2,0))
plot(mesh)
points(Loc, pch = 16, cex = 0.1, col="red")

A <- inla.spde.make.A(mesh, loc = Loc)
Range <- 50
Sigma <- 0.5
N <- nrow(dfTestData)
spde <- inla.spde2.pcmatern(mesh,  prior.range = c(Range, 0.05), prior.sigma = c(Sigma, 0.05))

w.index <- inla.spde.make.index(
  name = 'w',
  n.spde = spde$n.spde)

Xm <- model.matrix(~ 1, data = dfTestData) # + Xkm.std + Ykm.std
Xm <- as.data.frame(Xm)

Stack <- inla.stack(
  tag  = "Fit",
  data = list(ResponseVar = dfTestData$ResponseVar),
  A = list(1,A), #Remember to add a "1" every time you add a smoother
  effects = list(
    Intercept = rep(1, N),  #Intercept
#    X = Xm[,-1],            #Covariates without the intercept
    w = w.index))          #SRF
formulaGAM_SRF <- formula(ResponseVar ~ -1 + Intercept +
                                  f(w, model = spde))
fitNegBin_GAM_SRF <- inla(formulaGAM_SRF,
                                family = "nbinomial",
                                data = inla.stack.data(Stack, spde = spde),
                                control.compute = list(config = TRUE),
                                control.predictor = list(A = inla.stack.A(Stack)))

INLA_Samples_Test = inla.posterior.sample(10, fitNegBin_GAM_SRF)
A = inla.spde.make.A(mesh=mesh, loc=matrix(50,50))

A%*%w.index
---Gives--->
Error in A %*% w.index :
  not-yet-implemented method for <dgCMatrix> %*% <list>
----------------

Shall A or w.index be converted / reshaped beforehand?

Best regards
Teunis

