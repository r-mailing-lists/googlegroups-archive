nrep=500

thetaest=array(0,dim=c(3,9,nrep))
thetaest=array(0,dim=c(3,9,nrep))
thetaest=array(0,dim=c(3,9,nrep))

thetavector=matrix(0,3,9)
thetavector[,1]=c(-.821,.9,.675)     # Var(h)/ E[h]^2=10
thetavector[,2]=c(-.736,.9,.363)     # Var(h)/ E[h]^2=1
thetavector[,3]=c(-.706,.9,.135)     # Var(h)/ E[h]^2=.1
thetavector[,4]=c(-.4106,.95,.4835)  # Var(h)/ E[h]^2=10
