thetavector[,9]=c(-.1412,.98,.0614)  # Var(h)/ E[h]^2=.1

#simulated data
exp=1
set.seed(123456)
while (exp<10){

alpha=thetavector[1,exp]
phi=thetavector[2,exp]
sigmav=thetavector[3,exp]
crep=0
while(crep<nrep){
n=500
eta=rep(0.1,n)
for(i in 2:n)
eta[i]=alpha+phi*(eta[i-1]-alpha)+rnorm(1,0,sigmav)
y=exp(eta/2)*rnorm(n)

time=1:n
#mean of priors for sv process
alphap=-.5
phip=.5
sigmavp=.1
mprec=((sigmavp)*(1-phip^2))

data=list(ret=y,time=time)

formula=ret~f(time,model="ar1",hyper=list(prec=list(param=c(log(mprec),.01)),rho=list(param=log((1+phip)/(1-phip)),.01)))
result=try(inla(formula,family="stochvol",data=data,control.fixed=list(mean.intercept=alphap,prec.intercept=.01),control.inla=list(restart=10)))
if (is.null(result$summary.hyperpar[1])==F){
bresult=inla.hyperpar(result)
crep=crep+1

thetaest[2,exp,crep]=bresult$summary.hyperpar[2]
thetaest[1,exp,crep]=bresult$summary.fixed[1]
prec=bresult$summary.hyperpar[1]/(1-bresult$summary.hyperpar[2]^2)
thetaest[3,exp,crep]=sqrt(1/prec)
cat("exp ",exp," it ",crep,"alpha ",alpha, " ",thetaest[1,exp,crep]," phi ",phi," ",thetaest[2,exp,crep]," sigmav",sigmav, " ",thetaest[3,exp,crep],"\n")
}
}
exp=exp+1
