something like this

nsamp <- 10
ps <- inla.posterior.sample(nsamp, mod)

ysim <- function(size) {
    n <- length(APredictor)
    prob <- 1/(1+exp(-APredictor))
    return (rbinom(n, prob = prob, size = size))
}
yy <- inla.posterior.sample.eval(
    ysim, ps, size = inla.stack.data(stk.full)$numtrials)

