> > > > 1),
> > > > > > > climatic variables have been centered and scaled,
> > > > altogether
> > > > > > > there's 4 time-steps with available data. I'm actually
> > > > working
> > > > > > > with a spatio-temporal model, but to reduce complexity, I
> > > > have
> > > > > > > rerun the simpler model here and it yields the same error.
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > > Below is some of the code and the summary for the model.
> > > > > > > Attached is the verbose = TRUE output for the model and an
> > > > image
> > > > > > > of the mesh, in case the error may originate from there..
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > Making the Mesh #
> > > > > > >  # changing the CRS unit from meters to kilometers to avoid
> > > > > > > numerical precision errors
> > > > > > >  Loc.crs.m <- CRS(proj4string(Loc.shp))
> > > > > > >  Loc.crs.km <http://Loc.crs.km> <- inla.CRS(Loc.crs.m, args = list(units="km"))
> > > > > > >
> > > > > > >
> > > > > > >  Loc <- cbind (BBS$LONG_X, BBS$LAT_Y)
> > > > > > >  Loc.km <- Loc / 1000 # conversion into km
> > > > > > >
> > > > > > >  RangeGuess <- 500
> > > > > > >  MaxEdge <- RangeGuess / 5
> > > > > > >  mesh1 <- inla.mesh.2d(Loc.km,
> > > > > > >                        max.edge = c(1, 5) * MaxEdge,
> > > > > > >                        cutoff = MaxEdge / 5,
> > > > > > >                        crs = Loc.crs.km <http://Loc.crs.km>)
> > > > > > >
> > > > > > >  mesh1$n
> > > > > > >  # 3938
> > > > > > >
> > > > > > >
> > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > Projecttor Matrix #
> > > > > > >  A2      <- inla.spde.make.A (mesh  = mesh1,    #mesh
> > > > without
> > > > > > > temporal dependency
> > > > > > >                               loc   = Loc.km)
> > > > > > >
> > > > > > >
> > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > Define the SPDE #
> > > > > > >  diff (range (mesh1$loc[ , 1]))/2
> > > > > > >  #  3243.851
> > > > > > >  prior.median.range = 3200
> > > > > > >
> > > > > > >  sd (BBS$Species.Richness_MEAN) / 10
> > > > > > >  # 1.442036
> > > > > > >  prior.median.sd <http://prior.median.sd> = 1.5
> > > > > > >
> > > > > > >  spde1 <- inla.spde2.pcmatern (mesh1,
> > > > > > >                                prior.range = c
> > > > > > > (prior.median.range, 0.05),
> > > > > > >                                prior.sigma = c
> > > > (prior.median.sd <http://prior.median.sd>,
> > > > > > > 0.05))
> > > > > > >
> > > > > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > Define
> > > > > > > the Spatial Field #
> > > > > > >  w.st2    <- inla.spde.make.index (   # only for the
> > > > spatial
> > > > > > > effects, without temporal effect
> > > > > > >    name   = "w_spat",
> > > > > > >    n.spde = spde1$n.spde)
> > > > > > >
> > > > > > >
> > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > Make the Stack #
> > > > > > >  X <- data.frame (Year                              =
> > > > BBS$Year,
> > > > > > >
> > > > > > >                   Year2                                   =
> > > > > > > BBS$Year2,
> > > > > > >                   rteno_factor                            =
> > > > > > > BBS$rteno_factor,
> > > > > > >                   POP_peoplePerKm2                  =
> > > > > > > BBS$POP_peoplePerKm2,
> > > > > > >                   LC_Crop_dominatedLCs              =
> > > > > > > BBS$LC_Crop_dominatedLCs,
> > > > > > >                   LC_Herbaceous_dominatedLCs        =
> > > > > > > BBS$LC_Herbaceous_dominatedLCs,
> > > > > > >                   LC_Needleleaved_dominatedLCs      =
> > > > > > > BBS$LC_Needleleaved_dominatedLCs,
> > > > > > >                   LC_Broadleaved_dominatedLCs  =
> > > > > > > BBS$LC_Broadleaved_dominatedLCs,
> > > > > > >                   LC_Shrub_dominatedLCs            =
> > > > > > > BBS$LC_Shrub_dominatedLCs,
> > > > > > >                   LC_Grasslands
> > > >  =
> > > > > > > BBS$LC_Grasslands,
> > > > > > >                   LC_Urban
> > > >   =
> > > > > > > BBS$LC_Urban,
> > > > > > >                   LC_SparseVeg_dominatedLCs    =
> > > > > > > BBS$LC_SparseVeg_dominatedLCs,
> > > > > > >                   LC_Flood_dominatedLCs            =
> > > > > > > BBS$LC_Flood_dominatedLCs,
> > > > > > >                   LC_BareLand_dominatedLCs     =
> > > > > > > BBS$LC_BareLand_dominatedLCs,
> > > > > > >                   LC_Waterbodies                          =
> > > > > > > BBS$LC_Waterbodies,
> > > > > > >                   LC_Ice_permanent                      =
> > > > > > > BBS$LC_Ice_permanent,
> > > > > > >                   BIOCLIM_01_ztrans                    =
> > > > > > > BBS$BIOCLIM_01_ztrans,
> > > > > > >                   BIOCLIM_04_ztrans                    =
> > > > > > > BBS$BIOCLIM_04_ztrans,
> > > > > > >                   BIOCLIM_12_ztrans                    =
> > > > > > > BBS$BIOCLIM_12_ztrans)
> > > > > > >
> > > > > > >
> > > > > > >  Stack2 <- inla.stack (
> > > > > > >    tag = "Fit",
> > > > > > >    data = list (y = BBS$Species.Richness_MEAN),
> > > > > > >    A = list (A2, 1),  # the projector matrix
> > > > > > >    effects = list (
> > > > > > >      w_spat = w.st2, #spatio-temporal field
> > > > > > >      X = as.data.frame(X) # covariates
> > > > > > >    ))
> > > > > > >
> > > > > > >
> > > > > > >
> > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > ~~~~~~~ Forumla #
> > > > > > >  fSR <-y ~ -1 + LC_Crop_dominatedLCs +
> > > > > > > LC_Herbaceous_dominatedLCs +
> > > > > > >    LC_Needleleaved_dominatedLCs +
> > > > LC_Broadleaved_dominatedLCs +
> > > > > > >    LC_Grasslands + LC_Urban + LC_SparseVeg_dominatedLCs +
> > > > > > > LC_Flood_dominatedLCs +
> > > > > > >    LC_BareLand_dominatedLCs + LC_Waterbodies +
> > > > > > >    BIOCLIM_01_ztrans + BIOCLIM_04_ztrans + BIOCLIM_12_ztrans
> > > > +
> > > > > > >    f (rteno_factor, model = "iid") + # random intercept for
> > > > each
> > > > > > > transect
> > > > > > >    f (w_spat, model = spde1) # spatial term
> > > > > > >
> > > > > > >
> > > >  #~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
> > > > > > > Running the model #
> > > > > > >  inla.setOption (scale.model.default = TRUE)
> > > > > > >
> > > > > > >  M.SR <http://M.SR> <- inla (fSR,
> > > > > > >               family = "poisson",
> > > > > > >               data = inla.stack.data(Stack2),
> > > > > > >               control.compute = list(dic = TRUE, waic =
> > > > TRUE),
> > > > > > >               control.predictor = list (compute = TRUE,
> > > > > > >                                         A =
> > > > > > > inla.stack.A(Stack2)),
> > > > > > >               verbose = TRUE)
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > > > summary(M.SR <http://M.SR>)
> > > > > > >
> > > > > > >  Call:
> > > > > > >  c("inla(formula = fSR, family = \"poisson\", data =
> > > > > > > inla.stack.data(Stack2), ",  "    verbose = TRUE,
> > > > > > > control.compute = list(dic = TRUE, waic = TRUE), ",  "
> > > > > > >  control.predictor = list(compute = TRUE, A =
> > > > > > > inla.stack.A(Stack2)))" )
