> > > > > >                            A = list(1, 1),
> > > > > >                            effects = list(Intercept = rep(1, nrow(SVC2)),
> > > > > >                                           X = as.data.frame(X)))
> > > > > >
> > > > > > # and the formula
> > > > > > fglm1 <- formula(pos ~ -1 + Intercept + fGearDT + fHabitatMC + fHabitatSC)
