## Make AR1 precision matrix
AR1Q <- function(n,rho)
{
    K <- matrix(0, nrow = n -1 , ncol=n)
    for( i in 1:nrow(K))
        K[i,c(i,i+1)] <- c(1,-1)
    q1 <- rho* crossprod(K)
    if(n > 2){
        diag(q1) <- c(1,rep(1+rho^2,n-2),1)
    }
    else{
        diag(q1) <- 1
    }
    q1/(1-rho^2)
    ## Error 2   ###
    ## missing the scalar (1-rho^2)^(-1) from the matrix
}
q1 <- AR1Q(n=n,rho=phi)
## posterior correlation matrix
b0 <- cov2cor(solve(q1+(1/s^2)*diag(n)))
