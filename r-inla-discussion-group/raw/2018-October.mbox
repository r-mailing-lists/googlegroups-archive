an error due to missing 'x1' in the prev example. this one is better.

n = 100
z1 = rnorm(n, sd = 0.5)
eta = 0.5 + z1
p = exp(eta)/(exp(eta) + 1)
size = 100
y = rbinom(n, size = size, prob=p)

df = data.frame(y, z1 = 1:n)

r = inla(y ~ 1+f(z1, model="iid",

                  hyper = list(
                      prec = list(
                          prior = "pc.prec",
                          param = c(2, 0.01)))),
         data=df,
         family="binomial",
         Ntrials = size,
         control.predictor = list(compute=TRUE),
         control.compute = list(config=TRUE))

x = inla.posterior.sample(1000, r)

fun = function(df) {
    Intercept + z1
}

xf = inla.posterior.sample.eval(fun, x, df = df)

par(mfrow=c(1, 2))
plot(rowMeans(xf), eta)
abline(0, 1)
plot(rowMeans(xf), r$summary.linear.predictor[, "mean"])
abline(0, 1)

