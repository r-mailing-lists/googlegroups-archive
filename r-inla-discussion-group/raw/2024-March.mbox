> > > > > > > >
> > > > > > > > # Non-stationary:
> > > > > > > > formula.ns = y ~ -1 +
> > > > > > > > f(intercept,
> > > > > > > > model = "linear",
> > > > > > > > mean.linear = 0,
> > > > > > > > prec.linear = 0.0001) +
> > > > > > > > f(elevation,
> > > > > > > > model = "linear",
> > > > > > > > mean.linear = 0,
