Without the 'values' option the models run without error, but do seem to give different results (to the models with 'values').

E.g. the following two results are slightly different:

stack2 <- inla.stack(data    = list(y=y),
                     A       = list(1),
                     effects = list(list(z=z, intercept=1, w=w, s=s)),
                     tag     = "t")

result2 <- inla(y ~ -1 + intercept + z + f(w, model  = "meb", scale = s, values = w),
               control.predictor = list(A       = inla.stack.A(stack2),
                                        link    = 1,
                                        compute = TRUE),
               data = inla.stack.data(stack2))

result2b <- inla(y ~ -1 + intercept + z + f(w, model  = "meb", scale = s),

               control.predictor = list(A       = inla.stack.A(stack2),
                                        link    = 1,
                                        compute = TRUE),
               data = inla.stack.data(stack2))

