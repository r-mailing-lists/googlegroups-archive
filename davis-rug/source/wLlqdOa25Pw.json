     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><div><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div style=\"word-wrap:break-word\">What about collapsing the list with bind_rows(), making it tidy, and then doing the merge?<div><br></div></div></blockquote></div></div></div></div></blockquote></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><div><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div style=\"word-wrap:break-word\"><div><div><div>library(dplyr)</div><div>library(tidyr)</div><div><br></div><div>df1 &lt;- data.frame(id=1:6, area=c(7339, 7279, 7086, 7288, 7280, 7221),  CH4=2+runif(6))</div><div>df2 &lt;- data.frame(id=7:12, area=c(7339, 7279, 7086, 7288, 7280, 7221),  CO2=2+runif(6))</div><div>df3 &lt;- data.frame(id=13:18, area=c(7339, 7279, 7086, 7288, 7280, 7221),  NOX=2+runif(6))</div><div><br></div><div>target_df &lt;- data.frame(id=1:18, col1=sample(letters, 18), col2=sample(LETTERS, 18))</div><div><br></div><div>l &lt;- list(df1, df2, df3)</div><div><br></div><div>long_form &lt;- l %&gt;%</div><div>  bind_rows() %&gt;% # Collapse the list into a data.frame. Use dplyr to allow different column names</div><div>  gather(key=gas, value=measurement, -id, -area) %&gt;% # Convert to long form</div><div>  filter(!<a href=\"http://is.na\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792467657385000&amp;usg=AOvVaw2YdccqhVYwP82uEOYzTFbU\">is.na</a>(measurement)) %&gt;% # Only keep complete cases</div><div>  select(id, measurement) # Just pick out the id and measurement columns</div><div><br></div><div>final_df &lt;- merge(target_df, long_form, by=&quot;id&quot;)</div><div><br></div><div>final_df</div></div><div><br></div><div>\r\n<div style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:12px;font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;word-wrap:break-word\"><div style=\"color:rgb(0,0,0);letter-spacing:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;word-wrap:break-word\"><div style=\"color:rgb(0,0,0);letter-spacing:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;word-wrap:break-word\"><div><br>--</div><div>Michael Koontz — <a href=\"http://michaeljkoontz.weebly.com/\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://michaeljkoontz.weebly.com/&amp;source=gmail&amp;ust=1792467657385000&amp;usg=AOvVaw2_4zDdn6E8i9qfldy7WLTu\">website</a></div><div>Graduate Group in Ecology</div><div><a href=\"https://www.google.com/maps/place/Plant+and+Environmental+Sciences+Bldg,+University+of+California,+Davis,+Davis,+CA+95616/@38.5427751,-121.7570251,16z/data=!4m2!3m1!1s0x808529085c693a13:0xe20b0046ee4eb4f7\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.google.com/maps/place/Plant%2Band%2BEnvironmental%2BSciences%2BBldg,%2BUniversity%2Bof%2BCalifornia,%2BDavis,%2BDavis,%2BCA%2B95616/@38.5427751,-121.7570251,16z/data%3D!4m2!3m1!1s0x808529085c693a13:0xe20b0046ee4eb4f7&amp;source=gmail&amp;ust=1792467657385000&amp;usg=AOvVaw1meRkxbq52ugkQ3DGRaYLa\">Plant and Environmental Sciences</a>, Room 2211</div><div>University of California, Davis</div><div>Davis, CA 95616</div><div><br></div><div><br></div></div></div><br></div><br style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:12px;font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px\"><br style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:12px;font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px\">\r\n</div>\r\n<br></div></div></blockquote></div></d