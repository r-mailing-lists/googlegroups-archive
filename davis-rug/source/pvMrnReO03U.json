     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"#467886\" vlink=\"#96607D\" style=\"word-wrap:break-word\">\r\n<div>\r\n<p class=\"MsoNormal\">DataLab is looking for volunteers to help staff the VR and Virtual Reality Sandbox at Picnic Day this year.  We need people from 11:00-2:00 this Saturday in the lobby of Shields Library for shifts in blocks of a couple of hours.<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\">You do not need any experience with VR or VR Sandboxes.  We’ll teach you everything you need to know when you come for your shift. It’s really fun getting to see people’s reactions to this wonderful booth as they experience VR for the first\r\n time.<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\">If you can help, please email Pamela Reynolds <a href data-email-masked rel=\"nofollow\">\r\nplrey...@ucdavis.edu</a><u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\">Best<u></u><u></u></p>\r\n<p class=\"MsoNormal\">Michele<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:11.0pt;color:#1f497d\">Michele Tobias, PhD<u></u><u></u></span></b></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">Geospatial Data Scientist<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">DataLab: Data Science &amp; Informatics<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">UC Davis Library\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">370 Shields Library<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\"><a href=\"tel:(530)%20752-7532\" value=\"+15307527532\" target=\"_blank\" rel=\"nofollow\">(530)752-7532</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\"><a href data-email-masked rel=\"nofollow\"><span style=\"color:#0563c1\">mmto...@ucdavis.edu</span></a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">ORCID: </span><span style=\"font-size:9.0pt;font-family:&quot;Noto Sans&quot;,sans-serif;color:#494a4c;background:white\"><a href=\"https://orcid.org/0000-0002-2954-8710\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://orcid.org/0000-0002-2954-8710&amp;source=gmail&amp;ust=1792464473180000&amp;usg=AOvVaw120gGPmdl10IRSysM2C1dV\"><span style=\"color:#0563c1\">0000-0002-2954-8710</span></a>\r\n</span><span style=\"font-size:11.0pt;color:#1f497d\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;color:#1f497d\">Pronouns: she, her, hers<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n</div>\r\n\r\n"
