     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Reminder that this workshop is tomorrow!  Sign up ahead of time so you’ve got the zoom link when it starts.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Michele<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Michele Tobias, PhD<u></u><u></u></span></b></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Geospatial Data Specialist<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">DataLab: Data Science &amp; Informatics<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Data &amp; Digital Scholarship<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">UC Davis Library\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">370 Shields Library<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><a href=\"tel:(530)%20752-7532\" value=\"+15307527532\" target=\"_blank\" rel=\"nofollow\">(530)752-7532</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><a href data-email-masked rel=\"nofollow\"><span style=\"color:#0563c1\">mmto...@ucdavis.edu</span></a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">ORCID:\r\n</span><span style=\"font-size:9.0pt;font-family:&quot;Noto Sans&quot;;color:#494a4c;background:white\"><a href=\"https://orcid.org/0000-0002-2954-8710\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://orcid.org/0000-0002-2954-8710&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw0W7r7AQ0nE6CNQQ4mCUwP2\"><span style=\"color:#0563c1\">0000-0002-2954-8710</span></a>\r\n</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Pronouns: she, her, hers<u></u><u></u></span></p>\r\n</div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<div>\r\n<div style=\"border:none;border-top:solid #e1e1e1 1.0pt;padding:3.0pt 0in 0in 0in\">\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif\">From:</span></b><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif\"> <a href data-email-masked rel=\"nofollow\">geospatia...@ucdavis.edu</a> &lt;<a href data-email-masked rel=\"nofollow\">geospatia...@ucdavis.edu</a>&gt;\r\n<b>On Behalf Of </b>Matthew Conner<br>\r\n<b>Sent:</b> Tuesday, October 12, 2021 10:46 PM<br>\r\n<b>To:</b> geospatial Sympa List &lt;<a href data-email-masked rel=\"nofollow\">geosp...@ucdavis.edu</a>&gt;<br>\r\n<b>Subject:</b> [geospatial] #maptimeDavis Workshop: Interactive Maps in R Shiny<u></u><u></u></span></p>\r\n</div>\r\n</div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u> <u></u></span></p>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\">  <u></u><u></u></p>\r\n<h1 style=\"margin:0in;margin-bottom:.0001pt;background:white\"><span style=\"font-size:12.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#022851;text-transform:uppercase\">#MAPTIMEDAVIS: INTERACTIVE MAPS IN R SHINY</span><span style=\"font-size:20.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#022851;text-transform:uppercase\"><u></u><u></u></span></h1>\r\n<div style=\"margin-top:12.0pt;margin-bottom:.25in;zoom:1\">\r\n<h2 style=\"margin:0in;margin-bottom:.0001pt;background:white;vertical-align:middle\">\r\n<span><span style=\"font-size:12.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#022851;text-transform:uppercase\">OCTOBER 19 @ 10:00 AM</span></span><span style=\"font-size:12.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#022851;text-transform:uppercase\"> - <span>12:00\r\n PM</span><u></u><u></u></span></h2>\r\n</div>\r\n<div>\r\n<div style=\"margin-bottom:15.0pt\">\r\n<p class=\"MsoNormal\" style=\"background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u> <u></u></span></p>\r\n</div>\r\n<div>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Description</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u><u></u></span></p>\r\n<p style=\"margin-bottom:7.5pt;background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Learn how to create and customize professional-quality, interactive maps in R shiny. Allow users to explore data, provide both spatial and\r\n non-spatial inputs, and receive personalized feedback.<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Learning Objectives</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u><u></u></span></p>\r\n<p style=\"margin-bottom:7.5pt;background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">o Create a local R shiny app with an interactive map<br>\r\no Add customized data to an interactive map<br>\r\no Collect user input (spatial and non-spatial)<br>\r\no Give feedback to user based on combined data and user inputs.<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Prerequisites</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u><u></u></span></p>\r\n<p style=\"margin-bottom:7.5pt;background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">o Introductory knowledge of R<br>\r\no Introductory knowledge of spatial data<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Software</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u><u></u></span></p>\r\n<p style=\"background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">R (version 4.1.0 or newer) and R Studio. Download R at <a href=\"https://cran.r-project.org/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://cran.r-project.org/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw07QS3R2otwJ-lvgqkd6EN9\"><span style=\"color:#5da7ba\">https://cran.r-project.org/</span></a> and\r\n R Studio at <a href=\"https://www.rstudio.com/products/rstudio/download/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rstudio.com/products/rstudio/download/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw34cTRh9MAsOPzXXvzNZjxx\"><span style=\"color:#5da7ba\">https://www.rstudio.com/products/rstudio/download/</span></a><u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Instructor:</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"> Taylor Nelsen<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Instructor Bio</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><u></u><u></u></span></p>\r\n<p style=\"margin-bottom:7.5pt;background:white\"><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Taylor Nelsen is an Assistant Specialist in the Grain Cropping Systems lab in the Department of Plant Sciences at UC Davis. Her research\r\n and extension efforts focus on nitrogen management, plant phenotyping, and variety selection using traditional agronomic methods in conjunction with new technologies such as drones, satellites, and web-based decision support tools.<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Location: </span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Zoom. Please register to receive Zoom link.<u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Registration: </span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"><a href=\"https://registration.genomecenter.ucdavis.edu/events/maptimeDavisInteractiveMapsRshiny/register/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://registration.genomecenter.ucdavis.edu/events/maptimeDavisInteractiveMapsRshiny/register/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw13uSVGwMgTy0BvmRKffOT5\"><span style=\"color:#5da7ba\">https://registration.genomecenter.ucdavis.edu/events/maptimeDavisInteractiveMapsRshiny/register/</span></a><u></u><u></u></span></p>\r\n<p style=\"background:white\"><strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\">Cost:</span></strong><span style=\"font-size:10.5pt;font-family:&quot;Lucida Grande&quot;;color:#333333\"> Free of charge.<u></u><u></u></span></p>\r\n</div>\r\n</div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n<div>\r\n<div>\r\n<div>\r\n<div>\r\n<div>\r\n<div style=\"border:none;border-top:solid #e1e1e1 1.0pt;padding:3.0pt 0in 0in 0in\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u> <u></u></span></p>\r\n</div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">More Upcoming #maptimeDavis Events:</span></b><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">\r\n<u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">October 26, 2021 </span>\r\n<span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-getting-started-with-arcgis-online/\" title=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-getting-started-with-arcgis-online/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-getting-started-with-arcgis-online/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw2iH3NjeZEOwgpLWwF70JtK\"><span style=\"font-size:12.0pt\">I</span></a><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-getting-started-with-arcgis-online/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-getting-started-with-arcgis-online/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw2iH3NjeZEOwgpLWwF70JtK\"><span style=\"font-size:12.0pt\">ntro\r\n to ArcGIS Online</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> - Karen Beardsley</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">November 2, 2021 </span>\r\n<span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-arcgis-field-maps/\" title=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-arcgis-field-maps/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-arcgis-field-maps/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw3f3YGQshPtqD4C41lJkdQ2\"><span style=\"font-size:12.0pt\">ArcGIS\r\n Field Maps (ESRI)</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> - Miriam Schmidts and Canserina Kurnia</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">November 9, 2021 </span>\r\n<span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-postgis-with-crunchy-data/\" title=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-postgis-with-crunchy-data/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-postgis-with-crunchy-data/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw1VEuQMmvXJ5jrPRiIUeKjs\"><span style=\"font-size:12.0pt\">Intro\r\n to PostGIS with Crunchy Data</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> - Steve Pousty</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">November 16, 2021 </span>\r\n<span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-desktop-gis-with-qgis/\" title=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-desktop-gis-with-qgis/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-desktop-gis-with-qgis/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw3g6HATSZTIiPbG_YmWm3MQ\"><span style=\"font-size:12.0pt\">I</span></a><a href=\"https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-desktop-gis-with-qgis/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/eventscalendar/maptimedavis-introduction-to-desktop-gis-with-qgis/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw3g6HATSZTIiPbG_YmWm3MQ\"><span style=\"font-size:12.0pt\">ntro\r\n to Desktop GIS with QGIS</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> -\r\n<span>Michele</span> Tobias</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">*** The full schedule with links to each event is on the\r\n<a href=\"https://datalab.ucdavis.edu/spatial-sciences/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/spatial-sciences/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw1_y5oGThcpSURjm4rO5waN\">Spatial Sciences Research &amp; Learning Cluster</a> page. ***<u></u><u></u></span></p>\r\n<p><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u> <u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">Whenever possible, #maptimeDavis Workshops will be recorded and posted on the </span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://www.youtube.com/channel/UCTooXK1RiSHNbWsmeqz0W6g\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.youtube.com/channel/UCTooXK1RiSHNbWsmeqz0W6g&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw0sDThC08sSgKFKrGuICK6L\"><span style=\"font-size:12.0pt\">DataLab\r\n YouTube channel</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">. #maptimeDavis Studio will not be recorded to encourage open discussion. Weekly reminders will be sent on the </span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://lists.ucdavis.edu/sympa/info/geospatial\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lists.ucdavis.edu/sympa/info/geospatial&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw1MvQmsRdBlaVFaBEBaEB2-\"><span style=\"font-size:12.0pt\">Geospatial\r\n Email List</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">.</span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> </span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\">#maptimeDavis Workshops and Studio are a product of UC Davis DataLab’s </span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href=\"https://datalab.ucdavis.edu/spatial-sciences/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://datalab.ucdavis.edu/spatial-sciences/&amp;source=gmail&amp;ust=1792465150579000&amp;usg=AOvVaw1_y5oGThcpSURjm4rO5waN\"><span style=\"font-size:12.0pt\">Spatial\r\n Sciences Research Cluster</span></a></span><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"> and are supported by the contributions and participation of our community. Please send questions to Michele Tobias </span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\"><a href data-email-masked rel=\"nofollow\"><span style=\"font-size:12.0pt\">mmto...@ucdavis.edu</span></a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif;color:black\"><u></u> <u></u></span></p>\r\n<p><span style=\"font-size:11.0pt;font-f