ks as expected.</font></div><div><font face=\"arial, sans-serif\" size=\"2\"><br></font></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><font face=\"courier new, monospace\"><span style=\"font-size:13px;color:rgb(0,0,0)\">idVars </span><span style=\"font-size:13px;color:rgb(102,102,0)\">&lt;-</span><span style=\"font-size:13px;color:rgb(0,0,0)\"> names</span><span style=\"font-size:13px;color:rgb(102,102,0)\">(</span><span style=\"font-size:13px;color:rgb(0,0,0)\">df</span><span style=\"font-size:13px;color:rgb(102,102,0)\">[,</span><span style=\"font-size:13px;color:rgb(0,102,102)\">1</span><span style=\"font-size:13px;color:rgb(102,102,0)\">:</span><span style=\"font-size:13px;color:rgb(0,102,102)\">9</span><span style=\"font-size:13px;color:rgb(102,102,0)\">])</span><span style=\"font-size:13px;color:rgb(0,0,0)\"><br>dataVars </span><span style=\"font-size:13px;color:rgb(102,102,0)\">&lt;-</span><span style=\"font-size:13px;color:rgb(0,0,0)\"> names</span><span style=\"font-size:13px;color:rgb(102,102,0)\">(</span><span style=\"font-size:13px;color:rgb(0,0,0)\">df</span><span style=\"font-size:13px;color:rgb(102,102,0)\">[</span><span style=\"font-size:13px;color:rgb(0,102,102)\">10</span><span style=\"font-size:13px;color:rgb(102,102,0)\">:</span><span style=\"font-size:13px;color:rgb(0,102,102)\">15</span><span style=\"font-size:13px;color:rgb(102,102,0)\">])</span><span style=\"font-size:13px;color:rgb(0,0,0)\"><br>by_vars </span><span style=\"font-size:13px;color:rgb(102,102,0)\">=</span><span style=\"font-size:13px;color:rgb(0,0,0)\"> idVars</span><span style=\"font-size:13px;color:rgb(102,102,0)\">[</span><span style=\"font-size:13px;color:rgb(0,0,0)\"> !idVars </span><span style=\"font-size:13px\"><font color=\"#666600\">%in% c(&quot;</font></span><font color=\"#666600\">GEO.id2&quot;,</font><span style=\"font-size:13px;color:rgb(0,0,0)\"> &quot;<a