+1 to Jaime’s answer.

Here’s one way to reformat the result to look like what is in the Excel spreadsheet.

foo <- apply(df, MARGIN=2, FUN=table)
foo

# Use the t() function to transpose our matrix-like object
transposed_foo <- t(foo)

# Coerce our object to a data.frame
df_foo <- data.frame(transposed_foo)

# Make a new column called 'Mode' that uses the rownames of the object created with table()
df_foo$Mode <- rownames(df_foo)

# Reorder the columns in the object
d <- df_foo[, c(4, 1, 3, 2)]

# Overwrite the leftover rownames from the original table() call
rownames(d) <- 1:nrow(d)

