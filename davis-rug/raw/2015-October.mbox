The quickest way to get (approximately) this is geom_rug. You can likely adjust the shape of the rug points somehow too:

## first plot (scatterplot)
p1 <- ggplot(plots.fits,aes(x=plot.id <http://plot.id>,y=ppt.coef.mean,colour=ppt.normal)) +

  geom_point(aes(size=ppt.r.sq)) +  #make size of point proportional to R-sq of linear model fit
  geom_errorbar(aes(ymin=ppt.coef.mean-ppt.coef.stderr,ymax=ppt.coef.mean+ppt.coef.stderr))+

  facet_grid(. ~ cluster,scales="free_x",space="free_x")  #plot separate facet for each geographic region, or "cluster"

p1 + geom_rug(sides='b', size=4)

