#code for model by group - this works
modeltst <- datatst %>%
  slice_rows(c("site_id","spcod")) %>%
  by_slice(partial(lm, yvar ~ xvar))

str(modeltst)  #I can see the model results

summary(modeltst$.out[[1]]) #works to see results from one model
coef(modeltst$.out[[1]])  #works to see coeff for one model
modeltst$site_id[1]     #works to see site_id for one model
modeltst$spcod[1]       #works to see spcod for one model
