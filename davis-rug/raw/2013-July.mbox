Hey Patrick,

The code below should be faster, not sure if it's fast enough for your needs.

z <- c(150, 150, 99, 99, 150, 99, 99, 99, 99, 150, 150, 99, 99, 99, 99, 100)

i.low <- which(z < 100)
i.last <- i.low[1]
i.4 <- NA

counter <- 1
for( i in i.low[-1]){
  if(counter == 4) {
    i.4 <- i
    break
  }

  if(i-1 == i.last)
    counter = counter + 1
  i.last <- i
}

