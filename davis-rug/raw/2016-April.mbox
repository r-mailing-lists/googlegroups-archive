Hey Leslie,

Not sure if I totally follow what you are looking for, but here is one way to create such a visualization, using the package 'igraph'.

library <http://inside-r.org/r-doc/base/library>(raster)
library <http://inside-r.org/r-doc/base/library>(igraph <http://inside-r.org/packages/cran/igraph>)
library <http://inside-r.org/r-doc/base/library>(maps <http://inside-r.org/packages/cran/maps>)

set.seed <http://inside-r.org/r-doc/base/set.seed>(111)
# Generate random sample of data points in lon lat
x <- sample <http://inside-r.org/r-doc/base/sample>( seq <http://inside-r.org/r-doc/base/seq>(-110, -114, length.out = 2000), 20)
y <- sample <http://inside-r.org/r-doc/base/sample>( seq <http://inside-r.org/r-doc/base/seq>( 36.98, 42, length.out = 2000),20)
id <- 1:20
map('state','utah')
text <http://inside-r.org/r-doc/graphics/text>(x,y,id)

# generate distance matrix (in meters)
pd <- pointDistance( cbind <http://inside-r.org/r-doc/base/cbind>(x,y), lonlat = TRUE, allpairs = TRUE)

# make symmetrical and inverse (large distances = weaker connection)
pd[upper.tri <http://inside-r.org/r-doc/base/upper.tri>(pd)] <- t <http://inside-r.org/r-doc/base/t>(pd)[upper.tri <http://inside-r.org/r-doc/base/upper.tri>(pd)]
pd <- 1/ pd

# transform to a complete 'graph' (vertex = point, edge = distance)
g <- graph.adjacency(pd, weighted =TRUE, diag <http://inside-r.org/r-doc/base/diag> = FALSE, mode <http://inside-r.org/r-doc/base/mode> = 'undirected')

# here is a simple way visualize joint proximities, by deleting all connections above a certain distance (here, arbitrarily, the 50th percentile of all distances)
g2 <- delete.edges(g, which <http://inside-r.org/r-doc/base/which>(E(g)$weight < quantile <http://inside-r.org/r-doc/stats/quantile>(E(g)$weight, .5)))
plot <http://inside-r.org/r-doc/graphics/plot>(g2)

# There are many other ways to detect clusters/communities among the network and visualize them, e.g.:
fg <- fastgreedy.community(g)
h <- hclust <http://inside-r.org/r-doc/stats/hclust>(fg); plot <http://inside-r.org/r-doc/graphics/plot>(h)

