Hanna,

That seems tougher, but I hacked something together.

See if it works for you?

library(tidyverse)

char_types <- c("S","IL", "SL", "C", "LO")

char_df <-
tibble(one = sample(char_types, 8, replace = TRUE),
two = sample(char_types, 8, replace = TRUE),
three = sample(char_types, 8, replace = TRUE),
four = sample(char_types, 8, replace = TRUE)

)

trans_table <-
tibble(
symb = c("S","IL", "SL", "C", "LO"),
output = list(list(9,5,5), list(80,5,15), list(65,10,25), list(20,65,15), list(40,20,40))
)

iter_func <-
function(df, iter) {
df %>%
mutate(row_num = row_number()) %>%
gather(., key, value, -row_num) %>%
full_join(., trans_table, by = c("value" = "symb")) %>%
mutate(output = map_dbl(output, ~pluck(., iter))) %>%
select(-value) %>%
spread(., key, output) %>%
select(-row_num)
}

iter_vec <- c(1,2,3)

map(iter_vec, ~ iter_func(char_df, .))

HTH,
B

