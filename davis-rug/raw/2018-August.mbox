> > > > > > > > tibble(
> > > > > > > > symb = c("S","IL", "SL", "C", "LO"),
> > > > > > > > output = list(list(9,5,5), list(80,5,15), list(65,10,25), list(20,65,15), list(40,20,40))
> > > > > > > > )
> > > > > > > > purrr::map(char_vec, function(x) filter(trans_table, symb == x) %>% pull(output) %>% unlist) %>%
> > > > > > > > unlist %>%
> > > > > > > > matrix(., c(3, length(char_vec), 1))
> > > > > > > >
> > > > > > > > , , 1
