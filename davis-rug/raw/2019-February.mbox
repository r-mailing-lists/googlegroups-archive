  arrange(IDs, timestamp) %>%
  group_by(IDs, trip) %>%
  mutate(GIStrip = if_else(n_distinct(GIS, na.rm = TRUE) > 1, "MIXED", GIS))
with Error in mutate_impl(.data, dots) :
