Sorry for spamming, more typos, fixed them all:

library(raster)
library(ggplot2)
r1 <- raster(nrows=10, ncols=10);r1 <- setValues(r1, sample(-10:10, ncell(r1), replace=T))
r2 <- raster(nrows=10, ncols=10);r2 <- setValues(r2, sample(-10:10, ncell(r2), replace=T))
r3 <- raster(nrows=10, ncols=10);r3 <- setValues(r3, sample(-10:10, ncell(r3), replace=T))

#Take mean
avg <- mean(r1,r2,r3)

#multiply rasters together, matching signs will end up positive

r4 <- r1 * r2

r5 <- r2 * r3
r6 <- r1 * r3

#compare for sign

sign <- ifelse(values(r4) > 0 | values(r5) > 0 | values(r6) > 0, 1, 0)

#extract the cell coordinates

crd <- as.data.frame(coordinates(res))
crd[,3] <- sign

#delete the rows where val is 0
i <- which(crd[,3] == 0)
crd <- crd[-i,]

plot(avg)
points(crd, pch=3, cex=5)

