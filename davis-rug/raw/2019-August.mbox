Might help.. Just a quick and dirty solution but I have to run now...

ls <-
lapply(list(a,b,c), function(x) select(x, -id))

#Select unique id's
ids <-
bind_rows(ls) %>%
  select(name) %>%
  unique() %>%
  filter(name!= c("NA","")) %>%
  unlist %>% as.character()

for(i in ids){
  df <-
  lapply(ls, function(x) {filter(x,name == i) %>% select(-name)}) %>%
    bind_cols() %>% tbl_df()
  df$name <- i
print(df)
  }

