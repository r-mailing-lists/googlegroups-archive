Patrick is right.

require(readr)
require(dplyr)
require(ggplot2)

inverts3 <- read_csv("~/Downloads/inverts3.csv")

Sample.type <- unique(inverts3$Sample.type)
target <- unique(inverts3$target)

expand.grid(Sample.type = Sample.type, target = target, stringsAsFactors=FALSE) %>%
full_join(., inverts3) %>%
ggplot(., aes(x=target, y= mdiet, fill = Sample.type)) +

geom_bar(stat = "identity", position = "dodge") +
geom_errorbar(aes(ymax= mdiet + sediet, ymin = mdiet - sediet), position = "dodge") +
ylab("proportion of catch important to fish diets") +
ylim(0,1)

Does that do what you want Rosemary?

B

