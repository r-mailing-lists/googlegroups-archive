Thanks! Right after I sent this email I thought of checking the ggplot2 listserv, and found another solution, though it takes a little finagling

# set up a vector of labels as character strings with quotes around them (note the double quotes)
lab = c("'Gammarus sp'", "'Crangonyx sp'", "'Hyalella sp'", "'Camptocerus sp'",   "'Daphnia sp'", "'Calanoida'", "'Cyclopoida'", "'Ostracoda'", "'Chironoid larvae'", "'Other'")

#now set up the graph
fig1+ facet_grid(CT~Location)  +

  geom_bar(stat = "identity", position = "stack") +

# parse the terms "italic" and "plain" before the labels
  scale_fill_manual(name = "Taxon", labels = parse(text=c(paste('italic(',lab[1:5],')'),
                                                                         paste('plain(',lab[-c(1:5)],')'))))

