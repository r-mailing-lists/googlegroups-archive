Try gather() followed by a self-join:

require(tidyverse)

familyID = sample(letters, 5, replace = FALSE)
site01 = sample(c(0,1), 5, replace=TRUE)
site02 = sample(c(0,1), 5, replace=TRUE)
site03 = sample(c(0,1), 5, replace=TRUE)

dataf = data_frame(familyID, site01, site02, site03)

dataf %>%
    gather(site, value, -familyID) %>%
    full_join(., ., by = 'familyID') %>%
    filter(site.x < site.y) %>%
    mutate(site.comb = value.x > 0 & value.y > 0) %>%
    group_by(site.x, site.y) %>%
    summarize(connections = sum(site.comb))

Dan

