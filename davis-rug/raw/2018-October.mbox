THere are still a few bugs, but I fixed some of the problems in your origional code. I don't have the points scaled by size, you'll have to add your scaling variable into your "combs" data frame.

x <- match(names(pass)[-1], names(pass))
MAT <- outer(x, x, paste)
combs <- t(sapply(MAT[lower.tri(MAT)], function(x) as.numeric(unlist(strsplit(x, " ")))))

plotter <- function(cn, df) {

  #  title <- paste(“~/Figures_Matrix", x2, "_", x2, "_", x3, ".png", sep="")
  NAMES <- colnames(df)[cn]

  df2 <- df[,cn]

  names(df2)<- c('x1', 'x2')

  p <- ggplot(data=df2, aes(x1, x2)) + geom_point() + theme_bw() + #color=Region +
   # scale_x_continuous(name=NAMES[1]) +
  #  scale_y_continuous(name=NAMES[2])
  dev.new <http://dev.new>()
  print(p)
}

#I started with just the first 10 combinations
apply(combs[1:10,],  1, function(x) plotter(cn=x, df = pass))

