I tried changing it from pseudocode to R code. I wonder if anyone could look over it.

CheckRev <- function(t, i, a){

  for (j in c(i+1, (t+1)/2)) {

    if (a[j] < a[t- j +1]) {
        return(0)
    if (a[j] > a[t - j + 1]){
          return(-1)
    } else {
          return(1)
    }
  }
}
}

GenBracelets <- function(t, p, r, u, v, RS, a){
  n = length(a) # Jay Code #1
  k = length(set(a)) # Jay Code #2

  if (t - 1 > (n-r) / 2) {
    if (a[t - 1] > a[n - t + 2 + r]) {
      RS = FALSE
    }
    else if (a[t-1] < a[n-t+2+r]){
      RS = TRUE
    }
    if (t > n) {
      if (RS == FALSE && n %% p == 0){
        print()
      }
    }
    else {
      a[t] = a[t-p]
      if (a[t] == a[0]){

        v = v + 1
      } else {v = 0}

      if (u == t-1 && a[t=1] == a[1]){
        u = u+1
      }
      if (t == n && u != n && a[0] == a[1]){
        #pass
      }
      else if (u == v){
        rev = CheckRev(t, u, a)
        if (rev == 0){
          GenBracelets(t+1, p, r, u, v, RS)
        }
        if (rev == 1){
          GenBracelets(t+1, p, r, u, v, FALSE)
        }
      }
      else {GenBracelets(t+1, p, r, u, v, RS)}
      if (u == t) {u= u-1}

      for (j in c(a[t-p],k-1)){
        a[t] = j
        if (t == 1) {
          GenBracelets(t+1, t, r, 1, 1, RS)
        }
        else {GenBracelets(t+1, t, r, u, 0, RS)}

      }
    }
    }
}

