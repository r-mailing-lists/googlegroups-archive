>
> septicemia <- c("0380", "0381", "0382", "0383", "0384", "03840")
>
> # Goes through each row, and determines if any value within the three diagnosis columns matches any of the values within septicemia. This becomes your logical indexing vector for admissions.
>
> idx <- apply(df[, c("diagnosis1", "diagnosis2", "diagnosis3")], MARGIN=1, FUN=function(x)(sum(x %in% septicemia) > 0))
