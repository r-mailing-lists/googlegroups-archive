Sorry, that's going to cause an error due to the first/last row not existing.

growthcalc <- function(dtf,n){
  dtf$out <- NA
  for (i in 1:nrow(dtf)){

     if (i+n >= 1 & i+n <= nrow(dtf)){ #otherwise we leave it NA

        dtf[i,"out"] <- dtf[i+n,"growth"]
     }
 }
  return(dtf$out)
}

