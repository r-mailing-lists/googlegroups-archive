Yes, I need help again...  I am getting mentally tired so not "getting it" from my searches and poster needs to be printed yesterday.  Why I am trying to learn R last minute? I am crazy.

I want to export this plot into a pdf but I am not sure how to do it so I get all of it... the way I am trying only outputs the scatter plot.  Its probably so simple yet I can't figure it out.  I had boxplots on this too but could not get them to behave.

code:

names(trunk)=c("trunkdia","carbon")
trunk$trunk2=(trunk$trunkdia)^2
trunk$trunkS=scale(trunk$trunkdia,scale=F)
trunk$trunkS2=(trunk$trunkS)^2
####### calculation of the coefficient
m=coef(lm(trunk$carbon ~ trunk$trunkdia + trunk$trunk2-1,trunk=trunk))
cint=confint(lm(trunk$carbon ~ trunk$trunkdia + trunk$trunk2-1,trunk=trunk))
####### your statistics
summary(lm(trunk$carbon~ trunk$trunkS + trunk$trunkS2,trunk=trunk))
########## plot of the quadratic regression + confidence interval
# quadratic
quadratic<-lm(trunk$carbon ~ trunk$trunkdia+I(trunk$trunkdia^2))
summary(quadratic)
cq = coef(quadratic)
plot(trunk$carbon~ trunk$trunkdia,ylim=c(0,max(trunk$carbon)),xlim=c(0,max(trunk$trunkdia)), cex.axis=1.5,
xlab="Trunk Diameter (mm)",
ylab=expression(Wood ~ C ~(kg ~ C ~ vine^{-1})), cex.lab=1.5, pch=20, cex=1,)
curve(m[1]*x+m[2]*x*x,add=T)
curve(cint[1,1]*x+cint[2,1]*x*x,add=T,lty=2,col=2)
curve(cint[1,2]*x+cint[2,2]*x*x,add=T,lty=2,col=2)
coefs <- coef(lm(trunk$carbon~ trunk$trunkS + trunk$trunkS2,trunk=trunk))
b0 <- round(coefs[1],2)
b1 <- round(coefs[2],2)
r2 <- round(summary(lm(trunk$carbon~ trunk$trunkS + trunk$trunkS2,trunk=trunk))$r.squared, 2)
eqn <- bquote(italic(y) == .(round(m[1],30))*italic(x) + .(round(m[2],30))*italic(x^2)  ~~~  r^2 == .(r2), options(digits=2))
text(1, 5.5, eqn, cex = 1, adj=c(0,0))

pdf("Wood_Dia6.pdf", par(family="Times"))
plot(trunk$carbon~ trunk$trunkdia)
dev.off()

