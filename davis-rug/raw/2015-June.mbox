Use the start= º option in coord_polar()
?coord_polar

ggplot(my_data, aes(x = factor(1), y = percentage, fill = fraction)) +
geom_bar(width = 1, colour = "black", stat = "identity") +
guides(fill = FALSE) +

geom_text(aes(x = 1.70, y = y_breaks, label = y_labels, hjust = c(NA, NA, NA)) , size = 7, family="Times") +

geom_text(aes(x = 1.2, y = y_breaks, label = paste0(y_percentage, "%")), size = 7, family="Times", colour = c("black", "black", "black")) +

coord_polar(theta = "y", start=77) +

scale_fill_manual(values = c("plum4", "grey","powderblue")) +
theme_bw() +
theme(panel.grid.minor = element_blank(),
        panel.grid.major = element_blank(),
        panel.border = element_blank(),
        plot.margin = unit(c(0, 0, -0.5, 0),"cm"),
        axis.title = element_blank(),
        axis.text = element_blank(),
        axis.ticks = element_blank()
)

Thing is, I can't figure out what angle to get it started so Carbon is the horizontal. :/

B

