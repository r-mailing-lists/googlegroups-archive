You'll need to fix your equations, they weren't bracketed properly, but going on what you wrote:

out will return the P and min LSE for each jar for each time step

data <- read.csv("recursion2.csv")
data$mi <- rep(data$m[1:72], 5)
data$ni <- rep(data$n[1:72], 5)
out <- data.frame(jar=data$jar, t=data$t)

#need starting values outside the range of possibility
out$lse_min <- 10000
out$p <- 1000000

for (i in -10000:10000){
out$mt <- (i/data$k)-((i/data$k)-data$mi^(-data$k*data$t))

out$nt = ((data$ni^(-data$k*data$ap*data$t))/((i/data$k)-((i/data$k)-data$mi)^(-data$k*data$t)))*mt

 out$lse <- ##put the equation here##

out$lse_min <- ifelse(out$lse < out$lse_min, out$lse, out$lse_min)
out$p <- ifelse(out$lse < out$lse_min, i, out$p)
}

test this from, say -10 to 10 first, I can't test it because of the equation issues.

