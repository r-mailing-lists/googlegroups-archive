Something like:

x <- read.csv(SampleData.csv)

x$comp <- NA

fun <- function(x, comp){
  out <- rep(NA, 1:length(x))
   i <- which(x > comp)
  out[i] <- "gt"
   i <- which(x < comp)
   out[i] <- "lt"

   out
}

result <- apply(x,2, FUN=fun, comp=x$comp)

