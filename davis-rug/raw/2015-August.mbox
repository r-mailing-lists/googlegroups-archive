library('inline')
set.seed(1)
# The definitions of variables
## N: Sample Size
## boot.n: the size of bootstrap sampling
## q: the dimension of
## beta:
## eta: bandwith of kernel density estimator
## xi: bandwith of kernel density estimation for bootstrap
## beta_n: bootstrap beta_n
## lambda: The specific positive constant, the level
## bn_hat: estimate
## zn_star: bootstrap process

# First Step
## ======================================================================

## Choose underlying density F
## E.g. normal distribution ------> rnorm
## e.g. mean = 0, standard deviation = 1

## ======================================================================
## Second Step
## Choose sample size N
## e.g. N = 100
## Original Data

## ======================================================================
## Third Step
## fix bandwidth level to find kernel density estimation \hat{f}_{n, h}

## pdf of kernel density estimation
#mygaussian = function(n, h, x, X)
#{
## n: sample size
## h: bandwidth
## x: desired data point
## X: sample data points
#  u = (x - X)/h
#  K = sum((1/sqrt(2*pi))*exp(-0.5*(u^2)))/(n*h)
#  K
#}
get.band <- function(X1, X2, d){
  ## X1: first direction vectors
  ## X2: second direction vectors
  ## d: dimension
  sd1 = sd(X1)
  sd2 = sd(X2)
  n = length(X1)
  x = 1/(d + 4)
  H1 = ((4/(d + 2))^x)*(n^(-x))*sd1
  H2 = ((4/(d + 2))^x)*(n^(-x))*sd2
  c(H1, H2, mean(H1, H2))
}

mygaussian.multi <- cfunction(c(x1 = "numeric", x2 = "numeric", X1 = "numeric", X2 = "numeric", h1 = "numeric", h2 = "numeric"), "
                              int n_x = length(x1);
                              int n_X = length(X1);
                              double tmp = 0;
                              double *px1, *px2, *pout, *pX1, *pX2;
                              SEXP out = PROTECT(allocVector(REALSXP, n_x));

                              px1 = REAL(x1);
                              px2 = REAL(x2);
                              pX1 = REAL(X1);
                              pX2 = REAL(X2);
                              pout = REAL(out);
                              for (int i = 0; i < n_x; i++){
                              tmp = 0;
                              for(int j = 0; j < n_X; j++){
                              tmp = (1/(2*n_X*asReal(h1)*asReal(h2)*M_PI))*exp(-0.5*(pow((px1[i] - pX1[j])/asReal(h1),2) + pow((px2[i] - pX2[j])/asReal(h2), 2))) + tmp;
                              }
                              pout[i] = tmp;
                              }
                              UNPROTECT(1);

                              return out;
                              ")

truegaussian.multi <- cfunction(c(x1 = "numeric", x2 = "numeric"), "
                                int n_x = length(x1);
                                double *px1, *px2, *pout;
                                SEXP out = PROTECT(allocVector(REALSXP, n_x));

                                px1 = REAL(x1);
                                px2 = REAL(x2);
                                pout = REAL(out);
                                for (int i = 0; i < n_x; i++){
                                pout[i] = (1/(2*M_PI))*exp(-0.5*(pow(px1[i], 2) + pow(px2[i], 2)));
                                }
                                UNPROTECT(1);

                                return out;
                                ")

# mygaussian.multi <- function(h, x, X1, X2, lambda, beta){
#  n = length(X1)
#  sum(1/(2*pi*h[1]*h[2]*n)*exp(-0.5*(((x[1] - X1)/h[1])^2 + ((x[2] - X2)/h[2])^2)))
#}
# mygaussian.multi(H, c(1.24, 1.152), X1, X2, 0, 0)

## step 3

## Random sample from kernel density estimator
## n: The desired number of random samples
## m: The maximum of the kernel density estimation
## X1: The x direction
## X2: The y direction
## low: The lower bound of the function
## upper: The upper bound of the function
my.rgaussian <-
  function(n, m, h, X1, X2, low, upp)
  {
    i = 1
    z = matrix(0, n, 2)
    while(i <= n){
      x = runif(1, low, upp)
      y = runif(1, low, upp)
      u = runif(1, 0, 1) * m  # maximum
      fx = mygaussian.multi(x1 = x, x2 = y, h1 = h[1], h2 = h[2], X1 = X1, X2 = X2)
      if(u < fx){
        z[i, ] = c(x, y)
        i = i + 1
      }
    }
    z
  }

## The bootstrap function
## maximum: The largest value of the estimated density
## eta: The bandwidth of kernel density
## n: The number of the random sample
## Origin.data: Original random sample
## lambda: desired Y value
## c1: The constant to control the bandwidth
## c2: The constant to control \hat beta_n
## c3: The constant to control the condition 1
## c4: The constant to control the condition 2
## low: The lower boundary of the estimated density
## upper: The upper boudary of the estimated density

mybootstrap = function(maximum, m, eta, n, X1, X2, x, y, lambda, c1 = 1, c2 = 1, low = -4, upp = 4){
  b = numeric(m)
  for(i in 1:m){
    ## Get bootstrap samples
    rg = my.rgaussian(n = n, m = maximum, h = eta, X1 = X1, X2 = X2, low = low, upp = upp)
    ## Get bootstrap sample's bandwidth
    xi = get.band(X1 = rg[, 1], X2 = rg[, 2], d = 2)
    ## Choose beta_n:
    beta_n = c1*eta[3]/log(n)
    ## Check condition
    ## Condition 1:
    if(beta_n >= c2/(n*eta[3]^6*log(n)))
      warning("The condition 1 is not satisfied!")
    ind.temp = which(lambda - beta_n < y & y < lambda + beta_n, arr.ind = TRUE)
    est.value = y[lambda - beta_n < y & y < lambda + beta_n]
    boot.value = mygaussian.multi(x1 = x[ind.temp[, 1]],
                                  x2 = x[ind.temp[, 2]], X1 = rg[, 1],
                                  X2 = rg[, 2], h1 = xi[1], h2 = xi[2])
    b[i] = max(abs(est.value - boot.value))
  }
  quantile(b, 0.95, type = 5)
}

## Whole process
all.process <- function(M, n, mean, sd, m, lambda, len, ind.true, x, c1 = 1, c2 = 1, low = -4, upp = 4){
  ind = vector(mode = "list", length = M)
  cov = 0L
  for(i in 1:M){
    X1 = rnorm(n = n, mean = mean, sd = sd)
    X2 = rnorm(n = n, mean = mean, sd = sd)
    eta = get.band(X1 = X1, X2 = X2, d = 2) # get bandwidth by wikipedia of thumb of rules
    y = outer(x, x, mygaussian.multi, X1 = X1, X2 = X2, h1 = eta[1], h2 = eta[2])
    maximum = max(y) # get maximum
    z = mybootstrap(maximum = maximum, m = m, eta = eta, n = n,
                    X1 = X1, X2 = X2, x = x, y = y, lambda = lambda,
                    c1 = 1, c2 = 1, low = low, upp = upp)
    y.est = mygaussian.multi(x1 = x[ind.true[, 1]], x2 = x[ind.true[, 2]],
                             X1 = X1, X2 = X2, h1 = eta[1], h2 = eta[2])
    if(sum(lambda - z < y.est & y.est < lambda + z) == length(y.est)){
      cov =  cov + 1
    }
    ind[[i]] = which(lambda - z < y & y < lambda + z, arr.ind = TRUE)
  }
  list(ind, cov)
}

## =====================================================================================
lambda = 0.05
beta = 0.001
x = seq(-4, 4, length = 1000)
y.true = outer(x, x, truegaussian.multi)
ind.true = which(y.true > lambda - beta & y.true < lambda + beta, arr.ind = TRUE)
all.process(M = 2, n = 1000, mean = 0, sd = 1, m = 2, lambda = lambda, len = 100, ind.true = ind.true, x = x)
## ======================================================================================
