I'm not sure how R manages the memory for this, but my first inclination would
be to make a data-summary pass over your data file, reading it one line at a
time, always reading the line into the same buffer, and then writing selected
lines to a data-summary file.  Please see the appended for a toy example.

- -- Mike

$ cat read-line-by-line.R
inputFile <- file("some-lines.txt", open="r")
outputFile <- file("summary.txt", open="w")

previousTime <- 0

while (length(nextLine <- readLines(inputFile, n=1, warn=FALSE)) > 0) {
    nextItems <- unlist(strsplit(nextLine, split=" ", fixed=TRUE))

    currentTime <- as.numeric(nextItems[3])

    if (floor(currentTime) != floor(previousTime)) {
        cat (nextLine, "\n", file=outputFile, append=TRUE)
    }

    previousTime <- currentTime
}

close(inputFile)
close(outputFile)

##########

$ cat some-lines.txt
1 3 5
2 4 6
2 4 6
3 5 7
3 5 7
3 5 7
4 6 8
4 6 8
4 6 8
4 6 8
4 6 8

$ R --vanilla < read-line-by-line.R

$ cat summary.txt
1 3 5
2 4 6
3 5 7
4 6 8

