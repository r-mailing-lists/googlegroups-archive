> > > > sub.thresh <- 0
> > > > modality <- 'fmri'
> > > >
> > > > # trying another way to define inds
> > > > groups <- c('Pre', 'Post')
> > > > covar <- data.frame(Study.ID = c('p21','p22','p32','p38'), Group = rep(groups, each = 4))
> > > > covar <- data.table::data.table(covar)
