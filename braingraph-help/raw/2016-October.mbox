Hi Cris,

I created a function for cloness cent. What should I type to see the difference after permutation ?

close.diffs.perm <- function(g1, g2, density) {
  clo.diff <- centr_clo(g1)$res - centr_clo(g2)$res
  tmp <- data.table(cbind(density, t(clo.diff)))
}

clnss.diffs <- plyr::adply(densities[N], .margins=1, function(x)
permute.group(myPerms[1:1e4, ], x,
resids.all, 'other',
.function=close.diffs.perm),
.progress='text', .id=NULL)

setDT(clnss.diffs)

p.cloness <- plot_perm_diffs(g[[1]], g[[2]], clnss.diffs, '???',
                              level='vertex', groups=groups)

Thanks in advance,
Onur

