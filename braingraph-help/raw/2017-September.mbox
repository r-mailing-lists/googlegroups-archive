Vertex Level

kNumPerms <- 1e3

myPerms <- permute::shuffleSet(n=nrow(resids.all), nset=kNumPerms)

perms.btwn <- adply(densities[N:(N+1)], .margins=1, function(x)

 permute.group(myPerms[1:1e3, ], x, resids.all, 'vertex'),

 .progress='text',.id=NULL)

setDT(perms.btwn)

setnames(perms.btwn, 2:(kNumVertices+1), V(g[[1]][[N]])$name)

EigenVector Cent

evcent.diffs.perm <- function(g1, g2, density) {
  ev.diff <- centr_eigen(g1)$vector - centr_eigen(g2)

$vector
  tmp <- data.table(cbind(density, t(ev.diff)))
}

ev.diffs <- plyr::adply(densities[N], .margins=1, function(x)
permute.group(myPerms[1:1e3, ], x,
resids.all, 'other',
.function=evcent.diffs.perm),
.progress='text', .id=NULL)

setDT(ev.diffs)

p.perm.btwn <- plot_perm_diffs(g[[1]], g[[2]], ev.diffs, 'ev.cent',

 level='vertex', groups=groups)

p.perm.btwn$dt[p < 0.05, .SD[1], by=.(density, region)]

