> > modality <- 'fmri'
> > thresholds <- 0.2
> > sub.thresh <- 0.5
> > my.mats <- create_mats(matfiles$A, modality=modality,
> > mat.thresh=thresholds, sub.thresh=sub.thresh, inds=inds)
> > A.norm.sub <- my.mats$A.norm.sub
> > A.bin <- my.mats$A.bin
> > A.norm.mean <- my.mats$A.norm.mean
