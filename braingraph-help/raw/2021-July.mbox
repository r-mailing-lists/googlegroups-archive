> make_brainGraph(A.norm.sub[[1]][, , 1], atlas = atlas, modality = modality, weighting = "sld", threshold = thresholds[1],
weighted = TRUE, name = covar.sna$Study.ID[1], Group = covar.sna$Group[1])
