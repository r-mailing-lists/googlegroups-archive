     "\r\n  \r\n\r\n    \r\n  \r\n  <div text=\"#000000\" bgcolor=\"#FFFFFF\">\r\n    <br>\r\n    <div>-------- Missatge original\r\n      --------\r\n      <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\r\n        <tbody>\r\n          <tr>\r\n            <th nowrap valign=\"BASELINE\" align=\"RIGHT\">Assumpte:\r\n            </th>\r\n            <td>SEA - Informació pròxims cursos</td>\r\n          </tr>\r\n          <tr>\r\n            <th nowrap valign=\"BASELINE\" align=\"RIGHT\">Data: </th>\r\n            <td>Fri, 11 Oct 2013 09:11:41 +0200</td>\r\n          </tr>\r\n          <tr>\r\n            <th nowrap valign=\"BASELINE\" align=\"RIGHT\">De: </th>\r\n            <td>Servei d&#39;Estadística UAB <a href data-email-masked rel=\"nofollow\">&lt;s.esta...@uab.cat&gt;</a></td>\r\n          </tr>\r\n          <tr>\r\n            <th nowrap valign=\"BASELINE\" align=\"RIGHT\">A: </th>\r\n            <td><a href data-email-masked rel=\"nofollow\">sea-con...@llistes.uab.cat</a>,\r\n              <a href data-email-masked rel=\"nofollow\">sea-con...@llistes.uab.cat</a></td>\r\n          </tr>\r\n        </tbody>\r\n      </table>\r\n      <font size=\"+1\" color=\"#000099\"><br>\r\n        Benvolguts companys i companyes,<br>\r\n        <br>\r\n        <br>\r\n        El Servei d&#39;Estadística Aplicada té el plaer d&#39;anunciar-vos els\r\n        propers CURSOS DEL SEA:<br>\r\n      </font>\r\n      <ul>\r\n        <li><font size=\"+1\" color=\"#000099\"><b>Curs d&#39;introducció a\r\n              l&#39;Estadística amb Deducer</b></font><font size=\"+1\" color=\"#000099\">, que es realitzarà els dies 11, 13, 18 i 20\r\n            de Novembre.    <a href=\"http://sct.uab.cat/estadistica/content/curs-dintroducci%C3%B3-lestad%C3%ADstica-b%C3%A0sica-amb-deducer\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://sct.uab.cat/estadistica/content/curs-dintroducci%25C3%25B3-lestad%25C3%25ADstica-b%25C3%2