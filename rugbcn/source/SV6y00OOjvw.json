margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">(antes del 5 de Febrero)</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">\n1 asist</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">300,00 €</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">\n 300,00 €</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\"> 200,00 €</td></tr><tr style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n<td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">Inscripción <br style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n(despuésdel 5 de Febrero)</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">1 asist</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">\n450,00 €</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\"> 450,00 €</td><td style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:3px;padding-right:3px;padding-bottom:3px;padding-left:3px\">\n 300,00 €<br><br></td></tr></tbody></table><p></p><p></p><h4 style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0.5em;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;font-weight:700;color:rgb(42,111,173);font-family:Verdana,Arial,Helvetica;line-height:18px;background-color:rgb(255,255,255)\">\n<strong style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\"><br></strong></h4><h4 style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0.5em;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;font-weight:700;color:rgb(42,111,173);font-family:Verdana,Arial,Helvetica;line-height:18px;background-color:rgb(255,255,255)\">\n<strong style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">Programa del curso:</strong></h4><h3 style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0.5em;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;font-family:Arial;color:rgb(42,111,173);line-height:18px;background-color:rgb(255,255,255)\">\n<strong style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">Sesión 1: Introducción a R</strong><ul style=\"margin-top:0px;margin-right:0px;margin-bottom:1.5em;margin-left:2em;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;color:rgb(92,96,99)\">\n- Instalación de R.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">- Generalidades de R.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n- Instalación de librerías.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">- Vectores y matrices.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n- Listas y data frames.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">- Importar y exportar datos.</ul></h3><h3 style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0.5em;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;font-family:Arial;color:rgb(42,111,173);line-height:18px;background-color:rgb(255,255,255)\">\n<strong style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">Sesión 2: Gestión de bases de datos<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n</strong><ul style=\"margin-top:0px;margin-right:0px;margin-bottom:1.5em;margin-left:2em;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px;color:rgb(92,96,99)\">- Gestión de bases de datos.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n- Validación de bases de datos.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">- Fundir archivos.<br style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-left:0px\">\n- Transponer datos.</ul></h3><h3 style=\"font-size:12px;margin-top:0px;margin-right:0px;margin-bottom:0.5em;margin-left:0px;padding-top:0px;padding-right:0px;padding-bottom:0px;padding-lef