t medium medium;border-style:solid solid none none;border-color:windowtext windowtext -moz-use-text-color -moz-use-text-color;padding:0cm;height:15pt\" width=\"50%\"><br>\r\n    </td>\r\n  </tr>\r\n  <tr style=\"height:15pt\">\r\n    <td style=\"width:8.92%;border-width:1pt medium medium 1pt;border-style:solid none none solid;border-color:windowtext -moz-use-text-color -moz-use-text-color windowtext;padding:0cm;height:15pt\" width=\"8%\">\r\n      <p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"color:black\">11:15-12:00 </span></p>\r\n    </td>\r\n    <td style=\"width:22.16%;border-width:1pt medium medium;border-style:solid none none;border-color:windowtext -moz-use-text-color -moz-use-text-color;padding:0cm;height:15pt\" width=\"22%\">\r\n      <p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"color:black\">Jordi Garcia </span></p>\r\n    </td>\r\n    <td style=\"width:18.58%;border-width:1pt medium medium;border-style:solid none none;border-color:windowtext -moz-use-text-color -moz-use-text-color;padding:0cm;height:15pt\" width=\"18%\">\r\n      <p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"color:black\">Centre d’investigació en Agrigenòmica (CRAG) </span></p>\r\n    </td>\r\n    <td style=\"width:50.34%;border-width:1pt 1pt medium medium;border-style:solid solid none none;border-color:windowtext windowtext -moz-use-text-color -moz-use-text-color;padding:0cm;height:15pt\" width=\"50%\">\r\n      <p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"color:black\" lang=\"EN-US\">Genomic tools for plant breeding: the genome of melon </span></p>\r\n    </td>\r\n  </tr>\r\n  <tr style=\"height:15pt\">\r\n    <td style=\"width:8.92%;border-width:1pt medium medium 1pt;border-style:solid none none solid;border-color:windowtext -moz-use-text-color -moz-use-text-color windowtext;padding:0cm;height:15pt\" width=\"8%\">