>> >   beta_boot<-vector(length=nboot)
>> >   se_boot<-vector(length=nboot)
>> >   HR<-vector(length=5)
>> >   mv2<-vector(length=2)
>> >   vboot<-vector(length=2)
>> >   n<-dim(dat24)
>>
>> >   ###calibration model
>> >   mod<-lm(datq[,pos2]~datq[,pos1]+Age_Recr,weights(Ws1), data=datq,
>> >  na.action=na.omit)
>> >   coefi<-mod$coefficients
>>
>> >   datq$db_pr<-coefi[1]+coefi[2]*datq[,pos1]+coefi[3]*datq$Age_Recr
>> >   w<- sigu/(sige+sigu/k)
>> >   calib<-ifelse (!is.na <http://is.na>(datq[,pos2]),
>> > calib<-w*datq[,pos2]+(1-w)*datq$db_pr, calib<-(1-w)*datq$db_pr)
