>> >    #calibrated cox model
>>
>> >   mod_calib<-coxph(Surv(fwuptime,GA_studi_frst) ~ lgcalib +
>> > strata(len),data=datq)
>>
>> >     HR[1]<-exp(mod_calib$coefficients)
>> >     HR[2]<-HR[1]*exp(-1.96*sqrt(v_boot))
>> >     HR[3]<-HR[1]*exp(1.96*sqrt(v_boot))
>> >     HR[4] <- v_boot
>> >     HR[5] <- mean(se_boot)
>>
>> >     rm (v_2, mv2, datq, dat24)
>> >     return (HR)
>>
>> > }
>>
>> > El que fa la funció és crear una bbdd, a partir d'unes distribucions
