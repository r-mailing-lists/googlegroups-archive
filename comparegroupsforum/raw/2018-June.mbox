ui <- fluidPage(
    titlePanel("Tests of Association"),

    # Sidebar

    sidebarLayout(
      sidebarPanel(
        HTML('</br>'),
        selectInput("facilitypick", h5("Choose a Facility:"), choices = c("All Facilities","Facility A","Facility B","Facility C")),
  # main panel

    mainPanel(
