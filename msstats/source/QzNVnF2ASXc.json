    [
     1,
     "Corrected answer. This logic was changed since v3.5.5.<div><br></div><div>MBimpute=TRUE : imputation, with model-based value</div><div>MBimpute=FALSE : no imputation </div><div><br></div><div>- Meena<br><br></div>"
    ],
    [
     3,
