Hi,

Runs should be a problem, but you can try appending a letter to this column.
Please run the following code to see what is the error returned by model fitting function:

library(MSstats)

# quant_diann = your dataProcess output
cm = MSstatsContrastMatrix("pairwise", unique(quant_diann$ProteinLevelData$GROUP)) # just for testing
repeated = MSstats:::checkRepeatedDesign(quant_diann)
samples_info = getSamplesInfo(quant_diann)
groups = unique(quant_diann$ProteinLevelData$GROUP)

split_summarized = MSstatsPrepareForGroupComparison(quant_diann)
groups = colnames(cm)
has_imputed = FALSE
# MSstatsGroupComparisonSingleProtein(split_summarized[[1]], cm, repeated, groups, samples_info, T, F)

single_protein = split_summarized[[1]] # or change 1 to index of protein for which model fitting fails
single_protein = MSstats:::.prepareSingleProteinForGC(single_protein)
is_single_subject = MSstats:::.checkSingleSubject(single_protein)
has_tech_reps = MSstats:::.checkTechReplicate(single_protein)
fitted_model = MSstats:::.fitModelSingleProtein(single_protein,
                                                cm, has_tech_reps, is_single_subject, repeated,
                                                groups, samples_info, save_fitted_models, has_imputed)

Kind regards
Mateusz

