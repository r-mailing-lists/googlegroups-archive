Hi Mateusz,

If I understand correctly, I ran the following lines:

library(MSstats)

# quant.diann = your dataProcess output
cm = MSstatsContrastMatrix("pairwise", unique(quant.diann$ProteinLevelData$GROUP)) # just for testing

repeated = MSstats:::checkRepeatedDesign(quant.diann)
samples_info = getSamplesInfo(quant.diann)
groups = unique(quant.diann$ProteinLevelData$GROUP)

split_summarized = MSstatsPrepareForGroupComparison(quant.diann)
groups = colnames(cm)
has_imputed = FALSE
# MSstatsGroupComparisonSingleProtein(split_summarized[[1]], cm, repeated, groups, samples_info, T, F)

single_protein = split_summarized[[1]] # or change 1 to index of protein for which model fitting fails
single_protein = MSstats:::.prepareSingleProteinForGC(single_protein)
is_single_subject = MSstats:::.checkSingleSubject(single_protein)
has_tech_reps = MSstats:::.checkTechReplicate(single_protein)

single_protein[, GROUP := factor(GROUP)]
single_protein[, SUBJECT := factor(SUBJECT)]
protein = unique(single_protein$Protein)
n_groups = nlevels(single_protein$GROUP)

The returned values of each:
> n_groups [1] 8 > repeated [1] TRUE > is_single_subject [1] FALSE > has_tech_reps [1] FALSE >

I have also updated the package "lme4" before running these lines.
> packageVersion("lme4")
[1] ‘1.1.35.1’

Let me know what you think.

Thanks,

