可以把 worker 的 write 属性设置为 FALSE ，这样分词后的文件就不会写入文件了。如果 byline 属性为 FALSE ，分词时就不会分行，输出结果为一个 文本向量，如果 byline 属性为 TRUE ，分词时分行输出，输出结果为 一个 list ，关键词提取的结果也是 文本向量。文本向量 和 list 都是 R 常用的数据结构。如果不熟悉 文本向量 和 list 的操作，可以参考一些 R 入门的书籍。

# 写入一个测试文件
writeLines("一个测试文件\n换行以后的文本","./test.txt")

# 新建一个分词器
library(jiebaR)

cc = worker()

cc$bylines = TRUE

cc$write = FALSE

res1 = cc["./test.txt"]

cc$bylines = FALSE

res2 = cc["./test.txt"]

print(res1)

print(res2)

kk = worker("keywords")

resk = vector_keywords(res2, kk)

print(resk)

str(resk)

