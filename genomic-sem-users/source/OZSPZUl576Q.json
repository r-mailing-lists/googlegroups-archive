    [
     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">Dear Sir<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">I have conducted GWAS by subtraction\r\nfor six phenotypes using two different methods. For the first method, we\r\nemployed the following formula:<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\">model\r\n&lt;- &quot;IO=~NA*GCIPL + IOP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO=~NA*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span> </span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~~1*NIO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IO~~1*IO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~~0*IO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IO~SNP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~SNP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span> </span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IOP ~~ 0*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IOP ~~ 0*IOP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>GCIPL ~~ 0*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>SNP~~SNP&quot;<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">In this case, no loading factors\r\nwere used for phenotypes such as GCIPL or IOP, and &#39;NA&#39; was assigned to them.<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">However, for phenotypes that\r\nexhibited a significant model without SNP, we employed the following approach:<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span> </span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\">model\r\n&lt;- &quot;IO=~0.07*GCIPL + (-1)*IOP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO=~0.99*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span> </span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~~1*NIO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IO~~1*IO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~~0*IO<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IO~SNP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>NIO~SNP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span> </span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IOP ~~ 0*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>IOP ~~ 0*IOP<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>GCIPL ~~ 0*GCIPL<span></span></span></p>\r\n\r\n<p style=\"margin-bottom:0.0001pt;line-height:normal\"><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\"><span>          </span>SNP~~SNP&quot;<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">In this case, loading factors that was obtained from the analysis without SNP if it is significant  were\r\napplied to phenotypes like GCIPL and IOP. Notably, we observed that the\r\np-values of the GWAS by subtraction then  became more significant, revealing a\r\nstronger relationship with our outcome.<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">I would appreciate it if you could confirm\r\nwhether the approach we used is correct.<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">Thank you for your assistance.<span></span></span></p>\r\n\r\n<p style=\"line-height:normal\"><span style=\"font-size:12pt;font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\">Maryam<br><span></span></span></p>\r\n\r\n\r\n\r\n\r\n\r\n"
    ]
   ]
  }
