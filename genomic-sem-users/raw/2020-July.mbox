trait.names.p <- c('ADHD','ASD','MDD','TS')
se.logit=c(T,T,T,T)

p_sumstats <- sumstats(files=files, ref=ref, trait.names = trait.names.p, se.logit=se.logit)

pfactor <- commonfactorGWAS(covstruc = ldsc.snpef, SNPs = p_sumstats, parallel = TRUE)

