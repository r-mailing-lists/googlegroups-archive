Of course, here:

nSampleMDD<-807553

munge(
  files=c("data/PGC_UKB_depression_genome-wide_OR.txt"),
  hm3 = "data/w_hm3.noMHC.snplist", #hapMap3/reference file
  trait.names=c("mdd"),
  N=c(nSampleMDD),
  info.filter = 0.9, #won't work without info
  maf.filter = 0.01 #won't work without MAF
  )

nCaseMDD<-246363
#nControlMDD<-561190
samplePrevMDD<-nCaseMDD/nSampleMDD
popPrevMDD<-.16

traits <- c("mdd.sumstats.gz")
sample.prev <- c(samplePrevMDD)
population.prev <- c(popPrevMDD)
ld <- "eur_w_ld_chr/"
wld <- "eur_w_ld_chr/"
trait.names<-c("MDD")
LDSCoutput <- ldsc(traits, sample.prev, population.prev, ld, wld, trait.names)

