+    t = 1./ (b * b);
+    w = ((((c5 * s11 * t + c4 * s9) * t + c3 * s7) * t + c2 * s5) * t + c1
*
+	    s3) * t + c0;
+    w *= c / b;
+
+/*                    COMBINE THE RESULTS */
+
+    u = d * alnrel(a / b);
+    v = a * (Math.log(b) - 1.0);
+    if (u > v)
