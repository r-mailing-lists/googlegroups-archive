+
+    a2nm1 = 1.0;
+    a2n = 1.0;
+    b2nm1 = x;
+    b2n = x + (1.0 - a);
+    c = 1.0;
+
+    do {
+	a2nm1 = x * a2n + c * a2nm1;
+	b2nm1 = x * b2n + c * b2nm1;
+	am0 = a2nm1 / b2nm1;
+	c += 1.0;
+	cma = c - a;
+	a2n = a2nm1 + cma * a2n;
+	b2n = b2nm1 + cma * b2n;
+	an0 = a2n / b2n;
+    } while (Math.abs(an0 - am0) >= eps * an0);
+
+    q[0] = r * an0;
+    p[0] = 0.5 - q[0] + 0.5;
+    return;
+
