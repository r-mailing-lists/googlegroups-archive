+    r = 0.0;
+    k = (int) (m + n);
+    x = new int[k];
+    for (i = 0; i < k; i++) {
+      x[i] = i;
+    }
+
+    for (i = 0; i < n; i++) {
+      j = (int) (Math.floor(k * RNG.unif_rand()));
+      r += x[j];
+      x[j] = x[--k];
+    }
+    x = null;
+    return (r - n * (n - 1) / 2);
