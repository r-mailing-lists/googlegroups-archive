+
+  public double getLeft() {
+    return left;
+  }
+
+  public double getTop() {
+    return top;
+  }
+
+  public double getRight() {
+    return right;
+  }
+
+  public Vector toVector() {
+    return new DoubleVector(bottom, left, top, right);
+  }
+
+  public Margins multiplyBy(Dimension size) {
+    return new Margins(
+        bottom * size.getHeight(),
+        left * size.getWidth(),
+        top * size.getHeight(),
+        right * size.getWidth());
