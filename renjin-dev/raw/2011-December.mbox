+    this.fontSizeFactor = fontSizeFactor;
+  }
+
+  public Color getColor() {
+    return color;
+  }
+
+  public void setColor(Color color) {
+    this.color = color;
+  }
+
+  @Override
+  public TextStyle clone() {
+    return new TextStyle(fontSizeFactor, color);
+  }
+}
