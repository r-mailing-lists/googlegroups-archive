+    String transa = "N";
+    String transb = "N";
+    int i,  j, k;
+    double one = 1.0, zero = 0.0;
+    double sum;
+    boolean have_na = false;
+
+    if (nrx > 0 && ncx > 0 && nry > 0 && ncy > 0) {
