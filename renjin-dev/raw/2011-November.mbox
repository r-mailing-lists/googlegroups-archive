+            }
+            z[i + k * nrx] = sum;
+          }
+        }
+      } else {
+        BLAS.getInstance().dgemm(transa, transb, nrx, ncy, ncx, one,
+            x, nrx, y, nry, zero, z, nrx);
+      }
+    } else { /* zero-extent operations should return zeroes */
