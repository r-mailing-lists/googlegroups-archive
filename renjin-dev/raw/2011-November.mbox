+      BLAS.getInstance().dgemm(transa, transb, ncx, ncy, nrx, one,
+          x, nrx, y, nry, zero, z, ncx);
+    } else { /* zero-extent operations should return zeroes */
+      int i;
+      for(i = 0; i < ncx*ncy; i++) {
+        z[i] = 0;
+      }
+    }
+  }
