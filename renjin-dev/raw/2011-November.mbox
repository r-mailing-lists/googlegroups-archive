+
+      for (i = 0; i < nrx*ncx; i++) {
+        if (Double.isNaN(x[i])) {
+          have_na = true;
+          break;
+        }
+      }
+
+      if (!have_na) {
+        for (i = 0; i < nry*ncy; i++) {
