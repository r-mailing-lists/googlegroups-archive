+    int i, j;
+    if (nr > 0 && nc > 0) {
+      BLAS.getInstance().dsyrk(uplo, trans, nr, nc, one, x, nr, zero, z,
nr);
+      for (i = 1; i < nr; i++) {
+        for (j = 0; j < i; j++) {
+          z[i + nr *j] = z[j + nr * i];
+        }
+      }
+    } else { /* zero-extent operations should return zeroes */
+      for(i = 0; i < nr*nr; i++) {
+        z[i] = 0;
+      }
+    }
