+    if (nr > 0 && nc > 0) {
+      BLAS.getInstance().dsyrk(uplo, trans, nc, nr, one, x, nr, zero, z,
nc);
+      for (i = 1; i < nc; i++)
+        for (j = 0; j < i; j++) z[i + nc *j] = z[j + nc * i];
+    } else { /* zero-extent operations should return zeroes */
+      for(i = 0; i < nc*nc; i++) z[i] = 0;
+    }
