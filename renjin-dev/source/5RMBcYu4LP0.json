an><span style=\"color:#000\"><br>    </span><span style=\"color:#606\">Context</span><span style=\"color:#000\"> topContext </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> engine</span><span style=\"color:#660\">.</span><span style=\"color:#000\">getSession</span><span style=\"color:#660\">().</span><span style=\"color:#000\">getTopLevelContext</span><span style=\"color:#660\">();</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#606\">ListVector</span><span style=\"color:#000\"> df </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#606\">ListVector</span><span style=\"color:#660\">)</span><span style=\"color:#008\">global</span><span style=\"color:#660\">.</span><span style=\"color:#000\">getVariable</span><span style=\"color:#660\">(</span><span style=\"color:#000\">topContext</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;df&quot;</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#606\">List</span><span style=\"color:#660\">&lt;</span><span style=\"color:#606\">String</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> colList </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#008\">new</span><span style=\"color:#000\"> </span><span style=\"color:#606\">ArrayList</span><span style=\"color:#660\">&lt;&gt;();</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">if</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">df</span><span style=\"color:#660\">.</span><span style=\"color:#000\">hasAttributes</span><span style=\"color:#660\">())</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>       </span><span style=\"color:#606\">AttributeMap</span><span style=\"color:#000\"> attributes </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> df</span><span style=\"color:#660\">.</span><span style=\"color:#000\">getAttributes</span><span style=\"color:#660\">();</span><span style=\"color:#000\"><br>       </span><span style=\"color:#606\">Map</span><span style=\"color:#660\">&lt;</span><span style=\"color:#606\">Symbol</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> SEXP</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> attrMap </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> attributes</span><span style=\"color:#660\">.</span><span style=\"color:#000\">toMap</span><span style=\"color:#660\">();</span><span style=\"color:#000\"><br>       </span><span style=\"color:#606\">Symbol</span><span style=\"color:#000\"> s </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> attrMap</span><span style=\"color:#660\">.</span><span style=\"color:#000\">keySet</span><span style=\"color:#660\">().</span><span style=\"color:#000\">stream</span><span style=\"color:#660\">().</span><span style=\"color:#000\">filter</span><span style=\"color:#660\">(</span><span style=\"color:#000\">p </span><span style=\"color:#660\">-&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;names&quot;</span><span style=\"color:#660\">.</span><span style=\"color:#000\">equals</span><span style=\"color:#660\">(</span><span style=\"color:#000\">p</span><span style=\"color:#660\">.</span><span style=\"color:#000\">getPrintName</span><span style=\"color:#660\">())).</span><span style=\"color:#000\">findAny</span><span style=\"color:#660\">().</span><span style=\"color:#000\">orElse</span><span style=\"color:#660\">(</span><span style=\"color:#008\">null</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>       </span><span style=\"color:#606\">Vector</span><span style=\"color:#000\"> colNames </sp