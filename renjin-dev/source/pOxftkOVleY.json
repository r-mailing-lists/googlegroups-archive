     1,
     "<div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\">\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;Renjin&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href rel=\"noreferrer nofollow\" data-email-masked>renjin-dev+...@googlegroups.com</a>.<br>\r\nTo view this discussion on the web visit <a href=\"https://groups.google.com/d/msgid/renjin-dev/33cae847-0537-4b7b-9242-924feb8cc2c8o%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/renjin-dev/33cae847-0537-4b7b-9242-924feb8cc2c8o%2540googlegroups.com?utm_medium%3Demail%26utm_source%3Dfooter&amp;source=gmail&amp;ust=1793343294607000&amp;usg=AOvVaw3RU3elmZQ7u-KRlbuKKfMJ\">https://groups.google.com/d/msgid/renjin-dev/33cae847-0537-4b7b-9242-924feb8cc2c8o%40googlegroups.com</a>.<br>\r\n</blockquote></div>\r\n"
