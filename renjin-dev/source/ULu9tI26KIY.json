o&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(167,29,93);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#008\">void</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(121,93,163);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\">line</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#660\">(</span></span><span style=\"box-sizing:border-box;color:rgb(167,29,93);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#008\">float</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(237,106,67);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\">x1</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(167,29,93);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#008\">float</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(237,106,67);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\">y1</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(167,29,93);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#008\">float</span></span><span style=\"color:rgb(36,41,46);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\"> </span></span><span style=\"box-sizing:border-box;color:rgb(237,106,67);font-family:SFMono-Regular,Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:12px;white-space:pre-wrap;background-color:rgb(255,255,255)\"><span style=\"color:#000\">x2</span></span><span style=\"color:rgb(36,41,46);f