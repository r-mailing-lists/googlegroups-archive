+	if(nthresh==2){
+		cond[3]<-cond[2]
+		cond[2]<-paste("& \\text{if }",Th[1], "< \\text{Th} <", Th[2])
+ 		}
+	###Adds the const/trend and lags
+	for(i in 1:(nthresh+1)){
+		if(x$model.specific$oneMatrix){
