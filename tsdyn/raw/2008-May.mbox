+###LateX elements of R matrix
+TeXMat<-function(mat, oneLine=FALSE){
+	mat<-matrix(mat, ncol=ifelse(inherits(mat, "matrix"), ncol(mat), length(mat)))
+	nr<-nrow(mat)
+	nc<-ncol(mat)
+	d<-mat[,1]
+	if(!oneLine){
