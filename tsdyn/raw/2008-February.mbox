+data <- zeroyld[,c(36,19)]
+colnames(data) <- c("short", "long")
+
+OlsTVAR(data, lag=2, nthresh=3, thDelay=1,trim=0.1, mTh=1, ngrid, plot=FALSE)
+#lag2, 2 thresh, trim00.05: 561.46
+}
+\keyword{ ts }
