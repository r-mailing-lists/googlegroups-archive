+	plot(density(LRtestboot12), xlab="LRtest12",
xlim=c(0,max(LRtest12+1,max(LRtestboot12))),ylim=c(0,max(density(LRtestboot12)$y,dchisq(0:LRtest12,
df=1+m))), main="Test linear VAR vs 1 threshold TVAR")
+	abline(v=LRtest12, lty=2, col=2)
