+buildConstants<-function(include=c("const", "trend","none", "both"), n){
+  include<-match.arg(include)
+  if(include=="const"){
+	  const <- rep(1,n)
+	  inc<-"const"}
+  else if(include=="trend"){
+	  const<-seq_len(n)
+	  inc<-"trend"}
+  else if(include=="both"){
+	  const<-cbind(rep(1,n),seq_len(n))
+	  inc<-c("const","trend")}
+  else {
+	  const<-NULL
+	  inc<-NULL
+  }
+  ninc<-length(inc)
+  res<-list(const=const, inc=inc, ninc=ninc)
+  return(res)
  }

