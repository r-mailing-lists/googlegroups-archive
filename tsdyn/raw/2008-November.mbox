MH=MH, MM=MM,const=const,fun=buildXth2NoCommon,trim=trim)
+}
+AIC_1thresh<-function(gam1,thDelay, yy=yy,xx=xx,trans=z, ML=ML,
MH=MH,const=const,trim=trim,fun=buildXth1Common ){
+	XX<-fun(gam1,thDelay, xx,trans=trans, ML=ML, MH=MH, const)
