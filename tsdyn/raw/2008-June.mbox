+  cat("\nMultiple regime STAR model\n\n")
+  x <- x$model.specific
+
+  for (i in 1:x$noRegimes) {
+    cat("Regime ", i, ":\n")
+
+    cat("    Linear parameters: ")
+    print(x$phi1[i,])
+    cat("\n")
+
+    if(i > 1) {
+      cat("    Non-linear parameters:\n")
+      print(x$phi2[i - 1,])
+    }
+
+    cat("\n")
+
+  }
+
+  invisible(x)
+}

