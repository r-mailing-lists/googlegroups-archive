+coef(tvecm)
+logLik(tvecm)
+AIC(tvecm)
+BIC(tvecm)
+deviance(tvecm)
+residuals(tvecm)
+fitted(tvecm)
+summary(tvecm)
+
+toLatex(tvecm)
