+deviance(tvar)
+residuals(tvar)
+fitted(tvar)
+
+
+##FIXME
+options(show.signif.stars=TRUE)
+summary(tvar)
+
+options(show.signif.stars=FALSE)
+summary(tvar)
+
+print(summary(tvar), digits=3)
+
+toLatex(tvar)
+
+if(0) {##FIXME
+toLatex(summary(tvar), digits=2)
+tvar$coefficients
+tvar$StDev
+options(show.signif.stars=FALSE)
+toLatex(summary(tvar), digits=2)
+}
+
+###TVECM
+tvecm<-TVECM(dat, nthresh=2,lag=1, bn=20, ngridG=20, plot=FALSE,trim=0.05, model="All")
+class(tvecm)
+tvecm
