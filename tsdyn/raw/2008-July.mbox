+
+###TVAR
+tvar<-TVAR(dat[1:100,], lag=2, nthresh=2,thDelay=1,trim=0.1, plot=FALSE, include="const")
+class(tvar)
+tvar
+print(tvar)
+coefficients(tvar)
+##FIXME
