+logLik(lin)
+AIC(lin)
+BIC(lin)
+deviance(lin)
+coef(lin)
+summary(lin)
+toLatex(lin)
+toLatex(summary(lin))
+
+linVECM<-linear2(dat,lag=2, model="VECM")
+class(linVECM)
