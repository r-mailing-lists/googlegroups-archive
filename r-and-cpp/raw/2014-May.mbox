following example and it worked:

code <- '
#include <Rcpp.h>
#include <boost/range/irange.hpp>

// [[Rcpp::depends(BH)]]

// [[Rcpp::export]]
int useCpp11() {
    auto sum = 0;
    for(const auto i : boost::irange(0,4)) { sum += i; }
    return sum;
}
'

library(Rcpp11)
library(attributes)
sourceCpp(code = code)
useCpp11()

