You could make that approach simpler and eliminate the use of global
variables and the need for %T>% by wrapping it up into a function:

recorder <- function(x) {

  recording <- NULL
  i <- 0

  function(x) {
    # This will be slow if you record a lot of things
    # A better strategy would be to double vector when
    # it needs to grow

    i <<- i + 1

    recording[[i]] <<- x
    x
  }
}

record <- recorder()

some.data %>%
  mutate(c = a + b) %>% record() %>%
  filter(c == 2)    %>% record()

But I'd wonder if creating a "functional" pipe might be a better approach:

my_pipeline <-
  . %>%
  mutate(c = a + b) %>% record() %>%
  filter(c == 2)

some_data %>% my_pipeline

Hadley

