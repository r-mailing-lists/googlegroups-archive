B <- read.csv(paste(path,"B.csv",sep="/")) # has columns B and C
C <- read.csv(paste(path,"C.csv",sep="/")) # has columns C and D
D <- read.csv(paste(path,"D.csv",sep="/")) # has columns D and E

# bind
AB <- rbind.fill(A,B)
ABC <- rbind.fill(AB,C)
ABCD <- rbind.fill(ABC,D)

sessionInfo()

