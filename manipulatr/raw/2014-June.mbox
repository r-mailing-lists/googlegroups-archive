There are a couple things to fix... first, the Mode function doesn't actually return the mode when na.rm=T:

library(plyr)
library(dplyr)

df <- data.frame(npat.id <http://npat.id> = c(35,35,35,94,94,94), first = c("Mark","Mark","Mark","Ellen","Ellen","Ellen"), q16 = c(NA,1,1,0,NA,0), q33 = c(NA,0,0,0,1,0))

Mode <- function(x, na.rm=T) {
  ux <- unique(x)
  if (na.rm) { ux = na.omit(ux)[1]}
  ux[which.max(tabulate(match(x, ux)))]
}

Mode(c(1,2,3,3,4))
# 1

Also, the colmode function returns a named character vector, but dplyr::do needs a data frame:

colmode <- function(x) { mode.result <- apply(x,2,Mode) }

str(colmode(df))
# Named chr [1:4] "35" "Mark" " 1" " 0"
# - attr(*, "names")= chr [1:4] "npat.id <http://npat.id>" "first" "q16" "q33"

Here are fixed versions:

Mode <- function(x, na.rm=T) {
  ux <- unique(x)
  if (na.rm) {

    ux <- ux[!is.na <http://is.na>(ux)]
  }
  ux[which.max(tabulate(match(x, ux)))]
}
Mode(c(1,2,3,3,4))
# 3

colmodes <- function(x) { colwise(Mode)(x) }
str(colmodes(df))
# 'data.frame':  1 obs. of  4 variables:
#  $ npat.id <http://npat.id>: num 35
#  $ first  : Factor w/ 2 levels "Ellen","Mark": 2
#  $ q16    : num 1
#  $ q33    : num 0

df %>%
  group_by(npat.id <http://npat.id>) %>%
  do(colmodes(.))
# Source: local data frame [2 x 4]
# Groups: npat.id <http://npat.id>
#
#   npat.id <http://npat.id> first q16 q33
# 1      35  Mark   1   0
# 2      94 Ellen   0   0

-Winston

