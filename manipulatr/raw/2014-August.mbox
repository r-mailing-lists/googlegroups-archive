In plyr, things work according to my expectations:

library(plyr)

set.seed(100)
dfx <- data.frame(vara=factor(rep(c("a","b"),5)),matrix(rnorm(40),10,4))

# the next function call works
ddply(dfx,.(vara),
    summarise,
    sss=(function(x,y)sum(x*y))(cbind(X1,X2),cbind(X3,X4)))

#the following function call also works
ddply(dfx,.(vara),
    summarise,

    sss=(function(x,y)sum(x*y))(as.matrix(as.data.frame(mget(c("X1","X2")))),

                                as.matrix(as.data.frame(mget(c("X3","X4"))))))

