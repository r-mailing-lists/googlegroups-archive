Dear All,

I found the answer :-)

shop<-c('E1','E2','E3','E3','E3','E4','E4','E5','E6','E6','E7')

address<-c('A1','A2','A3','A4','A5','A4','A6','A7','A3','A5','A8')

example <- as.data.frame(cbind(shop,address))

example <- transform(example, rank = ave(rep(NA, nrow(example)), example$shop, FUN = seq_along))

result <- reshape(example,idvar="shop",timevar="rank",direction="wide")

result
Regards,

Thomas

