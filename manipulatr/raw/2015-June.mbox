+ 4,2,NA,3,1,NA,3
+ 5,1,m,4,5,2,4
+ 6,2,m,5,4,5,5
+ 7,1,m,5,3,4,4
+ 8,2,m,4,5,5,5"
> mydata <- read_csv( textConnection("mystring") )
Error: can only read from a binary connection

