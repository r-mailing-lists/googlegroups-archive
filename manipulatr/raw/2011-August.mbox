In isolation the code doesn't work either. I'm not sure your problem is plyr.

#isolate one "variable"
kw<-calid.isu[calid.isu$variable == "kw",]

#anova with isolated "variable"
kw.aov<-aov(value ~ rep +

                                               dens +
                                               trt +
                                               type +
                                               type/gen +
                                               type:dens +
                                               type/gen:dens +
                                               type:trt +
                                               type/gen:trt +
                                               dens:trt +
                                               type:dens:trt +
                                               type/gen:dens:trt +
                                               Error(rep/dens/trt/gen),

                                               data = kw)

#LSD Mean Separation Test
LSD.test(kw.aov, "dens")
#Error in as.data.frame.default(x[[i]], optional = TRUE, stringsAsFactors = stringsAsFactors) :
#cannot coerce class 'c("aovlist", "listof")' into a data.frame

