failwith goes around the function - it's easier if you break it up:

process_gene <- function(gene) {

   ## lots
   ## of
   ## computation
   ## here

   data.frame(gene=name(gene), ...)
}

gene.stats <- llply(genes, failwith(NULL, process_gene))
failed <- Filter(is.NULL, gene.stats)

Hadley

