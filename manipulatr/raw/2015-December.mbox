You're going to need to figure out what's going wrong yourself. This
suggests a place to start...

library(httr)

r <- POST("https://api.mmitnetwork.com/Token",

  body = list(
    grant_type = "password",

    username = "tantanchen",
    password = "Synygy1!"

  ),
  encode = "json",

  accept_json()
)

content(r)
