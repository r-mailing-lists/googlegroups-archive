# With this sort of problem it's always easiest to start by working on a
# single subset of the data
one <- subset(df, ID == "50676-A-1")

# Create a row for zero dose
zerodose <- data.frame(
  ID = one$ID[1], dose = 0,
  Avep1 = 100, Avep2 = 100, Avep3 = 100, Avep4 = 100)
# Combine with original data
rbind(zerodose, one)

# Now you've solved the problem for a single subset
# So the next step is to turn it into a function:

add_zero_dose <- function(one) {
  zerodose <- data.frame(
    ID = one$ID[1], dose = 0,
    Avep1 = 100, Avep2 = 100, Avep3 = 100, Avep4 = 100)
  # Combine with original data
  rbind(zerodose, one)
}

# and test it:
add_zero_dose(one)

# You can then apply that function to every subset with
# ddply from the plyr package
ddply(df, .(ID), add_zero_dose)

# Check it looks ok with some quick exploratory graphics
library(ggplot2)
dfm <- melt(df, id = c("dose","ID"))
qplot(dose, value, data = dfm, colour = variable, facets = ~ ID, geom = "line")
qplot(dose, value, data = dfm, colour = ID, geom = "line", stat =
"summary", fun.y = mean)

