+ test1 <- ddply(one[one$INTEREST_TYPE %in% title_codes, ],
+                .(LAND_AREA_CODE, LAND_AREA_NAME, OWNER_REFERENCE_NUMBER,
+                  TRACT_ID), summarise, CONSOL_INTEREST = sum(OWNER_INTEREST))
+ )
