>         1:10000,
>         function(x) {
>             foo <- rename(hflights,
>                           year=Year,
>                           month=Month,
>                           dayofmonth=DayofMonth,
>                           dayofweek=DayOfWeek)
>             return(NULL)
>         }))
>
>
