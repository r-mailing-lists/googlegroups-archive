Here is a quick benchmark. Both are fast, plyr is faster.

library(plyr)
library(hflights)

system.time(
    sapply(
        1:10000,
        function(x) {
            foo <- rename(hflights,
                          c(Year="year",
                          Month="month",
                          DayofMonth="dayofmonth",
                          DayOfWeek="dayofweek"))
            return(NULL)
        }))

  ##  user  system elapsed
  ## 2.140   0.180   2.364

detach(package:plyr, unload=TRUE)
library(dplyr)

system.time(
    sapply(
        1:10000,
        function(x) {
            foo <- rename(hflights,
                          year=Year,
                          month=Month,
                          dayofmonth=DayofMonth,
                          dayofweek=DayOfWeek)
            return(NULL)
        }))

  ##  user  system elapsed
  ## 5.840   0.010   5.902

