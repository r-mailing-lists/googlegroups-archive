If by "A sits next to B" you are referring to A and B vertically next to each other (that is, one on top of the other) in your sample matrix, this should work (implementing Doug's suggestions):

toy <- matrix(c("A", "B", "C", "A", "C", "B", "C", "A", "B", "C", "B", "A", "B", "C", "A", "B", "A", "C"), nrow = 3)
toy <- data.frame(toy)
toy.list <- lapply(toy, function(x) paste0(x, collapse = ""))
include <- grepl("(AB|BA)", toy.list)
toy[include]

