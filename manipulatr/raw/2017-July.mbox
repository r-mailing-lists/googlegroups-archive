Josh,

Does this do what you want?

library(tidyverse)

df1 <- read_tsv("~/Desktop/tidyrhelp.tsv")

df1 %>%
gather(thing, value, -WEEK_NAME, -ITM_SKU_CD) %>%
unite(united, ITM_SKU_CD, thing) %>%
spread(united, value)

HTH,
B

