Does this do what you want? (I'm not clear at to what the "batches" are)

toy_df <- data.frame(City = c("Little Rock", "Chicago", "Toledo"), State = c("Arkansas", "Illinois", "Ohio"))

sapply(toy_df, tolower)
#     City          State
# [1,] "little rock" "arkansas"
# [2,] "chicago"     "illinois"
# [3,] "toledo"      "ohio"

