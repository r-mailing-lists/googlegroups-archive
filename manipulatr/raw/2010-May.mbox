And here are the results:

> # Small number of groups
> system.time(a <- dlply(X, ~a, f))

   user  system elapsed
  0.756   0.406   1.166

> system.time(b <- dlply(idata.frame(X), ~a, f))

   user  system elapsed
  0.415   0.097   0.512
> system.time({
+   lX <- split(X, X$a)
+   c <- llply(lX, f)
+   names(c)[1] <- "a"
+ })
   user  system elapsed
  0.835   0.304   1.140

>
> # Large number of groups
> system.time(a <- dlply(X, ~b, f))

   user  system elapsed
  3.053   2.802   5.857

> system.time(b <- dlply(iX, ~b, f))

   user  system elapsed
  0.963   0.052   1.016
> system.time({
+   lX <- split(X, X$b)
+   c <- ldply(lX, f)
+   names(c)[1] <- "a"
+ })
   user  system elapsed
  3.129   2.834   5.966

dlply is now on par with split for data frames, and about 2x-5x faster
when you use immutable data frames.

Hadley

