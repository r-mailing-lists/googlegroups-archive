Hi:

It worked OK for me:

uid <- paste(rep(1271175709:1271175713, each = 5), 'GXUC', sep = '.')
tnb <- rpois(25, 250)
df <- data.frame(uid, tnb, stringsAsFactors = FALSE)
> str(df)
'data.frame':   25 obs. of  2 variables:
 $ uid: chr  "1271175709.GXUC" "1271175709.GXUC" "1271175709.GXUC" "1271175709.GXUC" ...
 $ tnb: num  261 220 243 248 250 249 255 240 206 274 ...
ddply(df, .(uid),  function(x) with(x, diff(range(tnb, na.rm = TRUE))))
