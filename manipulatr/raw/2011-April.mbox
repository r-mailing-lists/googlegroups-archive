21      104             1443
22      104             1631
23      104             1826
24      104             1946
25      104             1982
26      104             2024
27      104             2081
28      104             2257
29      104             2355

30      104             2473"), header = TRUE)

library(plyr)
zerodays <- function (df) {

            zeroed.offset <- df - min(df)
            }

dataset <- ddply(dat,.(masterid),transform, zeroed.offset = zerodays(days.after.nadir))

