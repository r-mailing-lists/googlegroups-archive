# Even if I try the following function, directly on the data frame, i.e. without ddply

fn.1 <- function(d)
{
    if(d[["temp"]] < 75 | d[["temp"]] > 95)
       { d[["sales"]] <- d[["sales"]] + 10}
    else
       {d[["sales"]] <- d[["sales"]] + 100}
    d
}

