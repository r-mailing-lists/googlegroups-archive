ode><span style=\"font-family:&#39;Helvetica Neue&#39;,Helvetica,Arial,sans-serif;line-height:16.8999996185303px\">s in the</span><code style=\"padding:1px 5px;font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,sans-serif;line-height:16.8999996185303px;background-color:rgb(238,238,238)\">t1rt</code><span style=\"font-family:&#39;Helvetica Neue&#39;,Helvetica,Arial,sans-serif;line-height:16.8999996185303px\"> column:</span></div><div><span style=\"font-family:&#39;Helvetica Neue&#39;,Helvetica,Arial,sans-serif;line-height:16.8999996185303px\"><br></span></div><div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\">          test1 &lt;- raw_data_rt %&gt;%</span></font></div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\">            group_by(raw_data_rt[[id]]) %&gt;%</span></font></div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\">            summarise(n = mean(rt[abs(z_score) &lt; 1])) %&gt;%</span></font></div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\">            dcast(raw_data_rt[[id]] ~ &quot;t1rt&quot;, value.var = &quot;n&quot;, fun = mean)</span></font></div></div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\"><br></span></font></div><div><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"line-height:16.8999996185303px\"><div>&gt; head(test1)</div><div>  raw_data_rt[[id]] t1rt</div><div>1                99   NA</div><div>2              5203   NA</div><div>3              5205   NA</div><div>4              5306   NA</div><div>5              5307   NA</div><div>6              5308   NA</div></spa