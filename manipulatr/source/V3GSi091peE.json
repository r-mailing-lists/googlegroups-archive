   "parts": [
    [
     1,
     "<div dir=\"ltr\">Hi,<div><br></div><div>I&#39;d like to pass on a bare column name to another method:</div><div><pre style=\"color:rgb(0,0,0);font-family:Menlo;font-size:10.5pt\"><br></pre><pre style=\"color:rgb(0,0,0);font-family:Menlo;font-size:10.5pt\">plot_hist = function(df, column){<br>    quoCol= enquo(column)<br>    <br>    hist(pull(df, !!quoCol))<br>}<br><br>plot_hist(iris, Petal.Width) ## works as expected</pre><pre style=\"color:rgb(0,0,0);font-family:Menlo;font-size:10.5pt\"><br></pre><pre style=\"color:rgb(0,0,0);font-family:Menlo;font-size:10.5pt\"><br><br># here another method that internally should call plot_hist:<br>do_stuff = function (df, column){<br>    plot_hist(df, column)<br>    # ... more stuff<br>}</pre><pre style=\"color:rgb(0,0,0);font-family:Menlo;font-size:10.5pt\"><br>do_stuff(iris, Petal.Width) ##  does not work but fails with <br></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><br></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><p><span>Error in overscope_eval_next(overscope, expr) :<span> </span></span></p><p><span><span>  </span>object &#39;Petal.Width&#39; not found</span></p><font face=\"arial, sans-serif\">\r\n</font></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><pre style=\"font-size:10.5pt\"><font face=\"arial, sans-serif\">plot_hist should stay as it is, but do_stuff needs to be changed somehow, I guess.</font></pre><pre style=\"font-size:10.5pt\"><font face=\"arial, sans-serif\"><br></font></pre></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><font face=\"arial, sans-serif\">What am I doing wrong here? </font></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><font face=\"arial, sans-serif\"><br></font></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><font face=\"arial, sans-serif\">Thanks,</font></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><font face=\"arial, sans-serif\">best regards,</font></pre><pre style=\"color:rgb(0,0,0);font-size:10.5pt\"><font face=\"arial, sans-serif\">Holger</font></pre></div></div>"
    ]
   ]
