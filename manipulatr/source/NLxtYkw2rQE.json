  {
   "id": "t7Q0UDvRHVYJ",
   "from": "Hadley Wickham",
   "author": "b756a7daa2c2aa6d",
   "date": "2012-09-10T21:56:28Z",
   "subject": "Re: maply efficiency?",
   "parts": [
    [
     1,
     "Hi Philip,\r<br>\r<br>I think you will only get marginal gains through tweaking how you run\r<br>the non-vectorised code.  If you really want performance improvements,\r<br>I think you need to bite the bullet and vectorise fisher.test.\r<br>\r<br>Hadley\r<br>"
    ],
    [
     3,
     "\r<br>On Sun, Sep 2, 2012 at 12:05 PM, philip &lt;<a href data-email-masked rel=\"nofollow\">pcv...@gmail.com</a>&gt; wrote:\r<br>&gt; Dear list members,\r<br>&gt;\r<br>&gt; Any help on this efficiency issue would be greatly appreciated.\r<br>&gt;\r<br>&gt; I would like to find the most efficient way to run a non-vectorized function\r<br>&gt; (here: fisher exact test p-value) iteratively using 4 matrices with\r<br>&gt; identical dimensions. And as a result I aim for an array with identical\r<br>&gt; dimensions containing the corresponding p-values. Please consider some code\r<br>&gt; using a trivial example with 3x4 arrays below. Eventually I would like to\r<br>&gt; run code on 2e3 x 7e6 arrays, for which someone suggested Amazon EC2\r<br>&gt; already...\r<br>&gt;\r<br>&gt; Q1: would you agree that fisher.test() is not vectorizable? e.g.\r<br>&gt; fisher.test( matrix(c(Ax,Ay,Bx,By),ncol=2) ) does not work\r<br>&gt; Q2: direct use of Ax, Ay, Bx, By as input instead of a (list) transform for\r<br>&gt; the input would seem beneficial for speed\r<br>&gt; Q3: parallelization of the iterative process seems to make sense.\r<br>&gt; Q4: a progress bar seems to save peace of mind having no clue of the\r<br>&gt; runtime.\r<br>&gt; Q5: avoidance of an output transform to get array from vector\r<br>&gt; Q6: for Q2/3/4/5 plyr seems to be ideal (e.g. maply)\r<br>&gt;\r<br>&gt; Please also find some solutions below.\r<br>&gt; solution 1: using mapply\r<br>&gt; solution 2: using lapply\r<br>&gt; solution 3: using mclapply\r<br>&gt; attempt 4: stuck on plyr implementation\r<br>&gt;\r<br>&gt; --Philip\r<br>&gt;\r<br>&gt; ### CODE START ###\r<br>&gt;\r<br>&gt; Ax &lt;- matrix(c(2,3,5,6,\r<br>&gt;                3,7,8,9,\r<br>&gt;                8,2,1,3), ncol = 4)\r<br>&gt; Ay &lt;- matrix(c(9,8,5,7,\r<br>&gt;                4,9,9,9,\r<br>&gt;                8,7,5,4), ncol = 4)\r<br>&gt; Bx &lt;- matrix(c(1,5,9,8,\r<br>&gt;                4,7,8,9,\r<br>&gt;                2,3,2,1), ncol = 4)\r<br>&gt; By &lt;- matrix(c(5,5,9,9,\r<br>&gt;                9,8,8,9,\r<br>&gt;                5,5,3,2), ncol = 4)\r<br>&gt;\r<br>&gt; ### solution 1 using mapply\r<br>&gt; # proper answer, no input transform, output transform, no parallelization,\r<br>&gt; no progress update\r<br>&gt; sol1 &lt;- function() {\r<br>&gt;  res1 &lt;- mapply(\r<br>&gt;    function(i,j,k,l) { fisher.test( matrix(c(i,j,k,l), ncol=2),\r<br>&gt; <a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792358480394000&amp;usg=AOvVaw1U-nRqDsjZbkjG91zviIDU\">conf.int</a>=F)$p.value },\r<br>&gt;    i=Ax, j=Ay, k=Bx, l=By,\r<br>&gt;    SIMPLIFY=TRUE)\r<br>&gt;  ans1 &lt;- matrix(res1,ncol=4)\r<br>&gt;  return(ans1)\r<br>&gt; }\r<br>&gt; s1 &lt;- sol1()\r<br>&gt;\r<br>&gt; ### solution 2 using lapply\r<br>&gt; # proper answer, input transform, output transform, no parallelization, no\r<br>&gt; progress update\r<br>&gt; sol2 &lt;- function() {\r<br>&gt;  tmp.list &lt;- as.data.frame(rbind(as.numeric(Ax), as.numeric(Ay),\r<br>&gt; as.numeric(Bx), as.numeric(By)))\r<br>&gt;  # determine fisher.test p-values as list\r<br>&gt;  res2 &lt;- lapply(tmp.list,\r<br>&gt;     function(x) { fisher.test( matrix(unlist(x), ncol=2),\r<br>&gt; <a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792358480394000&amp;usg=AOvVaw1U-nRqDsjZbkjG91zviIDU\">conf.int</a>=F)$p.value })\r<br>&gt;  ans2 &lt;- matrix(unlist(res2),ncol=4)\r<br>&gt;  return(ans2)\r<br>&gt; }\r<br>&gt; s2 &lt;- sol2()\r<br>&gt;\r<br>&gt; ### solution 3 using mclapply\r<br>&gt; # proper answer using input transform, output transform, parallelization, no\r<br>&gt; progress update\r<br>&gt; library(multicore)\r<br>&gt; sol3 &lt;- function() {\r<br>&gt;   tmp.list &lt;- as.data.frame(rbind(as.numeric(Ax), as.numeric(Ay),\r<br>&gt; as.numeric(Bx), as.numeric(By)))\r<br>&gt;   # determine fisher.test p-values as list\r<br>&gt;   res3 &lt;- mclapply(tmp.list,\r<br>&gt;     function(x) { fisher.test( matrix(unlist(x), ncol=2),\r<br>&gt; <a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792358480394000&amp;usg=AOvVaw1U-nRqDsjZbkjG91zviIDU\">conf.int</a>=F)$p.value },\r<br>&gt;     mc.cores=4)\r<br>&gt;   ans3 &lt;- matrix(unlist(res3),ncol=4)\r<br>&gt; }\r<br>&gt; s3 &lt;- sol3()\r<br>&gt;\r<br>&gt; ### solution 4 using plyr::maply\r<br>&gt; # difficulty finding equivalent code\r<br>&gt; # benefit could be: no input transform, no output transform,\r<br>&gt; parallelization, and progress update\r<br>&gt;  library(plyr)\r<br>&gt;  library(abind)\r<br>&gt;  library(doMC)\r<br>&gt;  registerDoMC(cores=4)\r<br>&gt;  sol4 &lt;- function() {\r<br>&gt;   ans4 &lt;- maply(\r<br>&gt;    #.data = abind(i=Ax,j=Ay,k=Bx,l=By,along=0),\r<br>&gt;    #.data = abind(Ax,Ay,Bx,By,along=3),\r<br>&gt;    #.data = data.frame(i=Ax, j=Ay, k=Bx, l=By),\r<br>&gt;    #.data = cbind(i=as.vector(Ax), j=as.vector(Ay), k=as.vector(Bx),\r<br>&gt; l=as.vector(By)),\r<br>&gt;    #.data = list(i=Ax, j=Ay, k=Bx, l=By),\r<br>&gt;    .data = abind(i=Ax, j=Ay, k=Bx, l=By, along=3),\r<br>&gt;    .fun = function(i,j,k,l) { fisher.test( matrix(c(i,j,k,l), ncol=2),\r<br>&gt; <a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792358480394000&amp;usg=AOvVaw1U-nRqDsjZbkjG91zviIDU\">conf.int</a>=F)$p.value },\r<br>&gt;    .progress = &quot;text&quot;,\r<br>&gt;    .parralel = TRUE\r<br>&gt;   )\r<br>&gt;   return(ans4)\r<br>&gt; }\r<br>&gt;\r<br>&gt; all.equal(s1,s2) # TRUE\r<br>&gt; all.equal(s1,s3) # TRUE\r<br>&gt;\r<br>&gt; library(microbenchmark)\r<br>&gt; microbenchmark(sol1, times=1000)\r<br>&gt; microbenchmark(sol2, times=1000)\r<br>&gt; microbenchmark(sol3, times=1000)\r<br>&gt; microbenchmark(sol4, times=1000)\r<br>&gt;\r<br>"
    ],
