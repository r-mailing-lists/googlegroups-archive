> > > > g2 <-  platypus.gl <http://platypus.gl>
> > > > g3 <-  platypus.gl <http://platypus.gl>
> > > >
> > > > genlight_list <- list(g1, g2, g3)
> > > >
> > > > f1 <- Reduce(
> > > >   f = \(x, y) gl.join(x, y, method = "join.by.loc"),
