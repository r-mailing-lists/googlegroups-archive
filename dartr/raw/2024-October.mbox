Hi Adrain,

I updated the gl.grm.netwrok function, please give it a try after installing the developing version of dartR.captive as shown below.

Cheers,
Luis

devtools::install_github("green-striped-gecko/dartR.captive@dev")
library(dartRverse)
DART_SNP <- platypus.gl <http://platypus.gl>

GRM <- gl.grm(DART_SNP)

shp <- gl.select.shapes(select=c(21,21,23,23,22,22,25,24))

col <-
  gl.select.colors(
    library = 'brewer',
    palette = 'Paired',
    ncolors = 12,
    select = c(1, 2, 7, 8, 3, 4, 12, 5)
  )

col2 <-
  gl.select.colors(library = 'gr.hcl',
                   palette = 'Viridis',
                   ncolors = 9)
NETWORK_Clones <- gl.grm.network(
  GRM,
  DART_SNP,
  method = "kk",
  node.size = 10,
  node.label = T,
  node.label.size = 4,
  node.label.color = "black",
  node.shape = shp,
  link.size = 3,

  relatedness_factor = 0.15,
  title = NULL,
  palette_discrete = col,
  link.color = col2,
  verbose = 3
)

