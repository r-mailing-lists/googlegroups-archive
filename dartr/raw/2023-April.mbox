Cheers,
Luis

devtools::install_github("bcm-uga/TESS3_encho_sen")
library(tess3r)
t1 <- gl.filter.callrate(platypus.gl <http://platypus.gl>,threshold = 1)
genotype <- as.matrix(t1)
coordinates <- as.matrix(t1$other$latlon)
tess3.obj <- tess3(X = genotype, coord = coordinates, K = 1:3,
                   method = "projected.ls <http://projected.ls>", ploidy = 2, openMP.core.num = 1)

