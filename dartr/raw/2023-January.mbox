gl2vcf( x, plink_path = getwd(), outfile = "gl_vcf", outpath = tempdir(), snp_pos = "0", snp_chr = "0", chr_format = "character", pos_cM = "0", ID_dad = "0", ID_mom = "0", sex_code = "unknown", phen_value = "0", verbose = NULL )

