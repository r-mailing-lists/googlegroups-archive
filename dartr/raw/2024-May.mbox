Hi,

Can you try using the developing version of dartR.base as shown below:

install.packages("dartRverse")
library(dartRverse)
dartRverse_install(package = "dartR.base", rep = "github", branch = "dev")

library(dartR.base)
t1 <- platypus.gl <http://platypus.gl>
#population names
popNames(t1)
#subsetting populations
t1_pop_1_2 <- gl.keep.pop(t1,pop.list = c("SEVERN_ABOVE" ,"SEVERN_BELOW"))
#running LD report
res <- gl.report.ld.map(t1_pop_1_2)
# Saving R object
saveRDS(res,"results_ld.rds")
# reading R object
res_ld <- readRDS("results_ld.rds")

Cheers,
Luis

