You can try:

library(dartR.base)
t1 <- bandicoot.gl <http://bandicoot.gl>
popNames(t1)
t2 <- gl.sort(t1,
        sort.by <http://sort.by> = "pop",
        order.by <http://order.by> = c("NSW" ,"QLD","SA" , "VIC" ,"WA" ) )
fst <- gl.fst.pop(t2)

Cheers,
Luis

