gl2vcf(t1, outpath = getwd(), snp_chr = "Chrom_viburnum_lautum_v031", snp_pos = "ChromPosSnp_viburnum_lautum_v031", plink_path = "/Users/davidtork/Desktop/'R projects'/Vib_May23Hyb/plink_mac_20230116")
