> library(devtools)
> install_github("green-striped-gecko/dartR@dev")
> library(dartR)
> test <-  gl.dist.ind(bandicoot.gl <http://bandicoot.gl>)
> test_2 <- gl.pcoa(test,nfactors=2)
> res <- gl.pcoa.plot(test_2,bandicoot.gl <http://bandicoot.gl>)
>
