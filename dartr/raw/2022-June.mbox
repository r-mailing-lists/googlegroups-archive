dat_L1000 <- gl.keep.loc(dat, loc.list = sample(dat$loc.names, 1000, replace = FALSE, prob = NULL), first = NULL, last = NULL, verbose = NULL)

gl2vcf(x=dat_L1000,
       plink_path = getwd(),
       outfile = "test.vcf",
       outpath = getwd(),

       snp_pos = "0",
       snp_chr = "0",
       chr_format = "character",
       pos_cM = "0",
       ID_dad = "0",
       ID_mom = "0",
       sex_code = "unknown",
       phen_value = "0",
       verbose = NULL)

