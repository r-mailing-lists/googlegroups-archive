Hi Cristian,

You can try:

library(dartR)
# overall MAF by locus in the entire dataset is here
platypus.gl <http://platypus.gl>$other$loc.metrics$maf
# MAF by population
# separating populations
sep_pop <- seppop(platypus.gl <http://platypus.gl>)

# obtain each individual MAF value for every locus from each of these 'genlight' objects
maf_pop <- lapply(sep_pop, function(x){
  #recalculating metrics
  x <- gl.recalc.metrics(x)
})
# name of each population in maf_pop
names(maf_pop)
# MAF by locus in pop 1
maf_pop[[1]]$other$loc.metrics$maf
# MAF by locus in pop 2
maf_pop[[2]]$other$loc.metrics$maf

Cheers,
Luis

