a Console&quot;;font-size:10pt\">-&gt;</span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\"> </span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\">-----------------</span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\"> </span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\">Enter\r\nthe name of a file holding prior allele frequency information</span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\">or\r\njust type 0 to not include any prior information</span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border:1pt windowtext;color:black;font-family:&quot;Lucida Console&quot;;font-size:10pt\">-&gt;</span></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"background:white;margin:0cm 0cm 0pt;line-height:11.25pt\"><span style=\"padding:0cm;border: