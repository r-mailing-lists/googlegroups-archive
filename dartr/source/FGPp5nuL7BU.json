     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-AU\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span>That might do what you want<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span>miss &lt;- rowMeans(<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792459182781000&amp;usg=AOvVaw0Cu0k18EhhMVilMceCF0MU\">is.na</a>(as.matrix(gl)))*100<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span>hist(miss)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span>names(miss) &lt;- indNames(gl)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span>barplot(miss)  #if  not too many individuals……<u></u><u></u></span></p></div></div>"
