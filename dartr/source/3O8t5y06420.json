     "<div lang=\"EN-AU\" link=\"blue\" vlink=\"purple\"><div>\r\n<p class=\"MsoNormal\"><span><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><b><span lang=\"EN-US\">From:</span></b><span lang=\"EN-US\"> <a href data-email-masked rel=\"nofollow\">da...@googlegroups.com</a> &lt;<a href data-email-masked rel=\"nofollow\">da...@googlegroups.com</a>&gt;\r\n<b>On Behalf Of </b>Arthur Georges<br>\r\n<b>Sent:</b> Friday, 26 June 2020 10:56<br>\r\n<b>To:</b> dartR &lt;<a href data-email-masked rel=\"nofollow\">da...@googlegroups.com</a>&gt;<br>\r\n<b>Subject:</b> [dartR] Re: Plot individual heterozygosity and missing data<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\">Hi Anna,<u></u><u></u></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\">Try this.<u></u><u></u></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\"># Grab the test set<br>\r\n  gl &lt;- <a href=\"http://testset.gl\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://testset.gl&amp;source=gmail&amp;ust=1792459128767000&amp;usg=AOvVaw0NcnHdHSCWtsOzLwe2fqSe\">testset.gl</a><br>\r\n# Assign each individual as a population<br>\r\n  pop(gl) &lt;- indNames(gl)<br>\r\n# Calculate Heterozygosity<br>\r\n  hetro &lt;- gl.report.heterozygosity(gl)<br>\r\n# Display heterozygosity<br>\r\n  hetro$Ho    <br>\r\n# Calculate the call rate by individual<br>\r\n  ind.call.rate &lt;- 1 - rowSums(<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792459128767000&amp;usg=AOvVaw2PTlhb4yM9007wv2Daj4Mv\">is.na</a>(as.matrix(gl)))/nLoc(gl)<br>\r\n# Display call rate<br>\r\n  ind.call.rate<br>\r\n#Plot heterozygosity against call rate<br>\r\n  plot(x=ind.call.rate,y=hetro$Ho)<u></u><u></u></p>\r\n</div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n</div></div>"
