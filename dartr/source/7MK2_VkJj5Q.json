    [
     2,
     "<div dir=\"ltr\"><div><br></div><div><span style=\"color:rgb(0,0,255)\">@other: a list containing: elements without names</span> <br></div><div><br></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div>when it should have something like<br></div><div><br></div><div><pre style=\"font-family:&#39;Lucida Console&#39;;font-size:10pt!important;outline:none;border:none;word-break:break-all;margin:0px;white-space:pre-wrap!important;line-height:9.615385055541992px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-align:-webkit-left;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\"><span><span style=\"outline:none;border:none;word-break:break-all;margin:0px;white-space:pre-wrap!important\"><span style=\"font-family:arial,sans-serif\"><font size=\"2\"><span style=\"color:rgb(0,0,255)\">@other: a list containing: loc.metrics  latlong  ind.metrics.</span><br><br><br>Did you generate your genlight object with data from DArT or from some other source?<br><br><br>A</font></span><br></span></span></pre></div></div>"
    ]
