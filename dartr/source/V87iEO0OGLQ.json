    [
     1,
     "<span style=\"font-weight:normal;font-style:normal;text-decoration:none\">Dear dartR users,</span><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><br style=\"font-weight:normal;font-style:normal;text-decoration:none\">The dartR developer team <span style=\"font-weight:normal;font-style:normal;text-decoration:none\">is participating in a CSIRO program in which we are learning about how to engage with end users and stakeholders. This will help us to understand the challenges that our end-users might be facing from a different perspective. <span></span></span><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><span style=\"font-weight:normal;font-style:normal;text-decoration:none\">So, we would appreciate if you could give us 10 minutes of your time to talk about your research area and the challenges that you face when analysing your data.</span><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><span style=\"font-weight:normal;font-style:normal;text-decoration:none\">If you would like to help us in this regard, we could schedule an online meeting.<span> </span></span><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><span style=\"font-weight:normal;font-style:normal;text-decoration:none\">Cheers,</span><br style=\"font-weight:normal;font-style:normal;text-decoration:none\"><span style=\"font-weight:normal;font-style:normal;text-decoration:none\">Luis<br></span>"
    ]
   ]
  },
