   "parts": [
    [
     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-AU\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Hi Robert,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">If you run you command via:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">out &lt;- gl.outflank(<a href=\"http://possums.gl\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://possums.gl&amp;source=gmail&amp;ust=1792459411993000&amp;usg=AOvVaw2k9pD_PgoAeLkWkn9MX2pQ\">possums.gl</a>)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">then the\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">out$index that is returned has the information you need. This object is true if the snp is an outlier according to outflank.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">So simply<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">locNames(<a href=\"http://possums.gl\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://possums.gl&amp;source=gmail&amp;ust=1792459411994000&amp;usg=AOvVaw18Eip8mr0mR2Yx_d7-5prb\">possums.gl</a>)[out$index]<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">should give you the names of the loci.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Cheers, Bernd<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">==============================================================================<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:navy\">Dr Bernd Gruber\r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\"> </span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">                                            )/_         \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">                                                         _.--..---&quot;-,--c_    \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">Associate Professor      \r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">                          \\|..&#39;           ._O__)_  \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">Tel: (02)\r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">6206 3804                     \r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">   ,=.    _.+   _ \\..--( /          \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">Fax:\r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">(02) 6201 2328</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">                           \\\\.-&#39;&#39;_.-&#39; \\ (     \\_          \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">Institute for Applied Ecology</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:navy\">                 \r\n</span><span style=\"font-size:8.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">`&#39;&#39;&#39;       `\\__   /\\