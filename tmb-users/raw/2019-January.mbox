names = c("Type 1", "Type 2", "Type 1").

I tried DATA_STRING(), but I don't think this is giving me what I would like. So I'm trying DATA_VECTOR but I think this is also incorrect.

An example is here below - I would like to change the jth value of m2 depending on whether the jth value of names is either "Type 1" or Type 2"

###############################

#include <TMB.hpp>
template<class Type>
  Type objective_function<Type>::operator() ()
{
  DATA_MATRIX(mZ);
  DATA_MATRIX(mY);
  DATA_VECTOR(names);
  PARAMETER_MATRIX(vu);

  matrix<Type> m1 = mZ*vu

  matrix<Type> m2 = log(exp(m1.array()) + 1);

  Type l = names.size();

  for(int j = 0; j < l; j = j + 1){
    std::string val = names.at <http://names.at>(j);
    if(val!="Type 1"){
      m2(j)= exp(m1.array()(j));
    }
  }

  Type nll = m2(0);

  return(nll);
  }

###############################

