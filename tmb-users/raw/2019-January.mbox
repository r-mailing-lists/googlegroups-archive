If you are using that vector container just for use in a logical condition I would suggest avoiding strings and going with int, I have added what I mean in the following code (disclaimer I haven't compiled or run the code).

#include <TMB.hpp>
template<class Type>
Type objective_function<Type>::operator() ()
{
  DATA_MATRIX(mZ);
  DATA_MATRIX(mY);

  // Use a vector of ints
  DATA_IVECTOR(types); // 1 = Type 1, 2 = Type 2 etc ...

  PARAMETER_MATRIX(vu);

  matrix<Type> m1 = mZ*vu

  matrix<Type> m2 = log(exp(m1.array()) + 1);

  Type l = types.size();

  for(int j = 0; j < l; ++j){
    if(types[j] == 1){

      m2(j)= exp(m1.array()(j));
    }
  }

  Type nll = m2(0);

  return(nll);
}

tmb_dat = list(
  types = c(1,1,2,2,2)
)

