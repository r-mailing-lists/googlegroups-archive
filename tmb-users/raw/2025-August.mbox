> > > b <- ADjoint(
> > >   function(x) {
> > >
> > >     B_interp <- sapply(1:ncol(B_fine), function(j) approx(xfine, B_fine[, j], xout = x, rule = 2)$y)
> > >     as.numeric(B_interp)
> > >   },
> > >   function(x, y, dy) {
> > >     dB_interp <- matrix(db(x), ncol = k)
