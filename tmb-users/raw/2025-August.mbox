https://github.com/kaskr/RTMB/blob/09a691a29df1bd8c1aaf0e0db695f4255ef6a50e/RTMB/R/advector.R#L559

    ## Set atomic
    atomic <- match.arg(atomic)
    atomic <- c("NA"="NA", "disable"="plain", "enable"="atomic")[atomic]
    args$matmul <- atomic

