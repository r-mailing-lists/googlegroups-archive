   vector<ad> eta_row = alpha0 + alpha1*X_row + a1(0);

    ad nll = -dnorm(a1,ad(0),exp(logsigma_a), true).sum();

    nll -= lla(eta_row,dfcost_row,rep);
    return nll;
  }
  template<class Type>
  Type eval_nldens() {
    vector<Type> start(2); start.setZero();
    newton::newton_config cfg;
    Type res = newton::Laplace(*this, start, cfg);
    return res;
  }
};

// Joint likelihood
template<class Type>
Type objective_function<Type>::operator() ()
{

  /* Data */
  DATA_MATRIX(Xrow);
  DATA_INTEGER(N);
  DATA_VECTOR(replicates);
  DATA_MATRIX(dfcost);

  /* Parameters */

  PARAMETER(logsigma_a);
  PARAMETER(alpha0);
  PARAMETER(alpha1);

  /* Joint likelihood */

  Type nll = Type(0.0);

  //the joint negative log-likelihood
  for(int i=0; i<N; i++){

    vector<Type> X_row = Xrow.row(i);

    //vector<Type> eta_row = eta.row(i);

    vector<Type> dfcost_row = dfcost.row(i);
    Type rep = replicates(i);

    model obj = {X_row, dfcost_row, rep, alpha0, alpha1, logsigma_a}; // put data vectors here

    nll -= obj.eval_nldens<Type>();}
  return nll;
}

