template<class Type>
Type dskewnorm(Type x, Type mu , Type sigma2, Type alpha, int give_log=0){
    if(!give_log) return 2 * dnorm(x, mean, sqrt(sigma2)) * pnorm(alpha*((x - mean)/ sqrt(sigma2)));
    else return log(2.0) + log(dnorm(x, mean, sqrt(sigma2))) + log(alpha*((x - mean)/ sqrt(sigma2)));
  }

