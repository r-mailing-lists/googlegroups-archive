Dear Kasper,
Thank you,  it took some time for me to fix the problem, but everything works fine now!  I am just wondering whether it is still possible to extract individual random effects  if Laplace is done on the C++ side rather than in R.  I am using REPORT function but I do not get them back in R when using adreport(obj).   I would appreciate any guidance on this.

#include <TMB.hpp>

typedef TMBad::ad_aug ad;
struct model {
  vector<ad> X_row;
  vector<ad> dfcost_row; // Data
  ad N, rep, alpha0, alpha1,  logsigma_a;

  ad operator()(vector<ad> a1) {

   vector<ad> eta_row = alpha0 + alpha1*X_row + a1(0);

    ad nll = -dnorm(a1(0),ad(0),exp(logsigma_a), true);
    vector<ad> pi_i = exp(eta_row)/(1+exp(eta_row));

    for(int h=0; h<rep; h++){
      if(dfcost_row(h) > 0){

    nll -= log(pi_i(h));
      }
      if(dfcost_row(h) == 0){
        nll -= log(1-pi_i(h));

      }
    }
    return nll;
  }
  template<class Type>

  Type eval_nldens(vector<Type> &start) {

    newton::newton_config cfg;
    Type res = newton::Laplace(*this, start, cfg);
    return res;
  }
};

// Joint likelihood
template<class Type>
Type objective_function<Type>::operator() ()
{

  /* Data */
  DATA_MATRIX(Xrow);
  DATA_INTEGER(N);
  DATA_VECTOR(replicates);
  DATA_MATRIX(dfcost);

  DATA_VECTOR(a1); //random effect initial guess

  /* Parameters */
  PARAMETER(logsigma_a);
  PARAMETER(alpha0);
  PARAMETER(alpha1);

  /* Joint likelihood */

  Type nll = 0;

  vector<Type> a(N);

  //the joint negative log-likelihood
  for(int i=0; i<N; i++){

    vector<Type> X_row = Xrow.row(i);

    vector<Type> dfcost_row = dfcost.row(i);
    Type rep = replicates(i);

    model obj = {X_row, dfcost_row, N, rep, alpha0, alpha1, logsigma_a};
    nll += obj.eval_nldens<Type>(a1);
    a(i) = a1(0);
    }
  REPORT(a);
  return nll;
}

