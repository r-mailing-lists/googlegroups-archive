{

  DATA_VECTOR(Y);

  PARAMETER_VECTOR(X);

  PARAMETER(logRho);
  PARAMETER(logSdState);
  PARAMETER(logSdObs);

  Type sdState = exp(logSdState);
  Type sdObs = exp(logSdObs);
  Type rho = exp(logRho);

  Type nll = 0.0;

  nll -= dnorm(X(0), Type(0.0), sdState, true);

  for (int i = 1; i < X.size(); ++i)
  {
    nll -= dnorm(X(i), rho*X(i-1), sdState, true);
  }

  for (int i = 0; i < Y.size(); ++i) {
    nll -= dnorm(Y(i), X(i), sdObs, true);
  }

  ADREPORT(rho);
  ADREPORT(sdState);
  ADREPORT(sdObs);

  REPORT(rho);
  REPORT(sdState);
  REPORT(sdObs);

  SIMULATE {
    for (int i = 1; i < X.size(); ++i)
    {
      X(i) = rnorm(rho*X(i-1), sdState);
    }

    for (int i = 0; i < Y.size(); ++i)
    {
      Y(i) = rnorm(X(i), sdObs);
    }

    REPORT(X);
    REPORT(Y);

    REPORT(rho);
    REPORT(logSdState);
    REPORT(logSdObs);
  }

  return nll;
}

