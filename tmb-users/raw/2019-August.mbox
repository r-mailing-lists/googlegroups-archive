Would the autodiff namespace help for your problem?
Example taken from the TMB Documentation: https://kaskr.github.io/adcomp/namespaceautodiff.html
Similarly you can compute the Hessian and Jacobian.

#include <TMB.hpp <https://kaskr.github.io/adcomp/TMB_8hpp.html>>
struct func {
  template <class T>
  T operator()(vector<T> <https://kaskr.github.io/adcomp/structvector.html> x){  // Evaluate function
    return exp( -x.sum() );
  }
};
template<class Type>
Type objective_function<Type>::operator() () {
  PARAMETER_VECTOR <https://kaskr.github.io/adcomp/group__macros.html#ga6b8a70eeee38fe896e89e0a9c6bef84a>(theta);
  func f;
  // Calculate gradient
  vector<Type> <https://kaskr.github.io/adcomp/structvector.html> g = autodiff::gradient <https://kaskr.github.io/adcomp/namespaceautodiff.html#a9726ba5efee905cf45ff8a16ed2ce35d>(f, theta);
  REPORT <https://kaskr.github.io/adcomp/group__macros.html#gac2d7888f4e0385930448f992de53079b>(g);
  // Exit
  return 0;
}

