There's an asArray in tmbutils namespace. Try the following:

#include <TMB.hpp>

/* List of integer matrices */
template<class Type>

struct LOA_t : vector<array<Type> > {
  LOA_t(SEXP x){  /* x = List passed from R */

    (*this).resize(LENGTH(x));
    for(int i=0; i<LENGTH(x); i++){
      SEXP sm = VECTOR_ELT(x, i);

      if(!Rf_isArray(sm)) Rf_error("Not an array");
      (*this)(i) = tmbutils::asArray<Type>(sm);

    }
  }
};

template<class Type>
Type objective_function<Type>::operator() ()
{

  // x = list of arrays
  DATA_STRUCT(x, LOA_t);
  // Get the first...
  array<Type> y = x(0);
  REPORT(y);
  return 0;
}

