>   y <- c()
>   print(class(y))
>   y[TRUE] <- x
>   print(class(y))
>   y
> }
> try(MakeTape(f, numeric(1)))
>
> When the object is created as a numeric then
>
> f2 <- function(x){
>   y <- numeric(1)
>   print(class(y))
>   y[TRUE] <- x
>   print(class(y))
>   y
> }
