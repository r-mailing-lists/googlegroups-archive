"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">a1 </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> model_data$Z</span><span style=\"color:rgb(102,102,0)\">[</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\">drop </span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,0,0)\"> F</span><span style=\"color:rgb(102,102,0)\">]%*%</span><span style=\"color:rgb(0,0,0)\">t</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">model_data$U</span><span style=\"color:rgb(102,102,0)\">[</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">,,</span><span style=\"color:rgb(0,0,0)\"> drop </span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,0,0)\">F</span><span style=\"color:rgb(102,102,0)\">]))</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(136,0,0)\"># How I think c++ would work</span><span style=\"color:rgb(0,0,0)\"><br>     </span><span style=\"color:rgb(102,102,0)\">[,</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">]</span><span style=\"color:rgb(0,0,0)\"><br></span><span style=\"color:rgb(102,102,0)\">[</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">,]</span><span style=\"color:rgb(0,0,0)\">   </span><span style=\"color:rgb(0,102,102)\">19</span><span style=\"color:rgb(0,0,0)\"><br></span></div></code></div><div><br>But I don&#39;t know how to perform it in template/C++;</div><br>On Monday, 4 May 2020 17:53:28 UTC-3, Chris Nottingham  wrote:<blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\"><div dir=\"ltr\"><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:rgb(0,0,0)\">ZZ</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,102,102)\">0</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\"> Z</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">row</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,102,102)\">0</span><span style=\"color:rgb(102,102,0)\">)*</span><span style=\"color:rgb(0,0,0)\">vector</span><span style=\"color:rgb(102,102,0)\">&lt;</span><span style=\"color:rgb(102,0,102)\">Type</span><span style=\"color:rgb(102,102,0)\">&gt;(</span><span style=\"color:rgb(0,0,0)\">U</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">row</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,102,102)\">0</span><span style=\"color:rgb(102,102,0)\">))</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">)(</span><span style=\"color:rgb(0,102,102)\">0</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,102,102)\">0</span><span style=\"color:rgb(102,102,0)\">);</span></div></code></div><span style=\"color:rgb(136,0,0);font-family:monospace;background-color:rgb(250,250,250)\"><br></span></div><div><font face=\"monospace\" color=\"#880000\"><span style=\"background-color:rgb(250,250,250)\">Why are you casting Z to a matrix, it already is a matrix?</span></font></div></div></blockquote></div>\r\n\r\n<p></p></blockquote></div>"
