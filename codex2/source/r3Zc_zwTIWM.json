0)\"> </span><span style=\"box-sizing:border-box;color:rgb(0,112,32);font-weight:bold\">normalize_null</span>(<span style=\"box-sizing:border-box;color:rgb(144,32,0)\">Y_qc =</span> Y_qc,\r\n                               <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">gc_qc =</span> gc_qc,\r\n                               <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">K =</span> <span style=\"box-sizing:border-box;color:rgb(64,160,112)\">1</span>:<span style=\"box-sizing:border-box;color:rgb(64,160,112)\">5</span>, <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">N =</span> N)</code></pre></div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\">So  in segmentation part,  whether I need to set chr? just like </div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\"><pre style=\"box-sizing:border-box;overflow:auto;padding:9.5px;margin-top:0px;margin-bottom:10px;line-height:1.42857;color:rgb(51,51,51);word-break:break-all;background-color:rgb(245,245,245);border:1px solid rgb(204,204,204);border-radius:4px\"><code style=\"box-sizing:border-box;font-size:inherit;padding:0px;color:inherit;background-color:transparent;border-radius:0px\">finalcall.CBS &lt;-<span style=\"box-sizing:border-box;color:rgb(64,112,160)\"> </span><span style=\"box-sizing:border-box;color:rgb(0,112,32);font-weight:bold\">segmentCBS</span>(Y_qc,  <span style=\"box-sizing:border-box;color:rgb(96,160,176);font-style:italic\"># recommended</span>\r\n                            Yhat.ns, <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">optK =</span> <span style=\"box-sizing:border-box;color:rgb(0,112,32);font-weight:bold\">which.max</span>(BIC.ns),\r\n                            <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">K =</span> <span style=\"box-sizing:border-box;color:rgb(64,160,112)\">1</span>:<span style=\"box-sizing:border-box;color:rgb(64,160,112)\">5</span>,\r\n                            <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">sampname_qc =</span> <span style=\"box-sizing:border-box;color:rgb(0,112,32);font-weight:bold\">colnames</span>(Y_qc),\r\n                            <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">ref_qc =</span> <span style=\"box-sizing:border-box;color:rgb(0,112,32);font-weight:bold\">ranges</span>(ref_qc),\r\n                            <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">lmax =</span> <span style=\"box-sizing:border-box;color:rgb(64,160,112)\">400</span>, <span style=\"box-sizing:border-box;color:rgb(144,32,0)\">mode =</span> <span style=\"box-sizing:border-box;color:rgb(64,112,160)\">&quot;integer&quot;</span>)</code></pre></div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\">And finally, I want to filter CNV  from the result of finalcall.CBS( is it suitable?).  How should I choose specific standards? <font style=\"display:inline;font-size:13px;font-family:Arial,Helvetica,sans-serif;color:rgb(34,34,34);background-color:rgba(0,0,0,0);font-weight:400;font-style:normal\">（like lratio &gt; ? and so on</font>）</div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\"><br></div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\"><font style=\"display:inline;font-size:13px;font-family:Arial,Helvetica,sans-serif;color:rgb(34,34,34);background-color:rgba(0,0,0,0);font-weight:400;font-style:normal\">Thank you, and I look forward to hearing from you.</font></div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\"><br></div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\">Best regards,</div><div style=\"margin:0px;padding:0px;border:0px;color:rgb(34,34,34);font-family:Arial,Helvetica,sans-serif;font-size:13px\">Yi Zhang</div></div><div><br></div><div><div style=\"color:rgb(144,144,144);font-family:&quot;Arial Narrow&quot;;font-size:12px\">------------------</div><div style=\"font-size:14px;font-family:Verdana\"><div>zhangyi</div><div><br></div></div></div><div> </div><div><br></div>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;CODEX/CODEX2 for CNV detection&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href data-email-masked rel=\"nofollow\">codex2+un...@googlegroups.com</a>.<br>\r\nTo view this discussion on the web visit <a href=\"https://groups.google.com/d/msgid/codex2/tencent_03CC9D459F4E82FF7CF1873784BFD9181006%40qq.com?utm_medium=email&amp;utm_source=footer\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/codex2/tencent_03CC9D459F4E82FF7CF1873784BFD9181006%2540qq.com?utm_medium%3Demail%26utm_source%3Dfooter&amp;source=gmail&amp;ust=1793243780309000&amp;usg=AOvVaw3p2lcauLQUv9o_6bPa0Pfe\">https://groups.google.com/d/msgid/codex2/tencent_03CC9D459F4E82FF7CF1873784BFD9181006%40qq.com</a>.<br>\r\n</div></blockquote></div><br></div></div></div></blockquote></div></div></div></blockquote></div>"
