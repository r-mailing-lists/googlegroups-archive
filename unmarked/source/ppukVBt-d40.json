    [
     1,
     "<div dir=\"ltr\">Check out Marc Mazerolle&#39;s AICcmodavg package, which has functions written specifically for models in unmarked.<br><br><a href=\"http://cran.r-project.org/web/packages/AICcmodavg/index.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://cran.r-project.org/web/packages/AICcmodavg/index.html&amp;source=gmail&amp;ust=1792452951076000&amp;usg=AOvVaw3W2f5Y5fSJxCWu_d7KX2j5\">http://cran.r-project.org/web/packages/AICcmodavg/index.html</a><br clear=\"all\">\n\n<div dir=\"ltr\">__________________________________________<br>Matt Giovanni, Ph.D. | Research Biologist<br>Director, <a href=\"http://kestrel.peregrinefund.org/index.php\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://kestrel.peregrinefund.org/index.php&amp;source=gmail&amp;ust=1792452951077000&amp;usg=AOvVaw2YvAZZBt_wKSodBGGHvVb_\">American Kestrel Partnership</a><br>\n\n<a href=\"http://www.peregrinefund.org/index.php\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.peregrinefund.org/index.php&amp;source=gmail&amp;ust=1792452951077000&amp;usg=AOvVaw3zxi6YGkIVPG597kKHPr32\">The Peregrine Fund</a><br>5668 West Flying Hawk Lane, Boise, ID 83709 USA<br><a href=\"tel:(208)%20362-8279\" value=\"+12083628279\" target=\"_blank\" rel=\"nofollow\">208.362.8279</a> office | <a href=\"tel:(402)%20617-3764\" value=\"+14026173764\" target=\"_blank\" rel=\"nofollow\">402.617.3764</a> mobile<br><a href=\"https://sites.google.com/site/matthewgiovanni/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sites.google.com/site/matthewgiovanni/&amp;source=gmail&amp;ust=1792452951077000&amp;usg=AOvVaw1W5KQJxDPGfWyO_RtqXMWj\">Check out my research website</a><br>\n\n<i>Conserving birds of prey worldwide</i><br></div></div>"
    ],
