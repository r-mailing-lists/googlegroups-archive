in 2:T) { #Loops over the subsequent time periods</span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">   N[i, T] &lt;-S[i, t]+R[i,t]  #survivors + recruits </span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">   S[i, t]~dbinom(phi, N[i, t-1])</span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">   R[i, t]~dpois(gamma*N[s, t-1])</span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">}<u></u><u></u></span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font face=\"Courier New\"><span style=\"font-size:13.3333px\">}</span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font face=\"Courier New\"><span style=\"font-size:13.3333px\"><br></span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">for (i in 1:R) { # Loops over R sites<u></u><u></u></span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">  for (t in 1:T) { #Loops over all time periods</span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"><u></u>   <u></u></span></font><span style=\"font-size:10pt;font-family:&quot;Courier New&quot;\">for (k in 1:K) { # Loops over repeated visits or whatever</span></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><br></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">#\r\nObservation model for replicated counts</span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">C[i, t, k]\r\n~ dbin(p[i, t, k], N[i, t])<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\">        p[i, t, k]~dbeta(alpha.p,beta.p) ##this is the beta-binomial part<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"> }<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"><u></u> }<u></u></span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"><u></u>}<u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"><u></u> <u></u></span></font></p><p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><br></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><br></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0.0001pt;line-height:normal\"><font size=\"2\" face=\"Courier New\"><span style=\"font-size:10pt\"><u></u> <u></u></span></font></p></div></div>\r\n\r\n<p></p></blockquote></div>"
