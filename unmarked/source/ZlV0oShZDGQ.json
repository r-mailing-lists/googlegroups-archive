right\">1</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">1</td>\r\n  <td align=\"right\">1</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">1</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">2</td>\r\n  <td align=\"right\">1</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">6</td>\r\n </tr></tbody></table></div><div><br></div><div>Should I add across visits, take the average, or make an educated guess about all the individuals I may have missed?</div><div><br></div><div>Thanks for any advice!</div><div><br></div><div>Best,</div><div>Kate</div></div></div>"
