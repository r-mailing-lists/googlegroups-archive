     "\r\n\r\n\r\n\r\n\r\n<div vlink=\"purple\" link=\"blue\" lang=\"EN-US\">\r\n<div style=\"direction:ltr;font-family:Tahoma;color:#000000;font-size:12pt\">\r\n<div><font size=\"2\">Dear all,</font></div>\r\n<div><font size=\"2\"><br>\r\n</font></div>\r\n<div><font size=\"2\">this may be interesting for the audience of this list.</font></div>\r\n<div><font size=\"2\"><br>\r\n</font></div>\r\n<div><font size=\"2\">Best regards  --- Marc</font></div>\r\n<div><font size=\"2\"><br>\r\n</font></div>\r\n<div style=\"font-family:Times New Roman;color:#000000;font-size:16px\">\r\n<hr>\r\n<div style=\"direction:ltr\"><font size=\"2\" face=\"Tahoma\" color=\"#000000\"><b>From:</b> Antoine Guisan [<a href data-email-masked rel=\"nofollow\">antoine...@unil.ch</a>]<br>\r\n<b>Sent:</b> 01 June 2020 23:31<br>\r\n<b>To:</b> Antoine Guisan<br>\r\n<b>Subject:</b> FW: First Assistant (Postdoc) in Spatial Modelling of Species and Biodiversity<br>\r\n</font><br>\r\n</div>\r\n<div></div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Dear colleagues,</span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">I am looking for an experienced modeler for a postdoc position available for up to 3 years in my lab in Lausanne. Thanks to circulate this information to any\r\n potential candidate.</span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Best wishes</span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Antoine</span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"> </span></p>\r\n<table style=\"width:412.5pt\" width=\"0\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\">\r\n<tbody>\r\n<tr>\r\n<td rowspan=\"3\" style=\"width:18.0pt;padding:0cm 0cm 0cm 0cm\" width=\"24\" valign=\"bottom\">\r\n<p class=\"MsoNormal\"><img src=\"https://ci4.googleusercontent.com/proxy/u_XVTJQbkRIG37xfl2m4CVG7Az24Ft38VclezVJYGFCME2tZZsHzb6mugEXvJnkSXkKmNZffZjk4EH1yzJN0PCO_-fFHbdkldbTB9L2wgSovCl-LIx0OkQpeI-ekaaFYUodXGw=s0-d-e1-ft#https://performancemanager5.successfactors.eu/ui/uicore/img/email_footer_left.png\"></p>\r\n</td>\r\n<td style=\"width:376.5pt;border:solid #dddddd 1.0pt;border-bottom:none;padding:10.5pt 10.5pt 10.5pt 10.5pt;word-wrap:break-word\" width=\"502\">\r\n<p class=\"MsoNormal\"><img src=\"https://ci5.googleusercontent.com/proxy/fSJ79ZzKlXxW7gKb8JS4RfvWRyw0KcnOqFUQftkQk7cl0oy6UCD0ja7sa-pJ9vad3WnzsWK8km2m9RizYhYZW_4kZGuqtkQ18p3Bnu7qvuSjbNo=s0-d-e1-ft#https://applicationspub.unil.ch/files/rh/cdc/1490708382.5986.png\" alt=\"Company Logo\"></p>\r\n</td>\r\n<td rowspan=\"3\" style=\"width:18.0pt;padding:0cm 0cm 0cm 0cm\" width=\"24\" valign=\"bottom\">\r\n<p class=\"MsoNormal\"><img src=\"https://ci3.googleusercontent.com/proxy/poMmKyyAbjCpNzZjayY3z4-Vd3ELUA6xMLlnSvdjxDUQx4566TjR6VSG_diFIh9mJcJ2z2b53hor6k_THBsqmdHUOumhUkaTQfLJs_M12if2Z76mu6r-OHjs2BL3kQk0RKxi4U4=s0-d-e1-ft#https://performancemanager5.successfactors.eu/ui/uicore/img/email_footer_right.png\"></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"width:376.5pt;border-top:none;border-left:solid #dddddd 1.0pt;border-bottom:none;border-right:solid #dddddd 1.0pt;padding:3.75pt 11.25pt 60.0pt 11.25pt;word-wrap:break-word\" width=\"502\">\r\n<h1><span style=\"font-size:17.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">First Assistant (Postdoc) in Spatial Modelling of Species and Biodiversity</span></h1>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"> </span></p>\r\n<div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Introduction</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">UNIL is a leading international teaching and research institution, with over 5,000 employees and 15,500 students split between its Dorigny campus, CHUV and Epalinges. As an employer,\r\n UNIL encourages excellence, individual recognition and responsibility.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Presentation</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">The Institute of Earth Surface Dynamics (IDYST) of the Faculty of Geosciences &amp; Environment is opening a position as\r\n<strong><span style=\"font-family:&quot;Arial&quot;,sans-serif\">First Assistant (Postdoc) in Spatial Modelling of Species and Biodiversity</span></strong>.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Job information</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Expected start date in position : 01.09.2020</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Contract length : 1 year, renewable 1 x 2 years, maximum 3 years</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Activity rate : 100%</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Workplace : Lausanne Dorigny (Géopolis)</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Your responsibilities</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">100% of the activity will be dedicated to research in the ValPar.CH project, within the Spatial Ecology group (<a href=\"http://www.unil.ch/ecospat\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.unil.ch/ecospat&amp;source=gmail&amp;ust=1792450508890000&amp;usg=AOvVaw0ryzMUREWaaNGsdGpcgXUm\">ECOSPAT</a>)\r\n in the GSE Faculty, IDYST institute.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Your qualifications</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">The candidate will have already a PhD grade and work within the new multidisciplinary national project ValPar.CH aiming at evaluating and modelling habitats, biodiversity and ecosystem\r\n services in Switzerland and for selected parks of national importance.</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">The candidate will be particularly involved in the spatial modelling of species and biodiversity at both the national scale and within parks at fine resolution. This task will\r\n require intensive and efficient computing, thus the candidate is expected to have advanced experience in computer programming, statistics and simulations, and a good knowledge in biogeography, especially about the drivers of species distributions.</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">The project will be based on existing national species occurrence data and environmental maps, so that no sampling will be required.</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">The candidate will also have to collaborate with the other researchers within the project, and especially with those involved in habitat and landuse mapping.</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">English will be the language for the scientific part of the project, but knowledge of French and German would be a plus.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">What the position offers you</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p style=\"text-align:justify\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">We offer a nice working place in a multicultural, diverse and dynamic academic environment. Opportunities for professional training, a lot of activities\r\n and other benefits to discover.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Contact for further information</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Mr</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Professor</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Antoine Guisan</span></p>\r\n<p><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"><a href rel=\"noopener noreferrer nofollow\" data-email-masked>Antoine...@unil.ch</a></span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Your application</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p style=\"text-align:justify\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Deadline : 30.06.2020<br>\r\n<br>\r\nPlease, send your application with a motivation letter, CV, copy of the PhD diploma (not the thesis itself), publication list with a short statement of research achievements, the coordinates and emails of 3 reference persons in Word or PDF.<br>\r\nOnly applications through this website will be taken into account.<br>\r\n<br>\r\nWe thank you for your understanding.</span></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"><b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">Additional information</span></b><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:#333333\">\r\n</span></p>\r\n</div>\r\n<div>\r\n<p style=\"text-align:justify\"><em><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">UNIL is committed to equal opportunities and diversity.</span></em><i><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"><br>\r\n<em><span style=\"font-family:&quot;Arial&quot;,sans-serif\"><a href=\"https://www.unil.ch/egalite/en/home.html\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.unil.ch/egalite/en/home.html&amp;source=gmail&amp;ust=1792450508890000&amp;usg=AOvVaw3Qf4cDYUYQEwHdwRQK6kuV\">www.unil.ch/egalite</a></span></em></span></i><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"></span></p>\r\n<p style=\"text-align:justify\"><em><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\">UNIL supports early career researchers.</span></em><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"><br>\r\n<a href=\"https://unil.ch/graduatecampus/en/home.html\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://unil.ch/graduatecampus/en/home.html&amp;source=gmail&amp;ust=1792450508890000&amp;usg=AOvVaw03026logF0pwUnTPHWXgw8\"><em><span style=\"font-family:&quot;Arial&quot;,sans-serif\">www.unil.ch/graduatecampus</span></em></a></span></p>\r\n</div>\r\n</div>\r\n</div>\r\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"> </span></p>\r\n<p class=\"MsoNormal\" style=\"text-align:center\" align=\"center\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#333333\"><a href=\"https://career5.successfactors.eu/career?company=universitdP&amp;career_job_req_id=16002&amp;career_ns=job_listing&amp;navBarLevel=JOB_SEARCH\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://career5.successfactors.eu/career?company%3DuniversitdP%26career_job_req_id%3D16002%26career_ns%3Djob_listing%26navBarLevel%3DJOB_SEARCH&amp;source=gmail&amp;ust=1792450508890000&amp;usg=AOvVaw0W1LKaWbEfTfo30D0PjWnC\">Postuler\r\n pour ce poste maintenant…</a></span></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td style=\"padding:0cm 0cm 0cm 0cm\">\r\n<p class=\"MsoNormal\"><img src=\"https://ci4.googleusercontent.com/proxy/0IDAG6pvH97HS5g5YWJ_9yRE2qitvdrUe9zYNbI4_ljYtrAJ7UjgIBn6mnVrcKsrAzLi91jC5XGU17DOSjRfz4yFVleFHhXmfDRCwO-L5FCkha2VDmTvjx8HlTtoq0wzfAEOAoy7=s0-d-e1-ft#https://performancemanager5.successfactors.eu/ui/uicore/img/email_footer_center.jpg\" border=\"0\"></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td colspan=\"3\" style=\"padding:0cm 15.0pt 0cm 15.0pt\"></td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"MsoNormal\"> </p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n"
