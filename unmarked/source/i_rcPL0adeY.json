     "<div dir=\"ltr\"><div><div>    nSim &lt;- 1000</div><div>    z &lt;- matrix(NA, nSites, nSim)</div><div>    for(i in 1:nSim) {</div><div>      z[,i] &lt;- rbinom(nSites, 1, pmean)</div><div>    }</div></div></div>"
    ],
    [
