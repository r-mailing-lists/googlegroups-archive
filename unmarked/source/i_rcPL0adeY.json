     "<div dir=\"ltr\"><div><div>    occup.sims &lt;- colSums(z) #Sites Occupied per Simulation</div><div>    quantile(occup.sims, c(0.025, 0.975))/n #95% CI</div><div><div>   2.5%     97.5% </div><div>0.3809524 0.7142857 </div></div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"></div></div></div></div></div></div></div></div></div></div>\r\n</div></div>\r\n</blockquote></div></div>"
