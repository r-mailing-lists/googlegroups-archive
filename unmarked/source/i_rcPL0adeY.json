    [
     1,
     "<div dir=\"ltr\"><div><div>    #Confidence Intervals</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div>    pmean &lt;- bup(re, stat=&quot;mean&quot;)</div></div></div>"
    ],
    [
