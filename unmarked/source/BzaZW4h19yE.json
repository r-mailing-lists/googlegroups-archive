     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"ES\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">Hi Gabrielle,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">I change slightly the R Documentation from\r\n<i>unmarked</i> to answer your question. Using a simplest model (no covariates), you can use backTransform to get abundance (latent in your samples) and p.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">Best,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">José<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">#==========================<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"># Simulate data<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">set.seed(35)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">nSites &lt;- 100<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">nVisits &lt;- 3<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">lambda &lt;- 3                      # expected counts at each site<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">N &lt;- rpois(nSites, lambda)       # latent abundance<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">y &lt;- matrix(NA, nSites, nVisits)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">p &lt;- 0.3                         # fix detection prob for each visit<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">for(j in 1:nVisits) {<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">  y[,j] &lt;- rbinom(nSites, N, p)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">}<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">umf &lt;- unmarkedFramePCount(y=y, siteCovs=NULL, obsCovs=NULL)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">summary(umf)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"># Fit a model<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">fm1 &lt;- pcount(~1 ~1, umf, K=50)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">fm1<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">backTransform(fm1, type=&quot;state&quot;)    # lambda<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Courier New&quot;;color:black\">backTransform(fm1, type=&quot;det&quot;)      # p<u></u><u></u></span></p></div></div>"
    ],
