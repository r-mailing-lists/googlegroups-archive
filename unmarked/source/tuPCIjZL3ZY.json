     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n\r\n<div>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:12.0pt\">Greetings,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:12.0pt\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:12.0pt\">I am running into a strange\r\nerror when trying to develop bootstrapped confidence intervals using a colext\r\nobject.  Just to make sure I was doing it correctly, I attempted to the same\r\nthing using the example(colext) data, but I get the same error message.  Any\r\nthoughts?  Thank you!<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:12.0pt\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext&gt;\r\ndata(frogs)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext&gt;\r\numf &lt;- formatMult(masspcru)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext&gt;\r\nobsCovs(umf) &lt;- scale(obsCovs(umf))<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext&gt;\r\numf &lt;- umf[which((1:numSites(umf)) %% 4 == 0),]<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext&gt;\r\n(fm &lt;- colext(psiformula = ~ 1,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext+\r\ngammaformula = ~ 1,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext+\r\nepsilonformula = ~ 1,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext+\r\npformula = ~ JulianDate + I(JulianDate^2), umf, control = list(trace=1,\r\nmaxit=1e4)))<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">initial \r\nvalue 622.192564 <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">iter \r\n10 value 343.985139<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">iter \r\n20 value 330.135612<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">final \r\nvalue 330.129438 <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">converged<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Call:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">colext(psiformula\r\n= ~1, gammaformula = ~1, epsilonformula = ~1, <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">   \r\npformula = ~JulianDate + I(JulianDate^2), data = umf, control = list(trace = 1,\r\n<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">       \r\nmaxit = 10000))<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Initial:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"> Estimate   \r\nSE    z  P(&gt;|z|)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">     \r\n1.4 0.397 3.53 0.000417<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Colonization:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"> Estimate   \r\nSE     z P(&gt;|z|)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">   \r\n-1.35 0.497 -2.72 0.00658<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Extinction:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"> Estimate  \r\nSE     z  P(&gt;|z|)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">   \r\n-3.15 0.48 -6.55 5.63e-11<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Detection:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">               \r\nEstimate    SE      z  P(&gt;|z|)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">(Intercept)       \r\n0.404 0.148   2.73 6.41e-03<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">JulianDate       \r\n-2.665 0.236 -11.30 1.27e-29<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">I(JulianDate^2)  \r\n-1.304 0.220  -5.92 3.28e-09<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">AIC:\r\n673.5922 <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">&gt;\r\nfm &lt;- nonparboot(fm, B = 10) <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">Error\r\nin .local(umf, ...) : <u></u><u></u></span></b></p>\r\n\r\n<p class=\"Mso