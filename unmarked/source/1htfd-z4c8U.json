     "\r\n\r\n\r\n\r\n<div>\r\n<div name=\"messageBodySection\">\r\n<div dir=\"auto\"><span style=\"font-family:Arial\">Hi Dilsad, </span><br>\r\n<span style=\"font-family:Arial\">Check out </span><a style=\"font-family:Arial\" href=\"https://besjournals.onlinelibrary.wiley.com/action/downloadSupplement?doi=10.1111%2F1365-2656.12370&amp;file=jane12370-sup-0002-Script2.R\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://besjournals.onlinelibrary.wiley.com/action/downloadSupplement?doi%3D10.1111%252F1365-2656.12370%26file%3Djane12370-sup-0002-Script2.R&amp;source=gmail&amp;ust=1792449374467000&amp;usg=AOvVaw1wHQ-OXYAUXLAWXxz0IIgb\">Appendix 2</a><span style=\"font-family:Arial\"> in </span><a style=\"font-family:Arial\" href=\"https://besjournals.onlinelibrary.wiley.com/doi/full/10.1111/1365-2656.12370\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://besjournals.onlinelibrary.wiley.com/doi/full/10.1111/1365-2656.12370&amp;source=gmail&amp;ust=1792449374467000&amp;usg=AOvVaw1cA2DZJCPVaVp2U8r5lzUo\">Gerber et al. 2015</a><span style=\"font-family:Arial\">, it’s a GLMM with a binomial response variable, but the code (and definitely the paper) should be useful ;-)</span><br>\r\n<span style=\"font-family:Arial\">Cheers,</span><br>\r\n<span style=\"font-family:Arial\">Olivier</span></div>\r\n</div>\r\n<div name=\"messageReplySection\"></div></div>"
