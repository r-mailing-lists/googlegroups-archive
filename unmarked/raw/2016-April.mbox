sitecovs=data.frame(Length=data$Length,Facility=data$Facility,Month=data$Month)
summary(sitecovs)
umf=csvToUMF("data.csv", long = TRUE, type = "unmarkedFrameOccu")
siteCovs(umf)=data2
summary(umf)
mod=occu(~1 ~1,umf)

