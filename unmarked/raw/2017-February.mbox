#Here is my full code (feel free to point out any other issues)

datum=read.csv(file.choose())
data= datum

y<-data[,3:32] #observed data matrix
S<- nrow(data) #number of sites
J<- 5 # number of secondary sampling occasions
T<- 6 #number of primary periods

#covariates
site.cov<-data.frame(plot=data[,2])#site level covariates, which plot
t1<-rep(c(1,0,0,0,0,0),S)
