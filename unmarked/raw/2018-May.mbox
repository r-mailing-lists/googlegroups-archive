##code used
#true psi
psi <- sample(c(0, 1), size = 180, replace = TRUE, prob = c(0.6, 0.4))
true_psi <- mean(psi)

#create survey data for 6 different observers:

##function for getting survey data with detection probability approx 0.5
obs <- function(){
  obsV <- vector(length = 180)
  for(i in 1:180) {
    if(psi[i] == 1)
      obsV[i] <- sample(c(0, 1), size = 1, prob = c(0.5, 0.5))
    else
      obsV[i] <- 0
  }
  obsV
}

obs_01 <- obs()
obs_02 <- obs()
obs_03 <- obs()
obs_04 <- obs()
obs_05 <- obs()
obs_06 <- obs()

#combine survey data
y_dat <- data.frame(obs_01, obs_02, obs_03, obs_04, obs_05, obs_06)

#create data frame for using different observers as detection covariate

obs_no <- rep(c("obs_01", "obs_02", "obs_03", "obs_04", "obs_05", "obs_06"), times = 180)

cov_obs <- data.frame(obs_no) # obs

#combine into unmarked data frame
umf00 <- unmarkedFrameOccu(y = y_dat, siteCovs = NULL, obsCovs = cov_obs)

#run model
fm00 <- occu(~ obs_no ~ 1, umf00)

#alter order of surveys and run model
y_dat1 <- y_dat[, sample(1:6)]
umf01 <- unmarkedFrameOccu(y = y_dat1, siteCovs = NULL, obsCovs = cov_obs)
fm01 <- occu(~ obs_no ~ 1, umf01)

fm00
fm01

#check results
psi00 <- fm00['state']@estimates
psi01 <- fm01['state']@estimates

(1 / (1 + exp(1) ^ (-psi00)))
(1 / (1 + exp(1) ^ (-psi01)))

#check detection estimates
getDetEst <- function(fm)
{
  P_det1 <- summary(fm['det'])$Estimate[1]
  P_det2 <- P_det1 + summary(fm['det'])$Estimate[2]
  P_det3 <- P_det1 + summary(fm['det'])$Estimate[3]
  P_det4 <- P_det1 + summary(fm['det'])$Estimate[4]
  P_det5 <- P_det1 + summary(fm['det'])$Estimate[5]
  P_det6 <- P_det1 + summary(fm['det'])$Estimate[6]
  P_det <- c(P_det1, P_det2, P_det3, P_det4, P_det5, P_det6)
  P_est <- 1 / (1 + exp(1) ^ (-P_det))
  print(data.frame(P_est = P_est))
}
P_est00 <- getDetEst(fm00)
P_est01 <- getDetEst(fm01)

#put detection estimates in same order as original surveys
P_est00[,]
P_est01[c(2, 1, 6, 4, 5, 3),] #NB this order will vary depending on sampled order for y_dat1

