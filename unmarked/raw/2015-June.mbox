Thanks a lot for your reply, Dan.  Here's some of the script I just tried, attempting to follow the first approach you advised, and some output.

I weighted with the SE calculated from the bootstrapping--I just took the standard deviation of the bootstrapped values for each stand.  Is that correct?

And then I used the below linear mixed models where I treated block as a random effect.  I have 3 blocks, each with 4 stands.  As you say, I've got sample size issues here, but the results have been reasonable so far.  Do you see red flags with this analysis?

xhab <-read.table("eawp stand densities & habitat.csv",
header=TRUE, sep=",", na.strings="NA", dec=".", strip.white=TRUE)
#
library(lme4)
library(MuMIn)
#
(null   <-lmer(dens ~(1|block), xhab, weights =se, gaussian))
(dwd    <-lmer(dens ~scale(dwd) + (1|block), xhab, weights =se,gaussian))
(big    <-lmer(dens ~scale(bigBA) +(1|block), xhab, weights =se,gaussian))
(yb     <-lmer(dens ~scale(yb) +(1|block), xhab, weights =se,gaussian))
(ro     <-lmer(dens ~scale(ro) +(1|block), xhab, weights =se,gaussian))
(con    <-lmer(dens ~scale(con) +(1|block), xhab, weights =se,gaussian))
(ba     <-lmer(dens ~scale(ba) +(1|block), xhab, weights =se,gaussian))
(snag   <-lmer(dens ~scale(snag) +(1|block), xhab, weights =se,gaussian))
(sap    <-lmer(dens ~scale(sap) +(1|block), xhab, weights =se,gaussian))
(baCV   <-lmer(dens ~scale(baCV) +(1|block), xhab, weights =se,gaussian))
(cnpy   <-lmer(dens ~scale(cnpy) +(1|block), xhab, weights =se,gaussian))
(cnpyCV <-lmer(dens ~scale(cnpyCV) +(1|block), xhab, weights =se,gaussian))
(tsDivSt<-lmer(dens ~scale(tsDivSt) +(1|block), xhab, weights =se,gaussian))
(scDiv  <-lmer(dens ~scale(scDiv) +(1|block), xhab, weights =se,gaussian))
(pole   <-lmer(dens ~scale(poleBA) +(1|block), xhab, weights =se,gaussian))
(sm     <-lmer(dens ~scale(sm) +(1|block), xhab, weights =se,gaussian))
#
aic <-AICc(null,dwd,big,yb,ro,con,ba,snag,sap,baCV,cnpy,cnpyCV,tsDivSt,
           scDiv,pole,sm)
aic.order <- order(aic[,2])
aic <- aic[aic.order,]
aic$delta <- aic$AICc - aic[1,2]
aic$wi <-exp(-0.5*aic[,3])/sum(exp(-0.5*aic[,3]))
aic

