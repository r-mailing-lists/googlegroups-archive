>
> fm2<-colext(psiformula=~y1.grass+y1.seed+y1.perch,
>             gammaformula=~y2.grass+y2.seed+y2.perch,
>             epsilonformula = ~y2.grass+y2.seed+y2.perch,
>             pformula=~1,data=umf1)
>
