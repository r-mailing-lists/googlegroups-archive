hi all,
 I stand corrected (I think), Murray's fix combined with Bill's seemed to possibly have fixed the problem.
 I am experimenting with this script below right now.... Will report more later
andy

N<- 100
K<- 12

# Simulate a data set. In this case with constant p but can change to heterogeneity
y<- matrix(0,nrow=N,ncol=K)
for(i in 1:N){

  p<- plogis(rnorm(1,-1.85, 0.5))

  y[i,]<- rbinom(K, 1, p)
  }

# observed data set, nind x K
y<- y[apply(y,1,sum)>0,]

# Need this
expit<- function(x){  1/(1+exp(-x)) }

# Likelihood function with sigma fixed (near 0) result should be close to Model M0 result

Mhlik <-function(parms, y2d ){

# Just two parameters
mu<- parms[1]

sigma<-exp(parms[2])
n0<-exp(parms[3])

K<- ncol(y2d)

nind<- nrow(y2d)

# add a row of zeros onto the matrix
 y2d<- rbind(y2d, rep(0,K))
# a vector to hold the result
il<-rep(NA,nrow(y2d))

# loop over rows of y2d and compute the marginal likelihood by evaluating the integral on a fine grid
# (note: the "integrate" function doesn't work either..... )
for(i in 1:nrow(y2d) ){
 ym <- as.vector(y2d[i,])

 eta.gr <http://eta.gr><- seq(-6,6,.05)

 f <-  function(eta, sig = sigma){

          #dbinom( sum(ym),K, expit(mu+eta), log=FALSE)*dnorm(eta,0,sig)

          apply(sapply(expit(mu+eta), dbinom, x = ym, size = 1),2,prod) * dnorm(eta,0,sig)
     }

 f.gr <http://f.gr><- f(eta.gr <http://eta.gr>)

 # Marginal likelihood right here:

 il[i]<- sum(f.gr <http://f.gr>*0.05)

}
# Sum this stuff up

-1*(    lgamma(n0+nind+1) - lgamma(n0+1) + sum(c(rep(1,nind),n0)*log(il)))
}

optim(c(-1,0,1), Mhlik, y2d=y)

