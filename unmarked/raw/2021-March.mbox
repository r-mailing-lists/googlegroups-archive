                     stateformulas=as.character(x$stateformulas),
                     data=x$data,
                     maxOrder=1,                       #Species interactions ignored
                     method="Nelder-Mead",   #To avoid "non-finite finite-difference value" errors
                     se=TRUE,
                     engine="C",
                     control=list(maxit=1000000))
