> > >
> > > )
> > >
> > > Models:
> > >
> > > #With pair
> > >
> > > fit_stack <- stan_occu(~ scale(mean_temp_surface)+
> > >
> > >                        scale(mean_temp_subsurface)+
> > >
> > >                        scale(mean_humidity)
> > >
> > >                      ~ scale(colony_pres_abs)+
