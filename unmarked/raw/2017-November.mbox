Obs<-read.csv("Obs.csv")

Wind<-read.csv("Wind.csv")

Cloud<-read.csv("Cloud.csv")

Rain<-read.csv("Rain.csv")

VegHt<-read.csv("VegHt.csv")

Obs.covs<-list(Obs,Wind,Cloud,Rain,VegHt)
names(Obs.covs) <- c("Obs", "Wind", "Cloud","Rain","VegHt")

WEME1<-unmarkedFramePCount(WEMEy,siteCovs=SiteCovs,obsCovs=Obs.covs)

fm.WEMENull<-pcount(~1~1,WEME1,K=50)
fm.WEMENull
plogis(coef(fm.WEMENull, type="det"))

Result:
p(Int)
0.04522228

I have run this in program Distance and have gotten much higher estimates for detection (around .70) for this species. Thus, I am wondering why my detection probability here is so low. Thanks so much for any insight!

