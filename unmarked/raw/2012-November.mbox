Hi again Rylee,

The last function I posted was wrong, but I think the one below is correct. However, it will not work if the number of sites with unknown occupancy status is >25 or so. In that case, you need to resort to simulation, which can be done using the second function below: sitesOccupiedSim(). Neither of these functions have been thoroughly tested, so use at your own risk.

Richard

p.s. I changed the name of this thread

sitesOccupied <- function(psi.c, cuts=c(0, 1)) {
    N <- length(psi.c)           # number of sites
    n <- sum(psi.c >= cuts[2])   # number of sites known to be occupied
    inrange <- (cuts[1] < psi.c) &
               (psi.c < cuts[2])
    n0max <- sum(inrange)        # nSites with unknown occupancy state
    psi.c0 <- psi.c[inrange]     # occupancy for sites with no dets
    postprobs <- rep(0, N+1)     # Posterior probabilities
    names(postprobs) <- 0:N
    for(n0 in 0:n0max) {         # Loop through possible values of n0
        cat("   doing", n0+1, "of", n0max+1, "\n")
        ind <- combn(n0max, n0)  # all possible locations for the n0 sites
        pz <- rep(NA, ncol(ind))
        for(j in 1:ncol(ind)) {
            z <- rep(0, n0max)   # True occupancy state
            z[ind[,j]] <- 1      # Creating all possibilities
            pz[j] <- exp(sum(dbinom(z, 1, psi.c0, log=TRUE)))
        }
        postprobs[n+n0+1] <- sum(pz)
    }
    cat("     unnormalized =", sum(postprobs), "\n")
    return(postprobs / sum(postprobs))
}

sitesOccupiedSim <- function(psi.c, nsim=1000) {
    M <- length(psi.c)           # number of sites
    sims <- matrix(NA, M, nsim)
    post <- rep(0, M+1)
    names(post) <- 0:M
    for(i in 1:nsim) {
        sims[,i] <- rbinom(M, 1, psi.c)
    }
    s <- colSums(sims)
    sf <- table(s)
    post[names(sf)] <- sf
    post <- post / nsim
    return(post)
}

psi.c4 <- c(1, 0.5, 0.1, 1, 1, 0.2, 0.4, 0.5, 0.5, 0.1, 0.001, 0.8,
            0.001, 0.00001, 0.999, 0.8, 0.5, 0.99, 0.4, 0.999, 0.5)
nsites4 <- length(psi.c4)
so4.1 <- sitesOccupied(psi.c4)
so4.2 <- sitesOccupiedSim(psi.c4, nsim=10000)

plot(0:nsites4, so4.1, type="h",
     xlab="Sites occupied", ylab="Posterior probability")
lines((0:nsites4)+0.3, so4.2, type="h", col=4)

q <- cumsum(so4.1)
results <- c(Est. = as.integer(names(which.max(so4.1))),
             lowerCI = as.integer(names(q)[max(which(q < 0.025))]),
             upperCI = as.integer(names(q)[min(which(q > 0.975))]))
