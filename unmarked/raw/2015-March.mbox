Hi Diego,

I think you want something like this:

oc1<-reshape(subset(anapla.dat,select=c("Year","Site","Boat","Scope")),
  timevar = "Year",idvar = "Site", direction="wide")

boat <- oc1[,paste("Boat", 1986:2014, sep=".")]
scope <- oc1[,paste("Scope", 1986:2014, sep=".")]
habitat <- sc1[,paste("Habitat", 1986:2014, sep=".")]
whole <- sc1[,paste("Whole", 1986:2014, sep=".")]

um.dat.covs<- unmarkedFramePCO(y = y[,2:30],

  siteCovs = sc1[,c("Habitat.1986", "Whole.1986")] ,
  yearlySiteCovs=list(boat=boat, scope=scope, whole=whole, habitat=habitat),
  numPrimary=T)

