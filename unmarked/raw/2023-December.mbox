pb <- parboot(fm, fitstats, nsim=20, report=1)

Warning message:
Model fitting failed in 20 sims

Error in t.star[i, ] : subscript out of bounds

If I evaluate distance and removal probabilities separately:

fitstats.r <- function(fm) {

  # Removal
  obs_rem <- fm@data@yRemoval
  exp_rem <- fitted(fm)$rem

  chisq_rem <- sum((obs_rem - exp_rem)^2 / exp_rem)
  sse_rem <- sum(residuals(fm)$rem^2)
  freetuke_rem <- sum((sqrt(obs_rem) - sqrt(exp_rem))^2)
 }

fitstats.d <- function(fm) {

 # Distance
  obs_dist <- fm@data@yDistance
  exp_dist <- fitted(fm)$dist

  chisq_dist <- sum((obs_dist - exp_dist)^2 / exp_dist)
  sse_dist <- sum(residuals(fm)$dist^2)
  freetuke_dist <- sum((sqrt(obs_dist) - sqrt(exp_dist))^2)
}

pb.r <- parboot(fm, fitstats.r, nsim=20)
pb.d <- parboot(fm, fitstats.d, nsim=20)

I can get it to work, but only if I don't include

c(SSE=sse_rem + sse_dist, Chisq = chisq_rem + chisq_dist, freemanTukey=freetuke_rem + freetuke_dist)

(which I modified to c(SSE=sse_rem, Chisq = chisq_rem, freemanTukey=freetuke_rem) for fitstats.r and did similar for fitstats.d)

But without that last line the output is difficult to interpret and I'm not sure it's actually working because it just gives me this:
Call: parboot(object = fm, statistic = fitstats.r, nsim = 20)

Parametric Bootstrap Statistics:
    t0 mean(t0 - t_B) StdDev(t0 - t_B) Pr(t_B > t0)
1 1891           1891                0            0

