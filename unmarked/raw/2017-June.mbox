Note that the function now identifies site covariates automatically so you don't have to add them in manually.  For example, if you combined your observation and additional site data into a single csv, it will (hopefully) distribute obsCovs and siteCovs correctly:

dat <- read.csv("~/HHB/HHB Analysis/R Analysis/Unmarked/Single Season Analysis/HHB3.csv")
sitecovs <- read.csv("~/HHB/HHB Analysis/R Analysis/Unmarked/Single Season Analysis/sitecovs3.csv" )
everything <- cbind(dat, sitecovs)
write.csv(everything, "~/HHB/HHB Analysis/R Analysis/Unmarked/Single Season Analysis/everything.csv", row.names = FALSE)
bat <- csvToUMF(filename = "~/HHB/HHB Analysis/R Analysis/Unmarked/Single Season Analysis/everything.csv", long = TRUE, type = "unmarkedFrameOccu")
str(bat)
