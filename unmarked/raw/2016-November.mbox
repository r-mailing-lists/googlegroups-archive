Hi Rob,

I think you must not have changed "area" in the siteCovs. I get different estimates when I change the area offset:

data(issj)
covs <- scale(issj[,c("elevation", "forest", "chaparral")])
area <- pi*300^2 / 10000

jayumf <- unmarkedFrameDS(y=as.matrix(issj[,1:3]),
                            siteCovs=data.frame(covs, area),
                            dist.breaks=c(0,100,200,300), unitsIn="m", survey="point")
## This model has an offset
fm1off<- distsamp(~chaparral ~chaparral + elevation + offset(log(area)),
                jayumf, keyfun="halfnorm", output="abund",
                starts=c(-2.8,1,0,4.5,0))

## This model doesn't have an offset
fm1 <- distsamp(~chaparral ~chaparral + elevation,
                jayumf, keyfun="halfnorm", output="abund",
                starts=c(-2.8,1,0,4.5,0))

covs <- scale(issj[,c("elevation", "forest", "chaparral")])

area <- 5

jayumf2 <- unmarkedFrameDS(y=as.matrix(issj[,1:3]),

                            siteCovs=data.frame(covs, area),
                            dist.breaks=c(0,100,200,300), unitsIn="m", survey="point")

fm2off<- distsamp(~chaparral ~chaparral + elevation + offset(log(area)),
                jayumf2, keyfun="halfnorm", output="abund",

                starts=c(-2.8,1,0,4.5,0))

## This model doesn't have an offset

fm2 <- distsamp(~chaparral ~chaparral + elevation,

                jayumf, keyfun="halfnorm", output="abund",
                starts=c(-2.8,1,0,4.5,0))

> coef(fm1)
           lam(Int)      lam(chaparral)      lam(elevation) p(sigma(Intercept))
          0.5145268           0.9569999          -0.2435514           4.7300774
  p(sigmachaparral)
         -0.2502567
> coef(fm1off)
           lam(Int)      lam(chaparral)      lam(elevation) p(sigma(Intercept))
         -2.8274327           0.9570043          -0.2435533           4.7300809
  p(sigmachaparral)
         -0.2502583
> coef(fm2)
           lam(Int)      lam(chaparral)      lam(elevation) p(sigma(Intercept))
          0.5145268           0.9569999          -0.2435514           4.7300774
  p(sigmachaparral)
         -0.2502567
> coef(fm2off)
           lam(Int)      lam(chaparral)      lam(elevation) p(sigma(Intercept))
         -1.0944331           0.9571926          -0.2435875           4.7299520
  p(sigmachaparral)
         -0.2503472

