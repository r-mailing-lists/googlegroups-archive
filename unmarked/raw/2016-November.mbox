I forgot to include the code leading up to the actual results so here it is.

soraMOD.exp<-list()

soraMOD.exp$sora.null<-gdistsamp(lambdaformula=~1, phiformula=~1, pformula=~1,
                             soraframe, keyfun="exp", output="abund", se=TRUE, unitsOut="ha")

soraMOD.exp$sora1<-gdistsamp(~TRX,~1,~1, soraframe, keyfun="exp", output="abund", se=TRUE, unitsOut="ha")

soraMOD.exp$sora2<-gdistsamp(~TRX,~1,~Cat, soraframe, keyfun="exp", output="abund", se=TRUE, unitsOut="ha")

soraMOD.exp$sora3<-gdistsamp(~TRX,~1,~AvgHgt, soraframe, keyfun="exp", output="abund", se=TRUE, unitsOut="ha")

soraMOD.exp$sora4<-gdistsamp(~TRX,~1,~Other, soraframe, keyfun="exp", output="abund", se=TRUE, unitsOut="ha")

datsora<-data.frame(TRX=c("C","CON","F","FC","FG","FGC","G","GC"))

soraFIT4<-predict(soraMOD.exp$sora1, type="lambda", newdata=datsora, appedData=T)

soraFIT4$TRX<-paste(datsora$TRX)

soraFIT4<-subset(soraFIT4, TRX!="C")

