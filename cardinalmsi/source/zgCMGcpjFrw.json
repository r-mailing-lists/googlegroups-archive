<span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">[[</span><span style=\"color:#066\">3</span><span style=\"color:#660\">]],</span><span style=\"color:#000\"> method </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;tic&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> BPPARAM </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#606\">SerialParam</span><span style=\"color:#660\">()))</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> process</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Cardinal</span><span style=\"color:#660\">::</span><span style=\"color:#000\">normalize</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">[[</span><span style=\"color:#066\">3</span><span style=\"color:#660\">]],</span><span style=\"color:#000\"> method </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;tic&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> BPPARAM </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#606\">SerialParam</span><span style=\"color:#660\">()))</span></div></code></div><br><br></div>"
