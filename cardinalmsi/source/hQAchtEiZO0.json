    [
     1,
     "<div dir=\"ltr\"><div>Hi Emily, <br></div><div><br></div><div>you don&#39;t need to know an m/z, you can also select regions on unsupervised clustering results e.g. pca, spatialkmeans, spatialshrunkencentroids: <br></div><div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#000\">segm_result </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> spatialShrunkenCentroids</span><span style=\"color:#660\">(</span><span style=\"color:#000\">test4</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> k</span><span style=\"color:#660\">=</span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> s</span><span style=\"color:#660\">=</span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> r</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>image</span><span style=\"color:#660\">(</span><span style=\"color:#000\">segm_result</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>ROI1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> selectROI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">segm_result</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> mode</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;region&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>ROI2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> selectROI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">segm_result</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> mode</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;region&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>regions </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> makeFactor</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ROI1</span><span style=\"color:#660\">=</span><span style=\"color:#000\">ROI1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ROI2</span><span style=\"color:#660\">=</span><span style=\"color:#000\">ROI2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>test4$region </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> regions<br>pData</span><span style=\"color:#660\">(</span><span style=\"color:#000\">test4</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span></div></code></div><br>Melanie<br></div></div>"
    ]
   ]
