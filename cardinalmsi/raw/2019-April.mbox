Works for me like this. I added 'Cardinal::' before the combine function to avoid calling another function named combine loaded into the environment. Also your loop construction seemed to have an error in the for line.

library(Cardinal)

rawdata_filenames <- c( '/imzmls/data1.imzml'
                       ,'/imzmls/data2.imzml'
                       ,'/imzmls/data3.imzml'
                       ,'/imzmls/data4.imzml'
                       ,'/imzmls/data5.imzml'
                       ,'/imzmls/data6.imzml'
                       ,'/imzmls/data7.imzml')

for (rawdata_filename in rawdata_filenames) {

  data <- readMSIData(rawdata_filename)
  if (exists("merged_samples") == FALSE) {
    merged_samples <- data
    }else{

    merged_samples <- Cardinal::combine(merged_samples, data)
  }
}

