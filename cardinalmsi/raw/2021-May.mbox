> boundingbox_ms_kmeans <- spatialKMeans(boundingbox_ms, r=1, k=3, method="gaussian")

> boundingbox_ms_ssc <- spatialShrunkenCentroids(boundingbox_ms, init=boundingbox_ms_kmeans, r=1, k=3, s=10)

