    ...
    for (n in 1:N) {
        mu[n] = beta0[subj[n]] + beta1[subj[n]] * x[n];
    }
    y ~ normal(mu, sigma);
}

Below is my new version (that doesn’t work) where I’m trying to get one beta by subject (as above) and for each predictor in the matrix X.
I receive the following error message: “base type mismatch in assignment; variable name = mu, type = real; right-hand side type=matrix”

data {
    int<lower=0> N;       // number of observations
    int<lower=0> n_subj;  // number of subjects
    vector[N] subj;       // subject indicator
    row_vector[2] X[N];   // predictors matrix
    vector[N] y;
    ...
// Note that X is a matrix:
