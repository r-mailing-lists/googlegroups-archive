    real<lower=0> ySd ;
  }
  model{
    yMean ~ normal(0,1) ;
    ySd ~ weibull(2,1) ;
    target += log_mix(
      normal_cdf(0,yMean,ySd)
      , normal_lpdf(y|-yMean,ySd)
      , normal_lpdf(y|yMean,ySd)
    ) ;
  }

