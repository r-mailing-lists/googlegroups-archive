> > >
> > > y1 <- train$mpg
> > > X1 <- as.matrix(train[, 3:7])
> > > N1 <- nrow(X1)
> > > D <- ncol(X1)
> > >
> > > X2 <- as.matrix(test[, 3:7])
> > > N2 <- nrow(X2)
> > >
> > > my_data <- list(x1 = X1, N1 = N1, D = D, y1 = y1, x2 = X2, N2 = N2)
> > > ```
> > >
> > > ### Step 2: Build the model
