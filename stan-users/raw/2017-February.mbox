  }
}
generated quantities{
  real<lower=0> mean_psi;
  vector[N] log_lik;
  real<lower=0> pi[N];
  real<lower=0> mean_pi;

  mean_psi = sum(psi)/N;

  // calculating log likelihood to get waic
  for(n in 1:N){
    log_lik[n] = bernoulli_lpmf(y[n]|psi[n]);
    pi[n] = psi[n]*(1-rho) + psi[n]*phi;
  }

  mean_pi = mean(pi);
}'

modc <- stan_model(model_code=mod)

