I corrected several syntactic errors. Could you take a look again? I think there are some problems with the math operations inside the function, but I don't what they are ...

functions {
  matrix rcsfun(int N, vector x, real knots) {
    vector[N] x1;
    vector[N] x2;
    vector[N] x3;
    x1 = x;
    x2 = ((x-knots[1] > 0) .* ((x-knots[1]) .* (x-knots[1]) .* (x-knots[1])) - (x-knots[3]>0) .* ((x-knots[3]) .* (x-knots[3]) .* (x-knots[3])) .* (knots[4]-knots[1]) / (knots[4]-knots[3]) + (x-knots[4]>0) .* ((x-knots[4]) .* (x-knots[4]) .* (x-knots[4])) .* (knots[3]-knots[1]) / (knots[4]-knots[3])) / ((knots[4]-knots[1]) * (knots[4]-knots[1]));
    x3 = ((x-knots[2] > 0) .* ((x-knots[1]) .* (x-knots[1]) .* (x-knots[1])) - (x-knots[3]>0) .* ((x-knots[3]) .* (x-knots[3]) .* (x-knots[3])) .* (knots[4]-knots[1]) ./ (knots[4]-knots[3]) + (x-knots[4]>0) .* ((x-knots[4]) .* (x-knots[4]) .* (x-knots[4])) .* (knots[3]-knots[2]) / (knots[4]-knots[3])) / ((knots[4]-knots[2]) * (knots[4]-knots[1]));
  return append_col(x1, x2, x3);

  }
}

data {
  int<lower=0> N;
  int<lower=0> y[N];
  int<lower=0, upper=1> Gender[N];
  real<lower=0> backpain[N];
  real Age[N];
  int<lower=0> M;
  int<lower=0, upper=M> practice[N];
  int<lower=0> Ncut;

  real knot_age[4];

}

generated quantities {
  real Age2[N];
  real Age3[N];

  Age2 = rcsfun(N, Age, knot_age)[,2];
  Age3 = rcsfun(N, Age, knot_age)[,3];

}

parameters {
  real beta_backpain;
  real beta_gender;
  real beta_age1;
  real beta_age2;
  real beta_age3;
  real b[M];
  ordered[Ncut] a;
  real<lower=0> sigma;
}

model {
  for (i in 1:N) {
    y[i] ~ ordered_logistic(beta_gender * Gender[i] + beta_backpain * backpain[i] + beta_age1 * Age[i] + beta_age2 * Age2[i] + beta_age3 * Age3[i] + b[practice[i]], a);
  }
  b ~ normal(0, sigma);
  beta_backpain ~ normal(0, 100);
  beta_gender ~ normal(0, 100);
  beta_age1 ~ normal(0, 100);
  beta_age2 ~ normal(0, 100);
  beta_age3 ~ normal(0, 100);
  sigma ~ cauchy(0,5);
}

