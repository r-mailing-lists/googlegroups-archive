Full Stan code:

data {
  int<lower = 0> N_obs;
  int<lower = 0> N_mis;

  int<lower = 1, upper = N_obs + N_mis> ii_obs[N_obs];
  int<lower = 1, upper = N_obs + N_mis> ii_mis[N_mis];

  real y_obs[N_obs];
}

parameters {
  real y_mis[N_mis];
  real y[N_obs + N_mis];
  y[ii_obs] = y_obs;
  y[ii_mis] = y_mis;

  real<lower=0> sigma_dynamic;
}

model {
  # Prior
  sigma_dynamic ~ gamma(1, 1);

  # Model/likelihood

  for(t in 2:N)
    y[t] ~ normal(y[t-1], sigma_dynamic);
}

