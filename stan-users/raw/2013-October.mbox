From: u1641d619313d04ab at groups.google.com (FHRB Toledo)
Date: Thu, 17 Oct 2013 17:10:42 +0000
Subject: Re: [stan-users] Slow Warmup with multivariate model in Rstan 2.0
Message-ID: <9GCAlBWVBtI.aebaK0eY2EAJ@stan-users.groups.google.com>
In-Reply-To: <9GCAlBWVBtI.HfLMwwXJbFQJ@stan-users.groups.google.com>
References: <9GCAlBWVBtI.eWIHquL9EnoJ@stan-users.groups.google.com> <9GCAlBWVBtI.HfLMwwXJbFQJ@stan-users.groups.google.com>
Archived-At: <https://groups.google.com/g/stan-users/c/9GCAlBWVBtI/m/aebaK0eY2EAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Daniel,

Thank indeed for your instant reply.

As requested I am forwarding the entire code and the data set is attached.

rm(list = ls()); ls() # clean WorkSpace

## requiring and setting
require(rstan) # interface R/Stan/C++ 'HMC'
set_cppo('fast') # fast optimization

## reading data
dataSet <- read.table('dataSet.txt'
                      header = TRUE,
                      sep = '\t',
                      dec = ',')

dataSet$entry <- factor(dataSet$entry)
y <- subset(dataSet, select = c('Pe', 'G', 'V'))
N <- nrow(y)
P <- ncol(y)
T <- nlevels(dataSet$entry)
X <- model.matrix(~ entry - 1, data = dataSet)
Omega <- diag(P) * c(.001, 1000, 200)
mu0 <- apply(y, 2, mean)

## input list to Stan
StanData <- list(y = y, # data matrix
                 N = N, # number of observations
                 P = P, # number of traits
                 T = T, # number of levels
                 X = X, # incidence matrix
                 Omega = Omega, # priori for Wishart
                 mu0 = mu0) # priori for mu

## Source Code
sourceCode <- "
data {
   int<lower=0> N;
   int<lower=0> P;
   int<lower=0> T;
   vector[ P ] y[ N ];
   vector[ T ] X[ N ];
   vector[ P ] mu0;
   cov_matrix[ P ] Omega;
}
transformed data {
   real nu;
   nu <- P * ( P + 1.0 ) / 2.0;
}
parameters {
   matrix[ P, T ] alpha;
   cov_matrix[ P ] Gen;
   cov_matrix[ P ] Res;
}
transformed parameters {
   vector[ P ] mu[ N ];
   for ( p in 1:P )
         for ( n in 1:N )
            mu[ n, p ] <- dot_product( X[ n ], alpha[ p ] );
}
model {
  Gen ~ inv_wishart( nu, Omega );
   for ( t in 1:T )
     col( alpha, t ) ~ multi_normal( mu0, Gen );
  Res ~ inv_wishart( nu, Omega );
  for ( n in 1:N )
     y[ n ] ~ multi_normal( mu[ n ], Res );
}
"

## translating, compiling, dyn.load and sampling
fit <- stan(model_code = sourceCode, # compiled code
            data = StanData, # data input
            init = 'random', # != seeds p/ cade
            chain = 2, # chain number
            iter = 2E4, # run length
            warmup = 2E3, # like the burn-in
            thin = 20, # between samples
            pars = 'Gen') # monitor

## summary
print(fit, digits = 4)

Best Regards,
FH

