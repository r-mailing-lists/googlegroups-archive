Thanks a lot for these useful hints, Bob (and generally thanks for Stan which is brilliant!).

I tried coding a fake-data example for a Dirichlet regression model where y consists of vectors of proportions summing to one, but these vectors have different lengths, and the covariates are specific to the units giving rise to the individual proportions.

Sampling works in principle and sometimes I can recover the true values, but most of the time I encounter numerical problems during sampling (overflow in the gamma function, or lgamma at negative). It looks like the coefficients drift off to the extremes. I'm wondering if there is any obvious mistake in my Stan code or should I more closely investigate the prior on the coefficients (although lowering the variance there seems not to help much)?

Thanks in advance!

# create some fake data for Dirichlet regression
# 100 simplexes of dimension 3, 100 of dimension 4
# the x's are specific to the 700 components

library(MCMCpack) # for rdirichlet()
xm <- matrix(c(rep(1,700),rnorm(700)),nrow=700)
# set coefs here:
sim.alpha <- exp(xm %*% matrix(c(5,.5),nrow=2))
sim.alpha.m.1 <- matrix(sim.alpha[1:300],nrow=100,byrow=T)
sim.alpha.m.2 <- matrix(sim.alpha[301:700],nrow=100,byrow=T)

y.m.1 <- matrix(NA,nrow=100,ncol=3)
y.m.2 <- matrix(NA,nrow=100,ncol=4)
for (i in 1:100){
  y.m.1[i,1:3] <- rdirichlet(1,sim.alpha.m.1[i,])
  y.m.2[i,1:4] <- rdirichlet(1,sim.alpha.m.2[i,])
}
y <- c(as.vector(t(y.m.1)),as.vector(t(y.m.2)))
llength <- c(rep(3,100),rep(4,100))

######## Stan model

data {
int<lower=1> L; // number of simplexes
int<lower=1> N; // number of proportions (sum over simplexes)
simplex[3] y_3[100];
simplex[4] y_4[100];
int<lower=1> C; // number of coefs
matrix[N,C] xm; // indepvars
}

parameters {
vector[C] coef;
}

model {
int i;
vector<lower=0>[N] alphavec;
vector<lower=0>[3] alpha_3;
vector<lower=0>[4] alpha_4;

coef ~ normal(0.0,5.0);
alphavec <-  exp(xm * coef);

for(l in 1:100){
for(s in 1:3){
alpha_3[s] <- alphavec[((l-1)*3+s)];
}
y_3[l] ~ dirichlet(alpha_3);
}

for(l in 101:200){
for(s in 1:4){
alpha_4[s] <- alphavec[(300+(l-101)*4+s)];
}
y_4[l-100] ~ dirichlet(alpha_4);
}
