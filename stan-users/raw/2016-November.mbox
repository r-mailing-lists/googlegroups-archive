transformed data{

  # zeroesForFacMeans: vector of zeroes for factor means
  vector[3] zeroesForFacMeans ;
  zeroesForFacMeans = rep_vector(0,3) ;

}
parameters{

  # facCor: correlations amongst the 3 latent factors
  corr_matrix[3] facCor ;

  # subjFacs: matrix of values for each factor associated with each subject

  // matrix[N,3] subjFacs ;
  vector[3] subjFacs[N] ;

  # outcomeMeans: means for each outcome
  vector[9] outcomeMeans ;

  # outcomeSds: SDs for each outcome
  vector<lower=0>[9] outcomeSds ;

  # betas: how each factor loads on to each outcome.

  vector<lower=0>[3] positive_betas ;
  vector[6] betas ;

}
model{

  #priors, assumes data have been scale()ed
  facCor ~ lkj_corr(1) ;
  outcomeMeans ~ normal(0,1) ;
  outcomeSds ~ weibull(2,1) ;

  positive_betas ~ normal(0,1) ;

  betas ~ normal(0,1) ;

  #generative model:

  subjFacs ~ multi_normal(zeroesForFacMeans, facCor) ;
  Y[,1] ~ normal( to_vector(subjFacs[,1])*positive_betas[1] + outcomeMeans[1] , outcomeSds[1] ) ;
  Y[,2] ~ normal( to_vector(subjFacs[,1])*betas[1]          + outcomeMeans[2] , outcomeSds[2] ) ;
  Y[,3] ~ normal( to_vector(subjFacs[,1])*betas[2]          + outcomeMeans[3] , outcomeSds[3] ) ;
  Y[,4] ~ normal( to_vector(subjFacs[,2])*positive_betas[2] + outcomeMeans[4] , outcomeSds[4] ) ;
  Y[,5] ~ normal( to_vector(subjFacs[,2])*betas[3]          + outcomeMeans[5] , outcomeSds[5] ) ;
  Y[,6] ~ normal( to_vector(subjFacs[,2])*betas[4]          + outcomeMeans[6] , outcomeSds[6] ) ;
  Y[,7] ~ normal( to_vector(subjFacs[,3])*positive_betas[3] + outcomeMeans[7] , outcomeSds[7] ) ;
  Y[,8] ~ normal( to_vector(subjFacs[,3])*betas[5]          + outcomeMeans[8] , outcomeSds[8] ) ;
  Y[,9] ~ normal( to_vector(subjFacs[,3])*betas[6]          + outcomeMeans[9] , outcomeSds[9] ) ;

}

