In previous example, I have put in the data, but didn't use it.
This time, I simply drew samples from multivariate normal distribution and the R code is like

library(rstan)
model <- '
data{
  matrix[6,6] sigma1;
}
transformed data {
  matrix[6,6] L;
  vector[6] mu1;
  mu1[1] <- 0; mu1[2] <- 0; mu1[3] <- 0;
  mu1[4] <- 0; mu1[5] <- 0; mu1[6] <- 0;
  L <- cholesky_decompose(sigma1);
}
parameters{
  vector[6] randnum;
}
transformed parameters {
  vector[6] y;
  y <- mu1 + L * randnum;
}
model {
  randnum ~ normal(0,1);
}
'
sigma1 <- diag(6) * 2
sigma1[2,1] <- 1; sigma1[1,2] <- sigma1[2,1];
sigma1[3,1] <- 1; sigma1[1,3] <- sigma1[3,1];
sigma1[4,1] <- -1; sigma1[1,4] <- sigma1[4,1];
sigma1[5,1] <- -1; sigma1[1,5] <- sigma1[5,1];
sigma1[6,1] <- 0; sigma1[1,6] <- sigma1[6,1];
sigma1[2,3] <- 1; sigma1[3,2] <- sigma1[2,3];
sigma1[2,4] <- 1; sigma1[4,2] <- sigma1[2,4];
sigma1[2,5] <- 0; sigma1[5,2] <- sigma1[2,5];
sigma1[2,6] <- -1; sigma1[6,2] <- sigma1[2,6];
sigma1[3,4] <- 0; sigma1[4,3] <- sigma1[3,4];
sigma1[3,5] <- 1; sigma1[5,3] <- sigma1[3,5];
sigma1[3,6] <- 1; sigma1[6,3] <- sigma1[3,6];
sigma1[4,5] <- 1; sigma1[5,4] <- sigma1[4,5];
sigma1[4,6] <- -1; sigma1[6,4] <- sigma1[4,6];
sigma1[5,6] <- 1; sigma1[6,5] <- sigma1[5,6];
data <- list(sigma1=sigma1)
fit1 <- stan(model_code=model,data=data,
             iter=100000,chains=1,thin=1)

# extract samples
fit_ss <- extract(fit1, permuted = TRUE)
yy <- fit_ss$y

