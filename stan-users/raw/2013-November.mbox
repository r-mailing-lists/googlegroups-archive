       BOOST_PP_CAT(boost_concept_check,__LINE__)
       ^
pystan/stan/lib/boost_1.54.0/boost/concept/assert.hpp:44:5: note: in expansion of macro 'BOOST_CONCEPT_ASSERT_FN'
     BOOST_CONCEPT_ASSERT_FN(void(*)ModelInParens)
     ^
pystan/stan/lib/boost_1.54.0/boost/spirit/home/qi/parse_attr.hpp:54:9: note: in expansion of macro 'BOOST_CONCEPT_ASSERT'
         BOOST_CONCEPT_ASSERT((ForwardIterator<Iterator>));
         ^
pystan/stan/lib/boost_1.54.0/boost/spirit/home/qi/parse_attr.hpp: In function 'bool boost::spirit::qi::phrase_parse(Iterator&, Iterator, const Expr&, const Skipper&, boost::spirit::qi::skip_flag::enum_type, A0&, A1&, A2&, A3&, A4&, A5&, A6&, A7&, A8&, A9&)':
pystan/stan/lib/boost_1.54.0/boost/concept/detail/general.hpp:71:20: warning: typedef 'boost_concept_check98' locally defined but not used [-Wunused-local-typedefs]
       BOOST_PP_CAT(boost_concept_check,__LINE__)

-Ken

