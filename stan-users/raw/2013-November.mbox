You can replace these six assignments with:

   mu1 <- rep_vector(0.0, 6);

>    L <- cholesky_decompose(sigma1);
> }
> parameters{
>    vector[6] randnum;
> }
> transformed parameters {
>    vector[6] y;
>    y <- mu1 + L * randnum;

If the mu1 are all 0, you could just drop mu1
altogether for this model.

> }
> model {
>    randnum ~ normal(0,1);
> }
> '
> sigma1 <- diag(pair_num) * 2

> sigma1[2,1] <- 1; sigma1[1,2] <- sigma1[2,1];
> sigma1[3,1] <- 1; sigma1[1,3] <- sigma1[3,1];
> sigma1[4,1] <- -1; sigma1[1,4] <- sigma1[4,1];
> sigma1[5,1] <- -1; sigma1[1,5] <- sigma1[5,1];
> sigma1[6,1] <- 0; sigma1[1,6] <- sigma1[6,1];
