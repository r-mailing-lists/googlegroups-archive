Daniel,

I am using Rstan < 2.2.0 (something from December last year).

The code is:
    data {
        int<lower=0> N;
        int<lower=0> NL;
        int<lower=0> lot [N];
        int<lower=0> counts [N];
    }

    transformed data {
    }

    parameters {
        real alpha0;
        real<lower=0> sigma2_alpha;
        real<lower=0> sigma2_gamma;
        real alpha [NL];
        real<lower=0> shape;
        real gamma [N];
    }

    transformed parameters {
        real<lower=0> sigma_alpha;
        real<lower=0> sigma_gamma;
        vector[N] log_lik;
        real mu [N];

        sigma_alpha <- sqrt (sigma2_alpha);
        sigma_gamma <- sqrt (sigma2_gamma);
        for (i in 1 : N) {
            mu [i] <- exp (alpha0 + alpha [lot [i]] + gamma [i]);
            log_lik [i] <- neg_binomial_log (counts [i], shape,
                shape / mu [i]);
        }
    }

    model {
        alpha0 ~ normal (0, 100);
        sigma2_alpha ~ cauchy (0, 5);
        alpha ~ normal (0, sigma_alpha);
        gamma ~ normal (0, sigma_gamma);
        shape ~ cauchy (0, 5);
        increment_log_prob (sum (log_lik));
    }
    generated quantities {
        real alpha_rep;
        real gamma_rep [5];
        real y_rep [5];
        real y_mean;
        real mu_rep [5];

        alpha_rep <- normal_rng (0, sigma_alpha);
        for (i in 1 : 5) {
            gamma_rep [i] <- normal_rng (0, sigma_gamma);
            mu_rep [i] <- exp (alpha0 + alpha_rep + gamma_rep [i]);
            y_rep [i] <- poisson_rng (gamma_rng (shape,
                shape / mu_rep [i]));
        }
        y_mean <- mean (y_rep);
    }

Linas

