    Z <- append_col(X, week_s);

  }

parameters {

vector[k+H+4] alpha;

real <lower=0> taud;

}

model {

    vector[N] mud;

    mud <- Z*alpha;

    alpha ~ normal(0,10);

  taud ~ cauchy(0,5);

DeathRate ~ normal(mud, taud);

}"

