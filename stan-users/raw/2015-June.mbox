I'm sorry that I didn't check my code. You have to move a[i] before mu[i], because the line order is important in Stan.

I confirmed the following code works:

data {
  int<lower=0> N;
  int y[N];
}

parameters {
  real b0;
  real b;
  real phi;

  vector[N] u;

}

transformed parameters {
  vector[N] mu;
  vector[N] a;

  a[1] <- phi + u[1];

  mu[1] <- exp(b0 + a[1]);

  for (i in 2:N) {

    a[i] <- phi*a[i-1] + u[i];
    mu[i] <- exp(b0 + log(i)*b + a[i]);
  }
}

model {
  u ~ normal(0, 1);
  b0 ~ normal(0, 10);
  b ~ normal(0, 10);
  phi ~ normal(0, 10);
  y ~ poisson(mu);
}

-Bee

