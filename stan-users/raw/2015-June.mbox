>     for ( k in 1:K-1)
>
>         thresh[k] ~ normal( k+0.5, 10);
>
>     for (n in 1:N) {
>
>         eta[1] <- x[n]*b1;
>
>         eta[2] <- x[n]*b2;
>
>         eta[3] <- x[n]*b3;
>
>         eta[4] <- x[n]*b4;
>
>         eta[5] <- x[n]*b5;
>
>         eta[6] <- x[n]*b6;
>
>         eta[7] <- x[n]*b7;
>
>         prob[1] <- inv_logit(thresh[1] - eta[1]);
>
>         for (k in 2:(K-1)) {
>
>             eta[k]  <- x[n]*b[]
>
>             prob[k] <- inv_logit(thresh[k] - eta[k]) - inv_logit(thresh[k-1] - eta[k-1]);
>
>         }
>
>         prob[K] <- 1 - inv_logit(thresh[K-1] - eta[K-1]);
>
>         y[n] ~ categorical(prob);
>
>     }
>
> }
