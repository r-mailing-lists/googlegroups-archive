Hi,

You should move u to parameters block and pay attention to dnorm(mean, tau) in BUGS but normal(mean, stddev) in Stan. So, you can rewrite your model as:

data {
  int<lower=0> N;
  int y[N];
}

parameters {
  real b0;
  real b;
  real phi;

  vector[N] u;

}

transformed parameters {
  vector[N] mu;
  vector[N] a;

  a[1] <- phi + u[1];
  mu[1] <- exp(b0 + a[1]);

  for (i in 2:N) {
    mu[i] <- exp(b0 + log(i)*b + a[i]);
    a[i] <- phi*a[i-1] + u[i];
  }
}

model {
  u ~ normal(0, 1);

  b0 ~ normal(0, 10);
  b ~ normal(0, 10);
  phi ~ normal(0, 10);
  y ~ poisson(mu);
}

-Bee

