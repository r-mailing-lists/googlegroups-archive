You need to restrict the range of tau:

data {
  int<lower=1> N;
  vector<lower=0>[N] y;
}
transformed data {
  real<lower=0> min_y;
  min_y <- min(y);
}
parameters {
  real<lower=0,upper=10> lambda;
  real<lower=0,upper=min_y> tau;
}
model {
  // ignore parser message about Jacobian adjustment
  y - tau ~ exponential(lambda);
}

Ben

