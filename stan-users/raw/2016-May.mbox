Hi Andre, thanks for the reply. i tried several models, here is one of the simplest version (not using random initial seed).

....

parameters {
  real <lower = 0> sigma;
  real <lower = 0, upper = 1> alpha;
  vector[N] u;
}
transformed parameters {
  vector[N] l;
  l[1] <- log(y[1] + 1);

  for (t in 2:N) {

    l[t] <- alpha * u[t] + (1 - alpha) * l[t-1];
  }
}
model {
  sigma ~ cauchy(0,2) T[0,];
  u[1] ~ normal(l[1], sigma);

  for (t in 2:N) {

    u[t] ~ normal(l[t-1], sigma);
  }

  for (t in 1:N) {

    if (flag[t] == 1) {
      increment_log_prob(poisson_ccdf_log(y[t], exp(u[t])));

    } else {
      increment_log_prob(poisson_log_log(y[t], u[t]));
    }
  }
}

