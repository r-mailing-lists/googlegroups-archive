Hi All,

Sorry it took me a while to respond/implement changes.

Unfortunately, I have over 100,000 bins, so I think Julian's suggestion does not give me much!

I have tried removing one condition for all random effect variables and have this be swallowed by the non-random intercept. Another idea that came to mind is to run the model piecewise, i.e. separately for the first ten time periods and then for the second ten time periods, and then "set" the distributions in the second run for t=1 to Normal with the observed mean and standard deviation of the previous run. Is this a legitimate approach?

On the other hand, the following model for N=80,000 and t=8 still runs on about 10 iterations a day, which seems crazy slow:

data {
  int<lower=0> N;                                         // sample wave_size
  int<lower=0> n_age;                                     // number of age categories
  int<lower=0> n_race;                                    // number of race categories
  int<lower=0> n_edu;                                     // number of education catoegories

  int<lower=0> n_division;                                // number of Divisions
  int<lower=0> n_states;                                  // number of States

  int<lower=0> n_party_id;                                // number of party-categories

  int<lower=0> n_waves;                                   // number of Waves
  int<lower=0,upper=n_division> division[N];              // Division for each respondent
  int<lower=0,upper=1> gender[N];                         // Gender each respondent

  int<lower=0,upper=n_age> age[N];                        // age for each respondent
  int<lower=0,upper=n_edu> edu[N];                        // edu for each respondent
  int<lower=0,upper=n_race> race[N];                      // race for each respondent
  int<lower=0,upper=n_party_id> party_id[N];              // party_id for each respondent

  real vote_prev_state[N];                                // 2012 state-vote at the individual-level

  int<lower=0,upper=1> y[N];                              // vote-choice

  int<lower=0,upper=N> in_wave[N];                        // wave of respondents
  int<lower=0>        wave_size[n_waves];                 // N individuals per Wave
 int<lower=0> wave_lims[n_waves,2];                       // first individual in wave and individuals per wave                                                              (5*2 matrix)
}
parameters {

  real beta [n_waves];                                    // coefficient-array for female; wave
  vector[n_age] a_age [n_waves];                          // coefficient-array for age; wave
  vector[n_edu] a_edu [n_waves];                          // coefficient-array for edu; wave
  vector[n_race] a_race [n_waves];                        // coefficient-array for race; wave
  vector[n_party_id] a_party_id [n_waves];                // coefficient-array for party_id; wave
  vector [n_division] a_division[n_waves];                // coefficient-array for division; wave

  real gamma;                                             // previous vote- slope

  real <lower=0> sigma_division;

  real <lower=0> sigma_age;
  real <lower=0> sigma_edu;
  real <lower=0> sigma_race;
  real <lower=0> sigma_party_id;

  real <lower=0> sigma_evolution_beta;
  real <lower=0> sigma_evolution_age;
  real <lower=0> sigma_evolution_edu;
  real <lower=0> sigma_evolution_race;
  real <lower=0> sigma_evolution_party_id;
  real <lower=0> sigma_evolution_division;

}
model {
  sigma_division ~normal(0,1.25);                          // within_division variance can move from 0.1% and 99%
  sigma_age ~normal(0,1.25);                          // within_division variance can move from 0.1% and 99%
  sigma_edu ~normal(0,1.25);                          // within_division variance can move from 0.1% and 99%
  sigma_race ~normal(0,1.25);                          // within_division variance can move from 0.1% and 99%
  sigma_party_id ~normal(0,1.25);                          // within_division variance can move from 0.1% and 99%
  sigma_evolution_beta~normal(0,0.1);
  sigma_evolution_age~normal(0,0.1);
  sigma_evolution_edu~normal(0,0.1);
  sigma_evolution_race~normal(0,0.1);
  sigma_evolution_party_id~normal(0,0.1);
  sigma_evolution_division~normal(0,0.1);

  beta[1]~normal(0,2.5);                                  // embed 95% probability mass between 0.1% and 99%
  gamma~normal(0,2.5);                                    // embed 95% probability mass between 0.01% and 99.9%                                                           // (Gelman 2008)

  a_division[1]~ normal(0,sigma_division);                         // embed 95% probability mass between 70% and 30%

  a_age[1]~normal(0,sigma_age);                                 // embed 95% probability mass between 0.01% and 99.9%
  a_edu[1]~normal(0,sigma_edu);                                 // embed 95% probability mass between 0.01% and 99.9%
  a_race[1]~normal(0,sigma_race);                                // embed 95% probability mass between 0.01% and 99.9%
  a_party_id[1]~normal(0,sigma_party_id);                            // embed 95% probability mass between 0.01% and 99.9%

  for (k in 2:n_waves) {
    beta[k] ~ normal(beta[k-1], sigma_evolution_beta);                    //  assume 5% shift per demographic per wave covers                                                            // 95% of probability mass
    a_age[k] ~ normal(a_age[k-1], sigma_evolution_age);                  // assume 5% shift per demographic per wave covers                                                             // 95% of probability mass
    a_edu[k] ~ normal(a_edu[k-1], sigma_evolution_edu);                  // assume 5% shift per demographic per wave covers

                                                          // 95% of probability mass

    a_race[k] ~ normal(a_race[k-1],sigma_evolution_race);                // assume 5% shift per demographic per wave covers                                                             // 95% of probability mass
    a_party_id[k] ~ normal(a_party_id[k-1], sigma_evolution_party_id);        // assume 5% shift per demographic per wave covers                                                             // 95% of probability mass
    a_division[k] ~ normal(a_division[k-1], sigma_evolution_division);

}
                                                          //Likelihood for each i in each wave

for(s in 1:n_waves){
      int obs_in_wave[wave_size[s]];

obs_in_wave<-segment(in_wave,wave_lims[s,1],wave_lims[s,2]) ;   // find observations in each wave
  for (i in 1:wave_size[s]) {
real y_hat;
    y_hat <-
    beta[s]*gender[obs_in_wave[i]]
    +a_age[s,age[obs_in_wave[i]]]
    +a_edu[s,edu[obs_in_wave[i]]]
    +a_party_id[s,party_id[obs_in_wave[i]]]
    +a_race[s,race[obs_in_wave[i]]]+gamma*vote_prev_state[i]
    +a_division[s,division[obs_in_wave[i]]];
    y[obs_in_wave[i]] ~ bernoulli_logit(y_hat);
  }
  }
  }

Thanks,
Tobi

