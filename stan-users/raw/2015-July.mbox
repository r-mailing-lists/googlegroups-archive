    SYN_LN_mu_high    = +5.0,
    SYN_LN_sigma_low  =  0.9,
    SYN_LN_sigma_high =  0.5,
    SYN_proportion    =  0.5,
    SYN_offset        =  0.0,
    SYN_scatter       =  0.000001,
    #-- STAN Parameter
    STAN_Compile      = 0,
    STAN_MCMC_Steps   = 1000,
    STAN_Chains       = 4
    )

num_a <-round(     Parse_Input_Parameter$SYN_proportion *Parse_Input_Parameter$NumData)
num_b <-round((1.0-Parse_Input_Parameter$SYN_proportion)*Parse_Input_Parameter$NumData)

Synthetic_data <- rlnorm(num_a, Parse_Input_Parameter$SYN_LN_mu_low, Parse_Input_Parameter$SYN_LN_sigma_low)
Synthetic_data <- c(Synthetic_data, rlnorm(num_b, Parse_Input_Parameter$SYN_LN_mu_high, Parse_Input_Parameter$SYN_LN_sigma_high))
Synthetic_data <- Synthetic_data +  rnorm(Parse_Input_Parameter$NumData, Parse_Input_Parameter$SYN_offset, Parse_Input_Parameter$SYN_scatter)

stan_data <- list(NumData = Parse_Input_Parameter$NumData, Measured_Data = Synthetic_data)
fit <- stan(file = 'Mixture_LogNormal.stan', data = stan_data, iter = Parse_Input_Parameter$STAN_MCMC_Steps, chains = Parse_Input_Parameter$STAN_Chains)

