> Synthetic_data <- c(Synthetic_data, rlnorm(num_b, Parse_Input_Parameter$SYN_LN_mu_high, Parse_Input_Parameter$SYN_LN_sigma_high))
> Synthetic_data <- Synthetic_data +  rnorm(Parse_Input_Parameter$NumData, Parse_Input_Parameter$SYN_offset, Parse_Input_Parameter$SYN_scatter)
