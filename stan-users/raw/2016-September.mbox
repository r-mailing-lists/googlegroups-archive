>         }
>         omega[j] = diag_matrix(al) * inverse(lambda[j]) * diag_matrix(al);
>       }
>     }
>
>     model {
>       rho ~ dirichlet(rep_vector(1.0, k));
>       for (j in 1:k) {
>         mu[j] ~ normal(0, 1);
>         lambda[j] ~ lkj_corr(1);
>         h[j] ~ exponential(1);
>       }
>
>       for (i in 1:n) {
>         real p[k];
>         for (j in 1:k) {
>           row_vector[d] z;
>           z = x[i] - mu[j];
>           p[j] = log(rho[j]) + multi_normal_prec_lpdf(x[i] | mu[j], omega[j]);
>         }
>
>         target += log_sum_exp(p);
>       }
>     }"
>
>   library(rstan)
>   n = dim(x)[1]
>   d = dim(x)[2]
>
>   # scale training set
>   means = colMeans(x)
>   stds = apply(x, 2, sd)
>   x = t(apply(x, 1, function(v) { return((v - means)/stds) }))
>   pars = c("rho", "mu", "lambda", "omega", "h")
>   identities = list()
>   ones = list()
>   for (j in 1:k) {
