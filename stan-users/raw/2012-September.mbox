Or you can do something like

data {
  int<lower=1> K;
}
transformed data {
  int K_choose_2;
  K_choose_2 <- K * (K - 1) / 2;
}
parameters {
  real<lower=-200,upper=200> lowers[K_choose_2];
  real<lower=0,upper=0.001>  uppers[K_choose_2];
  real<lower=0,upper=200>     diagonals[K];
}
transformed parameters {
  matrix[K,K] mu;
  // for loops to put lowers, uppers, and diagonals into mu
}

Ben

From u2a7f346506a3e9ff at groups.google.com  Sun Sep 30 19:58:04 2012
From: u2a7f346506a3e9ff at groups.google.com (Marcus Brubaker)
Date: Sun, 30 Sep 2012 19:58:04 +0000
