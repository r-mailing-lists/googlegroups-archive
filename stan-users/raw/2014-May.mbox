data {
  int<lower=0> N;
  int<lower=0> M;         // Number of  ID's
  int<lower=0> noc;       // Number of Outcomes (4)
  vector[noc] Numer[N];  // Numerator for  4  outcomes (noc)
  vector[noc] Deno[N];   // Denominator for 4 outcomes (noc)
  int ID[N];
  cov_matrix[noc] Imat; // Identity matrix
  cov_matrix[noc] mu;
  vector[noc] a0;

}
parameters {
   vector[noc] beta0[M];
   vector[noc] z0;
   cov_matrix[noc] Omega0;
}

transformed parameters {

 real<lower=0,upper=1> p[M,noc];

 for(i in 1:4)
 {
 for (j in 1:M)
 {
    p[j,i] <- inv_logit(beta0[j,i]);
}
}
}

model {

    z0~multi_normal(a0,mu);
    Omega0 ~ inv_wishart(noc, Imat);

for(i in 1:M)
{
    beta0[i] ~ multi_normal(z0 , Omega0);

}

for(i in 1:4)
{
for(j in 1:N)
{
// Logit Log Likelihood

 increment_log_prob( Numer[j,i]*log(exp(beta0[ID[j],i]))-Deno[j,i]*log(1+exp(beta0[CCG[j],i])));

//  increment_log_prob(binomial_logit_log(Numer[j], Deno[j], beta0[ID[j]]));
//  Numer[j,i] ~ binomial_logit(Deno[j,i], beta0[ID[j],i]);
}
}
}

--------------------------------------------------

# Number of outcomes

noc=4

# 4X4 indentity matrix

Imat=diag(4)*1

a0=rep(0,4)

mu=diag(4)*0.0001

fit <- stan(file = "Multi.stan", data = c("N","M", "Numer","ID", "Deno","noc","Imat", "a0", "mu"), iter = 1000, chains = 4)

