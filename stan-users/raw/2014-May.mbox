omega ~ inv_wishart( M , C0V );
phi[1] ~ multi_normal( mu0p , C0p );
beta[1] ~ multi_normal( phi[1].*mu0b , C0b );
Y[1] ~ multi_normal( X*beta[1] , omega ) ;

{
vector[N]           mu[T-1];

  for (t in 2:T) {
    mu[t] <- phi[t] .* beta[t-1] ; // elementwise multiplication
    beta[t] ~ multi_normal( mu[t] , sigma ) ;
  }

}

{
vector[M]           mu[T-1];

  for (t in 2:T) {

    mu[t] <- X * beta[t] ; // elementwise multiplication

    Y[t] ~ multi_normal( mu[t] , omega ) ;
  }

}

}
"

