Thanks. I understand you not having time to debug my examples. You have all been a big help so far. I'm not quite sure how to best define mu[1],...,mu[N]. Perhaps a for loop will do the trick for me. I am using PyStan as my interface. Here is the entire code (excluding imports).

model_code = """

    data {

      int<lower=0> N; //rows of data

      int<lower=0> K; // number of covariates

      int<lower=0> J; // number of groups (random effects)

      matrix[N,K] x; // predictor matrix

      real y[N]; // response

      int<lower=0, upper=J-1> random[N]; //random effect

    }

    parameters {

      vector[K] beta; //intercept and slope parameters

      real<lower=0, upper=10> sigma; // dispersion parameter

      vector[J] u; // random intercepts

      real<lower=0, upper=10> sigma_u; // random intercept SD

    }

    model {

      // local variables

      vector[N] mu;

      // priors

      u ~ normal(0,sigma_u);

      beta ~ normal(0,10);

      // data model

      mu[N] <- x[N] * beta + u[random[N]];

      y ~ normal(mu, sigma);

    }

    """

diet_dat = ({'N':len(df),

            'K': 3,

            'J': 9,

            'y': list(df['y']),

            'x': np.matrix([np.ones(len(df)).astype(int),

                            list(df['x1']),

                            list(pd.Categorical(df['x2']).codes)]).T,

            'random': list(pd.Categorical(df['random']).codes)

            })

fit = pystan.stan(model_code=model_code, data=df,

                  iter=1000, chains=4)

