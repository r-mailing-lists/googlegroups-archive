>>> }
>>> data {
>>>   int<lower=1> T;
>>>   real z[T];
>>>   vector<lower=0>[1] sigma;
>>>   real y0[2];
>>>   real t0;
>>>   real ts[T];
>>> }
>>> transformed data {
