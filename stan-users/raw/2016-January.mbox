Thanks, Daniel.
I am confused now.
I think a categorical distribution is similar to a Bernoulli distribution. A single int on the left side shouldn't be a problem.
Here is my model:

data {
  int N;                         // number of assignment

  int J;                         // number of raters
  int C;                         // number of rating categories
  int<lower=1, upper=C> Y[N, J]; // rating data matrix
}

parameters {
  real theta[N];               // assignment true score
  real delta[J];               // rater sys bias
  real a[J];                   // rater discrimination
  ordered[C-1] gamma;          // threshold
  real<lower=0> tau[J];        // rater precision parameter
}

model {
  real sigma[J];
  real prob[N, J, C];
  theta ~ normal(0, 1);
  delta ~ normal(0, 2);
  a ~ lognormal(0, 0.5);
  gamma ~ normal(0, 2);
  tau ~ gamma(1, 1);
  for (j in 1:J)
  sigma[j] <- pow(tau[j], -0.5);

  for (n in 1:N) {
     for (j in 1:J) {
      for (c in 2:(C-1)) {
      prob[n, j, c] <- normal_cdf((gamma[c]-a[j]*theta[n]-delta[j]), 0, sigma[j]) - normal_cdf((gamma[c-1]-a[j]*theta[n]-delta[j]), 0, sigma[j]); }
      prob[n, j, 1] <- normal_cdf((gamma[1]-a[j]*theta[n]-delta[j]), 0, sigma[j]);

      prob[n, j, C] <- 1 - normal_cdf((gamma[C-1]-a[j]*theta[n]-delta[j]), 0, sigma[j]);

      Y[n, j] ~ categorical(prob[n, j]);
     }
  }
}

