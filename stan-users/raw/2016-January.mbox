      int<lower=0> N; //rows of data
      int<lower=1> J; // number of covariates
      int<lower=1> K; // number of responses
      int<lower=1> L; // number of groups
      vector[J] x[N]; // design matrix (predictors)
      vector[K] y[N]; // response (outcomes)
      int<lower=1, upper=L> random[N];
    }
    parameters {
      vector[K] intercept; // Population intercept
      matrix[K,J] beta; // Population slope parameters
      cholesky_factor_corr[K] omega;
      cholesky_factor_corr[L] omega_u;
      vector<lower=0>[K] sigma; // population standard deviation
      vector[L] u; // random intercepts
      vector<lower=0>[L] sigma_u; // random intercepts SD
    }
    model {
      vector[K] mu[N];
      matrix[K,K] Sigma;
      matrix[L,L] Sigma_u;
      vector[L] zeros;

      Sigma <- diag_pre_multiply(sigma, omega);
      Sigma_u <- diag_pre_multiply(sigma_u, omega_u);

      for (l in 1:L)
        zeros[l] <- 0;

      u ~ multi_normal_cholesky(zeros, Sigma_u);

      for (n in 1:N)
        mu[n] <- beta * x[n] + intercept + u[random[N]];

      // Priors
      to_vector(beta) ~ normal(0, 5);
      omega ~ lkj_corr_cholesky(4);
      omega_u ~ lkj_corr_cholesky(4);
      sigma ~ cauchy(0, 2.5);
      sigma_u ~ cauchy(0, 2.5);

      // Data Model
      y ~ multi_normal_cholesky(mu, Sigma);
    }
    """

fit = pystan.stan(model_code=model_code, data=model_dat,
                  iter=1000, chains=2,
                  model_name='height_weight',
                  sample_file='/Users/username/Desktop/sample')

