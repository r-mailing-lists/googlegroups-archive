real b;
vector[N] c;
real d;
int ndx;

If N == 2, as in your example,

d <- ifelse(b < 2.0, c[1], c[2]);

If N > 2,

ndx <- 1;
for (i in 2:N) {
   if (i <= floor(b)
     ndx <- i;
}
d <- c[ndx];

;-)

Sergio

