Thanks a lot for the comments.

I figured it out, this model with the lkj method gives equivalent results now, and is slightly faster that the inv_whishart model.

Please let me know if you find another way to speed up the code

data{
int n;
int parmt;
int nsubj;
real y[n];
int id[n];
real x[n];
vector[parmt] pm;
cov_matrix[parmt] prec;
}

parameters {
vector[parmt] b[nsubj];
vector[parmt] mub;

real<lower=0,upper=20> sigma_y;
corr_matrix[parmt] Sigma_corr;
vector<lower=0,upper=20>[parmt] Sigma_sd;

}

transformed parameters {
cov_matrix[parmt] Sigma; // covariance matrix
for (m in 1:parmt) {
Sigma[m,m] <- Sigma_sd[m] * Sigma_sd[m] * Sigma_corr[m,m];
for (k in (m+1):parmt) {
Sigma[m,k] <- Sigma_sd[m] * Sigma_sd[k] * Sigma_corr[m,k];
Sigma[k,m] <- Sigma[m,k];
}
}
}

model{

Sigma_corr ~ lkj_corr(2.0);

for (j in 1:nsubj){
b[j] ~ multi_normal(mub, Sigma);
}

{
real mu[n];
for (i in 1:n){
mu[i] <- b[id[i],1] + b[id[i],2] * x[i];
if (x[i] > b[id[i],4])
mu[i] <- mu[i] + (b[id[i],3] * (x[i] - b[id[i],4]));
}
y ~ normal(mu, sigma_y);
}

mub ~ multi_normal(pm, prec);
}

