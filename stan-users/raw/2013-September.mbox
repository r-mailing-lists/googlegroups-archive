Hi Bob

Thank you for you answer.

Vectorizing the mu, and using the if statement instead of the int_step function, makes the code run a lot faster.

But for a better implementation of the covariance/correlation, I cant make it work properly with a procedure different than the inv_wishart.

I implemented the method explained in page 95 of the stan manual, but it doesnt converge properly (even with a higher number of iterations than the wishart method), and the estimates of the covariances/correlations are very different from the ones given by the wishart method.

Here is my code, could you help me find out what is wrong with it?

Thanks

data{
int n;
int parmt;
int nsubj;
real y[n];
int id[n];
real x[n];
vector[parmt] pm;
cov_matrix[parmt] prec;
}

parameters {
vector[parmt] b[nsubj];
vector[parmt] mub;
real<lower=0> sigma_y;

corr_matrix[parmt] Sigma_corr;
vector<lower=0>[parmt] Sigma_sd;
}

transformed parameters {
cov_matrix[parmt] Sigma; // covariance matrix
for (m in 1:parmt) {
Sigma[m,m] <- Sigma_sd[m] * Sigma_sd[m] * Sigma_corr[m,m];
for (k in (m+1):parmt) {
Sigma[m,k] <- Sigma_sd[m] * Sigma_sd[k] * Sigma_corr[m,k];
Sigma[k,m] <- Sigma[m,k];
}
}
}

model{

Sigma_corr ~ lkj_corr(2.0);

Sigma_sd ~ cauchy(0,5);

for (j in 1:nsubj){

b[j] ~ multi_normal(mub, Sigma);
}

sigma_y ~ uniform(0,50);

{

real mu[n];
for (i in 1:n){

mu[i] <- b[id[i],1] + b[id[i],2] * x[i];

if (x[i] > b[id[i],4])

mu[i] <- mu[i] + (b[id[i],3] * (x[i] - b[id[i],4]));
}
y ~ normal(mu, sigma_y);
}

mub ~ multi_normal(pm, prec);
}

-- Mauricio

