}

parameters {
    vector[P] betas;
    cov_matrix[P] Sigma;
    real eta;
}

transformed parameters {

}

model {

    betas ~ multi_normal(0, Sigma);

    for(n in 1:N){
        eta <- dot_product(X[n], betas);
        y[n] ~ poisson(eta);
    }
}

