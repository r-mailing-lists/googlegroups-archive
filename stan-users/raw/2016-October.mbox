    real peak1_theta;
    real peak2_k;
    real peak2_theta;
    real peak3_k;
    real peak3_theta;

    real peak1_gamma;
    real peak2_gamma;
    real peak3_gamma;

    //Keep estimated parameters on the same scale
    peak1_Ft_raw ~ normal(0,1);
    peak1_At_raw ~ normal(0,1);
    peak1_Bt_raw ~ normal(0,1);

    peak2_Ft_raw ~ normal(0,1);
    peak2_At_raw ~ normal(0,1);
    peak2_Bt_raw ~ normal(0,1);

    peak3_Ft_raw ~ normal(0,1);
    peak3_At_raw ~ normal(0,1);
    peak3_Bt_raw ~ normal(0,1);

    baseline_Ot_raw ~ normal(0,1);
    baseline_Rt_raw ~ normal(0,1);
    baseline_At_raw ~ normal(0,1);

    for (x in 1:Nt){
        //Compute Gamma Terms
        peak1_k=get_k(peak1_Ft[x], peak1_Bt[x]);
        peak1_theta=get_theta(peak1_Ft[x], peak1_Bt[x]);
        peak1_gamma=get_gamma_term(peak1_At[x], peak1_k, peak1_theta);

        peak2_k=get_k(peak2_Ft[x], peak2_Bt[x]);
        peak2_theta=get_theta(peak2_Ft[x], peak2_Bt[x]);
        peak2_gamma=get_gamma_term(peak2_At[x], peak2_k, peak2_theta);

        peak3_k=get_k(peak3_Ft[x], peak3_Bt[x]);
        peak3_theta=get_theta(peak3_Ft[x], peak3_Bt[x]);
        peak3_gamma=get_gamma_term(peak3_At[x], peak3_k, peak3_theta);

        for (y in 1:Nf){
            //Add Background
            mu[x,y] = (baseline_At[x])*(1-baseline_Rt[x])^yvals[y]+baseline_Ot[x];

            //Add Peak 3
            mu[x,y] = mu[x,y] + gamma(peak1_gamma, peak1_k, peak1_theta, yvals[y]);

            //Add peak1 Oscillation
            mu[x,y] = mu[x,y] + gamma(peak2_gamma, peak2_k, peak2_theta, yvals[y]);

            //Add peak2 Oscillation
            mu[x,y] = mu[x,y] + gamma(peak3_gamma, peak3_k, peak3_theta, yvals[y]);
        }
    }

      to_vector(data_matrix) ~ normal(to_vector(mu), sig2obs);
