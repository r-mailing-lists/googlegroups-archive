And it's useful to see the intervals for the predictions:

library(tidyverse)
y2 = rstan::extract(fit,pars='y2')[[1]]
y2 = y2 * sd(logratio) + mean(logratio)
data.frame(y2) %>%
tidyr::gather('x','value') %>%
dplyr::group_by(x) %>%
dplyr::summarise(
lo95 = quantile(value,.025)
, hi95 = quantile(value,.975)
, sig = (lo95>0)|(hi95<0)
, lo50 = quantile(value,.25)
, hi50 = quantile(value,.75)
, med = quantile(value,.5)
) %>%
dplyr::mutate(
x_num = as.numeric(gsub('X','',x))
, range = range[x_num]
) %>%
ggplot2::ggplot(
mapping = aes(
x = range
, y = med
)
)+
ggplot2::geom_ribbon(
mapping = aes(
ymin = lo95
, ymax = hi95
)
, alpha = .5
)+
ggplot2::geom_ribbon(
mapping = aes(
ymin = lo50
, ymax = hi50
)
, alpha = .5
)+
ggplot2::geom_line()+
ggplot2::geom_point(
data = data.frame(
range = range
, logratio = logratio
)
, mapping = aes(
x = range
, y = logratio
)
, alpha = .5
)

