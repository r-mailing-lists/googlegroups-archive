data {
int<lower=0> npep ;
int<lower=0> N ;
int<lower=0> nprotch ;

real y[N] ;
matrix[npep,2] int_IS ;
int<lower=1,upper=npep> opep[N] ;
int<lower=1,upper=nprotch> oprotch[N] ;

}

parameters{

real beta_pep[npep] ;  // pep effect
vector[2] beta[nprotch] ;  // channel/prot averages

corr_matrix[2] G;
real<lower=0> tau ; // peptide effect var
real<lower=0> sigma ; // experimental error
vector<lower=0>[2] bsds ; // random int and slope SD

real mu_pep ;
vector[2] mu_beta ;

}

model {

beta_pep ~ normal(0,10) ;
mu_pep ~ normal(0, 5) ;
mu_beta ~ normal(0,5) ;

bsds ~ cauchy(0, 2.5) ;
beta ~ multi_normal(mu_beta, quad_form_diag(G, bsds)) ;

for (i in 1:N)
  y[i] ~ normal(beta_pep[opep[i]] + int_IS[opep[i]] * beta[oprotch[i]], sigma) ;

}

generated quantities {

  vector[nprotch] ppred;
