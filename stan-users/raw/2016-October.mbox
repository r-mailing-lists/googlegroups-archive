  matrix delete_row_col(matrix a, int n) {
    int N;
    matrix[rows(a) - 1, cols(a) - 1] result;
    N = rows(a);
    for (i in 1:(n-1)) {
      for (j in 1:(n-1))
        result[i,j] = a[i,j];
      for (j in (n+1):N)
        result[i,j-1] = a[i,j];
    }
    for (i in (n+1):N) {
      for (j in 1:(n-1))
        result[i-1,j] = a[i,j];
      for (j in (n+1):N)
        result[i-1,j-1] = a[i,j];
    }
    return result;
  }
