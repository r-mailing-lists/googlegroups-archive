On Friday, September 30, 2016 at 11:53:28 AM UTC-4, malai...@gmail.com wrote:

> Hi All,
>
> I am currently working on a negative binomial model. I was able to get the coefficients for the NB model  using the attached script. Next, I would like to predict crashes (dependent variable) using the developed NB model. I don't know how I can implement that in RStan.
>
> I will appreciate any help.
>
> Thanks.

> ### load the libraries
> library(arm)       ### for the invlogit function
> library(emdbook)  ### for the rbetabinom function
> library(rstan)
> library(rstanarm)
> library(shinystan)
> ### Predicted crashes for comparison sites before period

> # data processing
> getwd()
> setwd("C:/Users/n01066737/Desktop/Angela")
> getwd()

> crashdata_CB<-read.csv('comparison_before.csv')
> crashdata_CB
> summary(crashdata_CB)
> names(crashdata_CB)
> str(crashdata_CB)

> ### converting factor variables to as.factors
>
>
> ### checking the structure after converting the factor variables

> str(crashdata_CB)

>
>
>
> ### creating dummy variables for factor variables
>
>
>
> ### specifying the poisson-gamma mixture model
>
> negbin<-"
> data{
> int<lower=0> N;                           # rows of data

> vector[N] studyperiod;

> vector[N] majaadt;
> vector[N] minaadt;                    # predictor variable
> vector[N] majlane;
> vector[N] minlane;
> vector[N] medianwidth;
> vector[N] speed;
> vector[N] landuse;
> vector[N] mediantype;
> int<lower=0> totalcrashes[N];            # response variable
> }
>
> parameters {
> real<lower=0> phi;      # negative binomial dispersion parameter
> real beta0;             # intercept

> real beta3;

> real beta5;
> real beta6;
> real beta7;
> real beta8;
> real beta9;
> real beta10;
> real beta11;
> real beta12;
> }
>
> model {
> ### priors
> phi ~    cauchy(0.001,0.001);
> beta0 ~ normal(0.0,1E4);

> beta3 ~  normal(0.0, 1E4);

> beta5 ~  normal(0.0, 1E4);
> beta6 ~ normal(0.0, 1E4);
> beta7 ~ normal(0.0, 1E4);
> beta8 ~ normal(0.0, 1E4);
> beta9 ~ normal(0.0, 1E4);
> beta10 ~ normal(0.0, 1E4);
> beta11 ~ normal(0.0, 1E4);
> beta12 ~ normal(0.0, 1E4);
> # data model

> totalcrashes~ neg_binomial_2_log(beta0 + beta3*studyperiod + beta5*majaadt + beta6*minaadt + beta7*majlane + beta8*minlane + beta9*speed + beta10*landuse + beta11*medianwidth + beta12*mediantype, phi);
> }
> "
> write(negbin, file="negbin-glm.stan")
> CB<-stan_model("negbin-glm.stan")
> set.seed(1000)
