    sigma_bar[k] = sqrt(sigma_bar[k]);
  }
  phi[1] = 0;
  phi[2] = Lambda[2,2];

  for(i in 1:N){
    tau[i] = tau_lsigma[i][1];
    sigma[i] = exp(tau_lsigma[i][2]);
