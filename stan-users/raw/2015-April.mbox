Sorry, Bob.  Here is a more complete model.

parameters {
  vector [N] phi;
  real <lower = 0> sigma_phi;
}
transformed parameters {
  vector[N] eta;
  vector[N] log_lik;

  for (i in 1:N) {
         eta[i] <- ...;
         log_lik[i] <- neg_binomial_2_log_log(Y[i], eta[i], phi[i]);
     }
}
model {
     phi ~ lognormal(0, sigma_phi);
     sigma_phi ~ cauchy(0, 2);
}

Thank you,
Linas

