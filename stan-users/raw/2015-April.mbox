parameters{
  real<lower=0,upper=1> alpha;
  real<lower=0,upper=1> beta;
  real<lower=0,upper=1> delta;
  real<lower=0,upper=1> gamma;
  real<lower=1> lambda;
  real<lower=0> luce;
}

model {
#Declaring Variables
  vector[items_n_pos] x_a_pos;
  vector[items_n_pos] y_a_pos;
  vector[items_n_pos] px_a_pos;
  vector[items_n_pos] py_a_pos;

  vector[items_n_pos] x_b_pos;
  vector[items_n_pos] y_b_pos;
  vector[items_n_pos] px_b_pos;
  vector[items_n_pos] py_b_pos;

  vector[items_n_neg-items_n_pos] x_a_neg;
  vector[items_n_neg-items_n_pos] y_a_neg;
  vector[items_n_neg-items_n_pos] px_a_neg;
  vector[items_n_neg-items_n_pos] py_a_neg;

  vector[items_n_neg-items_n_pos] x_b_neg;
  vector[items_n_neg-items_n_pos] y_b_neg;
  vector[items_n_neg-items_n_pos] px_b_neg;
  vector[items_n_neg-items_n_pos] py_b_neg;

  vector[items_n_mix-items_n_neg] x_a_mix;
  vector[items_n_mix-items_n_neg] y_a_mix;
  vector[items_n_mix-items_n_neg] px_a_mix;
  vector[items_n_mix-items_n_neg] py_a_mix;

  vector[items_n_mix-items_n_neg] x_b_mix;
  vector[items_n_mix-items_n_neg] y_b_mix;
  vector[items_n_mix-items_n_neg] px_b_mix;
  vector[items_n_mix-items_n_neg] py_b_mix;

  vector[items_n_pos] v_x_a_pos;
  vector[items_n_pos] v_y_a_pos;
  vector[items_n_pos] v_x_b_pos;
  vector[items_n_pos] v_y_b_pos;

  vector[items_n_neg-items_n_pos] v_x_a_neg;
  vector[items_n_neg-items_n_pos] v_y_a_neg;
  vector[items_n_neg-items_n_pos] v_x_b_neg;
  vector[items_n_neg-items_n_pos] v_y_b_neg;

  vector[items_n_mix-items_n_neg] v_x_a_mix;
  vector[items_n_mix-items_n_neg] v_y_a_mix;
  vector[items_n_mix-items_n_neg] v_x_b_mix;
  vector[items_n_mix-items_n_neg] v_y_b_mix;

  vector[items_n_pos] w_x_a_pos;
  vector[items_n_pos] w_x_b_pos;
  vector[items_n_pos] w_y_a_pos;
  vector[items_n_pos] w_y_b_pos;

  vector[items_n_neg-items_n_pos] w_x_a_neg;
  vector[items_n_neg-items_n_pos] w_x_b_neg;
  vector[items_n_neg-items_n_pos] w_y_a_neg;
  vector[items_n_neg-items_n_pos] w_y_b_neg;

  vector[items_n_mix-items_n_neg] w_x_a_mix;
  vector[items_n_mix-items_n_neg] w_x_b_mix;
  vector[items_n_mix-items_n_neg] w_y_a_mix;
  vector[items_n_mix-items_n_neg] w_y_b_mix;

  vector[items_n_pos] vf_a_pos;
  vector[items_n_pos] vf_b_pos;

  vector[items_n_neg-items_n_pos] vf_a_neg;
  vector[items_n_neg-items_n_pos] vf_b_neg;

  vector[items_n_mix-items_n_neg] vf_a_mix;
  vector[items_n_mix-items_n_neg] vf_b_mix;

  vector[N] vf_a;
  vector[N] vf_b;

  vector[N] binval;

#Actual code
  x_a_pos<-prospects_a[1:items_n_pos,1];
  y_a_pos<-prospects_a[1:items_n_pos,3];
  px_a_pos<-prospects_a[1:items_n_pos,2];
  py_a_pos<-prospects_a[1:items_n_pos,4];

  x_a_neg<-prospects_a[items_n_pos:items_n_neg,1];
  y_a_neg<-prospects_a[items_n_pos:items_n_neg,3];
  px_a_neg<-prospects_a[items_n_pos:items_n_neg,2];
  py_a_neg<-prospects_a[items_n_pos:items_n_neg,4];

  x_a_mix<-prospects_a[items_n_neg:items_n_mix,1];
  y_a_mix<-prospects_a[items_n_neg:items_n_mix,3];
  px_a_mix<-prospects_a[items_n_neg:items_n_mix,2];
  py_a_mix<-prospects_a[items_n_neg:items_n_mix,4];

  x_b_pos<-prospects_b[1:items_n_pos,1];
  y_b_pos<-prospects_b[1:items_n_pos,3];
  px_b_pos<-prospects_b[1:items_n_pos,2];
  py_b_pos<-prospects_b[1:items_n_pos,4];

  x_b_neg<-prospects_b[items_n_pos:items_n_neg,1];
  y_b_neg<-prospects_b[items_n_pos:items_n_neg,3];
  px_b_neg<-prospects_b[items_n_pos:items_n_neg,2];
  py_b_neg<-prospects_b[items_n_pos:items_n_neg,4];

  x_b_mix<-prospects_b[items_n_neg:items_n_mix,1];
  y_b_mix<-prospects_b[items_n_neg:items_n_mix,3];
  px_b_mix<-prospects_b[items_n_neg:items_n_mix,2];
  py_b_mix<-prospects_b[items_n_neg:items_n_mix,4];

  v_x_a_pos<-pow(x_a_pos,alpha);
  v_y_a_pos<-pow(y_a_pos,alpha);
  v_x_b_pos<-pow(x_b_pos,alpha);
  v_y_b_pos<-pow(y_b_pos,alpha);

  v_x_a_neg<--lambda*pow(-1*x_a_neg,beta);
  v_y_a_neg<--lambda*pow(-1*y_a_neg,beta);
  v_x_b_neg<--lambda*pow(-1*x_b_neg,beta);
  v_y_b_neg<--lambda*pow(-1*y_b_neg,beta);

  v_x_a_mix<-pow(x_a_mix,alpha);
  v_y_a_mix<--lambda*pow(-1*y_a_mix,beta);
  v_x_b_mix<-pow(x_b_mix,alpha);
  v_y_b_mix<--lambda*pow(-1*y_b_mix,beta);

  w_x_a_pos<-pow(px_a_pos,gamma)/pow((pow(px_a_pos,gamma)+pow((1-px_a_pos),gamma)),1/gamma);
  w_x_b_pos<-pow(px_b_pos,gamma)/pow((pow(px_b_pos,gamma)+pow((1-px_b_pos),gamma)),1/gamma);
  w_y_a_pos<-pow(py_a_pos,gamma)/pow((pow(py_a_pos,gamma)+pow((1-py_a_pos),gamma)),1/gamma);
  w_y_b_pos<-pow(py_b_pos,gamma)/pow((pow(py_b_pos,gamma)+pow((1-py_b_pos),gamma)),1/gamma);

  w_x_a_neg<-pow(px_a_neg,delta)/pow((pow(px_a_neg,delta)+pow((1-px_a_neg),delta)),1/delta);
  w_x_b_neg<-pow(px_b_neg,delta)/pow((pow(px_b_neg,delta)+pow((1-px_b_neg),delta)),1/delta);
  w_y_a_neg<-pow(py_a_neg,delta)/pow((pow(py_a_neg,delta)+pow((1-py_a_neg),delta)),1/delta);
  w_y_b_neg<-pow(py_b_neg,delta)/pow((pow(py_b_neg,delta)+pow((1-py_b_neg),delta)),1/delta);

  w_x_a_mix<-pow(px_a_mix,gamma)/pow((pow(px_a_mix,gamma)+pow((1-px_a_mix),gamma)),1/gamma);
  w_x_b_mix<-pow(px_b_mix,delta)/pow((pow(px_b_mix,delta)+pow((1-px_b_mix),delta)),1/delta);
  w_y_a_mix<-pow(py_a_mix,gamma)/pow((pow(py_a_mix,gamma)+pow((1-py_a_mix),gamma)),1/gamma);
  w_y_b_mix<-pow(py_b_mix,delta)/pow((pow(py_b_mix,delta)+pow((1-py_b_mix),delta)),1/delta);

  vf_a_pos<- v_x_a_pos*w_x_a_pos+v_y_a_pos*w_y_a_pos;
  vf_b_pos<- v_x_b_pos*w_x_b_pos+v_y_b_pos*w_y_b_pos;

  vf_a_neg<- v_x_a_neg*w_x_a_neg+v_y_a_neg*w_y_a_neg;
  vf_b_neg<- v_x_b_neg*w_x_b_neg+v_y_b_neg*w_y_b_neg;

  vf_a_mix<- v_x_a_mix*w_x_a_mix+v_y_a_mix*w_y_a_mix;
  vf_b_mix<- v_x_b_mix*w_x_b_mix+v_y_b_mix*w_y_b_mix;

  vf_a<-[vf_a_pos, vf_a_neg, vf_a_mix];
  vf_b<-[vf_b_pos, vf_b_neg, vf_b_mix];

  for (i in 1:N){
    binval[i]<-exp(luce*vf_b[i])/(exp(luce*vf_a[i])+exp(luce*vf_b[i]));
  }

#priors
  alpha~uniform(0,1);
  beta~uniform(0,1);
  gamma~uniform(0,1);
  delta~uniform(0,1);
  lambda~uniform(1,5);
  luce~uniform(0,1.5);

  //likelihood
  rawdata~bernoulli(binVal);
}

