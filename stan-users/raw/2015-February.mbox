> >
> > data {
> >   int<lower=0> N;
> >   vector[N] x;
> >   int<lower=0> y[N];
> > }
> > parameters {
> >   real alpha;
> >   real beta;
> >   real<lower=0> sigma;
> >   real y_tilde[N];
> > }
> > model {
