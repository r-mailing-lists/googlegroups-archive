> > >
> > > transformed data {
> > >  real l_1 ;
> > >  real b_1 ;
> > >
> > >  l_1 <- y[1] ;
> > >  b_1 <- 0 ;
> > > }
> > > transformed parameters{
> > >  vector<lower=0> [n-1] l_temp ;
> > >  vector[n-1] b_temp ;
> > > }
> > > model{
> > >  vector[n] l ;
> > >  vector[n] b ;
> > >  l[1] <- l_1 ;
> > >  b[1] <- b_1 ;
> > >  for (i in 2:n) {
> > >   l[i] <- l_temp[i] ;
> > >   b[i] <- b_temp[i] ;
> > >  }
> > > }
> > >
