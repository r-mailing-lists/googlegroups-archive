Bob,
Thank you very much for your answer, but I do not believe that fabs() is not a problem because
1. level is positive and tends to be two orders of magnitude bigger than trend.
2. I do not see any bimodal behavior in print(samples).
3, I changed totSigma from sigma*fabs(lev[t-1]+b[t-1])^powx to sigma*y[t-1]^powx with no apparent difference.

 My "linear" model is now:

data {
  int<lower=1> n;
  vector<lower=0>[n] y;

  real<lower=0> sigma_prior_mu;
  real<lower=0> sigma_prior_sigma;
  real<lower=0> sigma_level_prior_mu;
  real<lower=0> sigma_level_prior_sigma;
  real<lower=0> sigma_trend_prior_mu;
  real<lower=0> sigma_trend_prior_sigma;
}
transformed data {
  real MIN_SIGMA;
  MIN_SIGMA<-0.05;
}
parameters {
  real<lower=1, upper=15> nu;
  real<lower=MIN_SIGMA> sigma;
  real<lower=MIN_SIGMA> sigma_level;
  real<lower=MIN_SIGMA> sigma_trend;
  real <lower=0,upper=1> powx;
  vector[n] levelError;
  vector[n] trendError;

}
transformed parameters {
  vector[n] b;

  vector<lower=0>[n] lev;
  lev[1] <-y[1];
  b[1] <- 0;

  for (t in 2:n) {
    b[t] <- b[t-1] + trendError[t];

    //lev[t] <- lev[t-1]+ b[t-1]+ levelError[t];  // this causes a few more rejections, but not much difference
    lev[t] <- fabs(lev[t-1]+ b[t-1]+ levelError[t]);
  }
}
model {
  real totSigma;
  //priors
  sigma ~ normal(sigma_prior_mu, sigma_prior_sigma) T[MIN_SIGMA,];
  sigma_level ~ normal(sigma_level_prior_mu, sigma_level_prior_sigma) T[0,];
  sigma_trend ~ normal(sigma_trend_prior_mu, sigma_trend_prior_sigma) T[0,];

  //model

  trendError ~ normal(0,sigma_trend);//vector
  levelError ~ normal(0,sigma_level);

  for (t in 2:n) {

    //totSigma <- sigma*fabs(lev[t-1]+b[t-1])^powx;
    totSigma <- sigma*y[t-1]^powx;
    //if(!(totSigma>0))  print("t=", t, " y[t-1]=", y[t-1], "  sigma=", sigma, "  powx=",powx);
    y[t] ~ student_t(nu, lev[t-1]+b[t-1] , totSigma);

  }
}
generated quantities {
  real innov;
  real positiveInnovations;
  real negativeInnovations;

  positiveInnovations <- 0;
  negativeInnovations <- 0;

  for (t in 2:n) {

    innov <- y[t] -(lev[t-1]+b[t-1]);

    if (innov>=0)
      positiveInnovations <- positiveInnovations+innov;
    else
      negativeInnovations <- negativeInnovations-innov;
  }
}

Now, I followed your suggestion and created GLM-style model, as below:

data {
  int<lower=1> n;
  vector<lower=0>[n] y;

  real<lower=0> sigma_prior_mu;
  real<lower=0> sigma_prior_sigma;

  real<lower=0> sigma_level_prior_mu;
  real<lower=0> sigma_level_prior_sigma;
  real<lower=0> sigma_trend_prior_mu;
  real<lower=0> sigma_trend_prior_sigma;
}
transformed data {
  real MIN_SIGMA;
  real maxY;
  MIN_SIGMA<-0.05;
  maxY <- max(y);
}
parameters {
  real<lower=1,upper=15> nu;
  real<lower=MIN_SIGMA> sigma;
  real<lower=0> sigma_level;
  real<lower=0> sigma_trend;
  real <lower=0,upper=1> powx;
  vector[n] levelError;
  vector[n] trendError;
}
transformed parameters {
  vector<lower=0>[n] lev;
  vector<lower=-log(maxY), upper=log(maxY)>[n] b;
  vector<lower=0, upper=log(maxY)*1.5>[n] l;
  lev[1] <- y[1];
  l[1]<-log(lev[1]);
  b[1] <- 0;

  for (t in 2:n) {

    b[t] <- b[t-1] + trendError[t];
    l[t] <- l[t-1]+ b[t-1]+ levelError[t];

    lev[t] <- exp(l[t]);
  }
}
model {
  real expectedLevel;
  //priors
  sigma ~ normal(sigma_prior_mu, sigma_prior_sigma) T[MIN_SIGMA,];
  sigma_level ~ normal(sigma_level_prior_mu, sigma_level_prior_sigma) T[0,];
  sigma_trend ~ normal(sigma_trend_prior_mu, sigma_trend_prior_sigma) T[0,];

  //model

  trendError ~ normal(0,sigma_trend);//vector
  levelError ~ normal(0,sigma_level);

  for (t in 2:n) {

    expectedLevel <- exp(l[t-1]+b[t-1]);
    y[t] ~ student_t(nu, expectedLevel , sigma*expectedLevel^powx);

  }
}
generated quantities {
  real innov;
  real positiveInnovations;
  real negativeInnovations;

  real expectedL;

  positiveInnovations <- 0;
  negativeInnovations <- 0;

  for (t in 2:n) {

    expectedL <- exp(l[t-1]+b[t-1]);
    innov <- y[t] - expectedL;

    if (innov>=0)
      positiveInnovations <- positiveInnovations+innov;
    else
      negativeInnovations <- negativeInnovations-innov;
  }
}

Both models perform equally bad: n_eff of various parameters, except of b[1], tends to be between 3 and 15, and does not seem to increase with number of  iterations (50, 150, 500, 1000)
on 7 chains. Also, calculations seem to take perhaps 20 times longer than in case of my previous single error model (not shown in the message thread above).

Thanks a lot,
Slawek

On Thu, Feb 19, 2015 at 4:22 PM, Bob Carpenter <ca...@alias-i.com> wrote:
> Be careful!  using absolute values is very dangerous
> as it will typically lead to two posterior modes depending
> on how l and b are constrained.  In your case, swapping
> signs on l and b will lead to the same answer once you
> apply fabs().
>
>
> This could very likely be the cause of poor n_eff --- if
> two chains land in different modes, R-hat and n_eff get very low because
> they estimate means from all of the chains combined and
> then make sure each chain matches the global mean.
>
> The standard GLM solution if you want to constrain
> a linear predictor to be positive is to exponentiate.
>
> - Bob
