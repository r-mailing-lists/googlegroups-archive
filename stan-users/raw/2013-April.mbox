#beta <- 0.5;
#lambda <- 0.80

#sigmasquared <- 1.0

#====================================
# OKAY:  0.8
#====================================
#beta <- 1.0;
#lambda <- 0.75

#sigmasquared <- 1.0

#====================================
# GOOD: 2.7
#====================================
#beta <- 2.6;
#lambda <- 0.75

#sigmasquared <- 1.

#====================================
# STILL SO SO : 0.3
#====================================
#beta <- 0.5;
#lambda <- 0.75

#sigmasquared <- 1.0

#====================================
# OKAY:  0.8
