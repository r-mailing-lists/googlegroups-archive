Ok, when I use 'optimizing' I haven't been getting particularly good estimates of the state. In particular, the states appear to get stuck in one

Instead I've been using MCMC then taking the average state across all samples...Is this ok?

For completeness, the code below is what I've been using to generate the fake data:

## Generate a continuous latent variable that we then use to make a discrete state vector
fARProcess <- function(rho,X0,sigma,aT){
  X <- vector(length=aT)
  X[1] <- X0
  for(t in 2:aT){
    X[t] = rho * X[t-1] + rnorm(1,0,sigma)
  }
  return(X)
}

fState <- function(rho,X0,sigma,aT){
  X <- fARProcess(rho,X0,sigma,aT)
  Z <- ifelse(X<0,0,1)
  return(Z)
}

fGenerateData1 <- function(aAlpha,aBeta0,aBeta1,rho,X0,sigma,aT){
  Z <- fState(rho,X0,sigma,aT)
  l <- vector(length=aT)
  for(t in 1:aT){
    if(Z[t]==0){
      l[t] <- rweibull(1,aAlpha,aBeta0)
    }else{
      l[t] <- rweibull(1,aAlpha,aBeta1)
    }
  }
  return(list(l=l,Z=Z))
}

## Angle data
library(CircStats)
fGenerateAngle <- function(Z,aMu0,aMu1,aRho0,aRho1){
  lAngle <- sapply(Z, function(x) ifelse(x==0,rwrpcauchy(1,aMu0+pi,aRho0)-pi,rwrpcauchy(1,aMu1+pi,aRho1)-pi))
  return(lAngle)
}

## Fit model to fake data
N <- 400
L <- fGenerateData1(1,200,1000,0.99,0,1,N)
lAngle <- fGenerateAngle(L$Z,0,0,0.3,0.9)

plot(L$Z,type = 'l')
plot(L$l,type='l')
plot(lAngle,type = 'l')

Ben

