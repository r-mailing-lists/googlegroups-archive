The corresponding C++ code I think is:
for (int j = 1; j <= N_herd_index; ++j) {
                    current_statement_begin__ = 23;
                    lp_accum__.add(normal_log<propto__>(get_base1(vary_herd_index,j,"vary_herd_index",1), 0, sigma_herd_index));
                }
                current_statement_begin__ = 25;
                for (int i = 1; i <= N; ++i) {
                    current_statement_begin__ = 26;
                    stan::math::assign(get_base1_lhs(vary,i,"vary",1), get_base1(vary_herd_index,get_base1(herd_index,i,"herd_index",1),"vary_herd_index",1));
                    current_statement_begin__ = 27;
                    stan::math::assign(get_base1_lhs(glm,i,"glm",1), ((get_base1(vary,i,"vary",1) + Intercept) + (beta_period2 * get_base1(period2,i,"period2",1))));
                    current_statement_begin__ = 29;
                    stan::math::assign(get_base1_lhs(glm,i,"glm",1), inv_logit(get_base1(glm,i,"glm",1)));
