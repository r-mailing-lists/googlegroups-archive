  '
functions {
    vector fib2(int n) {
      vector[n] fib2;
      fib2[1] <- 1;
      fib2[2] <- 1;
      for (i in 3:n) {
        fib2[i] <- fib2[i-1] + fib2[i-2];
      }
      return fib2;
    }
}

model {

}
'
cppcode <- stanc(model_code = mc, model_name = "Demonstration2")
