Hi, Daniel,

Thank you very much for pointing that out. I have stared at my code for a long time but couldn't figure out this obvious mistake. However, after I fixed it as following:

swData <- stan(file="WS4.stan",data=c("T","y0","t0","ts","theta","fixpar"),chains=1,iter=1,algorithm="Fixed_param")

And the model code:

functions {
  real[] sw4(real t,
             real[] y,
             real[] theta,
             real[] x_r,
             int[] x_i) {
  real dydt[5];
  real fdiss;
  fdiss <- 1/(1+theta[3]*x_r[1]/x_r[2]);
  dydt[1] <- -theta[1]*y[1]-2*x_r[4]/(x_r[6])*(y[1]/x_r[3]-fdiss*y[2]/x_r[6]);
  dydt[2] <- -theta[2]*y[2]+2*x_r[4]/(x_r[6])*(y[1]/x_r[3]-fdiss*y[2]/x_r[6])-2*x_r[4]*fdiss/(x_r[6]+x_r[7])*(y[2]/x_r[6]-y[3]/x_r[7]);
  dydt[3] <- -x_r[5]*theta[2]*y[3]+2*x_r[4]*fdiss/(x_r[6]+x_r[7])*(y[2]/x_r[6]-y[3]/x_r[7])-2*x_r[4]*fdiss/(x_r[7]+x_r[8])*(y[3]/x_r[7]-y[4]/x_r[8]);
  dydt[4] <- -x_r[5]*theta[2]*y[4]+2*x_r[4]*fdiss/(x_r[7]+x_r[8])*(y[3]/x_r[7]-y[4]/x_r[8])-2*x_r[4]*fdiss/(x_r[8]+x_r[9])*(y[4]/x_r[8]-y[5]/x_r[9]);
  dydt[5] <- -x_r[5]*theta[2]*y[5]+2*x_r[4]*fdiss/(x_r[8]+x_r[9])*(y[4]/x_r[8]-y[5]/x_r[9]);
  return dydt;
  }
}
data {
  int<lower=1> T;
  real y0[5];
  real t0;
  real ts[T];
  real theta[3];
  real fixpar[9];
}
transformed data {
  real x_r[9];
  int x_i[0];
  x_r <- fixpar;
}
model {
}
generated quantities {
  real y_hat[T,5];

  y_hat <- integrate_ode(sw4, y0, t0, ts, theta, x_r, x_i);

  // add measurement error
  for (t in 1:T) {
    y_hat[t,1] <- y_hat[t,1] + normal_rng(0,0.2);
    y_hat[t,2] <- y_hat[t,2] + normal_rng(0,0.1);
    y_hat[t,3] <- y_hat[t,3] + normal_rng(0,0.1);
    y_hat[t,4] <- y_hat[t,4] + normal_rng(0,0.1);
    y_hat[t,5] <- y_hat[t,5] + normal_rng(0,0.1);
  }
}

I got new error message:

Error : integrate_ode(d): initial time is 0, but must be less than 0

error occurred during calling the sampler; sampling not done

Are there again obvious explanations?

Best,
Zhenglei

