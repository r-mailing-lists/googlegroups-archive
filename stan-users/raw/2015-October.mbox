data {
  int<lower=0> N; //N is the number of observations in training set
  int<lower=0> J; //J is the number of product categories i.e. length of level 2
  vector[N] y;  //outcomes

  int<lower=0> M; // num of independent predictors
  int<lower=0> L; // num of group predictors
  matrix[N, M] x; //individual predictors
  matrix[J, L] u; //group predictors
  int <lower=1,upper=J> itemlist[N];  //index of the items appearing in the training set.One item can have many different transactions, and can belong to only one product cat.

}
parameters {
  real a[J];

  vector [M] beta[J];  //indiv. coeff by group
  matrix[L,M] gamma; //group coeff

  real<lower=0> sigma_y;
  real<lower=0> sigma_a;
}
model {
  vector[N] y_hat;

  to_vector(gamma) ~ normal(0,10);

  sigma_a ~ cauchy(0,2.5);
  for (j in 1:J)
    a[j]~ normal(0, sigma_a);
  for (j in 1:J)
    beta[j] ~ normal((u[j] * gamma), 10);

  for (n in 1:N) {
  y_hat[n] <- a[itemlist[n]] +beta[itemlist[n]][1] * x[n,1] +beta[itemlist[n]][2] * x[n,2] +beta[itemlist[n]][3] * x[n,3];
//the problem is with beta[1]
  }
  sigma_y ~ cauchy(0,2.5);
  y ~ normal(y_hat, sigma_y);

}

