Hi. I am a new Stan user and started using it aiming to estimate (filter) the latent jumps a discrete-time jump-diffusion model (below). Unfortunately, using this code, I can't even filter out the most obvious jump. That is, I use a T=600 sample where, for a given tn, eps[tn], a normal(0,1), would have to be -15 if no jump had occurred. Well... using the code below, eps[tn] is indeed -15, and y[tn] is virtually zero. Any idea what I am doing wrong?

data {
  int<lower=0> T; // # time steps
  int<lower=0> N; // # truncation of jump sum
  real R[T];
  real lambda;
  real gamma;
  real wz;
  real wy;
  real az;
  real ay;
  real bz;
  real by;
  real cz;
  real cy;
  real dz;
  real dy;
  real ez;
  real ey;
  real alpha;
  real delta;
  real hz1;
  real hy1;
}
parameters {
  real y[T];
}
transformed parameters {
  real mu[T];
  real xi[T];
  real<lower=0> hz[T];
  real<lower=0> hy[T];
  real z[T];
  real eps[T];

  hz[1] <- hz1;
  hy[1] <- hy1;
  for (tn in 1:T) {
    mu[tn]  <- lambda * hz[tn] + gamma * hy[tn];
    xi[tn]  <- 0.5*hz[tn] + hy[tn]*(exp(alpha+0.5*pow(delta,2)) - 1);
    z[tn]   <- R[tn] - (mu[tn] - xi[tn] + y[tn]);
    eps[tn] <- z[tn] / sqrt(hz[tn]);

    if (tn < T) {
      hz[tn+1] <- wz + (az/hz[tn])*pow(z[tn] - cz*hz[tn],2) + bz*hz[tn];
      hy[tn+1] <- wy + (ay/hz[tn])*pow(z[tn] - cy*hz[tn],2) + by*hy[tn];
    }
  }
}
model {
  int nJ[T];
  eps ~ normal(0,1);
  nJ  ~ poisson(hy);

  // y   ~ normal(alpha*nJ, delta*sqrt(nJ)+1e-9); // forcing y[tn] to be zero when no jumps
  for (tn in 1:T)
    y[tn] ~ normal(alpha*nJ[tn], delta*sqrt(nJ[tn])+1e-9);
}

