Revised model code below:

model_code <- '

data {
  int<lower=1> N;
  int<lower=1> K;
  real X[N,K];
  int<lower=0> Y[N];
}

parameters {
  real<lower=0> phi;
  real b0;
  real b1;
  real d0;
  real d1;
}

model {
  #priors:
  phi ~ normal(0,5);
  b0 ~ normal(0,5);
  b1 ~ normal(0,5);
  d0 ~ normal(0,5);
  d1 ~ normal(0,5);

  #data model:
  for (n in 1:N) {
    if (Y[n] == 0)
      increment_log_prob(log_sum_exp(bernoulli_logit_log(1,d0 + d1 * X[n,1]),
                                      bernoulli_logit_log(0, d0 + d1 * X[n,1])
                                      + neg_binomial_2_log_log(Y[n], b0 + b1 * X[n,2],phi)));
