I think that If you want to use the random number generator in the generated quantities block you will need to use the arrow instead of the tilde.

A simple model should look something like:

data {
  int<lower=0> N;   // number of Observations
  real y[N];             //  Observed data
  real x[N];            //  Explanatory variables

}
parameters {
  real alpha;
  real beta;
  real<lower=0> sigma;
}
transformed parameters {
  real mu;
  mu <- alpha + beta * x;
}
model {
  alpha ~ normal(0,10);
  beta ~ normal(0,10);
  sigma ~ cauchy(0,5);

  //Likelihood
  y ~ normal(mu, sigma);
}
generated quantities{
 real yrep[N]

 //predicted values
 yrep <- normal_rng(mu,sigma);
}

Chris
-----------------

