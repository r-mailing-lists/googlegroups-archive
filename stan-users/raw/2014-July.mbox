> > >         for (j in 1 : N)
> > >             Sigma [i, j] <- sigmaf_sq * exp (-0.5 * pow (x [i] - x [j], 2) / l_sq)
> > >                 + if_else (i == j, sigman_sq, 0.0);
> > >
> > >     sigman_sq ~ cauchy (0, 5);
> > >     sigmaf_sq ~ cauchy (0, 5);
> > >     l_sq ~ cauchy (0, 5);
> > >     beta ~ normal (0, 100);
> > >     y ~ multi_normal (beta [1] + beta [2] * y_cfd, Sigma);
> > > }
