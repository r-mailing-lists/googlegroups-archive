Pearson_resid <-  (counts-mu)/sqrt(mu);     //Pearson residuals
Deviance <- pow(Pearson_resid,2);
pred_counts <- poisson_rng (exp (mu));
pred_resid <- (pred_counts-mu)/sqrt(mu);   //Pearson residuals
pred_Deviance <- pow(pred_resid,2);

fit <- sum(Deviance);
new_fit <- sum(new_Deviance);
}

