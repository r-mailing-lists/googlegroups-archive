It being the correlation matrix ...

parameters{

  real<lower=0> sigma1;
  real<lower=0> sigma2;

  corr_matrix[3] Lambda;

  real beta_treat;
  real betaselect;
  real beta_untreat;
}

transformed parameters {
  matrix[3,3] covmat;

  {
    vector[3] sdvector;
    sdvector[1] <- 1;
    sdvector[2] <- sigma1;
    sdvector[3] <- sigma2;

    covmat <- diag_pre_multiply(sdvector, diag_post_multiply(Lambda, sdvector));
  }
}

Ben

