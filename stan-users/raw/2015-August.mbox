vector[N] x_treat;
vector[N] x_untreat;
vector[N] xselect;
real constant; //this is the N/2 * log(2pi) constant in the likelihood function that I pass to from R
}
parameters{
real<lower=0> sigma1;
real<lower=0> sigma2;
real<lower=-1,upper=1> rho1;
real<lower=-1,upper=1> rho2;
real<lower=-1,upper=1> rho12;
real beta_treat;
real betaselect;
real beta_untreat;
}
transformed parameters{
cov_matrix[3] covmat;
covmat[1,1]<-1;
covmat[1,2]<-rho1*sigma1;
covmat[1,3]<-rho2*sigma2;
covmat[2,1]<-rho1*sigma1;
covmat[2,2]<-sigma1*sigma1;
covmat[3,1]<-rho2*sigma2;
covmat[3,3]<-sigma2*sigma2;
covmat[2,3]<-sigma1*sigma2*rho12;
covmat[3,2]<-sigma1*sigma2*rho12;
}

model{
vector[N] lp;
    for(i in 1:N){
        if(Y_treatment[i]==1){
lp[i]<-constant+(-log(sigma2)-0.5*((y_treat[i]-beta_treat*x_treat[i])/sigma2)^2+log(Phi(((betaselect*xselect[i]+(rho2/sigma2)*(y_treat[i]-beta_treat*x_treat[i]))/((1-rho2^2)^.5)))));
}
else{
lp[i]<-constant+(-log(sigma1)-0.5*((y_untreat[i]-beta_treat*x_untreat[i])/sigma1)^2+log(Phi(-1*((betaselect*xselect[i]+(rho1/sigma1)*(y_untreat[i]-beta_treat*x_untreat[i]))/((1-rho1^2)^.5)))));

}
}

sigma1 ~ cauchy(0,1);
sigma2 ~ cauchy(0,1);
beta_treat ~ normal(0,1);
beta_untreat ~ normal(0,1);
betaselect ~ normal(0,1);

increment_log_prob(log_sum_exp(lp));
}

