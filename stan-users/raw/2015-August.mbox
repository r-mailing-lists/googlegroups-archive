> }
> parameters {
>   real logit_theta;
>   real log_alpha;
> }
> model {

>   is_zero ~ bernoulli_logit(theta);
>   y ~ poisson_log(alpha);
> }
> generated quantities {

>   real theta;
>   real alpha;
>   theta <- inv_logit(logit_theta);
>   alpha <- exp(log_alpha);
> }
