P.S.  To make this post complete,

My model (corrected --- thanks again, Jiqiang --- you're a lifesaver):

transformed data {
  int<lower=0> N;
  vector[5] y;
  N <- 5;
  y[1] <- 10;
  y[2] <- 10;
  y[3] <- 12;
  y[4] <- 11;
  y[5] <- 9;
}
parameters {
  real mu;
  real<lower=0> sigma_sq;
  vector<lower=-0.5, upper=0.5>[5] y_err;
}
transformed parameters {
  real<lower=0> sigma;
  sigma <- sqrt(sigma_sq);
}
model {
  increment_log_prob(-2 * log(sigma));

  (y + y_err) ~ normal(mu, sigma);
}

Andrew's model:

transformed data {
  int<lower=0> N;
  vector[5] y;
  N <- 5;
  y[1] <- 10;
  y[2] <- 10;
  y[3] <- 12;
  y[4] <- 11;
  y[5] <- 9;
}
parameters {
  real mu;
  real<lower=0> sigma_sq;
}

transformed parameters {
  real<lower=0> sigma;
  sigma <- sqrt(sigma_sq);
}
model {
  increment_log_prob(-2 * log(sigma));
  for (n in 1:N)

    increment_log_prob(log(Phi((y[n] + 0.5 - mu) / sigma)
                           - Phi((y[n] - 0.5 - mu) / sigma)));
}

