Here is the data: https://www.dropbox.com/s/g6jcj85a3w6gscg/d2.csv?dl=0
And here the models

Weighted Bayes

functions {
  real F(real L, real w) {
    real eL = exp(L);

    return log((w * eL + 1 - w)/((1 - w) * eL + w));
  }
}

data{
    int<lower=1> N;

    int<lower=0, upper=1> ChoiceRed[N];

    real lSelf[N];
    real lOthers[N];

    int<lower=1> P;
    int<lower=1, upper=P> Participant[N];
}

parameters{
    vector[P] a;
    vector[P] wOthers;
    vector[P] wSelf;
}

model{
    vector[N] mu;
    wSelf ~ normal( 0.5 , 0.1 );
    wOthers ~ normal( 0.5 , 0.1);
    a ~ normal( 0.5 , 0.1 );

  for ( i in 1:N ) {
    mu[i] = a[Participant[i]] + F(lSelf[i], wSelf[Participant[i]]) + F(lOthers[i], wOthers[Participant[i]]);
  }

  ChoiceRed ~ bernoulli_logit(mu);

}

generated quantities{
    vector[N] mu;
    real dev;
    dev = 0;

    for ( i in 1:N ) {
    mu[i] = a[Participant[i]] + F(lSelf[i], wSelf[Participant[i]]) + F(lOthers[i], wOthers[Participant[i]]);
  }

    dev = dev + (-2)*bernoulli_logit_lpmf( ChoiceRed | mu );
}

Circular inference

functions {
  real F(real L, real w) {
    real eL = exp(L);
    return log((w * eL + 1 - w)/((1 - w) * eL + w));
  }
}

data{
  int<lower=1> N;

  int<lower=0, upper=1> ChoiceRed[N];

  real lSelf[N];
  real lOthers[N];

  int<lower=1> P;
  int<lower=1, upper=P> Participant[N];
}

parameters{
  vector[P] a;
  vector[P] wOthers;
  vector[P] wSelf;
}

model{
  vector[N] mu;
  wSelf ~ normal( 0.5 , 0.3 );
  wOthers ~ normal( 0.5 , 0.3 );
  a ~ normal( 0.5, 0.1 );

  for ( i in 1:N ) {

    mu[i] = a[Participant[i]] + F(lSelf[i] + F(aOthers[Participant[i]]*lOthers[i],wOthers[Participant[i]]) + F(aSelf[Participant[i]]*lSelf[i],wSelf[Participant[i]]), wSelf[Participant[i]]) + F(lOthers[i] + F(aSelf[Participant[i]]*lSelf[i],wSelf[Participant[i]]) + F(aOthers[Participant[i]]*lOthers[i],wOthers[Participant[i]]), wOthers[Participant[i]])
   }

  ChoiceRed ~ bernoulli_logit(mu);

}

generated quantities{
    vector[N] mu;
    real dev;
    dev = 0;

    for ( i in 1:N ) {

    mu[i] = a[Participant[i]] + F(lSelf[i] + F(aOthers[Participant[i]]*lOthers[i],wOthers[Participant[i]]) + F(aSelf[Participant[i]]*lSelf[i],wSelf[Participant[i]]), wSelf[Participant[i]]) + F(lOthers[i] + F(aSelf[Participant[i]]*lSelf[i],wSelf[Participant[i]]) + F(aOthers[Participant[i]]*lOthers[i],wOthers[Participant[i]]), wOthers[Participant[i]])
   }
    dev = dev + (-2)*bernoulli_logit_lpmf( ChoiceRed | mu );
}

