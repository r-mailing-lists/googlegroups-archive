data {
  int N;
  int K;
  vector[N] y;
  matrix[N, K] X;
}
parameters {
  real<lower = 0> alpha;
  real<lower = 0> beta;
  real<lower = 0> lambda;
  real<lower = 0> sigma;
}
transformed parameters{
  vector<lower = 0>[K] weights;
  vector[N] wX;

  {
     real x;

     for (k in 1:K) {

        x = k + 0.0) / K;
        weights[k] = x^alpha * (1 - x)^beta;
     }

  }
  wX = X * weights / sum(weights);
}
model {
  y ~ normal(wX * lambda, sigma);
  alpha ~ cauchy(0, 2);
  beta ~ cauchy(0, 2);
  lambda ~ cauchy(0, 2);
  sigma ~ cauchy(0, 2);
}

