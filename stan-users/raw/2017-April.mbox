transformed parameters {

  vector[T] u; // Level
  vector[T] v; // Slope

  u[1] = u_raw[1] * s_level;
  v[1] = v_raw[1] * s_slope;
  for(t in 2:T) {
    u[t] = (u_raw[t] + u[t - 1] + v[t - 1]) * s_level;
    v[t] =  (v_raw[t] + v[t - 1]) * s_slope;

  }
}
model {
  y ~ normal(u, s_obs);

  u_raw ~ normal(0, 1); // Should imply u[t] ~ N(u[t-1] + v[t-1], s_level)
  v_raw ~ normal(0, 1); // Should imply v[t] ~ N(v[t-1], s_slope)

  s_obs ~ cauchy(0, 1);
  s_level ~ cauchy(0, 1);
  s_slope ~ cauchy(0, 1);
}

