require(rstan)

model1 <- "

functions {
 vector convolution(int N, real tStep, vector aif, vector irf) {
   vector<lower=0>[N] ctr;
   for(i in 1:N) {
     vector<lower=0>[i] summand;
     for(j in 1:i) {
       summand[j] <- aif[i - j + 1] * irf[j];
     }
     ctr[i] <- sum(summand);
   }
   return ctr*tStep;
 }
}

data {
  int<lower=0> N;
}
transformed data {
  vector [N] aif_;
  vector [N] irf_;

  aif_[1] <- 1;
  irf_[1] <- 1;

  for (i in 2:N) {
    aif_[i] <- 1 + aif_[i-1]*0.1 + irf_[i-1]*0.16;
    irf_[i] <- 1 + aif_[i-1]*0.06 + irf_[i-1]*0.13;
  }
}
parameters {
  vector [N] beta;
}
transformed parameters {
  vector [N] beta_t;
  beta_t <- convolution(N, 1.1, aif_, irf_);
}
model {
  beta ~ normal(0, 1);
}"

model2 <- "

functions {
 vector convolution(int N, real tStep, vector aif, vector irf) {
    vector<lower=0>[N] ctr;
       for(i in 1:N) {
           ctr[i] <- 0.0;
           for(j in 1:i) {
               ctr[i] <- ctr[i] + aif[i - j + 1] * irf[j];
            }
       }
       return ctr*tStep;
 }
}

data {
  int<lower=0> N;
}
transformed data {
  vector [N] aif_;
  vector [N] irf_;

  aif_[1] <- 1;
  irf_[1] <- 1;

  for (i in 2:N) {
    aif_[i] <- 1 + aif_[i-1]*0.1 + irf_[i-1]*0.16;
    irf_[i] <- 1 + aif_[i-1]*0.06 + irf_[i-1]*0.13;
  }
}
parameters {
  vector [N] beta;
}
transformed parameters {
  vector [N] beta_t;
  beta_t <- convolution(N, 1.1, aif_, irf_);
}
model {
  beta ~ normal(0, 1);
}"

cmodel1 <- stan_model(model_code=model1)

