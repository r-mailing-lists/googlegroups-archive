log_T1 ~ uniform(log(6), log(8))              #  ~ uniform(1.79, 2.08)
  S_T1 ~ uniform(0.001,1)
         t ~ lognormal(log_T1, S_T1)

log_M1 ~ uniform(log(100), log(400))     # ~ uniform(4.61, 5.99)
  S_M1 ~ uniform(0.001, 3)
        m ~ lognormal(log_M1, S_M1)

log_R ~ uniform(log(12), log(16))           # ~ uniform(2.48, 2.77)
