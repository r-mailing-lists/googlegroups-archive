                + beta_age_center * age_center[i]
                + beta_age_squared * age_squared[i]
                + beta_age_cubed * age_cubed[i];
        dev <- dev + (-2) * binomial_log( y[i] , bin_total[i] , inv_logit(glm[i]) );
    }
}

