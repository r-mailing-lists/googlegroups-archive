As background, I'm running a recent version of STAN on a Mac, OS 10.7.5. Here is the model code:

data{
    int N;
    int y[N];
    real informant_sex[N];
    real age_center[N];
    real age_squared[N];
    real age_cubed[N];
    int informant_id[N];
    int species_id[N];
    int bin_total[N];
    int N_informant_id;
    int N_species_id;
}

parameters{
    real Intercept;
    real beta_informant_sex;
    real beta_age_center;
    real beta_age_squared;
    real beta_age_cubed;
    real vary_informant_id[N_informant_id];
    real<lower=0> sigma_informant_id;
    real vary_species_id[N_species_id];
    real<lower=0> sigma_species_id;
}

model{
    real vary[N];
    real glm[N];
    // Priors
    Intercept ~ normal( 0 , 100 );
    beta_informant_sex ~ normal( 0 , 100 );
    beta_age_center ~ normal( 0 , 100 );
    beta_age_squared ~ normal( 0 , 100 );
    beta_age_cubed ~ normal( 0 , 100 );
    sigma_informant_id ~ uniform( 0 , 100 );
    sigma_species_id ~ uniform( 0 , 100 );
    // Varying effects
    for ( j in 1:N_informant_id ) vary_informant_id[j] ~ normal( 0 , sigma_informant_id );
    for ( j in 1:N_species_id ) vary_species_id[j] ~ normal( 0 , sigma_species_id );
    // Fixed effects
    for ( i in 1:N ) {
        vary[i] <- vary_informant_id[informant_id[i]]
                + vary_species_id[species_id[i]];
        glm[i] <- vary[i] + Intercept
                + beta_informant_sex * informant_sex[i]
                + beta_age_center * age_center[i]
                + beta_age_squared * age_squared[i]
                + beta_age_cubed * age_cubed[i];
        glm[i] <- inv_logit( glm[i] );
    }
    y ~ binomial( bin_total , glm );
}

generated quantities{
    real dev;
    real vary[N];
    real glm[N];
    dev <- 0;
    for ( i in 1:N ) {
        vary[i] <- vary_informant_id[informant_id[i]]
