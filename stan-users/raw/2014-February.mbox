Great! Now it works fine. Just it seems a bit time consuming, compared to the rjags package. I ran this using a simulated data set with N=400 and nu=20. Haven't tried the real data set with N=20k and four levels(nurses within nursing units within hospitals within countries). Maybe there are some tricks to make it faster in stan? Here is my current stan file:

set_cppo('fast')
model_code<-'
data{
  int<lower=0> N;
  int<lower=0> nu;
  vector[3] Y[N];
  real x1[N];
  int<lower=1> unit[N];
  cov_matrix[3] Omega;
  vector[3] zero;
}
parameters{
  vector[3] beta0;
  vector[3] lam1;
  vector[3] u_l[nu];
  vector[3] u[nu];
  real F[N];
  vector[3] lam0;
  cov_matrix[3] sigma2;
  cov_matrix[3] sigma2_u;
  cov_matrix[3] sigma2_ul;
}
transformed parameters{
    vector[3] lam1x[2];
    vector[3] lam0x[2];
    lam1x[1]<-lam1;
    lam1x[2]<--1*lam1;
    lam0x[1]<-lam0;
    lam0x[2]<--1*lam0;
}
model{
  matrix[2,nu] lp_unit;
  lp_unit<-rep_matrix(0,2,nu);//fill lp_unit with zeros

  sigma2~inv_wishart(3,Omega);
  sigma2_u~inv_wishart(3,Omega);
  sigma2_ul~inv_wishart(3,Omega);

  beta0~normal(0,100);
  lam0~normal(0,100);
  lam1~normal(0,100);

  for (n in 1:nu){

    u[n]~multi_normal(zero,sigma2_u);

    u_l[n]~multi_normal(zero,sigma2_ul);
  }
  for (n in 1:N){
    F[n]~normal(0,1);

  for (k in 1:2){

    lp_unit[k,unit[n]]<-lp_unit[k,unit[n]]+multi_normal_log(Y[n],
                        beta0+u[unit[n]]+(lam0x[k]+lam1x[k]*x1[n]+u_l[unit[n]])*F[n],
                        sigma2);
  }
  }

  for (n in 1:nu){
    increment_log_prob(log_sum_exp(log(0.5)+lp_unit[1,n],log(0.5)+lp_unit[2,n]));
  }
}
'

