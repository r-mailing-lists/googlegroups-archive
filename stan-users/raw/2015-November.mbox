Hi Ben,
I re-write the STAN code as below (I edit a little bit about the inv_logit transformation you suggested earlier), and now both the chains for X_a and Z_a move around!

############ R code starts ############

library(rstan)

A <- 400

rho <- 0.9
sigma_eps <- 0.03
set.seed(1234)

logy_a <- rnorm(A, mean = 0, sd = 0.05)
y_a <- exp(logy_a)

X_lower <- log(0.5)
X_upper <- log(2)

test_data <- list(A = A, logy_a = logy_a,

                  rho = rho, sigma_eps = sigma_eps,

                  X_lower = X_lower, X_upper = X_upper)
test_model3 <-

"

data {
int<lower=1> A;
real<lower=0, upper=1> rho;
real<lower=0> sigma_eps;
real logy_a[A];
real X_lower;
real X_upper;
}//end of data

parameters{
  real Z_a[A];
}
transformed parameters {

  real<lower=X_lower, upper=X_upper> X_a[A];
real<lower=0> sigma_eps_stat;

sigma_eps_stat <- sqrt(sigma_eps^2 / (1 - rho^2));

  X_a[1] <- X_lower + inv_logit(sigma_eps_stat * Z_a[1]) * (X_upper - X_lower);

  for (i in 2:A) {
    X_a[i] <- X_lower +

              inv_logit(rho * X_a[i-1] + sigma_eps * Z_a[i]) * (X_upper - X_lower);
  }
}
model {

  Z_a ~ normal(0,1);
  logy_a ~ normal(X_a, 0.5);
}
"

fit_test3 <- sampling(stan_model(model_code = test_model3),
                      data = test_data,
                      init = 0,
                      control = list(adapt_delta = 0.999,#default=0.8
                                     max_treedepth = 12),

                      iter = 1000, chains = 2, warmup = 2)
traceplot(fit_test3, par = c(paste0("X_a[", c(10, 211, 352), "]"),
                             paste0("Z_a[", c(10, 211, 352), "]")))

