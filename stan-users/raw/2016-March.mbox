> >> data {
> >>  int<lower=0> N;
> >>  real y[N];
> >>  int<lower=0, upper=1> resp[N];
> >> }
> >> parameters {
> >>  real<lower=0> a;
> >>  real<lower=0> t;
> >>  real<lower=0, upper=1> b;
