Hi All,

Thank you for the answers. Bob comments settles it for me, and the model converges fine now. However, the model produces too much smoothing (i.e. the wave_random_effect parameters capture no variation), so I would like to put more "natural" dynamics into the model.

I thought I could simply put a random-walk-prior on each of the baseline coefficients including an evolution (variance) term, i.e. a_age ~N(a_age_(t-1), sigma_evolution), but now again the model does not converge (for now, I implemented only a version with a binary DV). Any idea what is going on here? Thanks again for these great answers, and fantastic maintenance of this site!

Tobi

data {
  int<lower=0> N;                                         // sample wave_size
  //int<lower=2> J;                                         // number of categories

  int<lower=0> n_age;                                     // number of age categories
  int<lower=0> n_race;                                    // number of race categories
  int<lower=0> n_edu;                                     // number of education catoegories
  int<lower=0> n_division;                                // number of Divisions
  int<lower=0> n_states;                                  // number of States
  int<lower=0> n_party_id;                                // number of party-categories
  int<lower=0> n_waves;                                   // number of Waves

  int<lower=0,upper=n_states> state[N];                   // state for each respondent

  int<lower=0,upper=1> gender[N];                         // gender each respondent
  int<lower=0,upper=n_age> age[N];                        // age for each respondent
  int<lower=0,upper=n_edu> edu[N];                        // edu for each respondent
  int<lower=0,upper=n_race> race[N];                      // race for each respondent
  int<lower=0,upper=n_party_id> party_id[N];              // party_id for each respondent

  //state level effects
  int<lower=1,upper=n_division> division[n_states];       // division for each state
  real<lower=0,upper=100> vote_prev_state[n_states];      // 2012 vote at the state-level

  int<lower=0,upper=1> y[N];                              // vote-choice
  int<lower=0,upper=N> in_wave[N];
  int<lower=0>        wave_size[n_waves];
 int<lower=0> wave_lims[n_waves,2];
}
parameters {

  real beta [n_waves];                                  // coefficient for female; wave
  vector[n_age] a_age [n_waves];                        // coefficient for age; wave
  vector[n_edu] a_edu [n_waves];                        // coefficient for edu; wave
  vector[n_race] a_race [n_waves];                      // coefficient for race; wave
  vector[n_party_id] a_party_id [n_waves];              // coefficient for party_id; wave

  //state level effects
  vector[n_division] a_division;                        // division random effects
  real gamma;                                           // previous vote- slope
  vector [n_states] a_state;                            // state effects

  // sigmas
  real<lower=0> sigma;                                  // sd for base-line parameters
  real<lower=0> sigma_evolution;                        // "evolution" term for dynamic parameters

}

transformed parameters{                                   // state-level effects transformed
  real a_state_hat [n_states];
  for (s in 1:n_states)
    a_state_hat[s]<-a_division[division[s]]+gamma*vote_prev_state[s];
}

model {

  sigma_evolution ~ cauchy(0,2.5);                      // half-cauchy priors, p. 54 for reference
  sigma ~ cauchy(0,2.5);

  //#1st Level
    a_state~ normal(a_state_hat,sigma);
  //evolution
  for (k in 2:n_waves) {
    beta[k] ~ normal(beta[k-1], sigma_evolution[k]);
    a_age[k] ~ normal(a_age[k-1], sigma_evolution);
    a_edu[k] ~ normal(a_edu[k-1], sigma_evolution);
    a_race[k] ~ normal(a_race[k-1], sigma_evolution);
    a_party_id[k] ~ normal(a_party_id[k-1], sigma_evolution);
}
//Likelihood for each i in each wave
for(s in 1:n_waves){
      int obs_in_wave[wave_size[s]];

obs_in_wave<-segment(in_wave,wave_lims[s,1],wave_lims[s,2]) ;   // find observations in each wave
  for (i in 1:wave_size[s]) {
real y_hat;
    y_hat <-
    beta[s]*gender[obs_in_wave[i]]
    +a_age[s,age[obs_in_wave[i]]]
    +a_edu[s,edu[obs_in_wave[i]]]
    +a_party_id[s,party_id[obs_in_wave[i]]]
    +a_race[s,race[obs_in_wave[i]]]
    +a_state[state[obs_in_wave[i]]];
    y[obs_in_wave[i]] ~ bernoulli_logit(y_hat);
  }
  }
  }

