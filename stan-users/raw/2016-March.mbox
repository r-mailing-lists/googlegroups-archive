Dear all -

I'm trying to model my data as a baseline plus mixture of three functions: Gaussian, linear, and a two-segment function. I've used the code from stagnant  <https://github.com/stan-dev/example-models/blob/master/bugs_examples/vol2/stagnant/stagnant2.stan>data to model a two-segment function and the examples from finite mixture in the manual to set up the model. However, the results with simulated data are still far from truth, so I'm probably doing something wrong.

Here's the R code for the data:
c_avg = 5

bp_u = 30
c_u = c(1, -1)
beta_u = c(0, -0.02)

beta_lin = -0.03

beta_g = 80
sigma_g = 30

fracs = c(1/3, 1/3, 1/3)

set.seed(1)
x<-runif(200,0,90)

y1 <- (x < bp_u)*(c_u[1]+beta_u[1]*x) + (x >= bp_u)*(c_u[2]+beta_u[2]*x)

y2 <- beta_lin*x

y3 <- (beta_g*(1/sigma_g*sqrt(2*pi))*exp(-(x^2)/(2*(sigma_g^2))))

set.seed(1)
y <- c_avg+fracs[1]*y1 + fracs[2]*y2 + fracs[3]*y3+rnorm(200,0,0.1)

And here's the model:

data {
  int<lower=0> N;
  real x[N];
  real Y[N];
}
parameters {
  real<lower=0> sigma;

  real c_avg;

  real c_u[2];
  real beta_u[2];
  real<lower=min(x),upper=max(x)> bp_u;

  real beta_lin;

  real beta_g;
  real<lower=0> sigma_g;

  simplex[3] fracs;
}

model {
  real mu[N];
  real log_probs[3];

  fracs ~ dirichlet(rep_vector(1.0/3.0,3));

  c_avg  ~ normal(0,100);

  c_u  ~ normal(0,100);
  beta_u ~ normal(0,100);
  beta_lin ~ normal(0,100);
  sigma_g ~ cauchy(0,100);
  sigma ~ cauchy(0,5);

  for (k in 1:3){
    for (n in 1:N){
      if (k==1)
        mu[n] <- fracs[1]*(c_avg+(x[n] < bp_u)*(c_u[1]+beta_u[1]*(x[n]-bp_u)) + (x[n] >= bp_u)*(c_u[2]+beta_u[2]*(x[n]-bp_u)));
      else if (k==2)
        mu[n] <- fracs[2]*(c_avg+beta_lin*x[n]);
      else if (k==3)
        mu[n] <- fracs[3]*(c_avg+beta_g*(1/sigma_g*sqrt(2*pi()))*exp(-(x[n]^2)/(2*(sigma_g^2))));
    }
    log_probs[k] <- log(fracs[k]) + normal_log(Y, mu, sigma);
  }
  increment_log_prob(log_sum_exp(log_probs));
}

