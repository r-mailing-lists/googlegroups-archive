> > >
> > >
> > > functions {
> > >  int sum(int[,] a) {
> > >   int s;
> > >   s <- 0;
> > >   for (i in 1:size(a))
> > >   for (j in 1:size(a[i]))
> > >    s <- s + a[i,j];
