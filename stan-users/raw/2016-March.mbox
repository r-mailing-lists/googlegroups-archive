   int RwNA[P,Q]; // Responses

}

parameters {

matrix[2,P] zP; // using example in page 75

   vector[2] muP; // parameters of persons (theta and tau)

   cholesky_factor_corr[2] L_rhoP; (Inferior matrix)

   vector<lower=0>[2] sigmaP;

   matrix[2,Q] zQ;

   vector[2] muQ;

   cholesky_factor_corr[2] L_rhoQ;

   vector<lower=0>[2] sigmaQ;

   vector<lower=0>[Q] sigmaT;

}

// I'm using transformed parameters because of explication in page 75 to obtain parmaP ~ MultiNormal(muP,sigmaP)

and paramI ~ MultiNormal(muI,sigmaI).

