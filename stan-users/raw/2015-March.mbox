Subject: Help with a non-mixing chain in what should be a simple multi-level intercept only model.
Message-ID: <LogY8yMSvN4.UU6GBkBkfj8J@stan-users.groups.google.com>
Archived-At: <https://groups.google.com/g/stan-users/c/LogY8yMSvN4/m/UU6GBkBkfj8J>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

I am trying to estimate what should be a very simple model for the mean and variance of the distribution of 6 correlated wealth measures by state and race, with partial pooling over states. The model, however, seems to run slower than it should, and the chain doesn't mix at all. I can't seem to find where I screwed up.

Also, is there any way to vectorize the calls to a multivariate dist?

data{
int N;
int Nstate;
row_vector[6] Wealth1984[N];
int State1984[N];
int Race1984[N];
}

parameters{
vector<lower=0>[6] SD;
corr_matrix[6] Rho;

vector[6] MuAlpha[2];
vector<lower=0>[6] SDAlpha[2];
corr_matrix[6] RhoAlpha[2];

vector[6] Alpha[Nstate,2];
}
model{
 matrix[6,6] L;
 matrix[6,6] L_A[2];

 SD ~ cauchy(0,1);

 MuAlpha[1] ~ normal(0,1);
 MuAlpha[2] ~ normal(0,1);

 SDAlpha[1] ~ cauchy(0,1);
 SDAlpha[2] ~ cauchy(0,1);

  L_A[1] <- diag_matrix(SDAlpha[1])*cholesky_decompose(RhoAlpha[1]);
  L_A[2] <- diag_matrix(SDAlpha[2])*cholesky_decompose(RhoAlpha[2]);

for(s in 1:Nstate){
 Alpha[s,1] ~ multi_normal_cholesky(rep_vector(0,6), L_A[1]);
 Alpha[s,2] ~ multi_normal_cholesky(rep_vector(0,6), L_A[2]);
            }

 L <- diag_matrix(SD)*cholesky_decompose(Rho);

for(i in 1:N){
   Wealth1984[i] ~ multi_normal_cholesky(MuAlpha[Race1984[i]]+Alpha[State1984[i],Race1984[i]], L  );
             }

 }

