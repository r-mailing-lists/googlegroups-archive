Hello everyone, here I am again!

First of all, I wanted to thank you all for your fantastic support.
I managed to run the model, but I still do have a lot of issues:

data {
  int<lower=1> n;
  int<lower=1> n_tot;
  int<lower=1> k;
  int<lower=1> s;                 // number of states of the HMM
  int<lower=1> T[n];
  int<lower=0> T_in[n];
  matrix<lower=0>[n_tot,k] X;

  int<lower=0> N[n_tot];
  int<lower=0,upper=1> C[n_tot];

  row_vector[s] pi_init;

}

parameters {

  vector[s] eta;
  matrix[k,s] tau;
  vector[s] alpha;

  matrix[k,s] gamma;
  vector[s*s-s] mu;
  matrix[k,s*s-s] beta;

}

transformed parameters {

  real<upper=0> llik;

  {int T_act;

  matrix<lower=0>[n_tot,s] lambda;
  matrix<lower=0,upper=1>[n_tot,s] m;

  matrix<lower=0,upper=1>[s,s] q[n_tot];
  vector<upper=0>[s] diag_pag[n_tot];
  vector<upper=0>[s] diag_prob[n_tot];
  vector[n] LL;
  row_vector<lower=0,upper=1>[s] L;
  matrix<lower=0,upper=1>[s,s] n_pag[n_tot];
  matrix<lower=0,upper=1>[s,s] p_conv[n_tot];
  matrix<lower=0,upper=1>[s,s] Y_mat;

  for (i in 1:n){

    L <- pi_init;

    for (t in 1:T[i]){
      T_act <- T_in[i]+t;

      // Sample the Bernoulli r.v. and the Poisson r.v.

      lambda[T_act] <- exp(eta' + X[T_act] * tau);
      for (j in 1:s){

        m[T_act,j] <- inv_logit(alpha[j] + X[T_act] * col(gamma,j));
        diag_pag[T_act,j] <- poisson_log(N[T_act], lambda[T_act,j]);
        diag_prob[T_act,j] <- bernoulli_log(C[T_act], m[T_act,j]);
      }

      // Sample the transition matrix
      q[T_act,1,1] <- 1./(1 + exp(mu[1] + X[T_act] * col(beta,1)) + exp(mu[2] + X[T_act] * col(beta,2)));
      q[T_act,1,2] <- exp(mu[1] + X[T_act] * col(beta,1))./(1 + exp(mu[1] + X[T_act] * col(beta,1)) + exp(mu[2] + X[T_act] * col(beta,2)));
      q[T_act,1,3] <- exp(mu[2] + X[T_act] * col(beta,2))./(1 + exp(mu[1] + X[T_act] * col(beta,1)) + exp(mu[2] + X[T_act] * col(beta,2)));
      q[T_act,2,1] <- exp(mu[3] + X[T_act] * col(beta,3))./(1 + exp(mu[3] + X[T_act] * col(beta,3)) + exp(mu[4] + X[T_act] * col(beta,4)));
      q[T_act,2,2] <- 1./(1 + exp(mu[3] + X[T_act] * col(beta,3)) + exp(mu[4] + X[T_act] * col(beta,4)));
      q[T_act,2,3] <- exp(mu[4] + X[T_act] * col(beta,4))./(1 + exp(mu[3] + X[T_act] * col(beta,3)) + exp(mu[4] + X[T_act] * col(beta,4)));
      q[T_act,3,1] <- exp(mu[5] + X[T_act] * col(beta,5))./(1 + exp(mu[5] + X[T_act] * col(beta,5)) + exp(mu[6] + X[T_act] * col(beta,6)));
      q[T_act,3,2] <- exp(mu[6] + X[T_act] * col(beta,6))./(1 + exp(mu[5] + X[T_act] * col(beta,5)) + exp(mu[6] + X[T_act] * col(beta,6)));
      q[T_act,3,3] <- 1./(1 + exp(mu[5] + X[T_act] * col(beta,5)) + exp(mu[6] + X[T_act] * col(beta,6)));

      n_pag[T_act] <- rep_matrix(0.0, s, s) + diag_matrix(exp(diag_pag[T_act]));
      p_conv[T_act] <- rep_matrix(0.0, s, s) + diag_matrix(exp(diag_prob[T_act]));

      Y_mat <- p_conv[T_act] .* n_pag[T_act];
      L <- L*Y_mat*q[T_act];
    }
    LL[i] <- log(L*rep_vector(1.0,s));
  }

  llik <- sum(LL);

  }
}

model {

  // Priors
  eta ~ normal(0,100);
  alpha ~ normal(0,100);

  mu ~ normal(0,100);

  for (i in 1:k){                            // the parameters tau and beta matrices with k rows
    tau[i] ~ normal(0,100);
    beta[i] ~ normal(0,100);
    gamma[i] ~ normal(0,100);
  }
  gamma[k+1] ~ normal(0,100);   // the parameter gamma is a matrix with k+1 rows

  // Likelihood
  increment_log_prob(llik);

}

It might seem a very complicated model, but basically what I need to compute is the likelihood for each user, given by
 <https://lh3.googleusercontent.com/-SJTHG543o_I/VRqxV-4vW5I/AAAAAAAAAQY/39fkgRoMh58/s1600/a.PNG>
where
 <https://lh3.googleusercontent.com/-KUalYp3yGYI/VRqyKeYyDKI/AAAAAAAAAQg/ERDtUDJUD1E/s1600/b.PNG>
