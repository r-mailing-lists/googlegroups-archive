Thanks very much. The following works pretty nicely. The plot of samples of a against b shows lots of divergent iterations near zero.

In R,

a <- 2
b <- 4
sigma <- 1
N <- 10
X <- rnorm(N,a*b,sigma)
priora_1=2
priora_2=100,
priorb_1=4
priorb_2=100

In Stan,

data {
  int N;
  real X[N];
  real priora_1;
  real priora_2;
  real priorb_1;
  real priorb_2;
}

parameters {
  real a;
  real b;
  real<lower=0> sigma;
}

model {
  X ~ normal(a*b,sigma);
  sigma ~ lognormal(0,1);
  a ~ normal(priora_1,priora_2);
  b ~ normal(priorb_1,priorb_2);
}

