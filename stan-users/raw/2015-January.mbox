                //  auxil[i]<-step(Z[i])

         //       Y[i] ~ dbern(auxil[i])

  // }

//likelihood

// moving to Stan:

// now I create an auxiliary vector muu  which will contain, in the i-th element, beta0(fixed for everyone) +(sum of the elements of the i-th_row  of (x*beta)   )

                for (i in 1:N){

                   sm1<-0.0;

       for(j in 1:k){

                    sm1<-sm1+beta[j]*x[i,j];

                     }

                   muu[i]<-beta0+sm1;

 z[i] ~ normal(muu[i],1);

