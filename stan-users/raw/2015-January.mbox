functions {

  real gev_log (vector y, real mu, real sigma, real xi) {
    vector[size(y)] z;
    vector[size(y) + 1] lp;
    real inv_xi;
    real inv_xi_p1;
    real neg_inv_xi;
    z <- ((1 + y) - mu) * (xi / sigma);
    inv_xi <- inv(xi);
    inv_xi_p1 <- 1 + inv_xi;
    neg_inv_xi <- -inv_xi;
    for (n in 1:size(y))
