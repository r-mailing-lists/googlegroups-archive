> > >   transformed data {
> > >   cholesky_factor_cov[N] L;
> > >   vector[N]  mu0 ;
> > >   matrix[N,N] eye;
> > >
> > >   L <- cholesky_decompose(K) ;
> > >
> > >   for (j in 1:N) {
> > >   mu0[j] <- 0;
> > >   }
> > >
> > >   for (j in 1:N) {
> > >     for (i in 1:N) {
> > >     eye[i,j] <- 0.0;
> > >     }
> > >       eye[j,j] <- 1.0;
> > >     }
> > >   }
> > >
> > >   parameters {
> > >
> > >   real beta_0;
> > >   // coefficient of the fixed effect
