Hi,

I am using rstan to jointly model the longitudinal data Y_{ij} and binary data E_i. The stan file looks as follows:

parameters {
  vector[3] beta;
  vector[3] alpha;
  real gamma0;
  vector[N2] U;
  real<lower=0> tau_e;
  real<lower=0> tau_u;
}
transformed parameters {
  real mu[N1];
  real eta[N2];
  real<lower=0> sig_e;
  real<lower=0> sig_u;

  sig_e <- sqrt(1/tau_e);
  sig_u <- sqrt(1/tau_u);

  for (i in 1:N1)
      mu[i] <- X[i] * beta + W[i] * U;

  for (i in 1:N2)
      eta[i] <- Xe[i] * alpha + gamma0 * U[i];

}
model {
  tau_e ~ uniform(0, 1000);
  tau_u ~ uniform(0, 1000);
  gamma0 ~ normal(0, 1000);

  for(i in 1:3){
    beta[i] ~ normal(0, 1000);
    alpha[i] ~ normal(0, 1000);
  }

  for(i in 1:N2){
    U[i] ~ normal(0, sig_u);
    E[i] ~ bernoulli_logit(eta[i]);
  }

  for (i in 1:N1)
    Y[i] ~ normal(mu[i], sig_e);

}

