  sigma ~ cauchy(0,5) ;
  h2 ~ uniform(0,1) ;

  // data generation
  g ~ multi_normal_cholesky(mu0, sqrt(h2)*sigma * L) ;

  // observation
  y  ~ normal(mu + g, sqrt(1 - h2) * sigma  );

  }
'

