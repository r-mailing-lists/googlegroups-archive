Bob,

I believe I have a model working with an AR(1) noise:

data
    {
    int<lower=1> N ;
    real x[N] ;
    real y[N] ;
    }

parameters
    {
    real alpha ;
    real beta ;
    real kappa ;

    real lambda ;

    real<lower=0> sigma ;
    }

model
    {
    real error ;

    alpha ~ normal (0, 30) ;
    beta  ~ normal (0, 2) ;
    kappa ~ normal (0, 2) ;
    lambda ~ normal (0, 2) ;

    sigma ~ gamma (3, 1) ;

    error <- 0 ;

    for (n in 1:N)
{

y[n] ~ normal (alpha + beta * x[n] + error, sigma) ;

error <- kappa * (y[n] - (alpha + beta * x[n])) ;
}
    }

