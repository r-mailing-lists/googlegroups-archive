> > > > > }
> > > > >
> > > > >
> > > > > model {
> > > > >     // Priors
> > > > >     gammaSpp  ~  normal(0, sigmaSpp);
> > > > >     sigmaSpp  ~  cauchy(0, 5);
> > > > >     alphaPhy  ~  normal(0, 5); // implies: gammaPhy  ~  multi_normal_cholesky(zeroes, diag_matrix(sigmaPhy) * LPhy * LPhy' * diag_matrix(sigmaPhy)))
> > > > >     sigmaPhy  ~  cauchy(0, 5);
> > > > >     beta      ~  normal(0, 5);
> > > > >     sigmaY    ~  cauchy(0, 5);
