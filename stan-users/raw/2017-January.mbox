Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Simple question hopefully begets a simple answer: can I vectorise this model further?
Thanks for the great resource!

data {
  int<lower=0> N_obs; //number of paired observations
  int<lower=0> N_sp; //number of species
  int<lower=1> J; //number of dimesions
  matrix[N_obs, J] y_obs; //data
  int sp[N_obs]; //species index
}
parameters {
  vector[J] mu_sp[N_sp];
  vector<lower=0>[J] sigma[N_sp];
  corr_matrix[J] Omega[N_sp];
}
transformed parameters{
  cov_matrix[J] Sigma[N_sp];
  for(i in 1:N_sp)
    Sigma[i] = quad_form_diag(Omega[i], sigma[i]);
}
model {
  for(i in 1:N_obs)
    y_obs[i] ~ multi_normal(mu_sp[sp[i]], Sigma[sp[i]]);

  //priors
  for(i in 1:N_sp){
    mu_sp[i] ~ normal(0, 10);
    sigma[i] ~ cauchy(0, 1);
    Omega[i] ~ lkj_corr(2);
  }
}

