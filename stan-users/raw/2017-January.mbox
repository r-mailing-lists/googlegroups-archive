>   vector[N2] y2;
>   real<lower=0> eta_sq;
>   real<lower=0> inv_rho_sq;
>   real<lower=0> sigma_sq;
> }
> transformed parameters {
>    real<lower=0> rho_sq;
>    rho_sq = inv(inv_rho_sq);
> }
> model {
