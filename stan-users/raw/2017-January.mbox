Thanks again Andre. Now I do manage to get a model running with normalized probs, but converges poorly (very little effective samples and high rhats, and ugly trace and pair plots!), and it takes a while to run.
I wonder if it has to do with this condition:

for (n in 1:N){

if (theta[N] + (m-1) * lambda > 0);

    for (j in 1:m){
      sumprob[j] =  (eta[n] + log1m(lambda) + (j-1-1) * log(theta[n] + lambda * (j-1)) - (theta[n] + lambda * (j-1)) - lgamma(j-1 + 1));
      logprob[n]= sum(sumprob[1:m]);
    }
  logprob[n]=0;
  }

Which in my understanding says that if (theta[N] + (m-1) * lambda > 0 then normalize, otherwise don't.
Although, even without that condition the model is not looking very good.
I'm thinking about quitting the normalization and just keep the unnormalized probs and related parameter estimates...if it weren't for a few divergent samples I get with this though!

Anyways. here's the complete code below.

Thanks,

Tada

functions{
real lb(matrix X, vector beta){
real max_mu = max(exp(X * beta));
if (max_mu <= 2) return max_mu / (max_mu - 4);
return -1;
  }
}

data {

int<lower=0> m;

int<lower=0> N;
int<lower=0> K;
matrix[N, K] X;
vector<lower=0>[N] y;
}

transformed data {
vector[N] ym1 = y - 1;
}

parameters {
vector[K] beta;
real<lower=lb(X, beta), upper = 1> lambda;

}

model {

vector[N] eta = X * beta;
vector[N] theta = exp(eta) * (1 - lambda);
vector[N] theta_lambda_y = theta + lambda * y;
vector[N] logyfact =  lgamma(y + 1);

vector[m] sumprob;
vector[N] logprob;

for (n in 1:N){

if (theta[N] + (m-1) * lambda > 0);

    for (j in 1:m){
      sumprob[j] =  (eta[n] + log1m(lambda) + (j-1-1) * log(theta[n] + lambda * (j-1)) - (theta[n] + lambda * (j-1)) - lgamma(j-1 + 1));
      logprob[n]= sum(sumprob[1:m]);
    }
  logprob[n]=0;
  }

target += (eta + log1m(lambda) + ym1 .* log(theta_lambda_y) - theta_lambda_y - logprob);

lambda ~ normal(0,0.1);
beta[1] ~ normal(0,10);
beta[2:4] ~ normal(0,1);

}

generated quantities{
vector[N] log_lik;
vector[N] theta;
for (i in 1:N){
log_lik[i] = (X[i,]*beta + log1m(lambda) + ym1[i] .* log((exp(X[i,] * beta) * (1 - lambda)) + lambda * y[i]) - ((exp(X[i,] * beta) * (1 - lambda)) + lambda * y[i]) - lgamma(y[i] + 1));

theta[i] = exp(X[i,] * beta) * (1 - lambda);
    }

