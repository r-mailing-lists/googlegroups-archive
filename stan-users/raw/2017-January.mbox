functions{
real lb(matrix X, vector beta){
  real max_mu = max(exp(X * beta));
  if (max_mu <= 2) return max_mu / (max_mu - 4);
    return -1;
  }

real normalized(theta, lambda, m){
real sumprob = for(i in 0:m){
logprob[i] = (eta + log1m(lambda) + (m[i]-1) .* log(theta + lambda * m[i]) - (theta + lambda * m[i]) - lgamma(m[i] + 1))
}
return sum(logprob)

   }
