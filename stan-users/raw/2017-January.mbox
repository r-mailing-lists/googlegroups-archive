>       Sigma[i,j] = eta_sq * exp(-rho_sq * dot_self(x[i] - x[j]));
>       Sigma[j,i] = Sigma[i,j];
>     }
>   }
>
>
>   // diagonal elements
>   for (k in 1:N)
>     Sigma[k,k] = eta_sq + sigma_sq; // + jitter
>
>
>   eta_sq ~ cauchy(0,5);     // prior on eta
>   inv_rho_sq ~ cauchy(0,5);     // prior
>   sigma_sq ~ cauchy(0,5);   // prior
