data {
int<lower=0> N;
int<lower=0> K;
matrix[N, K] X;
vector<lower=0>[N] y;
}
transformed data {
vector[N] ym1 = y - 1;
}

parameters {
vector[K] beta;
real<lower=lb(X, beta), upper = 1> lambda;

integer <lower=1, upper=5> m;

}

model {

vector[N] eta = X * beta;
vector[N] theta = exp(eta) * (1 - lambda);
vector[N] theta_lambda_y = theta + lambda * y;

vector[N] logyfact =  lgamma(y + 1);
real logknorm = normalized(theta, lambda, m);

target += (eta + log1m(lambda) + ym1 .* log(theta_lambda_y) - theta_lambda_y - logyfact)-logknorm;

lambda ~ normal(0,0.1);
beta[1] ~ normal(0,10);
