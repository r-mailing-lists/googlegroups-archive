I've been trying to modify the multivariate probit model in the Stan manual to include a hierarchical intercept that represents site-level effects.  I have been unable to get the model to converge despite trying a number of variations with lengthy run-times and strict control parameters.

I believe that part of the issue might be that I am not enforcing a sum-to-zero constraint on the intercept.  The reason for this is that I eventually plan to incorporate spatial autocorrelation among the intercepts (drawing them from a multivariate normal distribution), and I don't think that either of the sum-to-zero methods described in the manual would work with this.

Is there some way I could incorporate a hierarchical intercept, or should I just go with hierarchical slopes?  Any assistance would be greatly appreciated.

functions {
    // This section identical to mvProbit model in manual
    int sum(int[,] a) {
        int s;
        s <- 0;
        for (i in 1:size(a))
            for (j in 1:size(a[i]))
            s <- s + a[i,j];
        return s;
    }
}
data {
    int<lower=1> K;
    int<lower=1> D;
    int<lower=0> N;
    int<lower=0,upper=1> y[N,D];
    vector[K] x[N];
    int<lower=1> nPops;
    int<lower=1,upper=nPops> popID[N];
    real<lower=0> coefScale;  // Standard deviation of alpha & beta;
#    matrix<lower=0>[nPops, nPops] Dist; // Distance matrix; uncomment for spatial version of model
}
transformed data {
    // This section identical to provided mvProbit model
  int<lower=0> N_pos;
  int<lower=1,upper=N> n_pos[sum(y)];
  int<lower=1,upper=D> d_pos[size(n_pos)];
  int<lower=0> N_neg;
  int<lower=1,upper=N> n_neg[(N * D) - size(n_pos)];
  int<lower=1,upper=D> d_neg[size(n_neg)];

  N_pos <- size(n_pos);
  N_neg <- size(n_neg);
  {
    int i;
    int j;
    i <- 1;
    j <- 1;
    for (n in 1:N) {
      for (d in 1:D) {
        if (y[n,d] == 1) {
          n_pos[i] <- n;
          d_pos[i] <- d;
          i <- i + 1;
        } else {
          n_neg[j] <- n;
          d_neg[j] <- d;
          j <- j + 1;
        }
      }
    }
  }
}
parameters {
    matrix[D,nPops] raw_alpha;
    matrix[D,K] raw_beta;
    cholesky_factor_corr[D] L_Omega;
    vector<lower=0>[N_pos] z_pos;
    vector<upper=0>[N_neg] z_neg;
#   real<lower=0> spatialScale;  // uncomment for spatial version
}
transformed parameters {
    vector[D] z[N];
    matrix[D,nPops] alpha;
    matrix[D,K] beta;
/*    Spatial components
    corr_matrix[nPops] Spatial_Sigma;
    matrix[nPops,nPops] L_Spatial;
    Spatial_Sigma <- exp(-1*Dist/spatialScale);
    L_Spatial <- cholesky_decompose(Spatial_Sigma);
    for(i in 1:D) alpha[i] <- diag_pre_multiply(rep_vector(coefScale, nPops), L_Spatial) * raw_alpha[i];
*/ // End spatial components
   beta <- raw_beta * coefScale;
   alpha <- raw_alpha * coefScale; // Non-spatial version
    for (n in 1:N_pos)
        z[n_pos[n], d_pos[n]] <- z_pos[n];
    for (n in 1:N_neg)
        z[n_neg[n], d_neg[n]] <- z_neg[n];
}
model {
    to_vector(raw_beta) ~ normal(0, 1);
    to_vector(raw_alpha) ~ normal(0, 1);
#    spatialScale ~ normal(0, 1);
  {
    vector[D] beta_x[N];
    for (n in 1:N)
      beta_x[n] <- beta * x[n] + col(alpha, popID[n]);
    z ~ multi_normal_cholesky(beta_x, L_Omega);
  }
}

