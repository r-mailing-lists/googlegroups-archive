parameters {
    real A;
    real B;
    vector[N_upper] inv_L_lower;
}
transformed parameters {
    cholesky_factor_cov[N] inv_L;
    vector[N] v;

    for (n in 1:N) {
        inv_L[n, n] <- 1;
    }

    {
        int i;
        i <- 1;
        for (m in 2:N) {
            for (j in 1:(m - 1)) {
                inv_L[m, j] <- inv_L_lower[i];
                inv_L[j, m] <- 0;
                i <- i + 1;
            }
        }
    }

    v <- inv_L' * Y;
}
model {
    A ~ normal(0, 10);
    B ~ normal(0, 10);
    v ~ normal(A + X * B, 1);
    increment_log_prob(log_determinant(inv_L'));

