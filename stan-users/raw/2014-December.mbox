Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Hi All,

I've recently coded in STAN an example of state-space surplus-production model using Meyer-Millar (1999) BUGS in Bayesian stock assessments.

See attached WinBUGS code for comparison:

#State-space surplus production model for albacore tuna with lognormal errors
#############################################################################
model surplustuna {
######distribution of I's#####
for (i in 1:N) { Imean[i] <- log(Q*P[i]);
                 I[i] ~ dlnorm(Imean[i],itau2);
                 B[i] <- K*P[i] }
######distribution of P's######
Pmean[1] <- 0;
P[1] ~ dlnorm(Pmean[1],isigma2)I(0.5,2.0)
for (i in 2:N) {
    Pmean[i] <- log(max(P[i-1] + r*P[i-1]*(1-P[i-1]) - k*C[i-1],0.01));
    P[i] ~ dlnorm(Pmean[i],isigma2);
    }
#####Prior on r######
#lognormal prior corresponding to 10% and 90% of r at 0.13 and 0.48
r~dlnorm(-1.38,3.845);
#####Prior on k######
#Lognormal prior corresponding to 10% and 90% of k at 1/300 and 1/80
k ~ dlnorm(-5.042905,3.7603664);
K <- 1/k;
MSP<-r*K/4;
#####Prior on Q#####
iq ~ dgamma(0.001,0.001);
q <- 1/iq;
Q <- q*K;
#######Priors on isigma2 and itau2#####
a0<-3.785518;  b0<-0.010223;
c0<-1.708603; d0<-0.008613854;
isigma2 ~ dgamma(a0,b0);
itau2   ~ dgamma(c0,d0);
Sigma2<-1/isigma2; Tau2<-1/itau2;
#######Project biomass into future#####
nyrs<-10
for (i in N:(N+nyrs-1)) {C[i]<-19}
for (i in (N+1):(N+nyrs)) {
    Pmean[i] <- log(max(P[i-1] + r*P[i-1]*(1-P[i-1]) - k*C[i-1],0.01));
    P[i] ~ dlnorm(Pmean[i],isigma2);
    B[i] <- K*P[i] }

}

## data
list(N=23,
     C=c(15.9, 25.7, 28.5, 23.7, 25.0, 33.3, 28.2, 19.7, 17.5, 19.3, 21.6, 23.1,
         22.5, 22.5, 23.6, 29.1, 14.4, 13.2, 28.4, 34.6, 37.5, 25.9, 25.3),
     I=c(61.89, 78.98, 55.59, 44.61, 56.89, 38.27, 33.84, 36.13, 41.95, 36.63,
         36.33, 38.82, 34.32, 37.64, 34.01, 32.16, 26.88, 36.61, 30.07, 30.75,
         23.36, 22.36, 21.91))

## priors (not necessary if using JAGS)
list(P=c(0.99,0.98,0.96,0.94,0.92,0.90,0.88,0.86,0.84,0.82,0.80,0.78,0.76,0.74,
         0.72,0.70,0.68,0.66,0.64,0.62,0.60,0.58,0.56),r=0.8, k=0.005, iq=5,
     isigma2=100, itau2=100)

This is the STAN code that I coded based on the example. Please let me know if you see any errors.

library(rstan)

sink("surplus.stan")
cat("
  data {
    int<lower=0> N;
    real L[N];
    real I1[N];
    }
  parameters {
    real<lower=0.0001> k;
    real<lower=0> r;
    real<lower=0> P[N];
    real<lower=0, upper=1> sigma2p;
    real<lower=0, upper=1> sigma2s1;
    real<lower=0.0001> iq1;
    }
  transformed parameters {
    real<lower=0> q1;
    real<lower=0> Q1;
    real<lower=0> K;

    K <- 1/k;
    q1 <- 1/iq1;
    Q1 <- q1*K;
    }
  model {
    k ~ lognormal(-5.0429,0.3372);
    r ~ lognormal(-1.38,0.332);
    iq1 ~ gamma(0.001,0.001);
    sigma2p ~ inv_gamma(14.03,0.760143);
    sigma2s1 ~ inv_gamma(5.8029751,0.45121);

    // state equation
    // **************
    {
    real Pmu[N];
    Pmu[1] <- 0;
    P[1] ~ lognormal(Pmu[1], sigma2p) T[0.5,2.0];
    for (i in 2:N) {
      Pmu[i] <- log(fmax(P[i-1] + r*P[i-1]*(1-P[i-1]) - k*L[i-1], 0.01));
      P[i] ~ lognormal(Pmu[i],sigma2p);
      }
    }

    // observation equation
    // ********************
    for (i in 1:N) {
      real mu[N];
      mu[i] <- log(Q1*P[i]);
      I1[i] ~ lognormal(mu[i],sigma2s1);
      }

    }
  generated quantities {
    real B[N];
    real MSP;

    for (i in 1:N){
      B[i] <- K*P[i];
      }
    MSP <- r*K/4;
    }
    ", fill=TRUE)
sink()

tuna_data<-list(N=23,
     L=c(15.9, 25.7, 28.5, 23.7, 25.0, 33.3, 28.2, 19.7, 17.5, 19.3, 21.6, 23.1,
         22.5, 22.5, 23.6, 29.1, 14.4, 13.2, 28.4, 34.6, 37.5, 25.9, 25.3),
     I1=c(61.89, 78.98, 55.59, 44.61, 56.89, 38.27, 33.84, 36.13, 41.95, 36.63,
         36.33, 38.82, 34.32, 37.64, 34.01, 32.16, 26.88, 36.61, 30.07, 30.75,
         23.36, 22.36, 21.91))

