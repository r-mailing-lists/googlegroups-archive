Dear All

I want to expand my following code (working) for multiple outcomes but I am not sure whether it is possible in STAN or not...Is there any function multi-logit in Stan similar to multi_normal?...Please help...I stuck on this...

data {
  int<lower=0> N;
  int<lower=0> M;
  int Numerator[N];
  int Denominator[N];
  int ID[N];

}
parameters {
   real mu;
   real<lower=0> sigmasq;
   real beta0[M];
}
transformed parameters {
  real<lower=0> sigma;
  real<lower=0,upper=1> p[M];
  sigma <- sqrt(sigmasq);
  for (i in 1:M)
    p[i] <- inv_logit(beta0[i]);
}
model {
  mu ~ normal(0.0, 1000.0);
  sigmasq ~ inv_gamma(0.001, 0.001);
for (i in 1:M)
{
  beta0[i] ~ normal(mu, sigma);
}
for(j in 1:N)
{
  Numerator[j] ~ binomial_logit(Denominator[j], beta0[ID[j]]);
}
}
generated quantities {
  real pop_mean;
  pop_mean <- inv_logit(mu);
}

