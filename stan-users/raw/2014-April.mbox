  data {
    int<lower=1> K;
    int<lower=1> N;
    matrix[N,K] x;
    int y[N];
  }
  parameters {
     matrix[K,1] beta;
  }
  transformed parameters {
    matrix[N,1] theta;
    theta <- exp(x * beta);
  }
  model {
    int yrep[N];
    real T[N];
    for(i in 1:N){

      y[i] ~ poisson(theta[i]);

      yrep[i] ~ poisson(theta[i]);
