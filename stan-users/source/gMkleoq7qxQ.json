=\"color:#660\">&lt;=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>        cr</span><span style=\"color:#660\">[</span><span style=\"color:#000\">t</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> initCR</span><span style=\"color:#660\">;  // [0.25 0.25 0.25]</span><span style=\"color:#000\"><br>      </span><span style=\"color:#660\">}</span><span style=\"color:#000\"> </span><span style=\"color:#008\">else</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>        </span><span style=\"color:#008\">for</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">ct </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:(</span><span style=\"color:#000\">t</span><span style=\"color:#660\">-</span><span style=\"color:#066\">1</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>          wgtrew</span><span style=\"color:#660\">[</span><span style=\"color:#000\">ct</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">disc</span><span style=\"color:#660\">[</span><span style=\"color:#000\">s</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">^</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">t</span><span style=\"color:#660\">-</span><span style=\"color:#000\">ct</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> to_row_vector</span><span style=\"color:#660\">(</span><span style=\"color:#000\">otherReward</span><span style=\"color:#660\">[</span><span style=\"color:#000\">s</span><span style=\"color:#660\">,</span><span style=\"color:#000\">ct</span><span style=\"color:#660\">]);</span><span style=\"color:#000\"><br>        </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>        </span><span style=\"color:#008\">for</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">o </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">4</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>          cr</span><span style=\"color:#660\">[</span><span style=\"color:#000\">t</span><span style=\"color:#660\">,</span><span style=\"color:#000\">o</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sum</span><span style=\"color:#660\">(</span><span style=\"color:#000\"> sub_col</span><span style=\"color:#660\">(</span><span style=\"color:#000\">wgtrew</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">o</span><span style=\"color:#660\">,</span><span style=\"color:#000\">t</span><span style=\"color:#660\">-</span><span style=\"color:#066\">1</span><span style=\"color:#660\">));</span><span style=\"color:#000\"><br>        </span><span style=\"color:#660\">}<br></span><span style=\"color:#000\">        cr[t] &lt;- cr[t]/ (sum(cr[t])+machine_precision());<br>      </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br>     </span><span style=\"color:#660\">......</span><span style=\"color:#000\"><br>      <br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span></div></code></div><div><br></div></font></div></code></div><br>All the other part remains identical to another alternative model, which runs fairly fast. I doubt it is this piece computing </div><div>slows down the sampling procedure. </div><div><br></div><div>I was just wondering if there is a way to optimize it (something comparable in matlab)?</div><div><br></div><div>Hop this post is not so off topic. I appreciate any suggestion or comment.</div><div><br></div><div>Lei</div><div> </div></div></blockquote></div>"
