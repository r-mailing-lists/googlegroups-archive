r:#660\">,</span><span style=\"color:#066\">0.88</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.86</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.84</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.82</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.80</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.78</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.76</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.74</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         </span><span style=\"color:#066\">0.72</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.70</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.68</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.66</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.64</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.62</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.60</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.58</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.56</span><span style=\"color:#660\">),</span><span style=\"color:#000\">r</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0.8</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> k</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0.005</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> iq</span><span style=\"color:#660\">=</span><span style=\"color:#066\">5</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>     isigma2</span><span style=\"color:#660\">=</span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> itau2</span><span style=\"color:#660\">=</span><span style=\"color:#066\">100</span><span style=\"color:#660\">)</span></pre></div></code></div><br><br></div><div>This is the STAN code that I coded based on the example. Please let me know if you see any errors.</div><div><br></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><font color=\"#660066\"><div><br></div><div>library(rstan)</div><div><br></div><div>sink(&quot;surplus.stan&quot;)</div><div>cat(&quot;</div><div>  data {</div><div>    int&lt;lower=0&gt; N; </div><div>    real L[N];</div><div>    real I1[N];</div><div>    }</div><div>  parameters {</div><div>    real&lt;lower=0.0001&gt; k;</div><div>    real&lt;lower=0&gt; r;</div><div>    real&lt;lower=0&gt; P[N];</div><div>    real&lt;lower=0, upper=1&gt; sigma2p;</div><div>    real&lt;lower=0, upper=1&gt; sigma2s1;</div><div>    real&lt;lower=0.0001&gt; iq1;</div><div>    }</div><div>  transformed parameters {</div><div>    real&lt;lower=0&gt; q1;</div><div>    real&lt;lower=0&gt; Q1;</div><div>    real&lt;lower=0&gt; K;</div><div>    </div><div>    K &lt;- 1/k;</div><div>    q1 &lt;- 1/iq1;</div><div>    Q1 &lt;- q1*K;</div><div>    }</div><div>  model {</div><div>    k ~ lognormal(-5.0429,0.3372);</div><div>    r ~ lognormal(-1.38,0.332);</div><div>    iq1 ~ gamma(0.001,0.001);</div><div>    sigma2p ~ inv_gamma(14.03,0.760143);</div><div>    sigma2s1 ~ inv_gamma(5.8029751,0.45121);</div><div>    </div><div>    // state equation</div><div>    // **************</div><div>    {</div><div>    real Pmu[N];</div><div>    Pmu[1] &lt;- 0;</div><div>    P[1] ~ lognormal(Pmu[1], sigma2p) T[0.5,2.0];</div><div>    for (i in 2:N) {</div><div>      Pmu[i] &lt;- log(fmax(P[i-1] + r*P[i-1]*(1-P[i-1]) - k*L[i-1], 0.01));</div><div>      P[i] ~ lognormal(Pmu[i],sigma2p);</div><div>      }</div><div>    }</div><div>    </div><div>    // observation equation</div><div>    // ********************</div><div>    for (i in 1:N) {</div><div>      real mu[N];</div><div>      mu[i] &lt;- log(Q1*P[i]);</div><div>      I1[i] ~ lognormal(mu[i],sigma2s1);      </div><div>      }</div><div><br></div><div>    }</div><div>  generated quantities {</div><div>    real B[N];</div><div>    real MSP;</div><div><br></div><div>    for (i in 1:N){</div><div>      B[i] &lt;- K*P[i];</div><div>      }</div><div>    MSP &lt;- r*K/4;</div><div>    }</div><div>    &quot;, fill=TRUE) </div><div>sink()</div><div><br></div><div><div>tuna_data&lt;-list(N=23, </div><div>     L=c(15.9, 25.7, 28.5, 23.7, 25.0, 33.3, 28.2, 19.7, 17.5, 19.3, 21.6, 23.1,</div><div>         22.5, 22.5, 23.6, 29.1, 14.4, 13.2, 28.4, 34.6, 37.5, 25.9, 25.3),</div><div>     I1=c(61.89, 78.98, 55.59, 44.61, 56.89, 38.27, 33.84, 36.13, 41.95, 36.63, </div><div>         36.33, 38.82, 34.32, 37.64, 34.01, 32.16, 26.88, 36.61, 30.07, 30.75, </div><div>         23.36, 22.36, 21.91))</div></div><div><br></div></font></code></div><div><br></div>Thanks,</div><div><br></div><div>Allan Debertin<br><br></div></div></div>"
