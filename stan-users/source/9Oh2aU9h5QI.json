\">);</span><span style=\"color:#000\"><br> mu_prec</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> bmu</span><span style=\"color:#660\">*</span><span style=\"color:#000\">tau_mix</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br> </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br> </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br> <br> model </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br> real bprec</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> real alpha</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> real aprec</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> <br> amu </span><span style=\"color:#660\">~</span><span style=\"color:#000\"> normal</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.001</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br> bmu </span><span style=\"color:#660\">~</span><span style=\"color:#000\"> gamma</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0.5</span><span style=\"color:#660\">,</span><span style=\"color:#066\">50</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br> bprec</span><span style=\"color:#660\">~</span><span style=\"color:#000\">gamma</span><span style=\"color:#660\">(</span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br> <br> alpha </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><spa