<br> vector</span><span style=\"color:#660\">[</span><span style=\"color:#000\">C</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> tau_mix</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> real q</span><span style=\"color:#660\">[</span><span style=\"color:#000\">N</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br> <br> </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br> <br> transformed parameters</span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br> simplex </span><span style=\"color:#660\">[</span><span style=\"color:#000\">C</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> pi</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> real</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> p</span><span style=\"color:#660\">[</span><span style=\"color:#000\">N</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br> vector </span><span style=\"color:#660\">[</span><span style=\"color:#000\">C</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> mu_prec</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br> <br> p</span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> q</span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br> </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">j </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">: