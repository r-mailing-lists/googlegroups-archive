     "<div dir=\"ltr\"><div><div><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div><span style=\"color:#000\">sub_sample </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">stanfit</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> n</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> keep_warmup </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> TRUE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  sim </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> stanfit@sim<br>  samp </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sim$samples<br>  W </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sim$warmup<br>  I </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sim$iter<br>  sel </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#008\">if</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">keep_warmup</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\">W</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sample</span><span style=\"color:#660\">((</span><span style=\"color:#000\">W </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">):</span><span style=\"color:#000\">I</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> size </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> n</span><span style=\"color:#660\">))</span></div></code></div></div></div></blockquote></div></div></div>"
