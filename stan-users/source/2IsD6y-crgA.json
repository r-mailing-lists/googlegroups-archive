     "<div dir=\"ltr\"><div><div><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div><div class=\"gmail_quote\"><div dir=\"ltr\">On Wed, Aug 12, 2015 at 6:00 PM Jonah &lt;<a href rel=\"nofollow\" data-email-masked>jga...@gmail.com</a>&gt; wrote:<br></div></div></div></div></blockquote></div></div></blockquote></div></div></div>"
