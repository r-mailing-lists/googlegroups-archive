ght=\"20\" style=\"height:15.0pt\">\r\n  <td height=\"20\" style=\"height:15.0pt\">[36] abind_1.4-3        mime_0.4           gridExtra_2.2.1    ggplot2_2.1.0      digest_0.6.9      </td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15.0pt\">\r\n  <td height=\"20\" style=\"height:15.0pt\">[41] stringi_1.0-1      grid_3.2.1         tools_3.2.1        magrittr_1.5       shinythemes_1.0.1 </td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15.0pt\">\r\n  <td height=\"20\" style=\"height:15.0pt\">[46] rsconnect_0.4.2.1  dygraphs_0.8       minqa_1.2.4        R6_2.1.2           nlme_3.1-126      </td>\r\n </tr></tbody></table></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\"><span style=\"line-height:22.72px\">Cheers,</span><br></div><div style=\"line-height:22.72px;color:rgb(68,68,68);font-family:Calibri;font-size:16px\">Paul Scutti</div></div>"
