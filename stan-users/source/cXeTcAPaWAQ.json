or:#066\">1.0</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> nrow</span><span style=\"color:#660\">=</span><span style=\"color:#066\">15</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ncol</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>y </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span>