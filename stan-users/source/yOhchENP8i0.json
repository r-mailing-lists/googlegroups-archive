amily:&#39;courier new&#39;,monospace\">                S2 &lt;- (j-1) * 0.1;<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                uhat[k] &lt;- 0;<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                uhat[k+66] &lt;- 0;<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                for (n in 1:dtsteps){<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                    uhat[k] &lt;- uhat[k] + dt * gain(cs1,cs2,cs3,cs4,cs0,inhibition(S1,S2,A1,B1,B2,G1,G2,uhat[k],uhat[k+66]));<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                    uhat[k + 66] &lt;- uhat[k+66] + dt * gain(cs1,cs2,cs3,cs4,cs0,inhibition(S2,S1,A1,B1,B2,G1,G2,uhat[k+66],uhat[k]));<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                    }<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                k &lt;- k + 1;<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                <b>print(uhat);<br></b></span><span style=\"font-family:&#39;courier new&#39;,monospace\">                }<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">    for (n in 1:N){<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">        y[n] ~ normal(uhat[n],0.01);<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">        }<br></span><span style=\"font-family:&#39;courier new&#39;,monospace\">    }<br></span><font face=\"courier new, monospace\">&quot;</font></blockquote><div> </div><div>things work. However, if I write <font face=\"courier new, monospace\">print(&quot;uhat = &quot;,uhat);</font>, I get this error message:</div><div><br></div><div><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-color:rgb(204,204,204);border-left-style:solid;padding-left:1ex\"><font face=\"courier new, monospace\">Er