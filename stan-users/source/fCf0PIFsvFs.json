(prior_alpha[k] &gt; prior_alpha[k-1]) { // \r<br>&gt;         flag &lt;- 1;\r<br>&gt;       }\r<br>&gt;     }\r<br>&gt;     if (flag == 1) {\r<br>&gt;       increment_log_prob(negative_infinity());\r<br>&gt;     } else {\r<br>&gt;       increment_log_prob(log_sum_exp(gamma[T_unsup]));\r<br>&gt;     }\r<br>&gt;   }\r<br>&gt; }\r<br>\r<br>"
