     "<div style=\"word-wrap:break-word\"><div><div><blockquote type=\"cite\"><div><div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><span style=\"color:#660\">&gt;</span> fit <span style=\"color:#660\">&lt;-</span> read_stan_csv<span style=\"color:#660\">(</span>file<span style=\"color:#660\">.</span>choose<span style=\"color:#660\">())</span><br><span style=\"color:#606\">Error</span> <span style=\"color:#008\">in</span> <span style=\"color:#080\">`[.data.frame`</span><span style=\"color:#660\">(</span>df<span style=\"color:#660\">,</span> c<span style=\"color:#660\">(</span>paridx<span style=\"color:#660\">,</span> lp__idx<span style=\"color:#660\">)[</span>midx<span style=\"color:#660\">])</span> <span style=\"color:#660\">:</span> <br>  <span style=\"color:#008\">undefined</span> columns selected<br><span style=\"color:#606\">In</span> addition<span style=\"color:#660\">:</span> <span style=\"color:#606\">Warning</span> messages<span style=\"color:#660\">:</span><br><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span> <span style=\"color:#606\">In</span> readLines<span style=\"color:#660\">(</span>con<span style=\"color:#660\">,</span> n <span style=\"color:#660\">=</span> <span style=\"color:#066\">1</span><span style=\"color:#660\">)</span> <span style=\"color:#660\">:</span><br>  incomplete <span style=\"color:#008\">final</span> line found on <span style=\"color:#080\">&#39;C:/....blah...&#39;</span><br><span style=\"color:#066\">2</span><span style=\"color:#660\">:</span> <span style=\"color:#606\">In</span> FUN<span style=\"color:#660\">(</span>X<span style=\"color:#660\">[[</span>i<span style=\"color:#660\">]],</span> <span style=\"color:#660\">...)</span> <span style=\"color:#660\">:</span> line <span style=\"color:#008\">with</span> <span style=\"color:#080\">&quot;Elapsed Time&quot;</span> <span style=\"color:#008\">not</span>