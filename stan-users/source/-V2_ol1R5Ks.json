     "<div dir=\"ltr\">You could try something like this:<br><br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">parameters</span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  ordered</span><span style=\"color:#660\">[</span><span style=\"color:#000\">D</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> raw_mu1</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  positive_ordered</span><span style=\"color:#660\">[</span><span style=\"color:#000\">D</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> raw_mu2</span><span style=\"color:#660\">[</span><span style=\"color:#000\">K</span><span style=\"color:#660\">-</span><span style=\"color:#066\">1</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>transformed parameters</span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  vector</span><span style=\"color:#660\">[</span><span style=\"color:#000\">D</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> mu</span><span style=\"color:#660\">[</span><span style=\"color:#000\">K</span><span style=\"color:#660\">];</span><span style=\"color:#000\"> </span><span style=\"color:#800\">// This could also be matrix[K,D]</span><span style=\"color:#000\"><br>  mu</span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> raw_mu1</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">i </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:(</span><span style=\"color:#000\">K</span><span style=\"color:#660\">-</span><span style=\"color:#066\">1</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>    mu</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">+</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> mu</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> raw_mu2</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span></div></code></div></div>"
