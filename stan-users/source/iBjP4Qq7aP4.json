/span><span style=\"color:#660\">)</span><span style=\"color:#000\">$mtime</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">  mtime </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       mtime</span><span style=\"color:#660\">.</span><span style=\"color:#000\">rda </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#606\">POSIXct</span><span style=\"color:#660\">(</span><span style=\"color:#000\">packageDescription</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;rstan&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\">$Date</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       mtime</span><span style=\"color:#660\">.</span><span style=\"color:#000\">rda </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> rstan_load_time </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       </span><span style=\"color:#660\">!</span><span style=\"color:#008\">is</span><span style=\"color:#660\">(</span><span style=\"color:#000\">obj </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> readRDS</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file</span><span style=\"color:#660\">.</span><span style=\"color:#000\">rda</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;stanmodel&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       </span><span style=\"color:#660\">!</span><span style=\"color:#000\">is_sm_valid</span><span style=\"color:#660\">(</span><span style=\"color:#000\">obj</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       </span><span style=\"color:#660\">!</span><span style=\"color:#008\">is</span><span style=\"color:#660\">.</span><span style=\"color:#008\">null</span><span style=\"color:#660\">(</span><span style=\"color:#000\">writeLines</span><span style=\"color:#660\">(</span><span style=\"color:#000\">obj@model_code</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> con </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> tf </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> tempfile</span><span style=\"color:#660\">()))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">||</span><span style=\"color:#000\"><br>       md5 </span><span style=\"color:#660\">!=</span><span style=\"color:#000\"> tools</span><span style=\"color:#660\">::</span><span style=\"color:#000\">md5sum</span><span style=\"color:#660\">(</span><span style=\"color:#000\">tf</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>         </span><span style=\"color:#800\"># do nothing</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">else</span><span style=\"color:#000\"> </span><span style=\"color:#008\">return</span><span style=\"color:#660\">(</span><span style=\"color:#000\">invisible</span><span style=\"color:#660\">(</span><span style=\"color:#000\">obj</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br></span></div></code></div><br>is unexpectedly failing.<br><br>Ben<br><div dir=\"ltr\"><div> </div></div></div></div></blockquote></div>"
