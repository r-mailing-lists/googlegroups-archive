     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\">You need to restrict the range of tau:<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">data </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  </span><span style=\"color:#008\">int</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> N</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  vector</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">&gt;[</span><span style=\"color:#000\">N</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> y</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>transformed data </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  real</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> min_y</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  min_y </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> min</span><span style=\"color:#660\">(</span><span style=\"color:#000\">y</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>parameters </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  real</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\">upper</span><span style=\"color:#660\">=</span><span style=\"color:#066\">10</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#008\">lambda</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  real</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">lower</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\">upper</span><span style=\"color:#660\">=</span><span style=\"color:#000\">min_y</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> tau</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>model </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">// ignore parser message about Jacobian adjustment</span><span style=\"color:#000\"><br>  y </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> tau </span><span style=\"color:#660\">~</span><span style=\"color:#000\"> exponential</span><span style=\"color:#660\">(</span><span style=\"color:#008\">lambda</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span><font color=\"#888888\"><span style=\"color:#000\"><br></span></font></span></div></code></div><span><font color=\"#888888\"><br>Ben<br><br></font></span></div></blockquote></div></div>"
