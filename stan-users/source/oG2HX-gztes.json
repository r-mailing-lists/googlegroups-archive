e=\"color:#000\">I</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> B</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  matrix</span><span style=\"color:#660\">[</span><span style=\"color:#000\">K</span><span style=\"color:#660\">,</span><span style=\"color:#000\">K</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> sig_inv</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  matrix</span><span style=\"color:#660\">[</span><span style=\"color:#000\">K</span><span style=\"color:#660\">*</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#000\">K</span><span style=\"color:#660\">*</span><span style=\"color:#000\">T</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> first_product</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  real log_rho</span><span style=\"color:#660\">[</span><span style=\"color:#000\">J</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br>  vector</span><span style=\"color:#660\">[</span><span style=\"color:#000\">I</span><span style=\"color:#660\">*</span><span style=\"color:#000\">T</span><span style=\"color:#660\">*</span><span style=\"color:#000\">K</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> log_possion_mean</span><span style=\"color:#660\">[</span><span style=\"color:#000\">J</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br>  vector</span><span style=\"color:#660\">[</span><span style=\"color:#000\">I</span><span style=\"color:#660\">*</span><span style=\"color:#000\">T</span><span style=\"color:#660\">*</span><span style=\"color:#000\">K</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> vec_Z</span><span style=\"color:#660\">[</span><span style=\"color:#000\">J</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br>  vector</span><span style=\"color:#660\">[</span><span style=\"color:#000\">I</span><span style=\"color:#660\">*</span><span style=\"color:#000\">T</span><span style=\"color:#660\">*</span><span style=\"color:#000\">K</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> vec_V</span><span style=\"color:#660\">[</span><span style=\"color:#000\">J</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">//manually calculate the inverse of 2 by 2 matrix sig_inv as follows:</span><span style=\"color:#000\"><br>  real dinominator</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>  </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">j </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\">J</span><span style=\"color:#660\">){</span><span style=\"color:#000\"><br>    vec_Z</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> to_vector</span><span style=\"color:#660\">(</span><span style=\"color:#000\">Z</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]);</span><span style=\"color:#000\"><br>    vec_V</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> to_vector</span><span style=\"color:#660\">(</span><span style=\"color:#000\">V</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]);</span><span style=\"color:#000\"><br>    log_possion_mean</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> log</span><span style=\"color:#660\">(</span><span style=\"color:#000\">n</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">])+</span><span style=\"color:#000\">vec_V</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br>    B </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">  </span><span style=\"color:#606\">Identity</span><span style=\"color:#000\"> </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> rho</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">]*</span><span style=\"color:#606\">Cmatrix</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>    dinominator </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> SIGMA</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">][</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]*</span><span style=\"color:#000\">SIGMA</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">][</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> SIGMA</span><span style=\"color:#660\">[</span><span style=\"color:#000\">j</span><span style=\"color:#660\">][</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">2</span><span style=\"color:#660\">]^</span><span style=\"color:#066\">2</span><span style=\"color:#660\">;</span><span style=\"color