 in 1:n) {<br>      norm_data[i] ~ normal(m, sd);<br>    }<br>  }<br>&#39;</span><span><br>fit </span><span style=\"color:#660\">&lt;-</span><span> stan</span><span style=\"color:#660\">(</span><span>model_code </span><span style=\"color:#660\">=</span><span> norm_model1</span><span style=\"color:#660\">,</span><span> data </span><span style=\"color:#660\">=</span><span> data_list</span><span style=\"color:#660\">,</span><span> iter </span><span style=\"color:#660\">=</span><span> </span><span style=\"color:#066\">1000</span><span style=\"color:#660\">,</span><span> chains </span><span style=\"color:#660\">=</span><span> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span> seed</span><span style=\"color:#660\">=</span><span>seed</span><span style=\"color:#660\">)</span><span><br>\r\nsamples </span><span style=\"color:#660\">&lt;-</span><span> extract</span><span style=\"color:#660\">(</span><span>fit</span><span style=\"color:#660\">,</span><span> permute</span><span style=\"color:#660\">=</span><span>T</span><span style=\"color:#660\">)</span><span><br>\r\nsum</span><span style=\"color:#660\">(</span><span style=\"color:#008\">is</span><span style=\"color:#660\">.</span><span>na</span><span style=\"color:#660\">(</span><span>samples$lp__</span><span style=\"color:#660\">[</span><span style=\"color:#066\">1001</span><span style=\"color:#660\">:</span><span style=\"color:#066\">2000</span><span style=\"color:#660\">]))</span><span><br>\r\n<br></span><span style=\"color:#800\">## 1000</span><span><br></span></div></code></div><br>While if I change the prior on m from m ~ uniform(0, 10) to m ~ uniform(-10, 10) everything runs fine:<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\">\r\n<code><div><span>norm_model2 </span><span style=\"color:#660\">&lt;-</span><span> </span><span style=\"color:#080\">&#39;<br>  data {<br>    int&lt;lower=1&gt; n;<br>    real norm_data[n];<br>  }<br><br>  parameters {<br>\r\n    real m;<br>    real&lt;lower=0&gt; sd;<br>  }<br><br>  model {<br>    sd ~ uniform(0, 10);<br>    m ~ uniform(-10, 10);<br>    for(i in 1:n) {<br>      norm_data[i] ~ normal(m, sd);<br>    }<br>  }<br>&#39;</span><span><br>\r\nstan</span><span style=\"color:#660\">(</span><span>model_code </span><span style=\"color:#660\">=</span><span> norm_model2</span><span style=\"color:#660\">,</span><span> data </span><span style=\"color:#660\">=</span><span> data_list</span><span style=\"color:#660\">,</span><span> iter </span><span style=\"color:#660\">=</span><span> </span><span style=\"color:#066\">1000</span><span style=\"color:#660\">,</span><span> chains </span><span style=\"color:#660\">=</span><span> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span> seed</span><span style=\"color:#660\">=</span><span>seed</span><span style=\"color:#660\">)</span><span><br>\r\n<br></span><span style=\"color:#800\">## TRANSLATING MODEL &#39;norm_model2&#39; FROM Stan CODE TO C++ CODE NOW.</span><span><br></span><span><code><span style=\"color:#800\">## </span><span style=\"color:#800\"></span></code>COMPILING THE C</span><span style=\"color:#660\">++</span><span> CODE FOR MODEL </span><span style=\"color:#080\">&#39;norm_model2&#39;</span><span> NOW</span><span style=\"color:#660\">.</span><span><br>\r\n</span><span><code><span style=\"color:#800\">## </span><span style=\"color:#800\"></span></code>SAMPLING FOR MODEL </span><span style=\"color:#080\">&#39;norm_model2&#39;</span><span> NOW </span><span style=\"color:#660\">(</span><span>CHAIN </span><span style=\"color:#066\">1</span><span style=\"color:#660\">).</span><span><br>\r\n</span><span style=\"color:#606\"><code><span style=\"color:#800\">## </span><span style=\"color:#800\"></span></code>Iteration</span><span style=\"color:#660\">:</span><span>   </span><span style=\"color:#066\">1</span><span> </span><span style=\"color:#660\">/<