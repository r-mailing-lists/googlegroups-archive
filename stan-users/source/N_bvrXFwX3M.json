e),<br>                          log1m(p[2]) + exponential_lccdf(1|rate));<br><br><br>  for(i in 1:N_obs)<br>    target += log_sum_exp(log(p[1]) + (y_obs[i] &lt;= 1) + exponential_lpdf(y_obs[i]|rate),<br>                            log(p[2]) + (y_obs[i] &gt; 1) + exponential_lpdf(y_obs[i]|rate));<br>}<br>&quot;</span><span style=\"color:#000\"><br><br><br>dat </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">N_obs </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> sum</span><span style=\"color:#660\">(</span><span style=\"color:#000\">z </span><span style=\"color:#660\">!=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>           N_mis </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> sum</span><span style=\"color:#660\">(</span><span style=\"color:#000\">z </span><span style=\"color:#660\">==</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>           y_obs </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> z</span><span style=\"color:#660\">[</span><span style=\"color:#000\">z </span><span style=\"color:#660\">!=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">])</span><span style=\"color:#000\"><br><br><br>stan_POC </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> stan</span><span style=\"color:#660\">(</span><span style=\"color:#000\">model_code </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> stan_proof_of_concept</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> dat</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> pars </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;rate&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;p&quot;</span><span style=\"color:#660\">))</span></div></code></div><div><br></div></div><div>The model runs, but I am not able to successfully retrieve the simulated values. Am I simply asking for something with discrete parameters that Stan can&#39;t do? Did I screw up up with marginalizing? Coding problem? In short, what am I missing here?</div><div><br></div><div>This is a proof of concept for a much harder problem with tens of thousands of observations. JAGS takes far too long with this dataset.</div></div></blockquote></div></div></div></div></blockquote></div></div>"
