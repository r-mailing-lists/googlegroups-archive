an><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">p </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#000\"> </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> p</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> tau</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">./</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#066\">2</span><span style=\"color:#000\"> </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> w</span><span style=\"color:#660\">);</span></div></code></div></div>"
