00\">dist</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#800\">#View(dist1)</span><span style=\"color:#000\"><br>hc </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> hclust</span><span style=\"color:#660\">(</span><span style=\"color:#000\">dist1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>den </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">dendrogram</span><span style=\"color:#660\">(</span><span style=\"color:#000\">hc</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>p </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ggtree</span><span style=\"color:#660\">(</span><span style=\"color:#000\">den</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>mytable </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> mytable </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> read</span><span style=\"color:#660\">.</span><span style=\"color:#000\">csv</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;table.csv&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> header </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> T</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> row</span><span style=\"color:#660\">.</span><span style=\"color:#000\">names </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>gheatmap</span><span style=\"color:#660\">(</span><span style=\"color:#000\">p</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> mytable</span><span style=\"color:#660\">,</span><span style=\"color:#00