reen&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> high </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;red&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> color </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;white&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         offset </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">.</span><span style=\"color:#066\">03</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         </span><span style=\"color:#800\">#font.size=2,</span><span style=\"color:#000\"><br>         colnames_angle</span><span style=\"color:#660\">=-</span><span style=\"color:#066\">15</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         hjust</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         colnames_position </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bottom&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> colnames_offset_y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"><br>  geom_tiplab</span><span style=\"color:#660\">(</span><span style=\"color:#000\">size </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> <br><br></span></div></code></div><br></div><div>Any idea, how to increase the space available for the column names?</div><div><br