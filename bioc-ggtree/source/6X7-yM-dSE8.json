pan><span style=\"color:rgb(221,17,68);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap\"><span style=\"color:#080\">&quot;length_0.95_HPD&quot;</span></span><span style=\"color:rgb(17,17,17);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap;background-color:rgb(248,248,248)\"><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span></span><span style=\"color:rgb(0,0,0);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap\"><span style=\"color:#000\">branch</span><span style=\"color:#660\">.</span><span style=\"color:#000\">length</span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap\"><span style=\"color:#660\">=</span></span><span style=\"color:rgb(221,17,68);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap\"><span style=\"color:#080\">&quot;none&quot;</span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap\"><span style=\"color:#660\">)</span></span><span style=\"color:rgb(17,17,17);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans Mono&quot;,&quot;Lucida Console&quot;,Consolas,Monaco,monospace;font-size:11.96px;white-space:pre-wrap;background-color:rgb(248,248,248)\"><span style=\"color:#000\"> </span></span><span style=\"color:rgb(104,118,135);font-family:&quot;DejaVu Sans Mono&quot;,&quot;Droid Sans