olor:rgb(167,29,93)\">ggtree</span>(tr)\r\n\r\np2 &lt;-<span style=\"box-sizing:border-box;color:rgb(24,54,145)\"> </span><span style=\"box-sizing:border-box;color:rgb(167,29,93)\">facet_plot</span>(p, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">panel=</span><span style=\"box-sizing:border-box;color:rgb(24,54,145)\">&quot;dot&quot;</span>, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">data=</span>d1, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">geom=</span>geom_point, <span style=\"box-sizing:border-box;color:rgb(167,29,93)\">aes</span>(<span style=\"box-sizing:border-box;color:rgb(121,93,163)\">x=</span>val), <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">color=</span><span style=\"box-sizing:border-box;color:rgb(24,54,145)\">&#39;firebrick&#39;</span>)\r\nd2 &lt;-<span style=\"box-sizing:border-box;color:rgb(24,54,145)\"> </span><span style=\"box-sizing:border-box;color:rgb(167,29,93)\">data.frame</span>(<span style=\"box-sizing:border-box;color:rgb(121,93,163)\">id=</span>tr$tip.label, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">value =</span> <span style=\"box-sizing:border-box;color:rgb(167,29,93)\">abs</span>(<span style=\"box-sizing:border-box;color:rgb(167,29,93)\">rnorm</span>(<span style=\"box-sizing:border-box;color:rgb(0,134,179)\">30</span>, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">mean=</span><span style=\"box-sizing:border-box;color:rgb(0,134,179)\">100</span>, <span style=\"box-sizing:border-box;color:rgb(121,93,163)\">sd=</span><span style=\"box-sizing:border-box;color:rgb(0,134,179)\">50</span>)))</code></pre></div><div style=\"font-family:arial,sans-serif;font-size:19.2px\"><span style=\"color:rgb(0,0,0)\"><font size=\"1\" face=\"arial, helvetica, sans-serif\"><br></font></span></div><div style=\"font-family:arial,sans-serif;font-size:19.2px\"><span style=\"color:rgb(0,0,0)\"><font size=\"1\" face=\"arial, helvetica, sans-serif\">Rad package,</font></span>