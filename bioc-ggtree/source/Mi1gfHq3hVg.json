     "<div dir=\"ltr\"><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><pre></pre><div><pre style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;font-size:1em;line-height:1.2em;margin:1.2em 0px\"><code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline;white-space:pre;overflow:auto;border-radius:3px;border:1px solid rgb(204,204,204);padding:0.5em 0.7em;display:block!important;display:block;overflow-x:auto;padding:0.5em;color:rgb(51,51,51);background:rgb(248,248,248) none repeat scroll 0% 0%\">\r\n<span style=\"color:rgb(51,51,51);font-weight:bold\">library</span>(ggtree)\r\ntr &lt;- rtree(<span style=\"color:rgb(0,128,128)\">30</span>) <br>p &lt;- ggtree(tr)\r\n\r\n<span style=\"color:rgb(51,51,51);font-weight:bold\">library</span>(ggstance) <br>d3 &lt;- data.frame(id = rep(tr$tip.label, each=<span style=\"color:rgb(0,128,128)\">2</span>),<br>                 value = abs(rnorm(<span style=\"color:rgb(0,128,128)\">60</span>, mean=<span style=\"color:rgb(0,128,128)\">100</span>, sd=<span style=\"color:rgb(0,128,128)\">50</span>)),<br>                 category = rep(LETTERS[<span style=\"color:rgb(0,128,128)\">1</span>:<span style=\"color:rgb(0,128,128)\">2</span>], <span style=\"color:rgb(0,128,128)\">30</span>))<br> <br>p2 &lt;- facet_plot(p, panel = <span style=\"color:rgb(221,17,68)\">&#39;Stacked Barplot&#39;</span>, data = d3,<br>                 geom = geom_barh,<br>                 mapping = aes(x = value, fill = as.factor(category)),<br>                 stat=<span style=\"color:rgb(221,17,68)\">&#39;identity&#39;</span> ) <br>\r\np2 + scale_fill_manual(values=c(A=<span style=\"color:rgb(221,17,68)\">&#39;blue&#39;</span>, B=<span style=\"color:rgb(221,17,68)\">&#39;red&#39;</span>))\r\n</code></pre>\r\n<div title=\"MDH:PHByZT5gYGByPGJyPjwvcHJlPjxwcmU+bGlicmFyeShnZ3RyZWUpPGJyPjxjb2RlIGNsYXNzPSJn\r\nbWFpbC1obGpzIGdtYWlsLXBlcmwiPjxjb2RlIGNsYXNzPSJnbWFpbC1obGpzIGdtYWlsLXBlcmwi\r\nPjxjb2RlIGNsYXNzPSJnbWFpbC1obGpzIGdtYWlsLWphdmFzY3JpcHQiPnRyICZsdDstIHJ0cmVl\r\nKDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLW51bWJlciI+MzA8L3NwYW4+KQpwICZsdDstIGdndHJl\r\nZSh0cik8L2NvZGU+PGJyPjxicj5saWJyYXJ5KGdnc3RhbmNlKQpkMyAmbHQ7LSBkYXRhLmZyYW1l\r\nKGlkID0gcmVwKDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLWtleXdvcmQiPnRyPC9zcGFuPiR0aXAu\r\nbGFiZWwsIDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLWtleXdvcmQiPmVhY2g8L3NwYW4+PTxzcGFu\r\nIGNsYXNzPSJnbWFpbC1obGpzLW51bWJlciI+Mjwvc3Bhbj4pLAogICAgICAgICAgICAgICAgICAg\r\nIHZhbHVlID0gPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMta2V5d29yZCI+YWJzPC9zcGFuPihybm9y\r\nbSg8c3BhbiBjbGFzcz0iZ21haWwtaGxqcy1udW1iZXIiPjYwPC9zcGFuPiwgbWVhbj08c3BhbiBj\r\nbGFzcz0iZ21haWwtaGxqcy1udW1iZXIiPjEwMDwvc3Bhbj4sIHNkPTxzcGFuIGNsYXNzPSJnbWFp\r\nbC1obGpzLW51bWJlciI+NTA8L3NwYW4+KSksCiAgICAgICAgICAgICAgICAgICAgY2F0ZWdvcnkg\r\nPSByZXAoTEVUVEVSU1s8c3BhbiBjbGFzcz0iZ21haWwtaGxqcy1udW1iZXIiPjE8L3NwYW4+Ojxz\r\ncGFuIGNsYXNzPSJnbWFpbC1obGpzLW51bWJlciI+Mjwvc3Bhbj5dLCA8c3BhbiBjbGFzcz0iZ21h\r\naWwtaGxqcy1udW1iZXIiPjMwPC9zcGFuPikpPC9jb2RlPjxicj5wMiAmbHQ7LSBmYWNldF9wbG90\r\nKHAsIHBhbmVsID0gPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMtc3RyaW5nIj4nU3RhY2tlZCBCYXJw\r\nbG90Jzwvc3Bhbj4sIGRhdGEgPSBkMywgCiAgICAgICAgICAgICAgICBnZW9tID0gZ2VvbV9iYXJo\r\nLCAKICAgICAgICAgICAgICAgIG1hcHBpbmcgPSBhZXMoPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMt\r\na2V5d29yZCI+eDwvc3Bhbj4gPSB2YWx1ZSwgZmlsbCA9IGFzLmZhY3RvcihjYXRlZ29yeSkpLCAK\r\nICAgICAgICAgICAgICAgIDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLWtleXdvcmQiPnN0YXQ8L3Nw\r\nYW4+PTxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLXN0cmluZyI+J2lkZW50aXR5Jzwvc3Bhbj4gKSA8\r\nYnI+cDIgKyBzY2FsZV9maWxsX21hbnVhbCh2YWx1ZXM9YyhBPSdibHVlJywgQj0ncmVkJykpPGJy\r\nPjwvY29kZT48L3ByZT48ZGl2IGNsYXNzPSJnbWFpbF9leHRyYSI+PGJyPjxkaXYgY2xhc3M9Imdt\r\nYWlsX3F1b3RlIj5gYGA8L2Rpdj48L2Rpdj4=\" style=\"min-height:0;width:0;max-height:0;max-width:0;overflow:hidden;f