\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>ID </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;A1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A4&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A5&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A6&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A7&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A8&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;A9&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Boat</span><span style=\"color:#000\">  </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Green, Blue&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Green&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Blue&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Pink, Blue, Green&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Blue&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Blue, Green&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Pink&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Green&quot;</span><span style=\"color:#660