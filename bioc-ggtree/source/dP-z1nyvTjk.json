,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;,&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  unnest_longer</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Color</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  filter</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Color</span><span style=\"color:#000\"> </span><span style=\"color:#660\">!=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">)</span></div></code></div><div><br></div><div><br></div><div><br></div><div>And this is the outcome using _**ggplot2**_</div><div><br></div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#000\"><br><br>ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">df</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Color</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y</span><span style=\"color:#660\">=</span><span style=\"color:#000\">ID</span><span style=\"color:#660\">))+</span><span style=\"color:#000\"> </span><span style=\"color:#800\">#, alpha = Count)) + </span><span style=\"color:#000\"><br>  geom_tile</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fill</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Vehicle</span><span style=\"color:#660\">),</span><span style=\"color:#000\">colour</span><span style=\"color:#660\">=</span><span styl