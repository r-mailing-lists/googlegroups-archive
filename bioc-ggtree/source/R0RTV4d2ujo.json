u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><span>   </span>chain&lt;-hc[x]<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><span>   </span>hc_cls[[chain]] &lt;-\r\nlapply(select(filter(annot,HCfam==chain),XPA),as.character)$XPA<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">}<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">tree &lt;- groupOTU(tree,\r\nhc_cls)<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">heatdata &lt;-\r\nread_tsv(&quot;ggtree_test_annotation.txt&quot;,col_names=c(&quot;XPA&quot;,&quot;HCfam&quot;))<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">p&lt;-ggtree(tree,\r\naes(color=group)) + <u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><span>     </span>geom_tiplab(size=3) + <u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><span>    \r\n</span>scale_color_manual(values=c(&quot;black&quot;, rainbow_hcl(length(hc))),\r\nlabels=c(hc), name=&quot;Heavy Chain Family&quot;) + <u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><span>     </span>theme(legend.position=&quot;left&quot;,\r\nlegend.key=element_rect(color=&quot;White&quot;))<u></u><u></u></span></p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p><p class=\"MsoNormal\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n</p><p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">gheatma