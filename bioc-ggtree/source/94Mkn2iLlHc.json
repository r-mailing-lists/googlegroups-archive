an><span style=\"color:rgb(0,0,0)\"><br><br>ggtr3</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> revts</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">ggtr3</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"><br><br>ggtr3</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,102,102)\">2</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> ggtr3</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">+</span><span style=\"color:rgb(0,0,0)\">  theme_tree2</span><span style=\"color:rgb(102,102,0)\">()</span><span style=\"color:rgb(0,0,0)\">  </span><span style=\"color:rgb(102,102,0)\">+</span><span style=\"color:rgb(0,0,0)\">   geom_range</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">range</span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,136,0)\">&#39;height_0.95_HPD&#39;</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> color</span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,136,0)\">&#39;red&#39;</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> alpha</span><span style=\"color:rgb(102,102,0)\">=.</span><span style=\"color:rgb(0,102,102)\">3</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> branch</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">length</span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,136,0)\">&quot;height&quot;</span><span style=\"color:rgb(10