  {
   "id": "j5oWWeG_BwAJ",
   "from": "Xiaowei Zhan",
   "author": "e2ad330e3f95f813",
   "date": "2018-07-24T05:54:28Z",
   "subject": "Re: How to remove NA in the legend?",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">Your solution works now:<div><br></div><div>Use: </div><div><br><div><div>p + theme(legend.position=&quot;right&quot;) + scale_color_manual(values = c(&quot;red&quot;, &quot;blue&quot;, &quot;green&quot;), breaks=c(&quot;CZ&quot;, &quot;GZ&quot;, &quot;HK&quot;)) + scale_shape_manual(values = seq(3), breaks=c(&quot;CZ&quot;, &quot;GZ&quot;, &quot;HK&quot;))</div></div><div><br></div><div>Instead of:</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div>p + theme(legend.position=&quot;right&quot;)<br></div><div><br></div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div>Thanks. <br></div><div><br clear=\"all\"><div><div dir=\"ltr\" class=\"gmail_signature\"><div dir=\"ltr\"><div>Best,</div><div>Xiaowei</div></div></div></div><br></div></div></div><br><div class=\"gmail_quote\"></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\">On Mon, Jul 23, 2018 at 11:26 PM Yu, Guangchuang &lt;<a href data-email-masked rel=\"nofollow\">gc...@connect.hku.hk</a>&gt; wrote:<br></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\">use `scale_color_manual` to set the `breaks` that exclude `NA`.</div></blockquote></div>"
