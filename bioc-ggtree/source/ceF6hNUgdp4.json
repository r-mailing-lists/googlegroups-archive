n><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"><br>  geom_tippoint</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">size</span><span style=\"color:#660\">=</span><span style=\"color:#000\">value</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> shape</span><span style=\"color:#660\">=</span><span style=\"color:#000\">place</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> color</span><span style=\"color:#660\">=</span><span style=\"color:#000\">place</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> alpha</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0.25</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>p </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> theme</span><span style=\"color:#660\">(</span><span style=\"color:#000\">legend</span><span style=\"color:#660\">.</span><span style=\"color:#000\">position</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;right&quot;</span><span style=\"color:#660\">)</span><span><font color=\"#888888\"><span style=\"color:#000\"><br><br></span></font></span></div></code></div><span><font color=\"#888888\"><div><br></div><div><br><br></div></font></span></div></blockquote></div></div>"
