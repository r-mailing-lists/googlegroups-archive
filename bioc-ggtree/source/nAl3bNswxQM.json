  {
   "id": "Te4UQLouBwAJ",
   "from": "Yu, Guangchuang",
   "author": "cec41188340e8212",
   "date": "2018-09-10T10:18:18Z",
   "subject": "Re: how to set x axis limits and title for the tree panel ?",
   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div><p style=\"margin:0px 0px 1.2em!important\">using <code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline\">ggtree</code> v &gt;= 1.13.4, we can use <code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline\">facet_labeller</code> to label facet panels.</p>\r\n<pre style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;font-size:1em;line-height:1.2em;margin:1.2em 0px\"><code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline;white-space:pre;overflow:auto;border-radius:3px;border:1px solid rgb(204,204,204);padding:0.5em 0.7em;display:block!important;display:block;overflow-x:auto;padding:0.5em;color:rgb(51,51,51);background:rgb(248,248,248) none repeat scroll 0% 0%\">library(ggtree)\r\ntr &lt;- rtree(<span style=\"color:rgb(0,128,128)\">30</span>) <br>p &lt;- ggtree(tr) <br>d1 &lt;- data.frame(id=tr$tip.label, location=sample(c(<span style=\"color:rgb(221,17,68)\">&quot;GZ&quot;</span>, <span style=\"color:rgb(221,17,68)\">&quot;HK&quot;</span>, <span style=\"color:rgb(221,17,68)\">&quot;CZ&quot;</span>), <span style=\"color:rgb(0,128,128)\">30</span>, replace=<span>TRUE</span>)) <br>p1 &lt;- p %&lt;+% d1 + geom_tippoint(aes(color=location)) <br>d2 &lt;- data.frame(id=tr$tip.label, val=rnorm(<span style=\"color:rgb(0,128,128)\">30</span>, sd=<span style=\"color:rgb(0,128,128)\">3</span>)) <br>p2 &lt;- facet_plot(p1, panel=<span style=\"color:rgb(221,17,68)\">&quot;dot&quot;</span>, data=d2, geom=geom_point,<br> aes(x=val), color=<span style=\"color:rgb(221,17,68)\">&#39;firebrick&#39;</span>) + theme_tree2()\r\n\r\nlbs &lt;- c(Tree = <span style=\"color:rgb(221,17,68)\">&quot;tree panel&quot;</span>, dot = <span style=\"color:rgb(221,17,68)\">&quot;dot panel&quot;</span>)\r\nfacet_labeller(p2, lbs)\r\n</code></pre>\r\n<div title=\"MDH:PGRpdiBkaXI9Imx0ciI+PGRpdj51c2luZyBgZ2d0cmVlYCB2ICZndDs9IDEuMTMuNCwgd2UgY2Fu\r\nIHVzZSBgZmFjZXRfbGFiZWxsZXJgIHRvIGxhYmVsIGZhY2V0IHBhbmVscy48L2Rpdj48ZGl2Pjxi\r\ncj48L2Rpdj48ZGl2PmBgYHI8L2Rpdj48ZGl2PjxwcmU+PGNvZGUgY2xhc3M9ImdtYWlsLWhsanMg\r\nZ21haWwtamF2YXNjcmlwdCI+dHIgJmx0Oy0gcnRyZWUoPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMt\r\nbnVtYmVyIj4zMDwvc3Bhbj4pCnAgJmx0Oy0gZ2d0cmVlKHRyKQpkMSAmbHQ7LSBkYXRhLmZyYW1l\r\nKGlkPXRyJHRpcC5sYWJlbCwgbG9jYXRpb249c2FtcGxlKGMoPHNwYW4gY2xhc3M9ImdtYWlsLWhs\r\nanMtc3RyaW5nIj4iR1oiPC9zcGFuPiwgPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMtc3RyaW5nIj4i\r\nSEsiPC9zcGFuPiwgPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMtc3RyaW5nIj4iQ1oiPC9zcGFuPiks\r\nIDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLW51bWJlciI+MzA8L3NwYW4+LCByZXBsYWNlPVRSVUUp\r\nKQpwMSAmbHQ7LSBwICU8c3BhbiBjbGFzcz0iZ21haWwteG1sIj48c3BhbiBjbGFzcz0iZ21haWwt\r\naGxqcy10YWciPiZsdDs8c3BhbiBjbGFzcz0iZ21haWwtaGxqcy1uYW1lIj4rJTwvc3Bhbj4gPHNw\r\nYW4gY2xhc3M9ImdtYWlsLWhsanMtYXR0ciI+ZDE8L3NwYW4+ICsgPHNwYW4gY2xhc3M9ImdtYWls\r\nLWhsanMtYXR0ciI+Z2VvbV90aXBwb2ludDwvc3Bhbj4oPHNwYW4gY2xhc3M9ImdtYWlsLWhsanMt\r\nYXR0ciI+YWVzPC9zcGFuPig8c3BhbiBjbGFzcz0iZ21haWwtaGxqcy1hdHRyIj5jb2xvcjwvc3Bh\r\nbj49PHNwYW4gY2xhc3M9ImdtYWlsLWhsanMtc3RyaW5nIj5sb2NhdGlvbikpPC9zcGFuPgo8c3Bh\r\nbiBjbGFzcz0iZ21haWwtaGxqcy1hdHRyIj5kMjwvc3Bhbj4gJmx0OzxzcGFuIGNsYXNzPSJnbWFp\r\nbC1obGpzLWF0dHIiPi08L3NwYW4+IDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLWF0dHIiPmRhdGEu\r\nZnJhbWU8L3NwYW4+KDxzcGFuIGNsYXNzPSJnbWFpbC1obGpzLWF0dHIiPmlkPC9zcGFuPj08c3Bh\r\nbiBjbGFzcz0iZ21haWwtaGxqcy1zdHJpbmciPnRyJHRpcC5sYWJlbCw8L3NwYW4+IDxzcGFuIGNs\r\nYXNzPSJnbWFpbC1obGpzLWF0dHIiPnZhbDwvc3Bhbj49PHNwYW4gY2xhc3M9ImdtYWlsLWhsanMt\r\nc3RyaW5nIj5ybm9ybSgzMCw8L3NwYW4+IDxzcGF