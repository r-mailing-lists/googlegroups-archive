  {
   "id": "5S7UESCxAQAJ",
   "from": "gc...@connect.hku.hk",
   "author": "f0dc0fdb872722c6",
   "date": "2016-04-05T17:26:13Z",
   "subject": "Re: Rotating tip labels in fan or circle format so they are not upside down",
   "parts": [
    [
     1,
     "<div dir=\"ltr\"><span style=\"color:#061a99\">try:<br><br>ggtree(</span>fulltree<span style=\"color:#061a99\">, </span>layout<span style=\"color:#061a99\">=</span><span style=\"color:#b01600\">&quot;circular&quot;</span><span style=\"color:#061a99\">) </span>+ geom_tiplab(aes(subset=(abs(angle) &lt; 90), angle=angle)) + geom_tiplab(aes(subset=(abs(angle) &gt;= 90), angle=angle+180), hjust=1)</div>"
    ],
    [
     3,
