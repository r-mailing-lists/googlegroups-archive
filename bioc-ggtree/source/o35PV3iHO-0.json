   "date": "2016-04-05T16:41:05Z",
   "subject": "Rotating tip labels in fan or circle format so they are not upside down",
   "parts": [
    [
     1,
     "<div dir=\"ltr\"><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#Is there an easy way to make sure tip labels plot right side up with circular trees?</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#Example </p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\">require(<span style=\"color:#000000\">ape</span>)</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\">require(<span style=\"color:#000000\">ggtree</span>)</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\">require(<span style=\"color:#000000\">ggplot2</span>)</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\">set.seed(<span style=\"color:#045218\">1234</span>)</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\"><span style=\"color:#000000\">fulltree</span> &lt;- rtree(<span style=\"color:#000000\">n</span>=<span style=\"color:#045218\">50</span>, <span style=\"color:#000000\">br</span>=<span style=\"color:#c38809\">NULL</span>)</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#Plot with ggtree</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco\"><span style=\"color:#061a99\">ggtree(</span>fulltree<span style=\"color:#061a99\">, </span>layout<span style=\"color:#061a99\">=</span><span style=\"color:#b01600\">&quot;circular&quot;</span><span style=\"color:#061a99\">)+</span></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(6,26,153)\">geom_tiplab(aes(<span style=\"color:#000000\">angle</span>=<span style=\"color:#000000\">angle</span>))</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#Tip labels on the left of the circle are upside down. </p><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\"><br></p><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-idYD5ErAJN4/VwPqhKaDO1I/AAAAAAAAAX0/Kbp3Fj82fiMhSugkGYg5KY5R0pM2RZunA/s1600/Screen%2BShot%2B2016-04-05%2Bat%2B12.39.02%2BPM.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-idYD5ErAJN4/VwPqhKaDO1I/AAAAAAAAAX0/Kbp3Fj82fiMhSugkGYg5KY5R0pM2RZunA/s1600/Screen%252BShot%252B2016-04-05%252Bat%252B12.39.02%252BPM.png&amp;source=gmail&amp;ust=1792482984822000&amp;usg=AOvVaw1wr7BXM3LoWG94aczByWvd\"><img src=\"https://lh3.googleusercontent.com/-idYD5ErAJN4/VwPqhKaDO1I/AAAAAAAAAX0/Kbp3Fj82fiMhSugkGYg5KY5R0pM2RZunA/s320/Screen%2BShot%2B2016-04-05%2Bat%2B12.39.02%2BPM.png\" border=\"0\" width=\"320\" height=\"315\"></a></p><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#It would be better if they were rightside up like the default of plot.phylo</p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco\"><span style=\"color:#061a99\">plot(</span>fulltree<span style=\"color:#061a99\">,</span><span style=\"color:#b01600\"> </span>type<span style=\"color:#061a99\">=</span><span style=\"color:#b01600\">&quot;fan&quot;</span><span style=\"color:#061a99\">)</span></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(176,22,0);min-height:27px\"><br></p><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(176,22,0);min-height:27px\"><br></p><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-DPR59tvIEuQ/VwPqmUt_1AI/AAAAAAAAAX4/QJL8SjoAkbI9PsZ-nxejO9X_3sUlDnSRw/s1600/Screen%2BShot%2B2016-04-05%2Bat%2B12.39.15%2BPM.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-DPR59tvIEuQ/VwPqmUt_1AI/AAAAAAAAAX4/QJL8SjoAkbI9PsZ-nxejO9X_3sUlDnSRw/s1600/Screen%252BShot%252B2016-04-05%252Bat%252B12.39.15%252BPM.png&amp;source=gmail&amp;ust=1792482984823000&amp;usg=AOvVaw3v1Mst9dGec3oemj8RAftv\"><img src=\"https://lh3.googleusercontent.com/-DPR59tvIEuQ/VwPqmUt_1AI/AAAAAAAAAX4/QJL8SjoAkbI9PsZ-nxejO9X_3sUlDnSRw/s320/Screen%2BShot%2B2016-04-05%2Bat%2B12.39.15%2BPM.png\" border=\"0\" width=\"314\" height=\"320\"></a></p><div><br></div><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(176,22,0);min-height:27px\"><br></p><p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(176,22,0);min-height:27px\"><br></p>\r\n<p style=\"margin-left:4px;font-size:20.3px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\">#Thank you for your help!</p><div><br></div></div>"
    ]
