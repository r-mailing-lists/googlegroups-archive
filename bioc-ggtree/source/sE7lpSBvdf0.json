   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div><p style=\"margin:0px 0px 1.2em!important\">thanks for your feedback and glad it works with <code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline\">phylo4d</code>.</p>\r\n<p style=\"margin:0px 0px 1.2em!important\">The code in your first thread seems to have an issue.</p></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div>\r\n<pre style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;font-size:1em;line-height:1.2em;margin:1.2em 0px\"><code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline;white-space:pre;overflow:auto;border-radius:3px;border:1px solid rgb(204,204,204);padding:0.5em 0.7em;display:block!important\">p = p + geom_tiplab(size=3,  align=TRUE) %&lt;+% df + geom_tiplab(aes(label=label2))\r\n</code></pre></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><p style=\"margin:0px 0px 1.2em!important\">you forgot to add <b>()</b> before %&lt;+%.</p>\r\n<p style=\"margin:0px 0px 1.2em!important\">The following command should works:</p>\r\n<pre style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;font-size:1em;line-height:1.2em;margin:1.2em 0px\"><code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);background-color:rgb(248,248,248);border-radius:3px;display:inline;white-space:pre;overflow:auto;border-radius:3px;border:1px solid rgb(204,204,204);padding:0.5em 0.7em;display:block!important\">p = (p + geom_tiplab(size=3,  align=TRUE)) %&lt;+% df + geom_tiplab(aes(label=label2))\r\n</code></pre></div></div>"
    ],
    [
     3,
     "<div dir=\"ltr\"><div><p style=\"margin:0px 0px 1.2em!important\">On Fri, Feb 17, 2017 at 2:55 AM, Dana Winther &lt;<a href data-email-masked rel=\"nofollow\">alireza.k...@gmail.com</a>&gt; wrote:</p>\r\n<p style=\"margin:0px 0px 1.2em!important\"></p></div></div>"
