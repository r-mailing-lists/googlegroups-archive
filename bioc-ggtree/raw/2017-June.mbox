#You're right, I could use a relatively painless for loop like this

#First build the plot
p <- ggtree(tree2, layout="circular", aes(color=group))+
  geom_text2(aes(subset=!isTip, label=node), hjust=-.3)+
  geom_tiplab2()

for(j in 1:dim(clades)[1]){
  #Then add each clade label
  p <- p + geom_cladelabel(node=clades$Node[j], label=clades$Label[j], offset = .25)

}

#Plot the whole tree
p

