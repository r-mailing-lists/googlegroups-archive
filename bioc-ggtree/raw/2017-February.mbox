library(phylobase)

tr2 <- phylo4d(aa.tree, df)
p = ggtree::ggtree(tr2)
p = p + geom_tiplab(size=3,  align=TRUE, aes(label = label2), hjust= 0)
pp = gheatmap(p, fc.mat, offset = 1.2, width=0.5,
              color = "white", colnames_angle = 45, colnames_offset_y = -1)

p1 = pp + scale_fill_gradient(low = "black", high = "red",
            na.value = "white", trans = "log", breaks=c(0.001,0.01, 0.1, 1,10))

