Exactly what I needed! Thank you for the help!

library(devtools)
dev_mode(on = TRUE)
library(ggtree)
library(ggstance)

tr <- rtree(30)

p1 <- ggtree(tr)

d1 <- data.frame(id=tr$tip.label, value = abs(rnorm(30, mean=100, sd=50)), category = "A")
d2 <- data.frame(id=tr$tip.label, value = abs(rnorm(30, mean=100, sd=50)), category = "B")
d3 <- rbind(d1, d2)

facet_plot(p1, panel = 'Stacked Barplot', data = d3, geom = geom_barh, mapping = aes(x = value, fill = as.factor(category)), stat='identity' )

