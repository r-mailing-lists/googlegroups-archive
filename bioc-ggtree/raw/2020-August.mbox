How about plotting in this way.
This is the code
```R
trait_dat_mlg
trait_dat_mlg$trait1.s <- rescale(trait_dat_mlg$trait1)
trait_dat_mlg$trait2.s <- rescale(trait_dat_mlg$trait2) + 2
trait_dat_mlg$trait3.s <- rescale(trait_dat_mlg$trait3) + 4
trait_dat_mlg.s <- trait_dat_mlg[c(4,5,6)]

library("scales")
gheatmap(p4, trait_dat_mlg.s, width=0.5, offset = 0.1) +
  scale_fill_gradientn(colours = c("#e5f5f9","#99d8c9","#2ca25f",
                                   "white","white",
                                   "#deebf7", "#9ecae1", "#3182bd",
                                   "white","white",
                                   "#fff7bc","#fec44f","#d95f0e"),
                    values = rescale(c(seq(0,1,length.out = 3),
                                       1.000001,1.9999999,
                                       seq(2,3,length.out = 3),
                                       3.000001,3.9999999,
                                       seq(4,5,length.out = 3))),
                    breaks = c(0.5, 1,
                               2.5,3,
                               4.5,5),
                    labels = c("5.5","10   trait1",
                               "0.5","1    trait2",
                               "130","140  trait3"),
                    na.value="transparent",
                    guide = "colorbar",
                    name = ""
                    ) +
  theme(legend.position = "right")+
  guides(fill = guide_colourbar(barwidth = 0.5, barheight = 15))
```

