library(ggtree)
library(ape)

nwk <- "((((A, B), C), (D)));"
nwk.tree <- read.tree(text=nwk)

matrix(nwk.tree$tip.label)
d = fortify(nwk.tree)
d = subset(d, isTip)
with(d, label[order(y, decreasing = TTRUE)])

