Hi Ben, And thanks again!.
Here's my issue in code. Although, this may be somewhat more of an ape issue (and probably really just my misunderstanding) than a ggtree issue. Trees 1-6 end up with a trichomy (which just isn't desirable to see), but tree 7 which I opened up externally in NJPlot (etc) and rerooted and then plotted shows the desired visual output. I do really want to avoid having to open each tree first if I can just specific a known node or taxa to root on but there we go...

set.seed(1234)
tree1 <- rtree(10)
tree_one <- ggtree(tree1) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree2_root <- root(tree1, node=17, r = T)
tree2_rooted <- ggtree(tree2_root) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree3_root <- root(tree1, 6:7, r = T)
tree3_rooted <- ggtree(tree3_root) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree4_root <- root(tree1, outgroup = c("t3","t6"), resolve.root = T)
tree4_rooted <- ggtree(tree4_root) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree5_root <- reroot(tree1, node = 17)
tree5_rooted <- ggtree(tree5_root) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree1_root$root.edge <- 1
tree6_rooted <- ggtree(tree1_root) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

tree_rooted <- read.tree(file = "initial_rerooted.tree")
tree7_rooted <- ggtree(tree_rooted) + geom_tiplab() + geom_text2(aes(subset=!isTip, label=node), hjust=-.3, size=2)

multiplot(tree_one, tree2_rooted, tree3_rooted, tree4_rooted, tree5_rooted, tree6_rooted, tree7_rooted, ncol = 7)

