> pdist = dist(as.matrix(df), method = "euclidean")
>
> # Turn pairwise distance matrix into phylo via neighbour joining method
> phylo_nj <- nj(pdist)
>
> # Plotting in ggtree
> mytree <- ggtree(phylo_nj, layout="equal_angle", size=0.8, linetype=1)
> mytree
>
> # Adding metadata variables as tip points
> mytree2 <- mytree %<+% df2 + geom_tippoint(aes(color=Factor_B),
>                                            size=8,
>                                            alpha=0.8,
>                                            na.rm=TRUE)
> mytree2
>
> There should be 3 samples with no tip points using Factor_B to annotate because of the NAs, but instead these are given their own tip point colour.
>
> Thanks for your help.
> Will
>

