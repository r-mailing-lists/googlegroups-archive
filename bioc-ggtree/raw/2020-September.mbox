The margin of plot in aplot will automatically be set to zero.
I think you can use facet_grid to display the bar plot, so the distance between the barplot can be adjusted by panel.spacing or panel.spacing.y in theme of ggplot2.
then you can use aplot to group the bar plot and tree plot.
you can refer the following codes
library(aplot)
library(ggtree)
library(ggplot2)

set.seed(1024)

tr <- rtree(10)

df <- data.frame(trt = rep(tr$tip.label,2),
                 outcome = abs(rnorm(20, mean=20, sd=8)),
                 group=c(rep("A",10),rep("B",10)))

p1 <- ggtree(tr, layout="dendrogram") +
      geom_tiplab(
          align=TRUE,
          linesize=.1,
          angle=-90,
          hjust=-0.1,
          size=3
      )

dd <- p1$data[match(df$trt, p1$data$label),]
df$idx <- dd$y
df

p2 <- ggplot(data=df) +
      geom_bar(mapping=aes(y=idx, x=outcome, fill=group),
               stat="identity",
               orientation="y"
               ) +
      facet_grid(group~.) +
      coord_flip()

p3 <- p1 %>% insert_bottom(p2, height=0.8)
​
