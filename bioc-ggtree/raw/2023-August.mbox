data_tidy = data %>%
  gather("pop1", "pop2", "pop3", "pop4", "pop5",
         key = "Population",
         value = "Probability")

p2 = data_tidy %>%
  ggplot(aes(x = SampleID,
             y = Probability,
             fill = Population))+
  geom_bar(stat = "identity",
           position = "stack") +
  guides(x = "none") +
  coord_flip()

p1 = ggtree(tree)

How can I combine these plots and make sure the tip labels match the order of the stacked bar plot?

