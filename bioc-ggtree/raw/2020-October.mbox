> > > > > 20   19   20        20        21        t1
> > > > > 22   21   19        20        18        t2
> > > > > 20   20   19        21        20        t3
> > > > > 19   19   21        21        20        t4
> > > > >
> > > > > tdf1_melted <- melt(tdf1, id="Sample_ID")
> > > > >
