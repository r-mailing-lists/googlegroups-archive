Sorry for typo. pls use the following code:

library(ggtree)
x <- read.tree("long-branch-example.newick")
groupClade(x, 151) -> y
ggtree(y, aes(linetype=group)) + geom_tiplab(size = 2

) -> p
p$data[p$data$node %in% c(75, 76), "x"] = mean(p$data$x)
print(p)
​

