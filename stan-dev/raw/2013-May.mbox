time clang++ -I src -I lib/eigen_3.1.3 -I lib/boost_1.53.0 -Wall -DBOOST_RESULT_OF_USE_TR1 -DBOOST_NO_DECLTYPE -DBOOST_DISABLE_ASSERTS -Winvalid-pch -Wno-unused-function -Wno-uninitialized   -c -O3 -o models/bugs_examples/vol1/oxford/oxford2.o models/bugs_examples/vol1/oxford/oxford2.cpp

