>
> data {
>   int<lower=1> K;
>   int<lower=K> N;
>   matrix[N,K]  X;
>   int y[n];
>   int<lower=0,upper=1> R[N];
> }
> transformed data {
>   vector[N] lower;
>   vector[N] upper;
>   int n_miss;
>   n_miss <- N - sum(R);
>   for(i in 1:N) {
>     if(R[i] == 1) {
>       lower[i] <- 0.0;
>       upper[i] <- Infinity();
>     }
>     else {
>       lower[i] <- -Infinity();
>       upper[i] <- 0.0;
>     }
>   }
