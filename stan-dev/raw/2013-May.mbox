On Sunday, May 19, 2013 2:20:15 PM UTC-4, Ben Goodrich wrote:
> That fixed it. So, I have those two commits in a branch now.

Daniel, I have a feature branch that adds a test-pch make target like

feature/test-pch!stan *> git diff make/tests | cat
diff --git a/make/tests b/make/tests
index 13d5056..1c1cef7 100644
--- a/make/tests
+++ b/make/tests
@@ -41,6 +41,27 @@ UNIT_TESTS := $(shell find src/test -type f -name '*_test.cpp')
 UNIT_TESTS := $(UNIT_TESTS:src/test/%_test.cpp=test/%)
 UNIT_TESTS := $(filter-out $(MODEL_TESTS),$(UNIT_TESTS))

+##
+# Target to precompile all headers that are under src/stan
+# and end with *.hpp. Headers ending with *.h are ignored.
+##
+PCH_TESTS := $(shell find src/stan -name '*.hpp' -type f)
+.PHONY: test-pch
+test-pch: $(PCH_TESTS)
+       @echo
+       @echo 'Testing whether all relevant header files precompile'
+       @$(MAKE) -B $(PCH_TESTS)
+       @echo
+       @echo 'All relevant header files do precompile'
+
+.PRECIOUS: src/stan/%.hpp
+src/stan/%.hpp :
+ifeq ($(OS),win)
+       $(CC) -x c++-header $(CFLAGS) -o nul $@
+else
+       $(CC) -x c++-header $(CFLAGS) -o /dev/null $@
+endif
+
 GENERATED_AGRAD_TESTS := $(shell find src/test/agrad/distributions -type f -name '*_test.hpp')
 GENERATED_AGRAD_TESTS := $(GENERATED_AGRAD_TESTS:%_test.hpp=%_00000_generated_test.cpp)
 ##
@@ -65,7 +86,7 @@ test-unit: $(addprefix runtest/,$(UNIT_TESTS))
 # Target to build all tests
 ##
 .PHONY: test-all
-test-all: test-unit test-distributions test-models
+test-all: test-pch test-unit test-distributions test-models

 ##
 # Build the google test library.

This works, but make test-pch unfortunately goes through each .hpp file twice and the second time says

make[1]: `foo.hpp' is up to date.

That is not so bad, but do you see a mistake I made to cause that?

Thanks,
Ben

