index acd32b1..1940d7a 100644
--- a/src/test/agrad/rev/log1m_test.cpp
+++ b/src/test/agrad/rev/log1m_test.cpp
@@ -3,7 +3,7 @@
 #include <gtest/gtest.h>

 TEST(AgradRev,log1m) {
-  AVAR a = 0.1;
+  AVAR a = 1.1;
   AVAR f = log1m(a);
   EXPECT_FLOAT_EQ(log(1 - 0.1), f.val());

