#include <RInside.h>
int test(Rcpp::List& lst) {
  std::vector<int> v;
  for (int i = 0; i < 10; i++)
    v.push_back(i);
  lst = Rcpp::List(v.begin(), v.end());
  lst.attr("attr1") = 3;
  lst["v1"] = 4;
  return 0;
}
int main(int argc, char *argv[]) {
  RInside R(argc, argv);
  Rcpp::List lst;
  test(lst);
  R["txt"] = "Hello, world!\n";
  R["lst"] = lst;
  R.parseEvalQ("cat(txt)");
  R.parseEvalQ("print(lst)");
}

