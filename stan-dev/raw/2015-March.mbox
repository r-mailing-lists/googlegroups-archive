> ccache g++ -I/usr/share/R/include -DNDEBUG -I"../inst/include"  -DBOOST_RESULT_OF_USE_TR1 -DBOOST_NO_DECLTYPE -DBOOST_DISABLE_ASSERTS -ftemplate-depth-256  -Wno-unused-function -Wno-uninitialized  -I"/home/jq/R/x86_64-pc-linux-gnu-library/3.1/Rcpp/include" -I"/usr/lib/R/site-library/RcppEigen/include" -I"/home/jq/R/x86_64-pc-linux-gnu-library/3.1/BH/include" -I"/home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include"   -fpic  -O2 -fstack-protector-strong -Wformat -Werror=format-security -D_FORTIFY_SOURCE=2           -pedantic  -c chains.cpp -o chains.o
> In file included from /home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include/stan/meta/traits.hpp:11:0,
>                  from /home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include/stan/math/matrix/append_row.hpp:5,
>                  from /home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include/stan/math/matrix.hpp:7,
>                  from chains.cpp:2:
> /home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include/stan/agrad/rev/var.hpp:160:25: warning: ISO C++ 1998 does not support ‘long long’ [-Wlong-long]
>        var(unsigned long long n) :
>                          ^
> /home/jq/R/x86_64-pc-linux-gnu-library/3.1/StanHeaders/include/stan/agrad/rev/var.hpp:170:16: warning: ISO C++ 1998 does not support ‘long long’ [-Wlong-long]
>        var(long long n) :
