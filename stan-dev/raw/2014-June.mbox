Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

data {
  int N;
  int K;
  vector[N] y;
  matrix[N,K] X;
}
parameters {
  vector[K] b;
  real<lower=0> sigma_1;
  real<lower=0> sigma_2;
}
transformed parameters {
  real<lower=0> sigma;
  sigma <- sqrt (pow(sigma_1, 2) + pow(sigma_2, 2));
}
model {
  y ~ normal (X*b, sigma);
}

