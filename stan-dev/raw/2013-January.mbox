With this R code:

library(rstan)

y <- rnorm(1000)

model_code <-
'

data {
  int<lower=0> N;
  real y[N];
}
parameters {

  real mu_raw;
  real<lower=0> sigma_raw;

}
transformed parameters {
  real mu;
  real sigma;

  mu <- 10 * tan(pi() * (Phi(mu_raw) - 0.5));
  sigma <- 5 * tan(pi() * (Phi(sigma_raw) - 0.5));
}
model {
  mu_raw ~ normal(0,1);
  sigma_raw ~ normal(0,1);
  y ~ normal(mu, sigma);
}
'

results <- stan(model_code = model_code, data = list(y = y, N = length(y)))

I get

> results
