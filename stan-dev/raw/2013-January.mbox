 Max.   :2293   Max.   :2194   Max.   :0.07100   Max.   :1e-03   Max.   :0.07100   Max.   :0    Max.   :0
> summary(s2)
       mu           sigma        user.self          sys.self          elapsed          user.child   sys.child
 Min.   :1391   Min.   :1129   Min.   :0.07200   Min.   :0.0e+00   Min.   :0.07200   Min.   :0    Min.   :0
 1st Qu.:1866   1st Qu.:1545   1st Qu.:0.07300   1st Qu.:0.0e+00   1st Qu.:0.07300   1st Qu.:0    1st Qu.:0
 Median :1981   Median :1648   Median :0.07300   Median :0.0e+00   Median :0.07300   Median :0    Median :0
 Mean   :1976   Mean   :1642   Mean   :0.07329   Mean   :5.5e-05   Mean   :0.07344   Mean   :0    Mean   :0
 3rd Qu.:2109   3rd Qu.:1767   3rd Qu.:0.07400   3rd Qu.:0.0e+00   3rd Qu.:0.07400   3rd Qu.:0    3rd Qu.:0
 Max.   :2421   Max.   :2048   Max.   :0.07900   Max.   :1.0e-03   Max.   :0.07900   Max.   :0    Max.   :0

----

library(rstan)
m1 <- '

data {
  int<lower=0> N;
  real y[N];
}
parameters {
  real mu;
  real<lower=0> sigma;
}
model {
  y ~ normal(mu, sigma);

  mu ~ cauchy(0, 5);
  sigma ~ cauchy(0, 5);
}
'

m2 <- '

data {
  int<lower=0> N;
  real y[N];
}
parameters {

  real<lower=0, upper=pi()/2> sigma_unif;
  real<lower=-pi()/2, upper=pi()/2> mu_unif;
}

transformed parameters {
  real sigma;
  real mu;
  sigma <- 5 * tan(sigma_unif);
  mu <- 5 * tan(mu_unif);

}
model {
  y ~ normal(mu, sigma);
}

'

m3 <- '

data {
  int<lower=0> N;
  real y[N];
}
parameters {

  real sigma_norm;
  real mu_norm;
}

transformed parameters {
  real sigma;
  real mu;
  sigma <- 5 * tan(pi() * Phi(sigma_norm) * 0.5);
  mu <- 5 * tan(pi() * (Phi(sigma_norm) - 0.5));

}
model {
  y ~ normal(mu, sigma);
}

'

fit1 <- stan(model_code = m1);
fit2 <- stan(model_code = m2);
fit3 <- stan(model_code = m3);

fun1 <- function(y) {
  t <- system.time(fit <- stan(fit = fit1, data = list(N = length(y), y = y), refresh = -1))
  c(summary(fit)$summary[c('mu', 'sigma'), 'n_eff'], t)
}

fun2 <- function(y) {
  t <- system.time(fit <- stan(fit = fit2, data = list(N = length(y), y = y), refresh = -1))
  c(summary(fit)$summary[c('mu', 'sigma'), 'n_eff'], t)
}

fun3 <- function(y) {
  t <- system.time(fit <- stan(fit = fit3, data = list(N = length(y), y = y), refresh = -1))
  c(summary(fit)$summary[c('mu', 'sigma'), 'n_eff'], t)
}

N <- 30
ys <- lapply(1:200, FUN = function(i) rnorm(N))
s1 <- lapply(ys, FUN = fun1)
s2 <- lapply(ys, FUN = fun2)
s3 <- lapply(ys, FUN = fun3)

s1 <- do.call(rbind, s1)
s2 <- do.call(rbind, s2)
s3 <- do.call(rbind, s3)

