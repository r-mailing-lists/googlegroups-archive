Here are 4 models.  Two work, two don't.

(1) This works:

schools_code <- '
  data {
    int<lower=0> J; // number of schools
    real y[J]; // estimated treatment effects
    real<lower=0> sigma[J]; // s.e. of effect estimates
  }
  parameters {
    real theta[J];
    real mu;
    real<lower=0> tau;
  }
  model {
    theta ~ normal (mu, tau);
    for (j in 1:J)
      y[j] ~ normal (theta[j], sigma);
  }
'

(2) This works too:

schools_code <- '
  data {
    int<lower=0> J; // number of schools
    real y[J]; // estimated treatment effects
    real<lower=0> sigma[J]; // s.e. of effect estimates
  }
  parameters {
    real theta[J];
    real mu;
    real<lower=0> tau;
  }
  model {
    for (j in 1:J){
      theta[j] ~ student_t (4, mu, tau);
      y[j] ~ normal (theta[j], sigma);
    }
  }
'

(3) This doesn't:

schools_code <- '
  data {
    int<lower=0> J; // number of schools
    real y[J]; // estimated treatment effects
    real<lower=0> sigma[J]; // s.e. of effect estimates
  }
  parameters {
    real theta[J];
    real mu;
    real<lower=0> tau;
  }
  model {
    theta ~ normal (mu, tau);
    for (j in 1:J)
      y[j] ~ student_t(4,theta[j], sigma);
  }
'

It gives an error:

