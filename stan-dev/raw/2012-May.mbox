uint num_param_names(); // L

double theta(uint n, uint k, uint m);
vector<double> theta(uint n, uint k); // all values for chain k (use for
traceplot)
vector<double> theta(uint n); // all values for all chains
? vector<vector<double>> theta2(uint n); // all values for all chains

double mean(uint n);

double sd(uint n);

