On Saturday, June 4, 2016 at 6:25:13 PM UTC-4, Bob Carpenter wrote:

> > And I can't find any class to inherit from in order to implement
> >
> > inline var
> > foo(const std::vector<var>&a, const var& x);
>
> Right --- you're going to have to write your own base classes
> for this.  As far as I know, we don't have any signatures that
> apply to a mix of scalar and std::vector --- all of those functions
> use Eigen types.

This is the class I am supposed to define?

#ifndef STAN_MATH_REV_CORE_VECTOR_VV_VARI_HPP
#define STAN_MATH_REV_CORE_VECTOR_VV_VARI_HPP

#include <stan/math/rev/core/var.hpp>
#include <stan/math/rev/core/vari.hpp>
#include <vector>

namespace stan {
  namespace math {

    class op_vector_Vv_vari : public op_vari {
    protected:
      vari* xvi_;
      const size_t size_;
      vari** vis_;
    public:
      op_vector_Vv_vari(double f, const std::vector<stan::math::var>& vs,
                        vari* xvi) :
        vari(f),
        xvi_(xvi),
        size_(vs.size()) {
        vis_ = reinterpret_cast<vari**>
          (operator new(sizeof(vari*) * vs.size()));
        for (size_t i = 0; i < vs.size(); ++i)
          vis_[i] = vs[i].vi_;
      }
      vari* operator[](size_t n) const {
        return vis_[n];
      }
      size_t size() {
        return size_;
      }
    };

  }
}
#endif

Ben

