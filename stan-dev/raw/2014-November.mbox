Also, too, can you make a "template" file that comes up when you do File -> New File -> Stan similar to that for a C++ file? Maybe just have the template file demonstrate something like a linear regression but with all of the possible blocks:

functions {
  /* Can create user-defined functions here */
}
data {
  int<lower=1> N; # observations
  int<lower=1> K; # predictors
  matrix[N,K]  X; # design matrix
  real y[N];      # outcome
}
transformed data {
  /* Can create constants here that are only evaluated once */
}
parameters {
  vector[K] beta;
  real<lower=0> sigma;
}
transformed parameters {
  /* Can create intermediate parameters that are checked and saved here */
}
model {
  vector[N] mu;
  mu <- X * beta;        // intermediate that is not checked or saved
  y ~ normal(mu, sigma); // likelihood of the data
  beta ~ normal(0,10);   // i.i.d. prior on coefficients
  sigma ~ cauchy(2.5);   // prior on error standard deviation
}
generated quantities {
 /* Can create quantities of interest here that do not go into the posterior */
}

Ben

