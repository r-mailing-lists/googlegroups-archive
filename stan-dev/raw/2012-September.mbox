    template <typename T>
    void autocovariance(const std::vector<T>& y,
                        std::vector<T>& acov,
                        Eigen::FFT<T>& fft) {

      stan::prob::autocorrelation(y, acov, fft);

      T var = stan::math::variance(y) * (y.size()-1) / y.size();
      for (size_t i = 0; i < y.size(); i++) {
        acov[i] *= var;
      }
    }

    template <typename T>
    void autocovariance(const std::vector<T>& y,
                        std::vector<T>& acov) {
      Eigen::FFT<T> fft;
      return autocovariance(y,acov,fft);
    }

Since the second version doesn't have a Eigen::FFT argument like the first version does, I think it shouldn't have return type void.

Ben

