Yes, particularly:

data {
  int<lower=0> N;
  int<lower=0> n;
  matrix[N,n] x;
  int<lower=0,upper=1> z[N];
}
parameters {
  vector[n] beta_raw;
  real<lower=0> tau;
}
transformed parameters {
  vector[n] beta;
  beta <- tau * beta_raw;
}
model {
  tau ~ cauchy(0, 1);
  beta_raw ~ normal(0, 1);
  z ~ bernoulli_logit(x*beta);
}

>
> How are you generating the predictors x?
>

I generated cholesky factors as Ben suggested and then using

n.data.per.param <- c(4,8,16,32,64,128)
for (j in 1:8) {
    tau_actual <- 2
    beta_actual <- rnorm(ncol(cholesky.corr[[j]])+1, 0, tau_actual)

    for (k in 1:length(n.data.per.param)) {
        num.iter <- (ncol(cholesky.corr[[j]])+1) * n.data.per.param[k]
        x <- matrix(data=NA, ncol = ncol(cholesky.corr[[j]])+1, nrow=num.iter)

        for (i in 1:num.iter) {
            temp.norm <- rnorm(ncol(cholesky.corr[[j]]), mean=0, sd=1)
            cor.rv <- cholesky.corr[[j]] %*% temp.norm
            x[i,] <- c(1,cor.rv)
        }

        1 / (1+exp(-(x %*% beta_actual))) -> z
        z <- rbinom(length(z),1, z)

        N <- length(z)
        n <- ncol(x)

        list <- c("x","z", "N", "n","beta_actual","tau_actual")
        stan_rdump(list, file=paste("hier_logistic_",j,"_",k,".data.R",sep=""))
    }
}

