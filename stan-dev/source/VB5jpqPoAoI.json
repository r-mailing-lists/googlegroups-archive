     3,
     "<div><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">Mav,<br><br>I wrote a R function that tries to run something under src/models. You can improve / include it in rstan if you want or put it on the wiki or something. -- Ben<br>\r\n<br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span>libary</span><span style=\"color:#660\">(</span><span>rstan</span><span style=\"color:#660\">)</span><span><br>\r\n<br>stan_demo </span><span style=\"color:#660\">&lt;-</span><span> <br>  </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span>model </span><span style=\"color:#660\">=</span><span> NULL</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#660\">...)</span><span> </span><span style=\"color:#660\">{</span><span><br>\r\n    MODELS_HOME </span><span style=\"color:#660\">&lt;-</span><span> file</span><span style=\"color:#660\">.</span><span>path</span><span style=\"color:#660\">(</span><span>system</span><span style=\"color:#660\">.</span><span>file</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;include&#39;</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#008\">package</span><span> </span><span style=\"color:#660\">=</span><span> </span><span style=\"color:#080\">&#39;rstan&#39;</span><span style=\"color:#660\">),</span><span> <br>\r\n                             </span><span style=\"color:#080\">&quot;stansrc&quot;</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;models&quot;</span><span style=\"color:#660\">)</span><span><br>\r\n    MODELS </span><span style=\"color:#660\">&lt;-</span><span> dir</span><span style=\"color:#660\">(</span><span>MODELS_HOME</span><span style=\"color:#660\">,</span><span> pattern </span><span style=\"color:#660\">=</span><span> paste0</span><span style=\"color:#660\">(</span><span>model</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;.stan&quot;</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;$&quot;</span><span style=\"color:#660\">),</span><span> <br>\r\n                  recursive </span><span style=\"color:#660\">=</span><span> TRUE</span><span style=\"color:#660\">,</span><span> full</span><span style=\"color:#660\">.</span><span>names </span><span style=\"color:#660\">=</span><span> TRUE</span><span style=\"color:#660\">)</span><span><br>\r\n    </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span>length</span><span style=\"color:#660\">(</span><span>MODELS</span><span style=\"color:#660\">)</span><span> </span><span style=\"color:#660\">==</span><span> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">)</span><span> </span><span style=\"color:#660\">{</span><span><br>\r\n      stop</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;&#39;model&#39; not found; leave &#39;model&#39; unspecified to see all choices&quot;</span><span style=\"color:#660\">)</span><span><br>\r\n    </span><span style=\"color:#660\">}</span><span><br>    </span><span style=\"color:#008\">else</span><span> </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span>length</span><span style=\"color:#660\">(</span><span>MODELS</span><span style=\"color:#660\">)</span><span> </span><span style=\"color:#660\">&gt;</span><span> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span> </span><span style=\"color:#660\">{</span><span><br>\r\n      MODELS </span><span style=\"color:#660\">&lt;-</span><span> </span><span style=\"color:#008\">select</span><span style=\"color:#660\">.</span><span>list</span><span style=\"color:#660\">(</span><span>MODELS</span><span style=\"color:#660\">)</span><span><br>\r\n      model </span><span style=\"color:#660\">&lt;-</span><span> </span><span style=\"color:#008\">sub</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;.stan$&quot;</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">,</span><span> basename</span><span style=\"color:#660\">(</span><span>MODELS</span><span style=\"color:#660\">))</span><span><br>\r\n    </span><span style=\"color:#660\">}</span><span><br>    MODEL_HOME </span><span style=\"color:#660\">&lt;-</span><span> dirname</span><span style=\"color:#660\">(</span><span>MODELS</span><span style=\"color:#660\">)</span><span><br>\r\n    STAN_ENV </span><span style=\"color:#660\">&lt;-</span><span> </span><span style=\"color:#008\">new</span><span style=\"color:#660\">.</span><span>env</span><span style=\"color:#660\">()</span><span><br>    </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>exists</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>path</span><span style=\"color:#660\">(</span><span>MODEL_HOME</span><span style=\"color:#660\">,</span><span> paste0</span><span style=\"color:#660\">(</span><span>model</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;_generate_data.R&quot;</span><span style=\"color:#660\">))))</span><span> </span><span style=\"color:#660\">{</span><span><br>\r\n      current_wd </span><span style=\"color:#660\">&lt;-</span><span> getwd</span><span style=\"color:#660\">()</span><span><br>      on</span><span style=\"color:#660\">.</span><span style=\"color:#008\">exit</span><span style=\"color:#660\">(</span><span>setwd</span><span style=\"color:#660\">(</span><span>current_wd</span><span style=\"color:#660\">))</span><span><br>\r\n      setwd</span><span style=\"color:#660\">(</span><span>MODEL_HOME</span><span style=\"color:#660\">)</span><span> </span><span style=\"color:#800\"># this might not work if MODEL_HOME is not writable</span><span><br>\r\n      source</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>path</span><span style=\"color:#660\">(</span><span>MODEL_HOME</span><span style=\"color:#660\">,</span><span> paste0</span><span style=\"color:#660\">(</span><span>model</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;_generate_data.R&quot;</span><span style=\"color:#660\">)),</span><span> <br>\r\n             </span><span style=\"color:#008\">local</span><span> </span><span style=\"color:#660\">=</span><span> STAN_ENV</span><span style=\"color:#660\">,</span><span> verbose </span><span style=\"color:#660\">=</span><span> FALSE</span><span style=\"color:#660\">)</span><span><br>\r\n    </span><span style=\"color:#660\">}</span><span><br>    </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>exists</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>path</span><span style=\"color:#660\">(</span><span>MODEL_HOME</span><span style=\"color:#660\">,</span><span> paste0</span><span style=\"color:#660\">(</span><span>model</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;.Rdata&quot;</span><span style=\"color:#660\">))))</span><span> </span><span style=\"color:#660\">{</span><span><br>\r\n      source</span><span style=\"color:#660\">(</span><span>file</span><span style=\"color:#660\">.</span><span>path</span><span style=\"color:#660\">(</span><span>MODEL_HOME</span><span style=\"color:#660\">,</span><span> paste0</span><span style=\"color:#660\">(</span><span>model</span><span style=\"color:#660\">,</span><span> </span><span style=\"color:#080\">&quot;.Rdata&quot;</span><span style=\"color:#660\">)),</span><spa