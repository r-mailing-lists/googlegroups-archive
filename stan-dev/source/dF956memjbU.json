:#000\">eigenvalues</span><span style=\"color:#660\">()[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1E-10</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>src</span><span style=\"color:#660\">/</span><span style=\"color:#000\">test</span><span style=\"color:#660\">/</span><span style=\"color:#000\">io</span><span style=\"color:#660\">/</span><span style=\"color:#000\">reader_test</span><span style=\"color:#660\">.</span><span style=\"color:#000\">cpp</span><span style=\"color:#660\">:</span><span style=\"color:#066\">706</span><span style=\"color:#660\">:</span><span style=\"color:#000\">  </span><span style=\"color:#008\">assert</span><span style=\"color:#660\">(</span><span style=\"color:#000\">solver</span><span style=\"color:#660\">.</span><span style=\"color:#000\">eigenvalues</span><span style=\"color:#660\">()[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1E-10</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>src</span><span style=\"color:#660\">/</span><span style=\"color:#000\">test</span><span style=\"color:#660\">/</span><span style=\"color:#000\">io</span><span style=\"color:#660\">/</span><span style=\"color:#000\">reader_test</span><span style=\"color:#660\">.</span><span style=\"color:#000\">cpp</span><span style=\"color:#660\">:</span><span style=\"color:#066\">769</span><span style=\"color:#660\">:</span><span style=\"color:#000\">  </span><span style=\"color:#008\">assert</span><span style=\"color:#660\">(</span><span style=\"color:#000\">solver</span><span style=\"color:#660\">.</span><span style=\"color:#000\">eigenvalues</span><span style=\"color:#660\">()[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1E-10</span><span style=\"color:#660\">);</span><span style=\"color:#000\"> </span><span style=\"color:#800\">// check positive definite with smallest eigenvalue &gt; 0</span><span style=\"color:#000\"><br>src</span><span style=\"color:#660\">/</span><span style=\"color:#000\">test</span><span style=\"color:#660\">/</span><span style=\"color:#000\">io</span><span style=\"color:#660\">/</span><span style=\"color:#000\">reader_test</span><span style=\"color:#660\">.</span><span style=\"color:#000\">cpp</span><span style=\"color:#660\">:</span><span style=\"color:#066\">795</span><span style=\"color:#660\">:</span><span style=\"color:#000\">  </span><span style=\"color:#008\">assert</span><span style=\"color:#660\">(</span><span style=\"color:#000\">solver</span><span style=\"color:#660\">.</span><span style=\"color:#000\">eigenvalues</span><span style=\"color:#660\">()[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1E-10</span><span style=\"color:#660\">);</span><span style=\"color:#000\"> </span><span style=\"color:#800\">// check positive definite with smallest eigenvalue &gt; 0</span><span style=\"color:#000\"><br></span></div></code></div><br>I am not sure what to throw in this case (Daniel?), but if an assert() is triggered it would take down the process if it were called from R. I think asserts get disabled if NDEBUG is defined, but we should probably replace these with something else to be on the safe side.<br><br>Ben<br><br></div>"
