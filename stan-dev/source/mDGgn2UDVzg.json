   "subject": "to_vector for an array of Eigen types",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">I wanted to add a to_vector function for situations where you had an array, like<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">parameters </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  matrix</span><span style=\"color:#660\">[</span><span style=\"color:#066\">5</span><span style=\"color:#660\">,</span><span style=\"color:#066\">4</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> theta</span><span style=\"color:#660\">[</span><span style=\"color:#066\">3</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>model </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  to_vector</span><span style=\"color:#660\">(</span><span style=\"color:#000\">theta</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">~</span><span style=\"color:#000\"> normal</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0.0</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1.0</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span></div></code></div><br>So, I wrote this<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">    </span><span style=\"color:#008\">template</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;</span><span style=\"color:#008\">typename</span><span style=\"color:#000\"> T</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> R1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> R2</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">inline</span><span style=\"color:#000\"><br>    </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Dynamic</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"><br>    to_vector</span><span style=\"color:#660\">(</span><span style=\"color:#008\">const</span><span style=\"color:#000\"> std</span><span style=\"color:#660\">::</span><span style=\"color:#000\">vector</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#000\">R1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">R2</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;&amp;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>      std</span><span style=\"color:#660\">::</span><span style=\"color:#000\">cout </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Size = &quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">.</span><span style=\"color:#000\">size</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"><br>                   </span><span style=\"color:#080\">&quot; Rows = &quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">rows</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"><br>                   </span><span style=\"color:#080\">&quot; Cols = &quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">cols</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;&lt;</span><span style=\"color:#000\"> std</span><span style=\"color:#660\">::</span><span style=\"color:#000\">endl</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">return</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Dynamic</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">&gt;::</span><span style=\"color:#606\">Map</span><span style=\"color:#660\">(</span><span style=\"color:#000\">m</span><span style=\"color:#660\">.</span><span style=\"color:#000\">data</span><span style=\"color:#660\">()-&gt;</span><span style=\"color:#000\">data</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"><br>             m</span><span style=\"color:#660\">.</span><span style=\"color:#000\">size</span><span style=\"color:#660\">()*</span><span style=\"color:#000\">m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">rows</span><span style=\"color:#660\">()*</span><span style=\"color:#000\">m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">cols</span><span style=\"color:#660\">());</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span></div></code></div><br>which promptly segfaulted<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">vec_theta </span><span style=\"color:#660\">=</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Size</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">3</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Rows</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">5</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Cols</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">4</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Segmentation</span><span style=\"color:#000\"> fault<br></span></div></code></div><br>which made me look up<br><br><a href=\"http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html&amp;source=gmail&amp;ust=1792474971141000&amp;usg=AOvVaw17RrDRpSMFSmQHZx2SGa4g\">http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html</a><br><br>which only refers to fixed-size types but it appears as if there is some sort of an alignment problem. I guess a std::vector of Eigen::Matrix puts the each individual Eigen::Matrix in contiguous memory locations but does not necessarily but them adjacent to each other.<br><br>Does anyone know of a better way to do it than<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">    </span><span style=\"color:#008\">template</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;</span><span style=\"color:#008\">typename</span><span style=\"color:#000\"> T</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> R1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> R2</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">inline</span><span style=\"color:#000\"><br>    </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Dynamic</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"><br>    to_vector</span><span style=\"color:#660\">(</span><span style=\"color:#008\">const</span><span style=\"color:#000\"> std</span><span style=\"color:#660\">::</span><span style=\"color:#000\">vector</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#000\">R1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">R2</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&gt;&amp;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> mat_size </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">rows</span><span style=\"color:#660\">()*</span><span style=\"color:#000\">m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">cols</span><span style=\"color:#660\">();</span><span style=\"color:#000\"><br>      </span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Matrix</span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#606\">Eigen</span><span style=\"color:#660\">::</span><span style=\"color:#606\">Dynamic</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> vec</span><span style=\"color:#660\">(</span><span style=\"color:#000\">m</span><span style=\"color:#660\">.</span><span style=\"color:#000\">size</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> mat_size</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> pos </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#008\">unsigned</span><span style=\"color:#000\"> </span><span style=\"color:#008\">int</span><span style=\"color:#000\"> i </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">;</span><span style=\"color:#000\"> i </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">.</span><span style=\"color:#000\">size</span><span style=\"color:#660\">();</span><span style=\"color:#000\"> i</span><span style=\"color:#660\">++)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>        </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#008\">int</span><span style=\"color:#000\"> k </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">;</span><span style=\"color:#000\"> k </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">cols</span><span style=\"color:#660\">();</span><span style=\"color:#000\"> k</span><span style=\"color:#660\">++)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>          </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#008\">int</span><span style=\"color:#000\"> j </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">;</span><span style=\"color:#000\"> j </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#066\">0</span><span style=\"color:#660\">].</span><span style=\"color:#000\">rows</span><span style=\"color:#660\">();</span><span style=\"color:#000\"> j</span><span style=\"color:#660\">++)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>            vec</span><span style=\"color:#660\">(</span><span style=\"color:#000\">pos</span><span style=\"color:#660\">++)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> m</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">](</span><span style=\"color:#000\">j</span><span style=\"color:#660\">,</span><span style=\"color:#000\">k</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>          </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>        </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>      </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">return</span><span style=\"color:#000\"> vec</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span></div></code></div><br>Also, how do you specify the function signatures so that it would work with any multidimensional array of matrices like <br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">matrix</span><span style=\"color:#660\">[</span><span style=\"color:#066\">5</span><span style=\"color:#660\">,</span><span style=\"color:#066\">4</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> theta</span><span style=\"color:#660\">[</span><span style=\"color:#000\">a</span><span style=\"color:#660\">,</span><span style=\"color:#000\">b</span><span style=\"color:#660\">,</span><span style=\"color:#000\">c</span><span style=\"color:#660\">,</span><span style=\"color:#000\">d</span><span style=\"color:#660\">,</span><span style=\"color:#000\">e</span><span style=\"color:#660\">,</span><span style=\"color:#000\">f</span><span style=\"color:#660\">];</span><span style=\"color:#000\"><br></span></div></code></div><br>Ben<br><br></div>"
    ]
   ]
  },
  {
   "id": "d4zVuyiMaGAJ",
   "from": "Bob Carpenter",
   "author": "8aa9b8cc06fdc99c",
   "date": "2014-04-24T16:37:30Z",
   "subject": "Re: [stan-dev] to_vector for an array of Eigen types",
   "parts": [
    [
     2,
     "\r<br>On Apr 21, 2014, at 10:02 PM, Ben Goodrich &lt;<a href data-email-masked rel=\"nofollow\">goodri...@gmail.com</a>&gt; wrote:\r<br>\r<br>&gt; I wanted to add a to_vector function for situations where you had an array, like\r<br>&gt; \r<br>&gt; parameters {\r<br>&gt;   matrix[5,4] theta[3];\r<br>&gt; }\r<br>&gt; model {\r<br>&gt;   to_vector(theta) ~ normal(0.0,1.0);\r<br>&gt; }\r<br>&gt; \r<br>&gt; So, I wrote this\r<br>&gt; \r<br>&gt;     template &lt;typename T, int R1, int R2&gt;\r<br>&gt;     inline\r<br>&gt;     Eigen::Matrix&lt;T,Eigen::Dynamic,1&gt;\r<br>&gt;     to_vector(const std::vector&lt; Eigen::Matrix&lt;T,R1,R2&gt; &gt;&amp; m) {\r<br>&gt;       std::cout &lt;&lt; &quot;Size = &quot; &lt;&lt; m.size() &lt;&lt;\r<br>&gt;                    &quot; Rows = &quot; &lt;&lt; m[0].rows() &lt;&lt;\r<br>&gt;                    &quot; Cols = &quot; &lt;&lt; m[0].cols() &lt;&lt; std::endl;\r<br>&gt;       return Eigen::Matrix&lt;T,Eigen::Dynamic,1&gt;::Map(m.data()-&gt;data(),\r<br>&gt;              m.size()*m[0].rows()*m[0].cols());\r<br>&gt;     }\r<br>&gt; \r<br>&gt; which promptly segfaulted\r<br>&gt; \r<br>&gt; vec_theta =\r<br>&gt; Size = 3 Rows = 5 Cols = 4\r<br>&gt; Segmentation fault\r<br>&gt; \r<br>&gt; which made me look up\r<br>&gt; \r<br>&gt; <a href=\"http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html&amp;source=gmail&amp;ust=1792474971143000&amp;usg=AOvVaw1yPa3DeRhvo6QmmnmR36hz\">http://eigen.tuxfamily.org/dox/group__TopicStlContainers.html</a>\r<br>&gt; \r<br>&gt; which only refers to fixed-size types but it appears as if there is some sort of an alignment problem. I guess a std::vector of Eigen::Matrix puts the each individual Eigen::Matrix in contiguous memory locations but does not necessarily but them adjacent to each other.\r<br>\r<br>"
    ],
    [
     1,
     "Correct.  Each std::vector does its own malloc.  It uses\r<br>the RAII pattern (resource acquisition is initialization) pattern:\r<br>\r<br>  <a href=\"http://en.wikipedia.org/wiki/Resource_Acquisition_Is_Initialization\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://en.wikipedia.org/wiki/Resource_Acquisition_Is_Initialization&amp;source=gmail&amp;ust=1792474971143000&amp;usg=AOvVaw1dVOssK3X8wS2iU2aiAIbp\">http://en.wikipedia.org/wiki/Resource_Acquisition_Is_Initialization</a>\r<br>\r<br>The Eigen::Matrix class uses contigous memory, so any matrix object\r<br>has contiguous memory.\r<br>"
    ],
    [
     2,
     "\r<br>&gt; \r<br>&gt; Does anyone know of a better way to do it than\r<br>&gt; \r<br>&gt;     template &lt;typename T, int R1, int R2&gt;\r<br>&gt;     inline\r<br>&gt;     Eigen::Matrix&lt;T,Eigen::Dynamic,1&gt;\r<br>&gt;     to_vector(const std::vector&lt; Eigen::Matrix&lt;T,R1,R2&gt; &gt;&amp; m) {\r<br>&gt;       int mat_size = m[0].rows()*m[0].cols();\r<br>&gt;       Eigen::Matrix&lt;T,Eigen::Dynamic,1&gt; vec(m.size() * mat_size);\r<br>&gt;       int pos = 0;\r<br>&gt;       for(unsigned int i = 0; i &lt; m.size(); i++) {\r<br>&gt;         for(int k = 0; k &lt; m[0].cols(); k++) {\r<br>&gt;           for(int j = 0; j &lt; m[0].rows(); j++) {\r<br>&gt;             vec(pos++) = m[i](j,k);\r<br>&gt;           }\r<br>&gt;         }\r<br>&gt;       }\r<br>&gt;       return vec;\r<br>&gt;     }\r<br>&gt; \r<br>&gt; Also, how do you specify the function signatures so that it would work with any multidimensional array of matrices like \r<br>&gt; \r<br>&gt; matrix[5,4] theta[a,b,c,d,e,f];\r<br>\r<br>"
    ],
    [
     1,
     "What you have to do here is write recursive template programs that\r<br>peels off one std::vector at a time.  And it needs some auxiliary\r<br>template functions for calculating size_of using a similar trick and\r<br>a template metaprogram for peeling out the scalar type of an object.\r<br>They go roughly like this:\r<br>\r<br>For scalar_type_of:\r<br>\r<br>  template &lt;typename T&gt;\r<br>  class scalar_type_of {\r<br>    typedef T type;\r<br>  };\r<br>  template &lt;typename T&gt;\r<br>  class scalar_type_of&lt;vector&lt;T&gt; &gt; {\r<br>    typedef typename scalar_type_of&lt;T&gt;::type type;\r<br>  }\r<br>  template &lt;typename T, int R, int C&gt;\r<br>  class scalar_type_of&lt;Matrix&lt;T,Dynamic,Dynamic&gt; &gt; {\r<br>    typedef T type;\r<br>  }\r<br>  ... + (Dynamic,1) and (1,Dynamic) specializations ...\r<br>\r<br>\r<br>And then for size_of:\r<br>\r<br>  template &lt;typename T&gt;\r<br>  int size_of(const T&amp; x) {\r<br>    return 1;\r<br>  }\r<br>  template &lt;typename T&gt;\r<br>  int size_of(const vector&lt;T&gt;&amp; x) {\r<br>    return x.size() == 0U\r<br>      ? 0\r<br>      : static_cast&lt;int&gt;(x.size()) * size_of(x[0]);\r<br>  }\r<br>  template &lt;typename T, int R, int C&gt;\r<br>  int size_of(const Matrix&lt;T,R,C&gt;&amp; x) {\r<br>    return x.size();\r<br>  }\r<br>\r<br>And then down to business:\r<br>\r<br>   template &lt;typename T1, typename T2&gt;\r<br>   Matrix&lt;typename scalar_type_of&lt;T&gt;::type,Dynamic,1&gt;\r<br>   to_vector(const T&amp; x) {\r<br>     Matrix&lt;typename scalar_type_of&lt;T&gt;::type,Dynamic,1&gt; result(size_of(x));\r<br>     int pos = 0;\r<br>     to_vector(x,result,pos);\r<br>   }\r<br>\r<br>   template &lt;typename T&gt;\r<br>   T to_vector(const T&amp; x,\r<br>               Matrix&lt;T,Dynamic,1&gt;&amp; result,\r<br>               int&amp; pos) {\r<br>     result[pos++] = x;\r<br>   }\r<br>   template &lt;typename T&gt;\r<br>   int to_vector(const std::vector&lt;T&gt;&amp; x,\r<br>                 Matrix&lt;T,Dynamic,1&gt;&amp; result,\r<br>                 int&amp; pos) {\r<br>     for (size_t i = 0; i &lt; x.size(); ++i)\r<br>       to_vector(x,result[i],pos);\r<br>   }\r<br>   template &lt;typename T, int R, int C&gt;\r<br>   int to_vector(const Matrix&lt;T,R,C&gt;&amp; x,\r<br>                 Matrix&lt;T,Dynamic,1&gt;&amp; result,\r<br>                 int&amp; pos) {\r<br>     for (int i = 0; i &lt; x.size(); ++i)\r<br>       result[pos++] = x(i);\r<br>   }\r<br>\r<br>\r<br>- Bob\r<br>&gt; \r<br>"
    ]
   ]
  }
