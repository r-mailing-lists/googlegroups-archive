   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div dir=\"rtl\">שלום ליאור,</div><div dir=\"rtl\"><br></div><div dir=\"rtl\">דרך נוחה לעשות את מה שתיארת היא ליצור מפה עם רקע של גוגל בעזרת ספריית ggmap, שם תוכל להוסיף נקודות על גבי המפה עם geom_point -</div><div><a href=\"https://journal.r-project.org/archive/2013-1/kahle-wickham.pdf\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://journal.r-project.org/archive/2013-1/kahle-wickham.pdf&amp;source=gmail&amp;ust=1792496500443000&amp;usg=AOvVaw0vdHBut9mB7j5et4KQjdGX\">https://journal.r-project.org/archive/2013-1/kahle-wickham.pdf</a><br></div><div><br></div><div dir=\"rtl\">לאחר מכן תוכל להציג את המפה באפליקציית shiny עם plotOutput בדומה לכל פלט גרפי אחר - </div><div><a href=\"https://shiny.rstudio.com/reference/shiny/latest/plotOutput.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://shiny.rstudio.com/reference/shiny/latest/plotOutput.html&amp;source=gmail&amp;ust=1792496500443000&amp;usg=AOvVaw3X-YFRRYuKuzqPyvLuGviV\">https://shiny.rstudio.com/reference/shiny/latest/plotOutput.html</a><br></div><div><br></div><div dir=\"rtl\">יום טוב,</div><div dir=\"rtl\"><br></div><div dir=\"rtl\">מיכאל</div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
