   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div style=\"text-align:right\">מישהו יודע מה החבילות שצריך בשביל הקוד הבא:<br></div><div><div style=\"text-align:right\">hourly_delay &lt;- flights %&gt;% </div><div style=\"text-align:right\">  filter(!<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792497706523000&amp;usg=AOvVaw00qnLLV4qu7mk6lLSLPLPE\">is.na</a>(dep_delay)) %&gt;% </div><div style=\"text-align:right\">  group_by(date, hour) %&gt;% </div><div style=\"text-align:right\">  summarise( </div><div style=\"text-align:right\">    delay = mean(dep_delay), </div><div style=\"text-align:right\">    n = n() ) %&gt;% </div><div style=\"text-align:right\">  filter(n &gt; 10)</div></div><div style=\"text-align:right\"><br></div><div style=\"text-align:right\">חוץ מ magrittr?</div></div>"
    ]
   ]
