     1,
     "<div dir=\"rtl\"><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">שלום לכולם!</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\"> R-מצטערת שאני מעלה את השאלה שלי דווקא בפורום</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\"> לא באמת רוצה, אבל די חייבת) SAS אבל אני רוצה ללמוד גם<br></font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\"><br></font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">יש לי ניסיון ממש טוב עם</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">SPSS ו-R<br></font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">(לצרכים שלי)</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\"> ?האם יש פה מישהו שיכול לעשות שיעורים פרטיים בת&quot;א <br></font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">בנתיים לומדת לבד עם יוטיוב</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\"><br></font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">תודה רבה!</font></div><div style=\"text-align:right\"><font face=\"arial, sans-serif\" size=\"4\">אלינה</font></div></div>"
    ]
