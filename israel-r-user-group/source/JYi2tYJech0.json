   "parts": [
    [
     1,
     "<div dir=\"rtl\"><div style=\"text-align:right\">שלום,<br><br>אז בהתאם לעצות הטובות שניתנו כאן השתמשתי ב readHTMLTable שבחבילת XML.<br><br>הבעיה הנוכחית שלי היא שהמידע הוא מחרוזת ואני לא מצליח להפוך אותו ל integer.<br><br>הנה הקוד (עם הנתונים האמיתיים):<br><br><blockquote style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\" class=\"gmail_quote\"><div style=\"text-align:left\">library(XML)<br>myTable &lt;- readHTMLTable(&#39;<a href=\"http://fohs.bgu.ac.il/cmsfohs/hebSite/students/teaching/marks/484/degree-1/y-4/%D7%A1%D7%9E%D7%A1%D7%98%D7%A8%20%D7%90/%D7%9E%D7%95%D7%A2%D7%93%20%D7%90%20%D7%93%D7%99%D7%A0%D7%99%20%D7%A8%D7%95%D7%A7%D7%97%D7%95%D7%AA.htm\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://fohs.bgu.ac.il/cmsfohs/hebSite/students/teaching/marks/484/degree-1/y-4/%25D7%25A1%25D7%259E%25D7%25A1%25D7%2598%25D7%25A8%2520%25D7%2590/%25D7%259E%25D7%2595%25D7%25A2%25D7%2593%2520%25D7%2590%2520%25D7%2593%25D7%2599%25D7%25A0%25D7%2599%2520%25D7%25A8%25D7%2595%25D7%25A7%25D7%2597%25D7%2595%25D7%25AA.htm&amp;source=gmail&amp;ust=1792497007546000&amp;usg=AOvVaw0UtseBBdJins9jXtlVzJbp\">http://fohs.bgu.ac.il/cmsfohs/hebSite/students/teaching/marks/484/degree-1/y-4/%D7%A1%D7%9E%D7%A1%D7%98%D7%A8%20%D7%90/%D7%9E%D7%95%D7%A2%D7%93%20%D7%90%20%D7%93%D7%99%D7%A0%D7%99%20%D7%A8%D7%95%D7%A7%D7%97%D7%95%D7%AA.htm</a>&#39;)<br>myGrades &lt;- myTable$`pagehead-2`<br>tur1 &lt;- as.vector(myGrades$V5)<br>tur2 &lt;- as.vector(myGrades$V13)<br>tur3 &lt;- as.vector(myGrades$V21)<br>as.integer(tur1)<br>as.integer(tur2)<br>as.integer(tur3)<br>myGrades &lt;- c(tur1,tur2,tur3)<br>myGrades &lt;- na.omit(myGrades)<br>as.integer(myGrades)<br></div></blockquote><div><br>תודה! <br></div></div></div>"
    ]
   ]
