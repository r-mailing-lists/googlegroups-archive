   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div><h1 style=\"direction:ltr;margin:1.3em 0px 1em;padding:0px;font-weight:bold;font-size:1.6em;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:rgb(221,221,221)\">There is a roomer that it works in Google groups as well</h1>\r\n<p style=\"direction:ltr;margin:1.2em 0px!important\">After enabling TeX Math, we can finally copy proofs from Wikipedia</p>\r\n<p style=\"margin:1.2em 0px!important\"></p><div style=\"direction:ltr\"><img src=\"https://ci6.googleusercontent.com/proxy/MAvtb1B8_EIbem2yXG30JGjDVA0LKrAUL2OhJ3eE14srAMQkPZhXVwVw1KUEwLYFOFM9nX2lDEBTgrc3yAiDWYU40VJ3Ut65It1MTXv1ouwuFTlUAsK5qvCBeNf5Gw=s0-d-e1-ft#https://chart.googleapis.com/chart?cht=tx&amp;chl=z_%7Bi%7D%20%5Csim%20N(0%2C1)\" alt=\"z_{i} \\sim N(0,1)\"></div><div style=\"direction:ltr\"><img src=\"https://ci5.googleusercontent.com/proxy/wDDBFLQ9R352wc6z98tvi7JSKerKt0Iyo-W1W6eXSIoI1XYBSPEVshDL4kig1pwc8BdCUx567j4R_yPw9D5ccLW9jy4N9SOHsnt4-RU08pfrrtJPCq7kppra8UgP1dmVHztMLKHKluIp-cNP45cmPiWu0IR9Esjqc-uk=s0-d-e1-ft#https://chart.googleapis.com/chart?cht=tx&amp;chl=%5CSigma%20z%5E%7B2%7D%20%5Csim%20%5Cchi%5E%7B2%7D_%7Bn%7D\" alt=\"\\Sigma z^{2} \\sim \\chi^{2}_{n}\"></div><p></p>\r\n<p style=\"direction:ltr;margin:1.2em 0px!important\">Some R code</p>\r\n<pre style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;font-size:1em;line-height:1.2em;margin:1.2em 0px\"><code style=\"font-size:0.85em;font-family:Consolas,Inconsolata,Courier,monospace;margin:0px 0.15em;padding:0px 0.3em;white-space:pre-wrap;border:1px solid rgb(234,234,234);border-top-left-radius:3px;border-top-right-radius:3px;border-bottom-right-radius:3px;border-bottom-left-radius:3px;display:inline;background-color:rgb(248,248,248);white-space:pre;overflow:auto;border-top-left-radius:3px;border-top-right-radius:3px;border-bottom-right-radius:3px;border-bottom-left-radius:3px;border:1px solid rgb(204,204,204);padding:0.5em 0.7em;display:block!important;display:block;padding:0.5em;color:rgb(131,148,150);background:rgb(0,43,54)\"><div style=\"direction:ltr\"><span style=\"font-size:0.85em;line-height:1.2em\">z &lt;- rnorm(100)</span></div><div style=\"direction:ltr\"><span style=\"font-size:0.85em;line-height:1.2em\">sum(z^2)</span></div></code></pre>\r\n<p style=\"margin:1.2em 0px!important\">בתאריך יום ראשון, 1 ביוני 2014 16:05:41 UTC+3, מאת ha…@<a href=\"http://loostiger.com\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://loostiger.com&amp;source=gmail&amp;ust=1792497968741000&amp;usg=AOvVaw2auUjHOI6C9ktqkeR9CsZ_\">loostiger.com</a>:</p></div></div>"
    ],
