    [
     2,
     "<div dir=\"ltr\"><font face=\"monospace, monospace\"><span style=\"font-size:12.8000001907349px\">df &lt;-</span><span style=\"font-size:12.8000001907349px\"> </span><span style=\"font-size:12.8000001907349px\">data.frame</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">x =</span><span style=\"font-size:12.8000001907349px\"> </span><span style=\"font-size:12.8000001907349px\">sample</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">c</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">0</span><span style=\"font-size:12.8000001907349px\">:</span><span style=\"font-size:12.8000001907349px\">4</span><span style=\"font-size:12.8000001907349px\">,</span><span style=\"font-size:12.8000001907349px\">8</span><span style=\"font-size:12.8000001907349px\">:</span><span style=\"font-size:12.8000001907349px\">13</span><span style=\"font-size:12.8000001907349px\">, </span><span style=\"font-size:12.8000001907349px\">100</span><span style=\"font-size:12.8000001907349px\">:</span><span style=\"font-size:12.8000001907349px\">102</span><span style=\"font-size:12.8000001907349px\">), </span><span style=\"font-size:12.8000001907349px\">200</span><span style=\"font-size:12.8000001907349px\">, </span><span style=\"font-size:12.8000001907349px\">replace=</span><span style=\"font-size:12.8000001907349px\">T),</span><br style=\"font-size:12.8000001907349px\"><span style=\"font-size:12.8000001907349px\">                 </span><span style=\"font-size:12.8000001907349px\">g =</span><span style=\"font-size:12.8000001907349px\"> </span><span style=\"font-size:12.8000001907349px\">as.factor</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">sample</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">c</span><span style=\"font-size:12.8000001907349px\">(</span><span style=\"font-size:12.8000001907349px\">&quot;M&quot;</span><span style=\"font-size:12.8000001907349px\">,</span><span style=\"font-size:12.8000001907349px\">&quot;F&quot;</span><span style=\"font-size:12.8000001907349px\">), </span><span style=\"font-size:12.8000001907349px\">20</span><span style=\"font-size:12.8000001907349px\">, </span><span style=\"font-size:12.8000001907349px\">replace=</span><span style=\"font-size:12.8000001907349px\">T)))</span><br></font><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\"><br></font></span></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\"># Calculating frequency for each combination</font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\">library(plyr)</font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\">xf = count(df)</font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\"><br></font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\"># Plot with a different color for each gender</font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\">library(ggplot2)</font></span></div><div><span style=\"font-size:12.8000001907349px\"><font face=\"monospace, monospace\">ggplot(xf,aes(x,freq, colour = g)) + geom_point()</font></span><br></div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">On Sat, Aug 1, 2015 at 9:54 AM, Ofrit Lesser <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">ofrit....@gmail.com</a>&gt;</span> wrote:<br></div></div>"
