    [
     3,
     "<div dir=\"rtl\"><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\"><div dir=\"rtl\"><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\"><div dir=\"ltr\"><div dir=\"ltr\"><div style=\"direction:rtl\">היי אור,</div><div dir=\"rtl\">נשמע מגניב, רוצה לשלוח קישור לספר?</div><div dir=\"rtl\">(לצערי אין לי משהו טוב לומר על עברית ו rstudio, היות וזה נושא שהוא עדיין פתוח. אתה מוזמן להוסיף הערה משלך כאן:</div><div dir=\"rtl\"><a href=\"https://github.com/rstudio/rstudio/issues/3808\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://github.com/rstudio/rstudio/issues/3808&amp;source=gmail&amp;ust=1792496403466000&amp;usg=AOvVaw2b-VbLsw-f4XEIGPI7899j\">https://github.com/rstudio/rstudio/issues/3808</a><br></div><div dir=\"rtl\">)</div><div dir=\"rtl\">טל</div><div dir=\"rtl\"><br></div></div></div><br></blockquote></div></blockquote></div></blockquote></div>"
