ft;unicode-bidi:embed;direction:ltr\" dir=\"LTR\"><font face=\"Calibri\"><span><font color=\"#000000\" size=\"3\">  </font></span><font color=\"#000000\" size=\"3\">subject</font><span><font color=\"#000000\" size=\"3\">   </font></span><font color=\"#000000\" size=\"3\">rt ac condition</font><span><font color=\"#000000\" size=\"3\">     </font></span><font color=\"#000000\" size=\"3\">z.score</font></font></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"margin:0cm 0cm 10pt;text-align:left;unicode-bidi:embed;direction:ltr\" dir=\"LTR\"><font face=\"Calibri\"><font color=\"#000000\" size=\"3\">1</font><span><font color=\"#000000\" size=\"3\">      </font></span><font color=\"#000000\" size=\"3\">99 1253</font><span><font color=\"#000000\" size=\"3\">  </font></span><font color=\"#000000\" size=\"3\">1</font><span><font color=\"#000000\" size=\"3\">    \r\n</font></span><font color=\"#000000\" size=\"3\">200_9</font><span><font color=\"#000000\" size=\"3\">  </font></span><font color=\"#000000\" size=\"3\">1.20862682</font></font></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"margin:0cm 0cm 10pt;text-align:left;unicode-bidi:embed;direction:ltr\" dir=\"LTR\"><font face=\"Calibri\"><font color=\"#000000\" size=\"3\">2</font><span><font color=\"#000000\" size=\"3\">      </font></span><font color=\"#000000\" size=\"3\">99 1895</font><span><font color=\"#000000\" size=\"3\">  </font></span><font color=\"#000000\" size=\"3\">1</font><span><font color=\"#000000\" size=\"3\">    \r\n</font></span><font color=\"#000000\" size=\"3\">102_2</font><span><font color=\"#000000\" size=\"3\">  </font></span><font color=\"#000000\" size=\"3\">2.95813507</font></font></p><font color=\"#000000\" face=\"Times New Roman\" size=\"3\">\r\n\r\n</font><p style=\"margin:0cm 0cm 10pt;text-align:left;unicode-bidi:embed;direction:ltr\" dir=\"LTR\"><font face=\"Calibri\"><font color=\"#000000\" size=\"3\">3</font><