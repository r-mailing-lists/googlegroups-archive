    [
     3,
     "<blockquote style=\"BORDER-LEFT:#ccc 1px solid;MARGIN:0px 0px 0px 0.8ex;PADDING-LEFT:1ex\" class=\"gmail_quote\">\r\n<div dir=\"ltr\">\r\n<div dir=\"rtl\">כשאתה יוצר חבילה, אתה צריך להחליט אילו פונקציות זמינות למשתמש ואילו משתמשות רק פונקיות אחרות בחבילה.</div></div>\r\n<div dir=\"ltr\">\r\n<div dir=\"rtl\">האופרטור :: רק מבהיר מאיזו חבילה אתה רוצה את הפונקציה.</div></div>\r\n<div dir=\"ltr\">\r\n<div dir=\"rtl\">האופרטור ::: כופה את החילוץ של הפונקציה מהחבילה גם אם היוצר של החבילה לא תכנן להנגיש אותה למשתמש. </div></div>\r\n<div dir=\"ltr\">\r\n<div dir=\"rtl\">לעוד מידע, תציץ בעזרה של get<br><br></div></div>\r\n</blockquote>"
