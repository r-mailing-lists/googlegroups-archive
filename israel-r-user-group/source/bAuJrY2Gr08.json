    [
     1,
     "<div dir=\"rtl\"><span style=\"font-family:arial,sans-serif;font-size:small\">שלום לכולם,</span><div style=\"font-family:arial,sans-serif;font-size:small\"><br></div><div style=\"font-family:arial,sans-serif;font-size:small\">אני קורא נתונים מאורקל עם RODBC. </div><div style=\"font-family:arial,sans-serif;font-size:small\">שדה המכיל תיאורים בעברית מתקבל כסימני שאלה. </div><div style=\"font-family:arial,sans-serif;font-size:small\">קריאת נתונים בעברית מקובץ CSV מתקבלת בעברית ללא בעיות.</div><div style=\"font-family:arial,sans-serif;font-size:small\"><br></div><div style=\"font-family:arial,sans-serif;font-size:small\">האם יש דרך להתגבר על הבעיה ב-R או שהבעיה נובעת מהאורקל?</div><div style=\"font-family:arial,sans-serif;font-size:small\"><br></div><div style=\"font-family:arial,sans-serif;font-size:small\">תודה,</div><div style=\"font-family:arial,sans-serif;font-size:small\">ארז</div></div>"
    ]
   ]
  },
