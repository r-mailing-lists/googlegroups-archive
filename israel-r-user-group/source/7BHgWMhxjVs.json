   "parts": [
    [
     1,
     "<div dir=\"ltr\"><p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align:right;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">שלום לכולם,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align:right;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">אני משתמש חדש של </span><span dir=\"LTR\">R</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> שמעוניין לבנות גרף עם\r\nעקומות  של </span><span dir=\"LTR\">survival</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> שכולל גם </span><span dir=\"LTR\">confidence interval<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">בניתי  את הגרף ללא </span><span dir=\"LTR\">confidence\r\ninterval</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> <span lang=\"HE\">והכל בסדר אבל כאשר אני מוסיף את<u></u><u></u></span></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">    </span><span dir=\"LTR\"></span><span dir=\"LTR\"></span><span dir=\"LTR\" style=\"background:yellow\"><span dir=\"LTR\"></span><span dir=\"LTR\"></span>= TRUE</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span style=\"font-family:&quot;Arial&quot;,sans-serif;background:yellow\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> </span><span dir=\"LTR\" style=\"background:yellow\"><a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792497234816000&amp;usg=AOvVaw0jiQ69R8HNtoLsoj_Iok5y\">conf.int</a></span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\"><u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">בהגדרות\r\nשל ה- </span><span dir=\"LTR\">plot </span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span>  כדי\r\nשיתן אל ה-</span><span dir=\"LTR\"></span><span dir=\"LTR\"></span><span dir=\"LTR\"><span dir=\"LTR\"></span><span dir=\"LTR\"></span> confidence intervals</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> <span lang=\"HE\"><u></u><u></u></span></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">כל הגרף\r\nמתבלגן <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">אשמח\r\nלקבל רעיונות, <u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0in;margin-bottom:.0001pt;text-align:right;line-height:150%;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">תודה\r\nמראש !!!</span><span dir=\"LTR\"><u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align:right;direction:rtl;unicode-bidi:embed\"><span dir=\"LTR\"><u></u> <u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"text-align:right;direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,sans-serif\">להלו התוכנית בה השתמשתי<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\"><span lang=\"HE\" dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,sans-serif\">#####</span>Adjusted survival curve<span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,sans-serif\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span>#####</span><u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">coxmodel &lt;- coxph(Surv(Follow, CVD==1)~ Age_BMI + Birth_yr + GenderR +\r\nstrata(BMI7grR), data=Data1, method=&quot;breslow&quot;)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">cox &lt;- survfit(coxmodel)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">windows(width=7, height=7); par(lwd=1, las=1, family=&quot;sans&quot;,\r\ncex=1, mgp=c(2.5,1,0))<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">len &lt;- nchar(&quot;BMI7grR&quot;)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">group.levels &lt;- substring(names(cox$strata[cox$strata&gt;0]), len+2)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\"> plot(cox, col=1:32, lty=1, lwd=1,\r\nbty=&quot;l&quot;, mark.time=FALSE, ylim=c(0.98,1), xlab=&quot;Follow&quot;,\r\nylab=&quot;Probability&quot;, <span style=\"background:yellow\"><a href=\"http://conf.int\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://conf.int&amp;source=gmail&amp;ust=1792497234816000&amp;usg=AOvVaw0jiQ69R8HNtoLsoj_Iok5y\">conf.int</a>= TRUE</span>)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">legend(&quot;topright&quot;, group.levels, title=&quot;BMI7grR&quot;,\r\ncol=1:32, lty=1, lwd=1, box.lty=0)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">title(&quot;Survival curve adjusted for Age_BMI + Birth_yr +\r\nGenderR&quot;)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0in;margin-bottom:.0001pt;line-height:150%\">summary(cox)<u></u><u></u></p></div>"
    ]
   ]
