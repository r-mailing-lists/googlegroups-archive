     1,
     "<div dir=\"ltr\"><div><pre style=\"font-family:&quot;Lucida Console&quot;;font-size:10pt;outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\" dir=\"rtl\">אני ר<span><span style=\"color:blue;white-space:pre\">וצה להסיר שורות זהות בתנאי שהן צמודות זו לזו. איך עושים זאת?<br></span></span></pre><pre style=\"font-family:&quot;Lucida Console&quot;;font-size:10pt;outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\" dir=\"rtl\"><span><span style=\"color:blue;white-space:pre\">למשל<br></span></span></pre><pre style=\"font-family:&quot;Lucida Console&quot;;font-size:10pt;outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\"><span><span style=\"color:blue;white-space:pre\">x=&quot;a&quot;<br><pre style=\"font-family:&quot;Lucida Console&quot;;font-size:10pt;outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\"><span><span style=\"color:blue\">y=c(1, 2, 2, 2, 3, 2, 2, 3)</span></span></pre><pre style=\"font-family:&quot;Lucida Console&quot;;font-size:10pt;outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\"><span><span style=\"color:blue\">df&lt;-data.frame(x,y)</span></span></pre></span></span><span><span style=\"color:blue\">\r\n</span><span style=\"outline:medium none currentcolor;border:medium none;word-break:break-all;margin:0px;white-space:pre-wrap\">  x y\r\n1 a 1\r\n2 a 2\r\n3 a 2\r\n4 a 2\r\n5 a 3\r\n6 a 2\r\n7 a 2\r\n8 a 3\r\n</span></span></pre><br></div><div dir=\"rtl\">אני רוצה לקבל<br></div><div>  x y<br></div><div>1 a 1<br></div><div>2 a 2<br></div><div>3 a 3<br></div><div>4 a 2<br></div><div>5 a 3<br></div><div><br></div></div>\r\n"
