     1,
     "<div dir=\"ltr\">random data works fine. if you can attach data then maybe we can see if there is a conflict there<div><br></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ggplot2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">set</span><span style=\"color:#660\">.</span><span style=\"color:#000\">seed</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>df</span><span style=\"color:#660\">=</span><span style=\"color:#000\">data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#000\">rnorm</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#066\">70</span><span style=\"color:#660\">,</span><span style=\"color:#066\">20</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>              y</span><span style=\"color:#660\">=</span><span style=\"color:#000\">runif</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>              day</span><span style=\"color:#660\">=</span><span style=\"color:#000\">sample</span><span style=\"color:#660\">(</span><span style=\"color:#000\">letters</span><span style=\"color:#660\">[</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">4</span><span style=\"color:#660\">)],</span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#000\">replace </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> T</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>              sex</span><span style=\"color:#660\">=</span><span style=\"color:#000\">sample</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;m&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&#39;f&#39;</span><span style=\"color:#660\">),</span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#000\">replace </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> T</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br>ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">df</span><span style=\"color:#660\">,</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#000\">x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> y</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> <br>  geom_rect</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fill </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> day</span><span style=\"color:#660\">),</span><span style=\"color:#000\">xmin </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">-</span><span style=\"color:#606\">Inf</span><span style=\"color:#660\">,</span><span style=\"color:#000\">xmax </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Inf</span><span style=\"color:#660\">,</span></div></code></div></div></div>"
