     1,
     "<div dir=\"ltr\"><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\">setwd(&quot;C:/.../dir_of_files&quot;)</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># directory name </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># (the script assumes that the new directory is placed inside the working directory)</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\">new_dir &lt;- &quot;my_name&quot; </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"> </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\">addition_to_file&lt;- &quot;whatever&quot;</font></div><div class=\"gmail_default\"><span style=\"font-family:tahoma,sans-serif\">list_of_files &lt;- list.files()</span><br></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\">for (file1 in list_of_files){</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><span style=\"white-space:pre-wrap\">\t</span>tbl &lt;- read.csv(file1)</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># apply your function - &#39;f&#39;</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><span style=\"white-space:pre-wrap\">\t</span>results &lt;- f(tbl) </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># remove .csv extension from file name</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><span style=\"white-space:pre-wrap\">\t</span>file1_nocsv &lt;- unlist(strsplit(file1,&quot;.csv&quot;, fixed = TRUE)) </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># the name of the new file</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><span style=\"white-space:pre-wrap\">\t</span>new_file_name &lt;- paste(new_dir,&quot;/&quot;,file1_nocsv,&quot;_&quot;,addition_to_file,&quot;.csv&quot;, sep = &quot;&quot;) </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"># write &#39;results&#39; to </font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\"><span style=\"white-space:pre-wrap\">\t</span>write.csv( results, file = new_file_name )</font></div><div class=\"gmail_default\"><font face=\"tahoma, sans-serif\">}</font></div><div><br></div></div><div class=\"gmail_extra\"></div></div>"
