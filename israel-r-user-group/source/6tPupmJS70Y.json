     "<div dir=\"ltr\"><div><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 .8ex;border-left:1px #ccc solid;border-right:1px #ccc solid;padding-left:1ex;padding-right:1ex\"><div dir=\"ltr\"><div style=\"font-family:tahoma,sans-serif\" dir=\"rtl\">אם הדיון עדיין על הפרק, אז אני רק אגן לרגע על R ואגיד שאין שום בעיה לעשות מעשה <b>מכוער </b>שכזה: (למשל להרצה כל יום בשעה 10 וחצי)</div><div style=\"direction:ltr;font-family:tahoma,sans-serif\" dir=\"rtl\">while (TRUE){</div><div style=\"font-family:tahoma,sans-serif\" dir=\"rtl\"><div dir=\"rtl\" style=\"direction:ltr\">if( format(Sys.time(), &quot;%H:%M:%S&quot;) == &quot;10:30:00&quot; ){</div><div dir=\"rtl\" style=\"direction:ltr\"># YOUR_CODE_HERE</div><div dir=\"rtl\" style=\"direction:ltr\">  break()</div><div dir=\"rtl\" style=\"direction:ltr\">}</div><div dir=\"rtl\" style=\"direction:ltr\">}</div><div><br></div></div></div></blockquote></div></div></blockquote></div></div></div>"
