itial;background-clip:initial;background-position:initial;background-repeat:initial\"><span lang=\"HE\" style=\"font-size:10pt;font-family:Arial,sans-serif\">דוגמא 1 (רגרסיה\r\nלוגיסטית)<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0.0001pt;direction:rtl;unicode-bidi:embed;background-image:initial;background-size:initial;background-origin:initial;background-clip:initial;background-position:initial;background-repeat:initial\"><span lang=\"HE\" style=\"font-size:10pt;font-family:Arial,sans-serif\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"margin-bottom:0.0001pt;direction:rtl;unicode-bidi:embed;background-image:initial;background-size:initial;background-origin:initial;background-clip:initial;background-position:initial;background-repeat:initial\"><span lang=\"HE\" style=\"font-size:10pt;font-family:Arial,sans-serif\"> </span></p>\r\n\r\n<p class=\"MsoNormal\">mdl &lt;- glm(formula = BUYER_FLAG ~ . , family=\r\n&quot;binomial&quot;, data = ds_tr<span dir=\"RTL\"></span><span dir=\"RTL\"></span><span dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> <span lang=\"HE\">(</span></span><u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\">y_hat = predict(mdl, data = ds_tr , type = &#39;response<span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span>(</span><span lang=\"HE\" dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">&#39;<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">אני מניחה שהקריאה של הנתונים תהיה באופן הבא:<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\">ds = read.csv(file_path, na.strings=&quot;&quot;)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">ואז את </span><span dir=\"LTR\">ds</span><span dir=\"RTL\"></span><span dir=\"RTL\"></span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><span dir=\"RTL\"></span><span dir=\"RTL\"></span> אני אתן בתור </span><span dir=\"LTR\">newdata</span><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\">y_hat = predict(mdl, newdata =  ds, type = &#39;response&#39;)<span lang=\"HE\" dir=\"RTL\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"><u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\">y = (ds_te$BUYER_FLAG == 1)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\">cutoff= (y_hat &gt; 0.5)<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" dir=\"RTL\" style=\"direction:rtl;unicode-bidi:embed\"><span lang=\"HE\" style=\"font-family:&quot;Arial&quot;,&quot;sans-serif&quot;\">איך אני שופכת את התוצאות לקובץ טקסט? תודה!</span></p></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote></blockquote><div><br></div>"
