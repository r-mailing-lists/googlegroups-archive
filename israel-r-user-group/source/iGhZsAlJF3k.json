     1,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><span><font color=\"#888888\"><span style=\"text-indent:0px;letter-spacing:normal;font-variant:normal;text-align:-webkit-left;font-style:normal;background-color:rgb(225,226,229);font-weight:normal;line-height:15px;border-collapse:separate;text-transform:none;font-size:13px;white-space:pre-wrap;font-family:&#39;Lucida Console&#39;;word-spacing:0px\"></span>\r\n\r\n<p></p>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;Israel R User Group&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href data-email-masked rel=\"nofollow\">israel-r-user-g...@googlegroups.com</a>.<br>\r\n\r\n\r\nFor more options, visit <a href=\"https://groups.google.com/groups/opt_out\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/groups/opt_out&amp;source=gmail&amp;ust=1792498313470000&amp;usg=AOvVaw3hV4Rzg8itrQzvktTV1iZR\">https://groups.google.com/groups/opt_out</a>.<br>\r\n <br>\r\n <br>\r\n</font></span></blockquote></div><br></div>\r\n"
