#Here is a simplified code following Amit's remark:

f <- function(x,Pi.samples,alpha.marker,Pi.markers)
{
  C1 <- qnorm(1-Pi.markers)
  integrand <- (pnorm(x,sqrt(Pi.samples)*x,
           sqrt(1-Pi.samples),lower.tail=F)) * dnorm(x)/
(pnorm(C1,lower.tail=F))

  p.joint <- integrate( integrand , C1, Inf)$value
  return(p.joint - alpha.marker/Pi.markers)
}

alpha.marker <- 0.05/300000

Pi.samples <- 0.5
Pi.markers <- 0.1

C.joint<- uniroot(f, c(-7,7),
Pi.samples=Pi.samples,alpha.marker=alpha.marker,Pi.markers=Pi.markers)
$root

#Now I get " Error in get(as.character(FUN), mode = "function", envir
= envir) :
  object 'integrand' of mode 'function' was not found "
#which is obscure since the integrand computation runs smooth...

