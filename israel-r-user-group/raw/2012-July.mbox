אני לא יודע לגבי פונקציות מקומפלות, אבל האינטרפרטר של R לא יודע לעשות את זה (לפחות לא זה שלי). כגודל הציפיות, כך גודל האכזבה...

> f1 <- function(x){
+ return(pnorm(x) * pnorm(1))
+ }
>
> const <- pnorm(1)
> f2 <- function(x){
+ return(pnorm(x) * const)
+ }
>
> system.time(sapply(1:1000000,f1))
   user  system elapsed
  12.39    0.08   12.61
> system.time(sapply(1:1000000,f2))
   user  system elapsed
   7.08    0.01    7.10
>

