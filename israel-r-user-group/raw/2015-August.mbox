שלום לכולם,

אני משתמש חדש של R שמעוניין לבנות גרף עם עקומות  של survival שכולל גם confidence interval

בניתי  את הגרף ללא confidence interval והכל בסדר אבל כאשר אני מוסיף את

    = TRUE conf.int <http://conf.int>

בהגדרות של ה- plot   כדי שיתן אל ה- confidence intervals

כל הגרף מתבלגן

אשמח לקבל רעיונות,

תודה מראש !!!

להלו התוכנית בה השתמשתי

#####Adjusted survival curve#####

coxmodel <- coxph(Surv(Follow, CVD==1)~ Age_BMI + Birth_yr + GenderR + strata(BMI7grR), data=Data1, method="breslow")

cox <- survfit(coxmodel)

windows(width=7, height=7); par(lwd=1, las=1, family="sans", cex=1, mgp=c(2.5,1,0))

len <- nchar("BMI7grR")

group.levels <- substring(names(cox$strata[cox$strata>0]), len+2)

 plot(cox, col=1:32, lty=1, lwd=1, bty="l", mark.time=FALSE, ylim=c(0.98,1), xlab="Follow", ylab="Probability", conf.int <http://conf.int>= TRUE)

legend("topright", group.levels, title="BMI7grR", col=1:32, lty=1, lwd=1, box.lty=0)

title("Survival curve adjusted for Age_BMI + Birth_yr + GenderR")

summary(cox)

