library(stringr)
a=read.table("http://pisa2009.acer.edu.au/downloads/INT_SCQ09_SAS_DEC11.sas",sep="\t")
a1=str_split(str_trim(a[(which(grepl('length',str_trim(a[,1])))+1):(which(grepl('infile',str_trim(a[,1])))-1),1])," ")
b=as.numeric(gsub("[$.;]","",unlist(lapply(a1,tail,1))))
a3=a1[[which(is.na(b))]]
b[is.na(b)]=as.numeric(gsub("[A-Z$.;]","",a3[which(grepl("[1-9]",a3))]))
varnames=unlist(lapply(a1,head,1))
