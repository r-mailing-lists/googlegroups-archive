אפשר להשתמש ב-sub ו-gsub. הראשון מביניהם מתייחס להתאמה הראשונה בלבד, והשני לכל ההתאמות:

x = c(
  "x12288.14.12.2014",
  "x12288.15.12.2014",
  "x12288.16.12.2014",
  "x12288.17.12.2014",
  "x12288.18.12.2014",
  "x6815.17.12.2014",
  "x6815.18.12.2014",
  "x6815.17.12.2014",
  "x6815.21.3.2014",
  "x6815.9.4.2015"
)

x = sub(".", " ", x, fixed = TRUE)
x = gsub(".", "/", x, fixed = TRUE)
x

