נטול כל חן, אבל עובד (כמדומני)
test<- function(x){
  temp<- deparse(match.call())
  temp2<- unlist(strsplit(x=temp,split='', fixed=TRUE ))
  a<- grep(x=temp2, fixed=TRUE, pattern="="  )
  b<- grep(x=temp2, fixed=TRUE, pattern=")"  )
  c<- grep(x=temp2, fixed=TRUE, pattern="/"  )
  return(list(
    as.numeric(paste(temp2[(a+2):(c-1)], collapse="")),
    as.numeric(paste(temp2[(c+1):(b-1)], collapse=""))))
}
test(1222/87)

