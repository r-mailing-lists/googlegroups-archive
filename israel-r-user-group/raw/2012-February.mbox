הגעתי ל41 נקודות קנס עד כדי טעויות בספירה. אפשר כמובן לדחוס את הכל לשורה אחת אבל זה 3 נקודות קנס נוספות והרבה פחות קריא.

df <- data.frame(a=1,b=2,c=3,d=4)
#### start here
df.name <http://df.name> <- "df" # 0
names <- names(df) # -3
l <- length(names) # -3
text<- paste(rep(sprintf("%s=%s$%s","%s",df.name <http://df.name>,"%s"),l),collapse=";") # -14
cmd <- do.call(sprintf,c(fmt=text,as.list(rep(names,e=2)))) # -15
eval(parse(text=cmd)) # -6

