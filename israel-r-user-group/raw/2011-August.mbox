yizhar <- function(x) sapply(seq_along(x), function(j) {sum((x[1:j])[x[j] == x[j]])})

aya<- function(x){
counts <- rep(0,max(x))
y <- vector(length=n, mode="integer")
n<- length(x)
for (i in 1:n){
    counts[x[i]+1] <- counts[x[i]+1] + 1
    y[i] <- counts[x[i]+1]*x[i]
  }
return(y)
}

x <- c(1,1,2,1)

aya(x)
yizhar(x)

