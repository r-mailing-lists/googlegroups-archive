 אני מנסה להוריד מידע אוטומטית מיד 2 ולבצע גיאוקודינג
הקוד עובד יופי על המחשב המקומי אבל נחסם מהסרבר :
library(XML)
library(RCurl)
theurl <- "http://www.yad2.co.il/Nadlan/sales.php?City=%E9%F8%E5%F9%EC%E9%ED&Neighborhood=&HomeTypeID=1&fromRooms=3&untilRooms=3&fromPrice=&untilPrice=&PriceType=1&FromFloor=&ToFloor=&Info="
url<-getURL(theurl)
tables <- readHTMLTable(url)
