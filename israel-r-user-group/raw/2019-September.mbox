+     ), error = function(c) return(data.frame())
+   )
+   if(length(d) == 0) return(data.frame())
+   return(data.frame(lon = as.numeric(d$lon), lat = as.numeric(d$lat)))
+ }
>
> nominatim_osm("תל-אביב")
       lon      lat
1 34.78053 32.08048
> nominatim_osm("אילת")
