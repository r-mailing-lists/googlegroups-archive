MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Hi Amit,

You can add the edge only if it doesn't exist & otherwise increment the weight.

Example:

# Create a ring graph

g <- graph.ring(10)

# Add a weight attribute and set to 1

E(g)$weight <- 1

# Increment weight for an existing edge (example)

u <- 1

v <- 2

if (are.connected(g, u, v)) {

  E(g, c(u,v))$weight <- E(g, c(u,v))$weight + 1

} else {

  g <- add.edges(g, c(u,v))

  E(g, c(u,v))$weight <- 1

}

# Add a new edge  (example)

u <- 1

v <- 3

if (are.connected(g, u, v)) {

  E(g, c(u,v))$weight <- E(g, c(u,v))$weight + 1

} else {

  g <- add.edges(g, c(u,v))

  E(g, c(u,v))$weight <- 1

}

Ofrit

