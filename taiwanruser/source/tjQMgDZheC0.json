left:1em;margin-right:1em\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-Tg3HiMTZMAg/WZW6mwO_fSI/AAAAAAAAL3g/RLEd-fMsFT8trXQ-h2lVtoP0h5DZBrUjwCLcBGAs/s1600/biosignalEMG.png&amp;source=gmail&amp;ust=1793237602165000&amp;usg=AOvVaw06Sq8ANFxZI_JuefGZsXRx\"><img src=\"https://lh3.googleusercontent.com/-Tg3HiMTZMAg/WZW6mwO_fSI/AAAAAAAAL3g/RLEd-fMsFT8trXQ-h2lVtoP0h5DZBrUjwCLcBGAs/s320/biosignalEMG.png\" border=\"0\" width=\"320\" height=\"240\"></a></p><div><br></div><div>6. R code</div><div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><font color=\"#666600\"><div># title: 肌電信號EMG</div><div># date: 2017.8.17</div><div><br></div><div>library(biosignalEMG)</div><div><br></div><div>integrate(dnorm, -1.96, 1.96) # 0.9500042</div><div>integrate(dnorm, -Inf, Inf) # 1</div><div><br></div><div>x &lt;- read.table(&quot;emgsignal.csv&quot;, header=TRUE, sep=&quot;,&quot;)</div><div>str(x)</div><div>op &lt;- par(mfrow = c(2, 2))</div><div><br></div><div># plot1</div><div>plot(x$Ch1, type=&quot;l&quot;, main=&quot;graphics package&quot;)</div><div><br></div><div># plot2</div><div>emg &lt;- as.emg(x$Ch1, samplingrate=1000, units=&quot;mV&quot;) # need to verify?</div><div>plot(emg, main=&quot;biosignalEMG package&quot;)</div><div><br></div><div># plot3</div><div>emgr &lt;- rectification(emg, rtype = &quot;fullwave&quot;)</div><div>emgi &lt;- integration(emgr, reset = FALSE)</div><div>plot(emgi, main = &quot;Integrated EMG (no reset)&quot;)</div><div><br></div><div># plot4</div><div>emgma &lt;- envelope(emgr, method = &quot;MA&quot;, wsize = 60)</div><div>plot(emg, main = &quot;MA-envelope&quot;)</div><div>plot(emgma, add = TRUE, lwd = 4, col = &quot;red&quot;)</div><div><br></div><div>par(op)</div><div><br></div><div>?integration # integration of an EMG</div><div># end</div></font>