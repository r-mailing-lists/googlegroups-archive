    [
     1,
     "<div dir=\"ltr\"><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-7NiRsr4Ck7A/WDgjFza1C4I/AAAAAAAACd0/YcStgwd-RegjFVuS2EIwAxyHzXJtzY1QgCLcB/s1600/or.PNG\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-7NiRsr4Ck7A/WDgjFza1C4I/AAAAAAAACd0/YcStgwd-RegjFVuS2EIwAxyHzXJtzY1QgCLcB/s1600/or.PNG&amp;source=gmail&amp;ust=1793237838774000&amp;usg=AOvVaw1mReNB7L9FJYQ-e6uiO8pc\"><img src=\"https://lh3.googleusercontent.com/-7NiRsr4Ck7A/WDgjFza1C4I/AAAAAAAACd0/YcStgwd-RegjFVuS2EIwAxyHzXJtzY1QgCLcB/s1600/or.PNG\" border=\"0\"></a></p><div><br></div><div>我先將你的原始資料另存成CSV -&gt; tej.csv</div><div><br></div><div>設定工作目錄為 C 槽的 rtej</div><div><br></div><div><br></div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div>setwd(&quot;C:/rtej&quot;)</div><div>getwd()</div><div><br></div><div>tmprt = function(rtcsv){</div><div>read.csv( rtcsv, stringsAsFactors = FALSE)</div><div>}</div><div><br></div><div>wrta = function(xdo , ycsv)</div><div>{</div><div><span style=\"white-space:pre\">\t</span>write.table( xdo, file= ycsv, quote = FALSE, sep = &quot;,&quot;, row.names = FALSE)</div><div>}</div><div><br></div><div>dir()</div><div>tejdata = tmprt(&quot;tej.csv&quot;)</div><div>head( tejdata, 3)</div><div><br></div><div># clear</div><div>tejcol = names(tejdata)</div><div>tejcol[1] = &quot;year&quot;</div><div>colnames(tejdata) = tejcol</div><div>tejdata = tejdata[, 2:ncol(tejdata)]</div><div>head( tejdata, 3)</div><div><br></div><div>#Test</div><div># 小至大 ，decreasing = FALSE</div><div>sort( tejdata$X2016.10.31)</div><div># 大至小</div><div>sort( tejdata$X2016.10.31, decreasing = TRUE)</div><div><br></div><div><br></div><div>worksort = function(dt ,chrn) {</div><div><span style=\"white-space:pre\">\t</span>sortdf = data.frame( nm = 1:rep(nrow(dt)))</div><div><span style=\"white-space:pre\">\t</span>dtna = names(dt)</div><div><span style=\"white-space:pre\">\t</span>for( sorwn in 1:ncol(dt)){</div><div><span style=\"white-space:pre\">\t\t</span>cmds = paste0(chrn,&quot;$&quot;, dtna[sorwn])</div><div><span style=\"white-space:pre\">\t\t</span>evaltem = eval(parse(text = cmds))</div><div><span style=\"white-space:pre\">\t\t</span>temscl = sort( evaltem, decreasing = FALSE, na.last= TRUE)</div><div><span style=\"white-space:pre\">\t\t</span>sortdf = cbind(sortdf, temscl)</div><div><span style=\"white-space:pre\">\t</span>}</div><div><span style=\"white-space:pre\">\t</span>sortdfcol = c( &quot;nm&quot;, dtna)</div><div><span style=\"white-space:pre\">\t</span>colnames(sortdf) = sortdfcol</div><div><span style=\"white-space:pre\">\t</span>sortnm = paste0( chrn,&quot;sortproc&quot;)</div><div><span style=\"white-space:pre\">\t</span>assign( sortnm,</div><div><span style=\"white-space:pre\">\t\t</span>sortdf</div><div><span style=\"white-space:pre\">\t</span>, env = .GlobalEnv)</div><div>}</div><div><br></div><div>worksort( tejdata, &quot;tejdata&quot;)</div><div><br></div><div>wrta( tejdatasortproc, &quot;tejsort.csv&quot;)</div></div></blockquote><div><br></div><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-Ac5Q1nnmrRk/WDgjadou8hI/AAAAAAAACd4/xcftxsu6CboZNiR55-0vXDTMWNK7aCvxACLcB/s1600/en.PNG\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-Ac5Q1nnmrRk/WDgjadou8hI/AAAAAAAACd4/xcftxsu6CboZNiR55-0vXDTMWNK7aCvxACLcB/s1600/en.PNG&amp;source=gmail&amp;ust=1793237838774000&amp;usg=AOvVaw2fWhPgiq9yF-ur7N7evlW0\"><img src=\"https://lh3.googleusercontent.com/-Ac5Q1nnmrRk/WDgjadou8hI/AAAAAAAACd4/xcftxsu6CboZNiR55-0vXDTMWNK7aCvxACLcB/s1600/en.PNG\" border=\"0\"></a></p><div>匯出 結果為 tejsort.csv</div><div><br></div><div><br></div><div><br></div></div>"
    ]
