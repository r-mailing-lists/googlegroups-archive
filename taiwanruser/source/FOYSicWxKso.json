    [
     1,
     "<div dir=\"ltr\">我想問在R 內的 IF速度很慢的問題.<div>我想在我的data.frame 找出一個column 是否等1 and 同一個rows 內的column 是否等於2....</div><div>我的code 如下:</div><div><div>NUM=nrow(data)</div><div>for (i in 1:NUM) {</div></div><div>if ((data[i,&quot;f1] == 1) &amp;&amp; (data[i,&quot;f2&quot;]==2)) {</div><div><div>                CASE=data.frame(data[i,&#39;date&#39;],data[i,&#39;abc&#39;])</div><div>        } else if ((data[i,&quot;f1] == 0) &amp;&amp; (data[i,&quot;f2&quot;]==2)) {</div></div><div><div>                CASE=data.frame(data[i,&#39;date&#39;],data[i,&#39;def&#39;])</div></div><div>}</div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div><div><br></div></div>"
    ]
   ]
