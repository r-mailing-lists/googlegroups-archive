or=\"#666600\">mydf$Display &lt;- unlist(by(mydf, mydf$ID, function(x) {</font></div><div><font color=\"#666600\">  </font></div><div><font color=\"#666600\">  print(&quot;=====================&quot;)</font></div><div><font color=\"#666600\">  print(paste0(&quot;iteration :         &quot;, x[1,1]))</font></div><div><font color=\"#666600\">  print(&quot;=====================&quot;)</font></div><div><font color=\"#666600\"><br></font></div><div><font color=\"#666600\">  if (nrow(x) &gt; 1) { # 群組資料有2列以上</font></div><div><font color=\"#666600\">    </font></div><div><font color=\"#666600\">    results &lt;- rep(NA, nrow(x))</font></div><div><font color=\"#666600\">    </font></div><div><font color=\"#666600\">    for (i in 1:(nrow(x)-1)) { # 比較群組的第1列至倒數第2列</font></div><div><font color=\"#666600\">      </font></div><div><font color=\"#666600\">      if (results[i] != 0 | <a href=\"http://is.na\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1793237739201000&amp;usg=AOvVaw28zrgx9K4PIsJG4ymediIN\">is.na</a>(results[i])) {</font></div><div><font color=\"#666600\">        </font></div><div><font color=\"#666600\">        results[i] &lt;- 1 # 如果是NA表示仍要判斷;1表示不重複</font></div><div><font color=\"#666600\">        </font></div><div><font color=\"#666600\">        for (j in (i+1):nrow(x)) {</font></div><div><font color=\"#666600\">          </font></div><div><font color=\"#666600\">          print(paste0(&quot;i = &quot;, i , &quot; , j = &quot;, j))</font></div><div><font color=\"#666600\">          </font></div><div><font color=\"#666600\">          if (<a href=\"http://is.na\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1793237739201000&amp;usg=AOvVaw28zrgx9K4PIsJG4ymediIN\">is.na</a>(results[j])) { # <a href=\"http://is.na\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1793237739201000&amp;usg=AOvVaw28zrgx9K4PIsJG4ymediIN\">is.na</a>結果TRUE,表示進行判斷</font></div><div><font color=\"#666600\">            </font></div><div><font color=\"#666600\">            if (x[j,3] == x[i,3] &amp; ((j-i) == 1)) {</font></div><div><font color=\"#666600\">              </font></div><div><font color=\"#666600\">              results[j] &lt;- 0 # 0表示重複,不用顯示</font></div><div><font color=\"#666600\">              </font></div><div><font color=\"#666600\">            }</font></div><div><font color=\"#666600\">            else {</font></div><div><font color=\"#666600\">              results[j] &lt;- 1 # 1表示不重複,須保留顯示</font></div><div><font color=\"#666600\">            }</font></div><div><font color=\"#666600\">            </font></div><div><font color=\"#666600\">          }</font></div><div><font color=\"#666600\">          </font></div><div><font color=\"#666600\">        }</font></div><div><font color=\"#666600\">        </font></div><div><font color=\"#666600\">        </font></div><div><font color=\"#666600\">      }</font></div><div><font color=\"#666600\">    }</font></div><div><font color=\"#666600\"><br></font></div><div><font color=\"#666600\">    print(results)</font></div><div><font color=\"#666600\"><br></font></div><div><font color=\"#666600\">  }</font></div><div><font color=\"#666600\">  </font></div><div><font color=\"#666600\">  else { # 群組資料只有1列</font></div><div><font color=\"#666600\">    results &lt;- 1</font></div><div><font color=\"#666600\">    print(x)</font></div><div><font color=\"#666600\">    </font></div><div><font color=\"#666600\">  }</font></div><div><font color=\"#666600\">  </font></div><div><font color=\"#666600\">  return(results)</font></div><div><font color=\"#666600\">}))</font></div><div><font color=\"#666600\">mydf</font></div><div><font color=\"#666600\">mydf[mydf$Display == 1, 1:3]</font></div><div><font color=\"#666600\"># end</font></div></div></code></div><br><br>ike chang於 2017年3月22日星期三 UTC+8上午11時12分39秒寫道：<blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\">想詢問各位先進目前可以將(1)修改為(2)，因為還剛開始學習，對於(3)應該要如何加入判斷式的方式還不了解，不知道有沒有人可以協助，或提供相關文件，謝謝!!<div><br><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-yRdfd0nOEBo/WNHrEuWaLsI/AAAAAAAABVk/6mBZVtDn8AsGCVz3KiNt6_7nXXCjA_EQgCLcB/s1600/image.png\" style=\"clear:left;margin-bottom:1em;float:left;margin-right:1em\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-yRdfd0nOEBo/WNHrEuWaLsI/AAAAAAAABVk/6mBZVtDn8AsGCVz3KiNt6_7nXXCjA_EQgCLcB/s1600/image.png&amp;source=gmail&amp;ust=1793237739201000&amp;usg=AOvVaw3M36KT4qxuKVwf3ty69rER\"><img src=\"https://lh3.googleusercontent.com/-yRdfd0nOEBo/WNHrEuWaLsI/AAAAAAAABVk/6mBZVtDn8AsGCVz3KiNt6_7nXXCjA_EQgCLcB/s400/image.png\" border=\"0\" width=\"400\" height=\"127\"></a></p><div><br></div></div></div></blockquote></div></div></blockquote></div></div></blockquote></div></div>"
    ]
