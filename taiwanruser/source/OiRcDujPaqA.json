     2,
     "<div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><div><font color=\"#666600\"><br></font></div><div><font color=\"#666600\">library (raster)</font></div><div><font color=\"#666600\">r &lt;- raster(ncol=10, nrow=10)</font></div><div><font color=\"#666600\">values(r) &lt;- 1:ncell(r)</font></div></div></code></div></div>"
