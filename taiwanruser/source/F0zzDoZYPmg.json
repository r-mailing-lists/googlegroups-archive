     1,
     "<div><b>FibonacciNumbers.R</b><br></div><div><br></div><div># title: Fibonacci numbers</div><div># date: 2013.1.13</div><div>Fibonacci &lt;- function(x) {</div><div>  fn = numeric(x)</div><div>  fn[1] = 1</div><div>  fn[2] = 1</div><div>  for (i in 3:length(fn)) {</div><div>    fn[i] = fn[i-1] + fn[i-2]</div><div>  }</div><div>  return(max(fn)) # return(fn) for all values</div><div>}</div><div><br></div><div>Fibonacci(50)</div><div># end</div><br>WEPA ^_^於 2013年1月13日星期日UTC+8上午1時39分39秒寫道："
    ],
