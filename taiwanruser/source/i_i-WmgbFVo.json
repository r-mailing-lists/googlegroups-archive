     1,
     "<div dir=\"ltr\">補充一下 因為每次都取代掉了，所以你rbind一下就可以了，以下是隨便弄的，結果會是你想要的，建議精修一下<div><div><br></div><div>for(x in c(1:24))</div><div>{</div><div>  if(x&gt;=2)</div><div>  {</div><div>    tmp=paste(&quot;<a href=\"http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/&amp;source=gmail&amp;ust=1793237467204000&amp;usg=AOvVaw1Sg3aoZ5P2xHn9GvQO_ScC\">http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/</a>&quot;,paste(day,time[x],paste(&#39;TDCS_M04A_&#39;,day,time[x],sep=&#39;_&#39;),sep=&quot;/&quot;),minute,&quot;00&quot;,&quot;.csv&quot;,sep=&#39;&#39;)</div><div>    urls=rbind(urls, tmp)</div><div>  }</div><div>  else</div><div>  {</div><div>    urls&lt;- paste(&quot;<a href=\"http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/&amp;source=gmail&amp;ust=1793237467204000&amp;usg=AOvVaw1Sg3aoZ5P2xHn9GvQO_ScC\">http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/</a>&quot;,paste(day,time[x],paste(&#39;TDCS_M04A_&#39;,day,time[x],sep=&#39;_&#39;),sep=&quot;/&quot;),minute,&quot;00&quot;,&quot;.csv&quot;,sep=&#39;&#39;)</div><div>  }  </div><div>}</div></div></div>"
    ]
