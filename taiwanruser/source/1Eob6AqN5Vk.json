     1,
     "<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><font size=\"4\"><span style=\"font-family:標楷體;color:black\">我用<span lang=\"EN-US\">R</span>寫一個逆矩陣<span lang=\"EN-US\">(52*52)</span>的程式，請教有辦法提高結果的精確度<span lang=\"EN-US\">(</span>再多個<u></u>一兩<u></u>位小數<span lang=\"EN-US\">)</span>嗎？非常謝謝！</span><span lang=\"EN-US\" style=\"font-family:新細明體;color:black\"><u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:black\"><u></u><font size=\"4\"> </font><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><font size=\"4\"><span style=\"font-family:標楷體;color:black\">我的程式：</span><span lang=\"EN-US\" style=\"font-family:新細明體;color:black\"><u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">aa &lt;- scan( file = &quot;data1.txt&quot;, sep =\r\n&quot;\\t&quot;)<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">A &lt;- matrix( aa, nrow=52, byrow=TRUE)<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">print(A)<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">b &lt;- diag(52)-A<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">library(matrixcalc)<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">inv &lt;- matrix.inverse( b )<u></u><u></u></font></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-position:initial initial;background-repeat:initial initial\"><span lang=\"EN-US\" style=\"font-family:標楷體;color:blue\"><font size=\"4\">print( inv )</font></span><span lang=\"EN-US\" style=\"font-family:新細明體;color:black\"><u></u><u></u></span></p>"
    ]
   ]
