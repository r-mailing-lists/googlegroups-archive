     "<div dir=\"ltr\"><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><p class=\"MsoNormal\"><span lang=\"EN-US\">TWDtoF &lt;- function (input_la, input_lb){  </span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  a =\r\n6370</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  b =\r\n5000</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  e =\r\n(1 - b^2 / a^2)^0.5</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  la\r\n=a +(b*e)</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  lb = b+e</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">  ans = list(la = la, b = lb)</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"> \r\nreturn(ans)</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">}</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"> </span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">Data1</span><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">內容如下</span><span lang=\"EN-US\">,</span><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">有三欄位</span><span lang=\"EN-US\"></span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"> </span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">a     b    \r\nc </span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">10   \r\n20    30</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">5    \r\n10    40</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">20   \r\n30    30  </span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">………………………..</span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">想利用</span><span lang=\"EN-US\">apply </span><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">函數</span><span lang=\"EN-US\">,</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"> \r\nTWDtoF(data1$a,data1$b)</span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"> </span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">轉換為</span><span lang=\"EN-US\"> data2 </span><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">有五欄位</span><span lang=\"EN-US\"></span></p>\r\n\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">a      b   \r\nc   la   lb  </span></p><p class=\"MsoNormal\"><span lang=\"EN-US\">10   20  30  ?   ?</span></p><p class=\"MsoNormal\"><span lang=\"EN-US\">........................</span></p>\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">不知如何使用</span><span lang=\"EN-US\"> \r\napply</span><span style=\"font-family:&quot;\\0065b0\\007d30\\00660e\\009ad4&quot;,serif\">家族函式</span><span lang=\"EN-US\">? </span></p><p class=\"MsoNormal\"><span lang=\"EN-US\"><br></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\">感謝各位先進</span></p></div></blockquote></div>"
