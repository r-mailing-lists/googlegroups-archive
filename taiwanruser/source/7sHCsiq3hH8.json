    [
     1,
     "Hi Amy,<div><br></div><div>參考以下R程式與附圖, 目前mdy執行正常, 再測試看看.</div><div><br></div><div><div><font face=\"Courier New\"># Windows 10, 64位元, 繁體中文版</font></div><div><font face=\"Courier New\">library(lubridate)</font></div><div><font face=\"Courier New\">stock &lt;- read.table(&quot;0001.csv&quot;, header = TRUE, sep =&quot;,&quot;)</font></div><div><font face=\"Courier New\">str(stock)</font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">mdy(&quot;Aug 08,2019&quot;)</font></div><div><font face=\"Courier New\"># [1] &quot;2019-08-08&quot;</font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">mdy(&quot;Jul 31,2019&quot;)</font></div><div><font face=\"Courier New\"># [1] &quot;2019-07-31&quot;</font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">head(stock)</font></div><div><font face=\"Courier New\">head(mdy(stock$Date))</font></div><div><font face=\"Courier New\"># mdy 資料轉換正常</font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\"><img alt=\"lubridate日期處理.png\" width=\"841px\" height=\"537px\" src=\"https://groups.google.com/group/taiwanruser/attach/683ce65ec376e/lubridate%E6%97%A5%E6%9C%9F%E8%99%95%E7%90%86.png?part=0.1&amp;view=1\"><br></font></div><br></div><div class=\"gmail_quote\"><div dir=\"auto\" class=\"gmail_attr\"><a href data-email-masked rel=\"nofollow\">amy90...@gmail.com</a> 在 2021年5月19日 星期三上午11:45:40 [UTC+8] 的信中寫道：<br></div></div>"
