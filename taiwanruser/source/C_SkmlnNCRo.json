    [
     1,
     "<div dir=\"ltr\">基本上就是依照XY加文字進去<div><br><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ggplot2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">iris</span><span style=\"color:#660\">)+</span><span style=\"color:#000\"><br>  geom_point</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Length</span><span style=\"color:#660\">,</span><span style=\"color:#000\">y</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Width</span><span style=\"color:#660\">,</span><span style=\"color:#000\">colour</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Species</span><span style=\"color:#660\">))+</span><span style=\"color:#000\"><br>  geom_text</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Length</span><span style=\"color:#660\">,</span><span style=\"color:#000\">y</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Width</span><span style=\"color:#660\">+</span><span style=\"color:#066\">0.1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">label</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Species</span><span style=\"color:#660\">))</span></div></code></div><div><br></div></div></div><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-IH-7keVQRXs/WHDfFNQNXII/AAAAAAAA8ls/GxjKRPmLAcwjFbonU9L04IFcl8at2wq8gCLcB/s1600/a.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-IH-7keVQRXs/WHDfFNQNXII/AAAAAAAA8ls/GxjKRPmLAcwjFbonU9L04IFcl8at2wq8gCLcB/s1600/a.png&amp;source=gmail&amp;ust=1793237796290000&amp;usg=AOvVaw1KC4OErGHB40fmVnCuWU6_\"><img src=\"https://lh3.googleusercontent.com/-IH-7keVQRXs/WHDfFNQNXII/AAAAAAAA8ls/GxjKRPmLAcwjFbonU9L04IFcl8at2wq8gCLcB/s320/a.png\" border=\"0\" width=\"320\" height=\"169\"></a></p><p style=\"text-align:center;clear:both\">但是如果點相近就會重疊</p><p style=\"text-align:center;clear:both\"><br></p><p style=\"text-align:center;clear:both\">可以嘗試套件ggrepel</p><p style=\"text-align:center;clear:both\"><br></p><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ggrepel</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">iris</span><span style=\"color:#660\">)+</span><span style=\"color:#000\"><br>  geom_point</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Length</span><span style=\"color:#660\">,</span><span style=\"color:#000\">y</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Width</span><span style=\"color:#660\">,</span><span style=\"color:#000\">colour</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Species</span><span style=\"color:#660\">))+</span><span style=\"color:#000\"><br>  geom_text_repel</span><span style=\"color:#660\">(</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Length</span><span style=\"color:#660\">,</span><span style=\"color:#000\">y</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Width</span><span style=\"color:#660\">,</span><span style=\"color:#000\">label</span><span style=\"color:#660\">=</span><span style=\"color:#606\">Species</span><span style=\"color:#660\">))</span></div></code></div><p style=\"text-align:start;clear:both\"><font color=\"#000000\" face=\"monospace\"><span style=\"background-color:rgb(250,250,250)\"><br></span></font></p><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-Y3ph1aHExrg/WHDfi-YLOsI/AAAAAAAA8lw/0rXmsUwzfPY1T2E_I5Eq75CI7yWdp0V_wCLcB/s1600/b.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-Y3ph1aHExrg/WHDfi-YLOsI/AAAAAAAA8lw/0rXmsUwzfPY1T2E_I5Eq75CI7yWdp0V_wCLcB/s1600/b.png&amp;source=gmail&amp;ust=1793237796290000&amp;usg=AOvVaw2rHmSFh7jhGkc6vap8Yf4Y\"><img src=\"https://lh3.googleusercontent.com/-Y3ph1aHExrg/WHDfi-YLOsI/AAAAAAAA8lw/0rXmsUwzfPY1T2E_I5Eq75CI7yWdp0V_wCLcB/s320/b.png\" border=\"0\" width=\"320\" height=\"169\"></a></p><p style=\"text-align:center;clear:both\"><br></p><p style=\"text-align:center;clear:both\"><br></p><p style=\"text-align:center;clear:both\"><br></p><div><br></div></div>"
