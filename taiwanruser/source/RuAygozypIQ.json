tyle=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\">&quot;)</span><br></div><div style=\"font-family:arial,sans-serif;font-size:14px\"><font face=\"mingliu, monospace\" size=\"4\" color=\"#0000ff\">[1] TRUE</font></div><div style=\"font-family:arial,sans-serif;font-size:14px\"><div><span style=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\">&gt; url.exists(&quot;</span><a href=\"http://www444.dgbas.gov.tw/\" style=\"color:rgb(17,85,204);font-family:mingliu,monospace;font-size:large\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www444.dgbas.gov.tw/&amp;source=gmail&amp;ust=1793237907887000&amp;usg=AOvVaw2nNzJ7BK8WdEeYTLNX5qaP\">http://www444.dgbas.gov.tw</a><span style=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\">&quot;)</span><br></div><div><font face=\"mingliu, monospace\" size=\"4\" color=\"#0000ff\">[1] FALSE</font></div></div><div style=\"font-family:arial,sans-serif;font-size:14px\"><span style=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\">&gt; url.exists(&quot;<a href=\"http://www.mohw.gov.tw/\" style=\"color:rgb(17,85,204)\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.mohw.gov.tw/&amp;source=gmail&amp;ust=1793237907887000&amp;usg=AOvVaw1wwUqL_6Hjaifz4buX8-Yp\">http://www.mohw.gov.tw</a>&quot;)</span></div><div style=\"font-family:arial,sans-serif;font-size:14px\"><span style=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\"><br></span></div><div style=\"font-family:arial,sans-serif;font-size:14px\"><span style=\"color:rgb(255,0,0);font-family:mingliu,monospace;font-size:large\"><br></span></div></div></blockquote></div></blockquote></div>"
