     1,
     "Hi Hen-Chao,<div><br></div><div>Please try:</div><div><br></div><div><div><font face=\"courier new, monospace\" size=\"2\"><b># title: Frequency analysis with null value</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b># date: 2013.6.29</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>fre &lt;- read.table(&quot;FeequencyAnalysis.csv&quot;, head=T, sep=&quot;,&quot;, na.strings = &quot;&quot;)</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>fre</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>fre.count &lt;- table(fre$變數3, fre$變數4, useNA=&quot;always&quot;)</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>fre.count</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>row.names(fre.count) &lt;- c(&quot;B1&quot;, &quot;B2&quot;, &quot;缺值&quot;)</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>colnames(fre.count) &lt;- c(&quot;A1&quot;, &quot;A2&quot;, &quot;缺值&quot;)</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b>fre.count</b></font></div><div><font face=\"courier new, monospace\" size=\"2\"><b># end</b></font></div></div><div><br></div><p style=\"text-align:center;clear:both\"><a href=\"https://lh5.googleusercontent.com/-2QsVMQegr0o/Uc7afBVS9rI/AAAAAAAAAVs/gj1kF5Ozv4E/s787/FeequencyAnalysis.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh5.googleusercontent.com/-2QsVMQegr0o/Uc7afBVS9rI/AAAAAAAAAVs/gj1kF5Ozv4E/s787/FeequencyAnalysis.png&amp;source=gmail&amp;ust=1793238824789000&amp;usg=AOvVaw2pzHHpNHv_6T_rGZRmrB-a\"><img src=\"https://lh5.googleusercontent.com/-2QsVMQegr0o/Uc7afBVS9rI/AAAAAAAAAVs/gj1kF5Ozv4E/s320/FeequencyAnalysis.png\" border=\"0\" width=\"320\" height=\"242\"></a></p><p style=\"text-align:center;clear:both\"><a href=\"https://lh6.googleusercontent.