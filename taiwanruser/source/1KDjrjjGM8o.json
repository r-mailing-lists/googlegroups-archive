<td align=\"right\">157.521</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN1122</td>\r\n  <td>Ir</td>\r\n  <td>CC</td>\r\n  <td align=\"right\">22.3884</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN1302</td>\r\n  <td>Ir</td>\r\n  <td>CC</td>\r\n  <td align=\"right\">45.747</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN1482</td>\r\n  <td>Ir</td>\r\n  <td>CC</td>\r\n  <td align=\"right\">11.739</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN1662</td>\r\n  <td>Ir</td>\r\n  <td>CC</td>\r\n  <td align=\"right\">14134</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN1842</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">53.4089</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN2022</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">43.0488</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN2202</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">301.511</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN2382</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">402.65</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN2562</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">3.20055</td>\r\n </tr>\r\n <tr style=\"height:15.0pt\" height=\"20\">\r\n  <td style=\"height:15.0pt\" height=\"20\">NN2742</td>\r\n  <td>Ir</td>\r\n  <td>HJ</td>\r\n  <td align=\"right\">4012.65</td>\r\n </tr>\r\n\r\n</tbody></table><br><div><b>圖一：</b></div><div><b><br></b></div><p style=\"t