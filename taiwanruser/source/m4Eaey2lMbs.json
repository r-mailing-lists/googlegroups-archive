     "<div><font color=\"#0000ff\">我寫出了C語言，但不知道怎麼用R的方式寫有沒有人能救我一下</font></div><div><br></div><div><br></div><div>/* <span style=\"white-space:pre\">\t</span>輸入:要兌獎的彩券號碼為陣列lottery[6],例如int lottery [6] = {5,15,17,20,25,30}</div><div><span style=\"white-space:pre\">\t</span>輸出:文字訊息: 頭獎、二獎、三獎、四獎、五獎、未中獎 </div><div>*/</div><div><br></div><div>#include &lt;stdio.h&gt;</div><div>#include &lt;stdlib.h&gt;</div><div><br></div><div>//宣告兌獎函式原型</div><div>void convert (int lotterynum[]);</div><div><br></div><div>int main(){</div><div><br></div><div>int lottery[6]={5,15,17,20,25,30};<span style=\"white-space:pre\">\t</span>//要兌獎的彩券號碼 </div><div>convert(lottery);             <span style=\"white-space:pre\">\t\t</span>//呼叫兌獎函式 </div><div><br></div><div>return 0;</div><div>}</div><div><br></div><div><br></div><div><br></div><div><br></div><div>//以下是你要函式內容</div><div><br></div><div>void convert (int lotterynum[]){</div><div><span style=\"white-space:pre\">\t</span>int prize_num[7]={28,15,37,5,17,32,8};<span style=\"white-space:pre\">\t\t</span>//本期獎號 </div><div><span style=\"white-space:pre\">\t</span>int i,j,count_normal=0,count_special=0;</div><div><br></div><div>//計算在prize_num[0-5]之中有中幾個普通號碼，是否有中特別號碼prize_num[6]<span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>for(i=0;i&lt;=5;i++){<span style=\"white-space:pre\">\t\t\t\t\t\t\t</span>//依序對第1-6個彩券號碼 </div><div><span style=\"white-space:pre\">\t\t</span>for(j=0;j&lt;=5;j++){<span style=\"white-space:pre\">\t\t\t\t\t\t</span>//將第i個彩券號碼核對第j個獎號</div><div><span style=\"white-space:pre\">\t\t\t</span>if (lotterynum[i]==prize_num[j])</div><div><span style=\"white-space:pre\">\t\t\t\t</span>count_normal++;</div><div><span style=\"white-space:pre\">\t\t</span>}</div><div><span style=\"white-space:pre\">\t\t</span>if (lotterynum[i]==prize_num[6])<span style=\"white-space:pre\">\t\t</span>//將第i個彩券號碼核對第7個特別號 </div><div><span style=\"white-space:pre\">\t\t\t</span>count_special++;</div><div><span style=\"white-space:pre\">\t</span>}</div><div><br></div><div>//輸出中獎訊息</div><div><span style=\"white-space:pre\">\t</span>if (count_normal&lt;=2)</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;未中獎&quot;);</div><div><span style=\"white-space:pre\">\t</span>else if (count_normal==3)</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;五獎&quot;);</div><div><span style=\"white-space:pre\">\t</span>else if (count_normal==4)</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;四獎&quot;);</div><div><span style=\"white-space:pre\">\t</span>else if ((count_normal==5) &amp;&amp; (count_special==0))</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;三獎&quot;);</div><div><span style=\"white-space:pre\">\t</span>else if ((count_normal==5) &amp;&amp; (count_special==1))</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;二獎&quot;);</div><div><span style=\"white-space:pre\">\t</span>else if (count_normal==6)</div><div><span style=\"white-space:pre\">\t\t</span>printf(&quot;頭獎&quot;);<span style=\"white-space:pre\">\t\t</span></div><div>} </div><div><br></div><img alt=\"209366855_204647524892178_8487080830122861153_n.png\" width=\"534px\" height=\"217px\" src=\"https://groups.google.com/group/taiwanruser/attach/6218965120d6/209366855_204647524892178_8487080830122861153_n.png?part=0.1&amp;view=1\">"
