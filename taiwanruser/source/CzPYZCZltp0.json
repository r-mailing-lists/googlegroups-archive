   "parts": [
    [
     1,
     "<div dir=\"ltr\">請問如何讓 ggplot 不將 x 軸的資料排序後顯示 (請參考附圖)。<div>原始資料與指令如下:</div><div><br></div><div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"303\" style=\"border-collapse:collapse;width:227pt\">\r\n <colgroup><col width=\"303\" style=\"width:227pt\">\r\n </colgroup><tbody><tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" width=\"303\" style=\"height:15.95pt;width:227pt\">probgrp</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">   item   ItemValue   Probability</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">1     1         1~49        0.1255</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">2     2      49~66.8      0.1306</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">3     3      66.8~79      0.1516</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">4     4      79~90        0.1094</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">5     5      90~100      0.1559</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">6     6    100~110      0.1470</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">7     7     110~121     0.1644</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">8     8     121~133     0.1513</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">9     9    133~151.1   0.1194</td>\r\n </tr>\r\n <tr height=\"21\" style=\"height:15.95pt\">\r\n  <td height=\"21\" style=\"height:15.95pt\">10   10   151.1~243  0.1600<br><br>ggplot(probgrp, aes(ItemValue,Probability,group=1)) + geom_line(col=&quot;red&quot;)+geom_point(col=&quot;darkred&quot;)<br><br></td>\r\n </tr></tbody></table><br>Thanks.<br> </div></div>"
    ]
   ]
  },
