   selectInput("dataset", "Choose a dataset:",

               choices=c("C0A9A0","C0A9B0")),
  br(),

  downloadButton('downloadData', 'Download'),

mainPanel(
   tabsetPanel(

       tabPanel("C0A9A0",dataTableOutput("mytable1")),
       tabPanel("C0A9B0",dataTableOutput("mytable2")),

      tableOutput("table")

      )
      )
))
)

