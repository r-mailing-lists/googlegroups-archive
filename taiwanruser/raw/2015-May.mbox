以下為程式的部分，有修改一下資料，謝謝WEPA的建議:
# server.R--------------------------------------------------------------------------------------------------------------------

library(shiny)
library(ggplot2)

shinyServer(function(input, output) {
  output$mytable1  <- renderDataTable({C0A9A0[, input$show_vars, drop = FALSE]})
  output$mytable2  <- renderDataTable({C0A9B0[, input$show_vars, drop = FALSE]})

datasetInput <- reactive({
  switch(input$dataset,
         "C0A9A0" = C0A9A0[,input$show_vars],
         "C0A9B0" = C0A9B0[,input$show_vars],

               )})

output$table <-renderTable({
datasetInput()

})

  output$downloadData <- downloadHandler(

    filename = function() {

paste(input$dataset,"csv",sep='.')
    },
    content = function(file) {
          write.table(datasetInput(), file,sep="," , row.names=FALSE)
   })
})

