library(Matrix)
v22=as.matrix(v2)     #將v2變成矩陣v22
v222 <- as <http://inside-r.org/r-doc/methods/as>(v22, "sparseMatrix")   #把v22改為sparseMatria矩陣v222

sarprobit.fit1 <- sar_probit_mcmc(Y, X, W=v222)  # 跑sarprobit model

