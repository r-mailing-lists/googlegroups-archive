Hi Ocean,

參考以下修改後結果:
1. 使用 nrow 函數
2. 加上  is.na <http://is.na> 函數
3. if ( ... ) 要加上括號

ask <- read.csv("ask.csv")

for (j in 1:nrow(ask)) {

  if (ask[j,3] != 9 | is.na <http://is.na>(ask[j,3])) {

    for (r in 1:30) {

      LR <- ask[j,1]

      LR <- LR +1.5*r
      if (LR > 40) {
        ask[j,2] <- 1
      } else if (LR< 5) {
        ask[j,2] <- 0
      } else {
        ask[j,2] <- "unknow"
      }

    }

    ifelse(ask[j,2] == 1 | ask[j,2] == 0, ask[j,3] <- 9+r, ask[j,3] <- NA)
    if (ask[j,2] == 1 | ask[j,2] == 0) {break}
  }

}

