n <- 1000
p <- 0.2
mean.x <- numeric(5000)
for (i in 1:5000) {
  x <- rbinom(n, 1, p)
  mean.x[i] <- mean(x)
}
summary(mean.x)
qqnorm(mean.x); qqline(mean.x, col = 2)
hist(mean.x)

