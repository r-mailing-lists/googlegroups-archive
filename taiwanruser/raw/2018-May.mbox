補充一下 因為每次都取代掉了，所以你rbind一下就可以了，以下是隨便弄的，結果會是你想要的，建議精修一下

for(x in c(1:24))
{
  if(x>=2)
  {
    tmp=paste("http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/",paste(day,time[x],paste('TDCS_M04A_',day,time[x],sep='_'),sep="/"),minute,"00",".csv",sep='')
    urls=rbind(urls, tmp)
  }
  else
  {
    urls<- paste("http://tisvcloud.freeway.gov.tw/history/TDCS/M04A/",paste(day,time[x],paste('TDCS_M04A_',day,time[x],sep='_'),sep="/"),minute,"00",".csv",sep='')
  }
}

