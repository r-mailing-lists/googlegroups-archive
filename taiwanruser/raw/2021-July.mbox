我寫出了C語言，但不知道怎麼用R的方式寫有沒有人能救我一下

/*  輸入:要兌獎的彩券號碼為陣列lottery[6],例如int lottery [6] = {5,15,17,20,25,30}
輸出:文字訊息: 頭獎、二獎、三獎、四獎、五獎、未中獎
*/

#include <stdio.h>
#include <stdlib.h>

//宣告兌獎函式原型
void convert (int lotterynum[]);

int main(){

int lottery[6]={5,15,17,20,25,30}; //要兌獎的彩券號碼
convert(lottery);              //呼叫兌獎函式

return 0;
}

//以下是你要函式內容

void convert (int lotterynum[]){
int prize_num[7]={28,15,37,5,17,32,8}; //本期獎號
int i,j,count_normal=0,count_special=0;

//計算在prize_num[0-5]之中有中幾個普通號碼，是否有中特別號碼prize_num[6]
for(i=0;i<=5;i++){ //依序對第1-6個彩券號碼
for(j=0;j<=5;j++){ //將第i個彩券號碼核對第j個獎號
if (lotterynum[i]==prize_num[j])
count_normal++;
}
if (lotterynum[i]==prize_num[6]) //將第i個彩券號碼核對第7個特別號
count_special++;
}

//輸出中獎訊息
if (count_normal<=2)
printf("未中獎");
else if (count_normal==3)
printf("五獎");
else if (count_normal==4)
printf("四獎");
else if ((count_normal==5) && (count_special==0))
printf("三獎");
else if ((count_normal==5) && (count_special==1))
printf("二獎");
else if (count_normal==6)
printf("頭獎");
}

