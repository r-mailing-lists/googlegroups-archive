FibonacciNumbers.R

# title: Fibonacci numbers
# date: 2013.1.13
Fibonacci <- function(x) {
  fn = numeric(x)
  fn[1] = 1
  fn[2] = 1
  for (i in 3:length(fn)) {
    fn[i] = fn[i-1] + fn[i-2]
  }
  return(max(fn)) # return(fn) for all values
}

Fibonacci(50)
