Hi Tsai,

請參考以下程式碼與附圖結果, 主要採用 apply 或 lapply函數.

# title : fill missing value with column mean
# date  : 2015.10.16
(df <- data.frame(x1=c(1,2,NA,3,4),
                  x2=c(10,20,30,40,NA),
                  x3=c(100,200,NA,300,400)))
# method 1
df.apply <- apply(df, 2, function(x) {
  x[is.na <http://is.na>(x)] <- mean(x, na.rm=TRUE)
  x})
df.apply
# meyhod 2
df.lapply <- data.frame(lapply(df, function(x) {
  x[is.na <http://is.na>(x)] <- mean(x, na.rm=TRUE)
  x})
  )
df.lapply
# end

