Hi Danile,

1. strsplit(ROC_year,"/")[[1]] 之結果僅取出第1個元素, 所以結果只傳回'2017-05-02'

2. strsplit 之結果為 list, 因此可考慮使用 lapply, 取出 list 固定位置元素, 可使用 "[["

 <https://lh3.googleusercontent.com/-QIwUKQrWTds/WSba6e7jgnI/AAAAAAAALkk/FksOo1Op0tQ7yMZhs3_t2ieZwyznfmtiQCLcB/s1600/dateconvert.png>

# title: date convert
# date: 2017.5.25

convROCYear <- function(ROC_year) { # 106/10/01 -> Date
  v <- strsplit(ROC_year,"/")
  years <- as.numeric(lapply(v, "[[", 1)) + 1911
  months <- lapply(v, "[[", 2)
  days <- lapply(v, "[[", 3)
  dd = paste0(years, "-", months, "-", days)
  return(as.Date(dd))
}
t <- c('106/05/02','106/05/3','106/5/4')
convROCYear(t)
# end

