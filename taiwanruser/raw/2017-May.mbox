Hi Paul,

考量 for 與 apply 不同方式, apply 應該是比較快, 將 samplesize 改為100000, 結果差異更明顯.

> print(paste("sample size=", samplesize))

[1] "sample size= 1e+05"

> print("method 1")

[1] "method 1"

> print(method1.end - method1.start)

Time difference of 6.194284 secs

> print("method 2")

[1] "method 2"

> print(method2.end - method2.start)

Time difference of 1.347049 secs

> # end

 <https://lh3.googleusercontent.com/-EuM0gogCb_E/WSQ39FhqyII/AAAAAAAALjs/vF0CvEy8Mas7Kj5-PAjgXT9wo8iS8p8RgCLcB/s1600/data.frame_operation.png>

# title: data.frame operation
# date: 2017.5.23
set.seed(168)
samplesize <- 10
data <- data.frame(date=seq(as.Date("2017/5/1"), by="day", length.out=samplesize),
                   f1=sample(2,10, replace=TRUE)-1,
                   f2=sample(2,10,replace=TRUE),
                   abc=1:10,
                   def=11:20)
head(data)

method1.start <- Sys.time()
# 方法1 採用指標-FOR
NUM <- nrow(data)
index1 <- c()
index2 <- c()

for (i in 1:NUM) {
  if ((data[i,"f1"] == 1) && (data[i,"f2"] == 2)) {

    index1 <- c(index1,i)

  } else if ((data[i,"f1"] == 0) && (data[i,"f2"] == 2)) {

    index2 <- c(index2,i)
  }
}

data[index1,]
data[index2,]
method1.end <- Sys.time()

# 方法2 採用指標-apply
method2.start <- Sys.time()
index3 <- c()
indexvalue <- apply(data[,c("f1", "f2")], 1, function(x) {
  if (x[1] == "1" & x[2] == "2") {
    index3 <- c(index3, TRUE)
  } else {
    index3 <- c(index3, FALSE)
  }
  return(index3)
})
data[indexvalue,] # same as 方法1
# 同理可建立 f1=0, f2=2的查詢結果
method2.end <- Sys.time()
print(paste("sample size=", samplesize))
print("method 1")
print(method1.end - method1.start)
print("method 2")
print(method2.end - method2.start)
# end

