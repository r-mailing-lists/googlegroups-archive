謝謝您:  下面是輸入在R的程式碼,  但繪出的圖, 時間擠在一起了..
x=read.table("data.txt")  #讀取檔案#

options(max.print=9.5E5)  #增加上限, 9.5E5實際上是亂打,不知輸入多少較恰當#

summary(x)  #找出V5中需要的項目#

# title: read data/time data  讀取V1和V2 的時間

# date: 2013.2.28

lct <- Sys.getlocale("LC_TIME")

Sys.setlocale("LC_TIME", "C")

x.dates<-c("17.03.2001", "16.03.2001", "15.03.2001")

x.times<-c("23:39:15", "23:50:00", "22:23:43")

x.datetime <- paste(x.dates, x.times)

strptime(x.datetime, "%d.%m.%Y %H:%M:%S") # revise to %d.%m.%Y

Sys.setlocale("LC_TIME", lct)

# end

# method 1

x.SGOX <- x[x$V5=="SGOX",]

xlabels <- paste(x$V1, x$V2)               #時間 V1 日月年  V2  時分秒

x.index <- seq(from=1, to=7, by=1)           #以天當間隔,  但似乎得從秒開始增加.. ?

## figure 1              #完全看不懂@@

plot(x$V3, type="l", ylim=c(0,1), main="Figure 1", xlab="", xaxt="n")

axis(side=1, at=x.index, tick=TRUE, labels=FALSE)

text(x.index, par("usr")[3], labels=xlabels[x.index], srt=90, pos=1, adj = c(1.1, 0.2), xpd=TRUE, cex=0.8)

lines(x$V4, col="red")
畫出的圖 是附件1
# method 2
library(ggplot2)

dm <- data.frame(id.solar=paste(x$V1,x$V2), x[,4:6])

#這邊,我把data.frame 修改成 x (讀入的檔案)  但卻顯示沒有x函數,

dm$id.solar <- as.POSIXct(dm$id.solar, "%d.%m.%Y %H:%M:%S", tz="")

不好意思問題超多@@, 謝謝您

