Hi Hen-Chao,

參考使用 GET{httr}.

# title: URL check
# date: 2016.10.13

library(RCurl)
url.exists("http://www.cwb.gov.tw") # TRUE
url.exists("http://www444.dgbas.gov.tw") # FALSE
# url.exists("http://www.mohw.gov.tw") # ERROR

library(httr)
GET("http://www.cwb.gov.tw")
GET("http://www444.dgbas.gov.tw")

x <- GET("http://www.mohw.gov.tw")
# str(x) # length=10
x$url # 讀取response url

tryCatch(GET("http://www444.dgbas.gov.tw"),
         error = function(e) {
           print("ERROR")
           })

tryCatch(GET("http://www.mohw.gov.tw"),
         error = function(e) {
           print("ERROR")
           })
# end

