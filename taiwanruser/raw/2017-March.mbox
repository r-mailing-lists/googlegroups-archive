# title: 使用aggregate 計算各群組個數, 使用lapply建立群組指標
# date: 2017.3.17

mydf <- read.table("text.csv", header=TRUE, sep=",") # 230*7
mydf$ID <- as.factor(mydf$ID)
mydf <- mydf[!is.na <http://is.na>(mydf$ID),] # 刪除9列ID是NA, 230-9=221
mydfsort <- mydf[order(mydf$ID, mydf$Time), ]
head(mydfsort, n=10)

# aggregate 計算相同群組個數
mydfgroup <- aggregate(Time ~ ID, data=mydfsort, length)
names(mydfgroup)[2] <- "GroupNumbers"

# 建立各群組指標{1,2,3...}
mydfsort$Time_new <- unlist(lapply(mydfgroup$GroupNumbers, function(x) c(1:x)))
head(mydfsort, n=10)
# end

