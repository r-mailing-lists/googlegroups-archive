Hi 筱媛,

1. 在 method 1, 2中, 原想使用 plotGEOmap {GEOmap} 繪製太平洋地圖, 但顏色無法填滿而採用method 3.

2. 在 method 3 中, 使用 worldHires {mapdata} 資料集,以繪製太平洋地圖, 填滿顏色亦可使用.

3. 將地圖區分成不同網格, 依序計算各網格的累計資料點的數量, 儲存於 piedata 資料物件, 可利於後續使用.

4. add.pie {mapplots} 函數可於地圖中加入圓形圖, 其他 draw.* 亦可參考線上說明.

5. 第一次繪圖時, map 加上 type="n" 表示不用實際繪出, 等到 pie 圖繪製完成再加上實際繪圖.

library(GEOmap)            # plotGEOmap fuction
library(geomapdata) # worldmap dataset
library(mapdata)    # worldHires dataset, map function
library(mapplots)   # add.pie function

data(worldmap)

par(mar=c(3,3,7,3))

# method 1: no fill color - OK
# plotGEOmap(worldmap,
#            LIM = c(100, -50, 230, 50),
#            xaxt="n", yaxt="n",
#            ann=FALSE,
#            asp=1)

# method 2: fill color - ERROR
# plotGEOmap(worldmap,
#            MAPstyle=3, MAPcol=rgb(.8, .8, 1),
#            LIM = c(xmin, ymin, xmax, ymax),
#            xaxt="n", yaxt="n",
#            ann=FALSE,
#            asp=1)

# method 3: fill color - OK
map("worldHires", xlim=c(105, 245), ylim=c(-50, 60), type="n")
map.axes()

title("Trim.(bet)")
abline(v=seq(100, 240, 5), col="grey")
abline(h=seq(-50, 50, 5), col="grey")

# setup simulation data
set.seed(168)
mydf <- data.frame(x=runif(100, 120, 220), y=runif(100, -40, 20)) # simulating points
points(mydf, pch=".", cex=3)

# Compute ratio for each grid
xrange <- seq(100, 240, 5)
yrange <- seq(-50, 45, 5)

piedata <- c()
piecount <- 1

for (x in 1:(length(xrange)-1)) {
  for (y in 1:(length(yrange)-1)) {

    sumpie <- sum((mydf$x >= xrange[x] & mydf$x < xrange[x+1]) &
                    (mydf$y >= yrange[y] & mydf$y < yrange[y+1]))

    if (sumpie > 0) {
      piedata[piecount] <- sumpie
    } else {
      piedata[piecount] <- 0
    }

    # case 1
    if (piedata[piecount] == 0) {
      add.pie(z=table(c(1,rep(2,98))), x=xrange[x]+2.5, y=yrange[y]+2.5,
              radius=1,
              col=c("red", "white"),
              labels=NA,
              init.angle=0)
    }

    # case 2
    if (piedata[piecount] == 1) {
      add.pie(z=table(c(1,1,2,2,2)), x=xrange[x]+2.5, y=yrange[y]+2.5,
              radius=2,
              col=c("red", "white"),
              labels=NA,
              init.angle=0)
    }

    # case 3
    if (piedata[piecount] == 2) {
      add.pie(z=table(c(1,1,1,2,2)), x=xrange[x]+2.5, y=yrange[y]+2.5,
              radius=2,
              col=c("red", "white"),
              labels=NA,
              init.angle=0)
    }

    # case 4
    if (piedata[piecount] == 3) {
      add.pie(z=table(c(1,1,1,1,2)), x=xrange[x]+2.5, y=yrange[y]+2.5,
              radius=2.5,
              col=c("red", "white"),
              labels=NA,
              init.angle=0)
    }

    piecount <- piecount + 1

  }
}

map("worldHires", xlim=c(105, 245), ylim=c(-50, 60), fill=TRUE, col="gray90", add=TRUE)

pie.legend <- data.frame(x=rep(110, 4),
                         y=c(52, 46, 38, 28),
                         radius=c(2:5),
                         pie.labels=c("0~500", "500~2000", "2000~5000", ">5000"))

for (i in 1:4) {

  add.pie(table(c(1,rep(2,100))),
          x=pie.legend$x[i],
          y=pie.legend$y[i],
          radius=pie.legend$radius[i],
          col=c("black", "white"),
          labels=NA,
          init.angle=0)

  text(x=pie.legend$x[i]+5,
       y=pie.legend$y[i],
       labels=pie.legend$pie.labels[i],
       pos=4,
       col="blue")

}

legend(x=165,
       y=55,
       legend=c("orig data", "screening"),
       pch=c(0,15),
       col=c("black", "red"),
       bty="n")

# end

