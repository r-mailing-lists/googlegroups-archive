                                     eval.resp.var = NULL,
                                     eval.expl.var = NULL,
                                     eval.resp.xy = NULL,
                                     PA.nb.rep = 1,
                                     PA.nb.absences = 320,
                                     PA.strategy = 'disk',
                                     PA.dist.min = '10000',
                                     PA.dist.max = '40000',
)
