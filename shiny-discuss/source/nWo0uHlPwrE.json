0,250)\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><div><font color=\"#660066\">server {</font></div><div><span style=\"white-space:pre-wrap\"><font color=\"#660066\">\t</font></span></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>listen   80; ## listen for ipv4; this line is default and implied</font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>#listen   [::]:80 default ipv6only=on; ## listen for ipv6</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>root /usr/share/nginx/www;</font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>index index.php index.html index.htm;</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span># Make site accessible from <a href=\"http://localhost/\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://localhost/&amp;source=gmail&amp;ust=1792391099804000&amp;usg=AOvVaw0t7FHhQbd2phVDoSkF6E3_\">http://localhost/</a></font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>server_name localhost;</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>location /shiny/ {</font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>  rewrite ^(/shiny/[^/]+)$ $1/ permanent;</font></div><div><font color=\"#660066\"><span style=\"white-space:pre-wrap\">\t</span>  proxy_pass <a href=\"http://127.0.0.1:3838/shiny/\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://127.0.0.1:3838/shiny/&amp;source=gmail