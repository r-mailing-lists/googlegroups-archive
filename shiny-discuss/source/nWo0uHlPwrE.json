    [
     1,
     "<div dir=\"ltr\">You are proxying the request, so that will not be gzipped.<div><br>After that, shiny server is handling the request, so no gzip will happen.</div><div><br></div><div><br></div><div>Erik</div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
