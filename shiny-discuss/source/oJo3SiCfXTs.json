     1,
     "<div dir=\"ltr\">Very nice, thank you.<div><br></div><div>Thus, for my example I can simply do :</div><div><br></div><div><div>    observe({</div><div>      Sys.sleep(2)</div><div>      js_string &lt;- &#39;$(&quot;#box&quot;).animate({width:&quot;300px&quot;});&#39;</div><div>      session$sendCustomMessage(type=&#39;jsCode&#39;, list(value = js_string))</div><div>    })</div></div></div>"
    ]
   ]
  }
 ]
