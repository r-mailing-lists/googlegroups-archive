     1,
     "<div dir=\"ltr\">Hi<div><font face=\"times new roman, serif\"><br></font></div><p style=\"text-align:center;clear:both\"></p><div><font face=\"times new roman, serif\">You can use something like</font></div><div><font face=\"times new roman, serif\"><br></font></div><div><div><font face=\"times new roman, serif\" size=\"2\">div(style=&quot;display:inline-block&quot;,submitButton(&quot;Analysis&quot;), style=&quot;&quot;display:center-align&quot;)</font></div></div><div><div><code style=\"white-space:inherit\"><span style=\"color:rgb(0,0,0)\"><font face=\"times new roman, serif\" size=\"2\">or can use separate fluid row</font></span></code></div><div><code style=\"white-space:inherit\"><span style=\"color:rgb(0,0,0)\"><font face=\"times new roman, serif\" size=\"2\"><br></font></span></code></div><div><code style=\"white-space:inherit\"><span style=\"color:rgb(0,0,0)\"><pre style=\"font-stretch:inherit;line-height:16px;vertical-align:baseline\"><font face=\"times new roman, serif\" size=\"2\"><code style=\"font-style:inherit;font-variant:inherit;font-weight:inherit;font-stretch:inherit;line-height:inherit;vertical-align:baseline\">fluidRow(\r\n      column(6, align=&quot;center&quot;, offset = 3,\r\n         actionButton(&quot;button&quot;,label = &quot;search),\r\n         tags$style(type=&#39;text/css&#39;, &quot;#button { vertical-align- middle; height- 50px; width- 100%; font-size- 30px;}&quot;)\r\n      )</code></font></pre></span></code></div></div></div>"
