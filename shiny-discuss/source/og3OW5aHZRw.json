     1,
     "<div dir=\"ltr\"><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\"><br>                buttons </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;copy&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;csv&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;excel&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;pdf&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;print&#39;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>                columnDefs </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>                  list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">targets </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> render </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> JS</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;<br>                    function(data) {<br>                      return data.slice(-9, -4);<br>                    }&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>                </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>              </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span></div></code></div></div></code></div><div><br></div></div></div>"
