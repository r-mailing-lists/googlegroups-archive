span><span style=\"color:#000\"> shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> session</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br><br><br>    output$showplot </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPlot</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>        grid </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> expand</span><span style=\"color:#660\">.</span><span style=\"color:#000\">grid</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">3</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">3</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>        nums </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> rbinom</span><span style=\"color:#660\">(</span><span style=\"color:#066\">9</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">0.5</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>        g </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">grid</span><span style=\"color:#660\">,</span><span style=\"color:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Var1</span><span style=\"color:#660\">,</span><span style=\"color:#606\">Var2</span><span style=\"color:#660\">))</span><s