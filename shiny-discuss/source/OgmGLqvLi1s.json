   "subject": "Re: Multiple conditional panels",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">You should be able to use lapply or something here. Here&#39;s a really non-idiomatic version, excuse my R:<div><br></div><div>mainPanel(</div><div>  lapply(1:length(helpMethodConditions), function(i) {</div>\r\n\r\n<div>    conditionalPanel(condition=helpMethodConditions[[i]],</div><div>      helpText(helpMethod[[i]])</div><div>    )</div><div>  })</div><div>)</div></div><div class=\"gmail_extra\"><br><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">On Thu, Jun 13, 2013 at 12:44 AM, Dieter Menne <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">menne...@googlemail.com</a>&gt;</span> wrote:<br>\r\n\r\n</div></div>"
    ],
