#000\"><br>  <br>  </span><span style=\"color:#800\"># Combine the selected variables into a new data frame</span><span style=\"color:#000\"><br>  selectedData </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    iris</span><span style=\"color:#660\">[,</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$xcol</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> input$ycol</span><span style=\"color:#660\">)]</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br>  clusters </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    kmeans</span><span style=\"color:#660\">(</span><span style=\"color:#000\">selectedData</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"> input$clusters</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br>  output$plot1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPlot</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    par</span><span style=\"color:#660\">(</span><span style=\"color:#000\">mar </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#066\">5.1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">4.1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>   