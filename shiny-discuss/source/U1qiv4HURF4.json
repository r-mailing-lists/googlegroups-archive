50,250)\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> session</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"> <br>  output$tbl </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderDataTable</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>        iris$Sepal</span><span style=\"color:#660\">.</span><span style=\"color:#606\">Width</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> input$value<br>        </span><span style=\"color:#008\">return</span><span style=\"color:#660\">(</span><span style=\"color:#000\">iris</span><span style=\"color:#660\">)},</span><span style=\"color:#000\"><br>        callback </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;function(table) {<br>          table.on(&#39;click.dt&#39;, &#39;tr&#39;, function() {<br>            Shiny.onInputChange(&#39;value&#39;,table.data()[$(this).index()][0]);<br>          });<br>        }&quot;</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>  output$length </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderText</span><span style=\"color:#660\">({</span><span style=\"color:#000\">    <br>     paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;Length:&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> input$value</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> collapse </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39; &#39;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span></div></code></div><div><br></div></div><div><br></div><div>The issue I have with this, that the sorting is thrown away each time I click on a line.</div><div><br></div><div>Any advice?</div><div><br></div><div>Thanks,</div><div>Tom</div><div><br></div></div>"
