     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\">On Thu, Jun 2, 2016 at 2:18 AM Adrian Waddell &lt;<a href data-email-masked rel=\"nofollow\">adrian....@gmail.com</a>&gt; wrote:<br></div></div>"
    ],
