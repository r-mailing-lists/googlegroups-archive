acter</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"><br>                      list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">sel </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">name</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$select</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br>    txt </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">eval</span><span style=\"color:#660\">(</span><span style=\"color:#000\">txt</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"> <br></span><span style=\"color:#660\">}</span></div></code></div><br></div><div><br></div><div>Best,</div><div>Massimo<br><div><br></div></div></div></blockquote></div></div>"
