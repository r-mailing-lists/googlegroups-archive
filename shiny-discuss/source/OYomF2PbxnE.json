     1,
     "<div dir=\"ltr\">Hi,<br><br>just manipulate the HTML output of radioButtons, e.g.<br><br><font color=\"#000000\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>myRadioButtons </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(){</span><span style=\"color:#000\"> <br>    buttons </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> radioButtons</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;radio&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> label </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> h3</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Radio buttons&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>                            choices </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Choice 1&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choice 2&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choice 3&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#066\">3</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>                            selected </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    buttons </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> gsub</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;&lt;span&gt;Choice 1&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&lt;span&gt;&lt;font color=&quot;red&quot;&gt;Choice 1&lt;/font&gt;&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> buttons</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">fixed</span><span style=\"color:#660\">=</span><span style=\"color:#000\">T</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    buttons </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> gsub</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;&lt;span&gt;Choice 2&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&lt;span&gt;&lt;font color=&quot;blue&quot;&gt;Choice 2&lt;/font&gt;&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> buttons</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">fixed</span><span style=\"color:#660\">=</span><span style=\"color:#000\">T</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    buttons </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> gsub</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;&lt;span&gt;Choice 3&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&lt;span&gt;&lt;font color=&quot;green&quot;&gt;Choice 3&lt;/font&gt;&lt;/span&gt;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> buttons</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">fixed</span><span style=\"color:#660\">=</span><span style=\"color:#000\">T</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    HTML</span><span style=\"color:#660\">(</span><span style=\"color:#000\">buttons</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br>ui </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>        myRadioButtons</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"><br>        hr</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"><br>        fluidRow</span><span style=\"color:#660\">(</span><span style=\"color:#000\">column</span><span style=\"color:#660\">(</span><span style=\"color:#066\">3</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> verbatimTextOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;value&quot;</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">){</span><span style=\"color:#000\">    <br>    output$value </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPrint</span><span style=\"color:#660\">({</span><span style=\"color:#000\"> input$radio </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><sp