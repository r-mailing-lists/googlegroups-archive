pan style=\"color:#660\">=</span><span style=\"color:#000\"> TRUE<br>                      </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>           </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    <br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># -------------------------------------------------------------------</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\"># Single zoomable plot (on left)</span><span style=\"color:#000\"><br>  ranges </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactiveValues</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> NULL</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> NULL</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Write to a temporary PNG file</span><span style=\"color:#000\"><br>  outfile </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> tempfile</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fileext </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\"