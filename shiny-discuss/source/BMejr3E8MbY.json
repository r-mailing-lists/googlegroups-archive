   "date": "2016-07-31T14:45:02Z",
   "subject": "Re: uiOutput interdependencies",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">Hi,<br><br>you can do it directly:<br><br><code>\r\n</code><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">output$A </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderUI</span><span style=\"color:#660\">({</span><span style=\"color:#000\"> <br>  choicesA </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;A&quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;B&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#066\">2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> <br>  selectInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;A&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choose&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choicesA</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br>output$B </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderUI</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br> </span><span style=\"color:#008\"> if</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$A</span><span style=\"color:#660\">==</span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"> </span><code><span style=\"color:#000\"><br></span></code><code><span style=\"color:#000\">    choicesB1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> something</span></code><br><code><span style=\"color:#000\"></span></code><code><span style=\"color:#000\"></span></code><code><pre><code><span style=\"color:#000\">    ret &lt;- selectInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;B&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choose&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choicesB1)</span></code></pre></code><span style=\"color:#000\">  </span><span style=\"color:#660\">}</span><span style=\"color:#000\"> </span><span style=\"color:#008\">else</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br></span><code><code><span style=\"color:#000\">    choicesB2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> something</span></code><br><code><span style=\"color:#000\"></span></code><code><span style=\"color:#000\"></span></code><code><pre><code><span style=\"color:#000\">    ret &lt;- selectInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;B&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choose&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choicesB2)</span></code></pre></code></code><span style=\"color:#000\"></span><span style=\"color:#660\">  }</span><span style=\"color:#000\"><br>  ret<br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div><pre><code><br>Best Sigbert</code></pre><br><br></div>"
