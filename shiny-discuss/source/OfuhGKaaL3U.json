an><span style=\"color:rgb(128,0,0)\">&quot;New Patient Information Added&quot;</span><span style=\"color:rgb(0,0,0)\">\r\n      newpatientrow </span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> data.frame</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">input</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">newptnum</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> input</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">newptsy</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">0</span><span style=\"color:rgb(0,0,0)\">)</span><span style=\"color:rgb(0,0,0)\">\r\n      names</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">newpatientrow</span><span style=\"color:rgb(0,0,0)\">)[</span><span style=\"color:rgb(128,0,0)\">1</span><span style=\"color:rgb(0,0,0)\">]&lt;-</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">&quot;patientlist&quot;</span><span style=\"color:rgb(0,0,0)\">\r\n      names</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">newpatientrow</span><span style=\"color:rgb(0,0,0)\">)[</span><span style=\"color:rgb(128,0,0)\">2</span><span style=\"color:rgb(0,0,0)\">]&lt;-</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">&quot;patientsy&quot;</span><span style=\"color:rgb(0,0,0)\">\r\n      names</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">newpatientrow</span><span style=\"color:rgb(0,0,0)\">)[</span><span style=\"color:rgb(128,0,0)\">3</span><span style=\"color:rgb(0,0,0)\">]&lt;-</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">&quot;patientdx&quot;</span><span style=\"color:rgb(0,0,0)\">\r\n      print</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">newpatientrow</span><span style=\"color:rgb(0,0,0)\">)</span><span style=\"color:rgb(0,0,0)\">\r\n      patientdata </span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> rbind</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">patientdata</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\">newpatientrow</span><span style=\"color:rgb(0,0,0)\">)}</span></code></pre></div></div></blockquote></div></div>"
