     1,
     "<div dir=\"ltr\">Hi,<div><br></div><div>Thank you for your help. I understand what you are trying to do and I&#39;ve edited my code as such:</div><div><br></div><div><div>shinyServer(</div><div>  function(input, output, session){</div><div>    </div><div>    patientdata &lt;- reactive({readWorksheet(db, sheet=&quot;Sheet1&quot;)})</div><div>    </div><div>    output$newptnum &lt;- renderText({input$newptnum})</div><div>    output$newptsy &lt;- renderText({input$newptsy})</div><div>    output$patientdata &lt;- renderTable({patientdata()})</div><div>    observeEvent(input$goButton,{</div><div>#       &quot;New Patient Information Added&quot;</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div>      newpatientrow &lt;- data.frame(input$newptnum, input$newptsy, 0)</div><div>      names(newpatientrow)[1]&lt;- &quot;patientlist&quot;</div><div>      names(newpatientrow)[2]&lt;- &quot;patientsy&quot;</div><div>      names(newpatientrow)[3]&lt;- &quot;patientdx&quot;</div></div></div>"
