    [
     1,
     "<div dir=\"ltr\">Sorry, I forgot to edit out the <font face=\"courier new, monospace\">reactiveVal()</font> part. If you use <font face=\"courier new, monospace\">shiny = TRUE</font>, you really don&#39;t need that anymore, since your counter will already behave reactively. Here&#39;s what the shiny app should look like:<div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div></div></code></div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><div><font color=\"#660066\">ui &lt;- fluidPage(</font></div><div><font color=\"#660066\">  actionButton(&quot;minus&quot;, &quot;-1&quot;),</font></div><div><font color=\"#660066\">  actionButton(&quot;plus&quot;, &quot;+1&quot;),</font></div><div><font color=\"#660066\">  textOutput(&quot;value&quot;)</font></div><div><font color=\"#660066\">)</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">server &lt;- function(input, output, session) {</font></div></div></code></div></div></div>"
