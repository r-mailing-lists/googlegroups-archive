e=\"color:rgb(0,0,0)\"> origins$Origin_Name</span><span style=\"color:rgb(0,0,0)\">)</span><span style=\"color:rgb(0,0,0)\">\r\n</span><span style=\"color:rgb(0,0,0)\">})</span><span style=\"color:rgb(0,0,0)\">\r\n\r\n\r\nquery</span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\">reactive</span><span style=\"color:rgb(0,0,0)\">({</span><span style=\"color:rgb(0,0,0)\">\r\n                 sql</span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\">dbGetQuery</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">db</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\">paste0</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(128,0,0)\">&#39;SELECT Region_Name from CNS_Origin_List Where Origin_Name =&quot;&#39;</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\">input$origin</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(128,0,0)\">&#39;&quot;&#39;</span><span style=\"color:rgb(0,0,0)\">))</span><span style=\"color:rgb(0,0,0)\">\r\n</span><span style=\"color:rgb(0,0,0)\">})</span><span style=\"color:rgb(0,0,0)\">\r\n\r\n\r\n\r\n\r\n\r\n</span><span style=\"color:rgb(128,128,128)\">#This is where the error occurs when I call the query()</span><span style=\"color:rgb(0,0,0)\">\r\noutput$region</span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\">renderTable</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">query</span><span style=\"color:rgb(0,0,0)\">())</span><span style=\"color:rgb(0,0,0)\">\r\n\r\n\r\ndbDisconnect</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">db</span><span style=\"color:rgb(0,0,0)\">)</span><span style=\"color:rgb(0,0,0)\">\r\n</span><span style=\"color:rgb(0,0,0)\">})</span></code></pre><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(2