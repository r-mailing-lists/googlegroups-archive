)</span><span style=\"color:rgb(0,0,0)\">\r\n    output</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">plot1 </span><span style=\"color:rgb(0,0,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> renderText</span><span style=\"color:rgb(0,0,0)\">({</span><span style=\"color:rgb(0,0,0)\">as.numeric</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">input</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">text1</span><span style=\"color:rgb(0,0,0)\">),</span><span style=\"color:rgb(0,0,0)\"> as.numeric</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">input</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">text2</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> as.numeric</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">input</span><span style=\"color:rgb(0,0,0)\">$</span><span style=\"color:rgb(0,0,0)\">text3</span><span style=\"color:rgb(0,0,0)\">})</span><span style=\"color:rgb(0,0,0)\">\r\n      par</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">mar </span><span style=\"color:rgb(0,0,0)\">=</span><span style=\"color:rgb(0,0,0)\"> c</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(128,0,0)\">6.1</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">4.1</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">0</span><span style=\"color:rgb(0,0,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(128,0,0)\">1</span><span style=\"color:rgb(0,0,0)\">))</span><span style=\"color:rgb(0,0,0)\">\r\n      plot</span><span style=\"color:rgb(0,0,0)\">(</span><span style=\"color:rgb(0,0,0)\">selectedData</span><span style=\"color:rgb(0,0,0)\">(),</span><spa