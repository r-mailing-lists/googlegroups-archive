     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif;background-image:initial;background-repeat:initial\">Hi all,</span><span lang=\"EN-US\" style=\"font-family:&quot;Times New Roman&quot;,&quot;serif&quot;\"><u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\">I&#39;m struggling to use downloadHandler()\r\nto return a “existed” pdf file which is stored in the same directory with the ui.R\r\nand server.R.<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\">Under my Shiny app directory, I have three files:\r\nui.R, server.R, and a pdf file (“population.pdf”). What I want to do is using </span><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\">downloadHandler() to\r\nreturn a copy of the pdf to the users. Currently I have written something like\r\nbelow but it failed. Would like to ask how should it be done? Or should I even\r\nuse downloadHandler()?<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">#################################################################</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><font face=\"Arial, sans-serif\"><span style=\"font-size:13.3333px\"><u>UI.R</u></span></font></p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">shinyUI(<br></p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">  fluidPage(</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">    titlePanel(h3(strong(&quot;XXX&quot;)), windowTitle = &quot;XXX&quot;),</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">    sidebarLayout(position = &quot;right&quot;,</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                  sidebarPanel(</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                    downloadButton(&#39;downloadData&#39;, &#39;Download&#39;)</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                      </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                  ), #sidebarPanel</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                  </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                  mainPanel(</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                    p(&quot;Summary&quot;)</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">                  )</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">    )</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">  ) </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">) </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">##################################################################</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><u>server.R</u></p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">shinyServer(</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">  function(input, output){</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">      </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">      output$downloadData &lt;- downloadHandler(</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">      filename = &quot;summary.pdf&quot;,</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">      content = function(file) {</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">          src &lt;- normalizePath(&quot;population.pdf&quot;, mustWork = T);</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">          owd &lt;- setwd(tempdir());</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">          on.exit(setwd(owd));</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">          file.copy(src, &#39;population_projection.pdf&#39;)</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">          file.rename(src,file)</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">        } </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">      )</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">    } </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">) </p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\">#################################################################</p><p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><br></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\"> </span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\">Many thanks,<u></u><u></u></span></p>\r\n\r\n<p class=\"MsoNormal\" style=\"background-image:initial;background-repeat:initial\"><span lang=\"EN-US\" style=\"font-size:10pt;font-family:Arial,sans-serif\">Geoff<span><font color=\"#888888\"><u></u><u></u></font></span></span></p></div></blockquote></div></div>"
