n style=\"color:#000\"> </span><span style=\"color:#066\">6</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> weight </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> fillColor </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;red&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> fillOpacity </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0.3</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>    <br>    output$my_rows </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPrint</span><span style=\"color:#660\">({</span><span style=\"color:#000\"> filteredData</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"> nrow</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>                 <br>shinyApp</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ui </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> ui</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> server </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> server</span><span style=\"color:#660\">)</span></div></code></div><div><br></div></div></div>"
