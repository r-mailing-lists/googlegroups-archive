lor:#080\">&quot;B&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;C&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> selected </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;A&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;B&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;C&quot;</span><span style=\"color:#660\">)),</span><span style=\"color:#000\"><br>                verbatimTextOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;my_rows&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  <br>  filteredData </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">(</span><span style=\"color:#000\"> my_df </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"> filter</span><span style=\"color:#660\">(</span><span style=\"color:#000\">category </span><span style=\"color:#660\">%</span><span style=\"color:#008\">in</span><span style=\"color:#660\">%</span><span style=\"color:#000\"> input$choices</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>    outp