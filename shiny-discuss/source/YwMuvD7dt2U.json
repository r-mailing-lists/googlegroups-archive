     1,
     "<div dir=\"ltr\">Have you tried using &quot;<code>renderUI&quot;  and HTMLoutput instead?<br><br></code><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">source</span><span style=\"color:#660\">:</span><span style=\"color:#000\">http</span><span style=\"color:#660\">:</span><span style=\"color:#800\">//<a href=\"http://stackoverflow.com/questions/24875943/display-html-file-in-shiny-app\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://stackoverflow.com/questions/24875943/display-html-file-in-shiny-app&amp;source=gmail&amp;ust=1792395083472000&amp;usg=AOvVaw07DJDWeyyd-Vw8VZBXucaD\">stackoverflow.com/questions/24875943/display-html-file-in-shiny-app</a></span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># ----- ui.R -----</span><span style=\"color:#000\"><br><br>shinyUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br> titlePanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Uploading Files&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br> mainPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br> htmlOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;inc&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># ----- server.R -----</span><span style=\"color:#000\"><br><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br> getPage</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#008\">function</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br> </span><span style=\"color:#008\">return</span><span style=\"color:#660\">(</span><span style=\"color:#000\">includeHTML</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;include.html&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br> </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br> output$inc</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">renderUI</span><span style=\"color:#660\">({</span><span style=\"color:#000\">getPage</span><span style=\"color:#660\">()})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div></div>"
