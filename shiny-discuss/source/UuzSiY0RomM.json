ttps://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail/%23!overview&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw02uIhKPTTmX-HWJt-EfP2D\"><img style=\"border:0;vertical-align:middle\" src=\"https://ci5.googleusercontent.com/proxy/4SGWHe9midrWMDxDIJMQraTMMgnAU71soPZ0D28IOSZcs66TdyRoCqyIhaTt-kwo0YKv2lRo05RkwsGFZdnFhdvy60XdxNlL2U-B=s0-d-e1-ft#http://www.google.com/images/icons/product/groups-32.png\"></a>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n  <div style=\"padding:20px;background-color:#f5f5f5\">\r\n\r\n\r\n<div style=\"font-family:arial;color:#222222;padding:0px\">\r\n  <a name=\"m_-4750282094551432238_digest_top\" style=\"font-size:21px\" rel=\"nofollow\">\r\n  \r\n    Today&#39;s topic summary\r\n  \r\n  \r\n  </a><br>\r\n  <span style=\"font-size:11px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/shiny-discuss/topics\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/shiny-discuss/topics&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2PFTWs3MP-cWa39_0zUOXT\">View all topics</a>\r\n  </span>\r\n</div>\r\n<div style=\"font:13px/18px arial;color:#222222;padding:0px;margin-bottom:30px\">\r\n  <ul style=\"margin-left:3px;padding-left:0px\">\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_0\" rel=\"nofollow\">\r\n      Shiny server incredibly slow on IE9</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_1\" rel=\"nofollow\">\r\n      Show app UI in three steps</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_2\" rel=\"nofollow\">\r\n      How to avoid double plot evaluation?</a> -\r\n      <span style=\"color:#777777\">3 Updates</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_3\" rel=\"nofollow\">\r\n      Scoping Issue for reactive dataframes</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_4\" rel=\"nofollow\">\r\n      Render datatable with sparklines in Shiny</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_group_thread_5\" rel=\"nofollow\">\r\n      updating and saving the updates in shiny</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n  </ul>\r\n</div>\r\n\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_0\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/55685c65d75f451a?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/55685c65d75f451a?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2fcJ_z14DCxSl74ceY3yxf\">\r\n      Shiny server incredibly slow on IE9\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Chris Beeley &lt;<a href data-email-masked rel=\"nofollow\">chris....@gmail.com</a>&gt;: Jan 05 04:41PM\r\n      </span>\r\n      <br><br>\r\n      Joe, you are, as ever, a genius. That fixed it.<br>\r\n <br>\r\nJust in case it helps anyone else, it was xdr-polling that was the culprit,<br>\r\nwhich means you need to add the following line to your\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14ea8c6408a742?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14ea8c6408a742?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2uVjzE7JjvyW4zsb-Y4eVC\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_1\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/c9daf6efedcb51d6?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/c9daf6efedcb51d6?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw3i3oTvZMyEklorNpP86pBg\">\r\n      Show app UI in three steps\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        &quot;Bárbara Borges&quot; &lt;<a href data-email-masked rel=\"nofollow\">bar...@rstudio.com</a>&gt;: Jan 05 08:19AM -0800\r\n      </span>\r\n      <br><br>\r\n      Can you elaborate what you mean by &quot;I can get Shiny to run all this at <br>\r\nonce, but not for the questions to be asked sequentially and work <br>\r\nproperly.&quot;? What exactly is the problem? What are the\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14e9514b258739?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14e9514b258739?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw10WWitmti8kabbLNYxNCbA\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_2\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/8247aec8f0199dd3?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/8247aec8f0199dd3?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw3PY2jGtBXdUBLOoXK1VNgA\">\r\n      How to avoid double plot evaluation?\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        &quot;Joe Cheng [RStudio]&quot; &lt;<a href data-email-masked rel=\"nofollow\">j...@rstudio.com</a>&gt;: Jan 04 10:20PM -0800\r\n      </span>\r\n      <br><br>\r\n      Improved <br>\r\nversion: <a href=\"https://gist.github.com/jcheng5/3499a8201b8cb98b4593c8bce9fc6737\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://gist.github.com/jcheng5/3499a8201b8cb98b4593c8bce9fc6737&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw3zQBZdI4QFhsTSwDpM1kzx\">https://gist.github.com/jcheng5/3499a8201b8cb98b4593c8bce9fc6737</a><br>\r\n <br>\r\nThere were two problems here, one pretty fundamental and then one subtle <br>\r\ntrick.<br>\r\n <br>\r\nThe fundamental issue is\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14c89e2ac0f40d?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14c89e2ac0f40d?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2l0ejg6pGqn5H6hWemnrt_\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        mattek &lt;<a href data-email-masked rel=\"nofollow\">macd...@gmail.com</a>&gt;: Jan 05 02:46AM -0800\r\n      </span>\r\n      <br><br>\r\n      Thank you for this amazing insightful answer! This does solve my problem.<br>\r\n <br>\r\nWhen I was using observeEvent + reactiveValues it did feel like I was doing <br>\r\nthe wrong thing but version I had with\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14d71f391273a8?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14d71f391273a8?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw0r5RXEqJNcYGhx8LmsfOkG\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Stephen McDaniel &lt;<a href data-email-masked rel=\"nofollow\">stephen....@gmail.com</a>&gt;: Jan 05 08:53AM -0500\r\n      </span>\r\n      <br><br>\r\n      Hi Mattek,<br>\r\n <br>\r\nJoe answered your original question. So that should help you understand the<br>\r\nnuances of reactive programming relative to your app.<br>\r\n <br>\r\nI wanted to streamline your example and expand upon\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14e15ba1183caa?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14e15ba1183caa?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw1HPzBPR0ONNkbjpg83Cmto\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_3\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/28e291b7bbac8a69?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/28e291b7bbac8a69?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2Z3Ul5ygj-jHroXXDEHVIq\">\r\n      Scoping Issue for reactive dataframes\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        &quot;Joe Cheng [RStudio]&quot; &lt;<a href data-email-masked rel=\"nofollow\">j...@rstudio.com</a>&gt;: Jan 05 03:13AM -0800\r\n      </span>\r\n      <br><br>\r\n      Sorry for the delay.<br>\r\n <br>\r\nI&#39;m not 100% sure I understand exactly what you&#39;re saying, but from the <br>\r\nsounds of it you need:<br>\r\n <br>\r\n1. Move away from reactiveValues and observeEvent where possible. Watch/do \r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14d89e8b773df0?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14d89e8b773df0?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw08bwneO8KEBp-9g9d2uazZ\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_4\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/16c6f7399ef54984?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/16c6f7399ef54984?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw1YZa24MhCnJZEagliI3nMt\">\r\n      Render datatable with sparklines in Shiny\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Grant &lt;<a href data-email-masked rel=\"nofollow\">grantirv...@gmail.com</a>&gt;: Jan 04 11:54PM -0800\r\n      </span>\r\n      <br><br>\r\n      I want to include sparklines in a shiny DT. It works fine in the RStudio <br>\r\nviewer but in Shiny the sparklines are not rendered. Here is a minimal <br>\r\nexample. I suspect the problem has to do with adding\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14cdc864a3102f?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14cdc864a3102f?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw1Q1yqzGtCcsTZ3CgwqXtsO\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-4750282094551432238_group_thread_5\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/shiny-discuss/t/95c42fa90e09f1e1?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/t/95c42fa90e09f1e1?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw3HDyudT0ChyKmpEUEmzB0P\">\r\n      updating and saving the updates in shiny\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Nazia Afreen &lt;<a href data-email-masked rel=\"nofollow\">nazia.a...@gmail.com</a>&gt;: Jan 04 10:40PM -0800\r\n      </span>\r\n      <br><br>\r\n      I am updating an blank standard file with the matching columns from the <br>\r\nuploaded file .I am able to populate the blank file with the desired column <br>\r\nfrom the uploaded file but problem is that as\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/shiny-discuss/msg/14c9bfc77a1ef2?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/shiny-discuss/msg/14c9bfc77a1ef2?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw1-mP9es_rfKfwpZ7v3vIza\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-4750282094551432238_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n\r\n\r\n  </div>\r\n  <div style=\"background-color:#f5f5f5;padding:5px 20px\">\r\n  <table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\">\r\n  <tbody><tr>\r\n    <td style=\"padding-top:4px;font-family:arial,sans-serif;color:#636363;font-size:11px\">\r\n      \r\n      You received this digest because you&#39;re subscribed to updates for this group. You can change your settings on the <a href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/shiny-discuss/join\" style=\"color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/shiny-discuss/join&amp;source=gmail&amp;ust=1792390908802000&amp;usg=AOvVaw2dXbwqe507rMVoqxwzvJlm\">group membership page</a>.<br>\r\n      To unsubscribe from this group and stop receiving emails from it send an email to <a href data-email-masked rel=\"nofollow\">shiny-discus...@googlegroups.com</a>.\r\n    </td>\r\n  </tr></tbody>\r\n  </table>\r\n  </div>\r\n</div>\r\n\r\n<br></div></div>\r\n"
