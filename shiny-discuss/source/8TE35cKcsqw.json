   "parts": [
    [
     1,
     "<div style=\"white-space:pre-wrap\">You may also want to look at selectInput if you haven&#39;t already. This way you can prepopulate it with all the possible columns and offer autocomplete. <br><a href=\"http://shiny.rstudio.com/articles/selectize.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://shiny.rstudio.com/articles/selectize.html&amp;source=gmail&amp;ust=1792391464960000&amp;usg=AOvVaw0mPrRHPEahfqCPUTUhEgi2\">http://shiny.rstudio.com/articles/selectize.html</a><br></div><div class=\"gmail_quote\"></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\">On Sat, Nov 12, 2016 at 7:26 PM Dean Attali &lt;<a href data-email-masked rel=\"nofollow\">daat...@gmail.com</a>&gt; wrote:<br></div></div>"
    ],
    [
