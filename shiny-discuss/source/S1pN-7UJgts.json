yle=\"box-sizing:border-box\">label</span></span></span><span style=\"box-sizing:border-box;color:rgb(0,0,255)\">,</span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(0,0,0)\"><span style=\"box-sizing:border-box\">choices</span></span></span><span style=\"box-sizing:border-box;color:rgb(0,0,255)\">,</span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(0,0,0)\"><span style=\"box-sizing:border-box\">selected</span></span></span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(104,118,135)\"><span style=\"box-sizing:border-box\">=</span></span></span> <span style=\"box-sizing:border-box;color:rgb(88,72,246)\"><span style=\"box-sizing:border-box\">NULL</span></span><span style=\"box-sizing:border-box;color:rgb(0,0,255)\">,</span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(0,0,0)\"><span style=\"box-sizing:border-box\">multiple</span></span></span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(104,118,135)\"><span style=\"box-sizing:border-box\">=</span></span></span> TRUE,<br>  <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(0,0,0)\"><span style=\"box-sizing:border-box\">selectize</span></span></span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(104,118,135)\"><span style=\"box-sizing:border-box\">=</span></span></span> <span style=\"box-sizing:border-box;color:rgb(0,0,205)\"><span style=\"box-sizing:border-box;color:rgb(88,72,246)\"><span style=\"box-sizing:border-box\">TRUE</span></span></span><span style=\"box-sizing:border-box;color:rgb(0,0,255)\">,</span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(0,0,0)\"><span style=\"box-sizing:border-box\">width</span></span></span> <span style=\"box-sizing:border-box\"><span style=\"box-sizing:border-box;color:rgb(104,118,13