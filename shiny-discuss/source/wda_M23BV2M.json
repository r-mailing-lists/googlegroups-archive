   "parts": [
    [
     1,
     "<div dir=\"ltr\">Hi, I am new to Shiny.  Here is my syntax: <div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><div><font color=\"#660066\">file &lt;-read.csv(&#39;file.csv&#39;)</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">ui &lt;- fluidPage(</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">        plotOutput(&quot;plot1&quot;, height = 550, click = &quot;plot1_click&quot;),</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">    fluidRow(</font></div><div><font color=\"#660066\">        column(3,</font></div><div><font color=\"#660066\">        sliderInput(&quot;Obs&quot;, &quot;Number of Cars&quot;, min = 1, max = nrow(up), value = 50)</font></div><div><font color=\"#660066\">        ),</font></div><div><font color=\"#660066\">        column(3, offset = 3, </font></div><div><font color=\"#660066\">               h4(&quot;Legends&quot;),</font></div><div><font color=\"#660066\">         verbatimTextOutput(&quot;selected&quot;)</font></div><div><font color=\"#660066\">        )  </font></div><div><font color=\"#660066\">      )</font></div><div><font color=\"#660066\">      </font></div><div><font color=\"#660066\"> </font></div><div><font color=\"#660066\">    )</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">server &lt;- function(input, output) {</font></div><div><font color=\"#660066\">   mydata &lt;- reactive({</font></div><div><font color=\"#660066\">    file[1:as.numeric(input$Obs),]</font></div><div><font color=\"#660066\">  })</font></div><div><font color=\"#660066\">   </font></div><div><font color=\"#660066\">  output$plot1 &lt;- renderPlot({</font></div><div><font color=\"#660066\">    test &lt;- mydata()</font></div><div><font color=\"#660066\">    ggplot(data = test, aes(x = Cars, y = Names, group = &#39;Company&#39;, color = &#39;Cars&#39;)) +  geom_point()</font></div><div><font color=\"#660066\">  })</font></div><div><font color=\"#660066\">  </font></div><div><font color=\"#660066\">  output$selected &lt;- renderText({</font></div><div><font color=\"#660066\">    paste0(&quot;Cars=&quot;, input$plot1_click$x, &quot;\\n&quot;,</font></div><div><font color=\"#660066\">           &quot;Owner=&quot;, input$plot1_click$y)</font></div><div><font color=\"#660066\">  })</font></div><div><font color=\"#660066\">  </font></div><div><font color=\"#660066\">}</font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\"><br></font></div><div><font color=\"#660066\">shinyApp(ui = ui, server = server)</font></div><div><br></div></div></code></div><br><div>Here, input$plot1_click$y gives coordinate. What I have to do if I want to print the y-axis components (Names, here). </div></div>"
    ]
   ]
  },
