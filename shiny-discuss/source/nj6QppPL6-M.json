54)\">+</span><span style=\"color:rgb(48,51,54)\"> nchar</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">pattern</span><span style=\"color:rgb(48,51,54)\">),</span><span style=\"color:rgb(48,51,54)\"> nchar</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">text</span><span style=\"color:rgb(48,51,54)\">))</span><span style=\"color:rgb(48,51,54)\">\r\nresult </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> paste</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">afterPattern</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> replaceWith</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> beforePattern</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\nresult\r\n</span><span style=\"color:rgb(48,51,54)\">}</span></code></pre></div>\r\n\r\n<p></p>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;Shiny - Web Framework for R&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a rel=\"nofollow\">shiny-discus...@googlegroups.com</a>.<br>\r\nTo view this discussion on the web visit <a href=\"https://groups.google.com/d/msgid/shiny-discuss/7ec94129-4f80-43f6-be0c-bb900fdde30b%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/shiny-discuss/7ec94129-4f80-43f6-be0c-bb900fdde30b%2540googlegroups.com?utm_medium%3Demail%26utm_source%3Dfooter&amp;source=gmail&amp;ust=1792391295037000&amp;usg=AOvVaw173eTgr_pV1eWuXCPOU8oR\">https://groups.google.com/d/msgid/shiny-discuss/7ec94129-4f80-43f6-be0c-bb900fdde30b%40googlegroups.com</a>.<br>\r\nFor more options, visit <a href=\"https://groups.