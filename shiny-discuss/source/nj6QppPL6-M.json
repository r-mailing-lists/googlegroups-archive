or:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> text</span><span style=\"color:rgb(48,51,54)\">)[</span><span style=\"color:rgb(125,39,39)\">1</span><span style=\"color:rgb(48,51,54)\">]</span><span style=\"color:rgb(125,39,39)\">-1</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\nafterPattern </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> substr</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">text</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> regexpr</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">pattern</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\">text</span><span style=\"color:rgb(48,51,54)\">)[</span><span style=\"color:rgb(125,39,39)\">1</span><span style=\"color:rgb(48,51,54)\">]</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">+</span><span style=\"color:rgb(48,51,54)\"> nchar</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">pattern</span><span style=\"color:rgb(48,51,54)\">),</span><span style=\"color:rgb(48,51,54)\"> nchar</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">text</span><span style=\"color:rgb(48,51,54)\">))</span><span style=\"color:rgb(48,51,54)\">\r\nresult </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> paste</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">afterPattern</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> replaceWith</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> beforePattern</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\nresult\r\n</span><span style=\"color:rgb(48