or:#000\">df</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"> addTiles</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  addMarkers</span><span style=\"color:#660\">(~</span><span style=\"color:#606\">Long</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#660\">~</span><span style=\"color:#606\">Lat</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> popup </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">~</span><span style=\"color:#000\">htmlTable</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Name</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Long</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Lat</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br><br></span></div></code></div></div>\r\n\r\n<p></p></blockquote></div>"
