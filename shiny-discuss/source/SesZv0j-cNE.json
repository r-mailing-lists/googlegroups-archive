     1,
     "<div dir=\"ltr\">Thanks. This worked for me<br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">popup </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> apply</span><span style=\"color:#660\">(</span><span style=\"color:#000\">df</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">row</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> htmlTable</span><span style=\"color:#660\">(</span><span style=\"color:#000\">row</span><span style=\"color:#660\">))</span></div></code></div><br><br></div>"
    ]
