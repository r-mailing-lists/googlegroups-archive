an><span style=\"color:rgb(3,106,7)\">&quot;n&quot;</span></span><span>,</span> \r\n                <span><span style=\"color:rgb(3,106,7)\">&quot;Number of observations:&quot;</span></span><span>,</span> \r\n                 <span style=\"color:rgb(0,0,0)\">value</span> <span><span style=\"color:rgb(104,118,135)\">=</span></span> <span><span style=\"color:rgb(0,0,205)\">500</span></span><span>,</span>\r\n                 <span style=\"color:rgb(0,0,0)\">min</span> <span><span style=\"color:rgb(104,118,135)\">=</span></span> <span><span style=\"color:rgb(0,0,205)\">1</span></span><span>,</span> \r\n                 <span style=\"color:rgb(0,0,0)\">max</span> <span><span style=\"color:rgb(104,118,135)\">=</span></span> <span><span style=\"color:rgb(0,0,205)\">1000</span></span><span><span style=\"color:rgb(104,118,135)\">)</span></span>\r\n  <span><span style=\"color:rgb(104,118,135)\">)</span>,</span>\r\n\r\n  <span><span style=\"color:rgb(76,136,107)\"># Show a tabset that includes a plot, summary, and table view</span></span>\r\n  <span><span style=\"color:rgb(76,136,107)\"># of the generated distribution</span></span>\r\n  <span style=\"color:rgb(0,0,0)\">mainPanel</span><span><span style=\"color:rgb(104,118,135)\">(</span></span>\r\n    <span style=\"color:rgb(0,0,0)\">tabsetPanel</span><span><span style=\"color:rgb(104,118,135)\">(</span></span>\r\n      <span style=\"color:rgb(0,0,0)\">tabPanel</span><span><span style=\"color:rgb(104,118,135)\">(</span></span><span><span style=\"color:rgb(3,106,7)\">&quot;Plot&quot;</span></span><span>,</span> <span style=\"color:rgb(0,0,0)\">plotOutput</span><span><span style=\"color:rgb(104,118,135)\">(</span></span><span><span style=\"color:rgb(3,106,7)\">&quot;plot&quot;</span></span><span><span style=\"color:rgb(104,118,135)\">)</span><span style=\"color:rgb(104,118,135)\">)</span>,</span> \r\n      <span style=\"color:rgb(0,0,0)\">tabPanel</span><span><span style=\"color:rgb(104,118,135)\">(</span></span><span><span styl