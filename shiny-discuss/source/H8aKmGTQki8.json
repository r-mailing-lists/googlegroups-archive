ospace;border-top-left-radius:4px;border-top-right-radius:4px;border-bottom-right-radius:4px;border-bottom-left-radius:4px;line-height:18px;word-break:break-all;word-wrap:break-word;white-space:pre-wrap;background-color:rgb(245,245,245);color:rgb(51,51,51)\"><pre style=\"margin-bottom:9px;padding:8.5px;border:1px solid rgba(0,0,0,0.14902);font-size:12.025px;font-family:&#39;DejaVu Sans Mono&#39;,&#39;Droid Sans Mono&#39;,&#39;Lucida Console&#39;,Consolas,Monaco,monospace;border-top-left-radius:4px;border-top-right-radius:4px;border-bottom-right-radius:4px;border-bottom-left-radius:4px;line-height:18px;word-break:break-all;word-wrap:break-word;white-space:pre-wrap\"><code style=\"font-family:&#39;DejaVu Sans Mono&#39;,&#39;Droid Sans Mono&#39;,&#39;Lucida Console&#39;,Consolas,Monaco,monospace;font-size:12px;color:inherit;border-top-left-radius:3px;border-top-right-radius:3px;border-bottom-right-radius:3px;border-bottom-left-radius:3px;background-color:transparent\">  <span style=\"color:rgb(0,0,0)\">mainPanel</span><span><span style=\"color:rgb(104,118,135)\">(</span></span><span style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:normal;white-space:normal;background-color:rgb(255,255,255);color:rgb(80,0,80)\"> tags$img(src=&quot;</span><a href=\"http://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Rlogo.png/200px-Rlogo.png\" style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:normal;white-space:normal;background-color:rgb(255,255,255)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Rlogo.png/200px-Rlogo.png&amp;source=gmail&amp;ust=1792406770379000&amp;usg=AOvVaw2K4eGdgyo66QIi0aWkzxSd\">http://upload.wikimedia.org/wikipedia/commons/thumb/c/c1/Rlogo.png/200px-Rlogo.png</a><span style=\"font-family:Arial,Helvetica,sans-serif;font-size:13px;line-height:normal;white-space:normal;background-color:rgb(255,255,255);