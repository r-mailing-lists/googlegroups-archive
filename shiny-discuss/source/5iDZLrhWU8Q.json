olor:rgb(51,51,51)\">,</span><font color=\"#333333\"> </font><span style=\"color:rgb(51,51,51);font-weight:bold\">...</span><span style=\"color:rgb(51,51,51)\">,</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">                      .level <span style=\"font-weight:bold\">=</span> <span style=\"color:rgb(0,153,153)\">1L</span><span>,</span> .withNames <span style=\"font-weight:bold\">=</span> length<span>(</span>x<span>)</span> <span style=\"font-weight:bold\">&gt;</span> <span style=\"color:rgb(0,153,153)\">0</span> <span style=\"font-weight:bold\">&amp;&amp;</span> length<span>(</span>names<span>(</span>x<span>))</span> <span style=\"font-weight:bold\">&gt;</span> <span style=\"color:rgb(0,153,153)\">0</span><span>,</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">                        .na <span style=\"font-weight:bold\">=</span> <span style=\"color:rgb(221,17,68)\">&quot;null&quot;</span><span>,</span> .escapeEscapes <span style=\"font-weight:bold\">=</span> <span style=\"font-weight:bold\">TRUE</span><span>,</span> pretty <span style=\"font-weight:bold\">=</span> <span style=\"font-weight:bold\">FALSE</span><span>,</span> asIs <span style=\"font-weight:bold\">=</span> <span style=\"font-weight:bold\">NA</span><span>)</span> <span>{</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\"><br></div><div style=\"color:rgb(51,51,51);padding-left:10px\">            <span style=\"font-weight:bold\">if</span><span>(</span>any<span>(</span>is.infinite<span>(</span>x<span>)))</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">              warning<span>(</span><span style=\"color:rgb(221,17,68)\">&quot;non-fininte values in numeric vector may not be approriately represented in JSON&quot;</span><span>)</span>             </div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\"><br></div><div style=\"color:rgb(51,51,51);padding-left:10px\">             tmp <span style=\"font-weight:bold\">=</span> formatC<span>(</span>x<span>,</span> digits <span style=\"font-weight:bold\">=</span> digits<span>)</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">             <span style=\"font-weight:bold\">if</span><span>(</span>any<span>(</span>nas <span style=\"font-weight:bold\">&lt;-</span> <a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792407952816000&amp;usg=AOvVaw0vqaA-FUtRc6B4QLnScIiy\">is.na</a><span>(</span>x<span>)))</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">                 tmp<span>[</span>nas<span>]</span> <span style=\"font-weight:bold\">=</span> .na                          </div>\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">             </div><div style=\"color:rgb(51,51,51);padding-left:10px\">             <span style=\"font-weight:bold\">if</span><span>(</span>container<span>)</span> <span>{</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">                <span style=\"font-weight:bold\">if</span><span>(</span>.withNames<span>)</span></div><div style=\"color:rgb(51,51,51);padding-left:10px\">\r\n                   paste<span>(</span>sprintf<span>(</span><span style=\"color:rgb(221,17,68)\">&quot;{%s&quot;</span><span>,</span> collapse<span>),</span> paste<span>(</span>dQuote<span>(</span>names<span>(</span>x<span>)),</span> tmp<span>,</span> sep <span style=\"font-weight:bold\">=</span> <span style=\"color:rgb(221,17,68)\">&quot;: &quot;</span><span>,</span> collapse <span style=\"font-weight:bold\">=</span> sprintf<span>(</span><span style=\"color:rgb(221,17,68)\">&quot;,%s&quot;</span><span>,</span> collapse<span>)),</span></div>\r\n\r\n\r\n<div style=\"color:rgb(51,51,51);padding-left:10px\">                                   sprintf<span>(</span><span style=\"color:rgb(221,17,68)\">&quot;%s}&quot