     "<div dir=\"ltr\"><div><p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">shinyServer(<span style=\"color:#c38809\">function</span>(<span style=\"color:#000000\">input</span>, <span style=\"color:#000000\">output</span>) {</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\"><span style=\"white-space:pre\">\t</span><span style=\"color:#000000\">input</span>&lt;- reactive({</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">    switch(<span style=\"color:#000000\">input</span>$<span style=\"color:#000000\">variable</span>,</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">           <span style=\"color:#b01600\">&quot;id&quot;</span> = <span style=\"color:#000000\">tu</span>$<span style=\"color:#000000\">id</span>,</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">          <span style=\"color:#b01600\">&quot;size&quot;</span> = <span style=\"color:#000000\">tu</span>$<span style=\"color:#000000\">size</span>,</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">          <span style=\"color:#b01600\">&quot;months&quot;</span> = <span style=\"color:#000000\">tu</span>$<span style=\"color:#000000\">months</span>)</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">  })</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153);min-height:16px\">  </p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco\"><span style=\"color:#071a99\">  </span>output<span style=\"color:#071a99\">$</span>distPlot<span style=\"color:#071a99\">&lt;- renderPlot({ hist(</span>input<span style=\"color:#071a99\">$</span>variable<span style=\"color:#071a99\">)</span></p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153);min-height:16px\">  <span style=\"white-space:pre\">\t\t</span></p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\"><span style=\"white-space:pre\">\t</span>  })</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\"><span style=\"white-space:pre\">\t</span>  })</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153);min-height:16px\">  </p><div>this for ui:</div><div><p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">library(<span style=\"color:#000000\">shiny</span>)</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153);min-height:16px\"><br></p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\"><br></p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153)\">shinyUI(pageWithSidebar(</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(7,26,153);min-height:16px\"><br></p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Monaco;color:rgb(79,79,79)\"><span style=\"color:#071a99\">  </span># Application title</p>\r\n<p style=\"margin-bottom:0px;margin-left:4px;font-size:11.5px;line-height:normal;font-family:Mona