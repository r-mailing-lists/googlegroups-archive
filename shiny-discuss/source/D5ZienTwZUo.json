or:#660\">,</span><span style=\"color:#000\"> label</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;labla&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> min</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> max</span><span style=\"color:#660\">=</span><span style=\"color:#066\">10</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> value</span><span style=\"color:#660\">=</span><span style=\"color:#066\">5</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>               </span><span style=\"color:#660\">))),</span><span style=\"color:#000\"><br>  dashboardBody</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>    </span><span style=\"color:#800\"># Boxes need to be put in a row (or column)</span><span style=\"color:#000\"><br>    fluidRow</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      box</span><span style=\"color:#660\">(</span><span style=\"color:#000\">plotOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;plot1&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> width</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;420px&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> height</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;320px&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span styl