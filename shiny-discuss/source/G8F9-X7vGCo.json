><span style=\"color:#000\"><br><br>                  popup </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">my_shiny_Data$Institution</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&lt;br&gt;&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br><br>                                </span><span style=\"color:#080\">&quot;Overall Satisfaction:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> my_shiny_Data$</span><span style=\"color:#080\">`Satisfaction (%) 2016 Registered`</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&lt;br&gt;&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\">         <br><br>                  <br><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br><br><br><br>shinyApp</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ui </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> ui</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> server </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> server</span><span style=\"color:#660\">)</span></span></div></code></div><p style=\"margin-bottom:1em;font-size:15px;clear:both;color:rgb(36,39,41);font-family:Arial,&#39;Helvetica Neue&#39;,Helvetica,sans-serif\"><br></p><p style=\"text-align:center;clear:both\"><a href=\"https://i.stack.imgur.com/TA50v.jpg\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://i.stack.imgur.com/TA50v.jpg&amp;source=gmail&amp;ust=1792390928984000&amp;usg=AOvVaw3p8q3geaSQFRMofpNkaKfi\"><img src=\"https://ci6.googleu