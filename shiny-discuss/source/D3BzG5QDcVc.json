     "<div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">## Generate observeEvent</span><span style=\"color:#000\"><br>   observeEvent</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">[[</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;sl&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">slidername</span><span style=\"color:#660\">,</span><span style=\"color:#000\">sep</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">)]],</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>    </span><span style=\"color:#800\"># Identify the slider that will remain fixed (the one we just moved)  </span><span style=\"color:#000\"><br>    fx</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">slidername<br>    nf</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">setdiff</span><span style=\"color:#660\">(</span><span style=\"color:#000\">slidernames</span><span style=\"color:#660\">(),</span><span style=\"color:#000\">slidername</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    <br>    </span><span style=\"color:#800\"># Read the values and normalize</span><span style=\"color:#000\"><br>    sv</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">slidervals</span><span style=\"color:#660\">()</span><span style=\"color:#000\"><br>    ee</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">sv</span><span style=\"color:#660\">[</span><span style=\"color:#000\">nf</span><span style=\"color:#660\">]</span><span style=\"color:#000\"><br>    ee_n</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">ee</span><span style=\"color:#660\">/</span><span style=\"color:#000\">sum</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ee</span><span style=\"color:#660\">)*(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">-</span><span style=\"color:#000\">sv</span><span style=\"color:#660\">[</span><span style=\"color:#000\">fx</span><span style=\"color:#660\">])</span><span style=\"color:#000\"><br>    ee_n</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#000\">sv</span><span style=\"color:#660\">[</span><span style=\"color:#000\">fx</span><span style=\"color:#660\">],</span><span style=\"color:#000\">ee_n</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    names</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ee_n</span><span style=\"color:#660\">)[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]&lt;-</span><span style=\"color:#000\">fx<br>    <br>    </span><span style=\"color:#800\"># Move the non-fixed sliders</span><span style=\"color:#000\"><br>    lapply</span><span style=\"color:#660\">(</span><span style=\"color:#000\">nf</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">mm</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>                     updateSliderInput</span><span style=\"color:#660\">(</span><span style=\"color:#000\">session</span><span style=\"color:#660\">,</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;sl&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">mm</span><span style=\"color:#660\">,</span><span style=\"color:#000\">sep</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>                     value</span><span style=\"color:#660\">=</span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">numeric</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ee_n</span><span style=\"color:#660\">[</span><span style=\"color:#000\">mm</span><span style=\"color:#660\">]))</span><span style=\"color:#000\"><br>                 </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>   cat</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Slider&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">slidername</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;\\n&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>   </span><span style=\"color:#660\">})</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># End of observeEvent </span><span style=\"color:#000\"><br>   <br>   sliderInput</span><span style=\"color:#660\">(</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;sl&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">slidername</span><span style=\"color:#660\">,</span><span style=\"color:#000\">sep</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> slidername</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> min </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> max </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">100</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> value </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">100</span><span style=\"color:#660\">/</span><span style=\"color:#000\">input$num</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>   <br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># End of lapply</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># End of renderUI</span><span style=\"color:#000\"><br><br>output$result</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderText</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>slidervals</span><span style=\"color:#660\">()</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\">  <br> <br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div><br><br><br><br></div>"
