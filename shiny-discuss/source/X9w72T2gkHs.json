lor:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  <br>  output$slider </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderUI</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    input$reset<br>    sliderInput</span><span style=\"color:#660\">(</span><span style=\"color:#000\">inputId </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bw_adjust&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                label </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Bandwidth adjustment:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                min </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0.2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> max </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> value </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> step </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0.2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div>"
