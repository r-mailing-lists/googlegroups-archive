x-sizing:inherit;border:0px;font-family:inherit;font-style:inherit;font-weight:inherit;margin:0px;outline:0px;padding:0px;vertical-align:baseline\"><a href=\"https://shinydata.wordpress.com/2015/02/02/a-few-things-i-learned-about-shiny-and-reactive-programming/#conditional-panel\" style=\"box-sizing:inherit;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:rgb(51,51,51);font-family:inherit;font-style:inherit;font-weight:inherit;outline:0px;color:rgb(51,51,51)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://shinydata.wordpress.com/2015/02/02/a-few-things-i-learned-about-shiny-and-reactive-programming/%23conditional-panel&amp;source=gmail&amp;ust=1792400465386000&amp;usg=AOvVaw0maaIwoIH8EXvqQuT7Mn7k\">Conditional panel</a></li><li style=\"box-sizing:inherit;border:0px;font-family:inherit;font-style:inherit;font-weight:inherit;margin:0px;outline:0px;padding:0px;vertical-align:baseline\"><a href=\"https://shinydata.wordpress.com/2015/02/02/a-few-things-i-learned-about-shiny-and-reactive-programming/#reactivevalues\" style=\"box-sizing:inherit;border-bottom-width:1px;border-bottom-style:solid;border-bottom-color:rgb(51,51,51);font-family:inherit;font-style:inherit;font-weight:inherit;outline:0px;color:rgb(51,51,51)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://shinydata.wordpress.com/2015/02/02/a-few-things-i-learned-about-shiny-and-reactive-programming/%23reactivevalues&amp;source=gmail&amp;ust=1792400465386000&amp;usg=AOvVaw0dSAfCXnpUEHew-w2QRlEQ\"><code style=\"box-sizing:inherit;font-family:Inconsolata,monospace;font-style:inherit;font-weight:inherit;outline:0px\">reactiveValues</code></a></li></ul></div></div>"
