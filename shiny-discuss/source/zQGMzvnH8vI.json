it;vertical-align:baseline;clear:both;color:rgb(36,39,41)\">    write.csv(datasetInput(),file,row.names = FALSE)</p><p style=\"margin-bottom:1em;font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif;font-size:15px;font-stretch:inherit;line-height:inherit;vertical-align:baseline;clear:both;color:rgb(36,39,41)\">  })</p><p style=\"margin-bottom:1em;font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif;font-size:15px;font-stretch:inherit;line-height:inherit;vertical-align:baseline;clear:both;color:rgb(36,39,41)\">}</p></div>"
