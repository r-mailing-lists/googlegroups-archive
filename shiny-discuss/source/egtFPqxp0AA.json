02,102,0)\">}</span></div></code></div><div><br><p>It works nicely in general. However, it doesn&#39;t work in a Shiny App with <code>renderPlot()</code> like following:</p><p style=\"border:1px solid rgb(187,187,187);background-color:rgb(250,250,250)\"><code></code></p><div><code><span style=\"color:rgb(0,0,0)\">  output$main</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">plot </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> renderPlot</span><span style=\"color:rgb(102,102,0)\">({</span><span style=\"color:rgb(0,0,0)\"><br><br>    fit </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> res$main</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">fit<br> <br>    </span><span style=\"color:rgb(136,0,0)\"># p1, p2 are two ggplot objects. It works fine if I just plot only one.</span><span style=\"color:rgb(0,0,0)\"><br>    p1 </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> get_ggplot</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">fit</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"><br>    p2 </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> get_ggplot</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">fit</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"><br><br>    grid_arrange_shared_legend</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">p1</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> p2</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"><br><br>  </span><span style=\"color:rgb(102,102,0)\">})</span></code></div><p></p><p><br></p><p><br></p><p>Could anyone clarify to me what the problem is and how