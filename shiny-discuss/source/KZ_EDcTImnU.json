   "parts": [
    [
     1,
     "<div dir=\"ltr\">Hi,<br><br>the inputIds are TL1, TL2, ... and so on. Therefore you should use input$TL1, input$TL2, ....:<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">  tlabels </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    np  </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> length</span><span style=\"color:#660\">(</span><span style=\"color:#000\">props</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    inp </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sprintf</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;TL%i&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\">np</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># or &lt;- paste(&quot;TL&quot;, 1:np, sep = &quot;&quot;)</span><span style=\"color:#000\"><br>    ret </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> rep</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> np</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">i </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\">np</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>      ret</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> input</span><span style=\"color:#660\">[[</span><span style=\"color:#000\">inp</span><span style=\"color:#660\">[</span><span style=\"color:#000\">i</span><span style=\"color:#660\">]]]</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">return</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ret</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div><code><span style=\"color:#000\"><br><span style=\"font-family:arial,sans-serif\">Whenever one of the text inputs changes then tlabels should return the current list of inputs for all text fields.<br><br>Best Sigbert</span><br></span></code><div dir=\"ltr\"><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><br></div></blockquote></div></div></div>"
    ]
   ]
