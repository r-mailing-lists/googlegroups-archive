n style=\"color:#080\">&quot;Hello&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>input </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">language</span><span style=\"color:#660\">=</span><span style=\"color:#066\">2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">print</span><span style=\"color:#660\">(</span><span style=\"color:#000\">gettext</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Hello&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span></div></code></div><br>Best Sigbert<br><br></div>"
