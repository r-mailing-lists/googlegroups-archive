or:#000\"><br>run_as shiny</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Will run shiny as logged in user eg ec2</span><span style=\"color:#000\"><br></span><span style=\"color:#800\">#run_as session_name</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Define a server that listens on port 3838</span><span style=\"color:#000\"><br>server </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  listen </span><span style=\"color:#066\">3838</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br>  sanitize_errors off</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br>  </span><span style=\"color:#800\"># Define a location at the base URL</span><span style=\"color:#000\"><br>  location </span><span style=\"color:#660\">/</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#800\"># Host the directory of Shiny Apps stored in this directory</span><span style=\"color:#000\"><br>    site_dir </span><span style=\"color:#660\">/</span><span style=\"color:#000\">srv</span><span style=\"color:#660\">/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#800\"># Log all Shiny output to files in this directory</span><span style=\"color:#000\"><br>    log_dir </span><span style=\"color:#660\">/</span><span style=\"color:#008\">var</span><span style=\"color:#660\">/</span><span style=\"color:#000\">log</span><span style=\"color:#660\">/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br>    </span><span style=\"color:#800\"># When a user