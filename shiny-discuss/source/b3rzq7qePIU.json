     1,
     "<div dir=\"ltr\"><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">Anyone know how to put tooltip function into shiny reactive? I have a shiny app with radio buttons and a US choropleth. Users can switch the data set by clicking radio buttons. The code of choropleth and tooltip function work fine if I get rid of the reactivity. So I am pretty sure this just the problem of putting tooltip function into reactive.</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\"><br></span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">This is the message after running the app:</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  Warning: Unhandled error in observer: unused argument (data)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">observe({</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  value &lt;- session$input[[id]]</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  if (is.null(value)) </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    return()</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  if (!is.list(value$data)) </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    return()</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  df &lt;- value$data</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  class(df) &lt;- &quot;data.frame&quot;</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  attr(df, &quot;row.names&quot;) &lt;- .set_row_names(1L)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  fun(data = df, location = list(x = value$pagex, y = value$pagey), </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">      session = session)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">})</span></font></p><p style=\"clear:both\"><br></p><p style=\"clear:both\">########Below is c<span style=\"font-family:&#39;Helvetica Neue&#39;,Helvetica,Arial,sans-serif;font-size:15px;line-height:19.5px\">ode in shiny</span></p><p style=\"clear:both\"><br></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">dataInput&lt;-reactive({</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  switch(input$dataset,</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">         &quot;Segment 1&quot;=df1,</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">         &quot;Segment 2&quot;=df2)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">})</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\"><br></span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">######tooltip function        </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">values&lt;-reactive({</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  if(is.null(x)) return(NULL)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  row = head(data[data$group==x$group, ], 1)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  paste0(&quot;State: &quot;, row$state,&quot;&lt;br /&gt;&quot;,</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">         &quot;Revenue: &quot;, row$revenue, &quot;&lt;br /&gt;&quot;)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">})</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\"><br></span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">######choropleth        </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">vis1&lt;-reactive({</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  data&lt;-dataInput()</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">  data %&gt;%</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    group_by(group) %&gt;%</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    ggvis(~long, ~lat)  %&gt;%</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    layer_paths(fill=~revenue,strokeOpacity := 0.3, </span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">                strokeWidth := 0.4)%&gt;%</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">    add_tooltip(values,&quot;hover&quot;)</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">})</span></font></p><p style=\"clear:both\"><font face=\"Helvetica Neue, Helvetica, Arial, sans-serif\"><span style=\"font-size:15px;line-height:19.5px\">vis1 %&gt;% bind_shiny(&quot;plot&quot;)</span></font></p></div>"
