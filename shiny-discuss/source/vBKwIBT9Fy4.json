     2,
     "<div dir=\"ltr\"><code><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\"><br>  sliceBox</span><span style=\"color:#660\">.</span><span style=\"color:#000\">tree </span><span style=\"color:#660\">&lt;&lt;-</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">rootNode</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># We&#39;ll store our nodes as a 1D list, so parent and child ID&#39;s are recorded as their indices in the list</span><span style=\"color:#000\"><br></span></div></code></div></code></div>"
