seq</span><span style=\"color:#660\">(</span><span style=\"color:#000\">min</span><span style=\"color:#660\">(</span><span style=\"color:#000\">weight</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> max</span><span style=\"color:#660\">(</span><span style=\"color:#000\">weight</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> length</span><span style=\"color:#660\">.</span><span style=\"color:#008\">out</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> input$bins </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    <br>    </span><span style=\"color:#800\"># draw the histogram with the specified number of bins</span><span style=\"color:#000\"><br>    hist</span><span style=\"color:#660\">(</span><span style=\"color:#000\">weight</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> breaks </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> bins</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> col </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;darkgray&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> border </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;white&#39;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span></div></code></div><div><br></div></div><div><br></div><div><br></div><div>ui.R</div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\"><br><br>library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br></span><span style=\"color:#800\"># Define UI for application that draws a histogram</span><span style=\"color:#000\"><br>shinyUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Application title</span><span style=\"color:#000\"><br>  titlePanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Hello Shiny!&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Sidebar with a slider input for the number of bins</span><span style=\"color:#000\"><br>  sidebarLayout</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>    sidebarPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      selectInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;year&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Draft Year:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choices</span><span style=\"color:#660\">=</span><span style=\"color:#000\">sort</span><span style=\"color:#660\">(</span><span style=\"color:#000\">players$draft_year</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> selected</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&#39;2011&#39;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>      sliderInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bins&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  </span><span style=\"color:#080\">&quot;Number of bins:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>         