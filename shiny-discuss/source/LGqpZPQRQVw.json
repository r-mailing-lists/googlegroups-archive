pan style=\"color:#660\">(</span><span style=\"color:#000\">raster</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>server </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  <br>  shape </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    req</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$Shape_SHID</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    req</span><span style=\"color:#660\">(!</span><span style=\"color:#008\">is</span><span style=\"color:#660\">.</span><span style=\"color:#008\">null</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$Shape_SHID</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>    myshape</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> input$Shape_SHID<br>    dir</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">dirname</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myshape</span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">4</span><span style=\"color:#660\">])</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">for</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">i </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#0