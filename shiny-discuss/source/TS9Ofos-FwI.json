an><span style=\"color:#080\">&quot;table&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br></span><span style=\"color:#000\"><br></span></div></code></div><div><br><br></div><div><br></div><div>Example server.R:</div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br> output$table </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderDataTable</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br> iris<br> </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br> output$output </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderText</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br> input$actionBtn<br> <br> paste0</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Table parameters: ???&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br> </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span></div></code></div><div><br></div></div></div></blockquote></div></div>"
