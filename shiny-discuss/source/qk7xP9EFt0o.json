   "parts": [
    [
     1,
     "<div dir=\"ltr\">When h1/h2 change, do you want output$b to update? If so, these are not normal variables but <i>reactive values</i>.<div><br></div><div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div>server &lt;- function(input, output) {</div><div><br></div><div>  m &lt;- reactive({1:5})</div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div>  v &lt;- reactiveValues()</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><br></div><div>  output$a &lt;- renderPrint({</div><div><br></div><div>    for (i in 1:length(m())){</div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div>      v[[paste0(&quot;h&quot;,i)]] &lt;- &quot;u&quot;</div><div><span style=\"line-height:1.5;font-size:13.1999998092651px\">    }</span><br></div><div><br></div><div>    list(v$h1,v$h2)</div><div>  })</div><div><br></div><div>  output$b &lt;- renderPrint({</div><div><br></div><div>   list(v$h1,v$h2)</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div>  })</div><div>}</div><div>shinyApp(ui = ui, server = server)</div></div></div>"
    ],
    [
     3,
