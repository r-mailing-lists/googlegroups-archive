     1,
     "<div dir=\"ltr\"><br><div>Why does my plotOutput dissappear if inline=TRUE?</div><div><br></div><div>ui.R:</div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><font color=\"#660066\"><div>library(shiny)</div><div><br></div><div>shinyUI(fluidPage(</div><div>  fluidRow(</div><div>    column(width=6,</div><div>           plotOutput(&quot;basic&quot;, inline=TRUE)))))</div></font></div></code></div><br></div><div><div><br></div><div>server.R:</div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  output$basic </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPlot</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    plot</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br><br></span></div></code></div><div><br></div><div>This works well if inline=FALSE.<br> </div></div></div>"
    ]
   ]
  },
  {
   "id": "Pvk_drYcNO0J",
   "from": "Joe Cheng",
