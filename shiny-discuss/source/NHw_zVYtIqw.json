     "<div dir=\"ltr\"><div><div>    </div><div>  ),</div><div>  server = function(input, output) {</div><div>    output$mytable = renderDataTable(res, options =</div><div>                                       list(lengthchange = FALSE, searching = FALSE, info = FALSE, paging = FALSE,</div><div>                                            processing = FALSE, ordering = FALSE)</div><div>    )</div><div>  }</div><div>))</div><div><br></div></div></div>"
