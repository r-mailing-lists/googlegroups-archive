/span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br>  output$other_val_show</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">renderPrint</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    cor</span><span style=\"color:#660\">.</span><span style=\"color:#000\">test</span><span style=\"color:#660\">(</span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">numeric</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$ind_var_select</span><span style=\"color:#660\">),</span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">numeric</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$other_var_select</span><span style=\"color:#660\">),</span><span style=\"color:#000\">method</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;pearson&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#008\">use</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;complete.obs&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    <br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"> </span></div></code></div><div><br></div></span></font></div></div>"
