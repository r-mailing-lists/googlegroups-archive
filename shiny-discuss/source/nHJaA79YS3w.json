olor:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># define body</span><span style=\"color:#000\"><br>  dashboardBody</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>    tabItems</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      test_tools_setUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">id </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;test_tools_main&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#800\">#### END UI CODE ####</span><span style=\"color:#000\"><br><br><br></span><span style=\"color:#800\">#### SERVER CODE ####</span><span style=\"color:#000\"><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> session</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">### Module Calls ###</span><span style=\"color:#000\"><br>  callModule</span><span style=\"color:#660\">(</span><span style=\"color:#000\">test_tools_set</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> id </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;test_tools_main&quot;</sp