lue = FALSE),<br style=\"box-sizing:border-box\">checkboxInput(inputId = &quot;stringAsFactors&quot;, &quot;stringAsFactors&quot;, FALSE),<br style=\"box-sizing:border-box\">radioButtons(inputId = &#39;sep&#39;, label = &#39;Separator&#39;,<br style=\"box-sizing:border-box\">choices = c(Comma=&#39;,&#39;,Semicolon=&#39;;&#39;,Tab=&#39;\\t&#39;, Space=&#39;&#39;), selected = &#39;,&#39;)<br style=\"box-sizing:border-box\">),<br style=\"box-sizing:border-box\">mainPanel(uiOutput(&quot;tb1&quot;))<br style=\"box-sizing:border-box\">) ),<br style=\"box-sizing:border-box\">tabPanel(&quot;Model_dev&quot;,<br style=\"box-sizing:border-box\">sidebarLayout(sidebarPanel(<br style=\"box-sizing:border-box\">uiOutput(&quot;modelselect&quot;)<br style=\"box-sizing:border-box\">),<br style=\"box-sizing:border-box\">mainPanel(<br style=\"box-sizing:border-box\">verbatimTextOutput(&quot;other_val_show&quot;)<br style=\"box-sizing:border-box\">#verbatimTextOutput(&quot;other_val_show2&quot;),<br style=\"box-sizing:border-box\">#verbatimTextOutput(&quot;other_val_show3&quot;)<br style=\"box-sizing:border-box\">)))<br style=\"box-sizing:border-box\">)<br style=\"box-sizing:border-box\">#Server.r<br style=\"box-sizing:border-box\">library(shiny)<br style=\"box-sizing:border-box\">library(caret)<br style=\"box-sizing:border-box\">library(caTools)<br style=\"box-sizing:border-box\">library(klaR)<br style=\"box-sizing:border-box\">library(MASS)<br style=\"box-sizing:border-box\">library(lattice)<br style=\"box-sizing:border-box\">library(rvest)<br style=\"box-sizing:border-box\">library(dplyr)<br style=\"box-sizing:border-box\">library(e1071)<br style=\"box-sizing:border-box\">library(rpart)<br style=\"box-sizing:border-box\">library(rpart.plot)<br style=\"box-sizing:border-box\">library(rminer)<br style=\"box-sizing:border-box\">library(corrplot)<br style=\"box-sizing:border-box\">library(DT)<br style=\"box-sizing:border-box\">library(tidyr)<br style=\"box-sizing:border-box\">library(ggpl