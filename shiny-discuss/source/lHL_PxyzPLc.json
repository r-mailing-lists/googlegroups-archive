 &quot;Log&quot;)<br style=\"box-sizing:border-box\">})</p><p style=\"box-sizing:border-box;color:rgb(36,41,46);font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Helvetica,Arial,sans-serif,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,&quot;Segoe UI Symbol&quot;;font-size:14px\">output$other_val_show&lt;-renderPrint({<br style=\"box-sizing:border-box\">f&lt;-data()<br style=\"box-sizing:border-box\">hr_model &lt;- f %&gt;% filter(last_evaluation &gt;= 0.70 | time_spend_company &gt;= 4 | number_project &gt; 5)<br style=\"box-sizing:border-box\">hr_model$left &lt;- as.factor(hr_model$left)<br style=\"box-sizing:border-box\">train_control&lt;- trainControl(method=&quot;cv&quot;, number=5, repeats=3)</p><p style=\"box-sizing:border-box;color:rgb(36,41,46);font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Helvetica,Arial,sans-serif,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,&quot;Segoe UI Symbol&quot;;font-size:14px\">if(input$modelselect== &quot;Log&quot;)<br style=\"box-sizing:border-box\">{<br style=\"box-sizing:border-box\">gmlmodel &lt;- train(left~., data=hr_model, trControl=train_control, method=&quot;LogitBoost&quot;)</p><h1 style=\"box-sizing:border-box;font-size:2em;font-weight:600;line-height:1.25;padding-bottom:0.3em;border-bottom:1px solid rgb(234,236,239);color:rgb(36,41,46);font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Helvetica,Arial,sans-serif,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,&quot;Segoe UI Symbol&quot;\">make predictions</h1><p style=\"box-sizing:border-box;color:rgb(36,41,46);font-family:-apple-system,BlinkMacSystemFont,&quot;Segoe UI&quot;,Helvetica,Arial,sans-serif,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,&quot;Segoe UI Symbol&quot;;font-size:14px\">predictions&lt;- predict(gmlmodel,hr_model)<br style=\"box-sizing:border-box\">gmlmodelbinded &lt;- cbind(hr_model,predictions)</p><h1 style=\"box-sizing:border-box;font-size:2em;font-weigh