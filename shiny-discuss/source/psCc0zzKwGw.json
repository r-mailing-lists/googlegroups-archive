    [
     1,
     "<div dir=\"ltr\">A minimalistic example to illustrate the behaviour:<div><br></div><div><br></div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#800\"># Server.R</span><span style=\"color:#000\"><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">session</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  output$val</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPrint</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    <br>    </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span style=\"color:#008\">is</span><span style=\"color:#660\">.</span><span style=\"color:#008\">null</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$rb</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>      updateRadioButtons</span><span style=\"color:#660\">(</span><span style=\"color:#000\">session</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;rb&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Radiobuttons&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> selected </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;2&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    <br>    </span><span style=\"color:#800\">#if(input$rb == &quot;1&quot;) # This returns an error</span><span style=\"color:#000\"><br>      </span><span style=\"color:#800\">#print(&quot;error&quot;)</span><span style=\"color:#000\"><br>    <br>    input$rb<br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span></div></code></div><div><br></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#800\"># UI.R</span><span style=\"color:#000\"><br>fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>  radioButtons</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;rb&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;RadioButtons&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choices </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;1&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;2&quot;</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;2&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> selected </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;1&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>  textOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;val&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span></div></code></div></div></div>"
    ],
    [
     3,
