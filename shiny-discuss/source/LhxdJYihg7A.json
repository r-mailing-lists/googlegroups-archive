     "<div dir=\"ltr\"><br><span style=\"color:rgb(0,0,0);font-family:Arial,&#39;Liberation Sans&#39;,&#39;DejaVu Sans&#39;,sans-serif;font-size:14px;line-height:17.8048000335693px\">I have table on page with possible sorting in columns, but after I reload data table isn&#39;t sorted again, I mean after </span><span style=\"color:rgb(68,68,68);font-family:Arial,&#39;Liberation Sans&#39;,&#39;DejaVu Sans&#39;,sans-serif;line-height:17.2800006866455px\">page reload sorting is saving, but after change select value it isn&#39;t,</span><span style=\"color:rgb(0,0,0);font-family:Arial,&#39;Liberation Sans&#39;,&#39;DejaVu Sans&#39;,sans-serif;font-size:14px;line-height:17.8048000335693px\"> here is the code:</span><br><div><span style=\"color:rgb(0,0,0);font-family:Arial,&#39;Liberation Sans&#39;,&#39;DejaVu Sans&#39;,sans-serif;font-size:14px;line-height:17.8048000335693px\">server.R:</span></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"font-family:Arial,&#39;Liberation Sans&#39;,&#39;DejaVu Sans&#39;,sans-serif;font-size:14px;line-height:17.8048000335693px;background-color:rgb(255,255,255)\"><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span></span><span style=\"color:#000\"><br><br>shinyServer</span><span style=\"color:#660\">(</span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Return the requested dataset</span><span style=\"color:#000\"><br>  datasetInput </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">switch</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$dataset2</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>           </span><span style=\"color:#080\">&quot;[,...]&quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> diamonds</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>           </span><span style=\"color:#080\">&quot;[10:30,...]&quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> diamonds</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>           </span><span style=\"color:#080\">&quot;[31:50,...]&quot;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> diamonds</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\">#&quot;[,...]&quot; = diamonds[,],</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">#&quot;[10:30,...]&quot; = diamonds[10:30,],</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\">#&quot;[31:50,...]&quot; = diamonds[31:50,])</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Show the first &quot;n&quot; observations</span><span style=\"color:#000\"><br>  output$view </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderTable</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    head</span><span style=\"color:#660\">(</span><span style=\"color:#000\">datasetInput</span><span style=\"color:#660\">())</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\"># a large table, reative to input$show_vars</span><span style=\"color:#000\"><br>  output$mytable1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderDataTable</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ggplot2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    datasetInput</span><span style=\"color:#660\">()[,</span><span style=\"color:#000\"> </span><span style=\"color:#660\">,</span><span style=\"color:#000\"> drop </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> FALSE</span><span style=\"color:#660\">]</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br></span><span style=\"color:#660\">})</span></div></code></div><div><font color=\"#000000\" face=\"Arial, Liberation Sans, DejaVu Sans, sans-serif\"><span style=\"font-size:14px;line-height:17.8048000335693px\"><br></span></font></div></div><div><font color=\"#000000\" face=\"Arial, Liberation Sans, DejaVu Sans, sans-serif\"><span style=\"font-size:14px;line-height:17.8048000335693px\">ui.R:</span></font></div><div><font color=\"#000000\" face=\"Arial, Liberation Sans, DejaVu Sans, sans-serif\"><span style=\"font-size:14px;line-height:17.8048000335693px\"><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ggplot2</span><span style=\"color:#660\">)</span><span style=\"color:#000\">  </span><span style=\"color:#800\"># for the diamonds dataset</span><span style=\"color:#000\"><br><br><br>shinyUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>  title </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;Examples of DataTables&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>  sidebarLayout</span><span style=\"color:#660\">(</span><span style=\"color:#000\">  <br>    sidebarPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      selectInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;dataset2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Choose a dataset:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> choices </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;[,...]&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;[10:30,...]&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;[31:50,...]&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>    mainPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      tabsetPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>        id </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;dataset&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>        tabPanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;diamonds&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> dataTableOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;mytable1&#39;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>      </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">))</span></div></code></div><div><br></div></span></font></div></div>"
