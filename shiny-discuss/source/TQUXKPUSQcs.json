al, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">  server = function(input, output, session) {</span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">    HierarchyDependentDropdown(inputNames = c(&quot;selectcontinent&quot;,</span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">                                              &quot;selectcountry&quot;,</span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">                                              &quot;selectcity&quot;), </span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">                               columnNames = c(&#39;continent&#39;,</span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">                                               &#39;country&#39;,</span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica, sans-serif\"><span style=\"font-size:15px\">                                               &#39;city&#39;), </span></font></p><p style=\"line-height:inherit;font-stretch:inherit;vertical-align:baseline;clear:both\"><font color=\"#242729\" face=\"Arial, Helvetica Neue, Helvetica,