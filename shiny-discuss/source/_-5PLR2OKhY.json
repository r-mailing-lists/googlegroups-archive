     "<div dir=\"ltr\"><br><div>Anyone know where to place this code in a 3-file shiny app?</div><div><br></div><div><div style=\"color:rgb(0,0,0);font-family:arial,sans-serif;font-size:12.8px\"><div><span style=\"font-size:12.8px\"> theme = shinytheme(&quot;cerulean&quot;),</span></div><div><span style=\"font-size:12.8px\">  </span></div><div><span style=\"font-size:12.8px\"> tags$head(</span></div><div><span style=\"font-size:12.8px\">   tags$style(HTML(&quot;</span></div><div><span style=\"font-size:12.8px\">                    .shiny-output-error-validation {</span></div><div><span style=\"font-size:12.8px\">                    color: red;</span></div><div><span style=\"font-size:12.8px\">                    }</span></div><div><span style=\"font-size:12.8px\">                    &quot;))),</span></div></div><div style=\"color:rgb(0,0,0);font-family:arial,sans-serif;font-size:12.8px\"><span style=\"font-size:12.8px\"><br></span></div><div style=\"color:rgb(0,0,0);font-family:arial,sans-serif;font-size:12.8px\"><span style=\"font-size:12.8px\"><br></span></div><div style=\"color:rgb(0,0,0);font-family:arial,sans-serif;font-size:12.8px\">Thanks!</div></div></div>"
    ]
