><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">10</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> main </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Plot 1&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>        plot</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">10</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">10</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> main </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Plot 2&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>        <br>    output$testPlotHooverCoordinates </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderText</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>        paste0</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;hoover coordinates: x = &quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> input$testPlotHoover$x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;\\ny = &quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>            input$testPlotHoover$y</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># 