=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"># This row is the scenario input row these are text input boxes for the yield</span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"># table scenario analysis</span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">fillRow(width = &#39;100%&#39;, flex = 1,</span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">fillCol(width = &quot;100&quot;, textInput(inputId = &quot;s1&quot;, label = &quot;&quot;, </span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">value = &quot;d150&quot;, width = &#39;200&#39;)),</span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">fillCol(width = &quot;100&quot;, textInput(inputId = &quot;s1&quot;, label = &quot;&quot;, </span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">value = &quot;d100&quot;, width = &#39;100&#39;)),</span><br style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\"><span style=\"font-family:SFNSText,&#39;Helvetica Neue&#39;,Helvetica,sans-serif;font-size:15px\">fillCol(width = &quot;100&quot;, textInput(inputId = &quot;s1&quot;, label = &quo