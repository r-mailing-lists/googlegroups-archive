   "parts": [
    [
     1,
     "<div dir=\"ltr\">Sorry, the shinydashboard elements are only designed to be used inside of dashboardPage. This is the only way the dashboard CSS assets will be loaded.</div><br><div class=\"gmail_quote\"></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\">On Mon, Mar 13, 2017 at 4:00 AM msquatrito &lt;<a href data-email-masked rel=\"nofollow\">squa...@gmail.com</a>&gt; wrote:<br></div></div>"
    ],
    [
     3,
