     "<div dir=\"ltr\">dat &lt;- <span style=\"color:inherit;font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;background-color:transparent\">    </span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">read.csv</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">(</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">inFile</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">$</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">datapath</span><span style=\"color:inherit;font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;background-color:transparent\">, </span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">header</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">=</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">input</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">$</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">header</span><span style=\"color:inherit;font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;background-color:transparent\">, </span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">sep</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">=</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">input</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(104,118,135);background-color:transparent\">$</span><span style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;color:rgb(0,0,0);background-color:transparent\">sep</span><span style=\"color:inherit;font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;line-height:1em;white-space:pre-wrap;background-color:transparent\">, </span><pre style=\"margin-bottom:10px;padding:9.5px;border-style:none;font-size:12.7272720336914px;font-family:Monaco,Menlo,Consolas,&#39;Courier New&#39;,monospace;color:rgb(51,51,51);border-top-left-radius:4px;border-top-right-radius:4px;border-bottom-right-radius:4px;border-bottom-left-radius:4px;line-height:1em;word-break:break-all;word-wrap:break-word;white-space:pre-wrap\"><code style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;color:inherit;border-top-left-radius:3px;border-top-right-radius:3px;border-bottom-right-radius:3px;border-bottom-left-radius:3px;background-color:transparent\">\t\t\t\t <span style=\"color:rgb(0,0,0)\">quote</span><span style=\"color:rgb(104,118,135)\">=</span><span style=\"color:rgb(0,0,0)\">input</span><span style=\"color:rgb(104,118,135)\">$</span><span style=\"color:rgb(0,0,0)\">quote</span><span style=\"color:rgb(104,118,135)\">)</span></code></pre><pre style=\"margin-bottom:10px;padding:9.5px;border-style:none;font-size:12.7272720336914px;font-family:Monaco,Menlo,Consolas,&#39;Courier New&#39;,monospace;color:rgb(51,51,51);border-top-left-radius:4px;border-top-right-radius:4px;border-bottom-right-radius:4px;border-bottom-left-radius:4px;line-height:1em;word-break:break-all;word-wrap:break-word;white-space:pre-wrap\"><code style=\"font-family:Menlo,Consolas,&#39;Courier New&#39;,monospace;font-size:12px;color:inherit;border-top-left-radius:3px;border-top-right-radius:3px;border-bottom-right-radius:3px;border-bottom-left-radius:3px;background-color:transparent\"><span style=\"color:rgb(104,118,135)\">save(dat, &quot;path/dat.RData&quot;)</span></code></pre></div>"
