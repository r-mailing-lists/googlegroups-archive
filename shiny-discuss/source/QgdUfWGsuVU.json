utomatically or am I going in the wrong direction?</div><div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><font color=\"#660066\"><span style=\"color:#000\">observeEvent</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$goButtonCustom</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$goButtonCustom</span><span style=\"color:#660\">==</span><span style=\"color:#066\">0</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>      </span><span style=\"color:#008\">return</span><span style=\"color:#660\">()</span><span style=\"color:#000\"><br><br>      isolate</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>          </span></font><span style=\"color:#000\">     output$textbox </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">renderText</span><span style=\"color:#660\">({</span><font color=\"#000000\"><span style=\"color:#000\"> paste</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Some text&quot;</span><span style=\"color:#660\">)})</span><span style=\"color:#000\"><br>               variableInput </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> input$variableNumericInput<br><br>               calcFunction</span><span style=\"color:#660\">(</span><span style=\"color:#000\">variableInput</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span></font><font color=\"#660066\"><span style=\"color:#000\">             </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"> </span><span style=\"color:#800\">#