</span><span>&lt;/</span><span>head</span><span>&gt;</span><span>\r\n\r\n    </span><span>&lt;</span><span>body</span><span>&gt;</span><span>\r\n        </span><span>&lt;</span><span>br</span><span>&gt;</span><span>\r\n          </span><span>&lt;</span><span>p</span><span>&gt;</span><span>\r\n            </span><span>&lt;</span><span>label</span><span>&gt;</span><span>Multiply Number By</span><span>:&lt;/</span><span>label</span><span>&gt;&lt;</span><span>br </span><span>/&gt;</span><span> \r\n            </span><span>&lt;</span><span>input type</span><span>=</span><span>&quot;number&quot;</span><span> name</span><span>=</span><span>&quot;n&quot;</span><span> value</span><span>=</span><span>&quot;5&quot;</span><span> min</span><span>=</span><span>&quot;1&quot;</span><span> max</span><span>=</span><span>&quot;10&quot;</span><span> </span><span>/&gt;</span><span>\r\n          </span><span>&lt;/</span><span>p</span><span>&gt;</span><span>\r\n\r\n\r\n        </span><span>&lt;</span><span>div id </span><span>=</span><span> </span><span>&quot;mydiv&quot;</span><span> class</span><span>=</span><span>&quot;controls  multi-field-wrapper row&quot;</span><span>&gt;</span><span>\r\n            </span><span>&lt;</span><span>div class</span><span>=</span><span>&quot;multi-fields&quot;</span><span>&gt;</span><span>\r\n                </span><span>&lt;</span><span>div class</span><span>=</span><span>&quot;multi-field col-md-11 col-lg-11&quot;</span><span>&gt;</span><span>\r\n                    </span><span>&lt;</span><span>input type</span><span>=</span><span>&quot;text&quot;</span><span> name</span><span>=</span><span>&quot;first_num[]&quot;</span><span> placeholder</span><span>=</span><span>&quot;First Number?&quot;</span><span> class</span><span>=</span><span>&quot;col-md-4 col-lg-3&quot;</span><span> </span><span>&gt;</span><span>\r\n                    </span><span>&lt;</span><span>input type</span><span>=</span><span>&quot;text&quot;</span><span> name</span><span>=</span><sp