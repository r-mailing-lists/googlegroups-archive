     1,
     "<div dir=\"ltr\"><div><font size=\"4\" face=\"trebuchet ms, sans-serif\">Configured shiny pro to use flat file authentication in /etc/shiny-server/shiny-server.conf:</font></div><div><div><br></div><div></div></div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">auth_passwd_file </span><span style=\"color:#660\">/</span><span style=\"color:#000\">etc</span><span style=\"color:#660\">/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">/</span><span style=\"color:#000\">passwd</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br></span></div></code></div><div><br><br></div><div><font face=\"trebuchet ms, sans-serif\" size=\"4\">Verified that user/password combo exists:<br></font></div><div><br></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\"> </span><span style=\"color:#660\">/</span><span style=\"color:#000\">opt</span><span style=\"color:#660\">/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">/</span><span style=\"color:#000\">bin</span><span style=\"color:#660\">/</span><span style=\"color:#000\">sspasswd </span><span style=\"color:#660\">-</span><span style=\"color:#000\">v </span><span style=\"color:#660\">/</span><span style=\"color:#000\">etc</span><span style=\"color:#660\">/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">/</span><span style=\"color:#000\">passwd pwc</span></div></code></div><br></div><div><font face=\"trebuchet ms, sans-serif\" size=\"4\">Restarted shiny server:</font></div><div><div style=\"font-size:13.3333339691162px\"><br></div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#606\">Shiny</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Server</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#606\">Commercial</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> v1</span><span style=\"color:#660\">.</span><span style=\"color:#066\">2.1</span><span style=\"color:#660\">.</span><span style=\"color:#066\">433</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#606\">Node</span><span style=\"color:#660\">.</span><span style=\"color:#000\">js v0</span><span style=\"color:#660\">.</span><span style=\"color:#066\">10.21</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> </span><span style=\"color:#066\">20</span><span style=\"color:#000\"> days left </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> evaluation<br>shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server </span><span style=\"color:#660\">-</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Using</span><span style=\"color:#000\"> the file</span><span style=\"color:#660\">-</span><span style=\"color:#000\">based auth at</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#080\">/etc/</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">server</span><span style=\"color:#660\">/</span><span style=\"color:#000\">passwd</span></div></code></div><div style=\"font-size:13.3333339691162px\"><br></div><div style=\"font-size:13.3333339691162px\"><br></div></div><div><font face=\"trebuchet ms, sans-serif\" size=\"4\">Navigated to shiny application with web browser:</font></div><div><ul><li><b style=\"font-size:13.3333339691162px\">Expected </b><span style=\"font-size:13.3333339691162px\">result: Shiny application prompts for user/password</span><br></li><li style=\"font-size:13.3333339691162px\"><b style=\"font-size:13.3333339691162px\">Actual </b><span style=\"font-size:13.3333339691162px\">results: No prompt; shiny application is served with asking for user/password.</span><br></li></ul><div><span style=\"line-height:17px\"><br></span></div></div><div><span style=\"line-height:17px\"><font face=\"trebuchet ms, sans-serif\" size=\"4\">What am I missing? Why are users not prompted for their login information?</font></span></div><div><br></div></div>"
