an style=\"color:rgb(48,51,54)\">x </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> x</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> y </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> yhat</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> mode </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">&quot;lines&quot;</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">%&gt;%</span><span style=\"color:rgb(48,51,54)\">\r\n        plotly</span><span style=\"color:rgb(48,51,54)\">::</span><span style=\"color:rgb(48,51,54)\">layout</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">xaxis </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> list</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">title </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> s</span><span style=\"color:rgb(48,51,54)\">[[</span><span style=\"color:rgb(125,39,39)\">&quot;x&quot;</span><span style=\"color:rgb(48,51,54)\">]]),</span><span style=\"color:rgb(48,51,54)\"> \r\n          yaxis </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> list</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">title </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> s</span><span style=\"color:rgb(48,51,54)\">[[</span><span style=\"color:rgb(125,39,39)\">&quot;y&quot;</span><span style=\"color:rgb(48,51,54)\">]]),</span><span style=\"color:rgb(48,51,54)\"> \r\n          showlegend </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">FALSE</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n    </span><span style=\"color:rgb(48,51,54)\">}</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(16,16,148)\">else</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">{</span><span style=\"color:rgb(48,51,54)\">\r\n      plot_ly</span><span style=\"color:rgb(48,51,54)\">()</span><span style=\"color:rgb(48,51,54)\">\r\n    </span><span style=\"color:rgb(48,51,54)\">}</span><span style=\"color:rgb(48,51,54)\">\r\n  </span><span style=\"color:rgb(48,51,54)\">})</span><span style=\"color:rgb(48,51,54)\">\r\n\r\n</span><span style=\"color:rgb(48,51,54)\">}</span><span style=\"color:rgb(48,51,54)\">\r\n</span><span style=\"color:rgb(133,140,147)\">############ End Module Definition ######</span><span style=\"color:rgb(48,51,54)\">\r\n\r\nui </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> fluidPage</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">\r\n  sidebarLayout</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">\r\n    sidebarPanel</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">\r\n    </span><span style=\"color:rgb(48,51,54)\">),</span><span style=\"color:rgb(48,51,54)\">\r\n    correlation_matrix_shinyUI</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">id </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">&quot;cor_module&quot;</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n  </span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n\r\nserver </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(16,16,148)\">function</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">input</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> output</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> session</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">{</span><span style=\"color:rgb(48,51,54)\">\r\n  callModule</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">correlation_matrix_shiny</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> id </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">&quot;cor_module&quot;</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n</span><span style=\"color:rgb(48,51,54)\">}</span><span style=\"color:rgb(48,51,54)\">\r\n\r\nshinyApp</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">ui </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> ui</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> server </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> server</span><span style=\"color:rgb(48,51,54)\">)</span></code></pre><div><code style=\"font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,sans-serif;white-space:inherit\"><span style=\"color:rgb(48,51,54)\"><br></span></code></div></div></div></td></tr></tbody></table></div>"
