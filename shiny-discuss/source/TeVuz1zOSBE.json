n><span style=\"color:rgb(48,51,54)\">is.null</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">corr_names</span><span style=\"color:rgb(48,51,54)\">()))</span><span style=\"color:rgb(48,51,54)\">\r\n      </span><span style=\"color:rgb(16,16,148)\">return</span><span style=\"color:rgb(48,51,54)\">()</span><span style=\"color:rgb(48,51,54)\">\r\n    </span><span style=\"color:rgb(16,16,148)\">if</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">is.null</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">corr_data</span><span style=\"color:rgb(48,51,54)\">()))</span><span style=\"color:rgb(48,51,54)\">\r\n      </span><span style=\"color:rgb(16,16,148)\">return</span><span style=\"color:rgb(48,51,54)\">()</span><span style=\"color:rgb(48,51,54)\">\r\n\r\n\r\n    g </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> plot_ly</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">x </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> corr_names</span><span style=\"color:rgb(48,51,54)\">(),</span><span style=\"color:rgb(48,51,54)\"> y </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> corr_names</span><span style=\"color:rgb(48,51,54)\">(),</span><span style=\"color:rgb(48,51,54)\"> z </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> corr_data</span><span style=\"color:rgb(48,51,54)\">(),</span><span style=\"color:rgb(48,51,54)\"> \r\n      key </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> corr_data</span><span style=\"color:rgb(48,51,54)\">(),</span><span style=\"color:rgb(48,51,54)\"> type </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">&quot;heatmap&quot;</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> source </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">&quot;CORR_MATRIX&quot;</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> zmax </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">1</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> zmin </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">-1</span><span style=\"color:rgb(48,51,54)\">)</span><span style=\"color:rgb(48,51,54)\">\r\n    g\r\n  </span><span style=\"color:rgb(48,51,54)\">})</span><span style=\"color:rgb(48,51,54)\">\r\n\r\n  output</span><span style=\"color:rgb(48,51,54)\">$</span><span style=\"color:rgb(48,51,54)\">scatterplot </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> renderPlotly</span><span style=\"color:rgb(48,51,54)\">({</span><span style=\"color:rgb(48,51,54)\">\r\n    </span><span style=\"color:rgb(16,16,148)\">if</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">is.null</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">data_df</span><span style=\"color:rgb(48,51,54)\">()))</span><span style=\"color:rgb(48,51,54)\">\r\n      </span><span style=\"color:rgb(16,16,148)\">return</span><span style=\"color:rgb(48,51,54)\">()</span><span style=\"color:rgb(48,51,54)\">\r\n\r\n    data_use </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> data_df</span><span style=\"color:rgb(48,51,54)\">()</span><span style=\"color:rgb(48,51,54)\">\r\n\r\n    s </span><span style