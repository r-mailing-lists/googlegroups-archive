pan style=\"color:#660\">(</span><span style=\"color:#000\">type </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;resize&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> message </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> paste0</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#000\"> </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> getTotal</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;vh&#39;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  getTotal </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">return</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">numeric</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$total</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  output$allmaps </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderPlot</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">do</span><span style=\"color:#660\">.</span><span style=\"color:#000\">call</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;grid.arrange&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#000\">plotObjects</span><span style=\"color:#660\">(),</span><span style=\"color:#000\"> nrow </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> ceiling</span><span style=\"color:#660\">(</span><span style=\"color:#000\">getTotal</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">/</span><span style=\"color:#000\"> getNumCols</span><span style=\"color:#660\">()),</span><span style=\"color:#000\"> ncol </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> getNumCols</span><span style=\"color:#660\">()</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">...</span></div></code></div><div style=\"font-family:monospace\"><div><br><br></div></div><span style=\"font-family:monospace;color:rgb(0,0,0)\"><div></div></span></div></div>\r\n\r\n<p></p></blockquote></div>"
    ],
