     1,
     "<div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;Shiny - Web Framework for R&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href data-email-masked rel=\"nofollow\">shiny-discus...@googlegroups.com</a>.<br>\r\nTo view this discussion on the web visit <a href=\"https://groups.google.com/d/msgid/shiny-discuss/33a0f854-2012-4f2b-a2e1-097a77e5a53b%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/shiny-discuss/33a0f854-2012-4f2b-a2e1-097a77e5a53b%2540googlegroups.com?utm_medium%3Demail%26utm_source%3Dfooter&amp;source=gmail&amp;ust=1792392723635000&amp;usg=AOvVaw2OLoHsyBSsm5hGF92Uinca\">https://groups.google.com/d/msgid/shiny-discuss/33a0f854-2012-4f2b-a2e1-097a77e5a53b%40googlegroups.com</a>.<br>\r\nFor more options, visit <a href=\"https://groups.google.com/d/optout\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/optout&amp;source=gmail&amp;ust=1792392723635000&amp;usg=AOvVaw1tfxPzl75tsCqK7T6gZdip\">https://groups.google.com/d/optout</a>.<br>\r\n</blockquote></div>\r\n"
