    [
     1,
     "<div dir=\"ltr\">Thanks for the reply! I added .trigger(&#39;shown&#39;) and the plot is still the same size each time. I also tried manually setting the height like<div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div><span style=\"color:#000\">$</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;#allmaps&#39;</span><span style=\"color:#660\">).</span><span style=\"color:#000\">css</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;height&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">100vh</span><span style=\"color:#660\">).</span><span style=\"color:#000\">trigger</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;shown&#39;</span><span style=\"color:#660\">);</span><span style=\"color:#000\"><br></span></div></code></div>and it still didn&#39;t work which is strange.<br><br>After some experimentation, adding the below line worked (also works if you remove the tags$script section) but I don&#39;t know how to make it reactive.<br><div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div></div></code></div></div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\">ui</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">.</span></span><span style=\"color:#000\">R</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">)</span></span><span style=\"color:#000\"><br>library</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\">shiny</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">)</span></span><span style=\"color:#000\"><br>shinyUI</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\">fluidPage</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\"><br>  tags$head</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\"><br>    tags$script</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:#000\"><br>      HTML</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;<br>        Shiny.addCustomMessageHandler (&#39;resize&#39;,function (message) {<br>               $(&#39;#allmaps&#39;).css(&#39;height&#39;, message);<br>        });<br>      &quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">)</span></span></div></code></div></div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div><span style=\"color:#000\"><br>    </span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">),</span><span style=\"color:#000\"><br></span></span><span style=\"color:#000\">    </span><b><span style=\"color:#000\">tags$style</span></b><b><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;#allmaps{height:200vh !important;}&quot;</span><span style=\"color:#660\">)</span></b></div></code></div></div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><div style=\"background-color:rgb(250,250,250);border:1px solid rgb(187,187,187);word-wrap:break-word\"><code><div><span style=\"color:#000\"><br>  </span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">),</span></span><span style=\"color:#000\"><br>selectInput</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;total&quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">,</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;Total Plots&quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">,</span></span><span style=\"color:#000\"> list</span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">(</span></span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;1&quot;</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">=</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;1&quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">,</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;2&quot;</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">=</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;2&quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">,</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;3&quot;</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">=</span></span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,136,0)\"><span style=\"color:#080\">&quot;3&quot;</span></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">))</span></span><span style=\"color:#000\"><br></span><span style=\"color:rgb(102,102,0)\"><span style=\"color:#660\">...</span></span><span style=\"color:#000\"><br></span></div></code></div></div></div></div>"
