lor:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#000\">names</span><span style=\"color:#660\">(</span><span style=\"color:#000\">cols2</span><span style=\"color:#660\">())))</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>    <br>    model </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>      </span><span style=\"color:#800\">#lm(input$dsname[,names(input$dsname) %in% input$y_axis2] ~ input$dsname[,names(input$dsname) %in% input$x_axis2])</span><span style=\"color:#000\"><br><br><br>      lm</span><span style=\"color:#660\">(</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">formula</span><span style=\"color:#660\">(</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$y_axis2</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot; ~ &quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> input$x_axis2</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> input$dsname </span><span style=\"color:#660\">)</span><span style=\"color:#000\"> <br>    </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>    <br>    model_summary </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> reactive</span><span style=\"color:#660\">({</span><span style=\"color:#000\">summary</span><span style=\"color:#660\">(</span><span style=\"color:#000\">model</span><span style=\"color:#660\">())})</span><span style=\"color:#000\"><br>    output$rsquared </span><span style=\"color:#660\">&lt;-</span><span style=\"