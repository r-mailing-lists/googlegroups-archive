    [
     1,
     "<div dir=\"ltr\">Apologies, that was a typo. However, this neither makes the progress bar wider nor does it make the box where the text is shown bigger to fix the wrapping:<br><br><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#660\">.</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">progress </span><span style=\"color:#660\">.</span><span style=\"color:#000\">bar </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>background</span><span style=\"color:#660\">-</span><span style=\"color:#000\">color</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#800\">#FF0000;</span><span style=\"color:#000\"><br>opacity </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">0.8</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br>width</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#066\">30px</span><span style=\"color:#660\">;</span></div></code></div></div>"
    ],
    [
     3,
     "<div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br></span><span style=\"color:#660\">.</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">progress </span><span style=\"color:#660\">.</span><span style=\"color:#000\">progress</span><span style=\"color:#660\">-</span><span style=\"color:#000\">text </span><span style=\"color:#660\">.</span><span style=\"color:#000\">progress</span><span style=\"color:#660\">-</span><span style=\"color:#000\">message</span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>font</span><span style=\"color:#660\">-</span><span style=\"color:#000\">size</span><span style=\"color:#660\">:</span><span style=\"color:#066\">10px</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br></span><span style=\"color:#660\">.</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">-</span><span style=\"color:#000\">progress </span><span style=\"color:#660\">.</span><span style=\"color:#000\">progress</span><span style=\"color:#660\">-</span><span style=\"color:#000\">text </span><span style=\"color:#660\">.</span><span style=\"color:#000\">progress</span><span style=\"color:#660\">-</span><span style=\"color:#000\">detail</span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>font</span><span style=\"color:#660\">-</span><span style=\"color:#000\">size</span><span style=\"color:#660\">:</span><span style=\"color:#066\">15px</span><span style=\"color:#660\">;</span><span style=\"color:#000\"><br><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span></div></code></div></div>"
