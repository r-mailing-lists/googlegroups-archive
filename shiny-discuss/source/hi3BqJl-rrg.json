  {
   "id": "NQl23OIbuKYJ",
   "from": "Joe Cheng",
   "author": "ca443e6eaa0e78ed",
   "date": "2015-03-18T22:46:53Z",
   "subject": "Re: withProgress",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">For the bigger font, I believe the selectors you want are:<div><br></div><div><div>.shiny-progress .progress-text .progress-message</div></div><div><br></div><div>and</div><div><br></div><div><div>.shiny-progress .progress-text .progress-detail</div></div><div><br></div><div><br></div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
