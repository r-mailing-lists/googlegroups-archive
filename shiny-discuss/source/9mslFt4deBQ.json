color:#080\">&quot;bins&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  </span><span style=\"color:#080\">&quot;Number of bins:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  min </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  max </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">50</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  value </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">30</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>      </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>body </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> dashboardBody</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>    fluidRow</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>        column</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>            width </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">4</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>        box</span><span style=\"color:#660\">(</span><span style=\"color:#000\">title </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Chart1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                plotOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;distPlot&quot;</span><span style=\"color:#660\">)</span><span style