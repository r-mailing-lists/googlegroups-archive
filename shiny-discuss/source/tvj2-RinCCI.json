    [
     3,
     "\r<br>\r<br>On Wed, Jul 23, 2014 at 9:29 AM,  &lt;<a href data-email-masked rel=\"nofollow\">pvuto...@gmail.com</a>&gt; wrote:\r<br>&gt; I miscopied server.R, it&#39;s missing the closing brackets. Again, this time\r<br>&gt; properly:\r<br>&gt;\r<br>&gt; server.R\r<br>&gt; df.proto &lt;- data.frame(&quot;publisher&quot; = c(1:1000)) #the more values, the easier\r<br>&gt; to reproduce the bug; works with about 50 too\r<br>&gt;\r<br>&gt; shinyServer(function(input, output, session){\r<br>&gt;   observe({\r<br>&gt;     print(paste0(&quot;&gt;&gt;&gt;&gt;&gt; ENTERING OBSERVE input$publisher: &quot;,\r<br>&gt; paste(unlist(input$publisher), collapse = &quot;, &quot;)))\r<br>&gt;\r<br>&gt;     updateSelectizeInput(session, &quot;publisher&quot;, choices = df.proto$publisher,\r<br>&gt; selected = input[[&quot;publisher&quot;]])\r<br>&gt;\r<br>&gt;     print(paste0(&quot;EXITING OBSERVE input$publisher: &quot;,\r<br>&gt; paste(unlist(input$publisher), collapse = &quot;, &quot;), &quot;&lt;&lt;&lt;&lt;&lt;&lt;&quot;))\r<br>&gt;   })\r<br>&gt; }) # End server.\r<br>&gt;\r<br>&gt; ui.R\r<br>&gt;\r<br>&gt; shinyUI(\r<br>&gt;   navbarPage(&quot;test&quot;,\r<br>&gt;\r<br>&gt;     tabPanel(&quot;Browse&quot;,\r<br>&gt;       fixedPage(\r<br>&gt;         selectizeInput(&quot;publisher&quot;, &quot;publisher&quot;, choices = NULL, selected =\r<br>&gt; NULL, multiple = T),\r<br>&gt;\r<br>&gt; HTML(&quot;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&lt;/br&gt;&quot;)\r<br>&gt;       )\r<br>&gt;     )\r<br>&gt;   )\r<br>&gt; )# End shiny.\r<br>&gt;\r<br>"
