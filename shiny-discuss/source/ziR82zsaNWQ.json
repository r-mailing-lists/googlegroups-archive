    [
     3,
     "<div dir=\"ltr\"><br><br>On Sunday, November 30, 2014 6:38:16 AM UTC-8, Herman Sontrop wrote:<blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\">Would you mind sharing the code you use which does this part?</blockquote></div>"
