   "parts": [
    [
     1,
     "<div dir=\"ltr\">Hi kota, <div>  I suggest you read through the tutorial of Shiny. Here is the code I re-write for you:</div><div><br></div><div>## ui.R</div><div><div>### London weather</div><div><br></div><div>library(shiny)</div><div><br></div><div>shinyUI(pageWithSidebar(</div><div><br></div><div><span style=\"white-space:pre\">\t</span>headerPanel(&quot;Europe temperature 2013&quot;),</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>sidebarPanel(</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><span style=\"white-space:pre\">\t\t</span></div><div><span style=\"white-space:pre\">\t\t</span>selectInput(&quot;dataset&quot;, &quot;Choose a location&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>choices = c(&quot;Berlin Tigel Airport&quot; = &quot;berlin&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t</span>&quot;London City Airport&quot; = &quot;london&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t</span>&quot;Paris Charles De Gaulle&quot; = &quot;paris&quot;)</div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div><span style=\"white-space:pre\">\t\t\t\t</span>   ),</div><div><span style=\"white-space:pre\">\t\t\t\t</span>   </div><div><span style=\"white-space:pre\">\t\t</span>dateRangeInput(&quot;daterange&quot;, &quot;Date Range&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>   start = &quot;2013-01-01&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>   end = &quot;2013-12-31&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>   min = &quot;2013-01-01&quot;,</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>   max = &quot;2013-12-31&quot;</div><div><span style=\"white-space:pre\">\t\t\t\t\t</span>  )</div><div><span style=\"white-space:pre\">\t\t\t\t</span>),</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>mainPanel(</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t\t</span>plotOutput(&quot;theGraph&quot;)</div><div><span style=\"white-space:pre\">\t\t</span></div><div><span style=\"white-space:pre\">\t</span>)</div><div>))</div></div><div><br></div><div><br></div><div>## server.R</div><div><br></div><div><div>### Weather server.R</div><div><br></div><div><br></div><div>library(shiny)</div><div>library(weatherData)</div><div>library(ggplot2)</div><div>library(scales)</div><div>library(plyr)</div><div><br></div><div>### load weather data.</div><div>berlin &lt;- read.csv(&quot;berlin.csv&quot;, header = T)</div><div>london &lt;- read.csv(&quot;london.csv&quot;, header = T)</div><div>paris &lt;- read.csv(&quot;paris.csv&quot;, header = T)</div><div><br></div><div><br></div><div><br></div><div>shinyServer(function(input, output){</div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span># Return the requested dataset</div><div><span style=\"white-space:pre\">\t</span></div></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div><div><span style=\"white-space:pre\">\t</span>datasetInput &lt;- reactive({</div><div><span style=\"white-space:pre\">\t\t</span></div><div><span style=\"white-space:pre\">\t\t</span>switch(input$dataset,</div><div><span style=\"white-space:pre\">\t\t\t\t</span>&quot;berlin&quot; = berlin,</div><div><span style=\"white-space:pre\">\t\t\t\t</span>&quot;london&quot; = london,</div><div><span style=\"white-space:pre\">\t\t\t\t</span>&quot;paris&quot; = paris)</div><div><span style=\"white-space:pre\">\t</span>})</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span># Prepare data once and then pass around the program.</div><div><span style=\"white-space:pre\">\t\t</span></div><div><br></div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>output$theGraph &lt;- renderPlot({</div><div><span style=\"white-space:pre\">\t</span>  foo &lt;- datasetInput()</div><div><span style=\"white-space:pre\">\t</span>  foo$shortdate &lt;- strftime(foo$Time, format = &quot;%Y-%m-%d&quot;)</div><div><span style=\"white-space:pre\">\t</span>  foo$shortdate &lt;- as.Date(foo$shortdate, format = &quot;%Y-%m-%d&quot;)</div><div><span style=\"white-space:pre\">\t</span>  foo &lt;- foo[foo$shortdate %in%</div><div><span style=\"white-space:pre\">\t</span>               seq.Date(input$daterange[1],</div><div><span style=\"white-space:pre\">\t</span>                        input$daterange[2], by = 1), ]</div><div>    </div><div><span style=\"white-space:pre\">\t\t\t</span>graphdata &lt;- ddply(foo, .(shortdate), summarize, mean_C = mean(TemperatureC)) </div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div><div><span style=\"white-space:pre\">\t\t\t</span></div><div><span style=\"white-space:pre\">\t\t\t</span>if(input$dataset == &quot;berlin&quot;){</div><div><span style=\"white-space:pre\">\t\t\t\t</span></div><div><span style=\"white-space:pre\">\t\t\t\t</span>theGraph &lt;- ggplot(graphdata, aes(shortdate, mean_C)) +</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t\t</span>geom_line() +</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t\t</span>scale_x_date(labels = date_format(&quot;%Y-%m-%d&quot;)) +</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t\t</span>xlab(&quot;&quot;) +</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t\t</span>ylab(&quot;Mean Temperature (C)&quot;) +</div><div><span style=\"white-space:pre\">\t\t\t\t\t\t\t\t\t</span>ggtitle(&quot;2013 Average Daily Temperature in Berlin&quot;)</div><div><span style=\"white-space:pre\">\t\t\t</span>}</div><div><span style=\"white-space:pre\">\t\t\t</span></div></div></div>"
