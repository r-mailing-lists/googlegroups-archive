     1,
     "I&#39;m using javascript to modify my shiny page. I wrote a small script to listen to the shiny websocket. By using this you can listen to events which would normally be hidden. Maybe its useful for you!<br><br><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">window.Shiny.shinyapp.$socket.onmessage = function(e) {</span><br></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">  </span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">  //trigger R event op the body en send data from R with the event</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><font color=\"#000000\" face=\"Consolas, Lucida Console, monospace\" style=\"line-height:normal\"><span style=\"line-height:17px;font-size:12px;white-space:pre-wrap\">  $(&#39;body&#39;).trigger(&#39;R&#39;, $.parseJSON(e.data));</span></font></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"font-size:12px;line-height:17px;white-space:pre-wrap;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace\">\r\n  //you need this line to not break shiny internally</span><font color=\"#000000\" face=\"Consolas, Lucida Console, monospace\" style=\"line-height:normal\"><span style=\"line-height:17px;font-size:12px;white-space:pre-wrap\"><br></span></font></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">  window.Shiny.shinyapp.dispatchMessage(e.data);</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;line-height:17px;white-space:pre-wrap\">}</span><br></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">\r\n</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">$(&#39;body&#39;).on(&#39;R&#39;, function(event, data) {</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\"><br></span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">  //for some insight in incoming data</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">  console.log(&#39;R-data-recieved&#39;, data);</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">\r\n</span></div><div style=\"line-height:21px;color:rgb(68,68,68);font-family:Calibri,sans-serif;font-size:15px\"><span style=\"line-height:17px;color:rgb(0,0,0);font-family:Consolas,&#39;Lucida Console&#39;,monospace;font-size:12px;white-space:pre-wrap\">});</span></div>"
