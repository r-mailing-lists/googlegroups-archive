000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> j </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br>  <br>  </span><span style=\"color:#800\"># Want to add this B list to values to get values$B</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\"># The variable B is user selectable. Don&#39;t know in advance</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\"># B = list(info = 100, data = data.frame(i = 100, j = 200)))</span><span style=\"color:#000\"><br><br>  observe</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>    </span><span style=\"color:#008\">print</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#000\">values$A</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> values$B</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br>shinyApp</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ui</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> server</span><span style=\"color:#660\">)</span></div></code></div><br><br></div>"
