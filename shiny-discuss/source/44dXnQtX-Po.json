     "<div dir=\"ltr\">Hi All,<div><br></div><div><span style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\">I am using shiny package to make a simple dashboard.</span><br style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\"><span style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\">Dashboard Objective: Plot a bar graph based on date range (taken as input from user)</span><br style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\"><span style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\">My code of server.R -&gt;</span><br style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\"><span style=\"color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\">library(shiny)</span><span style=\"display:inline;color:rgb(20,24,35);font-family:helvetica,arial,sans-serif;font-size:14px;line-height:19.3199996948242px\"><br>library(quantmod)<br>setwd(&quot;d:/rshiny_dummy&quot;)<br>shinyServer(function(input, output) {<br>##########<a href=\"https://www.facebook.com/hashtag/method?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/method?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw0asfRMzoZ4NiHvW5o7pD_L\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>METHOD‬</span></a> 1#############<br><a href=\"https://www.facebook.com/hashtag/datainput?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/datainput?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw2RV-s3IuBFSNKw2l0wb52V\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>dataInput‬</span></a> &lt;- reactive({<br><a href=\"https://www.facebook.com/hashtag/getsymbols?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/getsymbols?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw1IWJcRay_VkAhH_AOg89d8\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>getSymbols‬</span></a>.csv(&quot;order trend&quot;, dir=&quot;&quot;, extension=&quot;csv&quot;,return.class = &quot;xts&quot;,col.names=c(&quot;order_date&quot;,&quot;tot_orders&quot;,&quot;avg_spent&quot;),<br><a href=\"https://www.facebook.com/hashtag/from?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/from?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw3CZf4gH4uHlLP1YkDFJnLo\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>from‬</span></a> = input$dates[1],<br><a href=\"https://www.facebook.com/hashtag/to?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/to?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw3lTT1dr0J628WuCa28qbQ_\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>to‬</span></a> = input$dates[2],<br><a href=\"https://www.facebook.com/hashtag/auto?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/auto?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw3gueqtoSSP5oWyBd7bPwQF\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>auto‬</span></a>.assign = FALSE)<br>#})<br><a href=\"https://www.facebook.com/hashtag/output?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/output?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw3psLsLXJHYxogDPzO4C5wp\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>output‬</span></a>$plot &lt;- renderPlot({ <br><a href=\"https://www.facebook.com/hashtag/chartseries?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/chartseries?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw2Ja_4c20tCWjyrvj2z8Cu_\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>chartSeries‬</span></a>(dataInput(), theme = chartTheme(&quot;white&quot;), <br><a href=\"https://www.facebook.com/hashtag/type?source=feed_text\" style=\"color:rgb(59,89,152)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.facebook.com/hashtag/type?source%3Dfeed_text&amp;source=gmail&amp;ust=1792398300450000&amp;usg=AOvVaw0bedxr0RuGvJQ82Ihoe2DI\"><span aria-label=\"hashtag\" style=\"color:rgb(109,132,180)\">‪#‎</span><span>type‬</span></a> = &quot;line&quot;, log.scale = FALSE)<br>###########METHOD 2#############<br>output$plot &lt;- renderPlot({<br>data &lt;- getSymbols.csv(&quot;order trend&quot;, dir=&quot;&quot;, extension=&quot;csv&quot;,return.class = &quot;xts&quot;,col.names=c(&quot;order_date&quot;,&quot;tot_orders&quot;,&quot;avg_spent&quot;),<br>from = input$dates[1],<br>to = input$dates[2],<br>auto.assign = FALSE)<br>chartSeries(data, theme = chartTheme(&quot;white&quot;), <br>type = &quot;line&quot;, log.scale = FALSE, TA = NULL)<br>})<br>#})<br>})<br>Both the methods are giving me this error:<br>&quot;Error in if (on == &quot;years&quot;) { : missing value where TRUE/FALSE needed&quot;<br>I have tried googling this error but all the results I am getting are not helping me.</span><br></div></div>"
