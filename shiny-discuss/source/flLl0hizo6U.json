pan style=\"color:#660\">,</span><span style=\"color:#000\"> plotOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;filedf&quot;</span><span style=\"color:#660\">)),</span><span style=\"color:#000\"><br>                  tabPanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Map&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> leafletOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;map&quot;</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span></div></code></div><div><br></div><div><br></div><div><br></div><div>ui.R</div><div><br></div><div><br></div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">shiny</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>shinyUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>  titlePanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;File Input&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>  sidebarLayout</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>    sidebarPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      fileInput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;file&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;Upload the file&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> multiple</span><span style=\"color:#660\">=</span><span style=\"color:#000\">TRUE