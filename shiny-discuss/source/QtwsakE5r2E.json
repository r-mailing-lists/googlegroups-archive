b1&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>    tabsetPanel</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>      tabPanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;Iris&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">dataTableOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;iris&#39;</span><span style=\"color:#660\">)),</span><span style=\"color:#000\"><br>      tabPanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;Mtcars&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">dataTableOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;mtcars&#39;</span><span style=\"color:#660\">)),</span><span style=\"color:#000\"><br>      position</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&#39;left&#39;</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#800\"># comment the 4 lines below and the first tab will work</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>  tabPanel</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;Tab2&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>    dataTableOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;iris&#39;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">)</span><span style=\"color:#000\">  <br><br><br>server </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> output</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> session</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>    <br>  output$iris </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderDataTable</span><span style=\"color:#660\">(</span><span style=\"color:#000\">iris</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  output$mtcars </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> renderDataTable</span><span style=\"color:#660\">(</span><span style=\"color:#000\">mtcars</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  <br>  <br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br><br><br>shinyApp</span><span style=\"color:#660\">(</span><span style=\"color:#000\">server </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> server</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ui </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> ui</span><span style=\"color:#660\">)</span></div></code></div><div><br></div></div></blockquote></div></div>"
