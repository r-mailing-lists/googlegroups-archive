    ],
    [
     1,
     "<div dir=\"ltr\"><div><div>        as.character() %&gt;% </div><div>        as.list()</div><div>    })</div><div>    </div><div>    output$mytabs &lt;- renderUI({</div><div>      colorVector_use &lt;- colorVector()</div><div>      myTabs = lapply(colorVector_use, tabPanel)</div><div>      </div><div>      do.call(tabsetPanel,</div><div>              c(type = &#39;pills&#39;,</div><div>                lapply(colorVector_use, function(x) {</div><div>                  call(&quot;tabPanel&quot;,x ,call(&#39;dataTableOutput&#39;,paste0(&quot;table_&quot;,x)))</div><div>                })</div><div>              ))</div><div>    })</div><div>   </div><div>    observe({</div><div>      if (!is.null(colorVector())){</div><div>    lapply(colorVector(), function(x){</div><div>      output[[paste0(&#39;table_&#39;,x)]] &lt;- renderDataTable(</div><div>        diamonds_test %&gt;% filter(cut == input$name, color == x))</div><div>    })</div><div>      }</div><div>    })</div><div>      }</div><div>))</div></div><div><br></div><br></div>"
