    [
     1,
     "<div dir=\"ltr\">If the bucket is non-public, you&#39;ll probably have to save it to a file and use renderImage() to display it.<div><br></div><div>See:</div><div><a href=\"http://shiny.rstudio.com/gallery/image-output.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://shiny.rstudio.com/gallery/image-output.html&amp;source=gmail&amp;ust=1792396571307000&amp;usg=AOvVaw3BpqxCQAgddBMOD_CWczmH\">http://shiny.rstudio.com/gallery/image-output.html</a></div><div><a href=\"http://shiny.rstudio.com/articles/images.html#sending-pre-rendered-images-with-renderimage\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://shiny.rstudio.com/articles/images.html%23sending-pre-rendered-images-with-renderimage&amp;source=gmail&amp;ust=1792396571307000&amp;usg=AOvVaw2BG6vY5R7DuqRlKW68k99H\">http://shiny.rstudio.com/articles/images.html#sending-pre-rendered-images-with-renderimage</a><br></div><div><br></div><div><br></div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">On Wed, Sep 30, 2015 at 1:44 PM, billelev <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">bi...@variantperception.com</a>&gt;</span> wrote:<br></div></div>"
