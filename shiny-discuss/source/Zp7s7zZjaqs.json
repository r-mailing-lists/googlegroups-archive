     1,
     "<div dir=\"ltr\">Hi, <div><br></div><div>As often, the answer is in the help page, accessible by typing :</div><div><br></div><blockquote style=\"margin:0 0 0 40px;border:none;padding:0px\"><div><i>?tabsetPanel</i></div></blockquote></div>"
    ]
   ]
