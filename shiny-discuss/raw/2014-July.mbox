Hi,

i create my own axes with

my.axis <- function(side, range, at, labels, ...) {
  at  <- pretty(range)
  df  <- min(diff(at))
  dec <- max(0, ceiling(-log10(df)))
  axis(side, at=at, labels=sprintf("%.*f", dec, at), ...)
}

