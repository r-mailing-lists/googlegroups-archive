Server.UI (on my UI.R, I have xcol and ycol on a different tabset than Upload CSV)

triggers<-reactiveValues(mainplot=NULL)
datasetInput <- reactive({
        inFile <- input$file1
        if (is.null(inFile)) return(NULL)
        main_plot<<-read.csv(input$file1$datapath, header=input$header, sep=input$sep, quote=input$quote) #special equal operation to change the value outside the function call
        triggers$mainplot<-inFile
})

 updatePlotFields <- observe({
        triggers$mainplot
        if (is.null(isolate(input$file1))) return(NULL)
        cols <- colnames(main_plot)
        updateSelectInput(session, "xcol", "Select X Axis Field", cols)
        updateSelectInput(session, "ycol", "Select Y Axis Field", cols)
    })

