Well you need your selectInput to be there other updateSelectInput just won't work.

server.R

library(shiny)

shinyServer(function(input, output, session){
  ## Data reactives:
  uploaded_Data <- reactive({
    inFile <- input $ data
    if(is.null(inFile)){return(NULL)}
    read.csv(file = inFile $ datapath,
             header=TRUE)
  })
  output $ raw_data <- renderTable({
    uploaded_Data()
  })## for table

  getStudy_codes <- reactive({
    Study_codes <- 'NULL'

    #names(Study_codes) <- 'Select Treatment'
    if(!is.null(input$inFile$datapath)){

      data <- read.csv(file = inFile$datapath, header=TRUE)

      codes <- unique(data$Treatment_nbr)

      names(codes) <- codes
      Study_codes <- c(Study_codes, codes)
    }
    return(Study_codes)
  })

  observe({
    updateSelectInput(session,"Tr1",label = "Treatment1", choices = getStudy_codes())
    updateSelectInput(session,"Tr2",label = "Treatment2", choices = getStudy_codes())
  })

})

ui.R

library(shiny)

shinyUI(pageWithSidebar(
  headerPanel(''),
  sidebarPanel(
    fileInput('data', 'File to upload (.csv only):',
              accept=c('.csv')),
    tags $ hr(),
    h4('Select treatments:'),

     selectInput("Tr1",label = "Treatment1", choices = ""),
     selectInput("Tr2",label = "Treatment2", choices = "")

  ),

  ## Option for tabsets:
  mainPanel(
    tabsetPanel(
      tabPanel('Uploaded Data',
               tableOutput('raw_data')),
      tabPanel('data',
               verbatimTextOutput('Tr1'))
    )
  )
))## overall

