)

server = function(input, output) {
#rv = reactiveValues( x=c(1,2,3) )
rv = reactiveValues( x=matrix(c(1,2,3,4),nrow=2) )
#rv = reactiveValuesToList( x=data.frame(matrix(c(1,2,3,4),nrow=2) ))

