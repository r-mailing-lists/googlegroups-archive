Hi Hashmi,

Add in ui.R:

library(htmltools)

tg <- tags$div()
tg <- attachDependencies(
  tg,
  htmlDependency(
    name    = "plotlyjs",
    version = "1.8.0",
    src     = c(href = "https://cdn.plot.ly"),
    script  = "plotly-latest.min.js"
  )
)

dashboardBody(
  //
  tags$head(tg)
  //
)

Good Luck

