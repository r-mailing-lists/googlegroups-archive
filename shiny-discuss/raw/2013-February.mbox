I used your maps example and added a js section that loads the Google "geomap" package:

ui.R:
require(shiny)

initGeomap <- '
<script type="text/javascript" src="http://www.google.com/jsapi"></script <http://www.google.com/jsapi%22%3E%3C/script>>
<script type="text/javascript">
google.load("visualization", "1", { packages:["geomap"] });
</script>
'
shinyUI(pageWithSidebar(
  headerPanel("shiny with googleVis"),
  sidebarPanel(),
  mainPanel(
    HTML(initGeomap),
    htmlOutput("gvis")
  )
  )
)

server.R:
require(shiny)
require(googleVis)
shinyServer(function(input, output) {
 output$gvis <- reactiveText(function(){

   G4 <- gvisGeoMap(Andrew, locationvar="LatLong", numvar="Speed_kt",
      hovervar="Category",
      options=list(height=350, region="US", dataMode="markers")
   )

   c(G4$html$chart,

       paste("\n<script type=\"text/javascript\">drawChart",

                           G4$chartid,"();</script>\n",sep="")
       )
 })
})

Best, Stefan

> >

