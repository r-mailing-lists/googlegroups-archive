Hallo :)

I realy appreciate all help I got here so far, please if anyone got some time and look through that little code :)

#######################################################################################
library(shiny)
library(rgl)
#######################################################################################
ui <- fluidPage(

  headerPanel("Block Theory 0.1"),

  sidebarPanel(

     numericInput(inputId = "strike", label = "Strike:", value = "", width = "80%"),

     numericInput(inputId = "dip", label = "Dip:", value = "", width = "80%"),

     actionButton(inputId = "add", label = "Add a plane"),

     actionButton(inputId = "plotbutton", label = "Update")
  ),

  mainPanel(

    rglwidgetOutput(outputId = "plot")
  ),

verbatimTextOutput(outputId = "log_planes"),

data_planes <- data.frame(),
makeReactiveBinding("data_planes")
)
#######################################################################################
server <- function(input, output) {

i <- 1

open3d()

observe({
    input$add
    isolate({
      data_planes <<- rbind(data_planes, data.frame(input$strike, input$dip))
      data_planes <<- na.omit(data_planes)

       })
  })

observeEvent(input$plotbutton,{
   output$plot <<-renderRglwidget({

      if (i <= nrow(data_planes)) {
        phi <- 90 - data_planes[i,1]
        deta <- data_planes[i,2]

        x <- sin(phi)*cos(deta)
        y <- sin(phi)*sin(deta)
        z <- cos(phi)

        persp3d(phi,deta)

        i <<- i + 1}
    })
  })

output$log_planes <- renderPrint({print(data_planes)})

}
#######################################################################################
shinyApp(ui = ui, server = server)

