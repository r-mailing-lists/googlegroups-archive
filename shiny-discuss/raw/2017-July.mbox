Additional info:

This does work - everytime :

## app.R ##
server <- function(input, output) {

  data_file <- shiny::reactive({

    inFile <- input$file

    if (is.null(inFile)) {
      return(NULL)
    }

    df <- readr::read_tsv(inFile$datapath)

    return(df)
  })

  output$text <- shiny::renderPrint({data_file()})

}

ui <- fluidPage(
  sidebarLayout(
    sidebarPanel(

      shiny::fileInput(inputId = "file",

                       label = "Chose RAP file",

                       multiple = FALSE,
                       accept = NULL,
                       width = NULL,
                       buttonLabel = "Browse...",
                       placeholder = "No file selected")

    ),
    mainPanel(textOutput("text"))
  )
)

shinyApp(ui = ui, server = server)

