you can do it directly:

output$A <- renderUI({
  choicesA <- c("A" = 1, "B"=2)
  selectInput('A', "Choose", choicesA) })
}

output$B <- renderUI({
  if (input$A==1) {
    choicesB1 <- something
    ret <- selectInput('B', "Choose", choicesB1)
  } else {
    choicesB2 <- something
    ret <- selectInput('B', "Choose", choicesB2)
  }
  ret
})

Best Sigbert

