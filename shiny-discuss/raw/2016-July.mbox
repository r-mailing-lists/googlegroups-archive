I have some reactive text in the sidebar of my app.  When it gets updated by a button in a tab, the app navigates back to the first tab.  Code below.
Any ideas on why this happens / how to fix it?

# changing panels on button action

ui<- bootstrapPage(
  uiOutput('ui')
)

server <- shinyServer(function(input, output, session){

  reactive_var <<- reactiveValues(
    'info' = 'no'
  )

  output$ui<- renderUI(
    sidebarLayout(
      sidebarPanel = sidebarPanel(
        h1(reactive_var[['info']])

      ),
      mainPanel = mainPanel(
        tabsetPanel(
          tabPanel(
            'tab1',
            h1('First Panel')
          ),
          tabPanel(
            'tab2',
            tagList(
              h1('Second Panel'),
              actionButton('button',
                           'Add reactive value')
            )
          )
        )
      )
    )
  )

    observeEvent( input$button, {
        reactive_var[['info']] <-'yes'
    })
})

shinyApp(ui = ui, server = server)

