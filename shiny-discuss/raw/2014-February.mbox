Hi,
Your reactive conductor is not connected to the action button because of isolate().
Add a connection like this:

   dat <- reactive({
    if (input$Guardar == 0 | Datos() == NULL | dicc() == NULL) return(NULL)

    input$acotador

    return(isolate({
      if(input$acotador==0){Datos()[,input$variables]=Datos()[,input$variables]}
      if(input$acotador==1){Datos[,input$variables][Datos[,input$variables] >= quantile(Datos[,input$variables], probs=0.95, na.rm=TRUE) & !is.na <http://is.na/>(Datos[,input$variables])] = quantile(Datos[,input$variables], probs=0.95, na.rm=TRUE)}
      if(input$acotador==2){Datos[,input$variables][Datos[,input$variables] >= quantile(Datos[,input$variables], probs=0.99, na.rm=TRUE) & !is.na <http://is.na/>(Datos[,input$variables])] = quantile(Datos[,input$variables], probs=0.99, na.rm=TRUE)}
      if(input$acotador==3){Datos[,input$variables][Datos[,input$variables] >= as.numeric(input$cota) & !is.na <http://is.na/>(Datos[,input$variables])] = as.numeric(input$cota)}
    }))
  })

