Try this instead as the body of your shinyServer function:

inFile <- reactive({
  if (is.null(input$file1))
  'data/some_data.csv'
  else
    input$file1$datapath
})

inData <- reactive(read.csv(inFile()))

output$contents <- renderTable({
  inData()
})

