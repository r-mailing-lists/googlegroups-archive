shinyUI(fluidPage(
  titlePanel("Uploading Files"),
sidebarLayout(
    sidebarPanel(
      fileInput('file1', 'Choose first file to upload',
                accept = c(
                  'text/csv',
                )
      ),))sidebarLayout(
    sidebarPanel(
      fileInput('file1', 'Choose second file to upload',
                accept = c(

                  '.xlsx'
                )
      ),
)))
server.R
shinyServer(function(input, output) {
a <- reactive({
   fileinput1 <- input$file1
