OK, you can use the melt command.

library(data.table)
data=data.table(name=c('a','b','c'), year=c('2010','2011','2012'),city1=c(30,20,15),city2=c(40,30,20),city3=c(30,20,15))
sel.name <http://sel.name>='a'
selcols=grep('city',names(data))

tot.by.city = melt(data[name==sel.name <http://sel.name>],id.vars=c('name','year'),measure.vars=selcols)

output
   name year variable value
1:    a 2010    city1    30
2:    a 2010    city2    40
3:    a 2010    city3    30

Max

