Hi,

I made a small app that does what you want :-)

library("shiny")

runApp(list(
  ui = fluidPage(
    titlePanel("Dynamic list example"),
    sidebarLayout(
      sidebarPanel(
        textInput("text","text to add", value = ""),

        actionButton('action',"Add")),
      mainPanel(

        h3(textOutput("MyList"))

      )
    )
  )
  ,
  server = function(input, output) {

    values <- reactiveValues(vect = NULL)

    observe({
      #take a dependency on action button
      if(input$action==0) return()

      #attach the new value
      values$vect <- c(isolate(values$vect),isolate(input$text))
     })

    output$MyList <- renderText({
      values$vect
    })

  }
 )
)

best, Herman Sontrop

