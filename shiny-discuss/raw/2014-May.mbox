Hallo,
You helped me out, that was exactly what I was searching for.
I tried

input$mslider

what was not giving me anything.

Now it's runable:

## ui.R
##########

library(shiny)

##########
shinyUI(fluidPage(
  titlePanel("Zoo series query"),

  sidebarLayout(
    sidebarPanel(
      helpText("z1 is a fictive measurement of wind speed (range between 18.1 and 129.6 km/h)"),
      helpText("z2 is a fictive measurement of wave height (range between 0.7 and 5.1 m)"),

      selectInput("var1",
                  label = "choose left axis variable",
                  choices = list("wind", "waves"),
                  selected = "wind"),

      selectInput("var2",
                  label = "choose right axis variable",
                  choices = list("wind", "waves"),
                  selected = "waves"),

      dateRangeInput("dates",
                     "date range",
                     start = start(z1),
                     end = end(z1)),

      uiOutput("mSlider")

    ),

    mainPanel(plotOutput("plot"))
  )

))

## server.R
###########

library(shiny)
library(zoo)

## plot legenden outside plot area
add_legend <- function(...) {
  opar <- par(fig=c(0, 1, 0, 1), oma=c(0, 0, 0, 0),
              mar=c(0, 0, 0, 0), new=TRUE)
  on.exit(par(opar))
  plot(0, 0, type='n', bty='n', xaxt='n', yaxt='n')
  legend(...)

}

#----------------#

### build two zoo series

x1 <- c(38.2, 18.1, 83.2, 42.7, 22.8, 48.1, 81.8, 129.6, 52.0, 110.3)
x2 <- c(2.2, 0.8, 0.7, 1.6, 0.9, 0.9, 1.1, 2.8, 5.1, 2.1)

z1 <- zooreg(x1, start=as.POSIXct("2013-01-01 00:00:01"), frequency=0.0000006)
z2 <- zooreg(x2, start=as.POSIXct("2013-01-01 00:00:20"), frequency=0.0000006)
zt <- zooreg(rnorm(1050), start=as.POSIXct("2013-01-01 00:00:01"), frequency=0.00007)

z<-merge(zt, z1, all = TRUE)
z<-merge(z, z2, all = TRUE)
Zf<-na.spline(z[,2:3], na.rm = FALSE)

#startdate<-as.POSIXct("2013-03-17 00:00:01")
#enddate<-as.POSIXct("2013-03-21 23:59:59")

#----------------#

shinyServer(function(input, output) {

  output$mSlider <- renderUI({

    #generate the slider

    sliderInput("mInput",label = "zoom slider",min = as.numeric(as.POSIXct(paste(as.character(input$dates[1])," 00:00:01", sep=""))), max = as.numeric(as.POSIXct(paste(as.character(input$dates[2])," 00:00:00", sep=""))), value =c(as.numeric(as.POSIXct(paste(as.character(input$dates[1])," 00:00:01", sep=""))), as.numeric(as.POSIXct(paste(as.character(input$dates[2])," 00:00:00", sep="")))) )
  })

  output$plot <- renderPlot({

    startdate<-as.POSIXct(input$mInput[1],origin="1970-01-01",tz="CET")
    enddate<-as.POSIXct(input$mInput[2],origin="1970-01-01",tz="CET")

    Zfw<-window(Zf, start=startdate, end=enddate)

    data1 <- switch(input$var1,
                    "wind" = Zfw$z1,
                    "waves" = Zfw$z2,
    )
    #data1<-Zfw$z1

    data2 <- switch(input$var2,
                    "wind" = Zfw$z1,
                    "waves" = Zfw$z2,
    )
    #data2<-Zfw$z2

    col1 <- switch(input$var1,
                   "wind" = "#e41a1c",
                   "waves" = "#377eb8",
    )
    #col1<-"#e41a1c"

    col2 <- switch(input$var2,
                   "wind" = "#e41a1c",
                   "waves" = "#377eb8",
    )
    #col2<-"#377eb8"

    ylab1 <- switch(input$var1,
                    "wind" = "wind speed [km/h]",
                    "waves" = "wave height [m]",
    )
    #ylab1<-"wind speed [km/h]"

    ylab2 <- switch(input$var1,
                    "wind" = "wind speed [km/h]",
                    "waves" = "wave height [m]",
    )
    #ylab2<-"wave height [m]"

    maintxt<-paste("windspeed and wave height at Dreamcoast from ", startdate, " to ", enddate, sep="")

    lnames<-c(as.character(input$var1),as.character(input$var2))
    #lnames<-c("wind", "waves")
    lcols<-c(col1,col2)

    plot(data1, col=col1 , ylim=c(0,signif(max(na.omit(data1)*1.05),2)), xlab="", ylab=ylab1,  main=maintxt)
    #grid(col = "lightgray", lty = "dotted")

    ## rightside y-axis
    opar <- par(usr = c(par("usr")[1:2], c(0,signif(max(na.omit(data2)*1.05),2))))
    axis(side = 4)
    mtext(ylab2, side = 4, line = 3, cex=0.7)
    lines(data2, col=col2)
    par(opar)
    ## Sekundaerachse Ende

    add_legend(-0.2,-0.95, lty = 1, col=lcols, legend = lnames, bty="n", horiz=TRUE, cex=1.1)

  }, height = 800, width = 1200)

})

