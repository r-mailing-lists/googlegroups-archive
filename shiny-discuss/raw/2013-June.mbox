      helpText("Recommend < 300"),

      sliderInput("edge_weight", "Shown edge weights:",
                  min = 5, max = 800, value = c(5, 800)),

      helpText("All edge weights below 5 were removed to provide
               more clarity."),

      actionButton("reseed", "Reseed")
    ),

    # output
    mainPanel(
        plotOutput("network"),
        textOutput("tab")
    )
))

########### Server #################
shinyServer(function(input, output) {
    # first generate the subnetwork
      gen.data <- reactive({
        input$reseed

        isolate({
          temp1 <- network.create(input$seed, network.n, thresh = input$size)
          net <- temp1$subnet
          dim(net)
          m <- length(union(net[,1], net[,2]))
          max.p <- max(max(net[,1]), max(net[,2]))
          A <- adj.mat(net[,1:2])
          del <- A$del
          g <- graph.adjacency(A$A)
          coords <- layout.spring(g)
#           return()
          list(coords = coords, subnet = net, max = max.p, m = m, del = del)
        })
      })

      # generate chosen plot
      output$tab <- renderText({
        tmp <- gen.data()
        head(tmp$coords)
      })

      output$network <- renderPlot({
        temp <- gen.data()
        net <- temp$subnet
        coords <- temp$coords
        max <- temp$max
        del <- temp$del
        counts <- net[,3]
        keep <- which(counts > input$edge_weight[1] & counts < input$edge_weight[2])
        subsubnet <- net[keep,]
        length(keep)
        A <- adj.mat(subsubnet[,1:2], max, empty=F)
        A <- A[-del[[1]], -del[[2]]]
        g <- graph.adjacency(A, mode="undirected")
        plot(g, layout = coords, vertex.label = NA, vertex.size= 3,
             edge.width = 0.5, edge.color = "red")
      })
  })

