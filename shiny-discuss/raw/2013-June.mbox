server.r portion:
 output$tablesx <- renderUI({
tables_output_listx <- lapply(1:copaN(), function(i) { #copaN being the total number of tables
tabname <- paste("tablex", i, sep="")
get(tabname) #this is my guess as to what to put here, it may just be tabname without get(), I am converting from plotOutput(tabname,height=480,width=850)

})
do.call(tagList,tables_output_listx)
})
for(i in 1:max_plots){
local({
my_i <- i
tablename <- paste("tablex", my_i, sep="")

output[[tablename]] <- renderPrint({
if(is.null(copaN()))
return()
if(is.null(normdat1()))
return()
if(is.null(probeAnno()))
return()

dat.rma=normdat1()
  Ann=probeAnno()
  Ann=Ann[intersect(rownames(Ann),rownames(dat.rma)),] # this is what would be printed

})
})
}
