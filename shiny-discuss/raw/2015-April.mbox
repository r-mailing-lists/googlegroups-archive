Hello,

I have a data table with different chromosomes.
I upload this dataTable in my program.
A plot displays according to a selectioned chromosome. So each chromosome has its own plot.
The user can click on the plot and the server can stock the (x,y) coordinates.
I would like to stock coordinates according to the chromosome and keep them in memory.

May someone help me ? :)
Than you !
Adrien

Here is a piece of my code, tou can easily copy/paste for testing :

#ui.R
library(shiny)
shinyUI(navbarPage("MareyMap online",
                   tabPanel("Step 1 : Data Selection",
                            fileInput("file", label = h3("or upload a data set"))
                   ),
                   tabPanel("Step 2 : Data Curation",
                            fluidRow(
                              column(4,
                                     uiOutput("chromSelector")
                              )
                            ),
                              plotOutput("graphePoints", width = "100%", height = "500px",clickId="Click")
                            )
                   ))

#server.R
library(shiny)
shinyServer(function(input, output) {
  dataInput <- reactive({
    inFile <- input$file
    if (is.null(inFile))
      return(NULL)
    read.csv(inFile$datapath, header = TRUE, sep = ' ', quote ='"')
  })
  output$table<-renderTable({
    dataInput()
  })
  listChrom <- reactive({
    a<-dataInput()
    l <- c()
    for (i in 1:length(a[,2])){
      l<-c(l,toString(a[i,2]))
    }
    l
  })
  output$chromSelector <- renderUI({
    chrom<-listChrom()
    selectInput("chromosome", "Choose a chromosome :", chrom )
  })
  setClass (
    Class="Chromosome",
    representation= representation(
      NomChromosome = "character",
      coordonneeX = "numeric",
      coordonneeY = "numeric"
    )
  )
  x<-reactiveValues(chrom=NULL)
  y<-reactiveValues(chrom=NULL)
  listeChrom<-c()
  # Expression that listens for clicks

  observe({
    # Initially will be empty
    if (is.null(input$Click)){
      return()
    }
    isolate({
      chrom<-input$chromosome

      print(paste("chrom : ",chrom))
      x$input$chromosome <- c(x$input$chromosome, input$Click$x)
      print(paste("x$input$chromosome : ",x$input$chromosome))
      y$chrom <- c(y$chrom, input$Click$y)
    })
  })
  # Expression that displays the plot
  clicInput <- reactive({
    b<-dataInput()
    c<-b[b$map==input$chromosome,"phys"]
    d<-b[b$map==input$chromosome,"gen"]
      plot(c,d, xlab = "Physical positions (b)", ylab = "Genetic distances (cM)")
  })

  output$graphePoints<-renderPlot({
    try(
      clicInput()
    )
  })
})

