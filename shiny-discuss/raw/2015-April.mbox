Hello,
You could use rbind instead of left_join :

#server.R
library(shiny)
shinyServer( function(input, output, session) {
  data1<-reactive({
    data.frame(loups=c(5,8,77,6),moutons=c(6,89,6,56))
  })
  data2<-reactive({
    data.frame(loups=c(5,8,9,6),moutons=c(90,89,6,56))
  })
  data.temp <- reactive({
    d1 <- data1()[1,]
    d2 <- data2()[c(1:2)]

    all <- rbind(d1, d2)

  })

  output$data<-renderTable({
    data.temp()
  })

}
)
# ui.R
library(shiny)
shinyUI(bootstrapPage(
 tableOutput("data")

))

Is that you want ?

