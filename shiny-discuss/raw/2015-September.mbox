            pb(nruns= input$runs ,n12.taguchi= FALSE ,nfactors= input$fac, ncenter= input$nc ,
         replications= input$nr ,repeat.only= FALSE ,randomize= rand ,seed= 13851,
         factor.names=names)
    })

 dz <- reactiveValues()
    observe({
      if(input$act==0)
        return()
      else
      if(!is.null(pbDesign()))
      isolate(
