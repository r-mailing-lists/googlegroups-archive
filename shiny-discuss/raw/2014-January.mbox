Hi Vincent,
  Yes, it's possiable and not difficult, just change the 'busy.js' to:

setInterval(function(){
  if ($('html').attr('class')=='shiny-busy') {
    setTimeout(function() {
      if ($('html').attr('class')=='shiny-busy') {
        $('div.busy').show()
      }
    }, 1000)

  } else {
    $('div.busy').hide()
  }
},100)

 Best!

Huidong

