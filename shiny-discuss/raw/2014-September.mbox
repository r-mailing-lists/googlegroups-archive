Ok, I got it. The following script does what I want:

server.R

library(shiny)
shinyServer(function(input, output) {

  output$ttable1 = renderTable({

    output$num_2_ui <- renderUI({

      num_2 <- ifelse(input$yes_or_no == 0, 0, input$num_2)

      numericInput("num_2", "Value num_2", value=num_2, min=0)
    })

    yes_or_no <-

input$yes_or_no
    num_2 <- input$num_2

    table1 <- data.frame(yes_or_no, num_2)
    print(t(table1))

  })
})

ui.R

library(shiny)

shinyUI(fluidPage(

  titlePanel("test"),

  sidebarLayout(
    sidebarPanel(
      uiOutput("num_2_ui"),

      radioButtons("yes_or_no", "Yes or No?", c("yes"=1, "no"=0), selected="no")

    ),

    mainPanel(
      uiOutput("ttable1")
    )
  )
))

