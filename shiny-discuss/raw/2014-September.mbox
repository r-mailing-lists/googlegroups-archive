value = 0.6,
step = 0.05),
dateInput("start",
"Start date:",
value = "2014-07-31",
format = "yyyy-mm-dd"),
dateInput("end",
"End date:",
value = now(),
format = "yyyy-mm-dd")
),

# Show a plot of the generated distribution
mainPanel(
uiOutput("solarplot_ui"),
ggvisOutput("solarplot")
)
))

