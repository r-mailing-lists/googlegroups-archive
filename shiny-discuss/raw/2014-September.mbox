Thanks! I was able to use that perfectly. Modified server script below:

shinyServer(function(input, output) {
  makeLink <- reactive({
    text <- NULL

    if(input$wiki){
      link <- "http://www.wikipedia.org/"
      text <- HTML(paste("Click Here for link <a href=", link, ">link</a>"))

    }
  })
  output$link <- renderText({
    makeLink()
  })
})

