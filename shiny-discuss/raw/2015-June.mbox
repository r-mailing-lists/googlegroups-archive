Solved this problem.. using inputs from Stackflow member..
Logic is listing the dataframes.. while inputing dataframes, they have to be listed..
Lot of material available in web on listing dataframes...

library(shiny)
shinyServer(function(input,output)
{
  output$data <-
    renderUI({
      res <- lapply(1:input$fnos, function(i) {fileInput(paste("file",i),"Load File",accept =c('text/csv',
              'text/comma-separated-values',
              'text/tab-separated-values',
              'text/plain','.csv','.tsv' ))})
      do.call(sidebarPanel,res)
    })

  output$multi <- renderTable({
    infile <- list(lapply(1:input$fnos, function(i) {input[[paste("file",i)]]}))[[1]]

    mm = list()

    for (i in 1:input$fnos)
      {

        mm[[i]] <- read.csv(infile[[c(i,4)]])
      }
    merged <- Reduce(merge, lapply(1:input$fnos, function(i) list(mm[[i]])))
  })
})
http://stackoverflow.com/questions/30921306/error-in-usemethodxtable

