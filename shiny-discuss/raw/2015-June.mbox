server.R

library(shiny)
library(wordcloud)
library(tm)

shinyServer(function(input, output) {

  datainput <- reactive({
    words <- Corpus(DirSource("temp/"))
    words <- tm_map(words, stripWhitespace)
    words <- tm_map(words, content_transformer(tolower))
