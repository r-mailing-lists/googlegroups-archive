> >       query <- parseQueryString(session$clientData$url_search)
> >       if (is.null(query[['plot']])) {
> >         show("inputsWindow")
> >       } else {
> >         show("plotWindow")
> >       }
> >     })
> >
> >     observeEvent(input$num, {
> >       values$num <- input$num
> >     })
> >
