Try this instead:

## app.R ##
library(shinydashboard)

ui <- dashboardPage(
  dashboardHeader(title = "Basic dashboard"),
  dashboardSidebar(),
  dashboardBody(
    # Boxes need to be put in a row (or column)
    fluidRow(

      box(textOutput("text1")),

      box(
        title = "Controls",
        sliderInput("slider", "X:", 1, 100, 50)
      )
    )
  )
)

server <- function(input, output) {

  df1 <- reactive({
    x <- input$slider
    data.frame(value1=x*x, value2=sqrt(x))
  })
  output$text1 <- renderText({
    paste("Value 1 is", df1()$value1)
  })
}

shinyApp(ui, server)

