I am having trouble with downloading data using DT with filtering the data - if I set rownames=TRUE as in the example below, then I get all NA, and if I set rownames=FALSE then I get an error with respect to joining tables
I have a reproducible example below and used shiny 0.12 and DT commit as specified below (version 0.65)
Any help would be appreciated

JJ

library(shiny)
library(data.table)
devtools::install_github('rstudio/DT', ref="baf3d924fda8d2859962461ae3554862b3c3323d")
library(DT)

Example <- data.table(runif(20),runif(20))
Example[, Category:=as.factor(ifelse(V1>0.5, "Republican", "Democrat"))]
setcolorder(Example, c("Category", "V1", "V2"))
setkeyv(Example, cols=c("Category", "V1"))

server <- function(input, output) {
  output$ExampleData <- DT::renderDataTable({
      DT::datatable(Example, filter = 'top', rownames = TRUE,
                    extensions = list('ColVis'),
                    options = list(dom = 'C<"clear">lfrtip', pageLength = 20, autoWidth = TRUE)) %>%
        formatPercentage(-1, 2)

  })

  output$downloadData <- downloadHandler(
    content = function(file) {
      write.csv(Example[input$ExampleData_rows_all, ], file)
    },
    filename = function() {
      'Example Data.csv'
    }
  )
}

ui <- fluidPage(fluidRow(
                  column(2,
                         downloadButton("downloadData", "Download Data")
                  ),

                  column(10,
                         tabsetPanel(
                           tabPanel("Data",
                                    DT:: dataTableOutput("ExampleData")
                           )
                         )
                  )))

shinyApp(ui = ui, server = server)

