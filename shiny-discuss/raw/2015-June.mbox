Here's an example:

library(shiny)

ui <- fluidPage(
  tags$style(type = "text/css",
    "label { font-size: 20px; }"
  ),
  h1("Heading 1"),
  h2("Heading 2"),
  radioButtons("option", "Choose an option", c(
    "Option 1" = "opt1",
    "Option 2" = "opt2",
    "Option 3" = "opt3"
  ))
)

server <- function(input, output, session) {
}

shinyApp(ui, server)

