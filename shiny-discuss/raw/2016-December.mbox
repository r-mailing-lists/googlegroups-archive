edLastMonth / 26) * 6) db.table.caplab$ParLevel <- ceiling(db.table.caplab$ParLevel) filterCapPlot <- reactive({ db.table.caplab.top20 <- head(arrange(db.table.caplab, desc(QtyDispensedMA)), n = input$ui.top) }) } # **PLOTS & TABLES** { myTheme1 <- theme(panel.background = element_rect(fill = 'lightgrey', color = 'lightgrey'), panel.grid.major = element_line(size = 0.5, linetype = 'solid', colour = "grey"), panel.grid.minor = element_line(size = 0.5, linetype = 'solid', colour = "grey"), legend.position = "none") # CAP PLOT & TABLE { output$capPlot <- renderPlot({ if(input$ui.show == "top" && input$ui.parlevel == TRUE){ myplot.p <- ggplot(filterCapPlot(), aes(y = QtyInStock, x = reorder(Name, -QtyInStock), color = QtyInStock > 0, fill = QtyInStock > 0)) nudgeMax <- max(pmax(db.table.caplab.top20$QtyInStock, db.table.caplab.top20$ParLevel)) myplot.p + geom_bar(stat = 'identity') + coord_flip() + labs(y = "Qty in Stock", x = "Drug", title = "Capsule Inventory") + scale_color_manual(guide = FALSE, values = setNames(c('black','black'),c(T, F))) + scale_fill_manual(values = c("TRUE" = "lightblue", "FALSE" = "firebrick")) + geom_errorbar(aes(y = ParLevel, x = Name, ymin = QtyInStock, ymax = ParLevel), color="darkred", width=0.5) + geom_text(aes(x = Name, y = nudgeMax + 100, label = QtyInStock)) + myTheme1 } else if(input$ui.show == "top" && input$ui.parlevel == FALSE){ myplot.p <- ggplot(filterCapPlot(), aes(y = db.table.caplab.top20$QtyInStock, x = reorder(db.table.caplab.top20$Name, -QtyInStock), color = db.table.caplab.top20$QtyInStock > 0, fill = QtyInStock > 0)) nudgeMax <- max(pmax(db.table.caplab.top20$QtyInStock, db.table.caplab.top20$ParLevel)) myplot.p + geom_bar(stat = 'identity') + coord_flip() + labs(y = "Qty in Stock", x = "Drug", title = "Capsule Inventory") + scale_color_manual(guide = FALSE, values = setNames(c('black','black'),c(T, F))) + scale_fill_manual(values = c("TRUE" = "lightblue", "FALSE" = "firebrick")) + geom_text(aes(x = Name, y = nudgeMax + 100, label = QtyInStock)) + myTheme1 }
})

