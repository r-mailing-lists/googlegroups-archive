library(shiny)

shinyServer(function(input, output) {

  inc <- reactive({input$yes + input$no + 1})

  i <- reactive({ifelse(inc() <= 26, inc(), -1)})

  add <- reactive({
    if (input$yes == 0) return(invisible())
