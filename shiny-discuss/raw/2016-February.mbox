library(shiny)
library(miniUI)

TSTAddin <- function() {

  ui <- miniPage(
    uiOutput('panelset')
  )

  server <- function(input, output, session) {

    output$Test <- renderUI(list(actionButton('Test','test'), helpText('AAAAA')))

    output$panelset <- renderUI({
      tabsetPanel(tabPanel('Pan1', uiOutput('Test'), helpText('BBBBB')))

    })
  }
  viewer <- paneViewer(300)
  runGadget(ui, server, viewer = viewer)
}
