This works for me:

library(leaflet)
library(shiny)

ui <- fluidPage(

  tags$style(type="text/css",
    "#mymap.recalculating { opacity: 1.0; }"),
  leafletOutput("mymap")

)

server <- function(input, output, session) {
  output$mymap <- renderLeaflet({
    Sys.sleep(4)
    invalidateLater(1000)
    leaflet() %>% addTiles()
  })
}

shinyApp(ui, server)

