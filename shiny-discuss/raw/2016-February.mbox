Digite o código aqui...rm(list = ls())
library(shiny)

ui =fluidPage(

  numericInput("num", label = h3('Number'), value = 1),
  uiOutput("res"),
  verbatimTextOutput("cont")
)

server = function(input, output, session) {

output$res <- renderUI({

  lapply(1:input$num, function(i){

    sliderInput(paste("a",i,sep = ""), paste("text",i), min=-100, max=100, value=0)

  })

})

out.14<-reactive({

    a.1<-"input$a1"

    for(i in 2:input$num){

      a.1<-cbind(a.1,paste("input$a",i,sep = ""))

    }

   a.2<-as.vector(sapply(a.1, function(x)get(x)))

  IS<-a.2%*%a.2

  return(IS)
})

output$cont<- renderPrint({
  out.14()
})

}
runApp(list(ui = ui, server = server))

