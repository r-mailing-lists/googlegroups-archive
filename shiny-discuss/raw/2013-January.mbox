Thanks for the follow-up Winston. Joe helped me to setup datasets in my app so they can be changed and the changes shown immediately throughout the app. He suggested setting a new.env() and putting all datasets into that environment. With the new reactiveValues function that doesn't seem to be required anymore. Below a (slightly) simplified version of the code in question. The user runs a regression and then wants to append residuals to the dataset. The observe function carries this out when the user clicks a button (linked to input$saveres). The residuals get added when I use data that is in a package (e.g., the car package) or data like mtcars, rock, etc. However, with data loaded by the user (see loadUserData) it does not. This worked with reactiveValue but not with reactiveValues(). If you need more information please let me know or see https://github.com/mostly-harmless/damshiny/  (the reactiveValues branch).

main.regression <- function(state) {
formula <- paste(state$var1, "~", paste(state$var2, collapse = " + "))

lm(formula, data = getdata())
}

regression <- reactive(function() {
if(is.null(input$var2)) return("Please select one or more independent variables")
main.regression(as.list(input))
})

observe(function() {
if (input$saveres == 0) return()
isolate(
changedata(regression()$residuals, "residuals")
)
})

changedata <- function(addCol = NULL, addColName = "") {
# function that changes data as needed
if(is.null(addCol) || addColName == "") return()
  # We don't want to take a reactive dependency on anything
  isolate(
   values[[input$datasets]][[addColName]] <- addCol
  )
}

getdata <- function(dataset = input$datasets) {
  values[[dataset]]
}

loadUserData <- function(uFile) {

# filename <- uFile$name
ext <- file_ext(uFile)
objname <- robjname <- sub(paste(".",ext,sep = ""),"",basename(uFile))
ext <- tolower(ext)

if(ext == 'rda' || ext == 'rdata') {
# objname will hold the name of the object inside the R datafile
 objname <- robjname <- load(uFile)
values[[robjname]] <- get(robjname)
}

if(datasets[1] == 'choosefile') {
datasets <<- c(objname)
} else {
datasets <<- unique(c(objname,datasets))
}

if(ext == 'csv') {
values[[objname]] <- read.csv(uFile)
}
}

loadPackData <- function(pFile) {

robjname <- data(list = pFile)
values[[robjname]] <- get(robjname)
datasets <<- unique(c(robjname,datasets))

}

