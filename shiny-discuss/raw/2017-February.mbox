  dashboardBody(

    # <---use tabBox--->
    tabBox(tabPanel("Main1",

                    tabsetPanel(
                      tabPanel("tab1","TAB1"),
                      tabPanel("tab2","TAB2")
                    )),
           tabPanel("Main2",textOutput("text")))

  )

)

