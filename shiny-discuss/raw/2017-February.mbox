   function (session, input, output){

    output$str <- renderTable({

      inFile <- input$file1

      if (is.null(input$file1))
        return(NULL)

      ## reactive value to read the csv file in ----------
      ABC_Input <- reactive({
        req(input$file1)
        data.frame(read.csv(input$file1$datapath))
      })

      ## observe input$file1 to update the input$rev_col ------------
      observeEvent(input$file1,{
        updateSelectInput(session,
                          inputId = "rev_col",
                          choices = names(ABC_Input()))
      }
      )

            #updateSelectInput(session, "rev_col", "rev_col", choices = colnames(ABC_Input))
      # same logic here
      updateSelectInput(session, "units_col", "units_col", choices = colnames(ABC_Input))

      ## Data_new as reactive (could be used in other chuncks)---------------
      Data_new <- reactive({
        req(input$rev_col)
        # now ABC_Input is reactive, so you need to call ABC_Input()
        Data_new <- ABC_Input()[order(ABC_Input()[input$rev_col], decreasing = T),]
        # Create cumsum variable

        Data_new$Rev_CumSum = cumsum(Data_new()[input$rev_col])

        #Create Percentages of CumSum
        Data_new$Percent_Rev_Cum <- Data_new$Rev_CumSum / sum(Data_new[input$rev_col])

        return(Data_new)
      })

      # #Create new sorted table
      # Data_new <- ABC_Input[order(ABC_Input$paste(input$rev_col) , decreasing = T),]
      # #Create cumsum variable
      # Data_new$Rev_CumSum = cumsum(Data_new$paste(input$rev_col))
      #
      # #Create Percentages of CumSum
      # Data_new$Percent_Rev_Cum <- Data_new$Rev_CumSum / sum(Data_new$paste(input$rev_col))

      #Create cumsum variable for sold units
      Data_new()[Units_CumSum] = cumsum(Data_new()[Units.Sold])

      #Create Percentages of CumSum
      Data_new()[Percent_Units_Cum] <- Data_new()[Units_CumSum] / sum(Data_new()[Units.Sold])

      # Create ABC-column
      Data_new()[ABC_Assign] <- "Stop"

      # Assign ABC-values & skip errors if there's no category assignment
      try(expr=Data_new()[which(Data_new()[Percent_Rev_Cum]<=input$value_A),]$ABC_Assign <- "A", silent=TRUE)
      try(expr=Data_new()[which(Data_new()[Percent_Rev_Cum]<=(input$value_A+input$value_B) & Data_new() [Percent_Rev_Cum]>(input$value_A)),]$ABC_Assign <- "B", silent=TRUE)
      try(expr=Data_new()[which(Data_new()[Percent_Rev_Cum]<=1 & Data_new()[Percent_Rev_Cum]>(input$value_A+input$value_B)),]$ABC_Assign <- "C", silent = TRUE)

      #Manipulate ABC-Values, so that first assignment upon threshold still belongs to last category
      Data_new()[ABC_Assign] [(max(which(Data_new()[Percent_Rev_Cum]<=input$value_A, arr.ind = T)))+1] <- "A"
      Data_new()[ABC_Assign] [(max(which(Data_new()[Percent_Rev_Cum]<=(input$value_A+input$value_B), arr.ind = T)))+1] <- "B"
      DownloadTable<<- Data_new ()

      output$plot <- renderPlot({

        if (is.null(input$file1))
          return(NULL)
        plot (x=Data_new()[Percent_Units_Cum],   Data_new()[Percent_Rev_Cum], type="o", xlab ="Cumulated percentage of units sold", ylab="Cumulated percentage of revenue", yaxs="i", xaxs="i")
        abline(h=input$value_A)
        abline(h=input$value_B+input$value_A)
        })

      output$plot2 <- renderPlotly({

        plot_ly(x = Data_new()[Percent_Units_Cum], y= Data_new()[Percent_Rev_Cum])
      })

      if(input$error=="Run"){
        return(Data_new())
      }
      else
      {
        return("ERROR")
      }

       })

    output$downloadData <- downloadHandler(
      filename = function() {
        paste("data-", Sys.Date(), ".csv", sep="")
      },
      content = function(file) {
        write.csv(DownloadTable, file)
      }
    )

     #Download code for plot
       output$ABC_image <- downloadHandler(
       filename =  function() {
         #paste("ABC_Analysis", input$plottype, sep=".")
         paste ("TestDL.png")
       },

       content = function(file) {
         if(input$plottype == "png")
           png(file, width=700, height = 400) # open the png device
           #plot (x=Data_new$Percent_Units_Cum,   Data_new$Percent_Rev_Cum, type="o", xlab ="Cumulated percentage of units sold", ylab="Cumulated percentage of revenue", yaxs="i", xaxs="i")
            #dev.off()
         else
           jpeg(file, width=700, height = 400) # open the pdf device

         plot (x=Data_new()[Percent_Units_Cum],   Data_new()[Percent_Rev_Cum], type="o", xlab ="Cumulated percentage of units sold", ylab="Cumulated percentage of revenue", yaxs="i", xaxs="i")

         dev.off()  # turn the device off
         }
         )

     #download code for plotly image -> NOT WORKING YET
     output$plotly_image <- downloadHandler(
       filename =  function() {
         #paste("Plotly_Image", input$plottype, sep=".")
         paste ("Plotly.png")
       },

       content = function(file) {
         if(input$plottype == "png")
           png(file, width=700, height = 400) # open the png device

         else
           jpeg(file, width=700, height = 400) # open the pdf device

         #SOMETHING'S NOT WORKING HERE => DOWNLOAD DOES NOT WORK
         plot_ly(x = Data_new()[Percent_Units_Cum], y= Data_new()[Percent_Rev_Cum])

         dev.off()  # turn the device off
       }
     )

  }
)

