gsub("\\r(?=\n)","","SAFER\r\nLines",perl = T) # if you want to keep \n
[1] "SAFER\nLines"

gsub("\r\n"," ","SAFER\r\nLines") # if it's always \r\n
[1] "SAFER Lines"

# or any other expression ....

