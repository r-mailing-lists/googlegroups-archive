      addTiles('http://{s}.tiles.mapbox.com/v3/jcheng.map-5ebohr46/{z}/{x}/{y}.png <http://tiles.mapbox.com/v3/jcheng.map-5ebohr46/%7Bz%7D/%7Bx%7D/%7By%7D.png>')

