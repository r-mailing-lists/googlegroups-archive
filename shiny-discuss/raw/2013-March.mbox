server.R

library(shiny)
library(googleVis)

shinyServer(function(input, output) {

  output$cn <- renderUI( {
    s = '中文测试'
    HTML(s)
  })

  output$gvis1 <- renderGvis({
    tmp = data.frame(cname=c("中文一","中文二"),ename=c("en1","en2"),count=c(15,20),stringsAsFactors=F)
    namestring = "ename"
    titlestring = "Count"
