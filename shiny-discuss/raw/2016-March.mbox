One of my friend shows me how to have all css parameters of each element of a web page !!

So AMAZING !! I manage to have access to the css of the body and to reduce the padding !!

Thank you so much my friend !!!

Here is the code for the next people :

library(shiny)
library(shinydashboard)

ui <- dashboardPage(
  dashboardHeader(),
  dashboardSidebar(
    sidebarMenu(
      menuItem("A"),
      menuItem("B")
    )
  ),
  dashboardBody(

    tags$style(HTML("
                    .content{
                    padding-left: 0px;
                    padding-top:0px;
                    }
                    ")),

        tags$head(tags$style(HTML('
                                  .skin-blue .main-sidebar {
                                  background-color: #666666;
                                  }
                                  .skin-blue .sidebar-menu>li.active>a, .skin-blue .sidebar-menu>li:hover>a {
                                  background-color: #444444;
                                  }
                                  ')))
    ,

    div(width = 12, style = "background-color: #666666;top:0;height:200px",
        "Box content"
    )

    )
    )

server <- function(input, output) {}

shinyApp(ui, server)

