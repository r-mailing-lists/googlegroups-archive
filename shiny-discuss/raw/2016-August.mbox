I'am not sure, but I guess the HTML page does not find the javascript file message-handler.js (maybe it needs to stored in the www subdirectory). However, following  <http://stackoverflow.com/questions/26003978/shiny-and-javascript-interaction-with-sessionsendcustommessage>Shiny and JavaScript interaction with session$sendCustomMessage <http://stackoverflow.com/questions/26003978/shiny-and-javascript-interaction-with-sessionsendcustommessage> you could use a modified code a la

library(shiny)
runApp(
  list(ui = fluidPage(
       tags$head(tags$script('Shiny.addCustomMessageHandler("testmessage",
         function(message) {
           alert("The b variable is " + message.b);
         }
         );')),

       actionButton("do", "Click Me")
      )

    , server = function(input, output, session){

        observeEvent(input$do, {
            session$sendCustomMessage(type = 'testmessage',

                                      message = list(a = 1, b = 'text',
                                                     controller = input$controller))
        })
    })
)

