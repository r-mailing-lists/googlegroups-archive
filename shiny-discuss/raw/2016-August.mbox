Hi,

just manipulate the HTML output of radioButtons, e.g.

library(shiny)

myRadioButtons <- function(){
    buttons <- radioButtons("radio", label = h3("Radio buttons"),
                            choices = list("Choice 1"=1, "Choice 2"=2, "Choice 3"=3),
                            selected = 1)
    buttons <- gsub('<span>Choice 1</span>', '<span><font color="red">Choice 1</font></span>', buttons, fixed=T)
    buttons <- gsub('<span>Choice 2</span>', '<span><font color="blue">Choice 2</font></span>', buttons, fixed=T)
    buttons <- gsub('<span>Choice 3</span>', '<span><font color="green">Choice 3</font></span>', buttons, fixed=T)
    HTML(buttons)
}

ui <- fluidPage(
        myRadioButtons(),
        hr(),
        fluidRow(column(3, verbatimTextOutput("value")))
)

server <- function(input, output){
    output$value <- renderPrint({ input$radio })
}

shinyApp(ui, server)

Best Sigbert

