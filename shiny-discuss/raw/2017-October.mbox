        )

server <- function(input, output) {

     output$table1 <- renderDataTable({
        dt <- datatable(mtcars, escape=FALSE, selection = 'none') %>% formatStyle(0, cursor = 'pointer')
      })

     observe({
        List <- input$table1_rows_current
        List <- createLink(List)
         return(List)
     })

}

shinyApp(ui, server)

