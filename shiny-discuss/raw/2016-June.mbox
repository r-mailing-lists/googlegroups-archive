All right, this is super-hacky, and might not be applicable to you depending on how easy it is to write the loop as a function.
It is extremely likely that there is a simpler, smarter way of doing it but I had great fun doing it.
Also, note the used of the evil "<<-" assignment.

Since input$ values are updated only when all reactive() elements have completed, I do the infinite loop by updating a dummy selectInput, which will trigger the next loop. Ideally, this selectInput should be hidden, for example using shinyjs::hide <https://github.com/daattali/shinyjs> or any other method you want.
I leave it displayed here for clarity.

# ui.R
library(shiny)

shinyUI(fluidPage(sidebarLayout(
    sidebarPanel(

        actionButton("startSearch", label = "Start Search"),

        actionButton("stopSearch",  label = "Stop Search"),
        selectInput("loopIter", label = "(hide this input)", choices = c(0))
    ),
    mainPanel(
        textOutput("myText"),
        textOutput("myResults")
    )
)))Saisissez le code ici...

# server.R
library(shiny)

shinyServer(function(input, output, session){

    # can you write one loop as function?
    runLoopOnce <- function() {
        Sys.sleep(0.2)
        return(1)
    }

    # results from loop will be stored there
    resultList <- list()

    # initialistation of variables, updated with <<-
    start <- 0
    stop <- 0
    iter <- 0

    # we manage start of the loop here
    myReactive1 <- reactive({
        if(input$startSearch > start) {
            iter <<- as.numeric(input$loopIter) + 1 # , Reactive, so will run each time loopIter is updated
            resultList[[iter]] <<- runLoopOnce() # we run the loop once
            updateSelectInput(session, "loopIter", choices = c(iter)) # loopIter is udated, will re-run again, infinite loop \o/
        }
        return(iter)
    })

    # we manage stop of the loop here
    myReactive2 <- reactive({
        if(input$stopSearch > stop) {
            start <<- input$startSearch
            stop <<- input$stopSearch
            return(iter) # we stop the loop without calling myReactive1, hence without updating loopIter
      } else {
            return(myReactive1())
        }
    })

    # display number of iteration
    output$myText <- renderText({
        paste("Loop has runned", myReactive2(), "time(s).")
    })

    # display the reslut, a nice list of ones
    output$myResults <- renderText({
        input$loopIter
        paste(unlist(resultList), collapse = " ")
    })
})

