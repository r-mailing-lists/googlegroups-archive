This line does not change the value of
Try this instead (untested, typos likely):
    Age<-reactive({
      df1 <- Update_df1()
      for(id in unique(df1$Site_ID)){
        lm.Age<- try(nlsLM(NEP~offset + A*(1-exp(k*Stand_Age)), data = df1[ df1$Site_ID != id,],
                           start = list(A=  711.5423, k= -0.2987, offset= -444.2672),

                           lower= c(A = -Inf, k =  -Inf, offset= -1500), control = list(maxiter = 500), weights = 1/Uncert), silent=TRUE);

        df1$f_Age[df1$Site_ID == id] <- predict(object = lm.Age, newdata =  df1[df1$Site_ID == id,])
        }%>% as.data.frame()
    })

