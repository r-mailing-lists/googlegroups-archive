      query <- as.numeric(paste0(query[1],query[2], query[3]))
      matches <- subset(tetragram_dt, trigram_int == query, select = word)[[1]]
      if (!FALSE %in% (query_tokens[2:3] %chin% names(uni_dict)) && length(matches) < 3){
