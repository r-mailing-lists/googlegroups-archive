library(shiny)
library(leaflet)

ui <- fluidPage(
  leafletOutput("mymap")
)

server <- function(input, output, session) {
  output$mymap <- renderLeaflet({
    leaflet() %>% addTiles()
  })

  observeEvent(input$mymap_bounds, {
    print("Bounds changed")
  })
}

shinyApp(ui, server)

