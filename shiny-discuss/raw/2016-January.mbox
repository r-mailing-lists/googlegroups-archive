        return(read.maimages(files = targets$FileName,
                      path = "Raw data/",
                      columns=list(G=input$RawProbe, Gb=input$RawBack, R=input$RawProbeR,Rb=input$RawBackR))
        )
        }else if(input$imageS == "Other" & input$datatype == "Two" & input$RawCBack == "N"){
