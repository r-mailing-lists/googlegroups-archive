Okay, the whole construction looks like this:

ui.R:

    mainPanel(

        tabsetPanel(id = "tabs",
            tabPanel("Proportions",  value = "props",
                conditionalPanel(condition = "input.checkvarselect",
                    uiOutput("props.select")
                )
            )
        )
    )

server.R:

    output$props.select             <- renderUI({

        conditionalPanel("input.checkfile",
             wellPanel(
                 h5("Please select the targeted proportions for each variable:"),
                    div(class = "row offset1",
                        conditionalPanel(n.vars() > 0,
                         div(class = "span3", wellPanel(
                             selectInput("var1propselect", "Select variable:",
                                         give.varnames(), give.varnames()[1]),
                             selectInput("var1valueselect",
                                         "Select target value:",
                                          as.list(give.valuelabels()[[
                                              selected.order()[1]]])),
                             sliderInput("var1propslider",
                                         "Set proportion range:",

                                         0,1,value = c(0,1),step = steps1(),
                                         animate=FALSE),
                             checkboxInput("smallsteps1", "use 0.01 steps"),

                             helpText("__________________________"),
                             selectInput("var1proplink",

                                         "Interlock variable (optional):",

                                         c(list("none"),give.varnames())),
                             sliderInput("var1weightslider",
                                 "Set relative weight of variable (optional):",
                                 0,1,value = 1,step = 0.01,animate=FALSE))
                         )),

                    ))
        )
    })

