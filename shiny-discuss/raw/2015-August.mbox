I am trying to build up a model selection tool, where the user enters the data and the regression equation, and based on the variables entered in the equation, multiple plots are rendered dynamically. What I want next is a checkbox next to those plots, so that user have the option to decide which plots can be there on the next tab for further analysis. I have attached the image that I am looking for:

Below code is for generating multiple plots only, I could not figure out how to even get started with this. Can anyone please help me?

shinyUI(pageWithSidebar(

 headerPanel("Dynamic number of plots"),

  sidebarPanel(
#user can upload any data file for the analysis
   fileInput("file","Please upload your file"),
   checkboxInput(inputId='header', label='header', value=TRUE),
   checkboxInput(inputId="stringsAsFactors", label="stringsAsFactors", value=FALSE),
   radioButtons(inputId='sep',label='Separator', choices=c(Comma=',', Semicolon=';',Tab='\t',Space=''), selected=',')
   ),

mainPanel(

   textInput("Model", label = "Please enter your model ", value = ""),
   actionButton("goButton", "Click to proceed"),
   plotOutput("plots")

)
 ))

 shinyServer(function(input, output) {

 #get data file
 data<-reactive({
    file1<-input$file
    if(is.null(file1)){return()}
     read.table(file=file1$datapath, sep=input$sep, header=input$header,stringsAsFactors=input$stringsAsFactors)
   })

 #model formula entered by the user
 model <- eventReactive(input$goButton, {
    input$Model
  })

  #parsing of model variables
  variables<-reactive({
       if(is.null(model()))
         {
            return()
         }
      else
         {
          all_vars<-all.vars(parse(text=model()))
          dependent<-all_vars[1]

          #variables on right hand side of the equation after ~
          fixed_vector <- all_vars[-1]

          return(list(dependent, fixed_vector))
         }
        })

  #rendering multiple plots based on model formula
   output$plots <- renderPlot({
           dependent<-variables()[[1]]
           fixed_vector<-variables()[[2]]
           length_fixed<-length(fixed_vector)

         p<-list()

         for (i in 1:length_fixed)
         {
        #multiple ggplots based on variables entered by the user in the model formula
         p[[i]]<-ggplot(data(), aes_string(y=dependent, x=fixed_vector[i]))+geom_point()
          }

    #using grid.arrange to display multiple plots
       do.call("grid.arrange", c(p, list(ncol=1)))
     })

    })

