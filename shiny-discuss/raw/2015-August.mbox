Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

I found a solution.

runApp(list(
  ui = fluidPage(
    actionButton("create", "create"),
    actionButton("load", "load")
  ),
  server = function(input, output) {

    data = reactiveValues(temp = NULL)

    observe({

      input$create

      if (input$create!=0) {data$temp <- "create"}

    })

    observe({

      input$load

      if (input$load!=0) { data$temp <- "load"}

    })

    currentProject <- reactive({

      input$create
      input$load

      data$temp

    })

    observe({
      input$create
      input$load
      print(currentProject())
    })
  }
))

It could be helpful !

Cheers !!!

