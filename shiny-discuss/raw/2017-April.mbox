        sliderInput("slider1","Número de Observações em Anos:",1,55,30 ,)),
      box(plotOutput("plot1", height = 300))

    ),

    fluidRow(
      box(
        title = "Taxa de Desemprego (em 31 dez)",height = 175,width = 3,
        sliderInput("slider2","Número de Observações em Meses:",1,144,30)),
      box(plotOutput("plot2", height = 300))

    ),

    fluidRow(
      box(
        title = "Taxa de câmbio - Livre -
        Dólar americano (venda) diário -R$/US$ (em 31/dez)",height = 175,width = 3,
        sliderInput("slider3","Número de Observações em Dias:",1,365,30)),
      box(plotOutput("plot3", height = 300))

    ),
    fluidPage(
      fluidRow(
        box(
          title = "Meta Selic definida pelo Copom - % a.a. (em 31 dez)",
          height = 175,width = 3, sliderInput("slider4","Número de
                                              Observações em Dias:",1,365,30)),
        box(plotOutput("plot4", height = 300))
          ),

      fluidRow(
        box(
          title = "Saldo da carteira de crédito em relação ao PIB,
          em % do PIB (em 31/dez)",
          height = 175,width = 3, sliderInput("slider5","Número de
                                              Observações em Meses:",1,120,30)),
        box(plotOutput("plot5", height = 300))
          ),

      fluidRow(
        box(
          title = "Rendimento médio real efetivo das pessoas ocupadas",
          height = 175,width = 3, sliderInput("slider6","Número de
                                              Observações em Meses:",1,120,30)),
        box(plotOutput("plot6", height = 300))
          ),
      fluidPage(
        fluidRow(
