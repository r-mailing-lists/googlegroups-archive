How about this?

library("shiny")
library("datasets")
library("DT")
library("shinyBS")

ui <- fluidPage(

  DT::dataTableOutput("mtcarsTable"),
  bsModal("mtCarsModal", "My Modal", "",
    textOutput('mytext'), size = "small")
))

on_click_js = paste0(
  "Shiny.onInputChange('mydata', '%s');",

  "$('#mtCarsModal').modal('show')"

)

convert_to_link <- function(x, n) {
  as.character(tags$img(
    src = paste0("http://www.gstatic.com/webp/gallery/", n, ".jpg"),
    height = "50px",
    onclick = sprintf(on_click_js,x)))
}

server <- function(input, output, session) {
  mtcarsLinked <- reactive({
    mtcars$mpg <- mapply(convert_to_link, datasets::mtcars$mpg, 1:5)
    mtcars

  })

  output$mtcarsTable <- DT::renderDataTable({
    DT::datatable(mtcarsLinked(),
      class = 'compact',
      escape = FALSE, selection = 'none'
    )
  })

  output$mytext <- renderText({
    sprintf('mpg value is %s', input$mydata)
  })
}

shinyApp(ui, server)

