##############################################################
#########     Servidor do Usuário(Input, Output)      ########
##############################################################

servidor <-  function(input, output) {

  output$plot1 <- renderPlot({
    plotdata <- as.character(P)
    data <- plotdata[seq_len(input$slider1)]
    plot(data,type = "l", col = "orange", main =
           "Taxa de Variação Real no Ano (PIB)", xlab = "Período Anual"
         , ylab = "Taxa de Variação do PIB")

    output$plot2 <- renderPlot({
      plotdata2 <- as.character(O)
      data2 <- plotdata2[seq_len(input$slider2)]
      plot(data2,type = "l", col = "blue", main = "Taxa Mensal de Desemprego",
           xlab = "Período Mensal", ylab = "Taxa de Desemprego")

      output$plot3 <- renderPlot({
        plotdata3 <- as.character(N)
        data3 <- plotdata3[seq_len(input$slider3)]
        plot(data3,type = "l", col = "red", main = "Taxa de câmbio - Livre - Dólar americano (venda) diário -R$/US$ (em 31/dez)",
             xlab = "Período Diário", ylab = "Taxa de Câmbio do Dólar(Venda")

        output$plot4 <- renderPlot({
          plotdata4 <- as.character(M)
          data4 <- plotdata4[seq_len(input$slider4)]
          plot(data4,type = "l", col = "brown", main = "Meta Selic definida pelo Copom - % a.a. (em 31 dez)",
               xlab = "Período Diário", ylab = "Meta Selic Copom")

          output$plot5 <- renderPlot({
            plotdata5 <- as.character(L)
            data5 <- plotdata5[seq_len(input$slider5)]
            plot(data5,type = "l", col = "pink", main = "Saldo da carteira de crédito em relação ao PIB,  em % do PIB (em 31/dez)",
                 xlab = "Período Mensal", ylab = "Saldo de Carteira de Crédito PIB")

            output$plot6 <- renderPlot({
              plotdata6 <- as.character(j)
              data6 <- plotdata6[seq_len(input$slider6)]
              plot(data6,type = "l", col = "black", main = "Rendimento médio real efetivo das pessoas ocupadas",
                   xlab = "Período Mensal", ylab = "Rendimento Médio")

              output$plot7 <- renderPlot({
                plotdata7 <- as.character(k)
                data7 <- plotdata7[seq_len(input$slider7)]
                plot(data7,type = "l", col = "purple", main = "Índice nacional de preços ao consumidor-amplo (IPCA)",
                     xlab = "Período Mensal", ylab = "Índice Nacional de Preços")

              })
            })
          })
          })
      })
    })
    })
  }

shinyApp(Interface, servidor)

