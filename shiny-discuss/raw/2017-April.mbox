> > > >
> > > > Rscript -e 'library(methods); shiny::runApp("shinyapp/",
> > > > launch.browser=TRUE)'
> > > >
> > > > or
> > > >
> > > > R --slave --no-restore -e 'shiny::runApp("shinyapp/", launch.browser=TRUE)'
> > > >
> > > >
