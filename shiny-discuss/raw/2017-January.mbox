My code is below.

Thank you.

server.R

library(shiny)
library(sf)
library(leaflet)
options(shiny.maxRequestSize=30*1024^2)
# use the below options code if you wish to increase the file input limit, in this example file input limit is increased from 5MB to 9MB
# options(shiny.maxRequestSize = 9*1024^2)

shinyServer(function(input,output){

  # This reactive function will take the inputs from UI.R and use them for read.table() to read the data from the file. It returns the dataset in the form of a dataframe.
  # file$datapath -> gives the path of the file

  data <- reactive({
    file1 <- input$file
    if(is.null(file1)){return()}
    st_read(file1$datapath)
  })

  # this reactive output contains the summary of the dataset and display the summary in table format
  output$filedf <- renderPlot({
    if(is.null(data())){return ()}
    plot(data)
  })

  output$map <- renderLeaflet({
    leaflet(data())  %>% addTiles() %>%
      addPolygons()
  })

  # the following renderUI is used to dynamically generate the tabsets when the file is loaded. Until the file is loaded, app will not show the tabset.
  output$tb <- renderUI({
      tabsetPanel(tabPanel("About file", plotOutput("filedf")),
                  tabPanel("Map", leafletOutput("map")))
  })
})

ui.R

library(shiny)
shinyUI(fluidPage(
  titlePanel("File Input"),
  sidebarLayout(
    sidebarPanel(
      fileInput("file","Upload the file", multiple=TRUE), # fileinput() function is used to get the file upload contorl option
      helpText("Default max. file size is 5MB"),
      tags$hr()
    ),
    mainPanel(
      uiOutput("tb")
    )

  )
))

