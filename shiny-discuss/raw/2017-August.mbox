This is effectively the same code without modules. Oddly, this also didn't perform quite like expected (clicking the "Edit" button caused no response), but errors were quite rare.

Note that without modules, the code below reads a bit contrived. I wouldn't necessarily use the interim variable of "edit_complete" in this case.

library(shiny)

ui <- fluidPage(
  sidebarLayout(
    sidebarPanel(
        actionButton("edit", "Edit")
      , h4("Edit requested: ")
      , textOutput("txt_edit_requested")
    ),
    mainPanel(
        conditionalPanel(
            condition = paste0("output['txt_edit_requested']=='TRUE'")

          , h1("Edit a widget")
          , textInput("txt_widget", "widget: ")
          , actionButton("btn_cancel", "Cancel")
          , actionButton("btn_save", "Save")

        )
      , h4("Edit module state: ")
      , textOutput("edit_module_state", inline = TRUE)

    )
  )
)

server <- function(input, output, session) {

  edit_requested <- reactiveVal(FALSE)

  user_action <- reactiveVal(character(0))
  edit_complete <- reactive({
    length(user_action()) != 0
  })

  observe({
    if (edit_requested()) {
      user_action(character(0))

    }
  })

  # This observer does not appear to work reliably.
  # Sometimes it will fire, other times it won't.
  observe({

    if (edit_complete()) {

      edit_requested(FALSE)
    }
  })

  observeEvent(input$edit, {
    edit_requested(TRUE)
  })

  observeEvent(input$btn_cancel, {
    user_action("Cancel")
  })

  observeEvent(input$btn_save, {
    user_action("Save")
  })

  output$txt_edit_requested <- renderText({
    edit_requested()
  })

  output$edit_module_state <- renderPrint({
    list(
      user_action(),
      edit_complete()
    )
  })

}

shinyApp(ui, server)

