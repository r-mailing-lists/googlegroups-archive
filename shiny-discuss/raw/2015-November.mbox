>              )
>       ),
>
>     #creates rows and columns for graphs
>
>   conditionalPanel(
>   condition="input.GraphNum=='One'",
>     fluidRow(
>       column(10,div(style = "height:auto;background-color: green;", "GraphOne"),
>       plotOutput("GraphThree"))
>       )),
>
>
>   conditionalPanel(
