Dropdownsc <- test$servicecategory
Dropdownbrand <- test$brand
Dropdownpos <- test$pos

shinyUI(fluidPage(
  titlePanel("Self Serve HQ Dashboard"),

  # Create a new Row in the UI for selectInputs
  fluidRow(
    column(4,
           selectInput("servicecategory",
                       "Service Category:",
                       c("All",
                         unique(as.character(Dropdownsc))))
    ),
    column(4,
           selectInput("brand",
                       "Brand:",
                       c("All",
                         unique(as.character(Dropdownbrand))))
    ),
    column(4,
           selectInput("pos",
                       "Point of Sale:",
                       c("All",
                         unique(as.character(Dropdownpos))))
    )
  ),
  # Create a new row for the table.
  fluidRow(
    dataTableOutput(outputId="hq")
  )
)
)

