Also, you don't need to set dom = 'myChart' in your chart generating code. Here is code that I tested and it works

require(rCharts)
require(shiny)
runApp(list(
  ui =  pageWithSidebar(

    headerPanel("Title"),
    sidebarPanel("MyApp" ),
    mainPanel(
      tabsetPanel(
        tabPanel("Interactive Map", mapOutput("myChart"))
      )
    )

  ),
  server = function(input, output){

    output$myChart <- renderMap({
      map3 <- Leaflet$new()
      map3$setView(c(19.4329,- 99.1331), zoom = 8)
      map3

    })
  }
))

