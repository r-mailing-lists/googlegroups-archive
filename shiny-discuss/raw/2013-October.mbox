Sorry Elodie this is simpler like my first proposal since only one of the two UIs should appear, then you don't need a dyanmic UI and you can type:

SERVER.R:

mydata <- reactive(){
  data = myfunction()

   ...
}
#
dataOK <- reactive({
  dat <- mydata()
  ....

  if(failed condition){
    return("failed")
  }
  else{
    return("OK")
  }
})
#
output$dataFAILED <- renderPrint({

   test <- datOK()
   if(test=="OK") return(NULL)
   return("Information message : choice not available")
})
#
output$tableACorr <- renderTable({
  test <- dataOK()
  if(test=="failed")  return(NULL)
  data <- mydata()

  data_sort <- data[order(data[,3],decreasing=FALSE),]
  head((data_sort),n=15)
},include.rownames=FALSE)

UI.R :

textOutput("dataFAILED")
tableOutput("tableACorr")

