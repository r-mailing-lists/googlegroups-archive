It looks like you may have forgot parentheses when accessing the reactive expressions and by quoting the values of "b" prior to storing them in a data.frame R converted the values to factors.  The code below worked for me, I made no changes to the ui file.

library(data.table)
library(shiny)
library(stats)
shinyServer(function(input, output) {
  a<-c("A","B","C","D","E","F","G")
  b<-c(10,20,30,40,50,60,70)

  ab<-data.frame(a,b, stringsAsFactors = F)

  a<-c("A","B","C","D","E")
  input_vector<-reactive({
    c(input$first,input$second,input$third,input$fourth,input$fifth)
  })
  newdata<-reactive({

    data.frame(a,input_vector(), stringsAsFactors = F)

  })
  merged_data<-reactive({
    merge(newdata(),ab,by.newdata=a)
  })
  mutated_data<-reactive({
    library(dplyr)

    merged_data() %>%
      mutate(newvalue=input_vector()*b)

  })
  output$mytable<-renderTable({
    input$mybutton
    isolate(mutated_data())
  })

})

