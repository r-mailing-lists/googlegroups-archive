Here is a highly minimalized concept of what I’m trying to achieve.  A loop, within the server that can update the display in the shiny dashboard.

library(shiny)

ui <- fluidPage(

    # Application title

     titlePanel("My Test"),

    # Start Sim

    actionButton(inputId = "start",

                label = "Start"),

    # Display status

     mainPanel(

          htmlOutput("f0")

     )

)

# Define server logic

server <-  function(input, output, session) {

    observeEvent(input$start, {

        for (i in 1:10) {

            output$f0 <- renderText({

                paste("Number: ", runif(1,1,10))

            })

            invalidateLater(1000, session)

        }

     })

}

# Run the application

shinyApp(ui = ui, server = server)

