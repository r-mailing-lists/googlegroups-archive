Another alternative can be to use shinyjs::onevent() to detect when enter/tab is pressed

library(shiny)
library(shinyjs)

ui <- fluidPage(
  useShinyjs(),
  textInput("text", "Enter text and hit Enter or Tab")
)

server <- function(input, output, session) {
  onevent("keydown", "text", function(event) {
    if (event$keyCode == 13) {
      cat("Enter ")
      cat(input$text, "\n")
    }
    if (event$keyCode == 9) {
      cat("Tab ")
      cat(input$text, "\n")
    }
  })
}

shinyApp(ui = ui, server = server)

But I would recommend Joe's commandInput because it's more consistent with shiny's design by using a real input where reactivity is built into the input

