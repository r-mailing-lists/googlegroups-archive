> > > > >
> > > > > Here's an example:
> > > > >
> > > > >
> > > > > library(shiny)
> > > > >
> > > > > ui <- fluidPage(
> > > > >   sidebarLayout(
> > > > >     sidebarPanel(
> > > > >       uiOutput("ui1"),
> > > > >       uiOutput("ui2")
> > > > >     ),
> > > > >     mainPanel(
> > > > >       verbatimTextOutput("result")
> > > > >     )
> > > > >   )
> > > > > )
> > > > >
> > > > > server <- function(input, output, session) {
> > > > >
> > > > >   progress <- Progress$new(session)
> > > > >   progress$set(message = "Please wait...")
> > > > >
> > > > >   output$ui1 <- renderUI({
> > > > >     Sys.sleep(3)
> > > > >     numericInput("x", "x", 5)
> > > > >   })
> > > > >
> > > > >   output$ui2 <- renderUI({
> > > > >     req(input$x)
> > > > >     Sys.sleep(3)
> > > > >     numericInput("y", "y", input$x * 2)
> > > > >   })
> > > > >
> > > > >   output$result <- renderPrint({
> > > > >     req(input$x, input$y)
> > > > >
> > > > >     if (!is.null(progress)) {
> > > > >       progress$close()
> > > > >       progress <<- NULL
> > > > >     }
> > > > >
> > > > >     input$x * input$y
> > > > >   })
> > > > > }
> > > > >
> > > > > shinyApp(ui, server)
