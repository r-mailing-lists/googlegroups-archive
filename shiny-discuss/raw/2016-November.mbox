> > > >     numericInput("x", "x", 5)
> > > >   })
> > > >
> > > >   output$ui2 <- renderUI({
> > > >     req(input$x)
> > > >     Sys.sleep(3)
> > > >     numericInput("y", "y", input$x * 2)
> > > >   })
> > > >
> > > >   output$result <- renderPrint({
> > > >     req(input$x, input$y)
> > > >
> > > >     if (!is.null(progress)) {
> > > >       progress$close()
> > > >       progress <<- NULL
> > > >     }
> > > >
> > > >     input$x * input$y
> > > >   })
> > > > }
> > > >
