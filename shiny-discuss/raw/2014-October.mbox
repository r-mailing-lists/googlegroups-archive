I have created a short demo app that illustrates the problem I asked in the first post.  And as you see, CairoPNG functions correctly, so it is not a broad Cairo issue.  Can anyone duplicate my issue?
ui.R
#######################################
require(shiny)
shinyUI(pageWithSidebar(
 headerPanel("Demo of CairoPDF Download issue"),
  sidebarPanel(
  HTML("Choose a download type"),
  wellPanel(
    downloadButton('downloadPlotpdf', label = "Download as PDF"),
    br(),
    downloadButton('downloadPlotpng', label = "Download as PNG"),
    br(),
    downloadButton('downloadPlotcpng', label = "Download as Cairo PNG"),
    br(),
    downloadButton('downloadPlotcpdf', label = "Download as Cairo PDF")
    ),
  HTML("On my testbed, only the CairoPDF approach does not work")
  ),
 mainPanel(
    plotOutput("histPlot")
    )
))
#######################################
server.R
#######################################
require(shiny)
require(Cairo)

# Define server logic required to generate and plot a random distribution
shinyServer(function(input, output) {
data(faithful)
makeplot <- function(){
  hist(faithful$eruptions)
}
output$histPlot <- renderPlot({
  makeplot()
  })
output$downloadPlotpng <- downloadHandler(
  filename = function() { paste0("test1.png") },
  content = function(file1) {
    png(file1)
    makeplot()
    dev.off()
  })
output$downloadPlotcpng <- downloadHandler(
  filename = function() { paste0("test1.png") },
  content = function(file1) {
    CairoPNG(file1)
    makeplot()
    dev.off()
  })
output$downloadPlotpdf <- downloadHandler(
  filename = function() { paste0("test1.pdf") },

  content = function(file1) {
    pdf(file1)
    makeplot()
    dev.off()
  })

output$downloadPlotcpdf <- downloadHandler(
  filename = function() { paste0("test1.pdf") },

  content = function(file1) {
    CairoPDF(file1)
    makeplot()
    dev.off()
  })

})

