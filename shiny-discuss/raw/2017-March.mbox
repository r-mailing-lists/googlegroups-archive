    #numericInput("test","test",30),

    uiOutput("TestColumns")
  ),
  server <- function(input, output) {

    data_set <- mtcars

    output$TestColumns <- renderUI({
      L<-vector("list",length(names(data_set)))
      for(i in names(data_set)){
        L[[i]]<-numericInput(i, i,30)
      }
      return(L)
    })})

