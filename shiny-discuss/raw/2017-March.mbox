server<-function(input, output, session) {
  library(plyr)
  library(dplyr)
  library(arules)

  library(plotly)
  transactions_todos<-data.frame(YEAR=c(2010,2011,2012,2013,2014,2010,2011,2012,2013,2014),
                                 STORE=c("STORE_1","STORE_2","STORE_3","STORE_4","STORE_5","STORE_1","STORE_2","STORE_3","STORE_4","STORE_5"),
                                 CUSTOMER=c("VIP","HIGH VALUE","BRONCE","SILVER","GOLD","VIP","HIGH VALUE","BRONCE","SILVER","GOLD"),
                                 CATEGORY=c("TABLE","COOKING","TABLE","COOKING","TABLE","TABLE","COOKING","TABLE","COOKING","TABLE"),
                                 ITEM=c("TRUE","FALSE","TRUE","FALSE","FALSE","TRUE","FALSE","TRUE","FALSE","FALSE"),
                                 ITEM1=c("TRUE","FALSE","FALSE","FALSE","FALSE","TRUE","FALSE","FALSE","FALSE","FALSE"),
                                 ITEM2=c("TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE"),
                                 ITEM3=c("FALSE","FALSE","FALSE","FALSE","TRUE","FALSE","FALSE","FALSE","FALSE","TRUE"),
                                 ITEM4=c("TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE"),
                                 ITEM5=c("TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE"),
                                 ITEM6=c("TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE"),
                                 ITEM7=c("TRUE","FALSE","FALSE","TRUE","FALSE","TRUE","FALSE","FALSE","TRUE","FALSE"),
                                 ITEM8=c("FALSE","FALSE","TRUE","TRUE","FALSE","FALSE","FALSE","TRUE","TRUE","FALSE"),
                                 ITEM9=c("TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE"),
                                 ITEM10=c("TRUE","FALSE","TRUE","TRUE","FALSE","TRUE","FALSE","TRUE","TRUE","FALSE"))

  for(i in 1:ncol(transactions_todos)){transactions_todos[,i]<-as.factor(transactions_todos[,i])}
    tableData <- reactive({
    df<-filter(transactions_todos, YEAR==input$anio & STORE==input$tienda & CUSTOMER==input$cliente & CATEGORY==input$categoria)
    tr<-as(df,"transactions")
    reglas_todos<-apriori(tr, parameter = list(minlen=2,maxlen= input$maxlg, maxtime=10,supp = input$soporte, conf = input$confianza,target = "rules"))
    reglas_todos<- subset(reglas_todos, subset = lift > 1)
    reglas_todos<-reglas_todos[!is.redundant(reglas_todos, measure="lift")]
    reglas_todos<-sort(reglas_todos, by=c("lift", "supp"))

    if(input$filtro1 == 'Filtrar'){
      varsL <- character()
      for(i in 1:length(input$opcs)){
        tmp <- with(transactions_todos, paste(input$opcs[i]))
        varsL <- c(varsL, tmp)
