Sure, for example, this extracts the commonalities in tabPanel/plotOutput:

graphTab <- function(tabName, outputId) {
  tabPanel(
    plotOutput(outputId, width = 1200, 700)
  )

}

shinyUI(
  fluidPage(
     titlePanel(),

     sidebarLayout(
        sidebarPanel(
           textInput(),
           textInput(),
           textInput(),
           actionButton(),
           uiOutput("chooseDatabases")
                    ), #sidebarPanel() end parantheses

        mainPanel(
           tabsetPanel(

                  graphTab("", "graph1"),
                  graphTab("", "graph2"),
                  graphTab("", "graph3"),
                  graphTab("", "graph4"),
                  graphTab("", "graph5"),

                  tabPanel("",
                           verbatimTextOutput(""),
                           verbatimTextOutput(""),
                           verbatimTextOutput("")
                          ),
                  tabPanel("Table",
                           tableOutput("Table1"),
                           tableOutput("Table2"),
                           tableOutput("Table3"),
                           tableOutput("Table4"),
                           tableOutput("Table5")
                           )
                       )#tabsetPanel() end parantheses
                )#mainPanel() end parantheses
            )#sidebarLayout() end parantheses
       )#fluidPage() end parantheses
   )#shinyUI() end parantheses

