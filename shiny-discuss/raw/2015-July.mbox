##server.r

library(shiny)
library(leaflet)
library(rgdal)

shinyServer(function(input, output,session) {

output$carte<-renderLeaflet({
  if(is.null(input$degre)){return()}
  data<-reactive({
    switch(input$degre,
           "Jardin"=jardin,
           "Primaire"=primaire,
           "Collège"=college,
           "Lycée"=lycee)
  })
 couleur<-switch(input$degre,
           "Jardin"="tomato",
           "Primaire"="skyblue",
           "Collège"="limegreen",
           "Lycée"="steelblue")

 leaflet(carto)%>%addTiles()%>%
