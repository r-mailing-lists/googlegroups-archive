Thanks for weighing in, Amber. I'd tweak your example a bit to avoid defining output$plot1 inside of an observer (it's not a hard and fast rule, the way avoiding defining outputs inside a reactive <https://groups.google.com/d/msg/shiny-discuss/iKwTnEsEACk/UEPPJWNjmuIJ> is, but I personally prefer defining outputs once when possible):

library(shiny)
library(DT)

library(ggplot2)
shinyApp(
  ui = fluidPage(
    textInput("textT", label = h5("Title"), value = ""),
    textInput("textX", label = h5("X Axis Label"), value = ""),
    actionButton("Btn", "", "push me"),
    plotOutput('plot1')),
  server = function(input, output) {

    v <- reactiveValues(clearPlot = TRUE)

    output$plot1 = renderPlot({
      if (v$clearPlot)
        return()
      else

        ggplot(mtcars, aes(x= gear, y= carb)) + geom_line() +ggtitle(input$textT) + xlab(input$textX)
    })

    observeEvent(c(input$textT, input$textX), {
      v$clearPlot <- TRUE
    }, priority = 10)
    observeEvent(input$Btn, {
      v$clearPlot <- FALSE
    }, priority = 10)

  }
)

