# V helpu za subset piše, da zavrže NA:

#For ordinary vectors, the result is simply x[subset & !is.na <http://is.na>(subset)].

# Tako je tole čisto kratko

subset(airquality, Ozone<10)

# tale ukaz pa ohrani tudi NA

subset(airquality, Ozone<10|is.na <http://is.na>(Ozone))

# Pri vas poskusite:

sub1<-subset(Gnezda,fazprop!="jajca"|is.na <http://is.na>(fazprop))

Andrej

