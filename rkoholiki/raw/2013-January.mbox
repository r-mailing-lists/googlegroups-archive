MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Na tem majhnem primeru tole deluje:

ursa <- read.table(text = "ID    osebek

1        4_1
1        4_1
2        4_1
2        4_1
3        4_2
3        4_2
3        4_2
4        4_2
4        4_2
5        4_2

5        4_2", header = TRUE)

out <- do.call("rbind", by(data = ursa, INDICES = ursa$osebek, FUN = function(x) {
  x[x$ID == min(x$ID), ]
}))
out

      ID osebek
4_1.1  1    4_1
4_1.2  1    4_1
4_2.5  3    4_2
4_2.6  3    4_2
4_2.7  3    4_2

Če ti imena vrstic niso všeč, jih lahko poradiraš z rownames(out) <- NULL

lp,
Roman

