Uff, to je pa enga pisanja. :) Tule je R skripta, ki pobere s strani vse PDF-je.

library(rvest)
x <- read_html("http://r.psylab.info/library/")
get.pdfs <- html_nodes(x, "a.uri") %>% html_text()

pdfs <- get.pdfs[grepl("\\.pdf", x = get.pdfs)]

sapply(pdfs, FUN = function(m) {
  sp <- unlist(strsplit(m, split = "/"))
  download.file(url = m, dest.file = sp[grepl("pdf", sp)])
})

lp,
Roman

