     "<div dir=\"ltr\"><div class=\"gmail_default\" style=\"font-family:&#39;trebuchet ms&#39;,sans-serif\">Uff, to je pa enga pisanja. :) Tule je R skripta, ki pobere s strani vse PDF-je.</div><div class=\"gmail_default\" style=\"font-family:&#39;trebuchet ms&#39;,sans-serif\"><br></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">library(rvest)</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">x &lt;- read_html(&quot;<a href=\"http://r.psylab.info/library/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://r.psylab.info/library/&amp;source=gmail&amp;ust=1793237159499000&amp;usg=AOvVaw1g_6eQ3b8dlif4pRIdKxSd\">http://r.psylab.info/library/</a>&quot;)</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">get.pdfs &lt;- html_nodes(x, &quot;a.uri&quot;) %&gt;% html_text()</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\"><br></font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">pdfs &lt;- get.pdfs[grepl(&quot;\\\\.pdf&quot;, x = get.pdfs)]</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\"><br></font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">sapply(pdfs, FUN = function(m) {</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">  sp &lt;- unlist(strsplit(m, split = &quot;/&quot;))</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">  download.file(url = m, dest.file = sp[grepl(&quot;pdf&quot;, sp)])</font></div><div class=\"gmail_default\"><font face=\"monospace, monospace\">})</font></div><div class=\"gmail_default\"><font face=\"trebuchet ms, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"trebuchet ms, sans-serif\">lp,</font></div><div class=\"gmail_default\"><font face=\"trebuchet ms, sans-serif\">Roman</font></div></div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
