     1,
     "\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n<p class=\"MsoNormal\">\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n</p><p class=\"MsoNormal\">hi,</p><p class=\"MsoNormal\">can anyone see where I went wrong?<br></p>I get the message: &quot;Error: unexpected symbol&quot; when I try to run:\n\n<p class=\"MsoNormal\"> </p>\n\n<p class=\"MsoNormal\">for(i in 1:nrow(wh)) {tozero &lt;- !<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792448701166000&amp;usg=AOvVaw0-L0pWlzt731LI9OSz2xn8\">is.na</a>(g[wh[i,1],]) &amp;\n!<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792448701166000&amp;usg=AOvVaw0-L0pWlzt731LI9OSz2xn8\">is.na</a>(g[wh[i,2],]) &amp; g[wh[i,1],] != g[wh[i,2],]\nAll_q50C50$geno[[1]]$data[wh[i,1],tozero] &lt;- NA} <br></p><p class=\"MsoNormal\"><br></p><p class=\"MsoNormal\">thanks<br></p><p class=\"MsoNormal\">roberta<br></p>\n\n\n\n\n\n\n\n\n\n\n\n"
    ]
   ]
