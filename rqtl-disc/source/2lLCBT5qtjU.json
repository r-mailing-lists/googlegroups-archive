    [
     2,
     "\r<br>for(i in 1:nrow(wh)) {\r<br>  tozero &lt;- !<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792448701167000&amp;usg=AOvVaw0cDdoPLshBeA1ONBRgDmcU\">is.na</a>(g[wh[i,1],]) &amp; !<a href=\"http://is.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1792448701167000&amp;usg=AOvVaw0cDdoPLshBeA1ONBRgDmcU\">is.na</a>(g[wh[i,2],]) &amp; g[wh[i,1],] != g[wh[i,2],] \r<br>  All_q50C50$geno[[1]]$data[wh[i,1],tozero] &lt;- NA\r<br>} \r<br>\r<br>"
