qtl.brix <- makeqtl(mydata_reduced, chr=c(6), pos=c(53.5),what=c("prob"))

plot(qtl.ph <http://qtl.ph>, justdots=FALSE, col="red")
plot(qtl.sd1, justdots=FALSE, col="orange")
plot(qtl.sd2, justdots=FALSE, col="yellow")
plot(qtl.biomass, justdots=FALSE, col="green")
plot(qtl.DTF, justdots=FALSE, col="blue")
