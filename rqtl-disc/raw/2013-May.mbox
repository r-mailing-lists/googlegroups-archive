From u96353e7106735838 at groups.google.com  Fri May 17 18:11:00 2013
From: u96353e7106735838 at groups.google.com (Karl Broman)
Date: Fri, 17 May 2013 18:11:00 +0000
Subject: Re: [Rqtl-disc] Running CIM with multiple phenotypes
Message-ID: <GWVMZUA2Aq0.kw30cbcvoyUJ@rqtl-disc.groups.google.com>
In-Reply-To: <GWVMZUA2Aq0.8fdjoO4l6gYJ@rqtl-disc.groups.google.com>
References: <GWVMZUA2Aq0.QCia4YI-RsEJ@rqtl-disc.groups.google.com> <GWVMZUA2Aq0.8fdjoO4l6gYJ@rqtl-disc.groups.google.com>
Archived-At: <https://groups.google.com/g/rqtl-disc/c/GWVMZUA2Aq0/m/kw30cbcvoyUJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Something like this:

data(fake.bc)
n.orig.phe <- nphe(fake.bc)
n.new.phe <- 1000
fake.bc$pheno <- cbind(fake.bc$pheno,
                       matrix(rnorm(nind(fake.bc)*n.new.phe),
                              ncol=n.new.phe))
fake.bc <- calc.genoprob(fake.bc, step=2.5)

library(parallel)
RNGkind("L'Ecuyer-CMRG")
mc.cores <- detectCores()

cim4parallel <- function(phe, ...) cim(pheno.col=phe, ...)

result <- mclapply(1:n.new.phe + n.orig.phe, cim4parallel, cross=fake.bc,
                   method="hk", n.marcovar=5, window=25, imp.method="imp",
                   mc.cores=mc.cores)

