get.ests is an argument to fitqtl(), not to makeqtl().

qtl <- makeqtl(I_80_fam3_QTL, chr=c(3,5),pos=c(37.3, 189.2))
out.fq <- fitqtl(I_80_fam3_QTL, qtl=qtl,formula=y~Q1+Q2,get.ests=TRUE)
summary(out.fq)

karl

