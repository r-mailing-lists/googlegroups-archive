Playing around with glm() and logLik(), it looks to me like it's giving the real log likelihood, and not the deviance (which I think would be 2*log lik).

  # rather ugly code follows
  x <- c(0,0,0,0,1,1,1,1)
  y <- c(0,0,1,1,0,0,0,1)

  out0 <- glm(y ~ 1, family=binomial())
  out1 <- glm(y ~ x, family=binomial())

  logLik(out0)
  p0 <- mean(y)
  ll0 <- log(p0^(sum(y)) * (1-p0)^(sum(1-y)))

  p1 <- tapply(y, x, mean)
  # this is especially ugly
  ll1 <- log(p1[1]^sum(y*(1-x)) * (1-p1[1])^sum((1-y)*(1-x)) *
             p1[2]^sum(y*x) * (1-p1[2])^sum((1-y)*x))
  logLik(out1)

karl

