Another option is to use the plotting function from R/qtl2.

  library(qtl)

  data(hyper)
  hyper <- calc.genoprob(hyper, step=1)
  out <- scanone(hyper)

  library(qtl2)
  library(qtl2convert)
  out2 <- scan_qtl_to_qtl2(out)
  plot(out2$scan1, out2$map)

karl

