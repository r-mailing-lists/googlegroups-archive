Message-ID: <ZTmTIKjIc4E.M8hjBeGKPkAJ@rqtl-disc.groups.google.com>
In-Reply-To: <ZTmTIKjIc4E.YdxydNgOz4sJ@rqtl-disc.groups.google.com>
References: <ZTmTIKjIc4E.YdxydNgOz4sJ@rqtl-disc.groups.google.com>
Archived-At: <https://groups.google.com/g/rqtl-disc/c/ZTmTIKjIc4E/m/M8hjBeGKPkAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Use the "perm.strata" argument in "scanone," for example as follows.

# regular genome scan without stratified permutations
out <- scanone(hyper,n.perm=1000)
# create strata according to genotyping intensity
extremes <- (nmissing(hyper)/totmar(hyper) < 0.5)
# permute within strata according to strata defined above
operm.strat <- scanone(hyper, n.perm=1000,perm.strata=extremes)

Saunak

