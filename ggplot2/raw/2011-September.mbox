DeepwaterOil_latlon <- c(lon = -89.5, lat = 29.0)
DeepwaterMap <-ggooglemap(center = DeepwaterOil_latlon, zoom = 8)

hdtmap<-qplot(lon, lat, data = DeepwaterMap, geom = 'tile', fill =
fill) +
  scale_fill_identity() +
  scale_x_continuous('Longitude') +
