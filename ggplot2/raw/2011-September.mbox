    type = c('color','bw')[1], rgbcoefs = c(0, 1, 0), zoom = 10,
maptype = 'terrain',
    destfile = 'DeepwaterTemporaryMap.jpg', n_pix = 640)
{
  require(ggplot2)
  require(RgoogleMaps)
  require(ReadImages)

  GetMap(center = center[c('lat','lon')], size = c(n_pix, n_pix), zoom
= zoom,
    format = 'jpg', maptype = maptype, destfile = destfile)

  # load map
  map <- read.jpeg(destfile)

  # deal with color
  if(type == 'color'){
    map <- apply(map, 1:2, function(v) rgb(v[1], v[2], v[3]))
  } else if(type == 'bw') {
 }

  # reshape map for plotting
  m_map <- melt(map)
  names(m_map) <- c('x','y','fill')
  m_map <- within(m_map,{
    x <- x - n_pix/2 - 1
    y <- y - n_pix/2 - 1
  })

  mapInfo <- list(lat = center['lat'], lon = center['lon'], zoom =
zoom, map)

  # geocode pixel references
  s <- (-n_pix/2) : (n_pix/2 - 1)
  lat_wrapper <- function(x) XY2LatLon(mapInfo, -n_pix/2, x)[1]
  lats <- apply(data.frame(s), 1, lat_wrapper)
