It looks like if you run the exact same code, but take out the kern="rect" argument, they produce the same line. So it may be that the kern argument isn't getting passed correctly when the model is built in stat_smooth.

# packages
require(locfit)

# sim data
set.seed(123)
n=1000
y=rbinom(n,1,0.5)
x=runif(n)
data=data.frame(x,y)

# fit model

model <- locfit(y~lp(x,h=0.2),data=data,family="binomial",link="logit")

xrange <- range(data$x)
xseq <- seq(from=xrange[1], to=xrange[2], length=80)
pred <- predict(model, newdata = data.frame(x = xseq), se=TRUE)
y_hat = pred$fit
data.locfit=data.frame(x=xseq,y=y_hat)

ggplot(data,aes(x=x,y=y)) +
  stat_smooth(method="locfit",formula = y~lp(x,h=0.2),family="binomial",link="logit") +
  geom_line(data=data.locfit,aes(x=x,y=y)) +
  ylim(0,1)

