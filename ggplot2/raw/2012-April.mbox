Hi Manuel:

geom_step() is your friend here. Try this:

x <- c(0,235,280,365)
y <- c(1,0.94,0.89,0.89)
li <- c(1,0.85,0.77,0.77)
ls <- c(1,1,1,1)

DF <- data.frame(x = x, y = y, li = li, ls = ls)
library('ggplot2')
ggplot(DF, aes(x = x)) +
    geom_step(aes(y = li), linetype = 'dashed') + geom_step(aes(y = y)) +
    geom_step(aes(y = ls), linetype = 'dashed') +  ylim(0, 1)

Dennis

