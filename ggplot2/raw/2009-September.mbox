Hi,

Does this produce what you want?

library(ggplot2)
tmp <- melt(data.frame(cbind(t,b,x,y)),meas=c("x","y"))
head(tmp)

ggplot(tmp, aes(x=t,y=b,groups=variable)) +
facet_wrap(~variable) +
geom_path(aes(y=b,colour=factor(value))) +
labs(x=NULL,y=NULL)

HTH,

baptiste

