Since you already have two separate plots you could use the grid.arrange function
from the gridExtra package.
Something like this:
library(gridExtra)
a <- qplot(main="Title1",ylim=yrange,xlim=xrange)+xlab("x label")+ylab("y label")+

  geom_point(data=TimeSeries1,aes(x=day,y=value,colour="Series1"),size=1.0)+
  scale_colour_manual("Values",c("Series1" =
"blue"))+opts(legend.position="right")

  b <- qplot(main="Title2",ylim=yrange,xlim=xrange)+xlab("x label")+ylab("y label")+

  geom_point(data=TimeSeries2,aes(x=day,y=value,colour="Series1"),size=1.0)+
  scale_colour_manual("Values",c("Series2" =
"red"))+opts(legend.position="right")

grid.arrange(a,b)

Alternatively, you can melt your data and then use either facet_grid() or facet_wrap()

