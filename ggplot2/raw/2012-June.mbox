Content-Transfer-Encoding: 8bit

Hi Ista.

The text looks fine but something's wrong with the "segment". This code fails to draw the first segment using annotate but doesn't fail to execute.  I tried reversing the order of the end-points but it made no difference.

p2 = ggplot(E, aes(Salinity, dO18, color=Site))
p2 + geom_point(size=3) +

#     annotate("segment", x=34.8, xend=33.80, y=0.0, yend= -0.3, colour="black") +
     annotate("segment", x=33.8, xend=34.80, y=-0.3, yend= 0.0, colour="black") +

     geom_segment(xend= 5.00, x=34.8, yend=-17.0, y = 0.0, show_guide=F, linetype=2, color="red") +
     geom_segment(xend=34.42, x=34.8, yend= -0.3, y = 0.0, show_guide=F, linetype=1, color="blue") +
     xlim(min(C$Salinity),max(C$Salinity)) + ylim(min(C$dO18),max(C$dO18)) +
     ylab(expression(paste(delta,{}^18*"O ("^o*"/"[oo]*")"))) + xlab('Salinity (psu)') +

     annotate("text",x=34.47,y=-0.08,label="Upper Circumpolar Deep Water -->", color="black", angle=37, size = 3) +
     annotate("text",x=34.09,y=-0.44,label="<-- Iceberg fragment \n dO18 = -17, Salinity = 5.0", angle=57, size = 3, color="red") +
     annotate("text",x=34.53,y=-0.25,label="Ambient", angle=65, size = 3, color="blue") +
     annotate("text",x=34.20,y=-0.25, label="<--- Melting   Freezing --->", size = 3, color = "black") +

     stat_smooth(method="loess")  +
     scale_colour_manual("Site",values=c("C18A"="black","Far-field"="magenta"))

Cheers.
