Yes, sorry, I realize what you're saying now. It's still not parsing the ^ into an exponent. If you look at the guts, I don't see where it's being told to parse it as an expression at all.

> tf <- trans_format("log10", math_format())

> tf(10 ^ 1:6)
[[1]]
10^`1`

[[2]]
10^`0.9542425`

[[3]]
10^`0.90309`

[[4]]
10^`0.845098`

[[5]]
10^`0.7781513`

> trans_format
function (trans, format = scientific_format())

{
    if (is.character(trans))
        trans <- match.fun(trans)
    function(x) {
        x <- trans(x)
        format(x)
    }
}
<environment: namespace:scales>

> math_format

function (expr = 10^.x, format = force)
{
    quoted <- substitute(expr)
    subs <- function(x) {
        do.call("substitute", list(quoted, list(.x = as.name <http://as.name>(x))))

    }
    function(x) {
        x <- format(x)
        llply(x, subs)
    }
}
<environment: namespace:scales>

