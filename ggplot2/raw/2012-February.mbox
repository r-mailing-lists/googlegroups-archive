Here's the best I've managed so far for a work-around, but it isn't
too pretty ...
Simon

library(ggplot2)
library(grid)
p1 <- ggplot(df) +

  geom_violin(aes(cat, x, fill=cat)) +
  opts(legend.background=theme_rect())

p1g <- ggplot_gtable(ggplot_build(p1))
p1g$grobs[p1g$layout$name == "guide-box"][[1]]$children[[1]]
$children[[1]]$width <- unit(1.25, "npc")
p1g$grobs[p1g$layout$name == "guide-box"][[1]]$children[[1]]
$children[[1]]$height <- unit(1.1, "npc")
grid.draw(p1g)

