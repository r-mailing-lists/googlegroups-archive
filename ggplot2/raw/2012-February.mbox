z <- data.frame(var=rep(LETTERS[1:3],each=5),
                y = c(outer(1:5,c(0.001,0.1,1))),
                x = rep(letters[1:3],each=5))
library(ggplot2)
ggplot(z,
       aes(x=x,y=y))+
  geom_point()+facet_grid(.~var,scale="free_y")+
  coord_flip()

