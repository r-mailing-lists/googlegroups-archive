Does this help?

n <- 5

df <- data.frame(
  x = rnorm(3*n),
  y = rnorm(3*n),
  c = factor(
    rep(c('a','b','c'), each = n),
    levels = c('a','b','c')
  )
)

ggplot(aes(x = x, y = y), data = df) +
  geom_point() +
  facet_grid(facets = c ~ .)

df$c <- factor(df$c, levels = c('a','c','b'))

ggplot(aes(x = x, y = y), data = df) +
  geom_point() +
  facet_grid(facets = c ~ .)

david.

