hi,

without warranty to work in future:

m <- ggplot(movies, aes(x=rating)) +  geom_histogram(binwidth = 0.5)

ob <- m + facet_wrap(~ mpaa)
dp <- ggplot_build(ob)$data
dp[[1]][,]

