Hi,

this is half in jest,

d <- data.frame(expand.grid(a=1:2,b=1:2,c=1:2),x=rnorm(8), y=rnorm(8))

p <- ggplot(d, aes(x, y)) + facet_grid(a~b) + geom_point() +
