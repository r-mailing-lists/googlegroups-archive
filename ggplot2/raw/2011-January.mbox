#set-up and plot median line
stat_sum_single <- function(fun, geom="point", ...) {
     stat_summary(fun.y=fun, colour="black", geom=geom, size =
0.5, ...)
   }
plot_sim_mean <- plot_sim + stat_sum_single(mean, geom="line")

#add real data
