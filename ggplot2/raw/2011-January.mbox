This is not an elegant solution, but you could simply do this, reordering day by the column 'order':

result <- data.frame(day = c("Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"),

count = c(56260, 56814, 63163, 52629, 48006, 32809, 39459),

order = seq(1:7))

ggplot(result, aes(reorder(day, order), count)) +

geom_bar()

