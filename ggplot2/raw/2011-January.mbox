Here is one way;

dfm$D <- "D1"
dfm$D[grep("D2", dfm$variable)] <- "D2"

ggplot(dfm, aes(variable, value)) + geom_point() + facet_grid(Sex

~Drug) + stat_summary(fun.y = mean, geom="line", aes(group=D))

