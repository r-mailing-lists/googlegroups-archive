gpturb<-gp + geom_line(data=dat,aes(x=ReadingDateTime,y=Turbidity), color="black")+ ylab("Turbidity (NTU)") +

  opts(axis.title.y = theme_text(size=12, angle=90))

windows()

print(gpturb)

