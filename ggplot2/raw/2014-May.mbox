MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

In addition:

ggplot(tst, aes(x, y)) +
   geom_point() +
   geom_text(data = tst[which.max(tst$y), ], aes(label = z),
                vjust = -1)

# In case you have multiple maxima,
ggplot(tst, aes(x, y)) +
   geom_point() +
   geom_text(data = tst[tst$y == max(tst$y), ], aes(label = z),
                vjust = 1)

Dennis

