Thanks, Both work :) Can I extend the problem a bit.

I want to plot a vertical line indicating mean on each of the sub plots.

>> Attempt

#### Dummy Data ----
n = 500 # no of sample in each dist
n.d = 3 # no of dist
kind = c(LETTERS[1:n.d])
color.1 = "#7777DD"
color.2 = "#CC6666"
color.3 = "#ccbe66d1"
v.col = c(color.1,color.2,color.3)

df.1 <- data.frame(kind=rep(kind, each=n), x=c(rnorm(n, 1), rbeta(n, 1,1), runif(n)), my.col = rep(v.col,each=n))

df.mean = ddply(df.1,.(kind),summarise,my.mean=mean(x))

#### `````````````````````````````````````````````````````

####  Main ----
l.1 = dlply(df.1,.(kind))

# Plot Function
fn.1 = function(df)
{
  ggplot() +

    geom_density(aes(x=x,fill=my.col), data=df, binwidth=0.2, position="identity", alpha=0.3) +
    geom_vline(aes(xintercept=my.mean),data=df.mean,linetype="dashed", size=0.5)

}

# Plots
my.plots = llply(l.1,fn.1)
#### `````````````````````````````````````````````````````

