Just need to name them the same... in your code you only renamed color to "Season", you just needed to do the same for Shape. Also, if you put theme_bw() after you change some elements, it overwrites them, but if you put it after it overwrites the defaults found in theme_bw().

HTH,
B

ggplot(season, aes(x = outcome, y = pinc,ymin = lcinc, ymax = ucinc, group=cat,color=cat,shape=cat))  +

geom_point(position=position_dodge() ,size = 4) +
geom_linerange(position=position_dodge(), size =0.7) +
geom_hline(aes(yintercept = 0))  +

scale_x_discrete("Outcome", labels = c("ami" = "AMI","cardva" = "CV", "dysrhy" = "Dysrhythmia", "heartf" = "Heart Failure","ischem" = "IHD")) +

labs(colour="Season", shape="Season", y="Percent Increase", x="") +
theme_bw()+

theme(axis.title=element_text(face="bold",size="14",color="brown"),axis.text=element_text(size=16,face="bold"))

