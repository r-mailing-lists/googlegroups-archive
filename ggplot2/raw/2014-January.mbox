In the case of simulated data, you could potentially do it this way. I am not sure how your specific data are though.

# Base R versions
n= 500
set.seed(123)

x = rnorm(n)
dx = density(x)

plot(dx)

dx$y = dx$y * n
plot(dx)

### ggplot2 versions

n= 500
set.seed(123)

x = rnorm(n)
dx = density(x)

x=dx$x
y=dx$y
df=data.frame(x,y)
ggplot(df,aes(x=x,y=y))+geom_line()
ggplot(df,aes(x=x,y=y*n))+geom_line()+labs(y="y")

