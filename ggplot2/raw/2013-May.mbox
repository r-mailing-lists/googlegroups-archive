On Mon, May 20, 2013 at 10:54 PM, Ito, Kaori (Groton) <Kaor...@pfizer.com> wrote:

Dear Xianwen,
"<-" is assignment operator and it works slightly different from "=". See the difference in "a" for two examples below.

a <- data.frame(x=1:3, y=4:6)
a <- data.frame(x <- 1:3, y <- 4:6)

Unfortunately, as long as I know, there is not "pattern" choice for fill within ggplot. But we have lots of choice of color + alpha transparency.

For the overwrap issue with you plot, do you mind if you place rect side by side?

rect_MNL_Delta <- data.frame(
xmin = c(1, 3, 5, 7, 9, 11, 13),

xmax = c(1.5, 3.5, 5.5, 7.5, 9.5, 11.5, 13.5),

ymin = c(16.7026, 14.9968, 16.0630, 17.7510, -5.01694, -.44146, 1.45884), ymax = c(21.1602, 18.7613, 19.1367, 23.6730, 2.26564, 3.08630,3.39865), f = 'MNL'
)
rect_GMNL <- data.frame(

xmin = c(1, 3, 5, 7, 9, 11, 13)+0.5,
xmax = c(1.5, 3.5, 5.5, 7.5, 9.5, 11.5, 13.5)+0.5,

ymin = c(17.20, 16.32, 15.86, 18.12, -8.86, -0.03, 0.95), ymax = c(20.12, 18.60, 18.14, 22.29, 3.03, 3.57, 2.81), f = 'GMNL'
)

WTP_plot = ggplot() +
geom_rect(data = rect_MNL_Delta, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill = grey(0.3)), alpha = 0.5) +
geom_rect(data = rect_GMNL, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill = grey(0.6)), alpha = 0.5) +
scale_fill_manual(name = "Model", breaks = c(grey(0.3), grey(0.6)), values =c(grey(0.3), grey(0.6)), labels = c("MNL", "GMNL")) +
scale_x_continuous(breaks=c(1.5, 3.5, 5.5, 7.5, 9.5, 11.5, 13.5), labels=c("Wild cod", "Farmed cod","Farmed salmon","Wild monk","Farmed pangasius","MSC label","AB label")) + scale_y_continuous(name = "Confidence Interval of WTP estimators
(EUR/KG)") +
theme(axis.text.x = element_text(angle=45, hjust=.5, vjust=0.5))

WTP_plot

By the way, if you combine the datasets together, you can also map Model to fill color and create a same plot (with less coding):

Data <- rbind.data.frame(rect_MNL_Delta, rect_GMNL)

ggplot(Data, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax, fill=f)) + geom_rect() +

scale_x_continuous(breaks=c(1.5, 3.5, 5.5, 7.5, 9.5, 11.5, 13.5)
, labels=c("Wild cod", "Farmed cod","Farmed salmon","Wild monk","Farmed pangasius","MSC label","AB label")) +

 scale_y_continuous(name = "Confidence Interval of WTP estimators(EUR/KG)") +
 theme(axis.text.x = element_text(angle=45, hjust=.5, vjust=0.5)) +
scale_fill_manual("Model",values=c(grey(0.3), grey(0.6)))

