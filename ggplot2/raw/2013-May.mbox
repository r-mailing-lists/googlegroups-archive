How about this? I changed "<-" to "=" in the data.frame.
You have continuous variables on x so I used scale_x_continuous for changing the ticks and adding labels. You can modify angle, size, etc with theme.

rect_MNL_Delta <- data.frame(
         xmin = c(1, 3, 5, 7, 9, 11, 13),
         xmax = xmin + 1,
         ymin = c(16.7026, 14.9968, 16.0630, 17.7510, -5.01694, -.44146, 1.45884),
         ymax = c(21.1602, 18.7613, 19.1367, 23.6730, 2.26564, 3.08630,3.39865)
)
rect_GMNL <- data.frame(
         xmin = c(1, 3, 5, 7, 9, 11, 13),
         xmax = xmin + 1,
         ymin =  c(17.20, 16.32, 15.86, 18.12, -8.86, -0.03, 0.95),
         ymax = c(20.12, 18.60, 18.14, 22.29, 3.03, 3.57, 2.81)

)

ggplot() +
         geom_rect(data = rect_MNL_Delta, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax), fill = "blue", alpha = 0.1) +

         geom_rect(data = rect_GMNL, aes(xmin = xmin, xmax = xmax, ymin = ymin, ymax = ymax), fill = "green", alpha = 0.1) +
         scale_x_continuous(breaks=c(1, 3, 5, 7, 9, 11, 13), labels=c("Farmed cod","text","text","text","text","text","text")) +
         theme(axis.text.x = element_text(angle=90, hjust=1, vjust=0.5))

