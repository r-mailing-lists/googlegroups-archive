Nice. To add the text, here is one approach:

ggplot(m,aes(Year,value,fill=variable)) +
geom_area(position="stack") +
geom_line(position="stack") +

geom_point(position="stack") +
geom_text(aes(y = value + rep(c(0.01, 0), each = 4),
              label = paste0(round(100 * value, 1), "%"),
              hjust = rep(c(0, 0.5, 0.5, 1), 2)),
          position = "stack", size = 4)

Dennis

