  scale_x_discrete("År", breaks=seq(1996,2008, 2))+
  scale_y_continuous("Antal")+
  geom_vline(aes(xintercept="2001", alpha=0.5,labels="Regering AFR"))+
  opts(axis.text.x=theme_text(angle=90,hjust=1,size=8))+
