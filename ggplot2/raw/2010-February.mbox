with ggplot you can specify an optional function to format your axis
labels.

my.round <- function(x){
    round(x,2)
}

p <- ggplot(melt_nutrients_sw, aes(x = ID, y = value, color=Season)) +

 geom_point() + facet_grid(variable~catchment, scales = "free") +

 scale_y_sqrt("",formatter=my.round)

regards,
 stefan

