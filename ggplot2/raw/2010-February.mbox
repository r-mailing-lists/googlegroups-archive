The lines and points show nicely in the legend but once the fill=set is applied the geom_bar
throws everything from the legend. Try the code below, I don't think is what you want but close enough(maybe)

# save datasets to your current working directory and then do:

     read.csv("precipal.csv") -> precipall
     read.csv("precip2.csv") -> precip2
     read.csv("precip1.csv") -> precip1
      # add a column to each dataset (to be able to merge legends) and bind them together

      precipall$set <- rep("precipall",nrow(precipall));precipall

       precip2$set <- rep("precip2",nrow(precip2))
       precip1$set <- rep("precip1",nrow(precip1))
    mdf <- rbind(precipall,precip2,precip1);str(mdf)
      mdf

# Create the plot with merged legends

    p <- ggplot(data=subset(mdf,set=='precipall'),aes(Month,Rainfall,colour=set))
    p <- p +  geom_bar(stat='identity',fill='pink');p
   pp <- p +  geom_line(data=subset(mdf,set!='precipall'),legend=F) ;pp
   ppp <- pp +  geom_point(data=subset(mdf,set!='precipall'));ppp

