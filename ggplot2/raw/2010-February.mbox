# save datasets to your current working directory and then do:
     read.csv("precipal.csv") -> precipall
     read.csv("precip2.csv") -> precip2
     read.csv("precip1.csv") -> precip1

      # add a column to each dataset (to be able to merge legends) and bind them together

      precipall$set <- rep("precipall",nrow(precipall))
       precip2$set <- rep("precip2",nrow(precip2))
       precip1$set <- rep("precip1",nrow(precip1))
    mdf <- rbind(precipall,precip2,precip1);str(mdf)
      mdf

       # could select original dataset but since a column was added,
       # subset from mdf for consistancy and be able to use the newly added column 'set'
    mdf_precip2 <- subset(mdf,set=='precip2')
    mdf_precip1 <- subset(mdf,set=='precip1')
    mdf_precipall <- subset(mdf,set=='precipall')
# Create the plot with merged legends
    p <- ggplot(mdf_precipall,aes(Month,Rainfall,fill=set,colour=set)) + geom_bar(stat='identity')
     p <- p + geom_line(data=mdf_precip2) + geom_point(data=mdf_precip2)
     p <- p +  geom_line(data=mdf_precip1) + geom_point(data=mdf_precip1);p

Just add the labels and break manually with scale_colour_manual if desired

