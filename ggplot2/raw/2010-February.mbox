  Does this do what you need?

ggplot(tsa) +
  geom_segment(aes(x=cron_inizio, xend=cron_fine,
                   y=reorder(Tipo, cron_inizio),
                   yend=reorder(Tipo,cron_inizio)),
               alpha=1, colour="red", size=4)+
  theme_bw()

