All I was suggesting is that when it calculates the minor axes, it's using the as.numeric(unique()) (to be more specific than before) instead of levels(). I would not expect this to affect the grouping/calculation of the boxplot at all....

But why dont we check that the grouping is correct by hand and that the boxplot is giving the advertised stats (http://had.co.nz/ggplot2/stat_boxplot.html) when we pull out the groups manually??

## the orig prob

library(ggplot2)
dat <- data.frame(time = factor(rep(0:59, each = 100), levels = 0:59), error = rnorm(6000))

gg <- qplot(time, error, data = dat, size = I(1), main =" title",

ylab="Error (min)", xlab="Time before ON (min)", alpha=I(1/10),
geom="jitter") +
geom_boxplot(alpha=.5, color="blue", outlier.colour="green",
outlier.size=1) + scale_x_discrete(breaks = seq(from=0, to=60, by=10))

## get the build object where we can access what ggplot actually calculated
bbg <- ggplot_build(gg)

# let's just use the code from stat-boxplot (slightly paired down, doing as described)
gg.bp.q <- function(y, coef=1.5) {
  qs <- c(0, 0.25, 0.5, 0.75, 1)
  stats <- as.numeric(quantile(y, qs))
  names(stats) <- c("ymin", "lower", "middle", "upper", "ymax")
  iqr <- diff(stats[c(2, 4)])
  outliers <- y < (stats[2] - coef * iqr) | y > (stats[4] + coef * iqr)
  if (any(outliers)) stats[c(1, 5)] <- range(y[!outliers], na.rm=TRUE)
  stats
}

## note that  bbg$data[[2]][[1]]$group == as.numeric(unique(dat$time))
for (igrp in as.numeric(unique(dat$time))) {
  igrp.error <- dat[ dat$time == (igrp-1), 'error' ]
  the.test <-
           bbg$data[[2]][[1]][ bbg$data[[2]][[1]]$group == igrp,
                                         c('ymin', 'lower', 'middle', 'upper', 'ymax')]  ==
           gg.bp.q(igrp.error)
   if (any(!the.test)) print(igrp)
}

so the grouping is done properly, whew!

