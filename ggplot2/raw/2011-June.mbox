geom_line(data=means.df)

means.df. <- data.frame(x=rep(seq(2000, 2011, length.out=23), 3),

                        group=rep(c("low", "middle", "high"),

each=23),
                        y=rep(means$mean[c(2,3,1)], each=23))

qplot(x, y, data=df, color=group, geom="line") +

geom_line(data=means.df.)

