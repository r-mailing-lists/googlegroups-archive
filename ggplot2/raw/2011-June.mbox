#transparency works here
ggplot(z,aes(x=x,y=y))+
geom_point(aes(pch=16,alpha=.5),size=6,colour="blue")

#but not when i use pch=21
ggplot(z,aes(x=x,y=y))+
geom_point(aes(pch=21,alpha=.
5),size=6,fill="lightblue",colour="black")

Cheers,
Adrian

