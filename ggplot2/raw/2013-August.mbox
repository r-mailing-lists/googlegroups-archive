hello,everyone!please see this article,http://rpubs.com/kohske/dual_axis_in_ggplot2 .
as you can see,this paper had done a bold attemptt and get a nice plot.
 i want to draw dual y axis with facet_wrap ,with the dataset mtcars,the code is below
(cause the code need learn grid and gtable packages,and I don not have too much time to spend in they ,so could someone nice to give me some help )

p1 <- ggplot(mtcars, aes(mpg, disp)) + geom_line(colour = "blue") + theme_bw()+facet_wrap(~vs)
p2 <- ggplot(mtcars, aes(mpg, drat)) + geom_line(colour = "red") + theme_bw() %+replace%
theme(panel.background = element_rect(fill = NA))+facet_wrap(~vs)
# extract gtable
g1 <- ggplot_gtable(ggplot_build(p1))
g2 <- ggplot_gtable(ggplot_build(p2))

# overlap the panel of 2nd plot on that of 1st plot
#pp <- c(subset(g1$layout, name == "panel", se = t:r))
pp <- c(subset(g1$layout, name %in% g1$layout$name[2:3] , se = t:r))
# g <- gtable_add_grob(g1, g2$grobs[[which(g2$layout$name == "panel")]], pp$t,
# pp$l, pp$b, pp$l)
g <- gtable_add_grob(g1, g2$grobs[2:3], pp$t,
pp$l, pp$b, pp$l)
#code below may be error,but with myslef dataset ,no error. I don not know why .
ia <- which(g2$layout$name %in% g2$layout$name[6:7])
ga=list();ax=list()
for(i in 1:length(ia)){
ga[[i]] <- g2$grobs[[i+6-1]]
ax[[i]] <- ga[[i]]$children[[2]]
ax[[i]]$widths <- rev(ax[[i]]$widths)
ax[[i]]$grobs <- rev(ax[[i]]$grobs)
ax[[i]]$grobs[[1]]$x <- ax[[i]]$grobs[[1]]$x - unit(1, "npc") + unit(0.15, "cm")
}
g <- gtable_add_cols(g, g2$widths[g2$layout[ia, ]$l], length(g$widths) - 1)
g <- gtable_add_grob(g, ax, pp$t, length(g$widths) - 1, pp$b)

# draw it
grid.draw(g)
