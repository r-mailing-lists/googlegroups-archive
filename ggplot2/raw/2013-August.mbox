geom_png <- function(file, xlim=NULL, ylim=NULL) {
  img <- as.raster(readPNG(img, FALSE))
  if (is.null(xlim))
    xlim <- c(0,ncol(img))
  if (is.null(ylim))
    ylim <- c(0,nrow(img))
  img <- img[seq(ylim[1]+1,ylim[2]),seq(xlim[1]+1,xlim[2])]
  annotation_raster(img,xlim[1],xlim[2],ylim[1],ylim[2],TRUE)
}

