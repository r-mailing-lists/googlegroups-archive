Is this what you're looking for? The width is taken from w, and each bar centered on the x value. The bars go from 0 on the y axis to the y value.

pdat <- data.frame(x=c(0.0,2.5,5.0,7.5,10.0,12.5,15.0),
       y=c(4.33e+05,1.73e+07,3.44e+07,1.00e+06,2.64e+06,9.46e+04,1.69e+07),
       w=c(2,1,1,2,2,3,1))

p <- ggplot(pdat) +
       scale_x_continuous(name='Frequency (Hz)') +
       scale_y_continuous(name='Power') +

       geom_rect(aes(xmin=x-w/2, xmax=x+w/2, ymin=0, ymax=y))
theme_set(theme_bw())
p

-Winston

