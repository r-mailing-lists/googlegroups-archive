1L, 1L, 1L, 2L, 2L, 2L, 2L, 2L, 2L, 2L), .Label = c("foxy", "sn4"
), class = "factor")), .Names = c("id", "Kmer.length", "n50",
"Length.Sum", "Organism.Name"), row.names = c(NA, -11L), class = "data.frame")

p <- ggplot(overview_all,aes(x=Length.Sum,y=n50,group=Organism.Name))
+geom_point(aes(colour=Kmer.length))

This makes it so that values of Kmer.length with low values are blue
and ones with high values are red. How would you like the plot to
