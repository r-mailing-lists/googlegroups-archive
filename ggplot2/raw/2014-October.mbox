This might do what you want if I understand you correctly. I created a new column of data and made the ones that were out of bounds NA. But then you can still use the z column for labels so the values are all there. Kudos for the example. Very easy to work with.

B

# required package
library(ggplot2)

# data frame
df <- data.frame(x=rep(toupper(letters[1:10]), 5),
                 y=c(array(1,10), array(2,10), array(3,10), array(4,10), array(5,10)),
                 z=runif(50, -4.5, 4.5))

#block out values that don't fit your desired scale with NA
df$zNew <- ifelse(df$z > 3 | df$z < -3, NA, df$z)

# plot heatmap
ggplot(data=df) +
geom_tile(aes(x=x, y=y, fill=zNew)) +
scale_fill_gradientn(colours=colours, limits=c(-3, 3), breaks=breaks, na.value = "grey", guide="colourbar") +

geom_text(aes(x=x, y=y, label=paste(sprintf("%.2f", z)), size=2), show_guide = FALSE)

