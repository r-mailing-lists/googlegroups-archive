               row.names = c(NA, -32L), class = "data.frame")

melted.d=melt(d, id.vars=c("i", "t", ps[[p]]),
measure.vars=paste("V_", 1:4, sep=""), variable_name="cl")
melted.d$cl=factor(melted.d$cl,
  levels=c(paste("V_", 1:4, sep="")),
  labels=paste("L_", 1:4, sep=""))

## there aer several more value_? columns leave them out as we only
## need on to demonstrate the problem

for ( level in levels(melted.d$cl) ) {
  model = rlm(value ~ c + p, data=melted.d[melted.d$cl %in% level, ])
  grid=round(with(d, expand.grid(
    "c" = seq(min(c), max(c), length=predictionSequenceLength),
    "p" = seq(min(p), max(p),
length=predictionSequenceLength)
    )))

  grid$value = predict(model, newdata=grid)
  err <- predict(model, newdata=grid, se = TRUE)
  grid$ucl <- err$fit + 1.96 * err$se.fit
  grid$lcl <- err$fit - 1.96 * err$se.fit

  e="p"

  ## graph example 1
  ## yields a straight line but the SE is in many cases so narrow as
to be not visible
  graph=ggplot(melted.d[melted.d$cl %in% level, ],
aes(x=eval(parse(text=e)), y=value)) +
    geom_point(data=melted.d[melted.d$cl %in% level, ],
aes(x=eval(parse(text=e)), y=value, color=t, shape=t)) +
      geom_smooth(aes(x=eval(parse(text=e)), y=value), data=grid,
color="black") +
        labs(x=eval(gsub(".", " ", e, fixed=T)), y="Volume") +
          scale_color_brewer(palette = "Set1")

  quartz()
  print(graph)

  ## graph example 2
  ## yields staircase line plots
  graph2=ggplot(melted.d[melted.d$cl %in% level, ],
aes(x=eval(parse(text=e)), y=value)) +
    geom_point(data=melted.d[melted.d$cl %in% level, ],
aes(x=eval(parse(text=e)), y=value, color=t, shape=t)) +
      geom_smooth(aes(ymin=lcl, ymax=ucl), data=grid, color="black",
stat="identity") +
        labs(x=eval(gsub(".", " ", e, fixed=T)), y="Volume") +
          scale_color_brewer(palette = "Set1")

  quartz()
  print(graph2)
}

