>
> mod <- read.csv(textConnection(link2), sep="", header=T)
>
> tmp <- paste(mod$year,"-", mod$month, "-", mod$day, sep='')
>
> mod$date <- as.Date(tmp)
>
>
>
> # Reorder DF and discard old date characteres
>
> mod <- mod[c(9,4,5,6,7,8)]
>
>
>
> # Merge datasets by date
>
