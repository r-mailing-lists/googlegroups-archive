####################
library(ggplot2)
sampleNb <- 60
fakeDf <- data.frame(month=as.factor(as.integer(runif(sampleNb, min=1, max=12))), gear_type=as.factor(as.integer(runif(sampleNb, min=1, max=4))), value=rnorm(n=sampleNb), mean_previous=rnorm(n=sampleNb), stddev_previous=rnorm(n=sampleNb)/5)
fakeSecondDf <- data.frame(month=as.factor(as.integer(runif(sampleNb, min=1, max=12))), gear_type=as.factor(as.integer(runif(sampleNb, min=1, max=4))), mean_previous=rnorm(n=sampleNb), stddev_previous=rnorm(n=sampleNb)/5)
fakeSecondDf <- merge(aggregate(mean_previous ~ month, data=fakeDf, sum), aggregate(stddev_previous ~ month, data=fakeDf, mean))
resultPlot <- ggplot()

resultPlot <- resultPlot + geom_bar(data=fakeDf, mapping=aes(x=month, y=value, fill=gear_type, order=gear_type), stat="identity", width=0.8) + scale_fill_brewer(palette="Set1", name="Gear type")
resultPlot <- resultPlot + geom_errorbar(data=fakeSecondDf, mapping=aes(x=month, ymax = mean_previous + stddev_previous, ymin=mean_previous - stddev_previous), width=0.25, color="dimgray")
resultPlot <- resultPlot + geom_line(data=fakeSecondDf, mapping=aes(x=month, y=mean_previous, group="month"))
resultPlot <- resultPlot + xlab("Month") + ylab("Fake value") + ggtitle("monthly fake values by gear type")

print(resultPlot)
####################

