> You either want to change the factor levels, or manually set the
> breaks and levels for the x axis:
>
> mtcars$cyl <- factor(mtcars$cyl)
> qplot(cyl, mpg, data = mtcars)
>
> mtcars$cyl2 <- factor(mtcars$cyl, labels = c("four", "six", "eight"))
> qplot(cyl2, mpg, data = mtcars)
>
> # OR
>
> qplot(cyl, mpg, data = mtcars) +
>   scale_x_discrete(labels = c("four", "six", "eight"))
>
