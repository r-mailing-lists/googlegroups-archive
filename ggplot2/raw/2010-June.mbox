Found part of the answer myself, but I still can't get the points in
the legend. However, now I have got a legend for the line
Willem

library(ggplot2)

x <- rep(runif(20),5)
y <- rnorm(100)
y2 <- mean(y) + sd(y)*x
treat <- ifelse(x > 0.5, "treat 1","treat 2")
crop <- ifelse(y > 0,"Fallow","Crop")

plot.frame <- data.frame(x = x, y = y, y2 = y2, treat = treat,
      crop = crop)

p <- ggplot(plot.frame, aes(x=x,y=y)) +
      geom_point(size=2,colour="black") +

      geom_line(aes(x=x,y=y2,colour="line"),size=1) +

      facet_grid(crop~treat) +
      opts(labels = c(x = "Variable 1", y = "Variable 2"))

p <- p + scale_colour_manual("Adjust",c("black"="black","line"="red"))

print(p)

