Hi Jared,

I think you can avoid the loop using melt (package reshape), hope this
helps,
fernando

library(ggplot2)
df <- data.frame(AA = sample(1:10, 10), BB = sample(1:10,10), CC =
sample(1:10,10), DD=sample(1:10,10))

tags <- c("Type 1", "Type 2", "Type 1", "Type 2")

new.df <- melt(df)
new.df$tag <- factor(rep(tags, each = dim(df)[1]))
str(new.df)

