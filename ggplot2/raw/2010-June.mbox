    if (i==1 & j==1) { D=df; F=f} else {
      D=merge(D,df,all.x=TRUE,all.y=TRUE)

      F=merge(F,f,all.x=TRUE,all.y=TRUE)
    }
  }
}

## dummy lists, just to match what I'm doing w multiple plots
