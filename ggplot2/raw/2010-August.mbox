please consider using scale_reverse instead of passing reversed limits
to the scale:

test.data <- data.frame(depth=0:9, response=1:10)

plot1 <- ggplot(test.data, aes(y = depth))+geom_smooth(aes(x =

response))+scale_y_continuous(limits=c(0,9))+scale_y_reverse()
print(plot1)

