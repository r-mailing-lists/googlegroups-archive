xval<-1:100
yval<-rnorm(100)

fullx<-c(-10,-10,1:100)
fully<-c(predict(lm(yval~xval),data.frame(xval=c(-10,-10),yval=c(NA,NA))),yval)

thedf<-data.frame(thex=fullx,they=fully)
thedf$text=c("\u2B00\nx=-10","\u26AA",rep("\u2022",100))
thedf$voff<-c(1,rep(0,101))
thedf$hoff<-c(1,rep(0,101))

ggplot(thedf,aes(x=thex,y=they,group=text,color=factor(text)))+
   geom_text(aes(thex,they,label=text,vjust=voff,hjust=hoff),size=4)+
   geom_smooth(method=lm) +
   scale_x_continuous(limits=c(-20,110))

