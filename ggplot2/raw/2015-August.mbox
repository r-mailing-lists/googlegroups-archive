                                   header=T,as.is <http://as.is>=T,row.names=1,fill=F,sep="\t",
                                   quote="",comment.char="",blank.lines.skip=F,strip.white=T),stringsAsFactors=F)

colnames(new.biom)<-gsub("^X","",colnames(new.biom))

original.biom.only.fungal<-original.biom[grep("k__Fungi.*",as.vector(original.biom[,"kingdom"])),]
original.biom.not.fungal<-original.biom[grep("k__Unassigned.*",as.vector(original.biom[,"kingdom"])),]

new.biom.only.fungal<-new.biom[grep("k__Fungi.*",as.vector(new.biom[,"kingdom"])),]
new.biom.not.fungal<-new.biom[grep("k__Unassigned.*",as.vector(new.biom[,"kingdom"])),]

original.biom.only.fungal.melt<-melt(cbind(rownames(original.biom.only.fungal),original.biom.only.fungal[,-81:-87]),id.vars=1)
original.biom.only.fungal.melt.taxa<-cbind(original.biom.only.fungal.melt,original.biom.only.fungal[as.vector(original.biom.only.fungal.melt[,1]),81:87],"original")
colnames(original.biom.only.fungal.melt.taxa)[c(1,11)]<-c("OTUID","analysis")
original.biom.only.fungal.melt.taxa[,"variable"]<-paste(as.vector(original.biom.only.fungal.melt.taxa[,"variable"]),"original",sep=" ")

new.biom.only.fungal.melt<-melt(cbind(rownames(new.biom.only.fungal),new.biom.only.fungal[,-81:-87]),id.vars=1)
new.biom.only.fungal.melt.taxa<-cbind(new.biom.only.fungal.melt,new.biom.only.fungal[as.vector(new.biom.only.fungal.melt[,1]),81:87],"new")
colnames(new.biom.only.fungal.melt.taxa)[c(1,11)]<-c("OTUID","analysis")
new.biom.only.fungal.melt.taxa[,"variable"]<-paste(as.vector(new.biom.only.fungal.melt.taxa[,"variable"]),"new",sep=" ")

p<- ggplot()
p<- p + geom_bar(data=rbind(original.biom.only.fungal.melt.taxa,new.biom.only.fungal.melt.taxa),
                 aes(x=variable,y=as.numeric(value),fill=species),stat="identity")
p<- p +  guides(fill=guide_legend(title="taxonomy",override.aes=list(colour=NA),nrow=15))
p<- p +
  theme(
        legend.position="bottom",axis.text.x = element_text(angle = 90, hjust = 1),
        panel.background=element_rect(fill="white",color="white"))

print(p)

