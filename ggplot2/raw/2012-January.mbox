Nice aesthetics option!!!!, Look very well. I used scale_x_discrete

p <- ggplot(subset(reclas))
p1 <- p + geom_bar(aes(factor(length), obs), stat = "identity")
p2 <- p1 + facet_wrap(~year)
p3 <- p2 + geom_line(aes(factor(length), pre, group = 1))

p4 <- p3 + scale_x_discrete(formatter = "abbreviate")
p4 <- p4 + scale_x_discrete(breaks=seq(3,33,5))
p4

