Hadley,

Does this help?

iris$cut3=cut(iris$Sepal.Length, c(0, 5.4, 6.9, 8.5), paste (c("<5.5",
"5.5-6.9", "7+"))) #cut into 3 bins
iris$cut4=cut(iris$Sepal.Length, c(0, 4.4, 5.4, 6.9, 8.5), paste (c
("<4.5", "4.5-5.4", "5.5-6.9", "7+"))) #cut into 4 bins
qplot(cut3, data=iris, geom="histogram") #correctly ordered
qplot(cut4, data=iris, geom="histogram") #incorrectly ordered

