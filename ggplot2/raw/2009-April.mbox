Or, if you really want that border around the bars:

data=data.frame(x=c(1,1,2,2),y=c(1,2,1,2),z=c(1,2,1,2))

p=ggplot(data,aes(x=x,y=y,fill=factor(z)))

#first call to geom_bar with no border to make legend
p=p+geom_bar(stat='identity',position='dodge')

#second call to geom_bar with border and no legend to overwrite
earlier call but leave the legend
p=p+geom_bar(stat='identity',position='dodge',colour='black',legend=FALSE)

