Something like this maybe
library(plyr)
library(reshape2)
library(ggplot2)

df <- data.frame(Condition = factor(c(1, 0), levels = c(1, 0), labels = c("Experimental", "Control")), Complied = c(.77, .29))

df <- melt(mutate(df, `Did Not Comply` = 1 - Complied))

p <- ggplot(data = df, aes(x = variable, y = value)) # bar plot
p +
  geom_bar(aes(fill = Condition), stat = "identity", position = "dodge") +
  scale_fill_manual(values = c("blue", "red")) +
  theme_bw() +
  theme(title = element_blank())

