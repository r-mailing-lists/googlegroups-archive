See the example below. It would be convenient if the sd value could be
label in each pair of figures.

library(cluster)
png('main.png',width=1000,height=1000)
par(mfrow=c(3,4))
lapply(
  seq(0,1,0.2)
  , function(sd) {
    x=rbind(
      cbind(
        rnorm(10,0,sd)
        , rnorm(10,0,sd)
        , rnorm(10,0,sd)
        )
      , cbind(
        rnorm(15,5,sd)
        , rnorm(15,5,sd)
        , rnorm(15,5,sd)
        )
      )
    plot(pam(x, 2))
  }
  )
dev.off()

