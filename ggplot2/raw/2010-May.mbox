You can save as png like this too:

library(ggplot2)
data=data.frame(
  X=sample(10,1000,replace=T)
  , Y=letters[1:10])

png("mypng.png")

qplot(X, data=data, geom='histogram') + facet_wrap( ~ Y)

dev.off()

