Manuel:
Here's another way to accomplish the same thing. Just add the desired opts()

library(spsurvey) # so read.shape function can be used
library(maptools)
gpclibPermit() # Permit to use maptools
   # Read in the shapefile
  shp <- read.shape("corredorCRTM05")
riqueza <- read.csv("manuel_data.csv");as.data.frame(shp);riqueza
names(shp);names(riqueza)
# add the column "id" to "shp" and use it to join with "shp.DF"
  names(shp)[1] <- "id"
shp.DF <- as.data.frame(shp)
head(shp.DF)
shp_fort <- fortify(shp,region="id")
 head(shp_fort);dim(shp_fort)

# join the two dataframes, shp.DF and shp_fort
   shp2 <- join(shp_fort,shp.DF,by="id")
     shp2
   head(shp2)
    dim(shp2)

  # Make the plot overlaying the riqueza points on top of the shapefile
man_plot <- ggplot(shp2,aes(x = long, y = lat, group = id)) + geom_polygon(fill='lightblue') +
geom_path(colour = I("white")) + geom_point(data=riqueza,aes(x,y,size=N,colour=N)) + scale_fill_brewer(pal="Set2") +
    opts(title="Manuel's plot",axis.text.y = theme_blank(),axis.title.y = theme_blank(),
    axis.text.x=theme_blank(),axis.title.x=theme_blank(),axis.ticks = theme_blank())
     man_plot

