d.data3 <- ddply(d.data2,"variable",
            function(x) {
              x <- x[order(x$Legend),]
              x$percent  <- x$freq/sum(x$freq)*100
              x$cfreq <- cumsum(x$freq)/sum(x$freq)
              x$pos <- (c(0,x$cfreq[-nrow(x)])+x$cfreq)/2
