Hi Rob,

Here's how I'd do it.  I think the main thing you were missing is that
you need to calculate the confidence bands on the raw predictions and
then back transform to the original scale.

Hadley

VESP <- read.csv("VESP.txt")

library(MASS)
vespnb5 <- glm.nb(SumOftamano ~ poly(grassNew, 2) + OtherNew, data = VESP)

grid <- with(VESP, expand.grid(
  grassNew = seq(0.1, 0.8, by = 0.1),
  OtherNew = mean(OtherNew)
))

err <- predict(vespnb5, newdata=grid, se=TRUE)

grid$SumOftamano <- exp(err$fit)
grid$ucl <- with(err, exp(fit + 1.96 * se.fit))
grid$lcl <- with(err, exp(fit - 1.96 * se.fit))

library(ggplot2)
ggplot(VESP, aes(grassNew, SumOftamano)) +
  geom_point() +
  geom_smooth(aes(min = lcl, max = ucl), data = grid,stat = "identity")

