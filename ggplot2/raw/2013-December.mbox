 	+ layerGRUEP
 	+ layerEVENNESS
 	+ scale_fill_manual(
 		values=c(
 			"lo"="yellow"
 			, "HI"="pink"
 			)
 		)
 	+ scale_color_manual(
 		values=c(
 			"odd"="green"
 			,"even"="red"
 			)
 		)
)

