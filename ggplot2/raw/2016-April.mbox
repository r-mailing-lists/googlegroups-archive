Well, you should also remove 'dose' when getting the Effect... And your plot has to become very different, too.

 <https://lh3.googleusercontent.com/-ullf6E4boOc/VwzeC-tC3yI/AAAAAAAANdU/pPD6_MFFqr4InAsMFfekD7rc5dMk_G36QCLcB/s1600/temp2.png>

fit <- lm(data = ToothGrowth, len ~ supp)

library(effects)
f <- as.data.frame(Effect('supp', fit))

ggplot(mapping = aes(x= supp)) +
  geom_bar(data = f, aes(y = fit), stat = "identity", col = 1, fill = NA) +
  geom_errorbar(data = f, aes(ymin = lower, ymax = upper, fill = supp), width = 0.3) +

  ylab('Length') + theme_bw()

ggsave('temp2.png', dpi = 500)

