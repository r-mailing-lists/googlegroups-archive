dev.off()

#Detach df.new <http://df.new>
detach(df.new <http://df.new>)

#Make the plot in ggplot2

require(ggplot2)

ggplot(df.new <http://df.new>, aes(Time, Weight, colour = Individual, linetype =
Individual)
+ geom_line()

======END======

