#"Before" and "After" are values of body weight before and after being
given the new food.

#Make and object with the data file.
newfood1 <- read.delim("newfood1.txt", header=T)

#Show the object
newfood1

#Build a new dataframe with the columns 'Weight', 'Time' and
'Individual'.
# 'Time' and 'Weight' become factors.
before <- newfood1$Before
after <- newfood1$After

#In the parameter "factor(1:10)", the second number must be equal to
