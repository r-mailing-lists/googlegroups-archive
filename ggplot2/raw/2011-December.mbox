before.new <http://before.new> <- data.frame(Weight = before, Time = "Before", Individual
= factor(1:10))
after.new <http://after.new> <- data.frame(Weight = after, Time = "After", Individual =
factor(1:10))
df.new <http://df.new> <- rbind(before.new <http://before.new>, after.new <http://after.new>)

#Show df.new <http://df.new>
df.new <http://df.new>

#Attach df.new <http://df.new>, in order to use the new dataframe
