# 'Time' and 'Weight' become factors.
before <- newfood1$Before
after <- newfood1$After

#In the parameter "factor(1:10)", the second number must be equal to the number of individuals tested.
before.new <http://before.new> <- data.frame(Weight = before, Time = "Before", Individual = factor(1:10)) after.new <http://after.new> <- data.frame(Weight = after, Time = "After", Individual =
factor(1:10))
df.new <http://df.new> <- rbind(before.new <http://before.new>, after.new <http://after.new>)

#Show df.new <http://df.new>
df.new <http://df.new>

#Attach df.new <http://df.new>, in order to use the new dataframe
attach(df.new <http://df.new>)

#Make the plot
png(file="newfood1.png", width = 1000, height = 1000, pointsize = 20) interaction.plot(Time, Individual, Weight, ylab = "Body weight (g)", xlab = "Time", main="Change in the body weight of bats after being given a new food", col = rainbow(10))
dev.off()

#Detach df.new <http://df.new>
detach(df.new <http://df.new>)

#Make the plot in ggplot2

require(ggplot2)

ggplot(df.new <http://df.new>, aes(Time, Weight, colour = Individual, linetype =
Individual)
+ geom_line()

======END======

