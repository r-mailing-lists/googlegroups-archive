Hi

try this:

ggplot(test.df, aes(x = CountryName, y = Value)) + geom_bar(aes(fill =
Level)) + geom_text(aes(label = sprintf("%.1f", Value),
hjust = ifelse(Value >= bound, 1, 0),               col = breakCol),
size = 2.5, legend = FALSE) + coord_flip() + xlab(NULL) + ylab(NULL) +
opts(legend.position = "top", legend.direction = "horizontal",

legend.title = NULL) + scale_color_manual(value = c("White", "Black"),
legend = F) + opts(axis.text.y = theme_text(colour = "grey50", size =
12 *     0.8, vjust = 1, lineheight = 0.5))

