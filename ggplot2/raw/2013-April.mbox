Bah, yes, my example was totally screwed up. And you do need the NA
padding. Sorry for spreading confusion! Just create the data as you
originally did. Here is my corrected example:

x1<-c(-18,0,-7,-29,-36,-18,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
x2<-c(-18,-13,-17,-19,-23,-18,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
x3<-c(-18,-13,-10,-11,-17,-24,-29,-25,-23,-20,-18,NA,NA,NA,NA,NA)
x4<-c(-10,-7,-6,-2,-6,-6,-12,-12,-14,-22,-24,-25,-25,-24,-22,-10)
x5<-c(-11,-10,-11,-11,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
x6<-c(-25,-28,-34,-30,-31,-30,-27,-25,NA,NA,NA,NA,NA,NA,NA,NA)

y1<-c(-23,-5,0,0,-5,-23,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
y2<-c(-21,-16,-17,-17,-16,-21,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
y3<-c(-14,-14,-13,-12,-11,-11,-10,-14,-13,-13,-14,NA,NA,NA,NA,NA)
y4<-c(-7,-8,-9,-5,-2,-5,-5,-4,-2,-2,-3,-4,-5,-6,-7,-7)
y5<-c(-2,-1,-1,-2,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA,NA)
y6<-c(-1,-1,-5,-9,-7,-5,-2,-1,NA,NA,NA,NA,NA,NA,NA,NA)

datf<-data.frame(x1,x2,x3,x4,x5,x6,y1,y2,y3,y4,y5,y6)

library(reshape2)
datfm <- cbind(melt(datf[grep("x", names(datf))],
                    id.vars=NULL,
                    value.name <http://value.name>="x",
                    variable.name <http://variable.name>="xvar"),
               melt(datf[grep("y", names(datf))],
                    id.vars=NULL,
                    value.name <http://value.name>="y",
                    variable.name <http://variable.name>="yvar")
               )

datfm$c <- ifelse(datfm$xvar == "x1", "r", "w")

ggplot(datfm, aes(x=x, y=y, group=xvar, fill=c)) +
  geom_polygon() +
  scale_fill_manual(values=c("red", "white"))

Best,
Ista

