msleep$vore<-as.character(msleep$vore)
msleep[which(is.na <http://is.na>(msleep$vore)),]$vore<-"None"

ggplot(data=msleep)+
geom_point(aes(sleep_total, sleep_cycle, colour=vore), size=3)

