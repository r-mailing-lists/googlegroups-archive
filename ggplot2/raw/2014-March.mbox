Is this the objective? Please also check-out the documentation for facet_wrap at: http://docs.ggplot2.org/0.9.3.1/facet_wrap.html

library(ggplot2)
library(reshape2)
dfmelt=melt(df,id="date")
ggplot(dfmelt,aes(x=date,y=value))+geom_point()+facet_wrap(~ variable,scales = "free_y",ncol=1)

