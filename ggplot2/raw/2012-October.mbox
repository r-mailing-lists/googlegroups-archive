I was going on the picture and not your code so I didn't use geom_smooth(). The idea is similar though...

ggplot(data, aes(x = a, y = b, color = char, linetype = factor(sex), shape=char, group=char:sex))+
  geom_point(color="black")+

  scale_color_grey() +
  scale_linetype_manual(breaks=c("male","female"), values=c(1,2), labels = c("male", "female")) +

  geom_smooth(method = "lm",
              se = FALSE, # Don't add shaded confidence region

              size = 1.2)+
  theme_bw()

