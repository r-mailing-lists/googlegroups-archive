Hi:

How about this:

library('ggplot2')
library('plyr')
library('RColorBrewer')
tab3.1 <- read.table(textConnection("

       ext.obs                           comp     Var1   Freq    Rating
1  'HC\nObserver'          'Student\n Interaction'    1  6.557377      1
2  'HC\nObserver'          'Student\n Interaction'    2 21.639344      2
3  'HC\nObserver'          'Student\n Interaction'    3 47.868852      3
4  'HC\nObserver'          'Student\n Interaction'    4 23.934426      4
5     'Prin\n/AP'          'Student\n Interaction'    1  4.774536      1
6     'Prin\n/AP'          'Student\n Interaction'    2 19.098143      2
7     'Prin\n/AP'          'Student\n Interaction'    3 68.169761      3
8     'Prin\n/AP'          'Student\n Interaction'    4  7.957560      4
9  'HC\nObserver'         'Culture \nfor Learning'    1  8.802817      1
10 'HC\nObserver'         'Culture \nfor Learning'    2 23.239437      2
11 'HC\nObserver'         'Culture \nfor Learning'    3 48.943662      3
12 'HC\nObserver'         'Culture \nfor Learning'    4 19.014085      4
13    'Prin\n/AP'         'Culture \nfor Learning'    1  1.944444      1
14    'Prin\n/AP'         'Culture \nfor Learning'    2 28.333333      2
15    'Prin\n/AP'         'Culture \nfor Learning'    3 61.666667      3

16    'Prin\n/AP'         'Culture \nfor Learning'    4  8.055556      4"),
  header = TRUE, stringsAsFactors = FALSE)
closeAllConnections()

plotTitle <- "TfL Learning Environment"

# Use the new mutate() function, a faster version of transform()
# cfrq computes cumulative percent frequencies by
# ext.obs/comp combinations
tab3.1m <- mutate(tab3.1, Var1 = factor(Var1, levels = 1:4),
                   cfrq = ave(Freq, list(ext.obs, comp), FUN =
cumsum))

ggplot(tab3.1m, aes(x = ext.obs, y = Freq, fill = Var1)) +

    geom_bar(stat = 'identity') +
    labs (x = "", y = "Percentage", fill=" ") +

    scale_fill_brewer(name="Rating", palette="BrBG",
                      breaks = rev(levels(tab3.1m$Var1))) +
    geom_text(aes(y = cfrq - 1,

                  label=paste(round(Freq, 1), "%", sep='')),
              size=3) +

    facet_grid(. ~ comp) +
    opts(title = plotTitle)

HTH,
Dennis

