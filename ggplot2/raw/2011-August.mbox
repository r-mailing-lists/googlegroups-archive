How about...

ggplot(getLocations(), aes(longitude, latitude))+

borders(colour='white', fill='#dddddd', interior=FALSE)+

geom_point(alpha=0.8, aes(size=nodes))+
coord_map(ylim=c(-60, 70))+
scale_size(to=c(1, 5))+
labs(x='', y='')+
opts(title='Cluster Locations')+
theme_bw()

Does that work? It seems to work for me. Not sure why, but it seems that for some reason when you put the size= in the ggplot2() call it doesn't like it, but if you isolate it to your points it's ok with it.

