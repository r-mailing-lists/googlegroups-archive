> 600) ##### trimming parameter

p.value<-rep(c(rep(c("alpha==0.9"),12),rep(c("alpha==0.95"),
12),rep(c("alpha==0.99"),12)),200)#### level of significance
Pi<-rep(c(rep(c("pi[0]==0.05"),4),rep(c("pi[0]==0.01"),4),rep(c("pi[0]==0.15"),4)),
600) ##### trimming parameter

> Beta<-rep(c(rep(c("b=1"),2),rep(c("b=b"),2)),1800) #### label for
> restriction
> Restriction<-rep(c(rep(c(1),2),rep(c(0),2)),1800)#### value for
> restriction
