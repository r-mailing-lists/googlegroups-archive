Hi,

try this:

pd <- position_dodge(width = 0.5)

gplot <- ggplot(data = gdata, aes(x=test, y=value, fill=group, width =

0.5))+ geom_bar(stat="identity", position=pd)+ scale_x_discrete("",

limits=c("Test2", "Test1", "Test3"))

gplot + geom_text(aes(label = sig), position = pd)

