#this function is from “Pharmacometrics” book, so it is correct formula to calculate AUC

aucTrapE1 <- function(data)

       {

       data <- data[!is.na <http://is.na>(data$conc),]

       N <- nrow(data)

       if(N == 1) return(NA)

       0.5 * sum(diff(data$time)* (data$conc[ - N] + data$conc[-1]))

       }

aucTrap <- function(data, conc="conc",sub="subject", time="time", dose="dose")

       {sub <- data[!is.na <http://is.na>(conc),sub]

       dataN <- data[!is.na <http://is.na>(conc),c(conc,time)]

       names(dataN) <- c("conc","time")

       if(is.element(dose,names(data))){

              sub <- paste(sub, data[!is.na <http://is.na>(conc),dose],sep=":")

              }

       sub <- factor(sub, levels = unique(sub))

       val <- sapply(split(dataN, sub), aucTrapE1)

       val

       }

