Wondering if anyone can show a newbie how to add a legend to a
timeseries chart, stumped after 2.5 hours why no legend appears -
probably something simple, any advice greatly appreciated!

# get data
library(quantmod) # http://www.quantmod.com/examples/intro/
getSymbols("CPIAUCNS", src="FRED")
getSymbols("CPILFENS", src="FRED")

# create dataframe
CPIPCT = data.frame(CPIAUCNS / lag(CPIAUCNS,12) * 100 -100)
CPIPCT$date= as.Date(rownames(CPIPCT))
CPIXPCT = data.frame(CPILFENS / lag(CPILFENS,12) * 100 -100)
CPIXPCT$date= as.Date(rownames(CPIXPCT))
CPI <- merge(CPIPCT, CPIXPCT, by.x= "date", by.y="date", all=TRUE)

library(ggplot2)
mylen = 120
CPI <- tail(CPI, mylen)

# simple version
ggplot(data=CPI, aes(x=date, y=CPIAUCNS)) +
 geom_line(aes(y=CPIAUCNS), colour="#CC0000", size=1.4)  +
 geom_line(aes(y=CPILFENS), colour="#000099", size=1.4)  +
 theme_bw()  +
 ylab("YoY % Change") + xlab("")  +
 opts(title="CPI, YoY % Change\n", legend.position="top",
plot.background = theme_rect(colour = 'black', fill = '#CCCCEE', size
= 1, linetype='solid')) +
 scale_colour_manual("CPI", c("All Urban"="#CC0000", "Ex Food &
Energy"="#000099"))

