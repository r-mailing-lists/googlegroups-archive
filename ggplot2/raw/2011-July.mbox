hist + geom_bar(position = "dodge") + scale_y_continuous(limits = c(0,

     100), name = "") + scale_x_discrete(labels=xlabels, breaks = xbreaks) +

     opts(

      axis.text.x = theme_text(face=c('bold','plain'),size=c('15','10'))

