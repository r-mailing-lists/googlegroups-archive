Take a look at this:

library(maps) # Map functions
library(ggplot2) # Required for the map_data() function and other ggplot2 functions

con <- url("http://gadm.org/data/rda/NGA_adm1.RData") # Get Nigeria map from GADM
print(load(con)) # Load the map
close (con)

nigeria.selected_regions <- c("Adamawa", # Regions to plot
"Akwa Ibom", "Anambra", "Bauchi",
"Benue", "Borno",
"Delta", "Edo",
"Federal Capital Territory", "Imo")
nigeria_map.ff <- fortify(gadm) # Create ggplot compatible data.frame

# Extract polygon corners and merge with shapefile data
gadm@data$id <- rownames(gadm@data)
nigeria_map.df <- merge(gadm@data, nigeria_map.ff, by = "id", all.y = TRUE)

#Build up the plot
p1 <- ggplot() +
theme_bw() + theme(panel.border = element_blank(),
panel.grid.major = element_blank(),
panel.grid.minor = element_blank())
p2 <- p1 +
ggtitle("GADM Level 0 Map of Nigeria")
p2 <- p2 + geom_path(data = nigeria_map.df,
aes(x = long, y = lat, group = group))
p2 # Plot all regions

dev.new <http://dev.new>()
p3 <- p1 +
ggtitle("GADM Level 1 Map of Nigeria - Selected Regions Highlighted") +
geom_path(data = nigeria_map.df, aes(x = long, y = lat, group = group)) +
geom_polygon(data = subset(nigeria_map.df, NAME_1 %in% nigeria.selected_regions),
aes(x = long, y = lat, group = group, fill = NAME_1))
p3 # Plot selected regions

