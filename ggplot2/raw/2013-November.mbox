Well, I think both versions are identical--- if we changed facet_grid added the code from (version~color) to (color~version) as Dennis' code has.....

p1 <- ggplot(df[df$product=='p1',],aes(x=price))+ geom_point(data=df[df$product=='p3',],aes(y=price, color=skew))+facet_grid(color~version)
p1

Dennis' version:

library(reshape2)

# Reshape the data from long to wide:
dfc <- dcast(df, skew + version + color ~ product, value.var = "price")

# Plot
ggplot(dfc, aes(x = p1, y = p3, color = factor(skew))) +
  geom_point() + facet_grid(color ~ version, labeller = label_both) +
  labs(x = "Product 1 price", y = "Product 3 price", color = "skew")

Vivek

