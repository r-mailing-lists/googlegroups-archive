+scale_x_reverse(breaks=c(2,3,4,5,6), labels=c("\u2264 2","3","4","5","\u2265 6"))
+scale_fill_manual("Riskklass",values = cols,breaks=c("Låg", "Måttlig", "Hög", "Mycket hög"))
polygon

