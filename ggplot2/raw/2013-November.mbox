or perhaps

library(ggplot2)

# dtot <- function(x) dnorm(x, mean=180, sd=10)

dAa <- function(x) dnorm(x, mean=185, sd=10)
dAA <- function(x) dnorm(x, mean=210, sd=22)
daa <- function(x) dnorm(x, mean=160, sd=15)
DTOT <- function(x) daa(x) + dAa(x) + dAA(x)

qplot(1, xlab='Weight', ylab='Frequency', xlim=c(80,280), binwidth=1) +
  stat_function(fun=daa, color='blue') +
  stat_function(fun=DTOT, color='black') +
  stat_function(fun=dAa, color='red') +
  stat_function(fun=dAA, color='purple') +
  geom_vline(aes(xintercept=200), color='green')

cheers,
Sean

