Message-ID: <n3Ns5lVXACk.etY9rShkCxoJ@ggplot2.groups.google.com>
Archived-At: <https://groups.google.com/g/ggplot2/c/n3Ns5lVXACk/m/etY9rShkCxoJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

It seems that there is over-jittering in the following example. Ideas?

# Read in abalone data

abalone<-read.csv(url("http://archive.ics.uci.edu/ml/machine-learning-databases/abalone/abalone.data"),

                header=FALSE)

names(abalone)<-c("Sex", "Length", "Diameter", "Height",

                "WholeWgt", "ShuckedWgt", "VisceraWgt", "ShellWgt", "Rings")

str(abalone)

# find ranges

range(abalone$Diameter) # note this range in particular

range(abalone$Rings)

# make 3 graphs

windows(4,4)

qplot(Diameter, Rings, data=abalone)

                # all seems fine

windows(4,4)

qplot(Diameter, Rings, data=abalone, position="jitter")

                # Rings: seems fine

                # But Diameter is over-jittered

# swap x,y

windows(4,4)

qplot(Rings,Diameter, data=abalone, position="jitter")

                # Both Rings and Diameter seem fine

