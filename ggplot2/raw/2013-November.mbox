+geom_point(size=7, data=Bed2, aes(x=Samplex, y=Sampley, shape=Analys, colour=Prov))
polygon

polygon<-polygon+opts(panel.border = theme_rect(colour = NA, fill = NA), title=" Försurningspotential, S (mg/kg)")

+geom_segment(data=Segments,aes(x=Sx,xend =Sx1,y=Sy,  yend =Sy1),size=0.75)
+opts(axis.ticks = theme_segment(size = 0.75))
