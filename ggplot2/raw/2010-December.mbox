plerrbar<-ggplot2::geom_errorbar(data=res.df,stat="identity",

aes(ymin=ymin,ymax=ymax),width=0.2,position=position_dodge(width=0.50))

qqq + pltgeom + pltxtfnty + pltheme + plerrbar

