Hi, here is an example:

ggplot(ass, aes(factor(diag),assort)) +
  geom_boxplot(aes(fill = factor(task)), position=position_dodge(width=0.9)) +
  geom_text(aes(x,y,label=v), data.frame(x=factor(0:2),
y=rep(0.45,3),v=c("*","","*")))

