From u5196f936ff792c35 at groups.google.com  Mon Dec 13 15:32:52 2010
From: u5196f936ff792c35 at groups.google.com (Brandon Hurr)
Date: Mon, 13 Dec 2010 15:32:52 +0000
Subject: Re: No symbols in legend
Message-ID: <rNFNIdtDW80.A5Mkal3yksIJ@ggplot2.groups.google.com>
In-Reply-To: <rNFNIdtDW80.5Jqzw3jZzcoJ@ggplot2.groups.google.com>
References: <rNFNIdtDW80.5Jqzw3jZzcoJ@ggplot2.groups.google.com>
Archived-At: <https://groups.google.com/g/ggplot2/c/rNFNIdtDW80/m/A5Mkal3yksIJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

legend=F in your geom_point() call does the trick.

library(maptools)
library(ggplot2)
gpclibPermit()

myshp<- readShapeSpatial(system.file("shapes/sids.shp",
                        package="maptools"))

myshp.points<- fortify.SpatialPolygonsDataFrame(myshp,
                          region="CNTY_ID")

shpm<- merge(myshp.points, myshp, by.x="id", by.y="CNTY_ID")

p <- ggplot(shpm, aes(long, lat, group=group, fill=NWBIR74))
p <- p + geom_polygon() + geom_path(color = "white") + coord_equal()

cities <- data.frame(long = c(-78.644722, -80.843333, -82.555833),
                    lat  = c( 35.818889, 35.226944, 35.58),
                    lab  = c("Raleigh", "Charlotte", "Asheville"))

p <- p + geom_point(aes(fill=NULL, group=NULL, group=lab),

                   data=cities, shape=3, size = 2, legend=F)

## Perfect!
p

HTH,

B

