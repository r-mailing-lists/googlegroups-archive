Hi, here is an example:

# raw data
n <- 5
d <- data.frame(id=1:n, m0=sample(n), m1=sample(n), m2=sample(n))

# reshape by melt
d2 <- melt(d, id="id")

# reorder the factor
d2$variable <- factor(d2$variable, levels=c("m2","m0","m1"))

# plot
ggplot(d2, aes(id, value, fill=variable)) + geom_area()

--
