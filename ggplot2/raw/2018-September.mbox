Something like this should get you started. A similar example can be found in ggplot2 documentation: https://ggplot2.tidyverse.org/reference/geom_bar.html

library(ggplot2)
library(tidyr)

set.seed(357)
xy <- data.frame(x1 = sample(1:10, 4, replace = TRUE),
                 x2 = sample(1:10, 4, replace = TRUE),
                 x3 = sample(1:10, 4, replace = TRUE))
rownames(xy) <- letters[1:4]

xy$group = rownames(xy)

gh <- gather(xy, key = key, value = value, -group)

ggplot(gh, aes(x = key, y = value, fill = group)) +
  theme_bw() +
  geom_col()

Cheers,
Roman

