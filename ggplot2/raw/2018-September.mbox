library(reshape2)
library(ggplot2)
da <- data.frame(x1 = c(40,5,3,2),x2 = c(38,5,6,1),
                 x3 = c(45,2,3,1))
da <- melt(da)
da <- cbind(da, Fact =
              c(rep(factor(letters[1:4],
                           labels = c("d","c","b","a"),
            levels = c("d","c","b","a")),3)))
library(ggthemes)
colnames(da) <- c("x","y","Fact")
da
ggplot(da, aes(x = x, y = y, fill = as.factor(Fact))) +
  geom_bar(stat = "identity", position = "stack") +
  theme_wsj() + scale_fill_wsj("rgby","")
This is my way.

