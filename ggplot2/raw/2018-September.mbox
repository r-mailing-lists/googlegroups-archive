Hey,

I could achieve a somewhat similar chart with the code below. Take a look. Hope it helps.

library (tidyverse)

x <- data.frame("x1" = c(40,5,3,2), "x2" = c(38,5,6,1), "x3" = c(45,3,2,1), "group" = c("a","b", "c", "d"))
x1 <- x %>% gather(Variable, value,x1:x3)

x1$group <- factor(x1$group, levels = rev(levels(x1$group)))
ggplot(x1, aes(x = Variable, y = value, fill = group, order= -as.numeric(group)))+
  geom_bar(stat = "identity")+
  scale_fill_brewer(palette = "Set2")

