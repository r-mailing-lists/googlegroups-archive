I'm not being clear. On the left side of the plot I want to show the
real data with a fit in red, then starting at the end of the actual
data show an extrapolation with an error cone extending out to the end
of February. When I change the scale_x_date statement to start at the
maximum of the data, then the data gets cut off. It is true that dates
are a bit painful to work with. Predict, for example, just seems to
fail. Here is all the code and the input data below.

library(ggplot2)
data = read.table("data", header=T)
Dates = as.Date(data$Date)

data = data.frame(Dates, data$Needfix)
colnames(data) = c("Date","Bugs")

#   do linear fit

fit = coef(lm(Bugs ~ Date, data = data))
weekend = weekdays(Dates) == "Sunday" | weekdays(Dates) == "Saturday"
weights = rep(1,length(Dates))
weights[weekend] = 0.1   # 1 on weekday, 0.1 on weekend
fit = lm(Bugs ~ Date, data = data, weights=weights)
#   interval from end of data to Feb 25
extrap = c(data$Date[length(data$Date)], as.Date("2011-02-25"))

#   error bounds for extrapolation

m = summary(fit)$coefficients[2]
b = summary(fit)$coefficients[1]

stderr_slope = summary(fit)$coefficients[4]
stderr_int   = summary(fit)$coefficients[3]
deltax = as.integer(as.Date("2011-02-25") - data$Date[length(data
$Date)])
deltay = stderr_slope*deltax

days = seq(as.integer(data$Date[length(data$Date)]),
as.integer(as.Date("2011-02-25")), 1)
mindays = days + deltay/(m-stderr_slope)*(days-days[1])/
(days[length(days)]-days[1])
maxdays = days - deltay/(m+stderr_slope)*(days-days[1])/
(days[length(days)]-days[1])
bugs = coef(fit)[2]*days + coef(fit)[1]
minpredict = data.frame(bugs, mindays)
maxpredict = data.frame(bugs, maxdays)

minfit = lm(bugs ~ mindays, data = minpredict)
maxfit = lm(bugs ~ maxdays, data = maxpredict)

p <- qplot(Date, Bugs, data=data, geom=c('smooth','point'),
ylim=c(0,150), main="Bugs Waiting to be Fixed")
p = p + stat_smooth(method="lm", se=FALSE, colour="red")
p = p + scale_x_date(lim = c(as.Date("2011-01-18"),
as.Date("2011-02-25")))

p = p + geom_abline(intercept=coef(fit)[1], slope=coef(fit)[2],
x=extrap, linetype=3)
p = p + geom_abline(intercept=coef(minfit)[1], slope=coef(minfit)[2],
x=extrap, linetype=2)

p + geom_abline(intercept=coef(maxfit)[1], slope=coef(maxfit)[2],
x=extrap, linetype=2)

