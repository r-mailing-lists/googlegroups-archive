"factor")),
.Names = c("Trial", "Cond", "V_num", "V1_pos", "V2_pos", "R_V_num",
"R_V1_pos", "R_V2_pos", "Class"),
row.names = c(NA, -20L), class = "data.frame")

data.melted <- melt(data, measure = c('R_V1_pos', 'R_V2_pos'))

myplot <- ggplot(data.melted, aes(x = V1_pos, y = value)) +
 geom_boxplot(aes(fill = variable), outlier.size = 0)

myplot + stat_summary(fun.y = mean, geom = "point",
