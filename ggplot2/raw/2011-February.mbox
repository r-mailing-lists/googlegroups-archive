1L, 1L, 2L, 2L, 1L, 1L, 2L, 2L, 2L, 2L, 2L, 2L, 1L, 2L, 2L, 1L
), .Label = c("1", "2"), class = "factor"), V1_pos = structure(c(1L,
2L, 4L, 1L, 5L, 4L, 1L, 3L, 5L, 4L, 2L, 3L, 2L, 1L, 2L, 1L, 3L,
1L, 4L, 3L), .Label = c("0", "1", "2", "3", "4"), class = "factor"),
    V2_pos = structure(c(1L, 2L, 3L, 2L, 4L, 3L, 1L, 3L, 4L,
    3L, 3L, 4L, 2L, 4L, 2L, 2L, 2L, 3L, 4L, 2L), .Label = c("1",
