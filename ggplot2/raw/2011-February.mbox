Here are two easier workaround.

library(ggplot2)
dataset <- data.frame(y = rchisq(200, df = 2))

ggplot(dataset, aes(sample = y)) + stat_qq() + geom_abline(intercept =
mean(dataset$y), slope = sd(dataset$y))

model <- lm(y ~ 1, data = dataset)
ggplot(model, aes(sample = .stdresid)) + stat_qq() + geom_abline()

Best regards,

Thierry

