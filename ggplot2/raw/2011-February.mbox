p <- ggplot(gvhd10, aes(log(FSC.H), Days))
pg <- p + geom_ribbon(aes(ymax = ..density.., ymin = -..density..),
stat = "density") + facet_grid(Days ~ ., as.table = F,  scales
="free_y") + labs(x = "log(Forward Scatter)",  y = "Days Past
Transplant")
print(pg)

