I would rewrite Dennis's code so it doesn't use coord_flip:

p <- ( ggplot(d, aes(x=y, y=x, xmin=ylo, xmax=yhi, group=categ)) +
                 theme_bw() +
                 labs(y = xlab, x = ylab) +
                 geom_point(size=3) + geom_errorbarh(width=0,height=0) +
                 geom_line(aes(x=0), lty=2) +
                 geom_text(aes(x= yhi + 1, label=size), size=3)
 )

and then do

p + facet_grid(categ~.,scales = "free_y")

Ben

