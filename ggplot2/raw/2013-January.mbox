#load ggplot2 library
library(ggplot2)

#load maps data library
library(maps)

#state-level longitude and lattitude data
ori_states <- map_data("state") # can't find "alaska" and "hawaii"

dim (ori_states) # why so many observations?

identical(ori_states$region, p1_st_data$region) # why FALSE?

#merge US map data with NSDUH estimates by region (state)
m_states <- merge (ori_states, p1_st_data,
                   by.ori_states = "region", by.p1_st_data = "state"); dim (m_states)

#reorder the rows
m_states <- m_states [order(m_states$order),];

dim(m_states)

#print tail observations
tail (m_states)

# US map on % who said - easy to get marijuana (Obt_mrj_p) from the merged data called m_states
# using the example in Hadley's ggplot2 - pages 78-79
qplot(long, lat, data=m_states, group=group, fill=ob_mrj_cat, geom="polygon")

