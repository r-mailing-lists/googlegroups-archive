I was getting all kinds of errors until I started to clean up the code a bit. You had quite a few things that were a bit odd in your code. For example, if you are calling a column in a data.frame in aes() you should only need to put Attribute and not label.data$Attribute. I also think you might have had an aberrant ()'s in there somewhere...

Does this work for you?

ggplot()+
geom_line(data = time.data
   , aes(
     x = as.numeric(Date2)
   , y = value
   , group = Attribute
   , color = Color)
   , size=1)+
geom_text(data = label.data
   , aes(
     x = Inf
   , y = value
   , label = Attribute
   , color = Color
   )
   , size=4
   , vjust=0
   , hjust=1
   )+
facet_grid(Attribute.Category~.,space="free")+
theme_bw()+
scale_x_continuous(
breaks=as.numeric(unique(time.data$Date2))
,labels=format(unique(time.data$Date2)
,format = "%b %Y"))+
theme(strip.background=element_blank(),
      strip.text.y=element_blank(),
      legend.text=element_blank(),
      legend.title=element_blank(),
      plot.margin=unit(c(1,5,1,1),"cm"),
      legend.position="none")+
 scale_colour_identity()

