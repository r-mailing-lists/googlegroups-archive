#
#Change background theme.
previous_theme <- theme_set(theme_bw())
#
#Graphic using FACET_GRID
#CHange the labels
martindfmeltmina$variable2 <- factor(martindfmeltmina$variable, labels
= c("v1 ~ (mu*g ~ g^-1)", "v2~ (mu*g ~ g^-1)", "v3~ (mu*g ~ g^-1)",
"v1[a]~ (g ~ m^-2)", "v2[a]~ (g ~ m^-2)", "v3[a]~ (g ~ m^-2)"))
