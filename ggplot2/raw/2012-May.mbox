stat_summary(fun.y=mean, geom="point", shape=5,  size=2) +
opts(legend.position="none")  + scale_fill_brewer(type="seq",
palette="Blues") + opts(axis.title.x = theme_blank()) +
opts(plot.title = theme_text(size=14, lineheight=.8, face="bold")) +
facet_wrap(~variable2, scale="free_y", ncol=2) + opts(axis.title.x=
theme_blank(), axis.text.x=theme_blank())

