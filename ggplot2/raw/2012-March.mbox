Thanks, I was able to get what I wanted (that is, to use a different variable for panel color than the one I used for facetting) by modifying your script!

dat <- data.frame(x = runif(16),
          y = runif(16),

  grp = rep(letters[1:4],each = 4),
  grp.type = rep(c("E","F"),each = 8))

ggplot(dat,aes(x = x,y = y)) +
facet_wrap(~grp) +

geom_rect(aes(fill = grp.type),xmin = -Inf,xmax = Inf,ymin = -Inf,ymax = Inf,alpha = 0.2) +
geom_point()

