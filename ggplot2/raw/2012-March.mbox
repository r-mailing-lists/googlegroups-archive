Thank you Chang,
I've just try to download to new version of ggplot2, but it looks like version 0.9.0 is not yet available.
I did run your code, but I still get an error message when I do p+geom_points:

"Error in `[.data.frame`(plot$data, , setdiff(cond, names(df)), drop = FALSE) :
  undefined columns selected"

Is this related to the ggplot2 version? Any ideas?

In the meantime, I've also received another suggestion from Felipe Carrillo, which allows me to plot plot the polygon but without unfortunately the facet_wrap(~month, ncol=2) option.

library(rgdal)
library(ggplot2)
library(sp)
library(maptools)
gpclibPermit() # you won't need this if using the rgeos package

shape <- readOGR(dsn=".", layer="Projections")
names(shape);dim(shape)
shape@data$id <- rownames(shape@data)
 #fortify to plot with ggplot2
   shape_fort <- fortify(shape,region="id")

  # Import the csv points
  aurelie_points <- read.csv("OT1.csv")
  head(aurelie_points);dim(aurelie_points)

OTz<-aurelie_points[with(aurelie_points,aurelie_points$TSUM=="0"),] #selecting only my zeros
    OTc<-aurelie_points[!with(aurelie_points,aurelie_points$TSUM=="0"),]
   Aurelie:
The code could be compacted a little bit but did it this way so you can see what's being done step by step. I will
try to make facet_wrap work when I get a chance. If you want to see the points from OTz on a legend, you could
shorten the limits of the existing legend and make the other legend show below it...just a thought.
library(gridExtra)
 # I added the points from OTz to this one so you can see both
 # datsets on the same graph...you might also want to add a title to
 # distinguish the different months.
 a <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==7),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
    geom_point(data=subset(OTz,month==7),
   colour=alpha("black",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
 b <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==8),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   geom_point(data=subset(OTz,month==8),
   colour=alpha("black",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
c <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==9),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
d <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==10),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
e <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==11),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
 f <- ggplot(shape_fort, aes(long,lat,group=group)) +
   geom_polygon(fill="lightblue") +
   geom_path(color="green") + geom_point(data=subset(OTc,month==12),
   colour=alpha("red",0.2),aes(longitude,latitude,size=TSUM,group=NULL)) +
   theme_bw()
 grid.arrange(a,b,c,d,e,f)

