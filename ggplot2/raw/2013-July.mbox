library(ggplot2)
library(grid)
library(tikzDevice)

area_k_mer <- function(k){

area_overlap <- 0.475

area_tot <- k*pi

res <- area_tot-(k-1)*area_overlap
return(res)

}

area_rogak <- function(k){

alpha <- 0.85

area_tot <- pi*(1+alpha*(k-1))

res <- area_tot
return(res)

}

area_lapuerta <- function(k){

z <- 0.8488+0.1512/k

area_tot <- z*k*pi

res <- area_tot
return(res)

}

