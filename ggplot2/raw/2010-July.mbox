Melt may be getting confused.  Try

t.start <- as.POSIXct(strptime('1/4/2005/00',"%d/%m/%Y/%H"))
dum.frame <- data.frame(time=t.start + (3600*(0:(1*24))),

                         var1=1:25,
                         var2=runif(25),
                         label=factor(c(rep('a',13),rep('b',12))))

dum.frame$time = as.character(dum.frame$time)
m.dum <- melt(dum.frame)
m.dum$time = as.POSIXct(m.dum$time, tz="MST")

Mark

