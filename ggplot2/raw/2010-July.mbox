How to add labels to boxplot if boxplot is dodged?
In the archive, I found a solution for faceted boxplots. But how to do
it for dodged boxplots?

#Solution for faceted boxplots
dummy <- data.frame(values = rnorm(30), fac1 = factor(rep(rep(1:3,
each
= 5), 2)), fac2 = factor(rep(1:2, each = 15) ))
p <- ggplot(dummy, aes(fac1, values)) + geom_boxplot() + facet_wrap(~
fac2)

# add letters for post-hoc Tukey results above upper whiskers
lettpos <- function(dummy)   boxplot(dummy$values)$stats[5,]
test <- ddply(dummy, .(fac2, fac1), lettpos)
test$lett <- rep("a", nrow(test))
colnames(test)[3] <- "upper"
p + geom_text(aes(fac1, upper + 0.05, label = lett), data = test,
vjust
= 0)

