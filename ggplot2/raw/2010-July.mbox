Good but what about a custom palette?

paleta <-
c("#2283DE","#27D971","#00FF00","#E2871E","#E5621B","#AAC040","#BCB644","#14A1DE")
names(paleta)[1 : length(paleta)] <- levels(rads$class_ang)

plot(1:8,pch=20,col=c("#2283DE","#27D971","#00FF00","#E2871E","#E5621B","#AAC040","#BCB644","#14A1DE"))

win.graph()

ggplot(data = rads, aes(x = x,y = y)) +
  # geom_text(aes(label = ang, size=3), hjust = 0, vjust = 0) +
  stat_spoke(aes(angle=V2, colour = class_ang), radius = 0.5,
    arrow = arrow(length = unit(0.1, "inches")))

win.graph()

ggplot(data = rads, aes(x = x,y = y)) +
  # geom_text(aes(label = ang, size=3), hjust = 0, vjust = 0) +

  stat_spoke(aes(angle=V2, colour = paleta[rads$class_ang]), radius =

0.5,
    arrow = arrow(length = unit(0.1, "inches")))

