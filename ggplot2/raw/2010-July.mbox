You can achieve order control like this ...

n  <- 100
x1 <- cbind(1:n,rnorm(n,sd=10))
x2 <- cbind(1:n,rnorm(n,sd=3))
df <- data.frame(rbind(x1,x2))
names(df) <- c("x","y")
df$metric <- as.factor(c(rep("A",n),rep("B",n)))

# Important Line Below
df$metric <- factor(df$metric,levels=c("B","A"))
# Important Line Above

bi <-  ggplot(df, aes(x=x)) + geom_line(aes(y=y)) +
facet_wrap(~metric,nrow=1,ncol=2)
print(bi)

HTH, Joh

