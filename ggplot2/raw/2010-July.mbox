Hi,

The necessary package are explicitly presented in the code, but
anyway :

library(CircStats)
library(ggplot2)
#! Teste calculo de ângulos em graus e
radianos---------------------------------

rads <- data.frame("ang" = 0:360)
for(i in 0:360){
rads[i+1,2] <- circ.mean(rad(i))
}
rads$deg <- round(CircStats::deg(rads$V2))

rads$deg[rads$V2 < 0  & rads$V2 >= -2.449294e-16] <- 360

rads$deg[rads$deg < 0] <- -(-360 - (rads$deg[rads$deg < 0]))
rads$class_ang <- cut(rads$deg, breaks=c(0, 45, 90, 135, 180, 225,
270, 315, 360.1),
 include.lowest = T, right = F, labels = c("0-45", "45-90", "90-135",
"135-180",
 "180-225", "225-270", "270-315", "315-360"))

rads$x <- expand.grid(1:19,1:19)$Var1
rads$y <- expand.grid(19:1,19:1)$Var2
gr <- ggplot(data = rads, aes(x = x,y = y)) + geom_point(size=0.01,
alpha=0.1)

gr +  geom_text(aes(label = rads$ang), size=2.5, hjust = 0, vjust =

0)+
stat_spoke(aes(angle=V2), radius = 0.5, arrow = arrow(length =
unit(0.1, "inches"))) #+ geom_text(label = degNum)

