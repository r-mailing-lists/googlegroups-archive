pushViewport( viewport( layout=grid_layout ) ) align.plots( grid_layout,
         list( temp.gg <http://temp.gg>, 1, 1:2 ),
         list( source.gg <http://source.gg>, 2, 1 ),
         list( status.gg <http://status.gg>, 3, 1 ),
         list( source.gg <http://source.gg>, 2:3, 2 ) )

