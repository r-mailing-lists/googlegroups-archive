References: <KaT5B5K8R9E.JCQJiQsu008J@ggplot2.groups.google.com> <KaT5B5K8R9E.MZQxSH35q1sJ@ggplot2.groups.google.com>
Archived-At: <https://groups.google.com/g/ggplot2/c/KaT5B5K8R9E/m/tz4I359RgjkJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

phantom() might help with the alignment,

params <- data.frame(a=c(0.5,5,1,2,2),b=c(0.5,1,3,2,5))

labs <- mlply(params, function(a,b) {
  if(length(strsplit(as.character(a),"")[[1]])==1) a <-
bquote(phantom("0.")*.(a))
  if(length(strsplit(as.character(b),"")[[1]])==1) b <-
bquote(phantom("0.")*.(b))
  bquote(alpha==.(a)~", "~beta==.(b)) })

HTH,

baptiste

