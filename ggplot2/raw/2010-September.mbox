Sorry I didn't post an example.  Here is one that demonstrates my
problem.  Notice that there is only one legend (labeled "region") when
I would prefer that there were two (one for "region" and one for "y").

library(maps)
library(ggplot2)

df_poly<-map_data("county",c("iowa","illinois"))
df_points <- data.frame(
               long=runif(5,min(df_poly$long),max(df_poly$long)),
               lat=runif(5,min(df_poly$lat),max(df_poly$lat)),
               y=c("A","B","B","A","B"))

ggplot(df_poly,aes(long,lat)) +
geom_polygon(aes(group=group,color=region), fill=NA) +
geom_point(data=df_points,aes(color=y))

