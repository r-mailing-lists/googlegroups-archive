neal,

this should do it:

df <- data.frame(path=1:10,p.1=rnorm(10),q.1=rnorm(10),r.1=rnorm(10),
p.2=rnorm(10),q.2=rnorm(10),r.2=rnorm(10),
p.3=rnorm(10),q.3=rnorm(10),r.3=rnorm(10),
p.4=rnorm(10),q.4=rnorm(10),r.4=rnorm(10),
p.5=rnorm(10),q.5=rnorm(10),r.5=rnorm(10))

require(reshape)

dfm<- melt(df, id.var="path")
dfm$value <- as.numeric(gsub("[pqr]","",as.character(dfm$variable)))
dfm$variable  <- factor(substr(as.character(dfm$variable),1,1))

Heike

