bayesplot doesn't have anything yet, but I'm on it!

The loop with repeated calls to geom_ribbon can be avoided using something like this:

dat %>%
  filter(dist %in% dist_list) %>%
  group_by(x, dist) %>%
  summarise(
    lo = first(y),
    hi = nth(y, 2),
    dist01 = first(dist01)
  ) %>%
  ggplot() +
  geom_ribbon(

    mapping = aes(
      x = x,
      ymin = lo,
      ymax = hi,

      fill = factor(dist01, levels = rev(unique(dist01)))
    ),
    alpha = 0.8,
    show.legend = FALSE
  ) +
  scale_fill_viridis(discrete = TRUE)

Jonah

