ggplot(Nov, aes(x = std, y = job, colour = job)) +
geom_segment(aes(xend = etd, yend = job), size=3) +

scale_x_datetime(major = "3 days", format = "%m/%d") +
facet_wrap(~ Month, ncol = 1, scales="free_x")

