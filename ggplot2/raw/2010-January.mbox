Use scale_y_reverse:

p = ggplot(results2,aes(SynWell_column, as.numeric(SynWell_row)))

p + geom_tile(aes(fill=totalODdna),colour="white") +
        scale_fill_gradient(low="white",high="steelblue") +

        labs(x="Column",y="Row") +
        scale_x_continuous(breaks=1:24) +

        scale_y_reverse(breaks=1:16, labels=LETTERS[1:16]) +
        opts(title=paste("Yield Map"))

