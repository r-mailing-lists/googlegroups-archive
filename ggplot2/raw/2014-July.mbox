And this is the code I used to try to reproduce the fingerprint plot:
# Calculate plot parameters
XAxis <- seq(0, 24, by=6)
YAxis <- seq(15, 345, by=30)

p1 <- ggplot(a, aes(hour, jday, z=photo_rate)) +
      stat_contour(geom='polygon', aes(fill=..level..)) +
      theme_bw(base_size = 22) +
      scale_x_continuous(breaks=XAxis) +
      scale_y_continuous(breaks=YAxis,  labels=month.abb) +
      ggtitle("Hourly rice photosynthesis rate across the growing season") +
      theme(axis.title.x=element_blank(), axis.title.y=element_blank()) +
      theme(aspect.ratio = 1)
print(p1)

