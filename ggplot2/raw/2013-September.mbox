x   1.00E-04

  # via base R:

  boxplot(df$value ~ df$station,

  main="base R: zoomed in,
with \nno negatives in y range")

# via ggplot2:

  library(ggplot2)

  ggplot(df, aes(factor(df$station), df$value)) +

  geom_boxplot() +

  ggtitle("ggplot2: not zoomed in,
with \nnegatives in y range")
# thanks to help at stackoverflow, I've narrowed down to adding and subtracting a percentage of the median:

ggplot(df, aes(factor(df$station),
df$value)) +
geom_boxplot() +
coord_cartesian(ylim = c(min(df$value)-.5*min(df$value),
