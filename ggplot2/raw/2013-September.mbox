Sorry, this is actually what you want.

r <- read.csv("Random.csv", header = T)

r.se1 <- summarySE(r,measurevar="RAND",groupvars=c("TREAT"))
r.se2 <- summarySE(r,measurevar="RAND",groupvars=c("MALE","TREAT"))
ggplot()  +
  geom_point(aes(x=TREAT,y=RAND),r.se2) +
  geom_errorbar(aes(x=TREAT,ymin=RAND-se,ymax=RAND+se),r.se1)

