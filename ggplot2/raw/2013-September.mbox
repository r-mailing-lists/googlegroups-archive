The problem is that geom_point does not pass lwd on to gpar(), the custom geom below will do what you want:

GeomPoint2 <- proto(ggplot2:::GeomPoint, {
  objname <- "point2"
  default_aes <- function(.) aes(shape=16, colour="black", size=2, fill = NA, alpha = NA, thickness=1)
  draw <- function(., data, scales, coordinates, na.rm = FALSE, ...) {
    data <- remove_missing(data, na.rm, c("x", "y", "size", "shape", "thickness"), name = "geom_point")
    if (empty(data)) return(zeroGrob())
    with(coord_transform(coordinates, data, scales),
         ggname(.$my_name(), pointsGrob(x, y, size=unit(size, "mm"), pch=shape, gp=gpar(col=alpha(colour, alpha), fill = alpha(fill, alpha), lwd = thickness, fontsize = size * .pt)))
    )
  }
})

geom_point2 <- function (mapping = NULL, data = NULL, stat = "identity", position = "identity", na.rm = FALSE, ...) {
  GeomPoint2$new(mapping = mapping, data = data, stat = stat, position = position, na.rm = na.rm, ...)
}

ggplot(df2, aes(x=x, y=y)) + geom_point2(aes(size=z, thickness=z2), shape=23, colour="Red", fill="Black") + scale_shape_identity()

