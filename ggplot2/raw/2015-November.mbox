ggplot(dt,aes(O_TFR,TFR))+
  geom_point(col="green")+
  geom_segment(aes(x=O_TFR,y=TFR,xend=TFR_1.1,yend=TFR_1))+
  geom_point(aes(TFR_1.1,TFR_1), col="red")

