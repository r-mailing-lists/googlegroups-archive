Indeed, but why?

Using unname() works Thomas.

require(ggthemes)
require(ggplot2)

accents <- ggthemes_data$solarized$accent[rep(1:8,times=2)]
accents
accents2 <- accents[1:length(levels(as.factor(mtcars$cyl)))]

p1 <- ggplot(mtcars, aes(mpg, wt)) +  geom_point(aes(colour = factor(cyl))) + scale_colour_manual(values=c("#b58900", "#cb4b16", "#dc322f" ))

p2 <- ggplot(mtcars, aes(mpg, wt)) + geom_point(aes(colour = factor(cyl))) + scale_colour_manual(values=unname(accents2))

str(ggplot_build(p1))
str(ggplot_build(p2))

