You need to define the grouping yourself:

library(ggplot2)

mydf <- data.frame(
  id = rep(1:90, each = 3),
  tmt = rep(c("A", "B", "C"), each = 90),

  time = rep(c(10, 20, 40),90),
  y = rnorm(270)
)

ggplot(mydf, aes(time, y, fill = tmt, group = interaction(time, tmt))) +
  geom_boxplot()

Hadley

