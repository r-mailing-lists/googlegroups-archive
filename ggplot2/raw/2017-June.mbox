You need to coerce the variable to a factor.

ggplot(xy, aes(x = as.factor(SYEAR), y = DOC, fill = SEASON)) +
  geom_boxplot() +
  xlab("YEAR") +
  ylab("Dissolved Organic Carbon")

ggplot(xy, aes(x = as.factor(SYEAR), y = DOC)) +
  geom_boxplot() +
  xlab("YEAR") +
  ylab("Dissolved Organic Carbon") +
  facet_wrap(~ SEASON)

