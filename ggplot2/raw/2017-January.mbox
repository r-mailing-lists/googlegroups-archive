        axis.title.x = element_blank(),
        axis.title.y = element_blank(),
        axis.text.x = element_blank(),
        axis.text.y = element_blank(),
        strip.background = element_blank(),
        complete = TRUE) +
  geom_point(data = goals, aes(x=-20.15+x_ast, y=52.5-y_ast), colour = 'khaki1', size = 2) +
  geom_point(data = goals, aes(x=-20.15+x_goal, y=52.5-y_goal), colour = 'lightcoral', size = 2) +
