hist_volume <- function(data) {
  str(data)
  filename <- 'tmp/cases/hist-volume.pdf'
  pdf(filename, width=7, height=5, pointsize=10, colormodel="rgb")
  dos = as.Date(data$Date, format="%m/%d/%Y")
  hist(dos, "months", freq=TRUE, plot=TRUE, format="%m/%y",
