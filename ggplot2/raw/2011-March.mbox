>   counts$caption[1]<- paste("N = ", sum(counts$bincount))
>   p<- ggplot(data=counts, aes(x=bin,y=bincount))  + geom_bar()
>   p<- p + geom_text(aes(x,y,label=caption),
> data=data.frame(x=nrow(counts)-1,y=30))
>   p
