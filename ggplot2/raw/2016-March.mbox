library(ggplot2)
library(tidyr)

# plot neuts
p <- ggplot(DATA, aes(Vacc, Neut_NS_new))+
  geom_boxplot()

trial_labeller <- function(var, value){
  value <- as.character(value)
  if (var=="Trial") {
    value[value=="A"] <- "2011"
    value[value=="B"]   <- "2012"
  }
  return(value)
}

p+facet_grid(.~Trial, labeller = trial_labeller)+
  xlab("Vaccination status") +ylab("1 / titre")+
  scale_x_discrete(breaks=c("n", "y"), labels=c("No", "Yes"))+
  theme(strip.text.y = element_text( size=rel(0.5)),
        strip.text.x = element_text( size=rel(0.7)),# changes the font size of the facet strip labels
        axis.line=element_line(color="grey"),
        axis.text= element_text(colour="black", size=5, angle=0,face = "plain"),
        panel.background=element_rect(fill="white"),
        panel.grid=element_line(colour="grey"),
        axis.title.x = element_text(face="plain", colour="black", size=7),
        axis.title.y = element_text(face="plain", colour="black", size=7),
        legend.title=element_text(size=6),legend.text=element_text(size=7))

Felix

