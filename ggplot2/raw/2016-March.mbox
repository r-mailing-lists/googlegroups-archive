Something like this?

xy <- data.frame(x = 1:10, y = rnorm(10))
xy$upper <- xy$y + 3
xy$z <- xy$y - 2
xy$lower <- xy$z - 3

library(ggplot2)

ggplot(xy, aes(x = x, y = y)) +
  theme_bw() +
  geom_pointrange(aes(ymax = upper, ymin = y), shape = 15) +
  geom_pointrange(aes(ymax = z, y = z, ymin = lower), shape = 16) +
  geom_line(aes(x = x, y = y)) +
  geom_line(aes(x = x, y = z))

Cheers,
Roman

