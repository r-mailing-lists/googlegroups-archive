Message-ID: <eOXj-ixCS78.tlTYHAfpcfcJ@ggplot2.groups.google.com>
In-Reply-To: <eOXj-ixCS78.dSdNyJ04tC0J@ggplot2.groups.google.com>
References: <eOXj-ixCS78.dSdNyJ04tC0J@ggplot2.groups.google.com>
Archived-At: <https://groups.google.com/g/ggplot2/c/eOXj-ixCS78/m/tlTYHAfpcfcJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Lorenzo

Here you go:

library(ggplot2)

radius <- 1
resolution <- 0.01
# construct grid

cgrid <- expand.grid(x=seq(-radius, radius, resolution), y=seq(-
radius, radius, resolution))
cgrid$incircle <- ((cgrid$x^2 + cgrid$y^2) <= radius^2)
cgrid <- cgrid[cgrid$incircle==TRUE, ]

# add colour

cgrid$colour <- abs(cos(cgrid$x/radius))
str(cgrid)

p <- ggplot(cgrid, aes(x=x, y=y)) +
  geom_tile(aes(fill=colour)) +
  scale_fill_gradient(low="red", high="blue")

print(p)

--

Andrie

