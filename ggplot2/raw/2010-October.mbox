I think you're trying to apply an alpha transparency to axis text. Can you even do that?

This is as close as I can get.

library(ggplot2)

d.frame  <- data.frame(city=rep(c("Geneve","Basel","Luzern"),each=3),

variable=rep(c("read.books","watch.tv <http://watch.tv>","shopping"),3),

mean.value=c(3.5,7.2,2.6,9.9,6.1,7.3,1.9,2.6,3.4),
                   trans=c(1,1,1,0.3,0.3,0.3,1,1,1))

d.frame$trans  <- factor (d.frame$trans)

d.frame$city[c(4:5)]  <- NA

ggplot(d.frame, aes(x=city, y=mean.value, fill=variable, alpha=trans))+
geom_bar(stat="identity",position = "dodge")+
geom_text(aes(label=((round(mean.value,0)))),position=position_dodge(width=1), colour="black", size=10,hjust=-0.3)+
geom_text(aes(x= city, y=12, label=city, size=12))+
scale_y_continuous("",limits=c(0,15))+
theme_bw()+
opts(axis.text.y = theme_blank())+
coord_flip()

