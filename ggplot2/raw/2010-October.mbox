Manuel

There is always a way, but first you have to describe in words what
you want the plot to look like.

Here is a starting point.  First, I put your data into a data.frame,
and then plotted some of the variables using a combination of colour
and facets.

You can build on this by labelling your variables using descriptive
names (1 and 0 are good for modelling, but not descriptive for
graphing).  You can build on this even more by combining some of your
predictors into super-categories.  For example, you can combine 'piso'
and 'paredes' into a single variable 'piso.paredes' with four
different levels, and use this combined variable as a faceting
variable.

library(ggplot2)
library(reshape)

d <- structure(list(n = 1:32, iluminacion = c(0L, 1L, 0L, 1L, 0L,
1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L,
1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L, 0L, 1L), animales = c(0L,
0L, 1L, 1L, 0L, 0L, 1L, 1L, 0L, 0L, 1L, 1L, 0L, 0L, 1L, 1L, 0L,
0L, 1L, 1L, 0L, 0L, 1L, 1L, 0L, 0L, 1L, 1L, 0L, 0L, 1L, 1L),
    cielo.raso = c(0L, 0L, 0L, 0L, 1L, 1L, 1L, 1L, 0L, 0L, 0L,
    0L, 1L, 1L, 1L, 1L, 0L, 0L, 0L, 0L, 1L, 1L, 1L, 1L, 0L, 0L,
    0L, 0L, 1L, 1L, 1L, 1L), piso = c(0L, 0L, 0L, 0L, 0L, 0L,
    0L, 0L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 0L, 0L, 0L, 0L, 0L,
    0L, 0L, 0L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L), paredes = c(0L,
    0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L, 0L,
    1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L, 1L,
    1L), condicion = c(0.3955409, 0.2881366, 0.5093029, 0.3909893,
    0.3629202, 0.2605554, 0.4746677, 0.3585214, 0.4289568, 0.317241,
    0.5436852, 0.4242906, 0.3953829, 0.288001, 0.5091378, 0.390832,
    0.3651755, 0.2624367, 0.4770974, 0.3607648, 0.3336766, 0.2364983,
    0.4426765, 0.329449, 0.397714, 0.2900027, 0.5115721, 0.3931537,
    0.3650223, 0.2623088, 0.4769325, 0.3606124), ucl = c(0.5282769,
    0.4219901, 0.6329608, 0.530814, 0.5072199, 0.39672, 0.6159702,
    0.5063956, 0.5914158, 0.4807612, 0.6945761, 0.5939351, 0.5740095,
    0.4571859, 0.6828918, 0.5734134, 0.5230834, 0.3946978, 0.6421186,
    0.5107178, 0.5141625, 0.3825463, 0.6381145, 0.5012936, 0.5106134,
    0.3903442, 0.6202424, 0.4962814, 0.5212488, 0.3938309, 0.6378933,
    0.5075854), lcl = c(0.26280477, 0.154283, 0.38564512, 0.25116467,
    0.2186204, 0.12439083, 0.33336522, 0.21064711, 0.26649775,
    0.15372074, 0.39279424, 0.25464619, 0.21675624, 0.11881614,
    0.3353838, 0.20825054, 0.20726754, 0.1301755, 0.3120762,
    0.21081188, 0.15319072, 0.09045025, 0.24723848, 0.15760432,
    0.28481456, 0.18966116, 0.40290176, 0.29002601, 0.20879575,
    0.13078659, 0.31597173, 0.21363949)), .Names = c("n",
"iluminacion",
"animales", "cielo.raso", "piso", "paredes", "condicion", "ucl",
"lcl"), class = "data.frame", row.names = c(NA, -32L))            #

d$iluminacion <- as.factor(d$iluminacion)
d$animales <- as.factor(d$animales)
d$cielo.raso <- as.factor(d$cielo.raso)
d$piso <- as.factor(d$piso)
d$paredes <- as.factor(d$paredes)

meltd <- melt(d, id.vars=1:6)
str(meltd)

p <- ggplot(meltd, aes(x=iluminacion, y=value, colour=variable)) +
  facet_grid(animales~cielo.raso) +
  geom_point()
print(p)

Andrie

