FYI - In lieu of request, here is a reproducible example you can run
with R and see that >1 factor levels produce a label on the right side
of the plots, but 1 factor level does not.  I'd like the latter to
display the factor level on the right as well...

   #   Sample Data
df.multi <- data.frame(
       a=rep(c("A","B"), 5),
       x=rep(Sys.Date() - seq(1,5), each=2),
       y=runif(10)
   )

df.single <- data.frame(
       a=rep(c("A"), 10),
       x=Sys.Date() - seq(1,10),
       y=runif(10)
   )

library(ggplot2)

   #   This plot has labels on the far right that show the value of
'a'
(p.multi <- ggplot( df.multi, aes(x, y)) +
           geom_line() +
           facet_grid(a ~ .)
)

   #   This plot DOES NOT HAVE labels on the far right that show the
value of 'a'
(p.single <- ggplot( df.single, aes(x, y)) +
           geom_line() +
           facet_grid(a ~ .)
)

