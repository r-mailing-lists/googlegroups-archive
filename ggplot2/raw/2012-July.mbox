Ouah,

I did it ... thanks.

JJ$Sunset2 <- as.numeric(difftime( JJ$Sunset, strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) ))
JJ$Sunrise2 <- as.numeric(difftime( JJ$Sunrise, strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) ))
JJ$difftime<-JJ$Sunset2
LL2$difftime <- as.numeric(difftime( LL2$value, strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) ))
JJ2$difftime <- as.numeric(difftime( JJ2$value, strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) ))
JJSunset<-subset(JJ2,variable=='Sunset')
JJSunrise<-subset(JJ2,variable=='Sunrise')
ggplot(JJ2,aes(Date,difftime))+geom_line(aes(Date,difftime,color=variable),size=1)
+geom_point(data=LL2,aes(Date,difftime,shape=Lake),size=3)+ylab('Time')
+guides(color=guide_legend(title=''))
+scale_shape_manual(values=c(1,3,17))
+ylim(as.numeric(difftime(strptime('2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ),
strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) )),
as.numeric(difftime(strptime( '2012-03-13 12:00:00',format='%Y-%m-%d %H:%M:%S'),
strptime( '2012-03-12 12:00:00',format='%Y-%m-%d %H:%M:%S' ) )))
+scale_y_continuous(limits=c(0,24), breaks=seq(0,24,3),labels=paste(c(12,15,18,21,0,3,6,9,12),"00",sep=":" ) )
+geom_ribbon(data=JJ,aes(ymin=Sunset2,ymax=Sunrise2),fill='black',alpha=0.2)
+geom_ribbon(data=JJSunset,aes(ymin=0,ymax=difftime),fill='yellow',alpha=0.2)
+geom_ribbon(data=JJSunrise,aes(ymin=difftime,ymax=24),fill='yellow',alpha=0.2)
+annotate('text', x = strptime('2012-05-20',format='%Y-%m-%d'),y=12,label='Night')
+annotate('text', x = strptime('2012-05-20',format='%Y-%m-%d'),y=21,label='Day')
+annotate('text', x = strptime('2012-05-20',format='%Y-%m-%d'),y=3,label='Day')

