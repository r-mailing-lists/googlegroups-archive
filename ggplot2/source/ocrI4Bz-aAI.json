    [
     1,
     "Answering my own question about line size this seems to do the trick:\r<br>"
    ],
    [
     2,
     "\r<br>library(ggplot2)\r<br>mydata&lt;-data.frame(x=1:10,y=c(1:5,5:1),g=rep(c(&quot;a&quot;,&quot;b&quot;),each=5))\r<br>"
    ],
    [
     1,
     "qplot(x,y,color=g,data=mydata,geom=&quot;path&quot;,size=I(3))\r<br>\r<br>\r<br>\r<br>\r<br>"
    ]
   ]
  },
