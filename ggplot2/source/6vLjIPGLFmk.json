x= 100*avg+100*sem,colour=factor(name)), <br>                  stat=&quot;identity&quot;,<br>                  stat_params=list(),<br>                  geom=&quot;pointrange&quot;,<br>                  geom_params=list(),<br>                  position= &quot;identity&quot;                <br>                  )+<br>                    <br>                    layer(<br>                          data=d9,<br>                          mapping=aes( x=log10(nM+1), y=100*avg  ), <br>                          stat=&quot;function&quot;,<br>                          stat_params=list(fun=drm, args=list(  formula=100*avg ~log10(nM+1),  data = d9,<br>                                                      fct = LL.4(fixed =c( NA, 0, 100, NA), names = c(&quot;Slope&quot;, &quot;Lower Limit&quot;, &quot;Upper Limit&quot;, &quot;ED50&quot;))    ))  ,<br>                          geom=&quot;line&quot;,<br>                          geom_params=list(),<br>                          position= &quot;identity&quot;                <br>                          )<br></span></div>\r\n<div style=\"LINE-HEIGHT:normal;MARGIN:0in 0in 0pt;BACKGROUND:white;VERTICAL-ALIGN:baseline\" class=\"MsoNormal\"><span style=\"FONT-FAMILY:&#39;Arial&#39;,&#39;sans-serif&#39;;COLOR:#222222;FONT-SIZE:10pt\">I get the error:</span></div>\r\n<div style=\"LINE-HEIGHT:normal;MARGIN:0in 0in 0pt;BACKGROUND:white;VERTICAL-ALIGN:baseline\" class=\"MsoNormal\"><span style=\"FONT-FAMILY:&#39;Arial&#39;,&#39;sans-serif&#39;;COLOR:#222222;FONT-SIZE:10pt\">Error in model.frame.default(formula = 100 * avg ~ log10(nM + 1), curveid = c(-3.65641728005737,  : <br>  variable lengths differ (found for &#39;(curveid)&#39;)<br></span></div>\r\n<div style=\"LINE-HEIGHT:normal;MARGIN:0in 0in 0pt;BACKGROUND:white;VERTICAL-ALIGN:baseline\" class=\"MsoNormal\"><span style=\"FONT-FAMILY:&#39;Arial&#39;,&#39;sans-serif&#39;;COLOR:#222222;FONT-SIZE:10pt\">I have tried many modifications without success.</span></div>\r\n<div style=\"LINE-HEIGH