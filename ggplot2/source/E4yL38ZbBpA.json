     1,
     "<div dir=\"ltr\"><div dir=\"ltr\"><div dir=\"ltr\"><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\">Something like this should get you started. A similar example can be found in ggplot2 documentation: <a href=\"https://ggplot2.tidyverse.org/reference/geom_bar.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://ggplot2.tidyverse.org/reference/geom_bar.html&amp;source=gmail&amp;ust=1792366450911000&amp;usg=AOvVaw0R6BCM5GPi73p4kTxXbtvU\">https://ggplot2.tidyverse.org/reference/geom_bar.html</a><br></div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\"><br></div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\">library(ggplot2)<br>library(tidyr)<br><br>set.seed(357)<br>xy &lt;- data.frame(x1 = sample(1:10, 4, replace = TRUE),<br>                 x2 = sample(1:10, 4, replace = TRUE),<br>                 x3 = sample(1:10, 4, replace = TRUE))<br>rownames(xy) &lt;- letters[1:4]</div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\"><br></div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\">xy$group = rownames(xy)<br><br>gh &lt;- gather(xy, key = key, value = value, -group)<br><br>ggplot(gh, aes(x = key, y = value, fill = group)) +<br>  theme_bw() +<br>  geom_col()</div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\"><br></div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\">Cheers,</div><div class=\"gmail_default\" style=\"font-family:trebuchet ms,sans-serif\">Roman<br></div></div></div></div><br><div class=\"gmail_quote\"></div>"
