)</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">minorx &lt;- pretty(majorx, 2 * length(majorx) + 2)</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">majorx &lt;- major$x[majorx &gt; exprg[1] &amp; majorx &lt;\nexprg[2]]</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">minorx &lt;- minor$x[minorx &gt; exprg[1] &amp; minorx &lt;\nexprg[2]]</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\"> </span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">major &lt;- data.frame(x = majorx)</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">minor &lt;- data.frame(x = minorx)</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\"> </span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\">ggplot(aes(x = x, y = y), data = df) +</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\">                </span><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">geom_vline(data = minor,\naes(xintercept = x), colour = I(&quot;grey95&quot;), size = I(0.25)) +</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">                geom_vline(data = major, aes(xintercept = x),\ncolour = I(&quot;white&quot;)) +</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">                </span><span style=\"font-size:11pt;color:rgb(31,73,125)\">geom_point() +</span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11pt;color:rgb(31,73,125)\">                </span><span style=\"font-size:11pt;color:rgb(31,73,125)\" lang=\"EN-US\">scale_x_continuous(breaks