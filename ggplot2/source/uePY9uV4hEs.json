   "parts": [
    [
     1,
     "<div style=\"word-wrap:break-word\">Hi Marcus -<div><br></div><div>Give this a shot, I think it&#39;s what you&#39;re looking for (or something similar).</div><div><br></div><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\">df<span style=\"color:#001b93\"> &lt;- </span>structure<span style=\"color:#001b93\">(</span>list<span style=\"color:#001b93\">(</span>Factor<span style=\"color:#001b93\"> = </span>structure<span style=\"color:#001b93\">(</span>c<span style=\"color:#001b93\">(</span><span style=\"color:#224f1e\">5</span>L<span style=\"color:#001b93\">, </span><span style=\"color:#224f1e\">1</span>L<span style=\"color:#001b93\">, </span><span style=\"color:#224f1e\">6</span>L<span style=\"color:#001b93\">, </span><span style=\"color:#224f1e\">2</span>L<span style=\"color:#001b93\">, </span><span style=\"color:#224f1e\">4</span>L<span style=\"color:#001b93\">, </span><span style=\"color:#224f1e\">3</span>L<span style=\"color:#001b93\">), </span>.Label<span style=\"color:#001b93\"> = </span>c<span style=\"color:#001b93\">(</span><span style=\"color:#9c2211\">&quot;a&quot;</span><span style=\"color:#001b93\">,</span></div></div></div>"
    ],
    [
     2,
     "<div style=\"word-wrap:break-word\"><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco;color:rgb(156,34,17)\">&quot;b&quot;<span style=\"color:#001b93\">, </span>&quot;c&quot;<span style=\"color:#001b93\">, </span>&quot;d&quot;<span style=\"color:#001b93\">, </span>&quot;e&quot;<span style=\"color:#001b93\">, </span>&quot;f&quot;<span style=\"color:#001b93\">), </span><span style=\"color:#000000\">class</span><span style=\"color:#001b93\"> = </span>&quot;factor&quot;<span style=\"color:#001b93\">), </span><span style=\"color:#000000\">mean.1</span><span style=\"color:#001b93\"> = </span><span style=\"color:#000000\">c</span><span style=\"color:#001b93\">(</span><span style=\"color:#224f1e\">8.8</span><span style=\"color:#001b93\">,</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco;color:rgb(34,79,30)\">3.6<span style=\"color:#001b93\">, </span>40.3<span style=\"color:#001b93\">, </span>14.7<span style=\"color:#001b93\">, </span>8<span style=\"color:#001b93\">, </span>24<span style=\"color:#001b93\">), </span><span style=\"color:#000000\">mean.2</span><span style=\"color:#001b93\"> = </span><span style=\"color:#000000\">c</span><span style=\"color:#001b93\">(</span>5.8<span style=\"color:#001b93\">, </span>1.2<span style=\"color:#001b93\">, </span>32.4<span style=\"color:#001b93\">, </span>7.1<span style=\"color:#001b93\">, </span>5.5<span style=\"color:#001b93\">,</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco;color:rgb(156,34,17)\"><span style=\"color:#224f1e\">8.7</span><span style=\"color:#001b93\">)), </span><span style=\"color:#000000\">.Names</span><span style=\"color:#001b93\"> = </span><span style=\"color:#000000\">c</span><span style=\"color:#001b93\">(</span>&quot;Factor&quot;<span style=\"color:#001b93\">, </span>&quot;mean.1&quot;<span style=\"color:#001b93\">, </span>&quot;mean.2&quot;<span style=\"color:#001b93\">), </span><span style=\"color:#000000\">row.names</span><span style=\"color:#001b93\"> = </span><span style=\"color:#000000\">c</span><span style=\"color:#001b93\">(</span><span style=\"color:#b98a23\">NA</span><span style=\"color:#001b93\">,</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco;color:rgb(156,34,17)\"><span style=\"color:#224f1e\">6</span><span style=\"color:#000000\">L</span><span style=\"color:#001b93\">), </span><span style=\"color:#000000\">class</span><span style=\"color:#001b93\"> = </span>&quot;data.frame&quot;<span style=\"color:#001b93\">)</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco;color:rgb(0,27,147);min-height:16px\"><br></div></div></div>"
    ],
    [
     1,
     "<div style=\"word-wrap:break-word\"><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\">molten_df<span style=\"color:#001b93\"> &lt;- </span>melt<span style=\"color:#001b93\">(</span>df<span style=\"color:#001b93\">)</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\">ggplot<span style=\"color:#001b93\">(</span>aes<span style=\"color:#001b93\">(</span>x<span style=\"color:#001b93\"> = </span>Factor<span style=\"color:#001b93\">, </span>y<span style=\"color:#001b93\"> = </span>value<span style=\"color:#001b93\">, </span>fill<span style=\"color:#001b93\"> = </span>variable<span style=\"color:#001b93\">),</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><span style=\"color:#001b93\">    </span>data<span style=\"color:#001b93\"> = </span>molten_df<span style=\"color:#001b93\">) + </span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><span style=\"color:#001b93\">  </span>geom_bar<span style=\"color:#001b93\">(</span>position<span style=\"color:#001b93\"> = </span><span style=\"color:#9c2211\">&#39;dodge&#39;</span><span style=\"color:#001b93\">) + </span>coord_flip<span style=\"color:#001b93\">()</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><font color=\"#001B93\"><br></font></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><font color=\"#001B93\"><span style=\"color:rgb(0,0,0);font-family:Helvetica\">Hope it helps!</span></font></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><font face=\"Helvetica\">david.</font></div></div></div>"
    ],
    [
     3,
     "<div style=\"word-wrap:break-word\"><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;font:normal normal normal 12px/normal Monaco\"><font color=\"#001B93\"><br></font></div><div><div>On Feb 25, 2009, at 10:06 PM, Marcus, Jeffrey wrote:</div><br><blockquote type=\"cite\"><span style=\"border-collapse:separate;color:rgb(0,0,0);font-family:Helvetica;font-size:12px;font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;line-height:normal;text-align:auto;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px\"><div style=\"margin-top:0in;margin-right:0in;margin-left:0in;margin-bottom:0.0001pt;font-size:12pt;font-family:&#39;Times New Roman&#39;\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10pt;font-family:Arial\">structure(list(Factor = structure(c(5L, 1L, 6L, 2L, 4L, 3L), .Label = c(&quot;a&quot;,<u></u><u></u></span></font></div><div style=\"margin-top:0in;margin-right:0in;margin-left:0in;margin-bottom:0.0001pt;font-size:12pt;font-family:&#39;Times New Roman&#39;\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10pt;font-family:Arial\">&quot;b&quot;, &quot;c&quot;, &quot;d&quot;, &quot;e&quot;, &quot;f&quot;), class = &quot;factor&quot;), mean.1 = c(8.8,<u></u><u></u></span></font></div><div style=\"margin-top:0in;margin-right:0in;margin-left:0in;margin-bottom:0.0001pt;font-size:12pt;font-family:&#39;Times New Roman&#39;\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10pt;font-family:Arial\">3.6, 40.3, 14.7, 8, 24), mean.2 = c(5.8, 1.2, 32.4, 7.1, 5.5,<u></u><u></u></span></font></div><div style=\"margin-top:0in;margin-right:0in;margin-left:0in;margin-bottom:0.0001pt;font-size:12pt;font-family:&#39;Times New Roman&#39;\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10pt;font-family:Arial\">8.7)), .Names = c(&quot;Factor&quot;, &quot;mean.1&quot;, &quot;mean.2&quot;), row.names = c(NA,<u></u><u></u></span></font></div><div style=\"margin-top:0in;margin-right:0in;margin-left:0in;margin-bottom:0.0001pt;font-size:12pt;font-family:&#39;Times New Roman&#39;\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10pt;font-family:Arial\">6L), class = &quot;data.frame&quot;)</span></font></div></span></blockquote></div><br></div></div>"
