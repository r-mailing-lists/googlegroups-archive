  {
   "id": "23MgtKbHNW4J",
   "from": "David Hajage",
   "author": "3c30c52b0f668f28",
   "date": "2009-02-26T06:55:36Z",
   "subject": "Re: Help with dotchart or barchart",
   "parts": [
    [
     1,
     "or :"
    ],
    [
     2,
     "<br>df &lt;- structure(list(Factor = structure(c(5L, 1L, 6L, 2L, 4L, 3L), .Label = c(&quot;a&quot;,<br>&quot;b&quot;, &quot;c&quot;, &quot;d&quot;, &quot;e&quot;, &quot;f&quot;), class = &quot;factor&quot;), mean.1 = c(8.8,<br>\r\n3.6, 40.3, 14.7, 8, 24), mean.2 = c(5.8, 1.2, 32.4, 7.1, 5.5,<br>8.7)), .Names = c(&quot;Factor&quot;, &quot;mean.1&quot;, &quot;mean.2&quot;), row.names = c(NA,<br>6L), class = &quot;data.frame&quot;)<br><br>"
    ],
    [
     1,
     "mdf &lt;- melt(df)<br>\r\nggplot(mdf, aes(variable, value)) + geom_point() + coord_flip() + facet_grid(Factor ~  .)<br><br clear=\"all\">David"
    ],
