    [
     1,
     "<div dir=\"ltr\">or perhaps<br><br>library(ggplot2)<br><br># dtot &lt;- function(x) dnorm(x, mean=180, sd=10)<br><br>dAa &lt;- function(x) dnorm(x, mean=185, sd=10)<br>dAA &lt;- function(x) dnorm(x, mean=210, sd=22)<br>daa &lt;- function(x) dnorm(x, mean=160, sd=15)<br>\r\nDTOT &lt;- function(x) daa(x) + dAa(x) + dAA(x)<br><br>qplot(1, xlab=&#39;Weight&#39;, ylab=&#39;Frequency&#39;, xlim=c(80,280), binwidth=1) +<br>  stat_function(fun=daa, color=&#39;blue&#39;) +<br>  stat_function(fun=DTOT, color=&#39;black&#39;) +<br>\r\n  stat_function(fun=dAa, color=&#39;red&#39;) +<br>  stat_function(fun=dAA, color=&#39;purple&#39;) +<br>  geom_vline(aes(xintercept=200), color=&#39;green&#39;)<br><br><br>cheers,<br><span></span><span></span>Sean</div>"
    ],
