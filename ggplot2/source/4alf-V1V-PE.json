     "<div dir=\"ltr\"># Hi,<div><br></div><div># I think there is a problem with geom_line:</div><div><br></div><div># Try this:</div><div><br></div><div><div>orig_data &lt;- read.csv(&quot;~/My_R/xy.csv&quot;) # File attached</div></div><div><br></div><div>require(ggplot2)</div><div>ggplot()+<br></div><div><div>geom_line(data=orig_data ,</div><div>                aes(x=x,</div><div>                      y=y),</div><div>                size=0.1,</div><div>                colour=&quot;red&quot;,</div><div>                alpha=0.6)+</div><div>theme_bw()+</div><div>coord_fixed()</div></div><div><br></div><div># Now, compare the results to this:</div><div>plot(orig_data$x,orig_data$y)</div><div>lines(orig_data$x,orig_data$y)<br></div><div><br></div><div># WHAT&#39;S GOING ON?</div><div><br></div><p style=\"text-align:center;clear:both\"><a href=\"https://lh6.googleusercontent.com/-oH_pubdlgcQ/VNfB3FWeX5I/AAAAAAAAARI/ikJfqxCYR_E/s1600/with_geom_line.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh6.googleusercontent.com/-oH_pubdlgcQ/VNfB3FWeX5I/AAAAAAAAARI/ikJfqxCYR_E/s1600/with_geom_line.png&amp;source=gmail&amp;ust=1792369659578000&amp;usg=AOvVaw2yhoc1PqR59ajVIqlmurkH\"><img src=\"https://lh6.googleusercontent.com/-oH_pubdlgcQ/VNfB3FWeX5I/AAAAAAAAARI/ikJfqxCYR_E/s320/with_geom_line.png\" border=\"0\" width=\"320\" height=\"180\"></a></p><p style=\"text-align:center;clear:both\"><a href=\"https://lh6.googleusercontent.com/-rm2oHhMvH24/VNfB6fcJh6I/AAAAAAAAARQ/y2Cdgu03t5k/s1600/with_plot_%26_lines.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh6.googleusercontent.com/-rm2oHhMvH24/VNfB6fcJh6I/AAAAAAAAARQ/y2Cdgu03t5k/s1600/with_plot_%2526_lines.png&amp;source=gmail&amp;ust=1792369659578000&amp;usg=AOvVaw3XCLjHkWrbP3kpqqbOOa0T\"><img src=\"https://lh6.go