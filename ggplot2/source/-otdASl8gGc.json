,\r<br>37.3123541, 38.72508481, 40.07685935, 40.87061957, 41.80098486,\r<br>42.39633664, 42.8368767, 43.6422874, 43.64031132, 43.722749045,\r<br>43.43987046, 43.035721135, 42.99675415, 42.767976475, 43.211522995,\r<br>43.89033617, 44.32511214, 44.687497775, 45.20113417, 45.01957008,\r<br>44.552493415, 43.85085642, 42.60540909, 41.02751841, 38.81904031\r<br>), seal = c(2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006041, 2006041,\r<br>2006041, 2006041, 2006041, 2006041, 2006041, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2006044, 2006044,\r<br>2006044, 2006044, 2006044, 2006044, 2006044, 2007009, 2007009,\r<br>2007009, 2007009, 2007009, 2007009, 2007009, 2007009, 2007009,\r<br>2007009, 2007009, 2007009, 2007009, 2007009, 2007009, 2007009,\r<br>2007009, 2007009, 2007009, 2007009, 2007009, 2007009, 2007009,\r<br>2007009, 2007009)), .Names = c(&quot;ssm_lon&quot;, &quot;ssm_lat&quot;, &quot;seal&quot;),\r<br>row.names = c(8214L,\r<br>8217L, 8220L, 8223L, 8226L, 8229L, 8232L, 8235L, 8238L, 8241L,\r<br>8244L, 8247L, 8250L, 8253L, 8256L, 8259L, 8262L, 8265L, 8268L,\r<br>8271L, 8274L, 8277L, 8280L, 8283L, 8286L, 8289L, 8292L, 8295L,\r<br>8298L, 8301L, 8304L, 8307L, 8310L, 8313L, 8316L, 8319L, 8322L,\r<br>8325L, 8328L, 8331L, 8334L, 8337L, 8340L, 8343L, 8346L, 8349L,\r<br>8352L, 8355L, 8358L, 8361L, 8364L, 8367L, 8370L, 8373L, 8376L,\r<br>8379L, 8382L, 8385L, 8388L, 8391L, 8394L, 8397L, 8400L, 8403L,\r<br>8406L, 8409L, 8412L, 8415L, 8418L, 8421L, 8424L, 8427L, 8430L,\r<br>8433L, 8436L, 8439L, 8442L, 8445L, 8448L, 8451L, 8454L, 8457L,\r<br>8460L, 8463L, 8466L, 8469L, 8472L, 8475L, 8478L, 8481L, 8484L,\r<br>8487L, 8490L, 8493L, 8496L, 8499L, 8502L, 8505L, 8508L, 8511L,\r<br>8514L, 8517L, 8520L, 8523L, 8526L, 8529L, 8532L, 8535L, 8538L,\r<br>8541L, 8544L, 8547L, 8550L, 8553L, 8556L, 8559L, 8562L, 8565L,\r<br>8568L, 8571L, 8574L, 8577L, 8580L, 8583L, 8586L, 8589L, 8592L,\r<br>8595L, 8598L, 8601L, 8604L, 8607L, 8610L, 8613L, 8616L, 8619L,\r<br>8622L, 8625L, 8628L, 8631L, 8634L, 8637L, 8640L, 8643L, 8646L,\r<br>8649L, 8652L, 8655L, 8658L, 8661L, 8664L, 10274L, 10277L, 10280L,\r<br>10283L, 10286L, 10289L, 10292L, 10295L, 10298L, 10301L, 10304L,\r<br>10307L, 10310L, 10313L, 10316L, 10319L, 10322L, 10325L, 10328L,\r<br>10331L, 10334L, 10337L, 10340L, 10343L, 10346L), class = &quot;data.frame&quot;)\r<br>\r<br># Scenario 1\r<br># this works, but I have the 180 longitude problem and the map isn&#39;t\r<br>projected\r<br>m &lt;- ggplot(data=test, aes(ssm_lon, ssm_lat,group=seal))+\r<br>\tgeom_path(colour=grey(0.75))+\r<br>        borders(&#39;world&#39;)+\r<br>\tcoord_cartesian(xlim=xrng, ylim=yrng)\r<br>print(m)\r<br>\r<br># Scenario 2\r<br># this plots, but with funky horizontal lines\r<br>m &lt;- ggplot(data=test, aes(ssm_lon, ssm_lat,group=seal))+\r<br>\tgeom_path(colour=grey(0.75))+\r<br>        borders(&#39;world&#39;)+\r<br>        coord_map(project=&#39;mercator&#39;, xlim=xrng, ylim=yrng)\r<br>print(m)\r<br>\r<br># Scenario 3 (different projection)\r<br># doesn&#39;t work, &quot;list cannot be coerced error...&quot; from mapproj\r<br>m &lt;- ggplot(data=test, aes(ssm_lon, ssm_lat,group=seal))+\r<br>       geom_path(colour=grey(0.75))+\r<br>       borders(&#39;world&#39;)+\r<br>       coord_map(project=&#39;albers&#39;,par=c(yrng[1],yrng[2]))\r<br>print(m)\r<br>\r<br>\r<br>&gt; sessionInfo()\r<br>R version 2.11.1 (2010-05-31)\r<br>i386-apple-darwin9.8.0\r<br>\r<br>locale:\r<br>[1] en_US.UTF-8/en_US.UTF-8/C/C/en_US.UTF-8/en_US.UTF-8\r<br>\r<br>attached base packages:\r<br>[1] grid      stats     graphics  grDevices utils     datasets\r<br>methods   base\r<br>\r<br>other attached packages:\r<br>[1] mapproj_1.1-8.2 maps_2.1-4      ggplot2_0.8.8   proto_0.3-8\r<br>reshape_0.8.3   plyr_1.2.1\r<br>\r<br>loaded via a namespace (and not attached):\r<br>[1] tools_2.11.1\r<br>"
