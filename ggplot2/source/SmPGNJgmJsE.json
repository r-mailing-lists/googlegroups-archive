     1,
     "<div dir=\"ltr\"><div class=\"gmail_extra\"><div class=\"gmail_extra\">theme_bw()+</div><div class=\"gmail_extra\">scale_fill_gradient(low=&quot;red&quot;, high=&quot;darkblue&quot;)</div><div class=\"gmail_extra\"><br></div><div class=\"gmail_extra\">Thanks for the reproducible example! Very helpful.</div><div class=\"gmail_extra\"><br></div><div class=\"gmail_extra\">B</div><div><br></div></div><div class=\"gmail_extra\"><br></div><div class=\"gmail_extra\"><img src=\"https://groups.google.com/group/ggplot2/attach/4d2a503f3e4ef5e7/redtodarkblue.png?part=0.1&amp;view=1\" alt=\"Inline image 1\" width=\"543\" height=\"543\"></div></div>"
