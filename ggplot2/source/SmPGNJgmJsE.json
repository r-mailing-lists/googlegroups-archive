    [
     1,
     "<div dir=\"ltr\"><div class=\"gmail_extra\">Kevin, </div><div class=\"gmail_extra\"><br></div><div class=\"gmail_extra\">I&#39;m not sure what your issue is, but scale_fill_gradient() works very well for me. </div><div class=\"gmail_extra\">See:</div><div class=\"gmail_extra\"><a href=\"http://docs.ggplot2.org/0.9.3.1/scale_gradient.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://docs.ggplot2.org/0.9.3.1/scale_gradient.html&amp;source=gmail&amp;ust=1792370204643000&amp;usg=AOvVaw0cdFdmcNe1Tk4AOpEp4eOO\">http://docs.ggplot2.org/0.9.3.1/scale_gradient.html</a></div><div class=\"gmail_extra\"><a href=\"http://docs.ggplot2.org/0.9.3.1/scale_gradient2.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://docs.ggplot2.org/0.9.3.1/scale_gradient2.html&amp;source=gmail&amp;ust=1792370204643000&amp;usg=AOvVaw338j3fr1NvHJ7KvUJcyiL2\">http://docs.ggplot2.org/0.9.3.1/scale_gradient2.html</a><br></div><div class=\"gmail_extra\"><a href=\"http://docs.ggplot2.org/0.9.3.1/scale_gradientn.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://docs.ggplot2.org/0.9.3.1/scale_gradientn.html&amp;source=gmail&amp;ust=1792370204643000&amp;usg=AOvVaw3FvHRBjlhrGyow1EF5ywlP\">http://docs.ggplot2.org/0.9.3.1/scale_gradientn.html</a><br></div><div class=\"gmail_extra\"><br></div><div class=\"gmail_extra\"><div class=\"gmail_extra\">ggplot(interp.out, aes(x, y, z = z)) + </div></div></div>"
    ],
    [
     2,
     "<div dir=\"ltr\"><div class=\"gmail_extra\"><div class=\"gmail_extra\">stat_contour(geom=&quot;polygon&quot;, aes(fill=..level..),binwidth=2) + stat_contour(binwidth=2) + facet_wrap(~freq) + </div><div class=\"gmail_extra\">scale_x_continuous(&#39;\\nAthwartship Beam Angle (deg)&#39;) + scale_y_continuous(&#39;Alongship Beam Angle (deg)\\n&#39;) +</div></div></div>"
    ],
