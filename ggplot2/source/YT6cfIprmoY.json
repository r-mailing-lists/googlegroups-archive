   "parts": [
    [
     1,
     "<div style=\"word-wrap:break-word\">Like this?<div><br></div><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\"><span style=\"color:#000000\">n </span>&lt;- <span style=\"color:#065218\">30</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\"><span style=\"color:#000000\">df </span>&lt;- data.frame(</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">  <span style=\"color:#000000\">x </span>= rnorm(<span style=\"color:#000000\">n</span>), </div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">  <span style=\"color:#000000\">y </span>= rnorm(<span style=\"color:#000000\">n</span>), </div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">  <span style=\"color:#000000\">size </span>= rexp(<span style=\"color:#000000\">n</span>),</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">  <span style=\"color:#000000\">class </span>= factor(sample(<span style=\"color:#065218\">0</span>:<span style=\"color:#065218\">1</span>, <span style=\"color:#000000\">n</span>, <span style=\"color:#000000\">replace </span>= <span style=\"color:#c3892e\">TRUE</span>))</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">)</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco\"><span style=\"color:#052499\">qplot(</span>x<span style=\"color:#052499\">, </span>y<span style=\"color:#052499\">, </span>data <span style=\"color:#052499\">= </span>df<span style=\"color:#052499\">, </span>size <span style=\"color:#052499\">= </span>size<span style=\"color:#052499\">, </span>colour <span style=\"color:#052499\">= </span>class<span style=\"color:#052499\">) + </span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 13.9px/normal Monaco;color:rgb(5,36,153)\">  scale_colour_manual(<span style=\"color:#000000\">values </span>= c(<span style=\"color:#b0140f\">&#39;0&#39; </span>= <span style=\"color:#b0140f\">&#39;red&#39;</span>, <span style=\"color:#b0140f\">&#39;1&#39; </span>= <span style=\"color:#b0140f\">&#39;green&#39;</span>))</div><div><br></div><div>HTH,</div><div>david.</div><div><br><div></div></div></div></div>"
