    [
     1,
     "Something like this?<div><br></div><div><font face=\"courier new, monospace\">dataset &lt;- read.table(&quot;JM.csv&quot;, header = TRUE, sep = &quot;,&quot;)</font></div><div><font face=\"courier new, monospace\"><br></font></div>\r\n\r\n\r\n<div><div><font face=\"courier new, monospace\">dataset$Date &lt;- with(dataset, as.Date(Date, format = &quot;%d/%m/%Y %H:%M&quot;))</font></div><div><font face=\"courier new, monospace\">dataset$month &lt;- as.factor(with(dataset, format(Date, format = &quot;%m&quot;)))</font></div>\r\n\r\n\r\n<div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">library(ggplot2)</font></div><div><font face=\"courier new, monospace\">ggplot(dataset, aes(x = month, y = Noy)) +</font></div>\r\n\r\n\r\n<div><font face=\"courier new, monospace\">  geom_boxplot() +</font></div><div><font face=\"courier new, monospace\">  theme_bw()</font></div><div><br></div><div>Cheers,</div><div>Roman</div><br><div class=\"gmail_quote\">On Wed, Jul 31, 2013 at 6:34 PM, Jean-Paul Huys <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">hu...@clarkcountynv.gov</a>&gt;</span> wrote:<br>\r\n\r\n\r\n<blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">This is the code for the plot below:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">dataset = read.csv(&quot;<a href=\"http://www.colby.edu/~mgimond/R/Meteo/Waterville_1900_2011.csv\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.colby.edu/~mgimond/R/Meteo/Waterville_1900_2011.csv&amp;source=gmail&amp;ust=1792372394480000&amp;usg=AOvVaw3Tf2RyDWIjFz9e3lr1AlmK\">http://www.colby.edu/~mgimond/R/Meteo/Waterville_1900_2011.csv</a>&quot;, na.strings=&quot;9999&quot;)<u></u><u></u></span></p>\r\n\r\n\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">Date = data.frame(Date=strptime(dataset$DATE, format=&quot;%Y%m%d&quot;, tz=&quot;EST&quot;))\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">Temp = 1.8 * (dataset$TOBS / 10) + 32<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">x    = data.frame()<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">x    = cbind(Date, Temp)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">x = na.omit(x)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">x = transform(x, Month = factor(as.POSIXlt(Date)$mon+1)) # Add a year column<u></u><u></u></span></p>\r\n\r\n\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">x<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">library(splines)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">ggplot(x,aes(Month,Temp)) + geom_boxplot(outlier.shape = NA) +\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">                           scale_x_discrete(breaks=seq(1,12,1)) +\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">                           geom_smooth(aes(group = 1), method = &quot;lm&quot;, formula = y ~ ns(x,5))<u></u><u></u></span></p>\r\n\r\n\r\n\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">I am having a problem with the “Date” format, the example has daily data, mine is hourly\r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;\">JP<u></u><u></u></span></p></div></div></blockquote></div></div>"
    ],
