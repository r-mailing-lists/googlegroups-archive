     1,
     "<div dir=\"ltr\">hi all<div><br></div><div>I&#39;m looking for a way to complete the line on a series of star plots</div><div><br></div><div><div><font face=\"courier new, monospace\">library(reshape2)</font></div><div><font face=\"courier new, monospace\">library(ggplot2)</font></div><div><font face=\"courier new, monospace\">library(plyr)</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"># this is borrowed from <a href=\"https://github.com/hadley/ggplot2/issues/516\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://github.com/hadley/ggplot2/issues/516&amp;source=gmail&amp;ust=1792371852396000&amp;usg=AOvVaw3B7fb96CbNNtOoCa_k8gVf\">https://github.com/hadley/ggplot2/issues/516</a></font></div><div><font face=\"courier new, monospace\">coord_radar &lt;- function(...) {</font></div><div><font face=\"courier new, monospace\">  structure(coord_polar(...), class = c(&quot;radar&quot;, &quot;polar&quot;, &quot;coord&quot;))</font></div><div><font face=\"courier new, monospace\">}</font></div><div><font face=\"courier new, monospace\">is.linear.radar &lt;- function(coord) TRUE</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">mtcars$id &lt;- row.names(mtcars)</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">mtcars[, c(1:5)] &lt;- llply(mtcars[, c(1:5)], function(i) scale(i))</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">mtcarsm &lt;- melt(mtcars[, c(1:5, ncol(mtcars))], id.vars  = &quot;id&quot;)</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">ggplot() + geom_line(aes(x = variable, y = value, group = id), </font></div><div><font face=\"courier new, monospace\">                     data = mtcarsm[mtcarsm$id %in% unique(mtcarsm$id)[1:4],]) + </font></div><div><font face=\"courier new, monospace\">           coord_radar() + </font></div><div><font face=\"courier new, monospace\">           facet_wrap(~id, ncol = 2)</font></div></div><div><br></div><div>which provides</div><div><br></div><p style=\"text-align:left;clear:both\"><a href=\"https://lh5.googleusercontent.com/-myEaiFte8qM/Um8jlfHYbxI/AAAAAAAAdZw/QWL_80_Gws8/s1600/Rplot.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh5.googleusercontent.com/-myEaiFte8qM/Um8jlfHYbxI/AAAAAAAAdZw/QWL_80_Gws8/s1600/Rplot.png&amp;source=gmail&amp;ust=1792371852396000&amp;usg=AOvVaw2mF11tOQz0PAQqh9ua8ZQR\"><img src=\"https://lh5.googleusercontent.com/-myEaiFte8qM/Um8jlfHYbxI/AAAAAAAAdZw/QWL_80_Gws8/s1600/Rplot.png\" border=\"0\"></a></p><p style=\"text-align:left;clear:both\">How do I complete the star diagram?</p><div><br></div><div><br></div><div><br></div></div>"
    ]
   ]
