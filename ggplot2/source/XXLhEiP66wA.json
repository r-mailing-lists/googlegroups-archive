al;border-style:none;word-break:break-all\">                                                                             </span><span style=\"color:blue\">\r\n</span><span style=\"color:blue;white-space:pre-wrap\">&gt; </span><span style=\"color:blue\">\r\n</span><span style=\"color:blue;white-space:pre-wrap\">&gt; </span><span style=\"color:blue\">\r\n</span><span style=\"color:blue;white-space:pre-wrap\">&gt; </span><span style=\"color:blue\">data %&gt;% \r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">  ggplot(aes(`Date of acquisition`, `Bperp(m)`)) +\r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">  geom_point() +\r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">  geom_segment(aes(x = centroid$`Date of acquisition`, y = centroid$`Bperp(m)`, \r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">                   xend = `Date of acquisition`, yend = `Bperp(m)`)) +\r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">  scale_x_date(date_labels = &quot;%d/%m/%Y&quot;) +\r\n</span><span style=\"color:blue;white-space:pre-wrap\">+ </span><span style=\"color:blue\">  theme_minimal()\r\n</span><span style=\"color:rgb(197,6,11)\">Error: Invalid input: date_trans works with objects of class Date only\r\n</span></pre></td></tr><tr><td align=\"left\" style=\"line-height:1.25;vertical-align:top;font-size:10pt\"></td></tr><tr><td align=\"left\" style=\"line-height:1.25;vertical-align:top;font-size:10pt\"><table cellspacing=\"0\" cellpadding=\"0\" style=\"width:735px\"><tbody><tr><td align=\"left\" width=\"1\" height=\"\" rowspan=\"1\" style=\"line-height:1.25;vertical-align:top;font-size:10pt\"><div style=\"color:blue;white-space:pre-wrap\">&gt; </div></td></tr></tbody></table></td></tr></tbody></table><br>On Thursday, April 9, 2020 at 8:40:21 PM UTC+5:30, Gok