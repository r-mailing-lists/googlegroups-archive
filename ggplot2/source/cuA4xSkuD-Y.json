ortant\"><font color=\"#000000\" face=\"arial, sans-serif\"><br></font></pre></span></pre></span></div><div><span style=\"border-collapse:separate;border-spacing:0px;background-color:rgb(29,31,33)\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"line-height:1.25;outline:none;border-style:none;word-break:break-all;font-size:10pt!important;white-space:pre-wrap!important\"><span><font color=\"#000000\" face=\"arial, sans-serif\">library(ggplot2)</font></span></pre></span></pre></span></pre></span></div><div><span style=\"border-collapse:separate;border-spacing:0px;background-color:rgb(29,31,33)\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"line-height:1.25;outline:none;border-style:none;word-break:break-all;font-size:10pt!important;white-space:pre-wrap!important\"><span><font color=\"#000000\" face=\"arial, sans-serif\">d &lt;- data.frame(x=1, y=10, z=260)</font></span></pre></span></pre></span></pre></span></div><div><span style=\"border-collapse:separate;border-spacing:0px;background-color:rgb(29,31,33)\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"outline:none;border-style:none;word-break:break-all\"><span style=\"border-collapse:separate;border-spacing:0px\"><pre style=\"line-height:1.25;outline:none;border-style:none;word-break:break-all;font-size:10pt!important;white-space:pre-wrap!important\"><span><font color=\"#000000\" face=\"arial, sans-serif\"><span style=\"font-size:10pt;line-height:1.25\">ggplot(d, aes(x, y)) + geom_tile(aes(f