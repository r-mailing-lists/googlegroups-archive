     "<div style=\"word-wrap:break-word;line-break:after-white-space\"><div><blockquote type=\"cite\"><div><div><span>&lt;my_graphic.jpeg&gt;</span></div><div><br></div><div># Example of graphic I want</div></div></blockquote></div></div>"
