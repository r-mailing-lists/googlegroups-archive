    [
     1,
     "\n\n\n\n\n\n<u></u>\n\n<u></u>\n\n\n<div bgcolor=\"white\" background=\"https://groups.google.com/group/ggplot2/attach/fa8d69b6c8686f35/image001.jpg?part=0.1\" lang=\"PT-BR\" link=\"blue\" vlink=\"purple\" style=\"margin-left:37.5pt;margin-top:15.0pt\">\n<img src=\"https://groups.google.com/group/ggplot2/attach/fa8d69b6c8686f35/image001.jpg?part=0.1\" width=\"0\" height=\"0\" style=\"display:none;width:0;min-height:0\">\n\n<div>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\"> Hi,<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">Anybody knows how can  change de font family, size, and\nother parameters of the ylab and xlab?<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin:0cm;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">This is\nan example of my plot:<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">library(ggplot2)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">posx\n&lt;- theme_text(angle=45,hjust=1,face=&#39;bold&#39;,size=12)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">posy\n&lt;- theme_text(angle=0,hjust=1,face=&#39;bold&#39;,size=12)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\"><u></u> <u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">y1\n&lt;- c(1,4,6,1,8,10,6,1,5,4)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\"><u></u> <u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">x &lt;-\nqplot(x=factor(paste(&#39;nomes&#39;,1:10),labels=paste(&#39;nomes&#39;,1:10)),<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">      \ny= y1 , label=y1,<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">      \ngeom=&#39;bar&#39;,margins=F, stat=&quot;identity&quot;,xlab=&#39;&#39;,ylab=&#39;Y Label&#39;)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin-right:0cm;margin-bottom:0cm;margin-left:37.5pt;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">x &lt;-\nx + opts(axis.text.x=posx,axis.text.y=posy) + geom_bar(fill=c(rgb(000,100,000,maxColorValue=255),rep(rgb(110,139,061,maxColorValue=255),9)))<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\" style=\"margin:0cm;margin-bottom:.0001pt\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">x +\ngeom_text(hjust=.5,vjust=-.3,size=4.5)<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\"><u></u> <u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">I want to put ylab with size = 14, face = ‘bold’<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">Thanks for any advance.<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">Regards,<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,&quot;sans-serif&quot;;color:#006666\">Leandro Marino<u></u><u></u></span></p>\n\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"color:black\"><u></u> <u></u></span></p>\n\n<div>\n\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;Tw Cen MT&quot;,&quot;sans-serif&quot;;color:black\">Atenciosamente,<br>\n</span><b><span style=\"font-size:11.0pt;font-family:&quot;Tw Cen MT&quot;,&quot;sans-serif&quot;;color:#000040\">Leandro Lins Marino</span></b><b><span style=\"font-size:10.0pt;font-family:&quot;Tw Cen MT&quot;,&quot;sans-serif&quot;;color:#000040\"><br>\n</span></b><i><span style=\"font-size:10.0pt;font-family:&quot;Tw Cen MT&quot;,&quot;sans-serif&quot;;color:gray\">Centro de Avali