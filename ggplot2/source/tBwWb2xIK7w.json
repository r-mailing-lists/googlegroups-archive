</span><span style=\"color:#066\">0.5</span><span style=\"color:#660\">)+</span><span style=\"color:#000\"><br>  theme_bw</span><span style=\"color:#660\">()+</span><span style=\"color:#000\">theme</span><span style=\"color:#660\">(</span><span style=\"color:#000\">axis</span><span style=\"color:#660\">.</span><span style=\"color:#000\">ticks</span><span style=\"color:#660\">.</span><span style=\"color:#000\">length</span><span style=\"color:#660\">=</span><span style=\"color:#000\"> unit</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0.3</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;cm&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>                   panel</span><span style=\"color:#660\">.</span><span style=\"color:#000\">grid</span><span style=\"color:#660\">.</span><span style=\"color:#000\">major </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> element_blank </span><span style=\"color:#660\">(),</span><span style=\"color:#000\"><br>                   panel</span><span style=\"color:#660\">.</span><span style=\"color:#000\">grid</span><span style=\"color:#660\">.</span><span style=\"color:#000\">minor </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> element_blank </span><span style=\"color:#660\">())</span><span style=\"color:#000\"><br><br></span></div></code></div></div>"
