    [
     1,
     "<div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#800\"># Extract plot data</span><span style=\"color:#000\"><br>pb </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> ggplot_build</span><span style=\"color:#660\">(</span><span style=\"color:#000\">p</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>d </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> pb$data</span><span style=\"color:#660\">[[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]][</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;x&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;ncount&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;count&quot;</span><span style=\"color:#660\">)]</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Get quantile breaks</span><span style=\"color:#000\"><br>breaks </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> quantile</span><span style=\"color:#660\">(</span><span style=\"color:#000\">rep</span><span style=\"color:#660\">(</span><span style=\"color:#000\">d$x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> d$count</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Interpolate x and y values</span><span style=\"color:#000\"><br>xvals </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> seq</span><span style=\"color:#660\">(</span><span style=\"color:#000\">min</span><span style=\"color:#660\">(</span><span style=\"color:#000\">d$x</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> max</span><span style=\"color:#660\">(</span><span style=\"color:#000\">d$x</span><span style=\"color:#660\">),</span><span style=\"color:#000\">length</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1000</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>d </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span><span style=\"color:#660\">(</span><span style=\"color:#000\">approx</span><span style=\"color:#660\">(</span><span style=\"color:#000\">d$x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> d$ncount</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> xout</span><span style=\"color:#660\">=</span><span style=\"color:#000\">xvals</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Add grouping variable by quartile</span><span style=\"color:#000\"><br>d$quart </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> cut</span><span style=\"color:#660\">(</span><span style=\"color:#000\">d$x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(-</span><span style=\"color:#606\">Inf</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> breaks</span><span style=\"color:#660\">[</span><span style=\"color:#066\">2</span><span style=\"color:#660\">:</span><span style=\"color:#066\">4</span><span style=\"color:#660\">],</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Inf</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Fill plot by quartile</span><span style=\"color:#000\"><br>p </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> geom_area</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">=</span><span style=\"color:#000\">d</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> aes</span><span style=\"color:#660\">(</span><span style=\"color:#066\">10</span><span style=\"color:#660\">^</span><span style=\"color:#000\">x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> fill</span><span style=\"color:#660\">=</span><span style=\"color:#000\">quart</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> alpha</span><span style=\"color:#660\">=</span><span style=\"color:#066\">0.3</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> show</span><span style=\"color:#660\">.</span><span style=\"color:#000\">legend</span><span style=\"color:#660\">=</span><span style=\"color:#000\">FALSE</span><span style=\"color:#660\">)</span></div></code></div><br><br><br></div>"
