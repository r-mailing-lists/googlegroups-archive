g:0px;margin-bottom:30px\">\r\n  <ul style=\"margin-left:3px;padding-left:0px\">\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_0\" rel=\"nofollow\">\r\n      Error with geom_text</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_1\" rel=\"nofollow\">\r\n      Plot with 2 y axes</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_2\" rel=\"nofollow\">\r\n      qplot()  Error: Unknown parameters: span</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_3\" rel=\"nofollow\">\r\n      Dynamically using expression in legend labels</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n  </ul>\r\n</div>\r\n\r\n\r\n\r\n  \r\n  <a name=\"m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_0\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/d737ed3dbc02250e?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/d737ed3dbc02250e?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772551000&amp;usg=AOvVaw1WUbSjvMF37cySZ2ZDdV82\">\r\n      Error with geom_text\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        &quot;Manuel Spínola&quot; &lt;<a href data-email-masked rel=\"nofollow\">mspin...@gmail.com</a>&gt;: Aug 19 07:45AM -0600\r\n      </span>\r\n      <br><br>\r\n      Dear group members,<br>\r\n <br>\r\nI am trying to label point estimates, lower and upper confidence limits in<br>\r\ngeom_pointrange but I got an error.  The problem is with the 2 last<br>\r\ngeom_text in my code.\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cc0ff228f7ac8?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cc0ff228f7ac8?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772552000&amp;usg=AOvVaw228cNS3W3mmiL9ltCN8ReV\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_1\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/785c14a2be2464eb?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/785c14a2be2464eb?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772552000&amp;usg=AOvVaw3Vz4OESNWdM2YXwSLCmlq4\">\r\n      Plot with 2 y axes\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Thang Khong &lt;<a href data-email-masked rel=\"nofollow\">khongth...@gmail.com</a>&gt;: Aug 19 01:03AM -0700\r\n      </span>\r\n      <br><br>\r\n      Dear all,<br>\r\nI want to draw a plot with two different y axes using ggplot2.<br>\r\n <br>\r\ndf &lt;- read.csv(file.choose(), header =  TRUE)<br>\r\nsummary(df)<br>\r\nhead(df)<br>\r\n <br>\r\n##-------------<br>\r\n <br>\r\nlibrary(ggplot2)\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cb8acf558e840?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cb8acf558e840?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772552000&amp;usg=AOvVaw0TUCsh2ovvDfrr3O1r04sI\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_group_thread_2\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/5e4a71b6b1f4f434?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/5e4a71b6b1f4f434?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772552000&amp;usg=AOvVaw3Pk2lrOJd9HFTHyIFtxiLy\">\r\n      qplot()  Error: Unknown parameters: span\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Benny Guo &lt;<a href data-email-masked rel=\"nofollow\">baili...@gmail.com</a>&gt;: Aug 18 07:43PM -0700\r\n      </span>\r\n      <br><br>\r\n      I use the example code in* ggplot2. Elegant Graphics for Data Analysis* to <br>\r\nplot . I encounter the error message below:<br>\r\n <br>\r\n&gt; &gt; qplot(carat, price, data = dsmall, geom = c(&quot;point&quot;, &quot;smooth&quot;), span =\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cb8aaf1e23e23?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cb8aaf1e23e23?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772552000&amp;usg=AOvVaw0KVOLfDXEXIk_J6VZ7XErz\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5195728647908591663_m_-909757240316540167_m_2448509381725641240_digest_top\" rel=\"nofollow\"