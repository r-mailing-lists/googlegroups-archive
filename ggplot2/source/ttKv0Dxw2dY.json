18660_m_2448509381725641240_group_thread_0\" rel=\"nofollow\">\r\n      Error with geom_text</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_group_thread_1\" rel=\"nofollow\">\r\n      Plot with 2 y axes</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_group_thread_2\" rel=\"nofollow\">\r\n      qplot()  Error: Unknown parameters: span</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_group_thread_3\" rel=\"nofollow\">\r\n      Dynamically using expression in legend labels</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n  </ul>\r\n</div>\r\n\r\n\r\n\r\n  \r\n  <a name=\"m_-3103381550811218660_m_2448509381725641240_group_thread_0\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/d737ed3dbc02250e?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/d737ed3dbc02250e?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw1Kv_te0fQ_3atxcipTfRY2\">\r\n      Error with geom_text\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        &quot;Manuel Spínola&quot; &lt;<a href data-email-masked rel=\"nofollow\">mspin...@gmail.com</a>&gt;: Aug 19 07:45AM -0600\r\n      </span>\r\n      <br><br>\r\n      Dear group members,<br>\r\n <br>\r\nI am trying to label point estimates, lower and upper confidence limits in<br>\r\ngeom_pointrange but I got an error.  The problem is with the 2 last<br>\r\ngeom_text in my code.\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cc0ff228f7ac8?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cc0ff228f7ac8?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw26RjE-lmeCGk4p8UH2trMf\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-3103381550811218660_m_2448509381725641240_group_thread_1\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/785c14a2be2464eb?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/785c14a2be2464eb?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw1xsYK2XPQyRG9E1gtHuyE0\">\r\n      Plot with 2 y axes\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Thang Khong &lt;<a href data-email-masked rel=\"nofollow\">khongth...@gmail.com</a>&gt;: Aug 19 01:03AM -0700\r\n      </span>\r\n      <br><br>\r\n      Dear all,<br>\r\nI want to draw a plot with two different y axes using ggplot2.<br>\r\n <br>\r\ndf &lt;- read.csv(file.choose(), header =  TRUE)<br>\r\nsummary(df)<br>\r\nhead(df)<br>\r\n <br>\r\n##-------------<br>\r\n <br>\r\nlibrary(ggplot2)\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cb8acf558e840?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cb8acf558e840?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw0csOBlHLVKU0diz6BNHJo7\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-3103381550811218660_m_2448509381725641240_group_thread_2\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/5e4a71b6b1f4f434?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/5e4a71b6b1f4f434?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw2HTT1rH73N5aps5nZp-cPK\">\r\n      qplot()  Error: Unknown parameters: span\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Benny Guo &lt;<a href data-email-masked rel=\"nofollow\">baili...@gmail.com</a>&gt;: Aug 18 07:43PM -0700\r\n      </span>\r\n      <br><br>\r\n      I use the example code in* ggplot2. Elegant Graphics for Data Analysis* to <br>\r\nplot . I encounter the error message below:<br>\r\n <br>\r\n&gt; &gt; qplot(carat, price, data = dsmall, geom = c(&quot;point&quot;, &quot;smooth&quot;), span =\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/cb8aaf1e23e23?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/cb8aaf1e23e23?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw0NfWGib0AOax-A3IJg8359\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_-3103381550811218660_m_2448509381725641240_group_thread_3\" rel=\"nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/ggplot2/t/c74ddcd87196d3d3?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/t/c74ddcd87196d3d3?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw3orB3c0hCQns-rA6Dn9sWs\">\r\n      Dynamically using expression in legend labels\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tbody><tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Brian &lt;<a href data-email-masked rel=\"nofollow\">zenl...@gmail.com</a>&gt;: Aug 18 10:02PM +0200\r\n      </span>\r\n      <br><br>\r\n      Hi Ron,<br>\r\n <br>\r\nglad I could help ^^.<br>\r\n <br>\r\nI have a few more ideas/strategies to do that, but I guess this list <br>\r\nisn&#39;t the right place to write a function interval_to_set_notation.<br>\r\n <br>\r\nBest<br>\r\nBrian<br>\r\n\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/ggplot2/msg/c86fbcdf0bb7a?utm_source=digest&amp;utm_medium=email\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/ggplot2/msg/c86fbcdf0bb7a?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw19TaATC47iOCid0EPOPZaH\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </tbody></table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_-3103381550811218660_m_2448509381725641240_digest_top\" rel=\"nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n\r\n\r\n  </div>\r\n  <div style=\"background-color:#f5f5f5;padding:5px 20px\">\r\n  <table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\">\r\n  <tbody><tr>\r\n    <td style=\"padding-top:4px;font-family:arial,sans-serif;color:#636363;font-size:11px\">\r\n      \r\n      You received this digest because you&#39;re subscribed to updates for this group. You can change your settings on the <a href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/ggplot2/join\" style=\"color:#1155cc;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/ggplot2/join&amp;source=gmail&amp;ust=1792367772548000&amp;usg=AOvVaw2QeOSIXRtUi8MiaOVkWc7s\">group membership page</a>.<br>\r\n      To unsubscribe from this group and stop receiving emails from it send an email to <a href data-email-masked rel=\"nofollow\">ggplot2+unsubscribe@googlegroups.com</a>.\r\n    </td>\r\n  </tr></tbody>\r\n  </table>\r\n  </div>\r\n</div>\r\n\r\n</blockquote></div><br><br clear=\"all\"><div><br></div>-- <br><div class=\"gmail_signature\" data-smartmail=\"gmail_signature\">Nabil Saad</div>\r\n</div>\r\n"
