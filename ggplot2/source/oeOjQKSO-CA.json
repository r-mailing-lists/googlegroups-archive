   "parts": [
    [
     1,
     "<div style=\"word-wrap:break-word\">Hello,<div><br></div><div>I plot runtime to compare different implementations (or kernels) in the following way. How can I make sure that my kernels labeled kernel1, kernel2, kernel3 predictably get a consistent color assignment e.g. I would like kernel1 to be the red etc.</div><div><br></div><div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#000000\">p</span> &lt;- ggplot(<span style=\"color:#000000\">data</span>=<span style=\"color:#000000\">df</span>, aes(<span style=\"color:#000000\">x</span>=<span style=\"color:#000000\">n</span>, <span style=\"color:#000000\">y</span>=<span style=\"color:#000000\">rt</span>, <span style=\"color:#000000\">group</span>=<span style=\"color:#000000\">kernel</span>, <span style=\"color:#000000\">shape</span>=<span style=\"color:#000000\">kernel</span>, <span style=\"color:#000000\">colour</span>=<span style=\"color:#000000\">kernel</span>)) + geom_point(<span style=\"color:#000000\">fill</span>=<span style=\"color:#b0130a\">&quot;white&quot;</span>, <span style=\"color:#000000\">size</span>=<span style=\"color:#055119\">3</span>) + geom_line() + xlab(<span style=\"color:#b0130a\">&quot;n&quot;</span>) + ylab(<span style=\"color:#b0130a\">&quot;Runtime (s)&quot;</span>) + opts(<span style=\"color:#000000\">title</span>=<span style=\"color:#000000\">title</span>,<span style=\"color:#000000\">plot.title</span>=theme_text(<span style=\"color:#000000\">size</span>=<span style=\"color:#000000\">font.size</span>))</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><a href=\"http://dev.new\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://dev.new&amp;source=gmail&amp;ust=1792374853954000&amp;usg=AOvVaw3A3K4YZIXS80IrbgepEHGo\">dev.new</a>(<span style=\"color:#000000\">width</span>=<span style=\"color:#055119\">7</span>, <span style=\"color:#000000\">height</span>=<span style=\"color:#055119\">5</span>)</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\">p</div></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\"><br></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\"><span style=\"font-family:Helvetica;font-size:medium\">Many TIA,</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\"><span style=\"font-family:Helvetica;font-size:medium\">Best!</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\"><span style=\"font-family:Helvetica;font-size:medium\">Giovanni</span></div></div>"
    ]
