ght:15.75pt;box-sizing:content-box\">\r\n  <div>\r\n  <div title=\"27\" style=\"text-overflow:ellipsis\">27</div>\r\n  </div></td>\r\n  <td>\r\n  <div></div>\r\n  \r\n  <div>\r\n  <div title=\"Main\" style=\"text-overflow:ellipsis\">Main</div>\r\n  </div></td>\r\n  <td>\r\n  <div></div>\r\n  \r\n  <div>\r\n  <div title=\"awareness\" style=\"text-overflow:ellipsis\">awareness</div>\r\n  </div></td>\r\n  <td>\r\n  <div></div>\r\n  \r\n  <div>\r\n  <div title=\"235049.0\" style=\"text-overflow:ellipsis\">235049</div>\r\n  </div></td>\r\n  <td>\r\n  <div></div>\r\n  \r\n  <div>\r\n  <div title=\"132886.50\" style=\"text-overflow:ellipsis\">132886.5</div>\r\n  </div>\r\n  </td>\r\n </tr></tbody></table><br></div><div>And here&#39;s the ggplot code including the fill variable:</div><div><div><br></div><div># create custom palette with &#39;white&#39; color for dummies, added 8 custom colors for data set</div><div>cols &lt;- c(&quot;#fec44f&quot;, &quot;#fc9272&quot;, &quot;#a1d99b&quot;, &quot;#fee0d2&quot;,</div><div>          &quot;#2ca25f&quot;, &quot;#8856a7&quot;, &quot;#43a2ca&quot;, &quot;#fdbb84&quot;,</div><div>          &quot;#e34a33&quot;, &quot;#a6bddb&quot;, &quot;#dd1c77&quot;,</div><div>          &quot;#4286f4&quot;,&quot;#2d5634&quot;,&quot;#a3a864&quot;,&quot;#626358&quot;,</div><div>          &quot;#937e57&quot;,&quot;#918a7e&quot;,&quot;#877a64&quot;,&quot;#d18d68&quot;,&quot;#ffffff&quot;)</div><div><br></div><div>str(cols)</div><div><br></div><div># plotting chart with 3 point font for labels</div><div>ggplot() +</div><div>  theme_minimal() +</div><div>  coord_flip() +</div><div>  scale_fill_manual(values=cols) +</div><div>  geom_bar(data=alldata, aes(x=step, y=Users, fill=content), stat=&quot;identity&quot;, width=1) +</div><div>  geom_text(data=alldata[alldata$content!=&#39;dummy&#39;, ],</div><div>            aes(x=step, y=pos, label=paste0(content, &#39;-&#39;, Users/1000, &#39;K&#39;)),</div><div>            size=18, color=&#39;white&#39;, fontface=&quot;bold&quot;) +</div><div>  geom_ribbon(data=fsa.lines, aes(x=step, ymax=max(maxx), ymin=maxx, group=1), fill=&#39;white&#39;) +</div><div>  geom_line(data=fsa.lines, aes(x=step, y=maxx, group=1), color=&#39;darkred&#39;, size=18) +</div><div>  geom_ribbon(data=fsa.lines, aes(x=step, ymax=minx, ymin=min(minx), group=1), fill=&#39;white&#39;) +</div><div>  geom_line(data=fsa.lines, aes(x=step, y=minx, group=1), color=&#39;darkred&#39;, size=18) +</div><div>  geom_text(data=step.rates, aes(x=step, y=(fsa.lines$minx[-1]), label=paste0(rate*100, &#39;%&#39;)), hjust=1.2,</div><div>            color=&#39;darkblue&#39;, fontface=&quot;bold&quot;) +</div><div>  theme(legend.position=&#39;none&#39;, axis.ticks=element_blank(), axis.text.x=element_blank(), </div><div>        axis.title.x=element_blank())</div></div><div><br></div><div>The final plot should look similar to this:</div><p style=\"text-align:center;clear:both\"><img src=\"https://groups.google.com/group/ggplot2/attach/2e50ebd482308/funnel.PNG?part=0.1&amp;view=1\" alt=\"funnel.PNG\" style=\"margin-left:1em;margin-right:1em\"></p><div><br></div></div>\r\n\r\n<p></p>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;LIIT_datasciene&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a href data-email-masked rel=\"nofollow\">liit_datascie...@googlegroups.com</a>.<br>\r\nTo post to this group, send email to <a href data-email-masked rel=\"nofollow\">liit_da...@googlegroups.com</a>.<br>\r\nTo view this discussion on the web visit <a href=\"https://groups.google.com/d/msgid/liit_datasciene/eaf74c47-45bc-4cca-a179-22e781f2afcf%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/liit_datasciene/eaf74c47-45bc-4cca-a179-22e781f2afcf%2540googlegroups.com?utm_medium%3Demail%26utm