     1,
     "\r\n\r\n\r\n\r\n\r\n<u></u>\r\n<u></u>\r\n<u></u>\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n\r\n<div>\r\n\r\n<div>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">Hello all,<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">I’ve just begun using ggplot2.<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">I can’t find a way to change a\r\nfew of the line characteristics for some (overlaid) density plots I’ve\r\ngenerated.<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">I’ve been able to change the\r\ncolors used, but not types and thickness of the lines.<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">Any guidance would be much\r\nappreciated.<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">Thanks in advance. <u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\">Marc<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Arial\"><span style=\"font-size:10.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><b><font size=\"2\" face=\"Tahoma\"><span style=\"font-size:10.0pt;font-family:Tahoma;font-weight:bold\">Marc W. <u></u><u></u><u></u><u></u>Zodet<u></u><u></u>,\r\n <u></u><u></u>MS<u></u><u></u><u></u><u></u></span><u></u><u></u></font></b></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><b><font size=\"2\" face=\"Tahoma\"><span style=\"font-size:10.0pt;font-family:Tahoma;font-weight:bold\">Senior Health\r\nStatistician<u></u><u></u></span></font></b></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Tahoma\"><span style=\"font-size:10.0pt;font-family:Tahoma\">Agency for Healthcare Research and\r\nQuality<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Tahoma\"><span style=\"font-size:10.0pt;font-family:Tahoma\">Center for Financing, Access, and\r\nCost Trends<u></u><u></u></span></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:1.0pt\"><font size=\"2\" face=\"Tahoma\"><span style=\"font-size:10.0pt;font-family:Tahoma\"><a href=\"tel:(301)%20427-1563\" value=\"+13014271563\" target=\"_blank\" rel=\"nofollow\">301-427-1563</a> 