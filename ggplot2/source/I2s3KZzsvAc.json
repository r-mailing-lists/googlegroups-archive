r:#000\">aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">col </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> factor</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Treatment</span><span style=\"color:#660\">)),</span><span style=\"color:#000\"> shape </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;|&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> <br>scale_color_manual</span><span style=\"color:#660\">(</span><span style=\"color:#000\">values </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> somecols</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> guide</span><span style=\"color:#660\">=</span><span style=\"color:#000\">FALSE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> <br></span><span style=\"color:#000\">scale_x_log10</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span></div></code></div><span><br></span></code></pre>\r\n    </div><p style=\"text-align:center;clear:both\"><a style=\"clear:left;margin-bottom:1em;float:left;margin-right:1em\" href=\"http://i.stack.imgur.com/II7Sf.png\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://i.stack.imgur.com/II7Sf.png&amp;source=gmail&amp;ust=1792369049355000&amp;usg=AOvVaw11aRXeAdIsfVyvW4W-2O3J\"><img src=\"https://ci6.googleusercontent.com/proxy/Y2TSc4Aufdjv3T6ZEFtyfhHZxMIdGvACSOtq0Qb_6jnjEJTPwEMdyLKGr8yiBsNfm78Vc00=s0-d-e1-ft#http://i.stack.imgur.com/II7Sf.png\" alt=\"enter image description here\" border=\"0\"></a></p></div></blockquote></div></div>"
