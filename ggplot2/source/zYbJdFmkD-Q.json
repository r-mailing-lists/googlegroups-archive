   "parts": [
    [
     1,
     "<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">Hello ggplot mavens,<u></u><u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">I have four time series with the following structure:<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">WEEK a date variable indicating the last day of a week (on the x-axis), <u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">OUTCOME a numeric outcome variable (on the y-axis), and <u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">CAT a factor variable that differentiates the 4 variable series.<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><u></u><font color=\"#000000\" size=\"3\" face=\"Calibri\"> </font><u></u></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">I want to produce a plot with a smoothed lowess line for each level of CAT.  I can produce the line plot with LINETYPE differentiated by CAT, but I don’t see how to fit the smoothed line.<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">I’d appreciate any suggestions how to do this.<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><u></u><font color=\"#000000\" size=\"3\" face=\"Calibri\"> </font><u></u></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">Thanks in advance <u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">AB<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><u></u><font color=\"#000000\" size=\"3\" face=\"Calibri\"> </font><u></u></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">Sample code producing the line graph below:<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">x1&lt;- ggplot(df, aes(x=WEEJ, y=OUTCOME, linetype=CAT)) +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  geom_line() +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  scale_y_continuous(&quot;Outcome&quot;) +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  scale_x_date(&quot;Week ending&quot;, breaks = date_breaks(&quot;1 week&quot;), labels= date_format(format = &quot;%m/%d&quot;)) +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  scale_linetype_manual(name= &quot;Category&quot;, breaks=c(&quot;LE 13&quot;,&quot;14 to 20&quot;,&quot;21 to 26&quot;, &quot;GT 26&quot;), values = c(10,8,5,1)) +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  theme(legend.position=&quot;bottom&quot;,axis.text.x=element_text(angle=-70, hjust=0)) +<u></u><u></u></font></font></font></p>\r\n<p style=\"MARGIN:0in 0in 0pt\" class=\"MsoNormal\"><font size=\"3\"><font color=\"#000000\"><font face=\"Calibri\">  ggtitle (&quot;Outcome by Category&quot;)<u></u><u></u></font></font></font></p>"
    ]
   ]
  },
  {
