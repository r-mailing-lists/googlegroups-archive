normal Monaco;color:rgb(5,36,153);font-size:17px\">)</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 20.8px/normal Monaco;color:rgb(5,36,153);font-size:17px\"><br></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 20.8px/normal Monaco;color:rgb(5,36,153);font-size:17px\"><span style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:medium\">Cheers</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 20.8px/normal Monaco;color:rgb(5,36,153);font-size:17px\"><span style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:medium\">david.</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 20.8px/normal Monaco;color:rgb(5,36,153);font-size:17px\"><span style=\"color:rgb(0,0,0);font-family:Helvetica;font-size:medium\"><br></span></div><div><br><div></div></div></div></div>"
