     1,
     "<u></u>\n\n\n\n<div>\n<div><span><font size=\"2\" face=\"Arial\">Dear \nAll,</font></span></div>\n<div><span><font size=\"2\" face=\"Arial\"></font></span> </div>\n<div><span><font size=\"2\" face=\"Arial\">Is it possible to \nhave multiple lines on leftside y-axis and right side y-axis in ggplot2. I \nassume there is a way but do not know how to accomplish it. For ex. the data set \nlooks like this</font></span></div>\n<div><span><font size=\"2\" face=\"Arial\"></font></span> </div>\n<div>\n<table style=\"WIDTH:144pt;BORDER-COLLAPSE:collapse\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\" width=\"192\">\n  <colgroup>\n  <col style=\"WIDTH:48pt\" span=\"3\" width=\"64\">\n  <tbody>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;WIDTH:48pt;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\" width=\"64\"><font size=\"2\" face=\"Arial\">year</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;WIDTH:48pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" width=\"64\"><font size=\"2\" face=\"Arial\">variable</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;WIDTH:48pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" width=\"64\"><font size=\"2\" face=\"Arial\">value</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2007</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">10</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2008</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">11</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2009</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">13</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2007</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x2</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">18</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2008</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x2</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">19</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2009</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">x2</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">21</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2007</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">y1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">123</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2008</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">y1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">124</font></td></tr>\n  <tr style=\"HEIGHT:12.75pt\" height=\"17\">\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;HEIGHT:12.75pt;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\" height=\"17\"><font size=\"2\" face=\"Arial\">2009</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">y1</font></td>\n    <td style=\"BORDER-BOTTOM:#ece9d8;BORDER-LEFT:#ece9d8;BACKGROUND-COLOR:transparent;BORDER-TOP:#ece9d8;BORDER-RIGHT:#ece9d8\"><font size=\"2\" face=\"Arial\">130</font></td></tr></tbody></colgroup></table></div>\n<div><font size=\"2\" face=\"Arial\"></font> </div>\n<div><span><font size=\"2\" face=\"Arial\">I would like to get \na <strong>line</strong> plot of x1 and x2 against year on left hand side \ny-axis and y1 on right hand side y-axis. any help or ideas will be greatly \nappreciated.</font></span></div>\n<div><span><font size=\"2\" face=\"Arial\"></font></span> </div>\n<div><span><font size=\"2\" face=\"Arial\">thanks in advance \nand regards,</font></span></div>\n<div><span><font size=\"2\" face=\"Arial\"></font></span><span></span><span><font size=\"2\" face=\"Arial\"></font></span> </div>\n<div><span><font size=\"2\" face=\"Arial\">SNVK \n</font></span></div>\n<div><font size=\"2\" face=\"Arial\"></font> </div></div>\n"
    ]
   ]
