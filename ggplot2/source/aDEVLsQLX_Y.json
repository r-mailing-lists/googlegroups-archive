     "<div dir=\"ltr\"><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">fm </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> glm</span><span style=\"color:#660\">(</span><span style=\"color:#000\">weev</span><span style=\"color:#660\">.</span><span style=\"color:#000\">prev</span><span style=\"color:#660\">~</span><span style=\"color:#000\"> lat</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">=</span><span style=\"color:#000\">rubra</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> weights</span><span style=\"color:#660\">=</span><span style=\"color:#008\">no</span><span style=\"color:#660\">.</span><span style=\"color:#000\">acorns</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> family</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;binomial&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br>library</span><span style=\"color:#660\">(</span><span style=\"color:#000\">effects</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>fit </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span><span style=\"color:#660\">(</span><span style=\"color:#606\">Effect</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&#39;lat&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> fm</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> xlevels </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1000</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br><br><br>g