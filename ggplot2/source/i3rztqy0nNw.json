  {
   "id": "J5sMz8W6k3YJ",
   "from": "James McCreight",
   "author": "4c2460918214ec91",
   "date": "2011-03-04T16:50:35Z",
   "subject": "Re: outliers in geom_boxplot",
   "parts": [
    [
     1,
     "Dear Augustin,<div><br></div><div>(great, thanks for the data. its just way easier to play when the data are there and everything is reproduced correctly)</div><div><br></div><div>If I understand correctly, you want to get the information back from the plotting routine. As I understand ggplot, this is not something ggplot is typical meant to do. But there are ways, and I too think these are great to exploit.</div>\n\n\n<div><br></div><div>gg=ggplot(d1m, aes(x = Sample, y = value)) + geom_boxplot()</div><div><div><br></div><div>## this was a trick offered once to me by Koshke Takahashi, </div><div>## he said it&#39;s not guranteed to work in the future.</div>\n\n\n<div>gb &lt;- ggplot_build(g)</div><div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\">## str(gb) is extensive, but look at  str(gb[[1]])</div><div class=\"gmail_quote\">## looks like $outliers, $ymin, $ymax, and $group (though this is in order, </div>\n\n\n<div class=\"gmail_quote\">## so not explicitly needed) are your ticket</div><div class=\"gmail_quote\">## extract the useful data frame</div><div class=\"gmail_quote\">gb1=gb[[1]][[1]][[1]]   ## funny</div><div class=\"gmail_quote\">\n\n\n<br></div><div class=\"gmail_quote\">## this is your new data frame where you&#39;ll remove the outliers</div><div class=\"gmail_quote\"><a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>=d1m</div><div class=\"gmail_quote\">## to match group you&#39;ll need to make sample a factor in the same </div>\n\n\n<div class=\"gmail_quote\">## default way as ggplot</div><div class=\"gmail_quote\"><div><div><a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$Sample=factor(<a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$Sample)</div></div>\n\n<div><br></div><div>## there maybe a cleaner way of doing this, but here goes....</div>\n<div>if (exists(&#39;wh.na.all&#39;)) rm(wh.na.all)</div><div>## for each case / factor level in Sample</div><div>for (cc in 1:dim(gb1)[1]) {</div><div><div>  <a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a> &lt;- which(  as.numeric(<a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$Sample)== cc &amp; </div>\n\n\n<div>                              (  <a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$value &gt; gb1$ymax[cc]  | <a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$value &lt; gb1$ymin[cc]) )</div></div><div>  if (length(<a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a>)&gt;0) {</div>\n\n\n<div>    print(<a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$value[<a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a>] == gb1$outliers[[cc]]) ## just checking</div><div>    wh.na.all &lt;- if (!exists(&#39;wh.na.all&#39;)) <a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a> else c(wh.na.all,<a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a>)</div>\n\n\n<div>    <a href=\"http://d1m.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://d1m.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0cVZzCEjAPCHf5AQ-ZOX7K\">d1m.na</a>$value[<a href=\"http://wh.na\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://wh.na&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw1QkA267u-HGXD1T4BA_W8M\">wh.na</a>]=NA</div><div>  }</div><div>}</div><div><br></div><div>#just another check.</div></div><div class=\"gmail_quote\">\n\nd1m$value[wh.na.all]==unlist(gb1$outliers)</div>\n<div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\">I hope that achieves what you want. Let me know if not.</div><div class=\"gmail_quote\">I&#39;m looking forward to visiting your city (for the first time) at the end of the month!</div>\n\n\n<div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\">Best, </div><div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\">James</div></div>"
    ],
    [
     3,
     "<div><div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\"><br></div><div class=\"gmail_quote\">\n\n\nOn Fri, Mar 4, 2011 at 1:02 AM, Agustin Lobo <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">alob...@gmail.com</a>&gt;</span> wrote:<br><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">\n\n\nThanks for your answer. I apologize for not having sent the data, but I thought that just showing the few first rows of the data would be enough to figure it out.<br>\nI&#39;ve put d1.rda (from save(d1, file=&quot;d1.rda&quot;) here:<br>\n<a href=\"https://sites.google.com/site/openfiles2/home/d1.rda\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sites.google.com/site/openfiles2/home/d1.rda&amp;source=gmail&amp;ust=1792380385869000&amp;usg=AOvVaw0TJJKHr2DMv9Qp5knDTBX1\">https://sites.google.com/site/openfiles2/home/d1.rda</a><br>\n<br>\nand also the dput() output followed by the sessionInfo() output.<br>\nMy question is whether we can get from geom_boxplot() something similar to the<br>\ncomponent out of boxplot()<br>\n<br>\n&gt; dput(d1)<br>\nstructure(list(Sample = c(&quot;Ca&quot;, &quot;Mg&quot;, &quot;Na&quot;, &quot;K&quot;, &quot;Si&quot;, &quot;Cl&quot;,<br>\n&quot;SO4&quot;, &quot;Li&quot;, &quot;Be&quot;, &quot;B&quot;, &quot;Al&quot;, &quot;P&quot;, &quot;Sc&quot;, &quot;Ti&quot;, &quot;V&quot;, &quot;Cr&quot;, &quot;Fe&quot;,<br>\n&quot;Mn&quot;, &quot;Co&quot;, &quot;Ni&quot;, &quot;Cu&quot;, &quot;Zn&quot;, &quot;Ga&quot;, &quot;Ge&quot;, &quot;As&quot;, &quot;Se&quot;, &quot;Br&quot;, &quot;Rb&quot;,<br>\n&quot;Sr&quot;, &quot;Y&quot;, &quot;Zr&quot;, &quot;Nb&quot;, &quot;Mo&quot;, &quot;Ag&quot;, &quot;Cd&quot;, &quot;Sn&quot;, &quot;Sb&quot;, &quot;I&quot;, &quot;Cs&quot;,<br>\n&quot;Ba&quot;, &quot;La&quot;, &quot;Ce&quot;, &quot;Pr&quot;, &quot;Nd&quot;, &quot;Sm&quot;, &quot;Eu&quot;, &quot;Gd&quot;, &quot;Tb&quot;, &quot;Dy&quot;, &quot;Ho&quot;,<br>\n&quot;Er&quot;, &quot;Tm&quot;, &quot;Yb&quot;, &quot;Lu&quot;, &quot;Hf&quot;, &quot;Ta&quot;, &quot;W&quot;, &quot;Hg&quot;, &quot;Tl&quot;, &quot;Pb&quot;, &quot;Bi&quot;,<br>\n&quot;Th&quot;, &quot;U&quot;), ELEMTYPE = c(&quot;MJ&quot;, &quot;MJ&quot;, &quot;MJ&quot;, &quot;MJ&quot;, &quot;MJ&quot;, &quot;MJ&quot;,<br>\n&quot;MJ&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;,<br>\n&quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;,<br>\n&quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;,<br>\n&quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;,<br>\n&quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;, &quot;MN&quot;,<br>\n&quot;MN&quot;, &quot;MN&quot;), AS.28 = c(1044.3, 40.9, 1455.7, 168.2, 363, 2417.3,<br>\n589.3, 2.59, 0.01, 38.82, 44.79, 4.77, 0.45, 1.06, 0.36, 0.11,<br>\n-0.97, 0.76, 0.21, 0.21, 0.63, 0.52, 0.02, 0.01, 0.8, 1.6, 3.95,<br>\n0.24, 2.68, 0.02, 1, 0.03, 0.06, 0.04, 0.11, 18.44, 0.01, 0.12,<br>\n0.01, 0.48, 0.04, 0.21, 0.01, 0.02, 0.01, 0, 0.01, 0, 0, 0, 0,<br>\n0, 0, 0, 0.04, 0, 36.21, 4.83, 0.01, 0.85, 0, 0.01, 0.02), AS.29 = c(208.8,<br>\n199.2, 2085.1, 188.6, 2484.4, 164.5, 138.4, 0.84, 0.03, -23.59,<br>\n580.74, 5.53, 2.06, 8.89, 0.08, 0.11, 322.97, 9.57, 0.09, 0.38,<br>\n0.5, 6.06, 0.17, 0.03, 0.07, 1.8, 3.31, 0.22, 0.74, 0.04, 0.69,<br>\n0.22, 0.01, 0.04, 0.1, 3.27, 0.02, 0.09, 0.01, 0.6, 0.15, 0.18,<br>\n0