     "\n\n\n\n\n\n\n\n\n<div lang=\"ZH-TW\" link=\"blue\" vlink=\"purple\">\n\n<div style=\"layout-grid:18.0pt\">\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\">Dear all, <u></u><u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\">In Section 6.4.4 (Page 109) of Hadley’s book\nggplot2, there is this figure with legend texts of ‘below’ and ‘above’.\n<br>\n<br>\n<u></u><u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\">Is there a way to change ‘below’ to ‘in\nPM10’ with the ‘10’ in subscript? <u></u><u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\">Thanks for your help. <u></u><u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\"><u></u> <u></u></span></font></p>\n\n<p class=\"MsoNormal\"><font size=\"3\" face=\"Arial\"><span lang=\"EN-US\" style=\"font-size:12.0pt;font-family:Arial\">-Linwei <u></u><u></u></span></font></p>\n\n</div>\n\n</div>\n\n\n"
