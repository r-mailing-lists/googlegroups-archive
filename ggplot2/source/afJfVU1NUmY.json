    [
     1,
     "\r\n  \r\n    \r\n  \r\n  <div bgcolor=\"#FFFFFF\" text=\"#000000\">\r\n    <p>Hello Money,</p>\r\n    <p>would you like to change the column names from the xls to\r\n      A,B,C,D... for less problems <br>\r\n    </p>\r\n    <p>then save the file to a tab delimited csv file <br>\r\n    </p>\r\n    <p>then read the csv file like<br>\r\n      logDirectory&lt;-&quot;dirPathOfFile&quot; <br>\r\n      plot &lt;- read.table(paste(logDirectory, &quot;my.csv&quot;, sep = &quot;&quot;))<br>\r\n    </p>\r\n    <p>and retry as<br>\r\n    </p>\r\n    <pre style=\"font-family:&#39;Lucida Console&#39;;font-size:10pt!important;outline:none;border:none;word-break:break-all;margin:0px;white-space:pre-wrap!important;line-height:15px;color:rgb(0,0,0);font-style:normal;font-variant:normal;font-weight:normal;letter-spacing:normal;text-align:-webkit-left;text-indent:0px;text-transform:none;word-spacing:0px;background-color:rgb(255,255,255)\"><span style=\"color:blue;white-space:pre\"></span><span style=\"color:blue\">ggplot(plot, </span><span style=\"color:blue\"><span style=\"color:blue\">aes(x=A, y=B)</span>) + geom_line()\r\n</span><span style=\"color:blue;white-space:pre\"></span></pre>\r\n    <br>\r\n    and build up one step at a time</div>"
    ],
