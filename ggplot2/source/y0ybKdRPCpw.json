ht:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\"><span style=\"color:#4f4f4f\"> </span><span style=\"color:#171799\">geom_path(</span>data<span style=\"color:#171799\">=</span>df<span style=\"color:#171799\">[</span>df<span style=\"color:#171799\">$</span>main<span style=\"color:#171799\">,],</span>size<span style=\"color:#171799\">=</span><span style=\"color:#055119\">0.75</span><span style=\"color:#171799\">,</span>colour<span style=\"color:#171799\">=</span><span style=\"color:#b0130a\">&quot;red&quot;</span><span style=\"color:#171799\">)</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">+</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">geom_point(</span>data<span style=\"color:#171799\">=</span>df<span style=\"color:#171799\">[</span>df<span style=\"color:#171799\">$</span>main<span style=\"color:#171799\">,],</span>size<span style=\"color:#171799\">=</span><span style=\"color:#055119\">3.0</span><span style=\"color:#171799\">,</span>colour<span style=\"color:#171799\">=</span><span style=\"color:#b0130a\">&quot;red&quot;</span><span style=\"color:#171799\">)</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">+</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\"> </span>scale_size_discrete(<span style=\"color:#000000\">range</span>=c(<span style=\"color:#055119\">0.5</span>,<span style=\"color:#055119\">1</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">guide</span>=<span style=\"color:#b0130a\">&quot;none&quot;</span>)<span style=\"color:#b0130a\"> </span>+</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\"> </span>scale_x_continuous(<span style=\"color:#000000\">expand</span>=c(<span style=\"color:#055119\">0</span>,<span style=\"color:#055119\">0</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">breaks</span>=seq(<span style=\"color:#055119\">0</span>,<span style=\"color:#055119\">5000</span>,<span style=\"color:#000000\">by</span>=<span style=\"color:#055119\">1000</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">limit</span>=c(<span style=\"color:#055119\">0</span>,max(<span style=\"color:#000000\">df</span>$<span style=\"color:#000000\">n</span><span style=\"color:#b0130a\"> </span>+<span style=\"color:#b0130a\"> </span><span style=\"color:#055119\">800</span>)))<span style=\"color:#b0130a\"> </span>+</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\"> </span>geom_hline(aes(<span style=\"color:#000000\">yintercept</span>=<span style=\"color:#055119\">0</span>))<span style=\"color:#b0130a\"> </span>+</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\"> </span>scale_y_continuous(<span style=\"color:#b0130a\">&quot;[Gflop/s]&quot;</span>,<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">limit</span>=c(<span style=\"color:#055119\">0</span>,<span style=\"color:#055119\">13</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">breaks</span>=seq(<span style=\"color:#055119\">1</span>,<span style=\"color:#055119\">12</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">expand</span>=c(<span style=\"color:#055119\">0</span>,<span style=\"color:#055119\">0</span>),<span style=\"color:#b0130a\"> </span><span style=\"color:#000000\">labels</span>=as.character(seq(<span style=\"color:#055119\">1</span>,<span style=\"color:#055119\">12</span>)))<span style=\"c