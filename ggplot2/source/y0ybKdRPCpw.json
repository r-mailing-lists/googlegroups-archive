ormal 14px/normal Monaco\"><span style=\"color:#b0130a\">   </span>axis.title.y<span style=\"color:#171799\">=theme_text(</span>size<span style=\"color:#171799\">=</span><span style=\"color:#055119\">13</span><span style=\"color:#171799\">,</span>face<span style=\"color:#171799\">=</span><span style=\"color:#b0130a\">&quot;plain&quot;</span><span style=\"color:#171799\">,</span>angle<span style=\"color:#171799\">=</span><span style=\"color:#055119\">0</span><span style=\"color:#171799\">,</span>vjust<span style=\"color:#171799\">=</span><span style=\"color:#055119\">1.05</span><span style=\"color:#171799\">,</span>hjust<span style=\"color:#171799\">=</span><span style=\"color:#055119\">7.5</span><span style=\"color:#171799\">),</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\">   </span><span style=\"color:#000000\">plot.margin</span>=unit(c(<span style=\"color:#055119\">1</span>,<span style=\"color:#055119\">1</span>,<span style=\"color:#055119\">0.5</span>,<span style=\"color:#055119\">-2</span>),<span style=\"color:#b0130a\"> &quot;lines&quot;</span>),</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\">   </span><span style=\"color:#000000\">axis.ticks</span>=theme_segment(),</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\">   </span><span style=\"color:#000000\">axis.text.x</span>=theme_text(),</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#b0130a\">   </span><span style=\"color:#000000\">axis.text.y</span>=theme_text()</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(176,19,10)\"> <span style=\"color:#171799\">)</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(176,19,10);min-height:19px\"><br></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\">p<span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">&lt;-</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">direct.label(</span>p<span style=\"color:#171799\">,</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">list(</span><span style=\"color:#b0130a\">&quot;last.qp&quot;</span><span style=\"color:#171799\">,</span>vjust<span style=\"color:#171799\">=</span><span style=\"color:#055119\">0.4</span><span style=\"color:#171799\">,</span>hjust<span style=\"color:#171799\">=</span><span style=\"color:#055119\">-0.2</span><span style=\"color:#171799\">,</span>fontfamily<span style=\"color:#171799\">=</span><span style=\"color:#b0130a\">&quot;sans&quot;</span><span style=\"color:#171799\">,</span>fontsize<span style=\"color:#171799\">=</span><span style=\"color:#055119\">15</span><span style=\"color:#171799\">,</span>fontface<span style=\"color:#171799\">=</span><span style=\"color:#b0130a\">&quot;plain&quot;</span><span style=\"color:#171799\">))</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\"><span style=\"color:#000000\">gt</span><span style=\"color:#b0130a\"> </span>&lt;-<span style=\"color:#b0130a\"> </span>ggplot_gtable(ggplot_build(<span style=\"color:#000000\">p</span>))</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco\">gt<span style=\"color:#171799\">$</span>layout<span style=\"color:#171799\">$</span>clip<span style=\"color:#171799\">[</span>gt<span style=\"color:#171799\">$</span>layout<span style=\"color:#171799\">$</span>name<span style=\"color:#171799\">==</span><span style=\"color:#b0130a\">&quot;panel&quot;</span><span style=\"color:#171799\">]</span><span style=\"color:#b0130a\"> </span><span style=\"color:#171799\">&lt;-</span><span style=\"color:#b0130a\"> &quot;off&quot;</span></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(23,23,153)\">grid.draw(<span style=\"color:#000000\">gt</span>)</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(176,19,10);min-height:19px\"><br></div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(79,79,79)\"># Restore the original guide_grid function so that it will draw all gridlines again</div><div style=\"margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:4px;font:normal normal normal 14px/normal Monaco;color:rgb(176,19,10)\"><span style=\"color:#171799\">assignInNamespace(</span>&quot;guide_grid&quot;<span style=\"color:#171799\">,</span> <span style=\"color:#000000\">guide_grid_orig</span><span style=\"color:#171799\">,</span> <span style=\"color:#000000\">ns</span><span style=\"color:#171799\">=</span>&quot;ggplot2&quot;<span style=\"color:#171799\">)</span> </div><div> </div><div><br></div></div>"
