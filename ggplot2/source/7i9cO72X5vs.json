     1,
     "\n\n\n\n\n\n\n\n\n\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\n\n<div>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\n\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\n\n<div style=\"border:none;border-top:solid #b5c4df 1.0pt;padding:3.0pt 0cm 0cm 0cm\">\n\n<p class=\"MsoNormal\"><b><span lang=\"PT-BR\" style=\"font-size:10.0pt;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;\">De:</span></b><span lang=\"PT-BR\" style=\"font-size:10.0pt;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;\"> hadley wickham [mailto:<a href data-email-masked rel=\"nofollow\">h.wi...@gmail.com</a>]\n<br>\n<b>Enviada em:</b> terça-feira, 5 de janeiro de 2010 19:24<br>\n<b>Para:</b> <a href data-email-masked rel=\"nofollow\">leandr...@leandromarino.com.br</a><br>\n<b>Assunto:</b> Re: Documentation feedback [#207]<u></u><u></u></span></p>\n\n</div>\n\n<p class=\"MsoNormal\"><u></u> <u></u></p>\n\n<p class=\"MsoNormal\">Hi Leandro,<u></u><u></u></p>\n\n<div>\n\n<p class=\"MsoNormal\"><u></u> <u></u></p>\n\n</div>\n\n<div>\n\n<p class=\"MsoNormal\">I&#39;d suggest sending an email along those lines to the\nggplot2 mailing list.<u></u><u></u></p>\n\n</div>\n\n<div>\n\n<p class=\"MsoNormal\"><u></u> <u></u></p>\n\n</div>\n\n<div>\n\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\">Hadley<u></u><u></u></p>\n\n<div>\n\n<p class=\"MsoNormal\">On Tue, Jan 5, 2010 at 9:59 AM, Wufoo &lt;<a href data-email-masked rel=\"nofollow\">no-r...@wufoo.com</a>&gt; wrote:<u></u><u></u></p>\n\n<div>\n\n<div>\n\n<table border=\"1\" cellspacing=\"0\" cellpadding=\"0\" width=\"100%\" style=\"width:100.0%;border:none;border-bottom:solid #eeeeee 1.0pt\">\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">What docs\n  are you commenting on? <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <div>\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\">geom_bar<u></u><u></u></span></p>\n  </div>\n  </td>\n </tr>\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">What&#39;s the\n  overall quality? <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <div>\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\">Not so good<u></u><u></u></span></p>\n  </div>\n  </td>\n </tr>\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">What needs\n  improving? <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <div>\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\">You dont&#39;t\n  specifies any king of information about de parameter size. I want to do the\n  graphic thinner then default, but i don&#39;t know how can i change it.<u></u><u></u></span></p>\n  </div>\n  </td>\n </tr>\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">What works\n  well? <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <div>\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\">posx &lt;-\n  theme_text(angle=45,hjust=1,face=&#39;bold&#39;,size=12)<br>\n  posy &lt;- theme_text(angle=0,hjust=1,face=&#39;bold&#39;,size=12)<br>\n  <br>\n  y1 &lt;- c(1,4,6,1,8,10,6,1,5,4)<br>\n  <br>\n  x &lt;- qplot(x=factor(paste(&#39;nomes&#39;,1:10),labels=paste(&#39;nomes&#39;,1:10)),<br>\n  y= y1 , label=y1,<br>\n  geom=&#39;bar&#39;,margins=F, stat=&quot;identity&quot;,xlab=&#39;&#39;,ylab=&#39;Y Label&#39;)<br>\n  x &lt;- x + opts(axis.text.x=posx,axis.text.y=posy) +\n  geom_bar(fill=c(rgb(000,100,000,maxColorValue=255),rep(rgb(110,139,061,maxColorValue=255),9)))<br>\n  x + geom_text(hjust=.5,vjust=-.3,size=4.5) <u></u><u></u></span></p>\n  </div>\n  </td>\n </tr>\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">Name <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:whitesmoke;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\">Leandro\n  Marino <u></u><u></u></span></p>\n  </td>\n </tr>\n <tr>\n  <td valign=\"top\" style=\"border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 6.75pt\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><b><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#222222\">Email <u></u><u></u></span></b></p>\n  </td>\n  <td width=\"60%\" valign=\"top\" style=\"width:60.0%;border:none;border-top:solid #eeeeee 1.0pt;background:white;padding:5.25pt 6.75pt 5.25pt 0cm\">\n  <p class=\"MsoNormal\" style=\"line-height:135%\"><span style=\"font-size:9.0pt;line-height:135%;font-family:&quot;Tahoma&quot;,&quot;sans-serif&quot;;color:#333333\"><a href data-email-masked rel=\"nofollow\">leandr...@leandromarino.com.br</a>\n  <u></u><u></u></span></p>\n  </td>\n </tr>\n</table>\n\n</div>\n\n</div>\n\n</div>\n\n<p class=\"MsoNormal\"><br>\n<br clear=\"all\">\n<br>\n-- <br>\n<a href=\"http://had.co.nz/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://had.co.nz/&amp;source=gmail&amp;ust=1792384453874000&amp;usg=AOvVaw1iZCG2n3JTcxO6e83iajU2\">http://had.co.nz/</a><u></u><u></u></p>\n\n</div>\n\n</div>\n\n</div>\n\n\n"
