    [
     1,
     "<div dir=\"ltr\">Use aes:    <div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px;word-wrap:break-word\"><code><div><span style=\"color:#000\">ggplot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> women</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> mapping </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> height</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> weight</span><span style=\"color:#660\">))</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> geom_point</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> geom_vline</span><span style=\"color:#660\">(</span><span style=\"color:#000\"> aes</span><span style=\"color:#660\">(</span><span style=\"color:#000\">xintercept </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> mean</span><span style=\"color:#660\">(</span><span style=\"color:#000\">height</span><span style=\"color:#660\">)))</span><span style=\"color:#000\"> </span></div></code></div></div></div>"
    ],
    [
     3,
