     1,
     "\r\n  \r\n    \r\n  \r\n  <div text=\"#000000\" bgcolor=\"#FFFFFF\">\r\n    <div>Hi Ahmed,<br>\r\n      <br>\r\n      That&#39;s because &quot;par&quot; commands don&#39;t work in ggplot2. If you want\r\n      to plot multiple graphs in one window, you need to use the\r\n      function &quot;grid.arrange&quot; from the library gridExtra..<br>\r\n      <br>\r\n      Regards,<br>\r\n      <div>\r\n        <b><i>Ellen Pape (PhD student)</i></b>\r\n        <br>\r\n        <br>\r\n        Ghent University<br>\r\n        Marine Biology Research Group<br>\r\n        Krijgslaan 281, S8<br>\r\n        9000 Ghent (Belgium)\r\n        <br>\r\n        <br>\r\n        Email: <a href data-email-masked rel=\"nofollow\">Ellen...@Ugent.be</a><br>\r\n        Tel: <a href=\"tel:+32%209%20264%2085%2023\" value=\"+3292648523\" target=\"_blank\" rel=\"nofollow\">++ 32 (0)9 264 85 23</a><br>\r\n        Fax: <a href=\"tel:+32%209%20264%2085%2098\" value=\"+3292648598\" target=\"_blank\" rel=\"nofollow\">++ 32 (0)9 264 85 98</a><br>\r\n        <br>\r\n      </div></div></div>"
    ],
