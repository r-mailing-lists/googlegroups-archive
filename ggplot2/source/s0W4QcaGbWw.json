     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">I am not sure what kind of plot you want to make,..but here is couple of examples:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">dat &lt;- data.frame(years=1949:1964,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"> y=c(942,1003,1100,1234,1188,923,1289,1340,1445,1432,1523,1598,1600,1673, 1654,1722))<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">ggplot(data=dat, aes(x=years, y=y)) + geom_line()<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">ggplot(data=dat, aes(x=years, y=y)) + geom_line() + geom_point()<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">ggplot(data=dat, aes(x=years, y=y)) + geom_bar(stat = &quot;identity&quot;)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">