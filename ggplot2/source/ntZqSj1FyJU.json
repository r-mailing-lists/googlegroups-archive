28,0,0)\">1.00E-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">\r\nx   </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1.00E-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">\r\nx   </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1.00E-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">\r\nx   </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1.00E-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">\r\nx   </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1.00E-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">\r\nx   </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1.00E-04</span></code></pre><pre style=\"margin-bottom:10px;padding:5px;font-size:13.333333969116211px;background-color:rgb(238,238,238);font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif;overflow:auto;width:auto;max-height:600px;color:rgb(0,0,0);line-height:16.666667938232422px\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;width:89pt\">\r\n <colgroup><col width=\"118\" style=\"width:89pt\">\r\n </colgroup><tbody><tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" width=\"118\" style=\"height:13.0pt;width:89pt\"># via base R:</td>\r\n </tr>\r\n <tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" style=\"height:13.0pt\">boxplot(df$value ~ df$station, </td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.5pt\">\r\n  <td height=\"19\" style=\"height:14.5pt\">main=&quot;base R: zoomed in,\r\nwith \\nno negatives in y range&quot;)</td>\r\n </tr>\r\n <tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" style=\"height:13.0pt\">    \r\n# via ggplot2:</td>\r\n </tr>\r\n <tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" style=\"height:13.0pt\">library(ggplot2)</td>\r\n </tr>\r\n <tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" style=\"height:13.0pt\">ggplot(df, aes(factor(df$station), df$value)) + </td>\r\n </tr>\r\n <tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" style=\"height:13.0pt\">geom_boxplot() + </td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.5pt\">\r\n  <td height=\"19\" style=\"height:14.5pt\">ggtitle(&quot;ggplot2: not zoomed in,\r\nwith \\nnegatives in y range&quot;)</td></tr></tbody></table></pre><pre style=\"margin-bottom:10px;padding:5px;font-size:13.333333969116211px;background-color:rgb(238,238,238);font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif;overflow:auto;width:auto;max-height:600px;color:rgb(0,0,0);line-height:16.666667938232422px\"><code style=\"font-size:13.333333969116211px;font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif\"><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\"># thanks to help at stackoverflow, I&#39;ve narrowed down to adding and subtracting a percentage of the median:</span></code></pre><pre style=\"margin-bottom:10px;padding:5px;font-size:13.333333969116211px;background-color:rgb(238,238,238);font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif;overflow:auto;width:auto;max-height:600px;color:rgb(0,0,0);line-height:16.666667938232422px\"><code style=\"font-size:13.333333969116211px;font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif\"><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;width:89pt\"><tbody><tr height=\"17\" style=\"height:13.0pt\">\r\n  <td height=\"17\" width=\"118\" style=\"height:13.0pt;width:89pt\">\r\n<table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;color:rgb(0,0,0);width:89pt\"><tbody><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" style=\"height:13pt\">ggplot(df, aes(factor(df$station),\r\ndf$value)) +</td></tr><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" style=\"height:13pt\">geom_boxplot() + <table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;width:89pt\"><tbody><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" style=\"height:13pt\">coord_cartesian(ylim = c(min(df$value)-.5*min(df$value),\r\nmax(df$value)+.5*max(df$value)))   \r\n<br></td></tr></tbody></table></td></tr><tr height=\"19\" style=\"height:14.5pt\"><td height=\"19\" style=\"height:14.5pt\"><br></td></tr></tbody></table></td></tr></tbody></table></span></code><pre style=\"margin-bottom:10px;padding:5px;font-size:13.333333969116211px;font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif;overflow:auto;width:auto;max-height:600px;line-height:16.666667938232422px\"><code style=\"font-size:13.333333969116211px;font-family:Consolas,Menlo,Monaco,&#39;Lucida Console&#39;,&#39;Liberation Mono&#39;,&#39;DejaVu Sans Mono&#39;,&#39;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif\"><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;width:89pt\"><tbody><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" width=\"118\" style=\"height:13pt;width:89pt\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;color:rgb(0,0,0);width:89pt\"><tbody><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" style=\"height:13pt\"><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"118\" style=\"border-collapse:collapse;width:89pt\"><tbody><tr height=\"17\" style=\"height:13pt\"><td height=\"17\" style=\"height:13pt\"># but is there a better way than this for ggplot2 to zoom in &#39;on its own&#39;?  Thank you!</td></tr></tbody></table></td></tr><tr height=\"19\" style=\"height:14.5pt\"><td height=\"19\" style=\"height:14.5pt\"><br></td></tr></tbody></table></td></tr></tbody></table></span></code></pre></pre></div></div>"
    ]
