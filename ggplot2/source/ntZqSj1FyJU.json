 style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent\">=</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">&quot;x&quot;</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(0,0,139)\">class</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent\">=</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">&quot;factor&quot;</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">),</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> value </span><span style=\"font-size:13.333333969116211px;background-color:transparent\">=</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> c</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">(</span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> \r\n</span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(128,0,0)\">1e-04</span><span style=\"font-size:13.333333969116211px;background-color:transparent\">,</span><span style=\"font-size:13.333333969116211px;background-color:transparent\"> </span><span style=\"font-size:13.333333969116211px;background-color:transparent;color:rgb(