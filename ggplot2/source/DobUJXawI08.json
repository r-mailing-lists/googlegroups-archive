;Bitstream Vera Sans Mono&#39;,&#39;Courier New&#39;,monospace,serif\">require(ggplot2)\r\n</code><span style=\"background-color:transparent\">require(scales)\r\n</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">df </span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">&lt;-</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\"> data</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">.</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">frame</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">(</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">x </span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">=</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\"> rnorm</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">(</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline;color:rgb(128,0,0)\">15000</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">),</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">y</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">=</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">rnorm</span><span style=\"background-color:transparent;margin:0px;padding:0px;border:0px;vertical-align:baseline\">(</span><span s