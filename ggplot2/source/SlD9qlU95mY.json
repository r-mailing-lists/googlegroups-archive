     1,
     "<div lang=\"DE\" link=\"#0563C1\" vlink=\"#954F72\"><div><p><span lang=\"EN-US\">Hi,<u></u><u></u></span></p><p><span lang=\"EN-US\">I want to plot an Errorbar-Plot and below the plot a table with the data of the errorbars. How can I plot the columns of the table (defined with tableGrob) directely below the categories of errorbars in the plot?<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"># needed packages<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">require(cowplot)  <u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">require(ggplot2)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">require(gridExtra)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"># Define the data<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">est&lt;-c(1:5)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">data&lt;-data.frame(nr=est,est=est,cil=est-1,ciu=est+1)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"># Plot of the data<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">plot&lt;-ggplot(data,aes(x=factor(nr),y=est)) +<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">  geom_errorbar(aes(ymin=cil,ymax=ciu),width=.1) + <u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">  geom_point(size=3,shape=15)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">plot<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"># Table of the Data<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">tab&lt;-as.data.frame(t(data))<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">tab &lt;- tableGrob(tab,cols=data$nr)<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"><u></u> <u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\"># Arrange and plot Plot and Table  <u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;\">plot_grid(plot,tab, nrow = 2,rel_heights =c(0.75,0.25))<u></u><u></u></span></p><p class=\"MsoNormal\"><span lang=\"EN-US\"><u></u> <u></u></span></p><p>Thanks for any help!<u></u><u></u></p><p>Volker<u></u><u></u></p><p class=\"MsoNormal\"><span lang=\"EN-US\"><u></u> <u></u></span></p></div></div>"
    ]
   ]
