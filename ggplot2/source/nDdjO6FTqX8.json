    [
     1,
     "<font size=\"2\" face=\"sans-serif\">Hi,</font>\r\n<br>\r\n<br><font size=\"2\" face=\"sans-serif\">Here:</font>\r\n<br>\r\n<br><font size=\"2\" face=\"sans-serif\">tst.melt&lt;-melt(tst)</font>\r\n<br><font size=\"2\" face=\"sans-serif\">ggplot(tst.melt,aes(value))+stat_ecdf(aes(group=variable))+facet_wrap(~variable)</font>\r\n<br>\r\n<br><font size=\"2\" face=\"sans-serif\">They recently added stat_ecdf to ggplot2.\r\nI was happy they did. </font>\r\n<br>\r\n<br>\r\n<br>\r\n<br>\r\n<br><font size=\"1\" color=\"#000080\" face=\"sans-serif\"><b>Adam Loveland</b></font><font size=\"1\" color=\"#000080\" face=\"sans-serif\"><b><br>\r\n</b></font>\r\n<br>\r\n<br>\r\n<br>\r\n<br>\r\n<table width=\"100%\">\r\n<tr valign=\"top\">\r\n<td><font size=\"1\" color=\"#5f5f5f\" face=\"sans-serif\">From:</font>\r\n<td><font size=\"1\" face=\"sans-serif\">Keith Weintraub &lt;<a href data-email-masked rel=\"nofollow\">kw1...@gmail.com</a>&gt;</font>\r\n<tr valign=\"top\">\r\n<td><font size=\"1\" color=\"#5f5f5f\" face=\"sans-serif\">To:</font>\r\n<td><font size=\"1\" face=\"sans-serif\">&quot;<a href data-email-masked rel=\"nofollow\">ggp...@googlegroups.com</a>&quot;\r\n&lt;<a href data-email-masked rel=\"nofollow\">ggp...@googlegroups.com</a>&gt;</font>\r\n<tr valign=\"top\">\r\n<td><font size=\"1\" color=\"#5f5f5f\" face=\"sans-serif\">Date:</font>\r\n<td><font size=\"1\" face=\"sans-serif\">02/12/2013 11:31 PM</font>\r\n<tr valign=\"top\">\r\n<td><font size=\"1\" color=\"#5f5f5f\" face=\"sans-serif\">Subject:</font>\r\n<td><font size=\"1\" face=\"sans-serif\">Plotting ecdf</font>\r\n<tr valign=\"top\">\r\n<td><font size=\"1\" color=\"#5f5f5f\" face=\"sans-serif\">Sent by:</font>\r\n<td><font size=\"1\" face=\"sans-serif\"><a href data-email-masked rel=\"nofollow\">ggp...@googlegroups.com</a></font></td></td></tr></td></td></tr></td></td></tr></td></td></tr></td></td></tr></table>\r\n<br>\r\n<hr noshade>"
