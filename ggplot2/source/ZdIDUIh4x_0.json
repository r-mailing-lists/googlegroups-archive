     "<div><div><div style=\"font-family:monospace;background-color:rgb(250,250,250)\"><font color=\"#660066\">ggplot(data=df, aes(x=factor(1), y=quantity, fill=factor(prod))) +</font></div><div style=\"font-family:monospace;background-color:rgb(250,250,250)\"><font color=\"#660066\">  geom_bar(stat=&quot;identity&quot;) +</font></div><div style=\"font-family:monospace;background-color:rgb(250,250,250)\"><font color=\"#660066\">  geom_text(aes(x= factor(1), y=pos, label = quantity), size=10) +  # note y = pos</font></div><div style=\"font-family:monospace;background-color:rgb(250,250,250)\"><font color=\"#660066\">  facet_grid(facets = .~year, labeller = label_value) +</font></div><div style=\"font-family:monospace;background-color:rgb(250,250,250)\"><font color=\"#660066\">  coord_polar(theta = &quot;y&quot;)</font></div></div></div>"
