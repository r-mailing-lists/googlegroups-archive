     1,
     "<div dir=\"ltr\"><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\">​You are probably referring to the <a href=\"https://github.com/tidyverse/ggplot2/blob/f561c3448eb7b7addff0a9251e01cab08d3bb688/R/utilities-break.r#L92\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://github.com/tidyverse/ggplot2/blob/f561c3448eb7b7addff0a9251e01cab08d3bb688/R/utilities-break.r%23L92&amp;source=gmail&amp;ust=1792367374080000&amp;usg=AOvVaw2n9Hh80Ky7bD1uNW6wUZ49\">function defined in utilities-break.r</a>?</div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\">&quot;n&quot; refers to &quot;numbers&quot; in the `equal` parameter. You should be able to deduce the rest from the code. Here&#39;s an example of usage:</div><div class=\"gmail_default\"><blockquote style=\"margin:0px 0px 0px 40px;border:none;padding:0px\"><div class=\"gmail_default\"><font face=\"monospace, monospace\"><br></font></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">breaks &lt;- function(x, equal, nbins = NULL, binwidth = NULL) {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  equal &lt;- match.arg(equal, c(&quot;numbers&quot;, &quot;width&quot;))</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  if ((!is.null(nbins) &amp;&amp; !is.null(binwidth)) || (is.null(nbins) &amp;&amp; is.null(binwidth))) {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    stop(&quot;Specify exactly one of n and width&quot;)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  }</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  </font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  rng &lt;- range(x, na.rm = TRUE, finite = TRUE)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  if (equal == &quot;width&quot;) {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    if (!is.null(binwidth)) {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">      fullseq(rng, binwidth)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    } else {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">      seq(rng[1], rng[2], length.out = nbins + 1)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    }</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  } else {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    if (!is.null(binwidth)) {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">      probs &lt;- seq(0, 1, by = binwidth)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    } else {</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">      probs &lt;- seq(0, 1, length.out = nbins + 1)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    }</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">    stats::quantile(x, probs, na.rm = TRUE)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  }</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  </font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">}</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">  </font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">breaks(1:100, &quot;numbers&quot;, nbins = 4)</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">library(scales) # needs this because of scales::fullseq</font></div></div><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"monospace, monospace\">breaks(1:100, &quot;width&quot;, binwidth = 5)</font></div></div></blockquote></div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\"><div class=\"gmail_default\"><br></div><div class=\"gmail_default\"><br></div></div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\"><br></div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\">Cheers,</div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\">Roman</div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\"><br></div><div class=\"gmail_default\" style=\"font-family:&quot;trebuchet ms&quot;,sans-serif\">​</div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
