/span><span style=\"color:black\">)</span><span style=\"color:black\"> </span><span style=\"color:black\">{</span><span style=\"color:black\">r </span><span style=\"color:black\">&lt;-</span><span style=\"color:black\"> c</span><span style=\"color:black\">(</span><span style=\"color:black\">    quantile</span><span style=\"color:black\">(</span><span style=\"color:black\">x</span><span style=\"color:black\">,</span><span style=\"color:black\">probs</span><span style=\"color:black\">=</span><span style=\"color:black\">c</span><span style=\"color:black\">(</span><span style=\"color:maroon\">0.25</span><span style=\"color:black\">))-(</span><span style=\"color:maroon\">1.5</span><span style=\"color:black\">*(</span><span style=\"color:black\">quantile</span><span style=\"color:black\">(</span><span style=\"color:black\">x</span><span style=\"color:black\">,</span><span style=\"color:black\">probs</span><span style=\"color:black\">=</span><span style=\"color:black\">c</span><span style=\"color:black\">(</span><span style=\"color:maroon\">0.75</span><span style=\"color:black\">))-</span><span style=\"color:black\">quantile</span><span style=\"color:black\">(</span><span style=\"color:black\">x</span><span style=\"color:black\">,</span><span style=\"color:black\">probs</span><span style=\"color:black\">=</span><span style=\"color:black\">c</span><span style=\"color:black\">(</span><span style=\"color:maroon\">0.25</span><span style=\"color:black\">))))</span><span style=\"color:black\">     </span><span style=\"color:black\">,</span><span style=\"color:black\">quantile</span><span style=\"color:black\">(</span><span style=\"color:black\">x</span><span style=\"color:black\">,</span><span style=\"color:black\"> probs </span><span style=\"color:black\">=</span><span style=\"color:black\"> c</span><span style=\"color:black\">(</span><span style=\"color:maroon\">0.25</span><span style=\"color:black\">)),</span><span style=\"color:black\"> quantile</span><span style=\"color:bla