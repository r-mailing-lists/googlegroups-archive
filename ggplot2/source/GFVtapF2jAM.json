     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\">The simplest way would be:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,&quot;sans-serif&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">d &lt;- data.frame(x1=rnorm(100), y1=rnorm(100))<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">ggplot(d, aes(x = x1, y = y1)) +  \r\n<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">  geom_point() +<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:&quot;Courier New&quot;;color:#1f497d\">ylab(expression(&quot;mean score &quot; %+-% &quot; standard error&quot;))<u></u><u></u></span></p></div></div>"
    ],
