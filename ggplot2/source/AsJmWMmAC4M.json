>-0.8490<span style=\"white-space:pre\">\t</span>-0.0604</blockquote></blockquote><div><br></div><div>Commands:</div><div><br></div><div><div>library(ggplot2)</div><div><span style=\"white-space:pre\">\t</span>library(reshape)</div><div><span style=\"white-space:pre\">\t</span>fname&lt;-&quot;table.txt&quot;</div><div><span style=\"white-space:pre\">\t</span>tt&lt;-read.table(fname,header=T,row.names=NULL)</div><div><span style=\"white-space:pre\">\t</span>nsmp &lt;- ncol(tt)-1</div><div><span style=\"white-space:pre\">\t</span>nmod &lt;- nrow(tt)-1</div><div><span style=\"white-space:pre\">\t</span>colnames(tt)[1]&lt;-&quot;Module&quot;</div><div><span style=\"white-space:pre\">\t</span>tt.m&lt;-melt(tt)</div><div><span style=\"white-space:pre\">\t</span>names(tt.m)&lt;-c(&quot;Module&quot;,&quot;Sample&quot;,&quot;value&quot;)</div><div><span style=\"white-space:pre\">\t</span>tt.m$Module&lt;-as.factor(tt.m$Module)</div><div><span style=\"white-space:pre\">\t</span>levels(tt.m$Sample)&lt;-sort(levels(tt.m$Sample))</div><div><span style=\"white-space:pre\">\t</span>levels(tt.m$Module) &lt;- paste(sort(as.integer(levels(tt.m$Module))))</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>title_length &lt;- max(nchar(names(tt)))</div><div><span style=\"white-space:pre\">\t</span>svg_height &lt;- round(10*nsmp/(0.15*title_length+nmod+1),digits=3)</div><div><br></div><div><span style=\"white-space:pre\">\t</span>p &lt;- ggplot(tt.m, aes(Module,Sample)) + geom_tile(aes(fill = value), colour = &quot;black&quot;,size=0.5) + scale_fill_gradient2(low = &quot;blue&quot;, mid=&quot;white&quot;,high = &quot;red&quot;)</div><div><span style=\"white-space:pre\">\t</span>base_size &lt;- 9</div><div><span style=\"white-space:pre\">\t</span>p2 &lt;- p + theme_grey(base_size=base_size)+labs(x=&quot;&quot;,y=&quot;&quot;)+scale_x_discrete(expand=c(0,0))+scale_y_discrete(expand =c(0,0))+theme(legend.position =&quot;none&quot;,axis.text.y=element_text(size=base_size*1.2,colour=&quot;black&quot;),axis.text.x=element_text(size=base_size*1.2,colour=&quot;black&quot;))</div><div><span style=\"white-space:pre\">\t</span>xmin &lt;- 4.5</div><div><span style=\"white-space:pre\">\t</span>xmax &lt;- 5.5</div><div><span style=\"white-space:pre\">\t</span>ymin &lt;- 0.5</div><div><span style=\"white-space:pre\">\t</span>ymax &lt;- nsmp+0.5</div><div><span style=\"white-space:pre\">\t</span>rect &lt;- data.frame(xmin=4.5, xmax=5.5, ymin=0.5, ymax=8.5)</div><div><span style=\"white-space:pre\">\t</span>p3 &lt;- p2 + geom_rect(data=rect, aes(xmin=xmin, xmax=xmax, ymin=ymin, ymax=ymax),color=&quot;black&quot;,fill=&quot;grey&quot;,alpha=0, size=3, inherit.aes = F)</div><div><span style=\"white-space:pre\">\t</span>ggsave(file=&quot;test.svg&quot;, plot=p3, width=10, height=svg_height) </div></div></div><div><br></div></div></blockquote></div></div>"
