\n\t</tbody></table>\r\n\t\r\n\r\n<table bgcolor=\"#f6f6f6\" style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px 40px;width:100%;clear:both\">\r\n  <tbody><tr style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px\">\r\n\t<td style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px\"></td>\r\n\t<td style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;padding:0px;clear:both;display:block;margin:0px auto;max-width:600px\">\r\n\t  \r\n\t  <div style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;padding:0px;margin:0px auto;display:block;max-width:540px\">\r\n\t\t<table style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px;width:100%\">\r\n\t\t  <tbody><tr style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px\">\r\n\t\t\t<td align=\"center\" style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;font-size:14px;line-height:1.6em;margin:0px;padding:0px\">\r\n\t\t\t  <p style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;line-height:1.6em;margin:0px 0px 10px;padding:0px;font-weight:normal;font-size:11px;color:rgb(102,102,102)\">\r\n\t\t\t  \tThis email was sent to <a href data-email-masked rel=\"nofollow\">bgpbra...@gmail.com</a>.\r\n\t\t\t  </p>\r\n\t\t\t  <p style=\"font-family:&quot;Helvetica Neue&quot;,Helvetica,Helvetica,Arial,sans-serif;line-height:1.6em;margin:0px 0px 10px;padding:0px;font-weight:normal;font-size:11px;color:rgb(102,102,102)\">\r\n\t\t\t  You ar