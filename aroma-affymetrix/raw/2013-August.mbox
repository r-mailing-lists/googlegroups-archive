>   > ds2 <- doCRMAv2("Tumor", chipType="GenomeWideSNP_6,Full")
> After that, I do
>  > dataSet <- "HapMap270"
>  > tags <- "ACC,ra,-XY,BPN,-XY,AVG,A+B,FLN,-XY"
>  > chipType <- "GenomeWideSNP_6"
>  > dsN <- AromaUnitTotalCnBinarySet$byName(dataSet, tags=tags, chipType=chipType)
>  > dataSet <- "Tumor"
>  > tags <- "ACC,ra,-XY,BPN,-XY,AVG,A+B,FLN,-XY"
>  > chipType <- "GenomeWideSNP_6"
>  > dsT <- AromaUnitTotalCnBinarySet$byName(dataSet, tags=tags, chipType=chipType)
>  > dfR <- getAverageFile(dsN)   # ?
