library(aroma.affymetrix)
verbose <- Arguments$getVerbose(-8)
timestampOn(verbose)
projectName <- "EndotelioExpr"

chipType <- "HGU133Plus2_Hs_ENSG";
cdf <- AffymetrixCdfFile$byChipType(chipType);
csExpr <- AffymetrixCelSet$byName(projectName,cdf=cdf);

# Background removal
ExprBC <- RmaBackgroundCorrection(csExpr);
ExprcsBC <- process(ExprBC, verbose = verbose);
plotDensity(ExprcsBC, type=”pm”);

