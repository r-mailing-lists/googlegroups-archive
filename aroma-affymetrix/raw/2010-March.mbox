27mar10.png  <- quantile normalize at probeset level, shows "good" MA
plots
Anderson rat ST limma MA plots same scale, aroma rmaBG noQN, QN at
probeset level 27mar10.png
Anderson rat ST limma compare probe level QN to probeset level QN
27mar10.png <- plot logFC of the two QN approaches
Anderson rat ST limma qqplot compare probe level QN to probeset level
QN 27mar10.png <- qqplot of the logFC of the two QN approaches

#######################################
# modified Mark Robinson scripts
doEverything<-function(name,chip,checkChipType=FALSE,
 doExon=FALSE,doCore=FALSE,force=FALSE,doMerge=FALSE,doResiduals=FALSE,
 doWeights=FALSE,getExpression=FALSE,verbose=Arguments$getVerbose(-8),units=NULL,
 doNorm=FALSE, doBG=TRUE, doQN=FALSE) {
# hack warning, doBG=FALSE with doQN=TRUE won't be executed.
# hack warning, if doBG/doQN are TRUE, then set doNorm=FALSE

   cs <- AffymetrixCelSet$byName(name, chipType=chip,
checkChipType=checkChipType)

   cs0 <- cs
   if (doCore)
     chip<-paste(chip,",core",sep="")
   cdf <- AffymetrixCdfFile$byChipType(chip)
   setCdf(cs, cdf)
   csN <- cs
   if(doBG){

    bc <- RmaBackgroundCorrection(cs)
    csBC <- process(bc,verbose=verbose,force=force)
    setCdf(csBC, cdf)

    csN <- csBC
    if(doQN){

      qn <- QuantileNormalization(csBC, typesToUpdate="pm")
      csN <- process(qn, verbose=verbose,force=force) #time required
      setCdf(csN, cdf)
    }
   }
   if(doNorm){
    bc <- RmaBackgroundCorrection(cs)
    csBC <- process(bc,verbose=verbose,force=force)
    setCdf(csBC, cdf)
    qn <- QuantileNormalization(csBC, typesToUpdate="pm")
    csN <- process(qn, verbose=verbose,force=force) #time required
    setCdf(csN, cdf)
   }

   if (doExon)
     plm <- ExonRmaPlm(csN,mergeGroups=doMerge)
   else
     plm <- RmaPlm(csN)
   fit(plm, verbose=verbose, units=units) #time required
   qam <- QualityAssessmentModel(plm)
   chp<-getChipEffectSet(plm)
   d<-NULL; ws<-NULL; rs<-NULL
   if (getExpression) {
     if (!doExon | doMerge)
       d<-getExprs(chp,doExon=F)
     else
       d<-getExprs(chp,doExon=T)
   }
   if (doResiduals)
     rs<-calculateResiduals(plm,verbose=verbose,force=force)
   if (doWeights)
     ws<-calculateWeights(plm,verbose=verbose,force=force)
   list(name=name,chip=chip,d=d,cs=cs0,csN=csN,cdf=cdf,plm=plm,qam=qam,chp=chp,res=rs,wts=ws)

}

getExprs <- function(ces,doExon=FALSE, ...) {
   cdf <- getCdf(ces);
   theta <- extractMatrix(ces, ..., returnUgcMap=TRUE);
   ugcMap <- attr(theta, "unitGroupCellMap");
   if (doExon) {
     x<-getFile(ces,1)
     y<-readUnits(x)
     cn<-names(unlist(y,recursive=F))
     rownames(theta) <-cn
   } else {
     un<-getUnitNames(cdf, ugcMap[,"unit"]);
     rownames(theta) <- un

   }
   log2(theta)

}

