>
>
>pathname <- sprintf("%s.Rbin", sampleName);
>
>
>fit <- loadObject(pathname);
>
>
>data <- getLocusData(fit);
>
>
>rm(fit);
>
>
>
>
>
>
>
>
>## Locate centromeres and other large gaps in data
>
>
