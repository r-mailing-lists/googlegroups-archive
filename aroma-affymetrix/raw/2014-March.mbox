>> arrays <- commandArgs(asValue=TRUE)$arrays;
>> arrays <- eval(parse(text=arrays));
>> arrays <- Arguments$getIndices(arrays);
>>
>> and then you can run the above by:
>>
>> R --args --arrays=1:5 < script.R
>>
