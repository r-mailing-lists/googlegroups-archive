>> >> >>
>> >> >> # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
>> >> >> # Setup data set
>> >> >> # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
>> >> >> cdf <- AffymetrixCdfFile$byChipType(chipType,
>> >> >> tags="coreR1,A20080718,MR");
>> >> >> print(cdf);
>> >> >> csR <- AffymetrixCelSet$byName(dataSet, chipType=chipType);
>> >> >> print(csR);
>> >> >> # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
>> >> >> # gcRMA-style background correction
>> >> >> # - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -
>> >> >> # Currently, you must use the standard CDF file.
>> >> >> cdf <- getCdf(csR);
