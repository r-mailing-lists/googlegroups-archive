>  e[[i]]<-list(x=bpmapdflist[[i]]$pmx[w],y=bpmapdflist[[i]]$pmy[w],
>               pbase=rep("A",np),tbase=rep("T",np),
>               atom=0:(np-1),indexpos=0:(np-1),
>               groupdirection="sense",natoms=np,ncellsperatom=1)
>
