>>> >> >>  However, for doCRMAv2() you need to do something like:
>>> >> >>
>>> >> >> dsC_Nsp <- doCRMAv2(dataSet, chipType="Mapping250K_Nsp",
>>> >> >> verbose=verbose)
>>> >> >> dsC_Sty <- doCRMAv2(dataSet, chipType="Mapping250K_Sty",
>>> >> >> verbose=verbose)
