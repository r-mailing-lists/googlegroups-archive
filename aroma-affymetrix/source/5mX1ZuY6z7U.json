nlo\"><span style=\"color:#2f2fd0\"><br></span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><span style=\"color:#2f2fd0\"><br></span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><span style=\"color:#2f2fd0\">could you pls let me know ?</span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><span style=\"color:#2f2fd0\"><br></span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><span style=\"color:#2f2fd0\">Thanks a lot in advance, </span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><span style=\"color:#2f2fd0\"><br></span></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><font color=\"#2f2fd0\">Sunghee</font></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><font color=\"#2f2fd0\"><br></font></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><font color=\"#2f2fd0\"><br></font></p></div><div><span style=\"color:#2f2fd0\"><br></span></div></div></blockquote></div></div></div>"
