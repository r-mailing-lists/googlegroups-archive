ame(fs, addNames=TRUE)</p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"><br></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\"></p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">&gt; fs &lt;- getFirmaScores(firma)</p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">&gt; asData &lt;- extractDataFrame(fs, addNames=TRUE)</p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">&gt; dim(asData)</p><p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">[1] 29170    13</p><div><br></div><p></p><p></p></div><div><br></div><div><br></div><div><br></div><div>Yet, And also, when i ran previously in oligo library, got 213067 probe indices </div><div><br></div><div><br></div><div>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo;min-height:13.0px\"><br></p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">library(oligo)</p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo;min-height:13.0px\"><br></p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo;color:#2f2fd0\"><span style=\"color:#000000\">celFiles = list.celfiles(</span>&#39;/Users/sungheeoh/Desktop/SUNGHEE/PROJS/KANG/RAW-CELFILES/&#39;<span style=\"color:#000000\">,<a href=\"http://full.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://full.name&amp;source=gmail&amp;ust=1793230173676000&amp;usg=AOvVaw2j_VQNOrrOm4XxgtGlP9kr\">full.name</a> =T)</span></p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">raw = <span style=\"color:#c02d9d\">read</span>.celfiles(celFiles)</p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">exon_rma = rma(raw,target=<span style=\"color:#d62c24\">&quot;probeset&quot;</span>)  #pre-processing/normalization/log2-scale</p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.0px Menlo\">exon_mat &lt;- exprs(exon_rma)</p>\r\n<p style=\"margin:0.0px 0.0px 0.0px 0.0px;font:11.