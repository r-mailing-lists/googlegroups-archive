/span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br></span><span style=\"color:#800\"># check whether transcript filtering has been performed; perform it if not</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">if</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file</span><span style=\"color:#660\">.</span><span style=\"color:#000\">exists</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">output</span><span style=\"color:#660\">.</span><span style=\"color:#000\">folder</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;/PresentTranscripts&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ds</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;.Rdata&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sep </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&quot;</span><span style=\"color:#660\">))){</span><span style=\"color:#000\"><br> load</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">output</span><span style=\"color:#660\">.</span><span style=\"color:#000\">folder</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;/PresentTranscripts&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ds</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </s