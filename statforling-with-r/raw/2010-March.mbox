Like this?

# generate a data frame
x <- c("a", 1, 2, "b")
y <- c(0, 1, 2, "b")
z <- c("a", 1, 2, 3)
a <- data.frame(x, y, z); str(a)

# subset with [] so that only numbers remain
b <- a[2:3,]
str(b) # still factors

# reclassify
b[] <- apply(b, 2, as.numeric)

# check the result
str(b) # done

Cheers,
