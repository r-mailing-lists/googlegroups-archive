      "message_id": "<HdIk1_OeI_c.jDRiTGKHLcQJ@rworldmap.groups.google.com>",
      "from_name": "Jean-Baka Domelevo Entfellner",
      "from_email_hash": "8e5a2b8e679630638e26086a3dfc9965fe9244e05cbdce0e5d6a4007686f7682",
      "date": "2015-07-08T21:05:24Z",
      "subject": "Re: [rworldmap group] Re: Transform individual variables",
      "subject_clean": "[rworldmap group] Re: Transform individual variables",
