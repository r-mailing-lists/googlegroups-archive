     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-IE\" link=\"#467886\" vlink=\"#96607D\" style=\"word-wrap:break-word\">\r\n<div>\r\n<div>\r\n<div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\">Hi everyone,<u></u><u></u></p>\r\n<p class=\"MsoNormal\"> <u></u><u></u></p>\r\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\">We’re seeking a Carpentries-certified instructor to represent Bioconductor at the 2025 Brazilian Genetics Society Meeting in Belém do Pará, Brazil. Help co-teach a Bioconductor workshop and potentially present\r\n a symposia or roundtable to raise awareness of Bioconductor in the Latin American bioinformatics and genetics communities.<u></u><u></u></p>\r\n<ul style=\"margin-top:0cm\" type=\"disc\">\r\n<li class=\"MsoNormal\"><b>Carpentries certification required</b> for co-teaching the workshop</li><li class=\"MsoNormal\"><b>August 13-16, 2025</b> (pending proposal approval)</li><li class=\"MsoNormal\" style=\"margin-bottom:12.0pt\"><b>Travel &amp; accommodation covered</b> for the workshop instructor (grant funding or employer support also encouraged)</li></ul>\r\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\">Interested in solely presenting a symposia or roundtable on Bioconductor? You’re welcome to apply! Travel support is prioritized for the workshop instructor, but the conference covers food and accommodation\r\n for presenters.<u></u><u></u></p>\r\n<p class=\"MsoNormal\">Interested? Complete the <a href=\"https://forms.gle/FQcVNjbVnGe9Yk497\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://forms.gle/FQcVNjbVnGe9Yk497&amp;source=gmail&amp;ust=1793246212488000&amp;usg=AOvVaw21VabnKuBnOyX_YT_5bAif\">\r\nexpression of interest form</a> by <b>Oct 26, 2024!</b><u></u><u></u></p>\r\n<p class=\"MsoNormal\"> <u></u><u></u></p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<table border=\"0\" cellspacing=\"0\" cellpadding=\"0\" style=\"background:white;border-collapse:collapse\">\r\n<tbody>\r\n<tr style=\"height:19.95pt\">\r\n<td width=\"454\" valign=\"top\" style=\"width:12.0cm;padding:2.85pt 0cm 2.85pt 0cm;height:19.95pt\">\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:10.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#005335;border:none windowtext 1.0pt;padding:0cm\">Maria Doyle, PhD</span></b><span style=\"font-size:10.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#005335;border:none windowtext 1.0pt;padding:0cm\"> </span><span style=\"font-size:10.5pt;font-family:&quot;Calibri&quot;,sans-serif;color:#242424\"><u></u><u></u></span></p>\r\n</td>\r\n</tr>\r\n<tr style=\"height:62.7pt\">\r\n<td width=\"454\" valign=\"top\" style=\"width:12.0cm;padding:2.85pt 0cm 2.85pt 0cm;height:62.7pt\">\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.5pt;font-family:&quot;Arial&quot;,sans-serif;color:#00b140;border:none windowtext 1.0pt;padding:0cm\">Bioconductor Community Manager<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.5pt;font-family:&quot;Calibri&quot;,sans-serif;color:#242424\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:10.0pt;font-family:inherit;color:#005335;border:none windowtext 1.0pt;padding:0cm\">School of Medicine, </span><span style=\"font-size:10.5pt;font-family:&quot;Calibri&quot;,sans-serif;color:#242424\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\"><span style=\"font-size:10.0pt;font-family:inherit;color:#005335;border:none windowtext 1.0pt;padding:0cm\">University of Limerick, Limerick, V94 T9PX<br>\r\nIreland<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\" style=\"margin-bottom:12.0pt\"><span style=\"font-size:10.0pt;font-family:inherit;color:#005335;border:none windowtext 1.0pt;padding:0cm\">Email:\r\n</span><span style=\"color:black\"><a href data-email-masked rel=\"nofollow\"><span style=\"font-size:10.0pt;font-family:inherit;color:#0563c1;border:none windowtext 1.0pt;padding:0cm\">maria...@ul.ie</span></a></span><span style=\"font-size:10.0pt;font-family:inherit;color:black;border:none windowtext 1.0pt;padding:0cm\"><br>\r\n</span><span style=\"font-size:10.0pt;font-family:inherit;color:#005335;border:none windowtext 1.0pt;padding:0cm\">Phone (office): <a href=\"tel:+353%2061%20234%20768\" value=\"+35361234768\" target=\"_blank\" rel=\"nofollow\">+353 61 234 768</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:black\">Connect with the Bioconductor community at our conferences:<u></u><u></u></span></b></p>\r\n<ul style=\"margin-top:0cm\" type=\"disc\">\r\n<li class=\"MsoNormal\" style=\"color:black\">\r\n<a href=\"https://biocasia2024.bioconductor.org/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://biocasia2024.bioconductor.org/&amp;source=gmail&amp;ust=1793246212488000&amp;usg=AOvVaw1bJG0QjMDgzQFebwwDn0RA\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:blue;text-decoration:none\">BioCAsia 2024 (November 7-8, Sydney, Australia)</span></a><b><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\"><u></u><u></u></span></b></li><li class=\"MsoNormal\" style=\"color:black\">\r\n<a href=\"https://www.linkedin.com/posts/bioconductor_gbcc2025-bioconductor-galaxy-activity-7236739126190829569-QdEH\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.linkedin.com/posts/bioconductor_gbcc2025-bioconductor-galaxy-activity-7236739126190829569-QdEH&amp;source=gmail&amp;ust=1793246212488000&amp;usg=AOvVaw0jGfjCG8g1ZkQdSmcKuFjZ\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:blue;text-decoration:none\">GBCC 2025 (June 23-26, New York,\r\n USA)</span></a><b><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\"><u></u><u></u></span></b></li><li class=\"MsoNormal\" style=\"color:black\">\r\n<a href=\"https://www.linkedin.com/posts/bioconductor_eurobioc2024-eurobioc2025-activity-7237888796564885505-hUW6\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.linkedin.com/posts/bioconductor_eurobioc2024-eurobioc2025-activity-7237888796564885505-hUW6&amp;source=gmail&amp;ust=1793246212488000&amp;usg=AOvVaw0jkW1oUvv784QyJNgFnNCn\"><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif;color:blue;text-decoration:none\">EuroBioC 2025 (September 17-19, Barcelona,\r\n Spain)</span></a><b><span style=\"font-size:10.0pt;font-family:&quot;Arial&quot;,sans-serif\"><u></u><u></u></span></b></li></ul>\r\n<p class=\"MsoNormal\"><b><i><span style=\"font-family:&quot;Arial&quot;,sans-serif;color:black;border:none windowtext 1.0pt;padding:0cm;background:white\"><u></u> <u></u></span></i></b></p>\r\n<p class=\"MsoNormal\"><i><span style=\"font-size:9.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#222222;border:none windowtext 1.0pt;padding:0cm;background:white\">I work flexible hours across several time zones. I don&#39;t expect you to read or respond to my emails\r\n outside of your normal working hours.<u></u><u></u></span></i></p>\r\n<p class=\"MsoNormal\"><i><span style=\"font-size:9.0pt;font-family:&quot;Arial&quot;,sans-serif;color:#222222;border:none windowtext 1.0pt;padding:0cm;background:white\"><u></u> <u></u></span></i></p>\r\n</td>\r\n</tr>\r\n</tbody>\r\n</table>\r\n<p class=\"MsoNormal\" style=\"vertical-align:baseline\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><img border=\"0\" width=\"160\" height=\"47\" style=\"width:1.6666in;min-height:.4895in\" src=\"https://groups.google.com/group/bioconductor-teaching/attach/99d401244a92/image001%5B76%5D.png?part=0.1&amp;view=1\" alt=\"wKkTIm24wiP8wAAAABJRU5ErkJggg==\"></span><span style=\"font-size:10.5pt;font-family:&quot;Segoe UI&quot;,sans-serif;color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-family:&quot;Calibri&quot;,sans-serif\"><img border=\"0\" width=\"168\" height=\"50\" style=\"width:1.75in;min-height:.5208in\" src=\"https://groups.google.com/group/bioconductor-teaching/attach/99d401244a92/image002%5B3%5D.png?part=0.2&amp;view=1\" alt=\"CbVpSWCd4mx+AAAAAElFTkSuQmCC\"></span><u></u><u></u></p>\r\n</div>\r\n</div>\r\n<div>\r\n<div>\r\n<p class=\"MsoNormal\"> <u></u><u></u></p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n"
