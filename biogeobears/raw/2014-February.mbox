tipranges = tipranges = getranges_from_LagrangePHYLIP(lgdata_fn=np(res$inputs$geogfn))
tipranges
areas = getareas_from_tipranges_object(tipranges)
areas
state_indices_0based = rcpp_areas_list_to_states_list(areas=areas, maxareas=res$inputs$max_range_size, include_null_range=TRUE)
state_indices_0based

# Get the ranges
ranges_list = areas_list_to_states_list_new(areas=areas, maxareas=length(areas),
include_null_range=TRUE, split_ABC=FALSE)
ranges_list
ranges = unlist(ranges_list)
ranges
