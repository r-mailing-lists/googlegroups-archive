Hi Nick,

I have attached the relevant files. Here's the code:

library(GenSA)
library(FD)
library(snow)
library(parallel)
library(rexpokit)
library(cladoRcpp)
library(BioGeoBEARS)

calc_loglike_sp = compiler::cmpfun(calc_loglike_sp_prebyte)
calc_independent_likelihoods_on_each_branch = compiler::cmpfun(calc_independent_likelihoods_on_each_branch_prebyte)

setwd("C:/Users/frp726/OneDrive - Københavns Universitet/Bela/AAR/CMEC genera/plectrophenax/")
list.files()

extdata_dir = np(system.file("extdata", package="BioGeoBEARS"))
extdata_dir
list.files(extdata_dir)

trfn = "C:/Users/frp726/OneDrive - Københavns Universitet/Bela/phylogenies/plectrophenax_newick.tre" # Had to remove 's from the taxa tips otherwise got errors.
moref(trfn)

pdffn = "tree.pdf"
pdf(file=pdffn, width=6, height=6)

tr = read.tree(trfn)
tr
plot(tr)
title("Plectrophenax phylogeny")
axisPhylo()

