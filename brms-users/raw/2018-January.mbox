Hello,

I am learning how to estimate non-linear models using brms.

I would like to run this model, but I am not able to specify the priors correctly:

dat = list(
  "N" = 27,
  "x" =
    c(1, 1.5, 1.5, 1.5, 2.5, 4, 5, 5, 7, 8, 8.5, 9, 9.5, 9.5, 10,
      12, 12, 13, 13, 14.5, 15.5, 15.5, 16.5, 17, 22.5, 29, 31.5),
  "Y" =
    c(1.8, 1.85, 1.87, 1.77, 2.02, 2.27, 2.15, 2.26, 2.47, 2.19,
      2.26, 2.4, 2.39, 2.41, 2.5, 2.32, 2.32, 2.43, 2.47, 2.56, 2.65,
      2.47, 2.64, 2.56, 2.7, 2.72, 2.57))

nlm = nls(Y ~ alpha - beta * lambda^x, data=dat,
           start=list(alpha=1, beta=1, lambda=0.9))
summary(nlm)

# brms

prior1 <- c(prior(normal(0.0, 100), nlpar = 'alpha'),
            prior(normal(0.0, 0.5), nlpar = 'lambda'),
            prior(normal(0.0, 100), nlpar = 'beta'))

fit <- brm(bf(Y ~ alpha - beta * pow(lambda, x),
               alpha + beta ~ 1, lambda ~ 1,
               nl = TRUE),
            data = dat, prior = prior1)

Any help will be appreciated.
Thanks!

