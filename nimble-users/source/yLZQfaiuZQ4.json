dth:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      inv_xi &lt;- 1 / xi </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      # Weibull and Frechet cases</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      # Weibull: xi &lt; 0, x bounded above by mu - sigma / xi</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      # Frechet: xi &lt;0, x bounded below by mu - sigma / xi</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      z1 &lt;- 1 + (x - mu) * xi / sigma</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      # z1 &lt; 0 implies density = 0 in both cases</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\"> </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      if (z1 &gt; 0)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        if (log == 1)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">          return(-(z1 ^ (-inv_xi)) - log(sigma)) - (1 + inv_xi) * log(z1)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        else </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">          return(exp(-(z1 ^ (-inv_xi))) * (1 / sigma) * z1 ^ -(1 + inv_xi))</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      else</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        if (log == 1)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">          return(-Inf)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        else</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        return(0)</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\"><br></blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">    }</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">    else{ </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      # Gumbel case: unbounded support</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      z1 &lt;- (x - mu) / sigma</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      if(log == 1) </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        return(- exp(- z1) - log(sigma) - z1) </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">      else </blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">        return(exp(- exp(- z1)) * (1 / sigma) * exp(-(z1)))</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">    }</blockquote><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\">  })</blockquote><div><br></div></blockquote><div><br></div><div>Any help would be appreciated. I am wondering whether the compiler is worried that sigma might be negative or xi , so that log(sigma) would fail. In fact sigma is constrained in the model to be strictly positive. Maybe the compiler does not know this? I have tried writing an explicit constraint sigma &gt; 0 into the model but that makes no difference to the fatal error. </div><div><br></div><div>Another thought is that if xi = 0, then inv_xi = Inf, but inv_xi is only defined for the cases where xi \\neq 0.</div><div><br></div><div>An earlier version  of this function did run,  did not require  a random generation function, and produced sensible-looking results. (I had made a mistake in the formula for the distribution. That was why I moved on to this new version.) The first time I tried to run this version, however,  I got </div><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left-width:1px;border-left-style:solid;border-left-color:rgb(204,204,204);padding-left:1ex\"> Error in eval(<a href=\"http://as.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://as.name&amp;source=gmail&amp;ust=1792478859081000&amp;usg=AOvVaw0auuqjaS6qHZPp89ENgL9G\">as.name</a>(simulateName)) : object &#39;rnimgev&#39; not found <br></blockquote><div><br></div><div>So I wrote a  random generation function. I found it odd that it was required in one case and not the other.</div><span><font color=\"#888888\"><div><br></div><div><br></div></font></span></div></blockquote></div></div>"
