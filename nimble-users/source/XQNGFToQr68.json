i symbol&quot;,&quot;android emoji&quot;,emojisymbols;font-size:inherit;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;color:rgb(0,0,0)\" dir=\"auto\"><span style=\"font-size:12pt;font-family:calibri,helvetica,sans-serif,emojifont,&quot;apple color emoji&quot;,&quot;segoe ui emoji&quot;,notocoloremoji,&quot;segoe ui symbol&quot;,&quot;android emoji&quot;,emojisymbols\"><br></span></div><div style=\"font-family:calibri,helvetica,sans-serif,emojifont,&quot;apple color emoji&quot;,&quot;segoe ui emoji&quot;,notocoloremoji,&quot;segoe ui symbol&quot;,&quot;android emoji&quot;,emojisymbols;font-size:inherit;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;color:rgb(0,0,0)\" dir=\"auto\"><span style=\"font-size:12pt;font-family:calibri,helvetica,sans-serif,emojifont,&quot;apple color emoji&quot;,&quot;segoe ui emoji&quot;,notocoloremoji,&quot;segoe ui symbol&quot;,&quot;android emoji&quot;,emojisymbols\">Mariana Santos </span></div></div><br></span></div><div style=\"font-size:inherit\" dir=\"auto\"><span style=\"font-family:calibri,helvetica,sans-serif,emojifont,&quot;apple color emoji&quot;,&quot;segoe ui emoji&quot;,notocoloremoji,&quot;segoe ui symbol&quot;,&quot;android emoji&quot;,emojisymbols;font-size:inherit;font-style:normal;font-weight:400;letter-spacing:normal;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;text-decoration:none;float:none;display:inline!important;background-color:rgb(255,255,255);color:rgb(0,0,0)\"><br></span></div>\r\n"
