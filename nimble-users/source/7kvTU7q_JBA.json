x(<a href=\"http://merge.ga\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://merge.ga&amp;source=gmail&amp;ust=1792476104919000&amp;usg=AOvVaw2o2jfbui1FFdyudIy7j4Zj\">merge.ga</a>$pm_cat_order)<br><br><br>rest.comp &lt;- list()<br>for(i in 3:(K-2)){<br>  rest.comp[[i]] &lt;- c(i-2, i-1, i+1, i+2)<br>}<br>rest.comp &lt;- unlist(rest.comp)<br><br>adj = c(2, 3, 1, 3, 4, <br>        rest.comp, <br>        c(K-3, K-2, K, K-2, K-1)<br>)<br><br>num = c(2, 3, rep(4, times = c(K-4)), 3, 2)<br><br>weights = c(c(2, -1, 2, 4, -1), <br>            rep(c(-1, 4, 4, -1), times = c(K-4)),<br>            c(-1, 4, 2, -1, 2))<br></div><div><b><br></b></div><div><b><br></b></div><div><br></div><div><br></div><div><br></div><div>RW2_Code &lt;- nimbleCode(<br>  {<br>    for (i in 1:N){<br>      <br>      O[i] ~ dpois(mu[i])                                # Poisson for observed counts <br>      log(mu[i]) &lt;- log(expected[i])+alpha +beta[i]*index[i]<br>      <br>      beta[i]&lt;-u[pm.ord[i]]+u[sm.ord[i]]+u[un.ord[i]]<br>    } <br>    <br>  <br>    u[1:K] ~ dcar_normal(adj = adj[1:L], weights  = weights[1:L], num = num[1:K], <br>                         tau = tau.u, c = 2, zero_mean = 1)<br>    <br>    <br>    # Priors:<br>    alpha ~ dflat()                                     <br>    exp.alpha &lt;- exp(alpha)<br>    <br><br>   <br>    tau.u ~ dgamma(1, 0.01)                            <br>    sigma2.u &lt;- 1/tau.u  <br><br>  }<br>)<br></div></div></div>\r\n"
