#000\"> </span><span style=\"color:#066\">2</span><span style=\"color:#000\"><br><br>poisHRegData </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">=</span><span style=\"color:#000\">Y</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                  X</span><span style=\"color:#660\">=</span><span style=\"color:#000\">X</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>poisHRegConsts </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">N</span><span style=\"color:#660\">=</span><span style=\"color:#000\">N</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                     K</span><span style=\"color:#660\">=</span><span style=\"color:#000\">K</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                     M</span><span style=\"color:#660\">=</span><span style=\"color:#000\">M</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>poisHRegInits </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">B_hat</span><span style=\"color:#660\">=</span><span style=\"color:#000\">rep</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\">K</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br>poisHRegModel </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> nimbleModel</span><span style=\"color:#660\">(</span><span style=\"color:#000\">code</span><span style=\"color:#660\">=</span><span style=\"color:#000\">poisHRegCode</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                        data</span><span style=\"color:#660\">=</span><span style=\"color:#000\">poisHRegData</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                        inits</span><span style=\"color:#660\">=</span><span style=\"color:#000\">poisHRegInits</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                        constants</span><span style=\"color:#660\">=</span><span style=\"color:#000\">poisHRegConsts</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#compile nimble model to C++ code—much faster runtime</span><span style=\"color:#000\"><br>C_poisHRegModel </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> compileNimble</span><span style=\"color:#660\">(</span><span style=\"color:#000\">poisHRegModel</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> showCompilerOutput </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> FALSE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#configure the MCMC</span><span style=\"color:#000\"><br>poisHRegModel_conf </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> configureMCMC</span><span style=\"color:#660\">(</span><span style=\"color:#000\">poisHRegModel</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#add monitors</span><span style=\"color:#000\"><br>poisHRegModel_conf$addMonitors</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;B&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#build MCMC</span><span style=\"color:#000\"><br>poisHRegModelMCMC </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> buildMCMC</span><span style=\"color:#660\">(</span><span style=\"color:#000\">poisHRegModel_conf</span><span style=\"color:#660\">,</span><span style=\"color:#000\">thin</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">enableWAIC </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> TRUE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#compile MCMC to C++—much faster</span><span style=\"color:#000\"><br>C_poisHRegModelMCMC </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> compileNimble</span><span style=\"color:#660\">(</span><span style=\"color:#000\">poisHRegModelMCMC</span><span style=\"color:#660\">,</span><span style=\"color:#000\">project</span><span style=\"color:#660\">=</span><span style=\"color:#000\">poisHRegModel</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#number of MCMC iterations</span><span style=\"color:#000\"><br>niter</span><span style=\"color:#660\">=</span><span style=\"color:#066\">10000</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#set seed for replicability</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">set</span><span style=\"color:#660\">.</span><span style=\"color:#000\">seed</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#call the C++ compiled MCMC model</span><span style=\"color:#000\"><br>C_poisHRegModelMCMC$run</span><span style=\"color:#660\">(</span><span style=\"color:#000\">niter</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\">#save the MCMC chain (monitored variables) as a matrix</span><span style=\"color:#000\"><br>samples </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">matrix</span><span style=\"color:#660\">(</span><span style=\"color:#000\">C_poisHRegModelMCMC$mvSamples</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>WAIC </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> C_poisHRegModelMCMC$calculateWAIC</span><span style=\"color:#660\">(</span><span style=\"color:#000\">nburnin</span><span style=\"color:#660\">=</span><span style=\"color:#066\">1000</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span></div></code></div><br><br></div></div>"
    ]
   ]
