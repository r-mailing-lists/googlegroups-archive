Hi Perry,

You were right for sum(u[1,1]). That was the proble! Now we became bolder and are trying to include a nimble function that calculates the likelihood conditional on the current parameter values. We have managed to write it and checked that it works. However, we do not manage to incorporate it in the model code. When executing

nimbleModel(DDCode,constants = list(C=10000,s=bugs.data$s),data = bugs.data[1:4], inits = inits())

we get a message as if the nimble function was not recognized as such:

Error in getSymbolicParentNodesRecurse(code, constNames, indexNames, nimbleFunctionNames,  :
  R function 'condL' has arguments that cannot be evaluated; either the function must be a nimbleFunction or values for the following inputs must be specified as constants in the model: phi,rho,p,mu.

Our nimble function has a setup and a run part. We could not find an example of a nimble function called within a model code that has a setup. We are unsure if we should use the nimbleFunction generator or the instance we have created with the data in the model code. I guess that we should mention the uncompiled version anyway, true?

DDCode <-  nimbleCode({
  ########### PRIORS #######################

  # gamma[1] <- 0

  phi[s] <- 0
  # logit constraint for phi
  for (t in 1:(s-1)){
    phi[t] <- 1 / (1 + exp(-logit.phi[t]))
    logit.phi[t] <- mu.phi + eps.phi[t]
    eps.phi[t] ~ dnorm(0, tau.phi)
  }
  mu.phi <- log(mean.phi / (1-mean.phi))
  mean.phi ~ dunif(0,1)
  tau.phi <- 1 / (sigma.phi * sigma.phi)
  sigma.phi ~ dunif(0, 5)
  # log constraint for PGR
  for (t in 1:(s-1)){
    rho[t] <- exp(log.rho[t])
    log.rho[t] <- mu.rho + eps.rho[t]
    eps.rho[t] ~ dnorm(0, tau.rho)
  }
  mu.rho ~ dnorm(0, 0.1)
  mean.rho <- exp(mu.rho)
  tau.rho <- 1 / (sigma.rho * sigma.rho)
  sigma.rho ~ dunif(0, 2)
  # logit constraint for p
  for (t in 1:s){
    p[t] <- 1 / (1 + exp(-logit.p[t]))
    logit.p[t] <- mu.p + eps.p[t]
    eps.p[t] ~ dnorm(0, tau.p)
    # no constraints for mu
    mu[t] ~ dunif(0,1)
  }
  mu.p <- log(mean.p / (1-mean.p))
  mean.p ~ dunif(0,1)
  tau.p <- 1 / (sigma.p * sigma.p)
  sigma.p ~ dunif(0, 5)
  ########### LIKELIHOOD (ZERO-TRICK) ######
  zeros ~ dpois(zero.mean)
  zero.mean <- -L +

C
  L <- condL(phi,rho,p,mu)
}
)

Here is the Nimble generator:

condL <- nimbleFunction(
  setup = function(u,n,v,d,s) {  ## setup is evaluated in R, never compiled
    firstexpo <- numeric(length = s)
    secondexpo_a <- numeric(length = s)
    secondexpo_b <- numeric(length = s)
    secondexpo <- numeric(length = s)
    thirdexpo <- numeric(length = s-1)
    fourthexpo <- numeric(length = s)
    fifthexpo <- numeric(length = s)
    sixthexpo <- numeric(length = s)
    ##### constants for the first occasion
    secondexpo_a[1] <- u[1]

    secondexpo_b[1] <- 0
    secondexpo[1] <- secondexpo_a[1] - secondexpo_b[1] - n[1]
    thirdexpo[1] <- sum(v[2:s])
    fourthexpo[1] <- n[1]-d[1]
    fifthexpo[1] <- sum(u[2:s])
    sixthexpo[1] <- v[1]-d[1]

    ##### constants for the last occasion

    firstexpo[s] <- sum(u[1:(s-1)])
    secondexpo_a[s] <- sum(u[1:s])
    secondexpo_b[s] <- sum(v[1:(s-1)])
    secondexpo[s] <- secondexpo_a[s] - secondexpo_b[s] - n[s]
    fourthexpo[s] <- n[s]-d[s]
    fifthexpo[s] <- 0
    sixthexpo[s] <- v[s]-d[s]

    ##### constants for intermediate occasions

    for (i in 2:(s-1)) {

      # first exponent
    firstexpo[i] <- sum(u[1:(i-1)])
    # second exponent
    secondexpo_a[i] <- sum(u[1:i])
    secondexpo_b[i] <- sum(v[1:(i-1)])
    secondexpo[i] <- secondexpo_a[i] - secondexpo_b[i] - n[i]
    # third exponent
    thirdexpo[i] <- sum(v[(i+1):s])
    # fourth exponent
    fourthexpo[i] <- n[i]-d[i]
    # fifth exponent
    fifthexpo[i] <- sum(u[(i+1):s])
    # sixth exponent
    sixthexpo[i] <- v[i]-d[i]
    }

    denom_expo <- sum(u[1:s])
  },
  run = function(phi = double(1), rho = double(1), p = double(1), mu =  double(1)) { ## This is compilable, so type declarations are needed, phi, rho, p, mu HERE ?!!!!
    returnType(double(0))
    xi <- numeric(length = s)
    xi.tmp <- numeric(length = s)
    chi <- numeric(length = s)
    gamma <- numeric(length = s)
    gamma_constr <- numeric(length = s)
    l.num <- numeric(length = s)
    PROD1 <- numeric(length = s)
    PROD2 <- numeric(length = s)
    denom_base_tmp <- numeric(length = s)
    PROD1_tmp <- matrix(nrow = s, ncol = s)
    PROD2_tmp <- matrix(nrow = s, ncol = s)

    ################# Gamma as derived parameter

    for (i in 2:s) {

      gamma[i] <- (phi[i-1] / rho[i-1])
      gamma_constr[i] <- min(gamma[i],1)
    }

    ################# Define xi and chi

    xi[1] <- 1
    chi[s] <- 1

    for (i in 2:s) {
      xi.tmp[i] <- (1-gamma[i]) + (gamma[i] * ((1-p[i-1])/(1-(p[i-1] * (1-mu[i-1])))) * xi[i-1])
      xi[i] <- max(xi.tmp[i],0.00001)
    }

    for (i in 1:(s-1)) {

      chi[i] <- (1-phi[i]) + (phi[i] * (1-p[i+1]) * chi[i+1])
    }

    ##### log-likelihood for the first occasion
    l.num[1] <- (u[1] * log(xi[1])) + (n[1] * log(p[1])) + (secondexpo[1] * log(1-p[1])) +
      (thirdexpo[1] * log(phi[1])) + (fourthexpo[1] * log(mu[1])) + (d[1] * log(1-mu[1])) + (fifthexpo[1] * log(1-(p[1]*(1-mu[1])))) +
      (sixthexpo[1] * log(chi[1]))

    ##### log-likelihood for the last occasion
    l.num[s] <- (u[s] * log(xi[s])) + (firstexpo[s] * (log(phi[s-1]) - log(rho[s-1]))) + (n[s] * log(p[s])) + (secondexpo[s] * log(1-p[s])) +
      (fourthexpo[s] * log(mu[s])) + (d[s] * log(1-mu[s])) + (fifthexpo[s] * log(1-(p[s]*(1-mu[s])))) +
      (sixthexpo[s] * log(chi[s]))

    ##### log-likelihood from occasion 2 to s-1

    for (i in 2:(s-1)) {
      l.num[i] <- (u[i] * log(xi[i])) + (firstexpo[i] * (log(phi[i-1]) - log(rho[i-1]))) + (n[i] * log(p[i])) + (secondexpo[i] * log(1-p[i])) +
        (thirdexpo[i] * log(phi[i])) + (fourthexpo[i] * log(mu[i])) + (d[i] * log(1-mu[i])) + (fifthexpo[i] * log(1-(p[i]*(1-mu[i])))) +
        (sixthexpo[i] * log(chi[i]))
    }

      ##### likelihood denominator
      # 1st product
      PROD1[1] <- 1
      for (j in 1:(s-1)){
        PROD1_tmp[1,j] <- 0
      }
      # fill part of PROD1_tmp
      for (i in 2:(s-1)) {
        for (j in i:(s-1)){
          PROD1_tmp[i,j] <- 0
        }
      }
      for (i in 2:s) {
        for (j in 1:(i-1)){
          PROD1_tmp[i,j] <- phi[j] * (1-(p[j]*(1-mu[j])))
        }
      }
      PROD1[2] <- PROD1_tmp[2,1]
      for (i in 3:s) {
        PROD1[i] <- prod(PROD1_tmp[i,1:(i-1)])
      }
      # 2nd product
      PROD2[s] <- 1
      for (i in 1:(s-1)) {
        for (j in (i+1):s) {
          PROD2_tmp[i,j] <- gamma[j]
        }
      }
      # fill part of PROD2_tmp
      for (i in 1:(s-1)) {

        for (j in 1:i) {
          PROD2_tmp[i,j] <- 0
        }
      }
      PROD2[s-1] <- PROD2_tmp[(s-1),s]
      for (i in 1:(s-2)) {
        PROD2[i] <- prod(PROD2_tmp[i,(i+1):s])
      }
      for (i in 1:s) {
        denom_base_tmp[i] <- xi[i] * PROD1[i] * PROD2[i] * p[i]
      }
      denom_base <- sum(denom_base_tmp[1:s])

      l.denom <- denom_expo * log(denom_base)

    return(sum(l.num[1:s]) - l.denom)
    }
)

