From uc48a384dbad0597c at groups.google.com  Sat Sep 29 19:29:11 2018
From: uc48a384dbad0597c at groups.google.com (Seongeun Jeong)
Date: Sat, 29 Sep 2018 19:29:11 +0000
Subject: Re: Help for state space modeling using NIMBLE particle filter
Message-ID: <MS7qnz3Lkj4.xrge0OLYAgAJ@nimble-users.groups.google.com>
In-Reply-To: <MS7qnz3Lkj4.b2nQ1GB1AAAJ@nimble-users.groups.google.com>
References: <MS7qnz3Lkj4.b2nQ1GB1AAAJ@nimble-users.groups.google.com>
Archived-At: <https://groups.google.com/g/nimble-users/c/MS7qnz3Lkj4/m/xrge0OLYAgAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

I spent some more time to figure out what's happening here.

The bottom line is that the following form does not work in NIMBLE:

 y [i,1:2] ~ dmnorm(mean=X[1:2], cov = R[1:2,1:2])

It does NOT mean that it doesn't compile/run. It does run but the result is entirely wrong.

To verify this, I modified the previous code (the first post; also fixed a typo and changed some priors) and used a normal MCMC (i.e. RW sampler, not RW_PF type) for this state space model. The final results are very similar to what I expected reading Shumway & Stoffer.

Separately, I analytically derived the Kalman filter solution for this model (here I didn't include the drift term - seems to have minimal impact in this case - to make the math simpler), wrote its implementation in R and got a similar result to that of Shumway and Stoffer:

sigw: 0.05871642
cR11: 0.07400443
cR22: 0.12335148
cR12:: 0.13670587

This suggests to me that Shumway & Stoffer's estimates are correct.

One thing to note is that the normal NIMBLE MCMC is much faster (100x) than the top-down parameter estimation using Particle MCMC. Here Particle MCMC means an implementation like this:

---------------------
  N = 5000
  stateSpaceMCMCconf <- configureMCMC(stateSpaceModel, nodes = NULL)
   stateSpaceMCMCconf$addSampler(target = c('r11', 'r12', 'r22', 'tau_sigw', 'd'),
                                type = 'RW_PF_block', control = list(latents = 'x'))
  stateSpaceMCMC <- buildMCMC(stateSpaceMCMCconf)
  compiledList <- compileNimble(stateSpaceModel, stateSpaceMCMC, resetFunctions = TRUE)
  compiledList$stateSpaceMCMC$run(N)
 posteriorSamps <- as.mcmc(as.matrix(compiledList$stateSpaceMCMC$mvSamples))

-----------------------

Of course, my analytical solution with the 'optim"-based MLE is even faster than any NIMBLE solution (but I don't like the MLE approach in general ...).

The remaining question is how I can include the off-diagonal term in the R covariance matrix in the observation equation. As shown below in the code, I used on-diagonal terms only because, as mentioned, the dmnorm(mean=X[1:2], cov = R[1:2,1:2])  form cannot be used. Please let me know if there is a way to do this!

If this can be added to future NIMBLE development, it will be great!

Please let me know it if there is any comment or thought.

Thank you.

- Seongeun

################################# CODE ##############################

library (nimble)
library(coda)
set.seed(1)
#
#One is globtemp, which was considered in the first chapter, and are
#the global mean land-ocean temperature index data. The second series, globtempl,
#are the surface air temperature index data using only meteorological station data.
#Conceptually, both series should be measuring the same underlying climatic signal,
#and we may consider the problem of extracting this underlying signal.

load ('globtemp.rda')
load ('globtempl.rda')

y = cbind (as.vector (globtemp), as.vector (globtempl))

stateSpaceCode <- nimbleCode({

  # drift

  d ~ dnorm(0, sd = 0.05)

  #sigw ~  dunif (0, 1)#T(dnorm (0, 10), 0.0001, )

  tau_sigw ~ dgamma(0.001, 0.001)
  sigw <- 1/sqrt(tau_sigw)

  x[1] ~ dnorm(-0.35, sd = 0.1) # a bit sensitive to sd of 0.1 or 1.

  #----------------------------------------------------------------------------
  # Observation equation
  #----------------------------------------------------------------------------
  #X1 [1] <- x[1]
  #X1 [2] <- x[1]
  #y [1,1:2] ~ dmnorm(mean=X1[1:2], cov = R[1:2,1:2])

  y [1,1] ~ dnorm(mean=x[1], sd = sqrt(R[1,1]))
  y [1,2] ~ dnorm(mean=x[1], sd = sqrt(R[2,2]))

  for (i in 2:t) {

    #----------------------------------------------------------------------------
    # State equation
    #----------------------------------------------------------------------------

    #xt = d + xt−1 + wt

    predX [i] <- x[i - 1] + d
    x[i] ~ dnorm(mean= predX[i], sd = sigw)

    predY [i] <- x[i]

    X [1] <- x[i]
    X [2] <- x[i]

    #----------------------------------------------------------------------------
    # Observation equation
    #----------------------------------------------------------------------------

    # observation model: yt = Axt + vt,
    # where yt = [yt1, yt2]^T, A = [1,1]^T and vt = [vt1, vt2]^T

    #----------------------------------------------------------------------------
    # The following multivariate normal does NOT work!
    # y [i,1:2] ~ dmnorm(mean=X[1:2], cov = R[1:2,1:2])
    #----------------------------------------------------------------------------

    y [i,1] ~ dnorm(mean=x[i], sd = sqrt(R[1,1]))
    y [i,2] ~ dnorm(mean=x[i], sd = sqrt(R[2,2]))

  }

  # observation noise using Cholesky decomposition to be consistent with Shumway & Stoffer

  if (USE_PRECISION) {
    r11 ~ dgamma(0.001,0.001)
    #r12 ~ dgamma(0.001,0.001)
    r22 ~ dgamma(0.001,0.001)

    if (USE_CHOL) {
        cR[1,1] <- 1/sqrt(r11)#,2)
        #cR[1,2] <- 1/sqrt(r12)#,2)
        cR[1,2] <- 0 # no correlated error for now
        cR[2,1] <- 0
        cR[2,2] <- 1/sqrt(r22)#,2)

        R[1:2,1:2] <- t(cR[1:2,1:2])%*%cR[1:2,1:2]
   } else {
      R [1,1] <- 1/r11
      R [2,2] <- 1/r22
      R [1,2] <- 0
      R [2,1] <- 0
    }

  } else {

    r11 ~ T(dt(mu = 0, sigma = 1, df=1), 0, 100)
    r12 ~ T(dt(mu = 0, sigma = 1, df=1), 0, 100)
    r22 ~ T(dt(mu = 0, sigma = 1, df=1), 0, 100)

    if (USE_CHOL) {
      cR[1,1] <- r11#,2)
      #cR[1,2] <- r12#,2) # No correlation for now
      cR[1,2] <- 0
      cR[2,1] <- 0
      cR[2,2] <- r22#,2)
      R[1:2,1:2] <- t(cR[1:2,1:2])%*%cR[1:2,1:2]
    } else {

      R [1,1] <- pow (r11,2)

      R [2,2] <- pow (r22,2)
      R [1,2] <- 0
      R [2,1] <- 0

    }
  }

})

## define data, constants, and initial values
data <- list(
  y = y
)
constants <- list(
  t = nrow (y)
)

inits <- list(
  r11 = .1,

  #r12 = .1,

  r22 = .1,
  d = 0,

  predY = rep (0, nrow (y)),
  tau_sigw = 0.05)

################################################################################
# Option
################################################################################
USE_PRECISION = TRUE
USE_CHOL = FALSE # Cholesky decomposition

N.SAMPLE = 55000
N.BURN.IN <http://N.BURN.IN> = 5000

################################################################################
# Build and compile
################################################################################

stateSpaceModel <- nimbleModel(stateSpaceCode,
                               data = data,
                               constants = constants,
                               inits = inits,
                               check = FALSE)

compileNimble(stateSpaceModel)

modelConf <- configureMCMC(stateSpaceModel, print = FALSE, thin=1)
modelConf$addMonitors(c('predY'))
cat ('### build MCMC\n')
modelMCMC <- buildMCMC(modelConf)
cat ('### compile MCMC\n')
CmodelMCMC <- compileNimble(modelMCMC)
CmodelMCMC$run(N.SAMPLE)

mcmcChain <- as.matrix(CmodelMCMC$mvSamples) [(N.BURN.IN <http://N.BURN.IN>+1):N.SAMPLE, ]

################################################################################
# Summary
################################################################################
cat ('d mean: ', mean(mcmcChain[,'d']), '\n')

if (USE_PRECISION) {
  # Only diagonal R
  cat ('r11 mean: ', 1/sqrt(mean(mcmcChain[,'r11'])), '\n')
  #cat ('r12 mean: ', 1/sqrt(mean(mcmcChain[,'r12'])), '\n')
  cat ('r22 mean: ', 1/sqrt(mean(mcmcChain[,'r22'])), '\n')
  cat ('sigw mean: ', 1/sqrt(mean(mcmcChain[,'tau_sigw'])), '\n')
} else {
  cat ('r11 mean: ', mean(mcmcChain[,'r11']), '\n')
  #cat ('r12 mean: ', mean(mcmcChain[,'r12']), '\n')
  cat ('r22 mean: ', mean(mcmcChain[,'r22']), '\n')
  cat ('sigw mean: ', 1/sqrt(mean(mcmcChain[,'tau_sigw'])), '\n')
}

################################################################################
# Some check plotting
################################################################################
par(mfrow=c(2,1))
plot(mcmcChain[,'d'], ylab = 'd')

X = mcmcChain [,grep ('predY', colnames (mcmcChain))]
#X = mcmcChain [,grep ('x', colnames (mcmcChain))]
post_x = apply (X, 2,mean)
plot (1:length (globtemp), globtemp,ylim = c(-1,1), type='p', pch=2, col=4)
lines (1:length (globtemp), globtempl, lty=2, type='p', pch=3, col=3)
legend(1, legend=c('land+ocean', 'land'), col=c(4,2), pch=2:3)
lines(1:length (globtemp),post_x , type='l', lwd=2)

