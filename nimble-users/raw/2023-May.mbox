From u9ff774745d3091db at groups.google.com  Wed May 10 20:46:58 2023
From: u9ff774745d3091db at groups.google.com (Ethan)
Date: Wed, 10 May 2023 20:46:58 +0000
Subject: Obtaining conjugacy for square-breaking EDP
Message-ID: <s3_QMAX2uOw.iUzBt3RLBAAJ@nimble-users.groups.google.com>
Archived-At: <https://groups.google.com/g/nimble-users/c/s3_QMAX2uOw/m/iUzBt3RLBAAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

Hello,

I am attempting to implement the square-breaking representation of the enriched Dirichlet Process (EDP) model of Wade et al. (2011, 2014) [https://www.jmlr.org/papers/volume15/wade14a/wade14a.pdf]

My understanding of the model is that the latent cluster IDs for covariates are nested. After implementing the model, everything looks good except I cannot obtain a conjugate posterior for the stick-breaking variables associated with the covariates. I suspect this is due to the fact that I have an array of stick-breaking variables and a single index for the covariate cluster membership. I am seeking a workaround.

I have provided a minimum reproducible example below:

library(nimble)

edpCodeStick <- nimbleCode({
  ## Prior for DP concentration parameters
  conc_x ~ dgamma(1, 1)
  conc_y ~ dgamma(1, 1)

  ## Variables for stick-breaking
  for ( i in 1:(Ly-1) )
    vy[i] ~ dbeta(1, conc_y)
  ## Cluster weights
  wy[1:Ly] <- stick_breaking(vy[1:(Ly-1)])

  ## Stick-breaking subclusters
  for ( i in 1:Ly ) {
    for ( j in 1:(Lx-1) )
      vx[j, i] ~ dbeta(1, conc_x)
    ## Subcluster weights
    wx[1:Lx, i] <- stick_breaking(vx[1:(Lx-1), i])
  }
  ## Loop through y clusters
  for ( i in 1:Ly ) {
    intercept[i] ~ dnorm(0, sd = 10)
    beta[i]      ~ dnorm(0, sd = 10)
    prec[i]      ~ dgamma(0.1, 0.1)
    ## Loop through subclusters
    for ( j in 1:Lx ) {
      mu_x[j,i] ~ dnorm(0, sd = 10)
      prec_x[j,i] ~ dgamma(0.1, 0.1)
    }
  }

  ## Loop through observations
  for ( i in 1:n ) {
    ## Likelihood of latent variables; zx is nested within zy
    zy[i] ~ dcat(wy[1:Ly])
    zx[i] ~ dcat(wx[1:Lx, zy[i]])

    ## Likelihood of outcome | covariates, class--locally normal distribution
    y[i] ~ dnorm(intercept[zy[i]] + beta[zy[i]] * x[i], tau = prec[zy[i]])

    ## Likelihood of covariates
    x[i] ~ dnorm(mu_x[zx[i], zy[i]], tau = prec_x[zx[i], zy[i]])
  }
})

## Create data
n   <- 100
rho <- 0.5
cor <- matrix(rho, 2, 2) + diag(1 - rho, 2)
sd  <- c(1, 2)
cov <- diag(sd) %*% cor %*% diag(sd)
U   <- chol(cov)
D   <- matrix(rnorm(2*n), nrow = n, ncol = 2) %*% U
y   <- 2 + D[, 1]
x   <- 3 + D[, 2]

## Obtain Nimble constants, data, and initial values
nimConst <- list(n = length(y), Ly = 3, Lx = 3)
nimDat   <- list(y = y, x = x)
nimInit  <- list(
    zy = rep(1, nimConst$n)
  , zx = rep(1, nimConst$n)
  , vy = rbeta(nimConst$Ly-1, 1, 1)
  , intercept = rep(mean(y), nimConst$Ly)
  , beta      = rep(0, nimConst$Ly)
  , prec      = rep(1 / var(y), nimConst$Ly)
  , vx        = sapply(1:nimConst$Ly, function(i) rbeta(nimConst$Lx-1, 1, 1))
  , mu_x      = sapply(1:nimConst$Ly, function(i) rep(mean(x), nimConst$Lx))
  , prec_x    = sapply(1:nimConst$Ly, function(i) rep(1 / var(x), nimConst$Lx))
  , conc_y = 1, conc_x = 1
)

## Obtain nimble model and compile
model <- nimbleModel(
  code = edpCodeStick, constants = nimConst, data = nimDat, inits = nimInit
)
cmodel <- compileNimble(model)

## Configure the MCMC--results in non-conjugate posterior for vx
mcmcConf <- configureMCMC(cmodel)

