Thanks, Daniel! I wasn't really sure how to implement what you suggested, but I was able to write a conjugate sampling code (for vx, conc_x, and conc_y). Pasting below for everyone's reference in case people ask about this in the future.

sampler_vx <- nimbleFunction(
  name = 'sampler_vx',
  contains = sampler_BASE,
  setup = function(model, mvSaved, target, control) {
    targetElements  <- model$expandNodeNames(target, returnScalarComponents = TRUE)
    conc_x_names    <- model$getParents(target, stochOnly = TRUE, self = FALSE, immediateOnly = TRUE)
    conc_x          <- values(model, conc_x_names)
    Ly              <- length(conc_x)
    vx              <- values(model, target)
    Lx              <- length(vx) / Ly + 1
    zx_names        <- model$getDependencies(target, self = FALSE, stochOnly = TRUE)
    zy_names        <- model$getParents(zx_names, omit = target, stochOnly = TRUE)
    vy_names        <- model$getParents(zy_names, stochOnly = TRUE)
    zy              <- values(model, zy_names)
    zx              <- values(model, zx_names)
    n               <- length(zx_names)
  }
  , run = function() {
    vx_new <- matrix(nrow = Lx-1, ncol = Ly)
    ## Loop through clusters

    for ( i in 1:Ly ) {

      yclustIndx  <- zy == i
      yclustSize  <- sum(yclustIndx)
      for ( j in 1:(Lx-1) ) {
        xclustSize   <- sum((yclustIndx) & (zx == j))
        post_shape1  <- xclustSize + 1
        post_shape2  <- conc_x[i] + sum((yclustIndx) & (zx > j))
        ## Update model
        vx_new[j, i] <- rbeta(1, post_shape1, post_shape2)
      }
    }
    values(model, target) <<- c(vx_new)
    model$calculate(target)
    nimCopy(from = model, to = mvSaved, row = 1, nodes = target, logProb = TRUE)
  }
  , methods = list(
    reset = function() { }
  )
)

sampler_conc_x <- nimbleFunction(
  name = 'sampler_conc_x',
  contains = sampler_BASE,
  setup = function(model, mvSaved, target, control) {
    targetElements  <- model$expandNodeNames(target, returnScalarComponents = TRUE)
    conc_x          <- values(model, target)
    Ly              <- length(conc_x)
    vx_names        <- model$getDependencies(targetElements, stochOnly = TRUE, self = FALSE)
    vx              <- values(model, vx_names)
    Lx              <- (length(vx_names)) / Ly + 1
  }
  , run = function() {
    conc_x_new <- rep(0, Ly)
    ## Loop through clusters

    for ( i in 1:Ly ) {

      ## Obtain corresponding Vx's
      vx_i          <- vx[ i * ( 1:(Lx-1) ) ]
      postShape     <- Lx + model$getParam(targetElements[i], 'shape') - 1
      postRate      <- model$getParam(targetElements[i], 'rate') - sum(log(1 - vx_i))
      conc_x_new[i] <- rgamma(n = 1, shape = postShape, rate = postRate)
    }
    values(model, target) <<- conc_x_new
    model$calculate(target)
    nimCopy(from = model, to = mvSaved, row = 1, nodes = target, logProb = TRUE)
  }
  , methods = list(
    reset = function() { }
  )
)

sampler_conc_y <- nimbleFunction(
  name = 'sampler_conc_y',
  contains = sampler_BASE,
  setup = function(model, mvSaved, target, control) {
    targetElements  <- model$expandNodeNames(target, returnScalarComponents = TRUE)
    conc_y          <- values(model, target)
    vy_names        <- model$getDependencies(target, self = FALSE, stochOnly = TRUE)
    Ly              <- length(vy_names) + 1
    vy              <- values(model, vy_names)
  }
  , run = function() {
    postShape  <- Ly + model$getParam(node = target, param = 'shape') - 1
    postRate   <- model$getParam(node = target, param = 'rate') - sum( log( 1 - vy ) )
    conc_y_new <- rgamma(1, shape = postShape, rate = postRate)
    model[[target]] <<- conc_y_new
    model$calculate(target)
    nimCopy(from = model, to = mvSaved, row = 1, nodes = target, logProb = TRUE)
  }
  , methods = list(
    reset = function() { }
  )
)

