  for (i in 1:3) {
    tmpX[i]  <- X.mod[H[i]]
    Xs[i] <- tmpX[i]
  }
  X[1:3] ~ dmnorm(Xs[1:3], prec = q[1:3, 1:3])
  Y[1:3] ~ dmnorm(X[1:3], prec = R[1:3, 1:3])
})
any thoughts?
