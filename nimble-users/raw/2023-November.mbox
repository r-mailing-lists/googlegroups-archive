library(nimble)
library(dplyr)
library(readxl)
library(ggplot2)
library(basicMCMCplots)
set.seed(1)

## 10/5: implement penalized likelihood from Bacchetti 1993

dat <- read_excel("C:/Users/ashap/OneDrive/Desktop/Thesis/my countries notif data.xlsx") %>%
  filter(Country == "Philippines") %>%
  dplyr::select(-c(Country, Notes))

#====================================================================
# functions
#====================================================================
#Philippines:
k <- 6.06; r <- 1/.34 # shape; scale

f_vec <- nimbleFunction(
   run = function(x = double(0)){

     k <- 6.06 # shape
     r <- 1/.34 # scale = 1/rate

     tmp_vec <- rep(NA, x)

     for (i in 1:x) {
       tmp_vec[i] <- pgamma(x-(i-1), k, rate = r) - pgamma(x-i, k, rate = r)
     }

     return(tmp_vec)
     returnType(double(1))
})

# Cf_vec <- compileNimble(f_vec)

# code penalty as prior
dpen <- nimbleFunction(
  run = function(x = double(1),
                 theta = double(0), L = double(0),
                 log = integer(0, default = 0)) {
    returnType(double(0))
    logProb <- -(theta/2)*sum((log(x[1:(L-2)]) - 2*log(x[2:(L-1)]) + log(x[3:L]))^2)
    if(log) return(logProb)
    else return(exp(logProb))
  })

# registerDistributions(list(
#   dpen = list(
#     BUGSdist = "dpen(theta, L)",
#     Rdist = "dpen(theta, L)",
#     pqAvail = F
#   )))

#====================================================================
# set up MCMC1
#====================================================================
#
# # get parameters for lnorm
# m <- mean(dat$Notifications)
# s <- sd(dat$Notifications)
# location <- log(m^2 / sqrt(s^2 + m^2))
# shape <- sqrt(log(1 + (s^2 / m^2)))

modelCode <- nimbleCode({

  for (i in 1:L){
    #get mu
    mu[i] <- sum(f_vec(i)*lambda[1:i])

    #likelihood
    x[i] ~ dpois(mu[i])}

  lambda[1:L] ~ dpen(theta = theta, L = L)

  theta ~ dunif(1, 100)
  })

modelConsts <- list(L = nrow(dat))

modelData <- list(x = dat$Notifications)

initsList <- list(lambda = abs(rnorm(nrow(dat), mean(dat$Notifications), sd(dat$Notifications))),
                  theta = 10)

model <- nimbleModel(modelCode, data = modelData, inits = initsList, constants = modelConsts)

Cmodel <- compileNimble(model)

