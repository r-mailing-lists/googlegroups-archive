> > >       K <- nimDim(y.L.true)[3]
> > >       #precalculate log likelihoods. Can pull from nimble, but structure depends on nimble model structure (vectorized or not)
> > >       ll.y.L <- array(0,dim=c(M,J,K))
> > >       for(i in 1:M){
> > >         if(z[i]==1){
> > >           for(j in 1:J){
> > >             for(k in 1:K){
