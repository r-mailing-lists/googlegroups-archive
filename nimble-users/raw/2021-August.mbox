> > >               }else if(K2D[j,k]==2){
> > >                 ll.y.L[i,j,k]=dbinom(y.L.true[i,j,k],prob=2*pd.L[i,j]-pd.L[i,j]^2,size=1,log=TRUE)
> > >               }
> > >             }
> > >           }
> > >         }
> > >       }
> > >       ll.y.L.cand <- ll.y.L
> > >       for(l in (n.fixed+1):n.L){
> > >         y.L.true.cand <- y.L.true
