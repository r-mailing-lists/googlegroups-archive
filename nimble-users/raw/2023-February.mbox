>   month.final.day <- traj.monthly[!duplicated(traj.monthly$month.abs,fromLast = TRUE),]
>   month.days.mapper <- month.final.day %>% dplyr::select(month.abs, days.in.month,time)
>   monthly.cases <- rpois(n = nrow(month.final.day),lambda = month.final.day$NI) #Assuming case ascertainment rate = 30%
