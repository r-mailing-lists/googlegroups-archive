  setup = function(i=double(0),x5=double(1),x6=double(1),x7=double(1),x8=double(1),x9=double(1),x10=double(1),x11=double(1),x12=double(1)){
    expr_beta <- c()

    if(x5[i]!=0){
      expr_beta <- c(expr_beta,5)
    }
    if(x6[i]!=0){
