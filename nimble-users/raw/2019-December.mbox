Great, thanks Chris.

I've given it a go, but I think I'm missing something again. I can't find any similar examples to check against, but with the below model the MCMC is not doing a good job of estimating the process and observation errors.
The other two parameters are estimated reasonably well.
I'm not sure what I've done wrong that means I can't recover these top level parameters.

```
require(nimble)

# Building a simple linear state-space model.
# x is latent space, y is observed data
timeModelCode <- nimbleCode({
  x[1] <- x_0
  y[1] ~ dnorm(x[1], 0.3)

  for(i in 2:t){
    x[i] ~ dnorm(x[i-1] + c, pro_error)
    y[i] ~ dnorm(x[i], obs_error)
  }

  x_0 ~ dnorm(0, 1)
  obs_error ~ dunif(0, 10)
  pro_error ~ dunif(0, 10)
  c ~ dnorm(1,1)

})

# simulate some data

set.seed(125)
t <- 50
x_0 <- 0.5
pro_error <- 0.1
obs_error <- 0.3
x <- x_0

y <- rnorm(1, x, obs_error)

c <- 0.7;
for(i in 2:t){
  x[i] <- x[i-1] + c

  y[i] <- rnorm(1, x[i], obs_error)
}

# y[10:30] = NA # missing values testing, not used

plot(x, type="l")
points(y, col="red")

# build the model
rTimeModel <- nimbleModel(timeModelCode, constants = list(t = t),
                          data <- list(y = y), check = FALSE )

rTimeModel$setInits(list(c = 1, x_0 = 1))

cTimeModel <- compileNimble(rTimeModel)

timeConf <- configureMCMC(rTimeModel)

# Add random walk PMCMC sampler with particle number optimization.

timeConf$addSampler(target = c("c", "x_0", "obs_error", "pro_error"), type = "RW_PF_block",
                    control <- list(propCov= diag(4), adaptScaleOnly = T,
                                    pfType = "bootstrap", pfControl = list(saveAll = T, smoothing = T),

                                    latents = "x", pfOptimizeNparticles = TRUE))

timeConf$addMonitors("x")

RtimeConf <- buildMCMC(timeConf)
CtimeConf <- compileNimble(RtimeConf, project=rTimeModel, resetFunctions=T)

CtimeConf$run(1000)

hist(as.matrix(CtimeConf$mvSamples, "obs_error"), breaks=100)
abline(v=obs_error, col="red"
hist(as.matrix(CtimeConf$mvSamples, "pro_error"), breaks=100)
abline(v=pro_error, col="red")
hist(as.matrix(CtimeConf$mvSamples, "c"), breaks=100)
abline(v=c, col="red")
hist(as.matrix(CtimeConf$mvSamples, "x_0"), breaks=100)
abline(v=x_0, col="red")
```

