Hi all,

I'm new to nimble and am trying to run a basic SCR model that has traps in two clusters, so am looping to account for the two grids. The nimble model won't compile - I'm getting errors due to indexing. The dbinom_vector function is especially unhappy. I'm not sure if it's the code or how I have the included the data. Any help is greatly appreciated. I've attached the data, the data wrangling and the model itself is below.

SCR_bern <- nimbleCode({
  sigma ~ dunif(0,1000) # uninformative prior
  psi ~ dbeta(1,1)
  lambda ~ dunif(0,20)

  for(g in 1:G){
    for(i in 1:M[g]){
      z[i,g] ~ dbern(psi)
      X[i,1,g]~dunif(0,20) # traps are centered and scaled, start at 0 and end <20 for both xlim and ylim
      X[i,2,g]~dunif(0,20)

      for(j in 1:J){
        d2[i,j,g]<- (X[i,1,g]-traps[j,1,g])^2 + (X[i,2,g]-traps[j,2,g])^2
        p[i,j,g]<- z[i,g]*(1-exp(-lambda*exp(-d2[i,j,g]/(2*sigma*sigma))))
        y[i,j,g] ~ dbinom_vector(size = 4, prob = p[i,j,g])
      }
    }

    N[g]<-sum(z[1:M,g])
    D[g]<-N[g]/area[g]
  }
}
)

