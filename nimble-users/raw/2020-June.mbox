Below is an minimal example that gives errors unless you uncomment the one line I commented. Although the error is not the same one I got when building the MCMC so maybe the error structure is different in that case?

rm(list=ls())
library(nimble)

test <- nimbleFunction(

  setup = function() {

    q <- matrix(nrow=2,ncol=2)
    #q[1,1:2] <- c(.9,.9)

  },

  run = function() {
    q[1,1:2] <<- c(.1,.9)
    q[2,1:2] <<- c(.9,.1)

    z <- q[1,1]+q[2,1]

    return(z)
    returnType(double(0))

  },

)

testing <- test()

ctesting <- compileNimble(testing)

ctesting$run()

