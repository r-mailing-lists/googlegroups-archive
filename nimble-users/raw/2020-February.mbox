  M <- 250
  J=nrow(data$X)
  K=10
  tf <- rep(K,J)
  gamma=list(c(0.5,0.5))
  gammaVec=gamma[[1]]
  inits.in <http://inits.in>=inits=list(psi=0.3,lam0=c(0.35,0.5),sigma=c(0.75,0.5),gamma=gamma)
  inits.tmp=init_conCatSMR_df(data,M = M,obstype="poisson",inits=inits.in <http://inits.in>,tf=tf)

  n.samp.latent=inits.tmp$n.samp.latent
  G.use.seen=!(inits.tmp$G.use==0)
  y.sight.latent=inits.tmp$y.sight.latent
  y.sight.latent=apply(y.sight.latent,1,function(x){which(x>0)})
  trapup=unique(y.sight.latent)

  # Supply inits to NIMBLE. Note, y.true initialized here
  Niminits <- list(z=inits.tmp$z, psi=.5, s=inits.tmp$s, sigma=c(0.35,0.5), lam0=c(0.75,0.5),
                   y.sight.true=inits.tmp$y.sight.true,
                   G.true=as.vector(inits.tmp$G.true),ID=inits.tmp$ID,
                   G.latent=as.vector(1*(inits.tmp$G.latent)),gammaVec=gammaVec)

  # Supply constants to NIMBLE
  # note: this assumes a rectangular state space
  xlim=c(min(X[,1]),max(X[,1]))+c(-buff,buff)
  ylim=c(min(X[,2]),max(X[,2]))+c(-buff,buff)
  constants<-list(K=K, J=J, M=M,n.samp.latent=n.samp.latent,ncat=ncat,
                  nlevels=nlevels,n.marked=n.marked)

  # Supply data to NIMBLE. Note, y.true is completely latent.
  Nimdata<-list(y.sight.true = array(NA, c(M,J)),
                G.true=rep(NA,M),K2D=inits.tmp$K2D,
                xlim=xlim, ylim=ylim,ID=rep(NA,n.samp.latent),X=as.matrix(X),
                G.latent=rep(NA,M))

  # set parameters to monitor
  parameters<-c('psi','lam0','sigma','N','n.cap','gammaVec')

  # mcmc controls
  nb=100
  ni=200+nb
  nc=1
  nt=1

  # Build the model, configure the mcmc, and compileConfigure
  start.time<-Sys.time()
  Rmodel <- nimbleModel(code=NimModel, constants=constants, data=Nimdata,check=FALSE,
                        inits=Niminits)
  conf <- configureMCMC(Rmodel,monitors=parameters, thin=nt, useConjugacy = TRUE)

  #### --- note: load custom samplers sourced at top of script  --- ####
  # replace with new sampler for y.sight.true and remove the sampler for y.sight.true.event
  # y.sight.true.event is jointly updated with y.sight.true
  conf$removeSampler("y.sight.true")
  conf$addSampler(target = paste0("y.sight.true[1:",M,",1:",J,"]"),
                  type = 'IDSampler',control = list(y.sight.latent=y.sight.latent,G.use=as.vector(inits.tmp$G.use),
                                                    G.use.seen=as.vector(G.use.seen),trapup=trapup,M=M,G.marked=as.numeric(inits.tmp$G.marked),
                                                    ncat=ncat,n.marked=n.marked,n.samp.latent=n.samp.latent,J=J,K2D=inits.tmp$K2D),
                  silent = TRUE)

  # replace with new sampler for G.true
  conf$removeSampler("G.true")
  conf$addSampler(target = paste0("G.true[1:","M]"),
                  type = 'GSampler',control = list(M=M,nlevels=nlevels,J=J,K2D=inits.tmp$K2D),
                  silent = TRUE)

