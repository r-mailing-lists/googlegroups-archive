ZICMPMCEM <- buildMCEM(model = ZICMPmodel2,latentNodes =  ZICMPmodel2$getNodeNames(latentOnly = TRUE),burnIn = 1000,mcmcControl = list(adaptInterval = 10), boxConstraints = box,buffer = 1e-6)
mles<-ZICMPMCEM$run(initM = 10000)

