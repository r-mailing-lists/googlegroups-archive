Inits = list(alpha = rnorm(1, log(1/(1+1/mean(SpData$occ))), 1),
             beta = rnorm(Const$k, 0, sd=0.1), sigma2=rep(1, ncol(mm)))

this_works <- lapply(1:2, DoAll,cod=MaxNetcode, dat=Data, cons=Const, init=Inits)

