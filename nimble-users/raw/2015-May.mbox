> X <- model.matrix(~ number*environment, data=b)
>
> # Convert covariates to level index value
> b$number <- as.integer(as.factor(b$number))
> b$environment <- as.integer(as.factor(b$environment))
> b$block <- as.integer(as.factor(b$block))
> b$extinct5after <- as.numeric(b$extinct5after)
>
> # Write the model
> beetleCode <- nimbleCode(
> {
>   for (i in 1:N)
>   {
>     logit(phi[i]) <- X[i,] %*% beta[] + RE[block[i]];
>     y[i] ~ dbern(p=phi[i]);
>   }
>   for (j in 1:n.coef)
>   {beta[j] ~ dnorm(0, sd=100)};
>   for (k in 1:n.block)
>   {RE[k] ~ dnorm(0, sd=RE_sigma)};
>   RE_sigma ~ dunif(0,100);
> } )
>
> # The constants
> beetleConsts <- list(N = nrow(b), block = b$block, X=X, n.coef=ncol(X), n.block=length(unique(b$block)))
> # The data
> beetleData <- list(y=b$extinct5after)
>
> # Initial values for beta coefficients and standard deviation of random effects distribution
> beetleInits <- list(beta = rep(0, ncol(X)),  RE_sigma=100)
>
> # Create the NIMBLE model
> beetles <- nimbleModel(code=beetleCode,
>                        name="beetles",
>                        constants=beetleConsts,
>                        data=beetleData,
>                        inits=beetleInits,
>                        dimensions=list(beta=ncol(X), X=c(nrow(X),ncol(X))))
>
> # Explore the model
