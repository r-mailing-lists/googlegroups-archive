Hi,
I run a Dirichlet likelihood model with CAR random effects. It has two problems. First, nimble will treat my response as missing data. Second when I add Car random effects, it has Error: Failed to create the shared library.How can I solve this problem.
Best
Guanyu
rm(list=ls())
require(nimble)
load('realdata.Rdata')
code <- nimbleCode({
    # data model
    for (i in 1:M){ # M is the number of locations
        Z[i,1:19] ~ ddirch(alpha = alpha[i,1:19]) # K is the number of category
      }
     for (i in 1:M)  {
       for (j in i:K){
        alpha[i,j] <-exp(X[i,1:p]%*%beta[1:p,j]+W[i,j])
       }
       }
      for (i in 1:p){
        for (j in 1:K){
          beta[i,j]~dnorm(0,10)
        }
      }
 for (i in 1:K){
   W[1:M,i]~dmnorm(mean=mean_w[1:M],cov=cov_w[i,1:M,1:M])
   cov_w[i,1:M,1:M]<-sigma2[i]*inverse(diag(1,M)-rho[i]*adj[1:M,1:M])
   sigma2[i]~dinvgamma(0.01,0.01)
   rho[i]~dunif(a,b)
 }

})

constants<-list(K=19,M=30,p=5,a=-0.3,b=0.19)
data<-list(Z=Z,X=X,adj=adj,mean_w=rep(0,30))
inits<-list(beta=matrix(0,5,19),sigma2=rep(1,19),rho=rep(0,19))
Model <- nimbleModel(code = code,  constants = constants,
                     data = data, inits =inits,check=FALSE)

Rmcmc <- buildMCMC(Model)
Cmodel<-compileNimble(Model)
Cmcmc <- compileNimble(Rmcmc, project = Model)

