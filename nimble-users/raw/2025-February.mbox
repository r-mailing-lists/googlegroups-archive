Also, this example that I tried a year ago, suggested by Perry de Valpine, still works as well:

foo <- nimbleFunction(
  run = function(x = double(1), mu = double(1), cov = double(2)) {
    chol_cov <- chol(cov)
    ans <- dmnorm_chol(x, mu, chol_cov, prec_param=FALSE)
    return(ans)
    returnType(double())
  }
)
Cfoo <- compileNimble(foo)
x <- rnorm(3, 1:3)
mu <- 1:3
cov <- diag(3)
Cfoo(x, mu, cov)

