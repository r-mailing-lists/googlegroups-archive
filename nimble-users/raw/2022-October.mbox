>     ######################################
>     # Chandler trick
>     ######################################
>     for(i in (n.ch <https://gcc02.safelinks.protection.outlook.com/?url=http%3A%2F%2Fn.ch%2F&data=05%...%40usgs.gov%7C8a27a4fe46da4ac10c8908daaf068a64%7C0693b5ba4b184d7b9341f32f400a5494%7C0%7C0%7C638014740046665327%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000%7C%7C%7C&sdata=HQGulZkeGFveSDR1Fd1NKkXCsv6b35XWMyAaNWzXFnQ%3D&reserved=0>+1):M) {                                        # Loop through psuedo individuals
>       pzo[i,1] <- 1 - (p[1] * z[i,1] * w[i])                      # probability of not being detected on first occasion
>     for (t in 2:n.occasions){
>       pzo[i,t] <- 1 - (p[t] * z[i,t] * w[i])                         # probability of not being detected on each other occasion
>     }
>       zeros[i] ~ dbern(1-prod(pzo[i,]))                         # probability of at being detected at least once (zeros = vector of 0's for each augmented individual)
