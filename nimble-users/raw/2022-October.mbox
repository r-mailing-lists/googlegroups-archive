Hi Perry,
thank you very much.
Indeed, it was the prior of eps.year and by correcting its dimension the warning disappeared.

I have another question on the same model, maybe less nimble-related.
I made two versions of the model, one simple and one with spatial autocorrelation. No problem at all with the simple model, however, with the one including a spatial effect, I can't get the right plot for the population trend.
I attach here an example: in the first case both number of occupied sites (blue dots) and the trend (black line with grey posteriors) are fine; in the second case, occupied sites are correct, but I the plot of the trend is clearly wrong:

Here is the script, consider that the first part is an update of the previos script. I attach an Rdata to make it possible to run the script just from the "PLOT" section:

library(nimble)

model <- nimbleCode({

  # Prior for the variance of CAR model
  psi_tau ~ T(dnorm(0, sd = 10), 0, ) # Truncated normal distribution with mean 0 and SD = 10
  # Spatial effect - CAR model
  psi_rho[1:nsite] ~ dcar_normal(adj=adj[1:sumneigh],weights=weights[1:sumneigh],num=num_adj[1:nsite],tau=psi_tau, zero_mean = 1)

  # Model for occupancy
  for (k in 1:nyear){
    for (i in 1:nsite){
      logit(psi[i,k]) <- alpha + beta.trend*year[k] + eps.year[k] + psi_rho[i]
    }
    eps.year[k] ~ dnorm(0, tau.lpsi) # Year random effect
  }
  alpha <- logit(mean.psi)
  mean.psi ~ dunif(0,1)
  beta.trend ~ dnorm(0, 0.01)
  tau.lpsi <- pow(sd.lpsi, -2)
  sd.lpsi ~ dunif(0, 10)

  # Ecological submodel
  for (i in 1:nsite){
    for (k in 1:nyear){
      z[i,k] ~ dbern(psi[i,k])
    }
  }

  # Priors for observational model
  p_int   ~ dnorm(0, 0.01)
  # Observational model
  for (i in 1:nsite){
    for (k in 1:nyear){
      for (j in 1:Tf[i,k]){ # Apply only to Tf[i,k] to avoid estimation of NA surveys
        muy[i,j,k] <- z[i,k]*p[i,j,k]
        logit(p[i,j,k]) <- p_int
        y[i,j,k] ~ dbern(muy[i,j,k])
      }
    }
  }

  # Derived parameters
  for (k in 1:nyear){
    occ[k] <- sum(z[1:nsite,k]) # Occupancy in each year
  }

})

# Load data
load("dataset_occupancy.Rdata")

# Exclude NA in secondary periods
Tf <- matrix(1, nrow = dim(tab)[1], ncol = dim(tab)[3])
for (i in 1:nrow(Tf)){
  for(k in 1:ncol(Tf)){
    m <- max(which(is.na <http://is.na>(tab[i,,k]) == FALSE))

    if(m != "-Inf"){ Tf[i,k] <- m}
  }
}

# FORMATTING DATA
win.data <- list(y = tab)
constants  <- list(nsite = dim(tab)[1], nyear = dim(tab)[3],
                   year = years-mean(c(min(years),max(years))),
                   adj = adiacenti,num_adj = num_adiacenti, sumneigh = sumneigh, weights = rep(1,sumneigh))

## RUN THE MODEL
# Parameters to monitor
params <- c("alpha","beta.trend","eps.year","sd.lpsi","occ","psi.trend",
            "p_int", "psi_tau","psi_rho")

# inits
inits <-list(alpha = rnorm(1,0,1), beta.trend = rnorm(1,0,1),

             eps.year = rnorm(dim(tab)[3],0,1), sd.lpsi = dunif(1,0,10),

             p_int = rnorm(1,0,1),
             psi_tau=runif(1,1,10),psi_rho=runif(dim(tab)[1],-1,1))

# MCMC
nc <- 3

ni <- 6*10^4
nb <- ni*2/3
nt <- (ni-nb)/1000 # To have 1000 posteriors for each chain

# nimble model
Rmodel <- nimbleModel(code=model, constants=constants, data=win.data, inits = inits)
Rmodel$initializeInfo()
# mcmc
conf <- configureMCMC(Rmodel, print = F)

conf$addMonitors(c("alpha","occ","psi_tau","psi_rho"))
Rmcmc <- buildMCMC(conf)

# Compile the model and MCMC algorithm
Cmodel <- compileNimble(Rmodel)
Cmcmc <- compileNimble(Rmcmc, project = Rmodel)

# RUN THE MODEL
start.time <- Sys.time()
out <- runMCMC(mcmc = Cmcmc, niter = ni, nburnin = nb, nchains = nc, thin = nt,
               samplesAsCodaMCMC = T,inits = inits)
Sys.time()-start.time

#####
# PLOT
#####
print(load("model20221011.Rdata"))
nsite <- dim(tab)[1]
ch <- as.data.frame(rbind(out$chain1, out$chain2, out$chain3))
occ <- ch[,grep("occ",names(ch))]

m <- c()
l <- c()
u <- c()
for(i in 1:ncol(occ)){
  m[i] <- quantile(occ[,i], c(0.5))
  l[i] <- quantile(occ[,i], c(0.025))
  u[i] <- quantile(occ[,i], c(0.975))
}

# Trend anno
l.out <- 200
original.var <- seq(min(years), max(years), length.out = l.out)
centered.var <- original.var-mean(c(min(years),max(years)))
# Predictions
# Mean trend
pred <- (plogis(c(mean(ch$alpha) + mean(ch$beta.trend)*centered.var)))*nsite
# For each posterior
nsamps <- nrow(ch)
post.pred <- matrix(NA, nrow = l.out, ncol = nsamps)
for (i in 1:nsamps){
  post.pred[,i] <- (plogis(c(ch$alpha[i]) + ch$beta.trend[i]*centered.var))*nsite
}

# Make the plot
x11(6,4)

plot(pred ~ original.var, ylim = c(0,dim(tab)[1]), type = "l", lwd = 0,
     xlab = "Year", ylab = "Occupied sites")

for (i in 1:nsamps){
  lines(original.var, post.pred[,i], col=rgb(200/255,200/255,200/255,0.1))
}
lines(pred ~ original.var, lwd = 1)

cl <- "dodgerblue"
points(m ~ years, pch = 19, col = cl)
segments(x0 = years, x1 = years, y0 = l, y1 = u, col = cl)

I think I am missing something when I make predictions, but I do not understand what, since both esp.year and psi_rho have a mean of zero.

All the best,
Mattia

