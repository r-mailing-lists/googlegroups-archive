        # Asymmetric interactions between all 3 species
        rhoPB[i, j] <- rhoP[i, j]
        rhoPT[i, j] <- rhoP[i, j]
        rhoBP[i, j] <- rhoB[i, j]
        rhoBT[i, j] <- rhoB[i, j]
        rhoTP[i, j] <- rhoT[i, j]
        rhoTB[i, j] <- rhoT[i, j]
        # Asymmetric interactions when all 3 species are present
        rhoPBT[i, j] <- rhoP[i, j]
        rhoBPT[i, j] <- rhoB[i, j]
        rhoTPB[i, j] <- rhoT[i, j]

      }
    }

