  zcat <- as.numeric(zcat)
  # Parameters monitored
  parameters <- c('betaP', 'betaB', 'betaT',
                  'alphaP', 'alphaB', 'alphaT', 'mean.psiP', 'mean.psiB', 'mean.psiT',
                  'mean.pP', 'mean.pB', 'mean.pT')

  Nimdata <- list(y = as.matrix(ycat))
  constants=list(psi_cov_P = psi_cov_P, psi_cov_B = psi_cov_B, psi_cov_T = psi_cov_T, psi_inxs_cov = psi_inxs_cov,
                 rho_cov = rho_cov, rho_inxs_cov = rho_inxs_cov, nsites = nsites,
                 nsurveys = nsurveys, nfirst_order_psi_P = ncol(psi_cov_P),nfirst_order_psi_B = ncol(psi_cov_B),
                 nfirst_order_psi_T = ncol(psi_cov_T),
                 nsecond_order_psi = ncol(psi_inxs_cov), nfirst_order_rho = dim(rho_cov)[3],
                 nsecond_order_rho = 1, ncat = ncat)

  Niminits=list(z=zcat,mean.psiP=0.25,mean.psiB=0.25,mean.psiT=0.25)
