        rdm[i, j, 4, 7] <- exp( rhoTP[i, j] ) #-----------------| OS = T
        rdm[i, j, 5, 7] <- 0 #----------------------------------| OS = PB
        rdm[i, j, 6, 7] <- 0 #----------------------------------| OS = BT
        rdm[i, j, 7, 7] <- exp( rhoPT[i, j] + rhoTP[i, j] ) #---| OS = PT
        rdm[i, j, 8, 7] <- 0 #----------------------------------| OS = PBT
