  # Build the model, configure the mcmc, and compile
  start.time<-Sys.time()
  Rmodel <- nimbleModel(code=NimModel, constants=constants, data=Nimdata,check=FALSE,
                        inits=Niminits)
  conf <- configureMCMC(Rmodel,monitors=parameters, thin=nt,useConjugacy = TRUE, enableWAIC=TRUE)

  #block these due to strong posterior correlation. These are largest offenders, can block more.
  conf$removeSampler(c("mean.pB","alphaB"))
  conf$addSampler(target = c("mean.pB","alphaB[2]"),
                  type = 'RW_block',control = list(adaptive=TRUE),silent = TRUE)
  conf$removeSampler(c("mean.pP","alphaP"))
  conf$addSampler(target = c("mean.pP","alphaP[2]"),
                  type = 'RW_block',control = list(adaptive=TRUE),silent = TRUE)
  conf$removeSampler(c("mean.pT","alphaT"))
  conf$addSampler(target = c("mean.pT","alphaT[2]"),
                  type = 'RW_block',control = list(adaptive=TRUE),silent = TRUE)

  # Build and compile
  Rmcmc <- buildMCMC(conf)
  # runMCMC(Rmcmc,niter=1) #this will run in R, used for better debugging
  Cmodel <- compileNimble(Rmodel)
  Cmcmc <- compileNimble(Rmcmc, project = Rmodel)

  # Run the model.
  start.time2<-Sys.time()
  Cmcmc$run(100000,reset=FALSE) #short run for demonstration. can keep running this line to get more sample
  end.time<-Sys.time()
  time1=end.time-start.time  # total time for compilation, replacing samplers, and fitting
  time2=end.time-start.time2 # post-com

  mvSamples = as.matrix(Cmcmc$mvSamples)
  WAIC = Cmcmc$getWAICdetails
  return(list(mvSamples, WAIC))
}

