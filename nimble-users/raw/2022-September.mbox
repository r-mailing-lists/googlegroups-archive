        rdm[i, j, 3, 3] <- exp( rhoB[i, j] ) #------------------| OS = B
        rdm[i, j, 4, 3] <- 0 #----------------------------------| OS = T
        rdm[i, j, 5, 3] <- 0 #----------------------------------| OS = PB
        rdm[i, j, 6, 3] <- 0 #----------------------------------| OS = BT
        rdm[i, j, 7, 3] <- 0 #----------------------------------| OS = PT
        rdm[i, j, 8, 3] <- 0 #----------------------------------| OS = PBT
        # True state = T
        rdm[i, j, 1, 4] <- 1 #----------------------------------| OS = U
        rdm[i, j, 2, 4] <- 0 #----------------------------------| OS = P
        rdm[i, j, 3, 4] <- 0 #----------------------------------| OS = B
        rdm[i, j, 4, 4] <- exp( rhoT[i, j] ) #------------------| OS = T
        rdm[i, j, 5, 4] <- 0 #----------------------------------| OS = PB
        rdm[i, j, 6, 4] <- 0 #----------------------------------| OS = BT
        rdm[i, j, 7, 4] <- 0 #----------------------------------| OS = PT
        rdm[i, j, 8, 4] <- 0 #----------------------------------| OS = PBT
        # True state = PB
        rdm[i, j, 1, 5] <- 1 #----------------------------------| OS = U
        rdm[i, j, 2, 5] <- exp( rhoPB[i, j] ) #-----------------| OS = P
        rdm[i, j, 3, 5] <- exp( rhoBP[i, j] ) #-----------------| OS = B
        rdm[i, j, 4, 5] <- 0 #----------------------------------| OS = T
        rdm[i, j, 5, 5] <- exp( rhoPB[i, j] + rhoBP[i, j]) #----| OS = PB
        rdm[i, j, 6, 5] <- 0 #----------------------------------| OS = BT
        rdm[i, j, 7, 5] <- 0 #----------------------------------| OS = PT
