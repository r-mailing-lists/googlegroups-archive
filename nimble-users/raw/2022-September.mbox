        rdm[i, j, 1, 1] <- 1 #----------------------------------| OS = U
        rdm[i, j, 2, 1] <- 0 #----------------------------------| OS = P
        rdm[i, j, 3, 1] <- 0 #----------------------------------| OS = B
        rdm[i, j, 4, 1] <- 0 #----------------------------------| OS = T
        rdm[i, j, 5, 1] <- 0 #----------------------------------| OS = PB
        rdm[i, j, 6, 1] <- 0 #----------------------------------| OS = BT
