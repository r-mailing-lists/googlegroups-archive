        rdm[i, j, 4, 2] <- 0 #----------------------------------| OS = T
        rdm[i, j, 5, 2] <- 0 #----------------------------------| OS = PB
        rdm[i, j, 6, 2] <- 0 #----------------------------------| OS = BT
