mcmc_age_as_known <- nimbleMCMC(
  code = hmm_age_as_known,
  constants = my_constants,
  data = my_data,
  inits = initial_values,
  monitors = parameters_to_save,
  niter = n_iter,
  nburnin = n_burnin,
  nchains = n_chains)

