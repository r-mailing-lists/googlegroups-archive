  phi4 = runif(1, 0, 1),
  phi5 = runif(1, 0, 1),
  phi6 = runif(1, 0, 1),
  phi7 = runif(1, 0, 1),
  p1 = runif(1, 0, 1),
  p2 = runif(1, 0, 1),
  p3 = runif(1, 0, 1),
  p4 = runif(1, 0, 1),
  p5 = runif(1, 0, 1),
  p6 = runif(1, 0, 1),
  p7 = runif(1, 0, 1),
  z = zinit)

parameters_to_save <- c(
  "pi1",
  "pi2",
  "pi3",
  "pi4",
  "pi5",
  "pi6",
  "phi1",
  "phi2",
  "phi3",
  "phi4",
  "phi5",
  "phi6",
  "phi7",
  "p1",
  "p2",
  "p3",
  "p4",
  "p5",
  "p6",
  "p7"
