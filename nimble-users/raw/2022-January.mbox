## ---------------------------------------------------------------------------------------------------------
my.data <- list(y= y + 1) #= y + 1

#'
#' Get data of first capture.
## ---------------------------------------------------------------------------------------------------------
get.first <- function(x) min(which(x != 0))
first <- apply(y, 1, get.first)

#'
#' Constants in a list.
## ---------------------------------------------------------------------------------------------------------
my.constants <- list(first = first,
                     K = ncol(y),
                     N = nrow(y))

#'
#' Initial values
## ---------------------------------------------------------------------------------------------------------
zinits <- y
zinits[zinits == 0] <- sample(c(1,2,3), sum(zinits == 0), replace = TRUE)
initial.values <- function(){list(phiJ = runif(1, 0, 1),
                                  phiP = runif(1, 0, 1),
                                  phiA = runif(1, 0, 1),
                                  psiJP = runif(1, 0, 1),
                                  psiPA = runif(1, 0, 1),
                                  pJ = runif(1, 0, 1),
                                  pP = runif(1, 0, 1),
                                  pA = runif(1, 0, 1),
