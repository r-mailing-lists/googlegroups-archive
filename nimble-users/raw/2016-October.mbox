Your welcome :0)

How about the following for the round problem. "as.integer" and "sign" were both problematic.

roundNim <- nimbleFunction(
  run = function(x = double(0) ){
      returnType(double(0))
      absx <- abs(x)
      low  <- floor(absx)   ## as.integer(absx)
      high <- ceiling(absx) ## as.integer(absx + 1)

      if ( (absx-low) < 0.50 ){

          out <- low * (-1)^(x < 0)
      } else {
          out <- high * (-1)^(x < 0)
      }
      return(out)
  }
)

c_roundNim <- compileNimble(roundNim)

c_roundNim(0.56)  ## 1
c_roundNim(0.46)  ## 0
c_roundNim(-0.56) ## -1
c_roundNim(-0.46) ## 0

c_roundNim(1.5)  ## 2
c_roundNim(0.5)  ## 1
c_roundNim(-0.5) ## -1
c_roundNim(-1.5) ## -2

