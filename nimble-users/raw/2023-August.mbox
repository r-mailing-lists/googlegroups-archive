> > > >       tibble::rownames_to_column("obs_state")
> > > >
> > > >     if (filter(obs_draw, V1 == 1)$obs_state == "PB") {
> > > >       y[i,t] <- 1
> > > >     }
> > > >     if (filter(obs_draw, V1 == 1)$obs_state == "SB") {
> > > >       y[i,t] <- 2
