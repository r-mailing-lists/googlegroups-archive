> > > >     }
> > > >     if (filter(obs_draw, V1 == 1)$obs_state == "NB") { # ND is for Non-Detected
> > > >       y[i,t] <- 4
> > > >     }
> > > >     if (filter(obs_draw, V1 == 1)$obs_state == "PSB") { # ND is for Non-Detected
