    px[1, 2] <- 1 - phi
    px[2, 1] <- 0
    px[2, 2] <- 1

    # Simulating data
    for (i in 1:N) {
      # Initial state

      for (j in f[i]:f[i]) {

        alive[i, j] <- 1
        mydata[i, j] ~ dcat(po[alive[i,j], 1:2])
      }

      for (j in (f[i]+1):nyears) {

        # State transition
        alive[i, j] ~ dcat(px[alive[i, j - 1], 1:2])

        # Observation process
        mydata[i, j] ~ dcat(po[alive[i, j], 1:2])
      }
    }
