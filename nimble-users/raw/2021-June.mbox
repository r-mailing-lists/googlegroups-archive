+   beta[s] ~ dnorm(0,.1)
+   }
+
+   prob.c[1:3] <- c(1/3, 1/3, 1/3)
+   for(i in 1:7){
+   scale[i] ~ dcat(prob.c[1:3])}
+
+   #likelihood
+     for(i in 1:nsite){
+     log.mu <http://log.mu>[i] <- beta0 +
+       indA[1]*beta[1]*covs[i,scale[1],1] +
+       indA[1]*indA[2]*beta[2]*(covs[i,scale[1],1]^2) +
+       indA[3]*beta[3]*covs[i,scale[2],2] +
