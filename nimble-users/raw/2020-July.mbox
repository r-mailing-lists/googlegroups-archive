> > > > > > > > > > >     a1[h] ~ ddexp(0.0,1.5)
> > > > > > > > > > >     a2[h] ~ ddexp(0.0,1.5)
> > > > > > > > > > >     a3[h] ~ ddexp(0.0,1.5)
> > > > > > > > > > >     a4[h] ~ ddexp(0.0,1.5)
