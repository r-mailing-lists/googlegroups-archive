> > > > > > > > >             for(t in 2:nyears)
> > > > > > > > >                 result[i, t] <- sum(z[neighID[i, 1:numN[i]], t-1]) / numN[i]
> > > > > > > > >       return(result)
> > > > > > > > >   })
> > > > > > > > >
