Dear team,

In the attached code, I would like to do the clustering for the coefficients (beta) using the stick-breaking

library(nimble)
library(rdist)
library(raster)
library(dplyr)
library(ggplot2)

netdist <- read.csv('country_distance.csv')

N <- 64
S <- 64

mybeta <- c(2,2,0, 4, 2)
set.seed(1)
x1 <- rnorm(64);
x2 <- rnorm(64);
x3 <- rnorm(64);
x4 <- rnorm(64);
x5 <- rnorm(64);
y  <- cbind(x1, x2, x3, x4, x5) %*% mybeta + rnorm(64)
y <-  matrix(y, nrow = length(y), ncol = length(y), byrow = FALSE)

library(nimble)

Code <- nimbleCode({
  for (i in 1:S){

    y[1:N, i] ~ dmnorm(mu_y[1:N, i], prec = tau_y0[1:N, 1:N, i])

    mu_y[1:N, i] <- b[i, 1] * x1[1:N] + b[i, 2] * x2[1:N] + b[i, 3] *

      x3[1:N] + b[i, 4] * x4[1:N] + b[i, 5] * x5[1:N]

    tau_y0[1:N, 1:N, i] <- diag(psi_y[i] * exp(-Dist[1:N, i]/lambda))

    psi_y[i] ~ dgamma(1, 1)

   b[i, 1:5] <- bm[latent[i], 1:5]
    latent[i] ~ dcat(zlatent[1:M])
  }

  lambda ~ dunif(0, D)

  for (k in 1:M) {

    bm[k,1]~dnorm(0,0.001)
    bm[k,2]~dnorm(0,0.001)
    bm[k,3]~dnorm(0,0.001)
    bm[k,4]~dnorm(0,0.001)
    bm[k,5]~dnorm(0,0.001)}

 }

  zlatent[1:M] <- stick_breaking(vlatent[1:(M - 1)])

  for (j in 1:(M - 1)) {
    vlatent[j] ~ dbeta(1, alpha)
  }

  alpha ~ dgamma(1, 1)

})

netdist <- read.csv('country_distance.csv')
my_points <- matrix(c(netdist$Longitude,    # Create longitude/latitude matrix
                      netdist$Latitude),ncol=2)

colnames(my_points) <- c("longitude", "latitude")

my_points

df <- my_points

# distance matrices

dist_mat <- pdist(df)
dist_1 <- pdist(df[, 1])
dist_2 <- pdist(df[, 2])

# product distance matrix
dist_prod <- product_metric(dist_1, dist_2)

Data <- list(y = y, x1 = x1, x2 = x2, x3 = x3, x4 = x4, x5 = x5,
                Dist = dist_prod )

Const <- list(S = S, M = 4, N = N, D = 50)

Inits <- list(psi_y = rep(1, Const$S), lambda = 10,alpha=1,
                 latent = sample(1:4, size = Const$S, replace = TRUE), tau_bm = 1,  mu_bm = rnorm(5), phi = 1,
                 vlatent = rbeta(Const$M - 1, 1, 1),bm=matrix(rnorm(320),nrow = 64,ncol = 5))

mcmc.out <- nimbleMCMC(code = Code, data = Data, constants = Const,
                       inits = nits, thin = 10, niter = 5000, nchains = 1, nburnin = 2000,
                       monitors = c("latent", "lambda",'b','bm'), setSeed = TRUE)

I noticed that the draws for beta in the mcmc.out do not change and are the same for all betas.

Could you please advise in this regard?

Thanks

