  beta1 ~ dnorm(0, 1/100)
  # keep phi safely away from 1; allow under/over-dispersion
  phi ~ dunif(-0.9, 0.95)
})

constants <- list(N = N, x = x)
data      <- list(y = y)
inits     <- list(beta0 = 0, beta1 = 0, phi = 0)

