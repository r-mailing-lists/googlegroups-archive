Hi all,

I've been going through the process of converting some old JAGS models I've been using over to nimble (using v 0.13.0 in R v. 4.1.0), and have been struggling with an alternative way I have been coding up a logistic regression model with a first order autoregressive term (e.g., sites sampled over time, and the value at time t depends on the value at t-1). I can successfully code up the model without issues when I provide the response variable as a matrix, however I used a lot of nested indexing in JAGS as a work around for dealing with ragged arrays because the amount of data I have varies substantially among groups (i.e., there is a lot of missing data I'd prefer to avoid estimating as it substantially increases run times). As such, I tried to input the response variable as a vector in a few different ways and created an indexing vector for the model to recognize data points that should be linked to one another.  Here is a small reproducible example of the two different ways I tried to work around it (as well as the one working example).

library(nimble)
library(MCMCvis)

# Step 1. Simulate the data.

# General bookkeeping
nsite <- 50
nyear <- 8
ncovar <- 3

# for covariates
X <- matrix(
  NA,
  ncol = ncovar,
  nrow = nsite
)

set.seed(333)
# Create covariates
X <- apply(X, 2, function(x) rnorm(nsite))

# first column should be 1's for intercept
X[,1] <- 1
# coefficients, +1 for intercept
betas <- rnorm(ncovar)

# first order auto-logistic term
theta <- 0.75

# response variable, give same dimensions as X
z <- matrix(NA, ncol = nyear, nrow = nsite)

# Do first year occupancy
psi <- plogis(X %*% betas)
z[,1] <- rbinom(nsite, 1, psi)

# And then the rest, which also uses the theta term
for(year in 2:nyear){
  psi <- plogis(X %*% betas + theta * z[,year-1])
  z[,year] <- rbinom(nsite,1,psi)
}

working_model <- nimble::nimbleCode(
  {
    # for the first season, not using
    #  a first-order autoregressive term
    for(site in 1:nsite){
      logit(psi[site,1]) <- inprod(
        psi_beta[1:ncovar],
        X[site,1:ncovar]
      )
      z[site,1] ~ dbern(psi[site,1])
      for(year in 2:nyear){
        logit(psi[site,year]) <- inprod(
          psi_beta[1:ncovar],
          X[site,1:ncovar]
        ) + theta * z[site,year-1]
        z[site,year] ~ dbern(psi[site,year])
      }
    }
    #
    # Priors
    #
    # Intercept and slope terms
    for(covar in 1:ncovar){
      psi_beta[covar] ~ dlogis(0,1)
    }
    # First-order autoregressive term
    theta ~ dlogis(0,1)
  }

)

working_data_list <- list(
  z = z,
  X = X
)

working_constant_list <- list(
  nyear = nyear,
  nsite = nsite,
  ncovar = ncovar
)

working_output <- nimble::nimbleMCMC(
  code= working_model,
  constants = working_constant_list,
  data = working_data_list,
  monitors = c("psi_beta", "theta"),
  niter = 50000,
  nburnin = 30000,
  nchain = 2
)

working_summary <- MCMCvis::MCMCsummary(
  working_output,
  round = 2
)
# does an okay job with recovering parameters
cbind(
  truth = round(
    c(
      betas, theta
    ),
    2
  ),
  working_summary
)

# What I would like to do instead is fit the model
#  in long format, so treat z as a vector instead of a
#  matrix, and use nested indexing to determine
#  the correct site for theta to be linked to.

# convert to long format with nested indexing
#  this vector will provide the info on which site at t-1
#  is linked to the site at time t.
last_sample_vec <- rep(0, length(z))

# simple example, the first 50 don't depend on anything,
#  the rest are just lagged (e.g.., 51 is linked to 1,
#  61 is linked to 11, etc.)
last_sample_vec[(nsite+1):length(last_sample_vec)] <- 1:(nsite * (nyear-1))

# first attempt at the model, the way this is coded up
#  would work in JAGS.

failing_model_one <- nimbleCode(
 {
    # for the first season, not using
    #  a first-order autoregressive term
    for(samp1 in 1:nsample_one){
      logit(psi[samp1]) <- inprod(
        psi_beta[1:ncovar],
        X[site_vec[samp1],1:ncovar]
      )
      z[samp1] ~ dbern(psi[samp1])
    }
    # and the following years of sampling are the same
    # except the probability can change depending
    # on the state in the previous timestep at that
    # site.
    for(samp2 in 1:nsample_two){
      logit(psi[samp2]) <- inprod(
        psi_beta[1:ncovar],
        X[site_vec[samp2], 1:ncovar]
      ) + theta * z[last_sample_vec[samp2]]
      z[samp2] ~ dbern(psi[samp2])
    }
    #
    # Priors
    #
    # Intercept and slope terms
    for(covar in 1:ncovar){
      psi_beta[covar] ~ dlogis(0,1)
    }
    # First-order autoregressive term
    theta ~ dlogis(0,1)
}
)
# convert z to a numeric so that it is a vector instead of a
#  matrix.
failing_data_list_one <- list(
  z = as.numeric(z),
  X = X,
  last_sample_vec = last_sample_vec
)
failing_constant_list_one <- list(
  nsample_one = nsite,
  nsample_two = length(z),
  ncovar = ncovar,
  site_vec = rep(1:50, nyear)
)

# model that does not compile
failing_output_one <- nimbleMCMC(
  code = failing_model_one,
  constants = failing_constant_list_one,
  data = failing_data_list_one,
  dimensions = list(
    psi = failing_constant_list_one$nsample_two,
    z = failing_constant_list_one$nsample_two
  )
)

# The error:

# Error in permute.vertices(graph, oldGraphID_2_newGraphID) :
#   At topology.c:2725 : Permute vertices: invalid permutation vector size, Invalid value
# In addition: Warning message:
#   In topological.sort(graph, mode = "out") :
#   At structural_properties.c:3346 :graph contains a cycle, partial result is returned

# My second idea was to use a nimble function so that all
#  of the z values are fit within one loop. I created
#  this function here to return 0 if theta should
#  not be included in the linear predictor and to
#  possibly include it if the data point at t-1 = 1

theta_fnc <- nimbleFunction(
  # zvec = z vector
  # lsv = last_sample_vector
  # theta_val = theta
  run = function(
    zvec = double(1),
    lsv = double(0),
    theta_val = double(0)) {
    returnType(double(0))
    if(lsv == 0){
      result <- 0
    }
    if(lsv != 0){
      result <- theta_val * zvec[lsv]
    }
    return(result)
  })

ctheta_fnc <- compileNimble(theta_fnc)

# this model just does it all in one loop
failing_model_two <- nimbleCode(
  {
    #  a first-order autoregressive term
    for(samp in 1:nsample){
      logit(psi[samp]) <- inprod(
        psi_beta[1:ncovar],
        X[site_vec[samp],1:ncovar]
      ) + theta_fnc(
        zvec = z[1:nsample],
        lsv = last_sample_vec[samp],
        theta_val = theta
      )
      z[samp] ~ dbern(psi[samp])
    }
    #
    # Priors
    #
    # Intercept and slope terms
    for(covar in 1:ncovar){
      psi_beta[covar] ~ dlogis(0,1)
    }
    # First-order autoregressive term
    theta ~ dlogis(0,1)
  }
)

failing_data_list_two <- list(
  z = as.numeric(z),
  X = X,
  last_sample_vec = last_sample_vec
)
failing_constant_list_two <- list(
  nsample = length(z),
  ncovar = ncovar,
  site_vec = rep(1:50, nyear)
)

# model that does not compile
failing_output_two <- nimbleMCMC(
  code = failing_model_two,
  constants = failing_constant_list_two,
  data = failing_data_list_two,
  inits = list(
    z = rep(1, length(z)),
    psi_beta = rnorm(ncovar),
    theta = rnorm(1)
  )
)

# Provides the exact same error.
# Error in permute.vertices(graph, oldGraphID_2_newGraphID) :
#   At topology.c:2725 : Permute vertices: invalid permutation vector size, Invalid value
# In addition: Warning message:
#   In topological.sort(graph, mode = "out") :
#   At structural_properties.c:3346 :graph contains a cycle, partial result is returned

