t3 <- nimbleFunction(

  setup = function(model,target) {

    nnames <- model$expandNodeNames(target)
    numnodes <- length(nnames)

  },

  run = function() {

    prev <- model[[target]][numnodes]

  },

)
dq <- !main_model$isData("S")
test3  <- t3(model=main_model,target="S[dq]")
test3$run()

ct3 <- compileNimble(test3)

Gives error on compiling

Error in indices[[i]][[1]] : object of type 'symbol' is not subsettable

