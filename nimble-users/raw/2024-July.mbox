> >
> > library(nimble)
> >
> > code <- nimbleCode({
> >     a ~ dunif(0, 10)
> >     b ~ dunif(0, 10)
> >     x ~ dbeta(a, b)
> >     xdens <- logdens.beta(x, a, b)
> >     y ~ dgamma(a, b)
> >     ydens <- logdens.gamma(y, a, b)
> > })
> >
> > constants <- list()
> > data <- list(x = 0.3, y = 0.5)
> > inits <- list(a = 1, b = 1)
> >
> > logdens.beta <- nimbleFunction(
> >     run = function(x = double(), a = double(), b = double()) {
> >         lp <- dbeta(x, a, b, log = TRUE)
