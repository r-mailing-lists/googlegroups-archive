Hi Perry,

Quick follow up question about the sampler function in NIMBLE.  I have a custom written sampler working fine in R, and it compiles in C++ without any errors.  However, when I run the C++ version all the saved target values and latent states returned are NaN.   I know with R the idea is you can use browser() and run pieces of the code to do debugging.  However, with the C++ I'm not sure how to fully diagnose the issue--especially since the compiling works fine.   I was wondering if you have any suggestions about how to go about diagnosing this incongruity between the two versions.  I am attaching the sampler code below if that is helpful.  Any suggestions would be much appreciated.

Thanks,

Colin

  sampler_Kalman <- nimbleFunction(
  contains = sampler_BASE,
  setup = function(model, mvSaved, target, control) {

    ## numeric value generation
    nodes <- model$expandNodeNames('x')
    T <- length(nodes)

    a1 <- model$getParam('sigmaSquaredInvv', 'shape')
    a2 <- model$getParam('sigmaSquaredInvw', 'shape')
    b1 <- model$getParam('sigmaSquaredInvv', 'rate')
    b2 <- model$getParam('sigmaSquaredInvw', 'rate')

    sh1 <- a1 + T/2      #Posterior V shape, fixed bc conjugacy
    sh2 <- a2 + (T*2)/2   #Posterior W shape, fixed bc conjugacy

    ## functions for kalman, ffbs, sse
    filt <- KalmanStep(model,'x')
    level <- FFBStep(model,filt$mvKF,'x')
    y_sse <- see_y(model,level$mvTheta)
    theta_sse <- see_st(model,level$mvTheta)

    #Stored States
    mvThetaS <- level$mvTheta

    #get Dependencies
    paramDependencies <- model$getDependencies(target)
  },
  run = function() {
    psis <- numeric(2) #store psi terms

    filt$run()
    level$run()

    #draw observation for precision 1, V

    rate1 <- b1 + y_sse$run()/2
    psis[1] <- rgamma(1, sh1, rate = rate1[1,1])

    #draw observation for precision 2, W

    rate2 <- b2 + theta_sse$run()/2
    psis[2] <- rgamma(1, sh2, rate = rate2[1,1])

    #Update model states variance terms
    values(model, target) <<- psis

    #Update Latent States in Model

    nimCopy(from=mvThetaS,to=model,nodes='theta[1:2,2:366]', nodesTo='x[1:2,1:365]',row=1)

    model$calculate(paramDependencies)
    model$calculate(nodes)

  },
  methods = list(
    reset = function () {}
  )
)

