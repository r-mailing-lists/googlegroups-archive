> > >   tau.w=1, W=rep(1, nsite),                                             # spatial random effects (1)
> > >   num=c(1,1,4,4,4,4,4,NA,4,NA,4,4,4,4))                        # spatial random effects (2)
> > >
> > > params <- c("phi", "mlambda", "mp",
