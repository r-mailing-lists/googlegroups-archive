round(as.numeric(apply(samplesRJ[,c("z.temp[1]","z.temp[2]","z.temp[3]","z.temp[4]","z.temp[5]","z.temp[6]","z.temp[7]","z.temp[8]","z.temp[9]","z.temp[10]")], 2, function(x) sum(x)/length(x))),3)
g = samplesRJ[,c("z[1]","z[2]","z[3]","z[4]","z[5]")]
