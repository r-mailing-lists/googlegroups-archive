> > >
> > > conjugacyRelationshipsInputList <- list(
> > >     ## dtruncbeta
> > >     list(prior = 'dtruncbeta',
> > >          link = 'identity',
> > >          dependents = list(
> > >              dbinom = list(param = 'prob', contribution_shape1 = 'value', contribution_shape2 = '1 - value')),
> > >          posterior = 'dtruncbeta(shape1 = prior_shape1 + contribution_shape1,
