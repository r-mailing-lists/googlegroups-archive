Hi NIMBLE experts,

I am trying to fit a varying coefficient model, with the parameter for the variable "index" varying based on different effect modifiers, and the effect modifiers are smoothed using rw2. When I fit the model, it gives error:

[Warning] Dynamic index out of bounds: u[pm.ord[i]] + u[sm.ord[i]] + u[un.ord[i]]

Could you please kindly point out which part I messed up? Thank you so much!
Bill

Code:

merge.ga <http://merge.ga>$pm_cat <- cut(
  merge.ga <http://merge.ga>$pm2.5_z,
  breaks = seq(from = min(merge.ga <http://merge.ga>$pm2.5_z),
               to  = max(merge.ga <http://merge.ga>$pm2.5_z),
               length.out = 30),
  labels = 1:29,
  include.lowest = TRUE
)

merge.ga <http://merge.ga>$pm_cat_order <-
  as.numeric(droplevels(merge.ga <http://merge.ga>$pm_cat))

merge.ga <http://merge.ga> <- merge.ga <http://merge.ga>[order(merge.ga <http://merge.ga>$pm_cat_order),]

merge.ga <http://merge.ga>$sm_cat <- cut(
  merge.ga <http://merge.ga>$smoking_z,
  breaks = seq(from = min(merge.ga <http://merge.ga>$smoking_z),
               to  = max(merge.ga <http://merge.ga>$smoking_z),
               length.out = 30),
  labels = 1:29,
  include.lowest = TRUE
)

merge.ga <http://merge.ga>$sm_cat_order <-
  as.numeric(droplevels(merge.ga <http://merge.ga>$sm_cat))

merge.ga <http://merge.ga> <- merge.ga <http://merge.ga>[order(merge.ga <http://merge.ga>$sm_cat_order),]

merge.ga <http://merge.ga>$un_cat <- cut(
  merge.ga <http://merge.ga>$uninsured_z,
  breaks = seq(from = min(merge.ga <http://merge.ga>$uninsured_z),
                 to  = max(merge.ga <http://merge.ga>$uninsured_z),
                 length.out = 30),
  labels = 1:29,
  include.lowest = TRUE
)

merge.ga <http://merge.ga>$un_cat_order <-
  as.numeric(droplevels(merge.ga <http://merge.ga>$un_cat))

merge.ga <http://merge.ga> <- merge.ga <http://merge.ga>[order(merge.ga <http://merge.ga>$un_cat_order),]

K <- max(merge.ga <http://merge.ga>$pm_cat_order)

rest.comp <- list()
for(i in 3:(K-2)){
  rest.comp[[i]] <- c(i-2, i-1, i+1, i+2)
}
rest.comp <- unlist(rest.comp)

adj = c(2, 3, 1, 3, 4,
        rest.comp,
        c(K-3, K-2, K, K-2, K-1)
)

num = c(2, 3, rep(4, times = c(K-4)), 3, 2)

weights = c(c(2, -1, 2, 4, -1),
            rep(c(-1, 4, 4, -1), times = c(K-4)),
            c(-1, 4, 2, -1, 2))

RW2_Code <- nimbleCode(
  {
    for (i in 1:N){

      O[i] ~ dpois(mu[i])                                # Poisson for observed counts
      log(mu[i]) <- log(expected[i])+alpha +beta[i]*index[i]

      beta[i]<-u[pm.ord[i]]+u[sm.ord[i]]+u[un.ord[i]]
    }

    u[1:K] ~ dcar_normal(adj = adj[1:L], weights  = weights[1:L], num = num[1:K],
                         tau = tau.u, c = 2, zero_mean = 1)

    # Priors:
    alpha ~ dflat()
    exp.alpha <- exp(alpha)

    tau.u ~ dgamma(1, 0.01)
    sigma2.u <- 1/tau.u

  }
)

