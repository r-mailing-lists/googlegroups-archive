Is there a cleaner way to make this run with a single line?

This is the example code:

nimbleCodeRegr <- nimbleCode({

  for(j in 1:S){
    for(k in 1:p){
      beta[k,j] ~ dnorm(0, 1)
    }
  }

  Xbeta[1:n, 1:S] <-
    (X[1:n,1:p] %*% beta[1:p,1:S,drop=F])[1:n,1:S]

  for(i in 1:n) {
    for(j in 1:S){

      y[i,j] ~ dnorm(Xbeta[i,j], sd = sigma)

    }
  }

})

n <- 100
p <- 1
S <- 10
X <- matrix(rnorm(n * p), n, p)

constants <- list(n = n,
                  p = p,
                  S = S,
                  X = X,
                  sigma = 1)

MCMCsamples <-
  nimbleModel(
    code = nimbleCodeRegr,
    constants = constants,
    inits = list(beta = matrix(0, p, S)))

