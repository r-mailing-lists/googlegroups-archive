  mean.S ~ dunif(5, 100)  # Prior shape Gamma distribution (distance) : in-search
  sd.S ~ dunif(0.01, 50)   # Prior scale Gamma distribution (distance) : in-search
  mean.NS ~ dunif(5, 100) # Prior shape Gamma distribution (distance) : in-transit
  sd.NS ~ dunif(0.01, 50)  # Prior scale Gamma distribution (distance) : in-transit
  para.speed[1,1] <- mean.S
  para.speed[1,2] <- sd.S
  para.speed[2,1] <- mean.NS
  para.speed[2,2] <- sd.NS

  # Initial state probability
  delta[1] <- 0 # Pr(in-search t = 1) = 0
  delta[2] <- 1 # Pr(in-transit t = 1) = 1

  # Transition matrix
  gamma[1,1] <- phi.S      # Pr(in-search t -> in-search t+1)
  gamma[1,2] <- 1 - phi.S  # Pr(in-search t -> in-transit t+1)

  gamma[2,1] <- 1 - phi.NS # Pr(in-transit t -> in-search t+1)

  gamma[2,2] <- phi.NS     # Pr(in-transit t -> in-transit t+1)

  # Likelihood
  ## Iteration over individuals
  for (i in 1:N) {

    z[i, first[i]] ~ dcat(delta[1:2]) # t = 1
    y[i, first[i]] ~ dgamma(mean = para.speed[z[i,first[i]], 1],
                             sd = para.speed[z[i,first[i]], 2])

    ## Iteration over time
    for (t in (first[i]+1):T) {

      z[i,t] ~ dcat(gamma[z[i,t-1], 1:2])

      y[i,t] ~ dgamma(mean = para.speed[z[i,t], 1],
                      sd = para.speed[z[i,t], 2])

    } # t
  } # i

})

