c(0.000000000000000000,  0.000000000000000000,  0.0000000000000000000,  0.0000000000000000000, -0.011669144453871133)
)

eigen(t(k.good))
nimEigen(t(k.good))

#Now compare eigen and nimEigen on a "bad" rate matrix. nimEigen reports complex eigenvalues and poops out
