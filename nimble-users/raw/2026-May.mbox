  list(
    beta0 = 0,
    beta1 = 0,
    gamma0 = 0,
    gamma1 = 0,
    phi = 40,

    alphaDP = 0.5,

    v = c(rbeta(K - 1, 1, 2), 1),

    sigma_b = runif(K, 0.05, 0.5),
    sigma_m = runif(K, 0.05, 0.5),
    rho = runif(K, -0.3, 0.3),

    cl = sample(1:K, A, replace = TRUE),

    b_raw = rnorm(A, 0, 0.1),
    m_raw = rnorm(A, 0, 0.1)
  )
}

