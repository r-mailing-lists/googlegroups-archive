I found something that works for me here <https://groups.google.com/forum/#!topic/nimble-users/dkP_epCA2cY>. But I'd still be interested to know if there's a better way.

For reference:

### this belongs in ragged.R ###
library(nimble)

### Nimble Model Code ###
model.code = nimbleCode({
  for (i in 1:I) {
    for (j in 1:J[i]) {
      y[idxOffset[i] + j] ~ dnorm(mu[i], 1)
    }
    mu[i] ~ dnorm(m, var=s2)
  }
})

### Data ###
J = c(30, 15)
mu_true = c(-3, 5)
y_orig = list(rnorm(J[1], mu_true[1]), rnorm(J[2], mu_true[2]))
I = length(y_orig)
y = Reduce(c, y_orig)
hist(y)

### Model data, constants, and inits ###
model.data = list(y=y)
model.consts = list(m=0, s2=100, idxOffset=c(0, cumsum(J[-I])), I=I, J=J)
model.inits = list(mu=rep(0, I))

### Model ###
model = nimbleModel(model.code, data=model.data, constants=model.consts, inits=model.inits)

