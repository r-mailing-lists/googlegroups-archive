    t4 = 1:(abs(b-mu3)+1)

    t1final = abs(mu1-a)

    t2final = abs(mu2-mu1)

    t3final = abs(mu3-mu2)

    t4final = abs(b-mu3)+1

    n1 = numeric(t1final)

    n2 = numeric(t2final)

    n3 = numeric(t3final)

    n4 = numeric(t4final)

    for (i in 1:t1final) {n1[i] = (1+r1)^t1[i]}

    for (i in 1:t2final) {n2[i] = (n1[t1final])  * (1+r2)^t2[i]}

    for (i in 1:t3final) {n3[i] = (n2[t2final])  * (1+r3)^t3[i]}

    for (i in 1:t4final) {n4[i] = (n3[t3final])  * (1+r4)^t4[i]}

    pop = c(n1,n2,n3,n4)

    p = pop/sum(pop)

    logProb = dcat(a-x+1,prob=p,log=TRUE)

    if(log) {

      return(logProb)

    } else {

      return(exp(logProb))

    }

  })

rQuadrupleExponentialGrowth = nimbleFunction(

  run = function(n=integer(0),a=double(0),b=double(0),r1=double(0),r2=double(0),r3=double(0),r4=double(0),mu1=double(0),mu2=double(0),mu3=double(0)) {

    returnType(double(0))

    mu1 = round(mu1)

    mu2 = round(mu2)

