    n3 = numeric(t3final)

    n4 = numeric(t4final)

    for (i in 1:t1final) {n1[i] = (1+r1)^t1[i]}

    for (i in 1:t2final) {n2[i] = (n1[t1final])  * (1+r2)^t2[i]}

    for (i in 1:t3final) {n3[i] = (n2[t2final])  * (1+r3)^t3[i]}

    for (i in 1:t4final) {n4[i] = (n3[t3final])  * (1+r4)^t4[i]}

    pop = c(n1,n2,n3,n4)

    p = pop/sum(pop)

    res=a-rcat(n=1,prob=p)+1

    return(res)

  })

registerDistributions(list(

  dTripleExponentialGrowth = list(

    BUGSdist = "dTripleExponentialGrowth(a,b,r1,r2,r3,mu1,mu2)",

    Rdist = "dTripleExponentialGrowth(a,b,r1,r2,r3,mu1,mu2)",

    pqAvail = FALSE

  )))

registerDistributions(list(

  dQuadrupleExponentialGrowth = list(

    BUGSdist = "dQuadrupleExponentialGrowth(a,b,r1,r2,r3,r4,mu1,mu2,mu3)",

    Rdist = "dQuadrupleExponentialGrowth(a,b,r1,r2,r3,r4,mu1,mu2,mu3)",

    pqAvail = FALSE

  )))

## Generate Simulated Data ####

