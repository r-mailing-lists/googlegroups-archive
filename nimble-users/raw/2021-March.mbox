## MCMC for dTripleExponentialGrowth (this works) ####

model3 <- nimbleCode({

  for (i in 1:N){

    X[i] ~ dTripleExponentialGrowth(a=a,b=b,r1=r1,r2=r2,r3=r3,mu1=chp1,mu2=chp2);

  }

  r1 ~ dnorm(0,0.004);

  r2 ~ dnorm(0,0.004);

  r3 ~ dnorm(0,0.004);

  alpha ~ dgamma(1, 1)

  for (j in 1:2) {v[j] ~ dbeta(1,alpha);}

  mu[1:3] <- stick_breaking(v[1:2]);

  for (k in 1:2)

  {

    chp[k] <- round(sum(mu[1:k]) * (b-a) + a);

  }

  chp1 <- chp[1];

  chp2 <- chp[2]

})

constants3 <- list(N=N,a=7000,b=3000)

data3 <- list(X=calendar.dates_c3)

init3 <- list(r1=0.002,r2=-0.001,r3=0.0005,v=c(0.2,0.2),alpha=0.6,chp1=5000,chp2=4000)

mcmc.samples3b<- nimbleMCMC(code = model3,constants = constants3,data = data3,niter = 5000, nchains = 1, thin=1, nburnin = 1000, progressBar = TRUE, monitors=c('r1','r2','r3','chp1','chp2'), inits=init3, samplesAsCodaMCMC=TRUE)

