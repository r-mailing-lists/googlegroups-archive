  alpha ~ dgamma(1, 1)

  for (j in 1:3) {v[j] ~ dbeta(1,alpha);}

  mu[1:4] <- stick_breaking(v[1:3]);

  for (k in 1:3)

  {

    chp[k] <- round(sum(mu[1:k]) * (b-a) + a);

