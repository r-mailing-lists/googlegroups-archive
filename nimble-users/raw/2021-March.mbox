    t4 = 1:(abs(b-mu3)+1)

    t1final = abs(mu1-a)

    t2final = abs(mu2-mu1)

    t3final = abs(mu3-mu2)

    t4final = abs(b-mu3)+1

    n1 = numeric(t1final)

