Dear All,

I’m getting a ‘caught segfault -memory not mapped' error when using a custom distribution model and the stick_breaking() function in nimble. The models in the example below are a simplified version of what I am trying to achieve (I do realise there are better ways - e.g. using a Poisson model, but this cannot be done for a number of reasons). Both dTripleExponentialGrowth and dQuadrupleExponentialGrowth basically describe the probability of observing an event at a discrete time t given an exponential growth process where the growth rate has change points (2 and 3). My idea was to use the stick breaking algorithm as the prior of these changepoints. The example below runs perfectly fine with the two changepoint model (dTripleExponentialGrowth) and I am able to correctly estimate the true parameters of my model. However, when trying to fit the three changepoint model (dQuadrupleExponentialGrowth) I get the following error:

*** caught segfault ***

  address 0xfffffffffffffff8, cause 'memory not mapped'

Traceback:

  1: .Call("CALL_MCMC_run", niter, reset, resetMV, time, progressBar,     nburnin, thin, thin2, .basePtr)

2: mcmc$run(niter, nburnin = nburnin, thin = thinToUseVec[1], thin2 = thinToUseVec[2],     progressBar = progressBar)

3: runMCMC(Cmcmc, niter = niter, nburnin = nburnin, nchains = nchains,     inits = inits, setSeed = setSeed, progressBar = progressBar,     samples = samples, samplesAsCodaMCMC = samplesAsCodaMCMC,     summary = summary, WAIC = WAIC)

4: nimbleMCMC(code = model4, constants = constants4, data = data4,     niter = 20000, nchains = 1, thin = 1, nburnin = 5000, progressBar = TRUE,     monitors = c("r1", "r2", "r3", "r4", "chp1", "chp2", "chp3"),     inits = init4, samplesAsCodaMCMC = TRUE)

This doesn’t happen consistently all the time and occurs randomly at some point while the progress bar is progressing.  I assume this is a problem with my custom model, but the two versions are identical (indeed the plan was to write a generalised N-changepoint model) so I am not sure why one works and the other doesn't. Any help is greatly appreciated!

All Best,

Enrico

----

library(nimble)

## Custom Distributions ####

dTripleExponentialGrowth=nimbleFunction(

  run = function(x = integer(0),a=double(0),b=double(0),r1=double(0),r2=double(0),r3=double(0),mu1=double(0),mu2=double(0), log = integer(0)) {

    returnType(double(0))

    mu1 = round(mu1)

    mu2 = round(mu2)

    t1 = 1:(abs(mu1-a))

    t2 = 1:(abs(mu2-mu1))

    t3 = 1:(abs(b-mu2)+1)

    t1final = abs(mu1-a)

    t2final = abs(mu2-mu1)

    t3final = abs(b-mu2)+1

    n1 = numeric(t1final)

    n2 = numeric(t2final)

    n3 = numeric(t3final)

    for (i in 1:t1final) {n1[i] = (1+r1)^t1[i]}

    for (i in 1:t2final) {n2[i] = (n1[t1final])  * (1+r2)^t2[i]}

    for (i in 1:t3final) {n3[i] = (n2[t2final])  * (1+r3)^t3[i]}

    pop = c(n1,n2,n3)

    p = pop/sum(pop)

    logProb = dcat(a-x+1,prob=p,log=TRUE)

    if(log) {

      return(logProb)

    } else {

      return(exp(logProb))

    }

  })

rTripleExponentialGrowth = nimbleFunction(

  run = function(n=integer(0),a=double(0),b=double(0),r1=double(0),r2=double(0),r3=double(0),mu1=double(0),mu2=double(0)) {

    returnType(double(0))

    mu1 = round(mu1)

    mu2 = round(mu2)

    t1 = 1:(abs(mu1-a))

    t2 = 1:(abs(mu2-mu1))

    t3 = 1:(abs(b-mu2)+1)

    t1final = abs(mu1-a)

