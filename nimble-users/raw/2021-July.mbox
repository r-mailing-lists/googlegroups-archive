> beta1_shared ~ dnorm(0, sd = 1000) # uninformative
> beta2_shared ~ dnorm(0, sd = 1000) # ditto
> l1 ~ dbern(phi) # (I'm not sure how well informed phi will be by two cases.)
> l2 ~ dbern(phi)
> for(j in 1:R) {
>   beta1[j] ~ dnorm(0, sd = 2.5 )
>   beta2[j] ~ dnorm(0, sd = 2.5 )
> }
