                            mean.pNT=runif(1,0,1),
                            mean.pT=runif(1,0,1),
                            survT=runif(1,0,1),
                            gam=runif(10,0,1),
                            mean.rNT=runif(1,0,1),
                            mean.rT=runif(1,0,1),
                            z=z2)}

