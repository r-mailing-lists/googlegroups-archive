> z1 ~ dmulti(size=1,prob=rep(1/R,R))
> z2 ~ dmulti(size=1,prob=rep(1/R,R))
> z1i <- which(z1[1:R] == 1) # There was a minor bug discovered for compilation of "which" recently,
