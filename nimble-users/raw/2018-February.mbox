cat ('Start compiling model\n')

Cpump <- compileNimble(test)

testConf <- configureMCMC(test, print = FALSE)

testMCMC <- buildMCMC(testConf)

C_MCMC <- compileNimble(testMCMC, project = test)

C_MCMC$run(10000)

samples <- as.matrix(C_MCMC$mvSamples)

