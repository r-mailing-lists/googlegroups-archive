    a1[1:J] <- nimble_which(alpha1[1:J],
d[1:J], 1, .0001) # Small value on vars not in group

    a2[1:J] <- nimble_which(alpha2[1:J],
d[1:J], 2, .0001)

    a3[1:J] <- nimble_which(alpha3[1:J],
d[1:J], 3, .0001)

    for (j in 1:J){

        d[j] ~ dcat(pi[1:K])              # vector of K group membership for J variables

