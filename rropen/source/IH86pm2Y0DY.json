   "date": "2015-05-22T21:40:27Z",
   "subject": "Re: xcopy installation of R Open",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n<p><span>Hello Jiri,</span></p>\r\n<p><span>Due to the fact that R stores several application-specific settings in the Windows registry, we do not recommend that anyone copy the installation directory to a different location on Windows systems.</span></p>\r\n<p><span>Regards,</span></p>\r\n<p><span>Josée Martens</span></p></div>"
    ]
   ]
  },
