prime = function(k)
{
  pn=vector("numeric", length=k)
  pn[1]=2
  l=2
  i=3
  n=0
  while(l<=k) {
    sig=0
    for (j in seq(1,sqrt(i),2)) {
      n=n+1
      if (i %% j == 0) {
        sig=sig+1
        if (sig > 1) break
      }
    }
    if (sig == 1) {
      pn[l] = i
      l = l + 1
    }
    i = i + 2
  }
  return(pn)
}
system.time(prime(10000))

