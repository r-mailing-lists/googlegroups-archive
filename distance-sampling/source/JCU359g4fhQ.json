sit <a href=\"https://groups.google.com/d/msgid/distance-sampling/c88d6f24-9d80-4092-b289-c8375b3c5612n%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/distance-sampling/c88d6f24-9d80-4092-b289-c8375b3c5612n%2540googlegroups.com?utm_medium%3Demail%26utm_source%3Dfooter&amp;source=gmail&amp;ust=1792472308161000&amp;usg=AOvVaw3KIJoBeA0UJqWeRiccYM4d\">\r\nhttps://groups.google.com/d/msgid/distance-sampling/c88d6f24-9d80-4092-b289-c8375b3c5612n%40googlegroups.com</a>.<br>\r\n</div>\r\n</div>\r\n\r\n</blockquote></div>\r\n"
