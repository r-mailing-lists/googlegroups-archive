-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0cm 5.4pt;height:16.25pt\">\r\n  <p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><span style=\"font-size:9.0pt\">0<u></u><u></u></span></p>\r\n  </td>\r\n </tr>\r\n <tr style=\"height:16.25pt\">\r\n  <td width=\"93\" nowrap valign=\"top\" style=\"width:70.1pt;border-right:1pt solid windowtext;border-bottom:1pt solid windowtext;border-left:1pt solid windowtext;border-top-width:initial;border-top-style:none;padding:0cm 5.4pt;height:16.25pt\">\r\n  <p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><span style=\"font-size:9.0pt\">hr11_880_site  <u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"79\" nowrap valign=\"top\" style=\"width:59.4pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0cm 5.4pt;height:16.25pt\">\r\n  <p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><span style=\"font-size:9.0pt\">Hazard-rate <u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"172\" nowrap valign=\"top\" style=\"width:129.3pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0cm 5.4pt;height:16.25pt\">\r\n  <p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><span lang=\"EN-US\" style=\"font-size:9.0pt\">~size+as.factor(Region.Label)<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"80\" nowrap valign=\"top\" style=\"width:59.75pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right