     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div dir=\"ltr\" style=\"font-size:12pt;color:rgb(0,0,0);font-family:Calibri,Helvetica,sans-serif,&quot;EmojiFont&quot;,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,NotoColorEmoji,&quot;Segoe UI Symbol&quot;,&quot;Android Emoji&quot;,EmojiSymbols\">\r\n<p style=\"margin-top:0;margin-bottom:0\">Dear Distance Sampling Folk<br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">We have just released Distance for Windows version 7.2 and uploaded the associated updated R packages (mrds, dsm and DSsim) to CRAN.</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">Distance 7.2 can be downloaded from our website:\r\n<a href=\"http://distancesampling.org/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://distancesampling.org/&amp;source=gmail&amp;ust=1792474443734000&amp;usg=AOvVaw3oZ5SsZGclFJ5vkNYSTmRv\">\r\nhttp://distancesampling.org/</a><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">The main new features of Distance 7.2 include:</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">- Point transect mark recapture (double observer) analyses</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">- Point transect density surface modelling analyses</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">- % complete tracker for simulations as well as various bug fixes and improved warning and error message output.</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">Enjoy!</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<div>\r\n<div style=\"font-size:12pt;color:rgb(0,0,0);background-color:rgb(255,255,255);font-family:Calibri,Arial,Helvetica,sans-serif,&quot;EmojiFont&quot;,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,NotoColorEmoji,&quot;Segoe UI Symbol&quot;,&quot;Android Emoji&quot;,EmojiSymbols\">\r\n<p><br>\r\n</p>\r\n<p>Dr. L Marshall</p>\r\n<p>Centre for Research into Ecological &amp; Environmental Modelling</p>\r\n<p>University of St. Andrews</p>\r\n<p>Tel: 01334 461808<br>\r\n</p>\r\n<p><br>\r\n</p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n"
