     1,
     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\nDear Distance List,</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\nWe are pleased to announce the release of Distance 2.0.1 and mrds 3.0.1 on CRAN. These releases contain a number of bug fixes / enhancements, please see the package NEWS for details. We recommend downloading the recent versions from CRAN to enjoy the benefits\r\n of these enhancements</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:16px;color:black\">\r\n<span style=\"background-color:white\"><a href=\"https://cran.r-project.org/web/packages/Distance/news/news.html\" title=\"Original URL: https://cran.r-project.org/web/packages/Distance/news/news.html. Click or tap if you trust this link.\" rel=\"noopener noreferrer nofollow\" style=\"margin:0px;background-color:white;text-align:left\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://cran.r-project.org/web/packages/Distance/news/news.html&amp;source=gmail&amp;ust=1792471527113000&amp;usg=AOvVaw3x4QfSLon4nUDys7QawpmA\">https://cran.r-project.org/web/packages/Distance/news/news.html</a></span></div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\n<a href=\"https://cran.r-project.org/web/packages/mrds/news/news.html\" title=\"Original URL: https://cran.r-project.org/web/packages/mrds/news/news.html. Click or tap if you trust this link.\" rel=\"noopener noreferrer nofollow\" style=\"margin:0px\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://cran.r-project.org/web/packages/mrds/news/news.html&amp;source=gmail&amp;ust=1792471527113000&amp;usg=AOvVaw0VumxCbqksiUsf9fVoFRDQ\">https://cran.r-project.org/web/packages/mrds/news/news.html</a></div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\nPlease note that we have initiated a review of the <code>dht2</code> function in <i>\r\nDistance</i> and have resolved several identified issues. Further review of this function is planned, and we encourage users to report any concerns regarding its functionality.</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:black\">\r\nBest wishes,</div>\r\n<div style=\"background-color:rgb(255,255,255);margin:0px\">\r\n<div style=\"margin:0px\"></div>\r\n</div>\r\n<div>\r\n<div>\r\n<p style=\"direction:ltr;margin-top:0px;margin-bottom:0px\">\r\n<span style=\"font-family:Calibri,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0)\">Distance Development Team<br>\r\n</span></p>\r\n<p style=\"direction:ltr;margin-top:0px;margin-bottom:0px\">\r\n<span style=\"font-family:Calibri,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0)\">Centre for Research into Ecological &amp; Environmental Modelling</span></p>\r\n<p style=\"direction:ltr;margin-top:0px;margin-bottom:0px\">\r\n<span style=\"font-family:Calibri,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0)\">University of St. Andrews</span></p>\r\n<div style=\"direction:ltr;font-family:Calibri,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n"
