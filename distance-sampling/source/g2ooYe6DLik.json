     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div dir=\"ltr\" style=\"font-size:12pt;color:rgb(0,0,0);font-family:Calibri,Helvetica,sans-serif,&quot;EmojiFont&quot;,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,NotoColorEmoji,&quot;Segoe UI Symbol&quot;,&quot;Android Emoji&quot;,EmojiSymbols\">\r\n<p style=\"margin-top:0;margin-bottom:0\"></p>\r\n<div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">Dear Distance List,</span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\"><br>\r\n</span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">We plan on developing new software to aid distance sampling practitioners\r\n in survey design and we would like you to </span></font><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\"><b>help us make sure our software meets your needs</b></span></font><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">.</span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\"> </span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">Distance for Windows is currently the only software which provides practitioners\r\n with the tools to be able to design surveys and generate sets of randomised transects for carrying out distance sampling surveys. We now plan on making similar tools available in R, meaning it can be used on any platform. This software will allow you to define\r\n a survey design, e.g. equal spaced line transect design, assess the properties of the design as well as generate a set of transects for your survey.\r\n</span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\"> </span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">We would appreciate it if you could take the time to answer the short questionaire\r\n provided in the link below, to ensure that we can best meet your needs.</span></font></span></font></div>\r\n</div>\r\n<div style=\"margin-top:0;margin-bottom:0\"> </div>\r\n<div style=\"margin-top:0;margin-bottom:0\"><br>\r\n</div>\r\n<div style=\"margin-top:0;margin-bottom:0\"><a href=\"https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV\" rel=\"noopener noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV&amp;source=gmail&amp;ust=1792474386059000&amp;usg=AOvVaw151Fc1CKUcWksL895wVa3Z\"><font size=\"3\" color=\"black\"><span style=\"font-size:12pt\">https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV</span></font></a><br>\r\n</div>\r\n<div style=\"margin-top:0;margin-bottom:0\"><br>\r\n</div>\r\n<div>\r\n<div style=\"background-color:white\"><font size=\"3\" face=\"Calibri,Arial,Helvetica,sans-serif,EmojiFont,Apple Color Emoji,Segoe UI Emoji,NotoColorEmoji,Segoe UI Symbol,Android Emoji,EmojiSymbols\" color=\"black\"><span style=\"font-size:12pt;background-color:white\">\r\n<div style=\"margin-top:0;margin-bottom:0\"> </div>\r\n<div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">Kind Regards,</span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\"> </span></font></span></font></div>\r\n<div style=\"margin:0\"><font size=\"3\" face=\"Calibri,sans-serif\"><span style=\"font-size:12pt\"><font size=\"3\" face=\"Helvetica Neue,sans-serif\" color=\"black\"><span style=\"font-size:12pt\">Distance Development Team</span></font></span></font></div>\r\n</div>\r\n</span></font></div>\r\n</div>\r\n<br>\r\n<p></p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<div>\r\n<div style=\"font-size:12pt;color:rgb(0,0,0);background-color:rgb(255,255,255);font-family:Calibri,Arial,Helvetica,sans-serif,&quot;EmojiFont&quot;,&quot;Apple Color Emoji&quot;,&quot;Segoe UI Emoji&quot;,NotoColorEmoji,&quot;Segoe UI Symbol&quot;,&quot;Android Emoji&quot;,EmojiSymbols\">\r\n<p>Dr. L Marshall</p>\r\n<p>Centre for Research into Ecological &amp; Environmental Modelling</p>\r\n<p>University of St. Andrews</p>\r\n<p>Tel: 01334 461808<br>\r\n</p>\r\n<p><br>\r\n</p>\r\n</div>\r\n</div>\r\n</div>\r\n</div>\r\n\r\n"
