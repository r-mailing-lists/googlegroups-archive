     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div bgcolor=\"#FFFFFF\" text=\"#000000\"><blockquote type=\"cite\"><div><div><blockquote type=\"cite\">\r\n        To unsubscribe from this group and stop receiving emails from\r\n        it, send an email to <a href data-email-masked rel=\"nofollow\">distance-sampling+unsubscribe@googlegroups.com</a>.<br>\r\n        To post to this group, send email to <a href data-email-masked rel=\"nofollow\">distance-sampling@googlegroups.com</a>.</blockquote></div></div></blockquote></div></blockquote></div></div>"
