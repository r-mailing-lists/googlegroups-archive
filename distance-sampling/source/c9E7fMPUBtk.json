     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div style=\"font-size:12pt;color:#000000;font-family:Calibri,Helvetica,sans-serif\" dir=\"ltr\">\r\n<p style=\"margin-top:0;margin-bottom:0\">Dear Distance List,</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">Many thanks for all your responses and feedback so far to our distance sampling survey design questionnaire. This has given us valuable information regarding the planning of a survey design package in R.</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">We will be taking the questionnaire offline this Friday 2nd November, so if anyone still wishes to provide us with feedback please follow the link below.</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><a href=\"https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV&amp;source=gmail&amp;ust=1792474338912000&amp;usg=AOvVaw0FWZA2LQqWEuTrGO14yy9g\">https://standrews.eu.qualtrics.com/jfe/form/SV_8A30qTNjVWNU5QV</a><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">Kind Regards,</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\">Laura</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"></p>\r\n<p>Dr. L Marshall</p>\r\n<p>Centre for Research into Ecological &amp; Environmental Modelling</p>\r\n<p>University of St. Andrews</p>\r\n<br>\r\n<p></p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n<p style=\"margin-top:0;margin-bottom:0\"><br>\r\n</p>\r\n</div>\r\n</div>\r\n\r\n"
