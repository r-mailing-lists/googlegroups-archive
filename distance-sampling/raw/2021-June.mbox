> > > > > > conversion <- convert_units("meter", "meter", "square kilometer")
> > > > > > lem_year$Region.Label <- lem_year$year
> > > > > > DS_lemR<- ds(data = lem_year,
> > > > > >              key="hn",
> > > > > >              formula=~Region.Label,
> > > > > >              convert.units = conversion)
