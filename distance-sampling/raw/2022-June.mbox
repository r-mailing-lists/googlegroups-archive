Hi Richard,

I think you are looking to do something like this?
I'll use the dsm example code in the R help as a demo

library(Distance)
library(dsm)

# load the Gulf of Mexico dolphin data
data(mexdolphins)

# fit a detection function and look at the summary
hr.model <- ds(distdata, truncation=6000,
               key = "hr", adjustment = NULL)

# fit a simple smooth of x and y to counts
mod1 <- dsm(count~s(x,y), hr.model, segdata, obsdata)

# predict over a grid
mod1.pred <- predict(mod1, preddata, preddata$area)

# Make an XYM sf points object and writes it to shapefile
library(sf)
p_data <- data.frame(X = preddata$x, Y = preddata$y, M = mod1.pred)
points <- st_as_sf(p_data, coords = c("X", "Y", "M"), dim = "XYM")
st_write(points, dsn = "predictions.shp")

Best wishes,
Laura

