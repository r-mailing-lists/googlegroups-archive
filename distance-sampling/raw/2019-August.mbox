  dplyr::select(PairID, SURVEY,distance, Group1, Group3, VEG, size) %>%
  filter(distance<=450)

bufvars$eswt<-as.data.frame(predict(buf.df, newdata=bufvars, compute=F, int.range=NULL, esw=T))

bufvars$eswf<-as.data.frame(predict(buf.df, newdata=bufvars, compute=F, int.range=NULL, esw=F))

