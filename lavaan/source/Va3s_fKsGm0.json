span style=\"color:#000\"> runMI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myModelSEM</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">=</span><span style=\"color:#000\">dataMI$imputations</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> fun</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;sem&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">ordered</span><span style=\"color:#660\">=</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bi1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bi2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bi3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bi4&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;bi5&quot;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Error</span><span style=\"color:#000\"> </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#080\">`[&lt;-`</span><span style=\"color:#660\">(</span><span style=\"color:#080\">`*tmp*`</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> lhs</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> rhs</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> value </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">-</span><span style=\"color:#066\">0.0087718452194632</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">:</span><span style=\"color:#000\"> <br>  subscript </span><span style=\"color:#