     2,
     "<div dir=\"ltr\"><div><br></div><div><br></div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#800\">#Checking variance</span><span style=\"color:#000\"><br>a</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">unclass</span><span style=\"color:#660\">(</span><span style=\"color:#000\">ess$eisced</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>a</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#008\">as</span><span style=\"color:#660\">.</span><span style=\"color:#000\">numeric</span><span style=\"color:#660\">(</span><span style=\"color:#000\">a</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">var</span><span style=\"color:#660\">(</span><span style=\"color:#000\">a</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>#[1] NA<br></span><span style=\"color:#800\">var(as.numeric(ess$eisced))<br></span><code><span style=\"color:#000\">#[1] NA</span></code><span style=\"color:#000\"></span><br><span style=\"color:#000\"><code></code></span><span style=\"color:#008\">var</span><span style=\"color:#660\">(</span><span style=\"color:#000\">married</span><span style=\"color:#660\">)<br></span><code><span style=\"color:#000\">#[1] NA<br>var(cntryNL)<br>#[1] 0.1701832</span></code></div></code></div></div></blockquote><div><br></div></div>"
