   "parts": [
    [
     1,
     "<div dir=\"ltr\">This is not a lavaan issue, so a more general forum like SEMNET or Stack Overflow would be a better place to post a general statistical question like this.  But you can also start by reading about what (semi)partial correlations are, and how their interpretation differs from zero-order correlations.<div><br></div><div><div style=\"font-family:sans-serif\"><div style=\"font-family:Arial,Helvetica,sans-serif\">Terrence D. Jorgensen</div><div style=\"font-family:Arial,Helvetica,sans-serif\">Postdoctoral Researcher, Methods and Statistics</div><div style=\"font-family:Arial,Helvetica,sans-serif\">Research Institute for Child Development and Education, the University of Amsterdam</div><div style=\"font-family:Arial,Helvetica,sans-serif\">UvA web page: <a href=\"http://www.uva.nl/profile/t.d.jorgensen\" style=\"color:rgb(17,85,204)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.uva.nl/profile/t.d.jorgensen&amp;source=gmail&amp;ust=1792425332916000&amp;usg=AOvVaw15CILv1teAyEv6CmzqTt7x\">http://www.uva.nl/profile/t.d.jorgensen</a></div><div><br></div></div></div><div></div></div>"
    ]
   ]
  },
