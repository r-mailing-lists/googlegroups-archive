n><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> scale</span><span style=\"color:#660\">(</span><span style=\"color:#000\">pathdata$m</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>pathdata$y</span><span style=\"color:#660\">.</span><span style=\"color:#000\">st </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> scale</span><span style=\"color:#660\">(</span><span style=\"color:#000\">pathdata$y</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>pathdata$z</span><span style=\"color:#660\">.</span><span style=\"color:#000\">st </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> scale</span><span style=\"color:#660\">(</span><span style=\"color:#000\">pathdata$z</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>pathdata$xz</span><span style=\"color:#660\">.</span><span style=\"color:#000\">st </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> pathdata$x</span><span style=\"color:#660\">.</span><span style=\"color:#000\">st </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> pathdata$z</span><span style=\"color:#660\">.</span><span style=\"color:#000\">st<br><br>stmodel </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39; <a href=\"http://m.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://m.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw2hF0to8gsmiwirVv3mZ5Fy\">m.st</a> ~ <a href=\"http://x.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://x.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw2KU437OiUg5eZhnQOcx-Fu\">x.st</a> + <a href=\"http://z.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://z.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw0dlAugeMpNhvbFwOxaL_4q\">z.st</a> + <a href=\"http://xz.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://xz.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw0-WVzA4EfdAilW9Bo7246J\">xz.st</a>                                                    <br>             <a href=\"http://y.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://y.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw21OJcGeaSv7QS1ErhBvUC9\">y.st</a> ~ <a href=\"http://x.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://x.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw2KU437OiUg5eZhnQOcx-Fu\">x.st</a> + <a href=\"http://z.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://z.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw0dlAugeMpNhvbFwOxaL_4q\">z.st</a> + <a href=\"http://m.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://m.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw2hF0to8gsmiwirVv3mZ5Fy\">m.st</a> + <a href=\"http://xz.st\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://xz.st&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw0-WVzA4EfdAilW9Bo7246J\">xz.st</a> &#39;</span><span style=\"color:#000\"><br>stpathfit </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sem</span><span style=\"color:#660\">(</span><span style=\"color:#000\">stmodel</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> pathdata</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> <br>coef</span><span style=\"color:#660\">(</span><span style=\"color:#000\">stpathfit</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># standardized coefficients</span></div></code></div><div><br></div><div><br></div><div><div>Terrence D. Jorgensen</div><div>Postdoctoral Researcher, Methods and Statistics</div><div>Research Institute for Child Development and Education, the University of Amsterdam</div><div>UvA web page: <a href=\"http://www.uva.nl/profile/t.d.jorgensen\" style=\"color:rgb(17,85,204)\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.uva.nl/profile/t.d.jorgensen&amp;source=gmail&amp;ust=1792427371705000&amp;usg=AOvVaw3_dmmuWJkSGS0Pq9aE5nGT\">http://www.uva.nl/profile/t.d.jorgensen</a></div></div><div><br></div></div></blockquote></div>"
