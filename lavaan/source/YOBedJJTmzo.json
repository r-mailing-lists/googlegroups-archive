<span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sem</span><span style=\"color:#660\">(</span><span style=\"color:#000\">mySyntax</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> myData</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> lavInspect</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fit</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;est&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\">$beta </span><span style=\"color:#800\"># matrix of path coefficients</span><span style=\"color:#000\"><br></span><span style=\"color:#800\"># view effects of each order</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># direct effects</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%*%</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># indirect effects involving 2 path coefficents</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%*%</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%*%</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color:#800\"># indirect effects involving 3 path coefficients</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Beta</span><span style=\"color:#000\"> </span><span style=\"color