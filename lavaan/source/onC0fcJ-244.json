     "<div dir=\"ltr\"><div><br></div><div><br></div><div><br></div><blockquote style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\" class=\"gmail_quote\">By the way, this is problematic:<br><code><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(136,0,0)\">#residual correlations<br></span></code><code><span style=\"color:rgb(0,0,0)\">      value     </span><span style=\"color:rgb(102,102,0)\">~~</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">*</span><span style=\"color:rgb(0,0,0)\">value<br></span></code><span style=\"background-color:rgb(250,250,250);color:rgb(0,0,0)\">      rating    </span><span style=\"background-color:rgb(250,250,250);color:rgb(102,102,0)\">~~</span><span style=\"background-color:rgb(250,250,250);color:rgb(0,0,0)\"> </span><span style=\"background-color:rgb(250,250,250);color:rgb(0,102,102)\">1</span><span style=\"background-color:rgb(250,250,250);color:rgb(102,102,0)\">*</span><span style=\"background-color:rgb(250,250,250);color:rgb(0,0,0)\">rating</span> </blockquote><div><br></div></div>"
