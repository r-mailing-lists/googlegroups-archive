e=\"color:#000\"> ordered</span><span style=\"color:#660\">=</span><span style=\"color:#000\">TRUE</span><span style=\"color:#660\">)</span><span style=\"color:#000\">        </span><span style=\"color:#800\"># binary outcome as factor</span><span style=\"color:#000\"><br>df </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">frame</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> z1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> z2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Basic model: works ...</span><span style=\"color:#000\"><br>m1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;<br>z2 ~ b1*x + b2*y<br>&quot;</span><span style=\"color:#000\"><br><br></span><span style=\"color:#800\"># Constrained model: works as well ...</span><span style=\"color:#000\"><br>m2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;<br>z2 ~ b1*x + b2*y<br>b1==b2<br>&quot;</span><span style=\"color:#000\"><br>s1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sem</span><span style=\"color:#660\">(</span><span style=\"color:#000\">m1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">=</span><span style=\"color:#000\">df</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;z2&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>s2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sem</span><spa