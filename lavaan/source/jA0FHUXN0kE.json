     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\" class=\"gmail_attr\">El lun, 27 may 2024 a las 10:36, Helene von Gugelberg (&lt;<a href data-email-masked rel=\"nofollow\">vonguge...@gmail.com</a>&gt;) escribió:<br></div></div>"
