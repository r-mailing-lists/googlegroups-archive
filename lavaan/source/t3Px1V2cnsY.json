   "subject": "Re: Error in match(x, table, nomatch = 0L) : 'to' must be of length 1",
   "parts": [
    [
     1,
     "<div dir=\"ltr\">taken from  <a href=\"https://groups.google.com/forum/#!searchin/lavaan/HolzingerSwineford1939/lavaan/pWbB8PNRZ1U/rESP1rMtyiwJ\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/%23!searchin/lavaan/HolzingerSwineford1939/lavaan/pWbB8PNRZ1U/rESP1rMtyiwJ&amp;source=gmail&amp;ust=1792430439402000&amp;usg=AOvVaw2CpYY7_m4PQK4dqOHNIyDE\">https://groups.google.com/forum/#!searchin/lavaan/HolzingerSwineford1939/lavaan/pWbB8PNRZ1U/rESP1rMtyiwJ</a><div><br></div><div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><div>#create 4 categories for each continuous variable</div><div>DF=HolzingerSwineford1939 #copy data frame into new object</div><div>#recode in categorical variables</div><div>vec=c(&quot;x1&quot;,&quot;x2&quot;,&quot;x3&quot;,&quot;x4&quot;,&quot;x5&quot;,&quot;x6&quot;,&quot;x7&quot;,&quot;x8&quot;,&quot;x9&quot;)#vector of variables names</div><div>MinusSD=function(x){mean(x)-sd(x)}#functions to simplify recoding</div><div>PlusSD=function(x){mean(x)+sd(x)}</div><div>#create 4 categories</div><div>library(car)</div><div>for (i in vec) </div><div>  { DF[,i]=recode(DF[,i],&quot;lo:MinusSD(DF[,i])=0;MinusSD(DF[,i]):mean(DF[,i])=1; </div><div>                           mean(DF[,i]):PlusSD(DF[,i])=2;PlusSD(DF[,i]):hi=3&quot;)}</div><div>for (i in vec) {DF[,i]&lt;-ordered(DF[,i])}#order</div><div>table(DF$x1);class(DF$x1)</div></div></code></div><div><br></div><div>reproduce error message</div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><font color=\"#660066\"><div>m &lt;- &#39;</div><div><span style=\"white-space:pre\">\t</span>visual =~ x1 + x2 + x3</div><div><span style=\"white-space:pre\">\t</span>textual =~ x4 + x5 + x6</div><div><span style=\"white-space:pre\">\t</span>speed =~ x7 + x8 + x9</div><div><span style=\"white-space:pre\">\t</span></div><div><span style=\"white-space:pre\">\t</span>visual ~ sex</div><div>&#39;</div><div><br></div><div>sem(</div><div><span style=\"white-space:pre\">\t</span>model = m, data = DF, </div><div><span style=\"white-space:pre\">\t</span>estimator = &quot;WLSMV&quot;, parameterization = &quot;theta&quot;, </div><div><span style=\"white-space:pre\">\t</span>group = &quot;school&quot;</div><div>)<br><br># Fehler in match(x, table, nomatch = 0L) : &#39;to&#39; must be of length 1<br></div></font></div></code></div><br><br><br></div></div>"
    ]
   ]
