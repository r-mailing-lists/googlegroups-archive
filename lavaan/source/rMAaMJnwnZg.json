p</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> cluster </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> cluster</span><span style=\"color:#660\">,</span><span style=\"color:#000\">  </span><span style=\"color:#660\">:</span><span style=\"color:#000\"> <br>  lavaan ERROR</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> missing observed variables </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> dataset</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> aw bw sc</span></div></code></div></div><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div style=\"word-wrap:break-word;line-break:after-white-space\"><div><div><br></div></div></div></blockquote></div></div></blockquote><div><br></div><div><br></div></div>"
