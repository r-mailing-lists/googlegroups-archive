itial;border-top-style:none;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\"><span style=\"color:black\"><font face=\"arial, sans-serif\" size=\"2\">dv1_t1~~dv1_t1</font></span></p>\r\n  </td>\r\n  <td width=\"191\" nowrap valign=\"top\" style=\"width:143pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:rgb(191,191,191);border-right-width:1pt;border-right-color:rgb(191,191,191);padding:0in 5.4pt;height:16pt\"></td>\r\n  <td width=\"191\" nowrap valign=\"top\" style=\"width:143pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:rgb(191,191,191);border-right-width:1pt;border-right-color:rgb(191,191,191);padding:0in 5.4pt;height:16pt\"></td>\r\n </tr>\r\n <tr style=\"height:16.0pt\">\r\n  <td width=\"191\" nowrap valign=\"top\" style=\"width:143pt;border-right:1pt solid rgb(191,191,191);border-bottom:1pt solid rgb(191,191,191);border-left:1pt solid rgb(191,191,191);border-top-width:initial;border-top-style:none;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\"><span style=\"color:black\"><font face=\"arial, sans-serif\" size=\"2\">-0.025</font></span></p>\r\n  </td>\r\n  <td width=\"191\" nowrap valign=\"top\" style=\"width:143pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:rgb(191,191,191);border-right-width:1pt;border-right-color:rgb(191,191,191);padding:0in 5.4pt;height:16pt\"></td>\r\n  <td width=\"191\" nowrap valign=\"top\" style=\"width:143pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:rgb(191,191,191);border-right-width:1pt;border-right-color:rgb(191,191,191);padding:0in 5.4pt;height:16pt\"></td>\r\n </tr>\r\n</tbody></table>\r\n\r\n<p class=\"MsoNormal\"><font face=\"arial, sans-serif\" size=\"2\"> </font></p></div></blockquote><div><br></div></div>"
    ],
    [
     1,
     "<div dir=\"ltr\"><div>All these are about your dv* variables.  What does their correlation matrix look like? </div><div><br></div><div>Does this continue to occur when you treat self and other as separate outcomes instead of trying to extract a higher-order common factor &quot;latent&quot;?</div><div><br></div><div><div><div>Terrence D. Jorgensen</div><div>Assistant Professor, Methods and Statistics</div><div>Research Institute for Child Development and Education, the University of Amsterdam</div><div><a href=\"http://www.uva.nl/profile/t.d.jorgensen\" style=\"color:rgb(17,85,204)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.uva.nl/profile/t.d.jorgensen&amp;source=gmail&amp;ust=1792423049676000&amp;usg=AOvVaw3aKQai7ev3wz5xFqyFt_4-\">http://www.uva.nl/profile/t.d.jorgensen</a></div></div><div><br></div></div></div>"
    ]
