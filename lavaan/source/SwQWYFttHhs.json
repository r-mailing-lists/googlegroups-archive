{
 "thread": "SwQWYFttHhs",
 "subject": "standardized residuals with wlsmv estimator",
 "messages_listed": 4,
 "last_activity": "2018-11-29T10:29:28Z",
 "messages": [
  {
   "id": "B_zIkjH_AQAJ",
   "from": "geor...@hawaii.edu",
