     "<div dir=\"auto\"></div><br><div class=\"gmail_quote\"><div dir=\"ltr\">On Fri, Jul 20, 2018, 22:41  &lt;<a href data-email-masked rel=\"nofollow\">lav...@googlegroups.com</a>&gt; wrote:<br></div><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">\r\n<div style=\"border:1px solid #d3d3d3;max-width:850px;font-family:Arial,sans-serif;color:#000000\">\r\n  <div style=\"background-color:#f5f5f5;padding:10px 20px\">\r\n    <table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\">\r\n      <tbody>\r\n        <tr>\r\n          <td style=\"width:70%\">\r\n            <span style=\"font:18px/20px arial;color:#333333\">\r\n              <a href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/lavaan/topics\" style=\"text-decoration:none;color:#333333\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/lavaan/topics&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0E0d9y037zbctwN6ZYrsA_\">\r\n              lav...@googlegroups.com</a>\r\n            </span>\r\n          </td>\r\n          <td style=\"text-align:right;width:30%\">\r\n            <span style=\"font:20px/24px arial\"><a style=\"color:#dd4b39;text-decoration:none\" href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email/#!overview\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail/%23!overview&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0P8_i0Xt030SYuy1SPEq_6\">Google Groups</a></span>\r\n          </td>\r\n          <td style=\"width:32px\">\r\n            <a href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email/#!overview\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail/%23!overview&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0P8_i0Xt030SYuy1SPEq_6\"><img style=\"border:0;vertical-align:middle\" src=\"https://ci5.googleusercontent.com/proxy/4SGWHe9midrWMDxDIJMQraTMMgnAU71soPZ0D28IOSZcs66TdyRoCqyIhaTt-kwo0YKv2lRo05RkwsGFZdnFhdvy60XdxNlL2U-B=s0-d-e1-ft#http://www.google.com/images/icons/product/groups-32.png\"></a>\r\n          </td>\r\n        </tr>\r\n      </tbody>\r\n    </table>\r\n  </div>\r\n  <div style=\"padding:20px;background-color:#f5f5f5\">\r\n\r\n\r\n<div style=\"font-family:arial;color:#222222;padding:0px\">\r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_digest_top\" style=\"font-size:21px\" rel=\"noreferrer nofollow\">\r\n  \r\n    Today&#39;s topic summary\r\n  \r\n  \r\n  </a><br>\r\n  <span style=\"font-size:11px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/lavaan/topics\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/lavaan/topics&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0E0d9y037zbctwN6ZYrsA_\">View all topics</a>\r\n  </span>\r\n</div>\r\n<div style=\"font:13px/18px arial;color:#222222;padding:0px;margin-bottom:30px\">\r\n  <ul style=\"margin-left:3px;padding-left:0px\">\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_group_thread_0\" rel=\"noreferrer nofollow\">\r\n      Estimation of bidimensional IRT parameters using LAVAAN and MIRT</a> -\r\n      <span style=\"color:#777777\">4 Updates</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_group_thread_1\" rel=\"noreferrer nofollow\">\r\n      Testing measurement invariance with constrained model parameters.</a> -\r\n      <span style=\"color:#777777\">3 Updates</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_group_thread_2\" rel=\"noreferrer nofollow\">\r\n      lavaan 0.6-2 has been released on CRAN</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_group_thread_3\" rel=\"noreferrer nofollow\">\r\n      Convergence issue: same model works in two samples, not in a third</a> -\r\n      <span style=\"color:#777777\">2 Updates</span>\r\n    </li>\r\n  \r\n    <li>\r\n      <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_group_thread_4\" rel=\"noreferrer nofollow\">\r\n      Error and warnings produced using runMI for analysis with multiple imputed datasets.</a> -\r\n      <span style=\"color:#777777\">1 Update</span>\r\n    </li>\r\n  \r\n  </ul>\r\n</div>\r\n\r\n\r\n\r\n  \r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_group_thread_0\" rel=\"noreferrer nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/lavaan/t/ba3907982562ac46?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/t/ba3907982562ac46?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0cbUFupJIVYGZ-N4dJ5OPS\">\r\n      Estimation of bidimensional IRT parameters using LAVAAN and MIRT\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Mauricio Garnier-Villarreal &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>mauga...@gmail.com</a>&gt;: Jul 19 09:40PM -0700\r\n      </span>\r\n      <br><br>\r\n      Hugo<br>\r\n <br>\r\nYou dont need the <a href=\"http://std.lv\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://std.lv&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0hGi86BmLAZnaTDZgMen5-\">std.lv</a>=T, the EFA function sets the identification <br>\r\nconstraints needed for estimation.<br>\r\n <br>\r\nWhen I run this I dont get an error<br>\r\n### run EFA with WLSMV <br>\r\nef2_irt &lt;-\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/44600080b9ebc?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/44600080b9ebc?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw2Q19cYwzrt1a0-Q869YRd0\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Hugo Harada &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>hugo....@adaptativa.com.br</a>&gt;: Jul 20 10:11AM -0300\r\n      </span>\r\n      <br><br>\r\n      Mauricio,<br>\r\n <br>\r\nThank you for your reply.<br>\r\n <br>\r\n*When I run this I dont get an error*<br>\r\n*### run EFA with WLSMV *<br>\r\n*ef2_irt &lt;- efaUnrotate(data=<a href=\"http://LC.MT\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://LC.MT&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw2O105N1rKkPYJ3V-DC3tp1\">LC.MT</a> &lt;<a href=\"http://lc.mt/\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://lc.mt/&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw3E93QznaSMm6L4JqfdnI48\">http://lc.mt/</a>&gt;,*<br>\r\n*                      \r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/707810a6ceaee?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/707810a6ceaee?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw1WcYzaKpBkyGfmn60SQcXO\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Yves Rosseel &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>yros...@gmail.com</a>&gt;: Jul 20 03:21PM +0200\r\n      </span>\r\n      <br><br>\r\n      &gt;          does not appear to be positive definite! The smallest eigenvalue<br>\r\n&gt;          (= -1.552743e-02) is smaller than zero. This may be a symptom that<br>\r\n&gt;          the model is not\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/70811b75efd34?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/70811b75efd34?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw2iDxkuZCKyIvFWuhf6LWET\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Hugo Harada &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>hugo....@adaptativa.com.br</a>&gt;: Jul 20 11:35PM -0300\r\n      </span>\r\n      <br><br>\r\n      Hi, Mauricio!<br>\r\n <br>\r\n*As for sessioninfo(), the only difference seems to be the R version and<br>\r\nthe OS. I will try to run my code in a linux virtual machine and try to<br>\r\nconfirm this is a platform dependent\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/73106679beb1d?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/73106679beb1d?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0v6Yfp0mb3Vx_RvQd70m0x\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_digest_top\" rel=\"noreferrer nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_group_thread_1\" rel=\"noreferrer nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/lavaan/t/e3d2fca007e6f6e?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/t/e3d2fca007e6f6e?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw3XQcM01Fp5xpeUZXQffVsf\">\r\n      Testing measurement invariance with constrained model parameters.\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Peter Kruyen &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>p.m.k...@gmail.com</a>&gt;: Jul 20 04:06AM -0700\r\n      </span>\r\n      <br><br>\r\n      Dear all,<br>\r\n <br>\r\nI have the following multiple group SEM model, in which I constrained the <br>\r\nfactor loading of &#39;bal8.1&#39; (to prevent the variance of this item to become <br>\r\nnegative; and several factor\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/45b080a46f6d4?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/45b080a46f6d4?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0Mjg3CM0eEcpQB5-1uz6nl\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Edward Rigdon &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>edward...@gmail.com</a>&gt;: Jul 20 09:54AM -0400\r\n      </span>\r\n      <br><br>\r\n      My first guess would be an interaction between &quot;ordered&quot; and &quot;pairwise&quot;. If<br>\r\nvalues are missing for one level of one variable in one group, then the<br>\r\n&quot;ordered&quot; is going to produce different\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/709dd8b8cc71f?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/709dd8b8cc71f?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw0rE1PUdHkQdOlXfKVdZToZ\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Peter Kruyen &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>p.m.k...@gmail.com</a>&gt;: Jul 20 07:08AM -0700\r\n      </span>\r\n      <br><br>\r\n      Hi Edward,<br>\r\n <br>\r\nThat does make sense! And yes, you are correct without treating the <br>\r\nvariables as ordinal the syntax works (but the fit drops significantly <br>\r\ntoo). Okay, I will go through the bivariate\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/464fec596a54f?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/464fec596a54f?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw1HjUhhaPQTqC5ncpz9kQ6Z\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_digest_top\" rel=\"noreferrer nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_group_thread_2\" rel=\"noreferrer nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/lavaan/t/b7ac04a2189c7fbb?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/t/b7ac04a2189c7fbb?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw3DYXgPkbbRHBvnC4zQR0sV\">\r\n      lavaan 0.6-2 has been released on CRAN\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        <a href rel=\"noreferrer nofollow\" data-email-masked>yros...@gmail.com</a>: Jul 20 05:59AM -0700\r\n      </span>\r\n      <br><br>\r\n      Dear lavaan users,<br>\r\n <br>\r\nlavaan 0.6-2 has arrived at CRAN. To install, simply to in R:<br>\r\n <br>\r\ninstall.packages(&quot;lavaan&quot;, dependencies = TRUE)<br>\r\n <br>\r\nand restart your R session.<br>\r\n <br>\r\nThe release notes can be found\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/46134c09d2595?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/46134c09d2595?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw2TF75o-4AY9sl8GIxoQIn7\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_digest_top\" rel=\"noreferrer nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_group_thread_3\" rel=\"noreferrer nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/lavaan/t/7e26591bb91cdc11?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/t/7e26591bb91cdc11?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266868000&amp;usg=AOvVaw1kL0XF9N7rrwcDB-TfGDHL\">\r\n      Convergence issue: same model works in two samples, not in a third\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        <a href rel=\"noreferrer nofollow\" data-email-masked>christophe...@nicholls.edu</a>: Jul 19 09:55PM -0700\r\n      </span>\r\n      <br><br>\r\n      Thanks for responding, Terrence.<br>\r\n <br>\r\nIt might help you if you think of the model as exactly the same, but the <br>\r\ndata are gathered in such a way as to cause a temporal separation in <br>\r\n\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/446c8b3175358?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/446c8b3175358?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266869000&amp;usg=AOvVaw2Trzpnm92FS3S3eI953LJG\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Terrence Jorgensen &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>tjorge...@gmail.com</a>&gt;: Jul 20 01:50AM -0700\r\n      </span>\r\n      <br><br>\r\n      I&#39;ve seen convergence issues with bifactor and especially MTMM models <br>\r\nbefore, when factors were allowed to correlate.  Does the model converge if <br>\r\nall factors are orthogonal?<br>\r\n <br>\r\nAlso, this is not\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/453a5c99c9108?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/453a5c99c9108?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266869000&amp;usg=AOvVaw2BACnL5RFa8aEgTIWEvgqG\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_digest_top\" rel=\"noreferrer nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n  \r\n  <a name=\"m_5345786524313070709_m_-636196726741942784_group_thread_4\" rel=\"noreferrer nofollow\"></a>\r\n  <div style=\"display:inline-block;font-family:arial;padding:4px 0 5px 0px\">\r\n  \r\n    <a href=\"http://groups.google.com/group/lavaan/t/56df12793bea8c6?utm_source=digest&amp;utm_medium=email\" style=\"font-size:21px;color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/t/56df12793bea8c6?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266869000&amp;usg=AOvVaw3Q0OgkZehnMOOgncwBVdPa\">\r\n      Error and warnings produced using runMI for analysis with multiple imputed datasets.\r\n    </a>\r\n  \r\n  </div>\r\n\r\n  <table style=\"border-collapse:collapse;width:100%\">\r\n    \r\n    <tr><td style=\"background-color:#ffffff;color:#2e2e2e;font-family:arial;padding:10px 15px;border:1px solid #d3d3d3\">\r\n      <span style=\"color:#b1b0b0;font-size:15px\">\r\n        Terrence Jorgensen &lt;<a href rel=\"noreferrer nofollow\" data-email-masked>tjorge...@gmail.com</a>&gt;: Jul 20 01:30AM -0700\r\n      </span>\r\n      <br><br>\r\n      <br>\r\n&gt; Could it be due to the fact that English.teacher is  a categorical <br>\r\n&gt; variable? *Can you include categorical variables as predictors for <br>\r\n&gt; variables to be imputed in mice??*<br>\r\n\r\n      \r\n        <span style=\"font-size:11px\"><a style=\"color:#1155cc;text-decoration:none\" href=\"http://groups.google.com/group/lavaan/msg/45283d64f0113?utm_source=digest&amp;utm_medium=email\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://groups.google.com/group/lavaan/msg/45283d64f0113?utm_source%3Ddigest%26utm_medium%3Demail&amp;source=gmail&amp;ust=1792425266869000&amp;usg=AOvVaw3ZRA-a1mmqOrihHkUVlD7s\">...more</a></span>\r\n        <br>\r\n      \r\n    </td></tr>\r\n    \r\n  </table>\r\n  <div style=\"font-size:11px;margin-bottom:40px;margin-top:5px\">\r\n    <a style=\"color:#1155cc;text-decoration:none\" href=\"#m_5345786524313070709_m_-636196726741942784_digest_top\" rel=\"noreferrer nofollow\">Back to top</a>\r\n  </div>\r\n\r\n\r\n\r\n\r\n  </div>\r\n  <div style=\"background-color:#f5f5f5;padding:5px 20px\">\r\n  <table cellpadding=\"0\" cellspacing=\"0\" style=\"width:100%\">\r\n  <tbody><tr>\r\n    <td style=\"padding-top:4px;font-family:arial,sans-serif;color:#636363;font-size:11px\">\r\n      \r\n      You received this digest because you&#39;re subscribed to updates for this group. You can change your settings on the <a href=\"https://groups.google.com/forum/?utm_source=digest&amp;utm_medium=email#!forum/lavaan/join\" style=\"color:#1155cc;text-decoration:none\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/forum/?utm_source%3Ddigest%26utm_medium%3Demail%23!forum/lavaan/join&amp;source=gmail&amp;ust=1792425266869000&amp;usg=AOvVaw0HLhaLvW88GNTWOtJorcko\">group membership page</a>.<br>\r\n      To unsubscribe from this group and stop receiving emails from it send an email to <a href rel=\"noreferrer nofollow\" data-email-masked>lavaan+un...@googlegroups.com</a>.\r\n    </td>\r\n  </tr></tbody>\r\n  </table>\r\n  </div>\r\n</div>\r\n\r\n</blockquote></div>\r\n"
