,102)\">0.604</span></p><p align=\"LEFT\"><span style=\"color:rgb(0,102,102)\">6</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(102,0,102)\">Var7</span><span style=\"color:rgb(0,0,0)\">  </span><span style=\"color:rgb(102,102,0)\">~</span><span style=\"color:rgb(0,0,0)\"> factor1 </span><span style=\"color:rgb(0,102,102)\">14.294</span><span style=\"color:rgb(0,0,0)\">  </span><span style=\"color:rgb(0,102,102)\">0.320</span><span style=\"color:rgb(0,0,0)\">   </span><span style=\"color:rgb(0,102,102)\">0.260</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(0,102,102)\">0.263</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(0,102,102)\">0.263</span></p><p align=\"LEFT\"><span style=\"color:rgb(0,102,102)\">7</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(102,0,102)\">Var6</span><span style=\"color:rgb(0,0,0)\">  </span><span style=\"color:rgb(102,102,0)\">~</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(102,0,102)\">Var7</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">12.885</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">-</span><span style=\"color:rgb(0,102,102)\">0.127</span><span style=\"color:rgb(0,0,0)\">  </span><span style=\"color:rgb(102,102,0)\">-</span><span style=\"color:rgb(0,102,102)\">0.127</span><span style=\"color:rgb(0,0,0)\">   </span><span style=\"color:rgb(102,102,0)\">-</span><span style=\"color:rgb(0,102,102)\">0.154</span><span style=\"color:rgb(0,0,0)\">   </span><span style=\"color:rgb(102,102,0)\">-</span><span style=\"color:rgb(0,102,102)\">0.156</span></p><p><span style=\"color:rgb(0,102,102)\">8</span><span style=\"color:rgb(0,0,0)\"> factor1  </span><span style=\"color:rgb(102,102,0)\">~</span><span style=\"color:rgb(0,0,0)\">    </span><span style=\"color:rgb(102,0,102)\">Var1</span><span style=\"color:rgb(0,0,0)\"> </span><span style=