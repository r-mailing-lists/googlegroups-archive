quot;theta&quot;,</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         ID.fac = &quot;</span><a href=\"http://std.lv/\" style=\"font-size:small\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://std.lv/&amp;source=gmail&amp;ust=1792415605140000&amp;usg=AOvVaw2Z9akzTllMXFZTxkARmt4q\">std.lv</a><span style=\"color:rgb(34,34,34);font-size:small\">&quot;,</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         ID.cat = &quot;Wu.Estabrook.2016&quot;,</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         group = &quot;Gender&quot;,</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         group.equal = c(&quot;thresholds&quot;,&quot;loadings&quot;,&quot;</span><span style=\"color:rgb(34,34,34);font-size:small\">intercepts&quot;,&quot;residuals&quot;),</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         </span><span class=\"gmail_default\"></span><span class=\"gmail_default\"></span><span style=\"color:rgb(34,34,34);font-size:small\">group.partial= c(&quot;CSBD2~~CSBD2&quot;,&quot;CSBD9~~</span><span style=\"color:rgb(34,34,34);font-size:small\">CSBD9&quot;),</span><br style=\"color:rgb(34,34,34);font-size:small\"><span style=\"color:rgb(34,34,34);font-size:small\">                                         return.fit=TRUE)</span><div style=\"color:rgb(34,34,34);font-size:small\"><div class=\"gmail_default\" style=\"font-size:large;color:rgb(0,0,255)\"><span style=\"font-size:small;color:rgb(34,34,34)\">Error in group.partial == &quot;&quot; &amp;&amp; le