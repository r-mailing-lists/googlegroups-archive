e.com/url?hl=en-US&amp;q=http://www.statmodel.com/usersguide/chap5/ex5.16.dat&amp;source=gmail&amp;ust=1792424278918000&amp;usg=AOvVaw3ybzp1XkjxP8eQEU7y_oOL\">http://www.statmodel.com/usersguide/chap5/ex5.16.dat</a>&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>names</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;u1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;u2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;u3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;u4&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;u5&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;u6&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;g&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u3 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u3</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u4 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u4</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u5 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u5</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u6 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u6</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#000\"><br>model </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;<br>f1 =~ u1 + u2 + u3<br>f2 =~ u4 + u5 + u6<br>&#39;</span><span style=\"color:#000\"><br>fit </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> cfa</span><span style=\"color:#660\">(</span><span style=\"color:#000\">model</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> myData</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> estimator </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;MML&#39;</span><span style=\"color:#660\">)</span></div></code></div><div><div><br></div></div><div><br></div><div><div style=\"font-size:small\"><div style=\"font-size:13px\">Terrence D. Jorgensen</div><div style=\"font-size:13px\">Assistant Professor, Methods and Statistics</div><div style=\"font-size:13px\">Research Institute for Child Development and Education, the University o