,</span><span style=\"color:#080\">&quot;u6&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;x3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#080\">&quot;g&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u1 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u2 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u2</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u3 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u3</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u4 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u4</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u5 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u5</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>myData$u6 </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> ordered</span><span style=\"color:#660\">(</span><span style=\"color:#000\">myData$u6</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#000\"><br>model </span><span style=\"color:#660\">&lt;-</span><span