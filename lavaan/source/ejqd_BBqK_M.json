beration Mono&quot;,&quot;Courier New&quot;,monospace;font-size:14.875px;white-space:pre;background-color:rgba(233,236,239,0.65)\"><a href=\"https://lavaan.ugent.be/tutorial/growth.html#cb2-2\" aria-hidden=\"true\" style=\"text-decoration-color:rgb(108,117,125);color:inherit;box-sizing:border-box\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lavaan.ugent.be/tutorial/growth.html%23cb2-2&amp;source=gmail&amp;ust=1792415284928000&amp;usg=AOvVaw2OIewkQQVmJipWSyGGGasL\"></a><span style=\"box-sizing:border-box;color:rgb(32,121,77);font-style:inherit\">           s =~ 0*t1 + 1*t2 + 2*t3 + 4*t4 </span></span><span style=\"background-color:rgba(233,236,239,0.65);color:rgb(32,121,77);font-family:SFMono-Regular,Menlo,Monaco,Consolas,&quot;Liberation Mono&quot;,&quot;Courier New&quot;,monospace;font-size:14.875px;white-space:pre\">+ 5.5*t5 + 7*t6 </span></div><div><span style=\"box-sizing:border-box;color:rgb(0,59,79);text-decoration-line:inherit;display:inline-block;line-height:1.25;font-family:SFMono-Regular,Menlo,Monaco,Consolas,&quot;Liberation Mono&quot;,&quot;Courier New&quot;,monospace;font-size:14.875px;white-space:pre;background-color:rgba(233,236,239,0.65)\"><span style=\"box-sizing:border-box;color:rgb(32,121,77);font-style:inherit\">           q =~ 0*t1 + 1*t2 + 4*t3 + 16*t4 </span></span><span style=\"background-color:rgba(233,236,239,0.65);color:rgb(32,121,77);font-family:SFMono-Regular,Menlo,Monaco,Consolas,&quot;Liberation Mono&quot;,&quot;Courier New&quot;,monospace;font-size:14.875px;white-space:pre\">+ 30.25*t5 + 49*t6 </span></div><div><span style=\"box-sizing:border-box;color:rgb(0,59,79);text-decoration-line:inherit;display:inline-block;line-height:1.25;font-family:SFMono-Regular,Menlo,Monaco,Consolas,&quot;Liberation Mono&quot;,&quot;Courier New&quot;,monospace;font-size:14.875px;white-space:pre;background-color:rgba(233,236,239,0.65)\"><span style=\"box-sizing:border-box;color:rgb(32,121,77)