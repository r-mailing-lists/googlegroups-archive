ri&quot;,sans-serif;color:black\">NA<u></u><u></u></span></p>\r\n  </td>\r\n </tr>\r\n <tr style=\"height:16.0pt\">\r\n  <td width=\"66\" nowrap valign=\"bottom\" style=\"width:49.25pt;border-right:1pt solid windowtext;border-bottom:1pt solid windowtext;border-left:1pt solid windowtext;border-top-width:initial;border-top-style:none;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"right\" style=\"text-align:right\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">item 4<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"46\" nowrap valign=\"bottom\" style=\"width:34.75pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">0.43<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"60\" nowrap valign=\"bottom\" style=\"width:45pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">0.36<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"60\" nowrap valign=\"bottom\" style=\"width:45pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">NA<u></u><u></u></span></p>\r\n  </td>\r\n </tr>\r\n <tr style=\"height:16.0pt\">\r\n  <td width=\"66\" nowrap valign=\"bottom\" style=\"width:49.25pt;border-right:1pt solid windowtext;border-bottom:1pt solid windowtext;border-left:1pt solid windowtext;border-top-width:initial;border-top-style:none;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"right\" style=\"text-align:right\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">item 5<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"46\" nowrap valign=\"bottom\" style=\"width:34.75pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">NA<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"60\" nowrap valign=\"bottom\" style=\"width:45pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">NA<u></u><u></u></span></p>\r\n  </td>\r\n  <td width=\"60\" nowrap valign=\"bottom\" style=\"width:45pt;border-top-width:initial;border-style:none solid solid none;border-left-width:initial;border-bottom-width:1pt;border-bottom-color:windowtext;border-right-width:1pt;border-right-color:windowtext;padding:0in 5.4pt;height:16pt\">\r\n  <p class=\"MsoNormal\" align=\"center\" style=\"text-align:center\"><span style=\"font-size:12.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:black\">0.45<u></u><u></u></span></p>\r\n  </td>\r\n </tr>\r\n</tbody></table><br>\r\n\r\n</div><div><br></div><div>I collected a new sample with the exact same items (questions). What I would like to do is take the loadings from this former study and use them to specify the input structure for the CFA. </div><div><u><br></u></div><div><u>How would I do this?</u> (i.e., syntax)</div><div><br></div><div>The overall question is whether the new sample has the same factor structure.</div><div><br></div><div>Best,</div><div><br></div><div>Edward</div></div>"
    ]
