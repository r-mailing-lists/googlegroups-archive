n style=\"color:#000\">   </span><span style=\"color:#606\">Std</span><span style=\"color:#660\">.</span><span style=\"color:#000\">lv  </span><span style=\"color:#606\">Std</span><span style=\"color:#660\">.</span><span style=\"color:#000\">all<br>  dem60 </span><span style=\"color:#660\">~</span><span style=\"color:#000\">                                                               <br>    ind60             </span><span style=\"color:#066\">0.499</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.144</span><span style=\"color:#000\">    </span><span style=\"color:#066\">3.460</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.001</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.447</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.447</span><span style=\"color:#000\"><br>  dem65 </span><span style=\"color:#660\">~</span><span style=\"color:#000\">                                                               <br>    ind60             </span><span style=\"color:#066\">0.923</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.628</span><span style=\"color:#000\">    </span><span style=\"color:#066\">1.469</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.142</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.182</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.182</span><span style=\"color:#000\"><br>    dem60             </span><span style=\"color:#066\">4.010</span><span style=\"color:#000\">    </span><span style=\"color:#066\">2.617</span><span style=\"color:#000\">    </span><span style=\"color:#066\">1.533</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.125</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.885</span><span style=\"color:#000\">    </span><span style=\"color:#066\">0.885</span></div></code></div><div><br></div></div><div><br></div><div>Could you enlighten me ?</div><div>Thank you in advance,</div><div><br></div><div>CDF</div></div>"
