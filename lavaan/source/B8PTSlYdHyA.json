(&quot;DKA&quot;,&quot;HYPO&quot;,&quot;COMPLT&quot;, &quot;HEART&quot;,&quot;depanx&quot;))</div><div>summary(fit, fit.measures=TRUE)</div></div><div><br></div><div>ALSO TRIED: </div><div><br></div><div><div>socio[,c(&quot;DKA&quot;,</div><div>        &quot;HYPO&quot;,</div><div>        &quot;COMPLT&quot;,</div><div>        &quot;HEART&quot;,</div><div>        &quot;depanx&quot;)] &lt;-</div><div>  lapply(socio[,c(&quot;DKA&quot;,</div><div>                 &quot;HYPO&quot;,</div><div>                 &quot;COMPLT&quot;,</div><div>                 &quot;HEART&quot;,</div><div>                 &quot;depanx&quot;)], ordered)</div></div><div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"768\" style=\"border-collapse:collapse;width:576pt\"></table></div></div></div>"
