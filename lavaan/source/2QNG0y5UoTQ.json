   "parts": [
    [
     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"en-FI\" link=\"blue\" vlink=\"purple\" style=\"word-wrap:break-word\">\r\n<div>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt\">Hi,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt\">You cannot because the model is not identified.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\" style=\"font-size:11.0pt\">You have 6 covariances in the data and you are trying to estimate 3 exogenous covariances and 6 paths. You cannot estimate 9 things from 6 things. The model would be specified as follows, but\r\n you will just get an error that the model is not identified:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">library(lavaan)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"># Generate correlated variables<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">N &lt;- 1000<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">X &lt;- rnorm(N)<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">d &lt;- data.frame(A=X+rnorm(N),<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">                B=X+rnorm(N),<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">                C=X+rnorm(N),<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">                E=X+rnorm(N))<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">sem(&#39;<u></u><u></u></span></p></div></div>"
    ],
    [
     2,
     "<div lang=\"en-FI\" link=\"blue\" vlink=\"purple\" style=\"word-wrap:break-word\"><div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">#Regression Model<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">D ~ A+B+C<u></u><u></u></span></p>\r\n</div></div>"
