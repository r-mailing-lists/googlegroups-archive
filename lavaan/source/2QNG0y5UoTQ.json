redirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://std.lv&amp;source=gmail&amp;ust=1792418491536000&amp;usg=AOvVaw2p0AyNx-dmEg52KBYWm1AA\">std.lv</a> = TRUE, check.gradient = FALSE,  :\r\n<br>\r\n  lavaan ERROR: missing observed variables in dataset: D<u></u><u></u></span></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\" style=\"margin-left:36.0pt\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n</div>\r\n<div>\r\n<p class=\"MsoNormal\" style=\"margin-left:36.0pt\"><span style=\"font-size:11.0pt\">How can I get this output? <u></u><u></u></span></p>\r\n</div>\r\n</div></div>"
