 style=\"color:#606\">ALparent</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                    TY </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> TY</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                    VTE </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> VTE</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                    RTE </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> RTE</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                    modelType </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;CFA&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br><br></span><span style=\"color:#800\"># fit nested and parent model on data from nested model</span><span style=\"color:#000\"><br>outDatNestedModNested </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sim</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1000</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> n </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">200</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> lcsmNested</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> generate </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> lcsmNested</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>outDatNestedModParent </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sim</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1000</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> n </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#066\">200</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> lcsmParent</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> generate </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> lcsmNested</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>anova</span><span style=\"color:#660\">(</span><span style=\"color:#000\">outDatNestedModNested</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> outDatNestedModParent</span><span style=\"color:#660\">)</span></div></code></div><br><br></div><div><br></div><div><br></div><div><br></div><div><br></div></div>"
