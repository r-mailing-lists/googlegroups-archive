le=\"color:#066\">3</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;runif(1, 0.4, 0.6)&quot;</span><span style=\"color:#000\"><br>RTE </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> binds</span><span style=\"color:#660\">(</span><span style=\"color:#000\">error</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> errorVal</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>RTE<br><br><br></span><span style=\"color:#800\"># generate nested model</span><span style=\"color:#000\"><br>lcsmNested </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> model</span><span style=\"color:#660\">(</span><span style=\"color:#000\">LY </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> LY</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                    RPS </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> RPS</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                    VE </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> VE</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                    AL </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#606\">ALnested</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                    TY </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> TY</span><span style=\"color:#660\">,</span><span style=\"color:#000\">  <br>                    VTE </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> VTE</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                    RTE </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> RTE</span><span style=\"c