     "<div dir=\"ltr\"><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#000\"><br>ordered</span><span style=\"color:#660\">=</span><span style=\"color:#000\">names</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">),</span><span style=\"color:#000\"><br>estimator</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;WLSMV&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>parameterization</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&#39;theta&#39;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>se</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;robust.sem&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>std</span><span style=\"color:#660\">.</span><span style=\"color:#000\">lv</span><span style=\"color:#660\">=</span><span style=\"color:#000\">T</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>orthogonal</span><span style=\"color:#660\">=</span><span style=\"color:#000\">T<br></span><span style=\"color:#660\">)</span></div></code></div></div>"
