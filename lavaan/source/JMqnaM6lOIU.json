    [
     1,
     "<div dir=\"auto\">Thank you so much, I will follow your steps to investigate the culture of NPD, maybe I will drop other items first before dropping the whole variable, do you think it is possible?</div><div dir=\"auto\"><br></div><div dir=\"auto\">Many many thanks</div><div><br><div class=\"gmail_quote\"></div></div>"
