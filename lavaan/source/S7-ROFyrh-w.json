    [
     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\" class=\"gmail_attr\">Am Fr., 10. Mai 2019 um 14:09 Uhr schrieb Terrence Jorgensen &lt;<a href data-email-masked rel=\"nofollow\">tjorge...@gmail.com</a>&gt;:<br></div></div>"
