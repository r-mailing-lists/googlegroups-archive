u.mother.ind := um2*us
u.father.ind := um3*us
u.female.ind := um4*us
u.semester.ind := umc1*us
u.year.ind := umc2*us
u.grade.ind := umc3*us
u.university.ind := umc4*us
u.age.ind := umc5*us
u.child.ind := umc6*us

#total
c.total.none := c1 + (cm1*cs)
c.total.female := c2 + (cm2*cs)
c.total.mother := c3 + (cm3*cs)
c.total.father := c4 + (cm4*cs)
c.total.semester := cc1 + (cmc1*cs)
c.total.year := cc2 + (cmc2*cs)
c.total.grade := cc3 + (cmc3*cs)
c.total.university := cc4 + (cmc4*cs)
c.total.age := cc5 + (cmc5*cs)
c.total.child := cc6 + (cmc6*cs)

e.total.none := c1 + (em1*es)
e.total.female := c2 + (em2*es)
e.total.mother := c3 + (em3*es)
e.total.father := c4 + (em4*es)
e.total.semester := cc1 + (emc1*es)
e.total.year := cc2 + (emc2*es)
e.total.grade := cc3 + (emc3*es)
e.total.university := cc4 + (emc4*es)
e.total.age := cc5 + (emc5*es)
e.total.child := cc6 + (emc6*es)

p.total.none := c1 + (pm1*ps)
p.total.female := c2 + (pm2*ps)
p.total.mother := c3 + (pm3*ps)
p.total.father := c4 + (pm4*ps)
p.total.semester := cc1 + (pmc1*ps)
p.total.year := cc2 + (pmc2*ps)
p.total.grade := cc3 + (pmc3*ps)
p.total.university := cc4 + (pmc4*ps)
p.total.age := cc5 + (pmc5*ps)
p.total.child := cc6 + (pmc6*ps)

u.total.none := c1 + (um1*us)
u.total.female := c2 + (um2*us)
u.total.mother := c3 + (um3*us)
u.total.father := c4 + (um4*us)
u.total.semester := cc1 + (umc1*us)
u.total.year := cc2 + (umc1*us)
u.total.grade := cc3 + (umc1*us)
u.total.university := cc4 + (umc1*us)
u.total.age := cc5 + (umc1*us)
u.total.child := cc6 + (umc6*us)

#Total indirect effects
ind.none := c.none.ind + e.none.ind + p.none.ind + u.none.ind
ind.mother := c.mother.ind + e.mother.ind + p.mother.ind + u.mother.ind
ind.father := c.father.ind + e.father.ind + p.father.ind + u.father.ind
ind.female := c.female.ind + e.female.ind + p.female.ind + u.female.ind

ind.semester := c.semester.ind + e.semester.ind + p.semester.ind + u.semester.ind
ind.year := c.year.ind + e.year.ind + p.year.ind + u.year.ind
ind.grade := c.grade.ind + e.grade.ind + p.grade.ind + u.grade.ind
ind.university :=  c.university.ind + e.university.ind + p.university.ind + u.university.ind
ind.child := c.child.ind + e.child.ind + p.child.ind + u.child.ind
ind.age := c.age.ind + e.age.ind + p.age.ind + u.age.ind

#Total direct effects
total.none := c.total.none + e.total.none + p.total.none + u.total.none + c1
total.mother := c.total.mother + e.total.mother + p.total.mother + u.total.mother + c2
total.father := c.total.father + e.total.father + p.total.father + u.total.father + c3
total.female := c.total.female + e.total.female + p.total.female + u.total.female + c4

total.semester := c.total.semester + e.total.semester + p.total.semester + u.total.semester + cc1
total.year := c.total.year + e.total.year + p.total.year + u.total.year + cc2
total.grade := c.total.grade + e.total.grade + p.total.grade + u.total.grade + cc3
total.university := c.total.university + e.total.university + p.total.university + u.total.university + cc4
total.child := c.total.child + e.total.child + p.total.child + u.total.child + cc6
total.age := c.total.age + e.total.age + p.total.age + u.total.age + cc5
'

