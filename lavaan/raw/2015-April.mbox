library(lavaan)

library(semTools)

strongaggrmodel<- 'Datsub272=~ AGGR + AGOR + ANXI + COGN + MOOD + SOMA + SOPH

AGOR =~ SQ4 + SQ8 +  SQ14 + SQ25
ANXI =~ SQ48 + SQ24 + SQ28 + SQ33 + SQ41 + SQ46
COGN =~ SQ2 + SQ6 + SQ39 + SQ44 + SQ47
MOOD =~ SQ13 + SQ7 + SQ3 + SQ19 + SQ38 + SQ40
SOMA =~ SQ31 + SQ5 + Q11 + SQ17 + SQ22 + SQ26 + SQ1
SOPH =~ SQ32 + SQ27 + SQ23 + SQ36 + SQ45
AGGR =~ c(v43, v43)*SQ43 + c(v10, v10)*SQ10 + c(v16, v16)*SQ16 + c(v21, v21)*SQ21
SQ43 | c(th1,th1)*t1
SQ43 | c(th2,th2)*t2
SQ43 | c(th3,th3)*t3
SQ43 | c(th4,th4)*t4
SQ10 | c(th5,th5)*t1
SQ10 | c(th6,th6)*t2
SQ10 | c(th7,th7)*t3
SQ10 | c(th8,th8)*t4
SQ16 | c(th9,th9)*t1
SQ16 | c(th10,th10)*t2
SQ16 | c(th11,th11)*t3
SQ16 | c(th12,th12)*t4
SQ21 | c(th13,th13)*t1
SQ21 | c(th14,th14)*t2
SQ21 | c(th15,th15)*t3

SQ21 | c(th16,th16)*t4'

StrongAGGR <- cfa(strongaggrmodel, group="Time", data=Data12, estimator="WLSMV", parameterization="theta", ordered=names(Data12)[2:38], std.lv <http://std.lv>=T)

strictaggrmodel<- 'Datsub272=~ AGGR + AGOR + ANXI + COGN + MOOD + SOMA + SOPH
AGOR =~ SQ4 + SQ8 +  SQ14 + SQ25
