>
> head(mp9.11.dat)
>
> model4 <- '
>
> level: 1
> wf1 =~ a*y1 + b*y2 + c*y3
> wf2 =~ d*y4 + e*y5 + f*y6
>
> wf1 ~ b.within*wf2
>
> level: 2
> bf1 =~ a*y1 + b*y2 + c*y3
> bf2 =~ d*y4 + e*y5 + f*y6
> bf1 ~ b.between*bf2
>
>
> bflpe := b.between-b.within
>
> '
> library(lavaan)
> model4.out <- cfa(model4, data=mp9.11.dat, cluster="clus")
>
> summary(model4.out)
>
