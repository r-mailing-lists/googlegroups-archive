Here's the Mplus version (via MplusAutomation) for fun...

model4.mp <http://model4.mp> <- mplusObject (
  TITLE = "Doubly-latent from Marsh, Model 4",
  VARIABLE = "CLUSTER is clus;",
  ANALYSIS = "TYPE = TWOLEVEL RANDOM;
  ESTIMATOR = ML;",

  MODEL = "%WITHIN%
  wf1 by y1 (a);
  wf1 by y2 (b);
  wf1 by y3 (c);
  wf2 by y4 (d);
  wf2 by y5 (e);
  wf2 by y6 (f);
  wf1 ON wf2 (b_within);

  %BETWEEN%
  bf1 by y1 (a);
  bf1 by y2 (b);
  bf1 by y3 (c);
  bf2 by y4 (d);
  bf2 by y5 (e);
  bf2 by y6 (f);
  bf1 ON bf2 (b_betwn);",

  MODELCONSTRAINT = "
  new(bflpe);
  bflpe = b_betwn - b_within;",
  rdata = mp9.11.dat)

model4.mp.out <- mplusModeler(model4.mp <http://model4.mp>, "mp9.11.dat", modelout = "model4.mp.inp", run = 10L)

model4.mp.out$results$model$parameters
model4.mp.out$results$model$summaries

