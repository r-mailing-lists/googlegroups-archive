intercept ~~  intercept
slope ~~  slope
intercept ~~ slope
Cog_T1 ~~   Cog_T1
Cog_T2 ~~   Cog_T2
Cog_T3 ~~   Cog_T3
'

fit_LGC_cog <- sem(LGC_cog, data=df, estimator='ML',missing='fiml')

