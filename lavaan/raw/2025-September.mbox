model_cog_all <- '

Cog_T1 =~ immc_m0_z3 + delmc_m0_z3 + ccc_m0_z3

immc_m0_z3 ~~ immc_m0_z3

delmc_m0_z3 ~~ delmc_m0_z3

ccc_m0_z3 ~~ ccc_m0_z3

