EA =~ MPFI_U1 + MPFI_U2 + MPFI_U3 + MPFI_U4 + MPFI_U5
LPM =~ MPFI_BCH1 + MPFI_BCH2 + MPFI_BCH3 + MPFI_BCH4 + MPFI_BCH5
