Hugo

------------------------------------------------------

mod2ind3lv1.indicator_effects.delta_conditional <- '

lv1 =~ l1*y2w1 + l2*y2w2 + l3*y2w3
l1 + l2 + l3 == 3

lv1 ~ lv1mean*1
lv1 ~~ lv1var*lv1

## LIR means
y2w1 ~ int1*1
y2w2 ~ int2*1
y2w3 ~ int3*1
int1==0
int2==0
int3==0

## thresholds link LIRs to observed items
y2w1 | thr1*t1
y2w2 | thr2*t1
y2w3 | thr3*t1
thr1 + thr2 +thr3 ==0

## LIR (co)variances
#y2w1 ~~ var1*y2w1 + 0*y2w2 + 0*y2w3     # problematic lines
