library(sem)
library(lavaan)
library(semPlot)
library(foreign)

PATH <- read.spss(file.choose(),to.data.frame=TRUE)
summary(PATH)

#Enacted stigma
PATH$EDS <- 'PATH$C1_1_1 + PATH$C1_2_1 + PATH$C1_3_1 + PATH$C1_4_1 + PATH$C1_5_1 + PATH$C1_6_1 + PATH$C1_7_1 + PATH$C1_8_1 + PATH$C1_9_1'
PATH$GSD.GENERAL <- 'PATH$C2_1_1 + PATH$C2_2_1 + PATH$C2_3_1 + PATH$C2_4_1 + PATH$C2_5_1'
PATH$GSD.VERBAL.ABUSES <- 'PATH$C2_7_1 + PATH$C2_8_1 + PATH$C2_9_1'
PATH$GSD.PHYSICAL.ABUSES <- 'PATH$C2_10_1 + PATH$C2_11_1 + PATH$C2_12_1'
PATH$GSD.SEXUAL.ABUSES <- 'PATH$C2_13_1 + PATH$C2_14_1 + PATH$C2_15_1'

#Internalized homophobia
PATH$PRIDE <- 'PATH$D2_1_r_1 + PATH$D2_3_r_1 + PATH$D2_7_r_1 + PATH$D2_9_r_1 + PATH$D2_11_r_1 + PATH$D2_12_r_1 + PATH$D2_14_r_1'
PATH$SHAME <- 'PATH$D2_4_1 + PATH$D2_27_1 + PATH$D2_10_1 + PATH$D2_16_1 + PATH$D2_29_1 + PATH$D2_19_1 + PATH$D2_30_1 + PATH$D2_32_1'
PATH$PASSING <- 'PATH$D2_6_1 + PATH$D2_31_1 + PATH$D2_28_1 + PATH$D2_15_1 + PATH$D2_23_1 + PATH$D2_13_1 + PATH$D2_21_1'
PATH$ALIENATION <- 'PATH$D2_37_1 + PATH$D2_38_1 + PATH$D2_39_1'

# Negative mental health outcomes

PATH$BAI <- 'PATH$F1_1_1 + PATH$F1_2_1 + PATH$F1_3_1 + PATH$F1_4_1 + PATH$F1_5_1 + PATH$F1_6_1 + PATH$F1_7_1 + PATH$F1_8_1 + PATH$F1_9_1 + PATH$F1_10_1 + PATH$F1_11_1 + PATH$F1_12_1 + PATH$F1_13_1 + PATH$F1_14_1 + PATH$F1_15_1 + PATH$F1_16_1+ PATH$F1_17_1 + PATH$F1_18_1 + PATH$F1_19_1 + PATH$F1_20_1 + PATH$F1_21_1'
PATH$CESD <- 'PATH$F2_1_1 + PATH$F2_2_1 + PATH$F2_3_1 + PATH$F2_4_r_1 + PATH$F2_5_1 + PATH$F2_6_1 + PATH$F2_7_1 + PATH$F2_8_r_1 + PATH$F2_9_1 + PATH$F2_10_1 + PATH$F2_11_1 + PATH$F2_12_r_1 + PATH$F2_13_1 + PATH$F2_14_1 + PATH$F2_15_1 + PATH$F2_16_r_1 + PATH$F2_17_1 + PATH$F2_18_1 + PATH$F2_19_1 + PATH$F2_20_1'

# Creation of X, Y and M
X <- 'PATH$EDS + PATH$GSD_GENERAL + PATH$GSD.VERBAL.ABUSES + PATH$GSD.PHYSICAL.ABUSES + PATH$GSD.SEXUAL.ABUSES'
M <- 'PATH$PRIDE + PATH$SHAME + PATH$PASSING + PATH$ALIENATION'
Y <- 'PATH$BAI + PATH$CESD'

Model1 <-'Y ~ c*X
M ~ a*X
Y ~ b*M
ab := a*b
total := c + (a*b)
’

fit1 <- sem(Model1, data = PATH)
summary(fit1, fit.measures = TRUE)

Model2 <- 'X2 =~ PATH$EDS + PATH$GSD.GENERAL + PATH$GSD.VERBAL.ABUSES + PATH$GSD.PHYSICAL.ABUSES + PATH$GSD.SEXUAL.ABUSES
M2 =~ PATH$PRIDE + PATH$SHAME + PATH$PASSING + PATH$ALIENATION
Y2 =~ PATH$BAI + PATH$CESD

Y2 ~ c*X2
M2 ~ a*X2
Y2 ~ b*M2
ab := a*b
total := c + (a*b)
'

fit2 <- sem(Model2, data=PATH)
summary(fit2, fit.measures=TRUE)

