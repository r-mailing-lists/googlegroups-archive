Then, you may use the observed data instead of the factor scores:

set.seed(1234)
library(lavaan)
library(psych)

X <- rnorm(100)
M <- 0.5*X + rnorm(100)
Y <- 0.7*M + rnorm(100)
Data <- data.frame(X = X, Y = Y, M = M)

manimod <- '
  M ~ a*X
  Y ~ b*M + c*X'
manifit <- sem(manimod,Data)

describe(Data)

predM <- coef(manifit)["a"] * Data$X
predY <- coef(manifit)["c"] * Data$X + coef(manifit)["b"] * Data$M
residM <- Data$M - predM
residY <- Data$Y - predY

# Residual plot to check the heteroscadasticity
plot(predM, residM)
plot(predY, residY)

# Check the skewness and kurtosis of residuals
describe(cbind(residM, residY))

