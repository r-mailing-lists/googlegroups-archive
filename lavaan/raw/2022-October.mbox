> > > x2 <- rnorm(n)
> > > Z1 <- .3 * x1 + .4 * x2 + rnorm(n, 0, .8)
> > > Z2 <- rnorm(n)
> > > Y <- .1 * Z1 + .2 * Z2 + .3 * Z1 * Z2 + rnorm(n, 0, .9)
> > > # Arbitrarily scale them
> > > dat <- data.frame(x1 = x1 * 2,
> > >                   x2 = x2 * 3,
> > >                   Z1 = Z1 * 4,
> > >                   Z2 = Z2 * 5,
> > >                   Y = Y * 2)
> > > # Mean center all variables
> > > dat <- as.data.frame(scale(dat, center = TRUE, scale = FALSE))
> > > # Form product term
> > > dat$Z.int <- (dat$Z1 * dat$Z2)
> > >
> > > path <-
> > > 'Z1 ~ a1 * x1 + a2 * x2
> > >  Y  ~ l * Z.int + b1 * Z1 + b2 * Z2 + x1 + x2
> > >  x1.indirect. := a1 * b1
> > >  x1.indirect2 := a1 * (b1 - 1 * l)
> > >  x1.indirect3 := a1 * (b1 + 1 * l)
> > >  '
> > >
> > > library(lavaan)
> > > fit <- sem(path, dat)
> > > parameterEstimates(fit)
> > >
> > > 1) Note that a1 * (b1 - 1 * l) gives the indirect effect of x1->Z1->Y when Z2 is one unit above mean (Z2 is mean-centered), not one SD above mean. To use SD, we can use the technique presented in this webpage (Section 5):
> > >
> > > https://ademos.people.uic.edu/Chapter15.html#5_moderated_mediation_analyses_using_%E2%80%9Clavaan%E2%80%9D_package
> > >
> > > In your example, add "Z2 ~~ var_Z2 * Z2" to label its variance. The square root of this variance is then the SD of Z2.
> > >
> > > path_sd <-
> > > 'Z1 ~ a1 * x1 + a2 * x2
> > >  Y  ~ l * Z.int + b1 * Z1 + b2 * Z2 + x1 + x2
> > >  # Variance of Z2
> > >  Z2 ~~ var_Z2 * Z2
> > >  x1.indirect. := a1 * b1
> > >  x1.indirect2 := a1 * (b1 - sqrt(var_Z2) * l)
> > >  x1.indirect3 := a1 * (b1 + sqrt(var_Z2) * l)
> > >  '
> > > fit_sd <- sem(path_sd, dat)
