Hi Shu Fai,

Thanks for catching my error. I meant to say Z2 should be _standardized_ (mean centered with unit variance). Modifying your code slightly gives the desired indirect effects:
----
set.seed(87452)
n <- 10000

x1 <- rnorm(n)
x2 <- rnorm(n)

Z1 <- 1 * x1 + .4 * x2 + rnorm(n, 0, .8)
Z2 <- rnorm(n)
Y <- 1 * Z1 + .2 * Z2 + 1 * Z1 * Z2 + rnorm(n, 0, .9)

# Arbitrarily scale them
dat <- data.frame(x1 = x1 * 2,
                  x2 = x2 * 3,
                  Z1 = Z1 * 4,
                  Z2 = Z2 * 5,
                  Y = Y * 2)
# Mean center all variables
dat <- as.data.frame(scale(dat, center = TRUE, scale = FALSE))

# standardize Z2
dat$Z2 <- dat$Z2/sd(dat$Z2)

# Form product term
dat$Z.int <- (dat$Z1 * dat$Z2)

path <-'
  Z1 ~ a1 * x1 + a2 * x2
  Y  ~ l * Z.int + b1 * Z1 + b2 * Z2 + x1 + x2

  x1.indirect. := a1 * b1 # true value = 1
  x1.indirect2 := a1 * (b1 - 1 * l) # true value = 0
  x1.indirect3 := a1 * (b1 + 1 * l)  # true value = 2

'

library(lavaan)
fit <- sem(path, dat)

subset(parameterEstimates(fit),label!="")
----
Best wishes,
Wen Wei

