> Ravi,
FIML estimation requires mean structures.  See fit3 below.

require(lavaan)

data <- lavaan::HolzingerSwineford1939

model <- "
    visual =~ x1 + x2 + x3
    textual =~ x4 + x5 + x6
    speed =~ x7 + x8 + x9

    x1 ~~ x2
"
fit1 <- lavaan::cfa(model = model, data=data, std.lv <http://std.lv>=TRUE, missing="listwise")
fit2 <- lavaan::cfa(model = model, data=data, std.lv <http://std.lv>=TRUE, missing="fiml")

summary(fit1)
summary(fit2)

fit3 <- lavaan::cfa(model = model, data=data, std.lv <http://std.lv>=TRUE, missing="listwise", meanstructure=TRUE)
summary(fit3)

