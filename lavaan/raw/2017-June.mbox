the syntax of the LGCM is:

library(lavaan)
install.packages("simsem")
popModel <- '
   i =~ 1*t1 + 1*t2 + 1*t3 + 1*t4
   s =~ 0*t1 + 1*t2 + 2*t3 + 3*t4
   i ~ 0
   s ~ 0
   i ~~ 1*i
   s ~~ 0.2*s
   i ~~ 0*s
   t1 ~~ 1*t1
   t2 ~~ 1.2*t2
   t3 ~~ 1.8*t3
   t4 ~~ 2.8*t4
'
SModel <-'intercept =~ 1*t1 + 1*t2 + 1*t3 + 1*t4
          slope     =~ 0*t1 + 1*t2 + 2*t3 + 3*t4'
library(simsem)
Output1 <- sim(1000, model=SModel, n=50, generate=popModel, std.lv <http://std.lv>=TRUE, lavaanfun="growth", seed=53487)
summary(Output1)

