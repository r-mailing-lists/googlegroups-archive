> > > > 5     f3 ~~   f3     e2   0.982 0.019  52.468  0.000    0.945    1.018
> > > > 6     f1 ~~   f1          1.000 0.000      NA     NA    1.000    1.000
> > > > 7 f2.rsq := 1-e1 f2.rsq   0.532 0.041  12.883  0.000    0.451    0.613
