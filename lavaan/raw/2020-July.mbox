ID8*CORR2 + ID10*CORR2 + ID11*CORR2 + ID12*CORR2 + ID13*CORR2 + ID14*CORR2 +
ID15*CORR2 + ID16*CORR2 + ID17*CORR2 + ID1*CORR3 + ID2*CORR3 + ID3*CORR3 +
ID4*CORR3 + ID5*CORR3 + ID6*CORR3 + ID7*CORR3 + ID8*CORR3 + ID10*CORR3 +
ID11*CORR3 + ID12*CORR3 + ID13*CORR3 + ID14*CORR3 + ID15*CORR3 +
ID16*CORR3 + ID17*CORR3

EO2 ~~ EO5
EO3 ~~ EO4
EO8 ~~ EO9
EO2 ~~ EO3
ID16 ~~ ID17
EO_C ~ ID_Sec + CORR_C + MODing
'
ID.dmc.fit <-sem(ID, data=DataG.dmc, std.lv <http://std.lv>=TRUE, estimator="mlr")
fitMeasures(ID.dmc.fit)
