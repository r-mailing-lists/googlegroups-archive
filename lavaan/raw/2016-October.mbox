    .p11. <- .x.[9]
    .p12. <- .x.[10]
    out[1] <- .p1. - (.p7.)
    out[2] <- .p2. - (.p8.)
    out[3] <- .p3. - (.p9.)
    out[4] <- .p4. - (.p10.)
    out[5] <- .p5. - (.p11.)
    out[6] <- .p6. - (.p12.)
    out[7] = .x.[78] - 1
    return(out)
}
<environment: 0x7609ce8>

But if I fit the model without the constraint, the function has no 'NA's:

function (.x., ...)
{
    out <- numeric(0L)
    .p2. <- .x.[1]
    .p3. <- .x.[2]
    .p4. <- .x.[3]
    .p5. <- .x.[4]
