############################################################ group differences
ph_ s_var_a =~ c(NA, NA)* s_var_a
s_var_a ~~ c(0, 0)* s_var_a
ph_ s_var_a ~~ c(1, 1)*ph_ s_var_a + c(0, 0)* s_var_b

ph_ s_var_b =~ c(NA, NA)* s_var_b
s_var_b  ~~ c(0, 0)* s_var_b
ph_ s_var_b ~~ c(1, 1)*ph_ s_var_b + c(0, 0)*s_var_a

s_var_a ~~ c(0, 0)* s_var_b

ph_ s_var_a ~~ c(cor1, cor2)*ph_ s_var_b

cor_diff_s := cor1 - cor2
###########################################################
i_var_a ~ 1
s_var_a ~ 1
i_var_b ~ 1
s_var_b ~ 1

var_a2  ~ 0
var_a4  ~ 0
var_a6 ~ 0
var_a8 ~ 0

var_b2  ~ 0
var_b4  ~ 0
var_b6 ~ 0
var_b8 ~ 0

##########variances deleted (i_var_a  ~~  i_var_a,......)

# covariances among factors
############ deleted

# variances of observed variables at each measurement (made equivalent by naming theta1)

var_a2 ~~ theta1* var_a2
var_a4 ~~ theta1* var_a4
var_a6 ~~ theta1* var_a6
var_a8 ~~ theta1* var_a8

var_b2 ~~ theta2* var_b2
var_b4 ~~ theta2* var_b4
var_b6 ~~ theta2* var_b6
