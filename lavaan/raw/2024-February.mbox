#Mediated effect (indirect path)
indirect := a1*b + a2*b + a3*b + a4*b + a5*b + a6*b + a7*b

#Total effect
total := indirect + c1 + c2 + c3 + c4 + c5 + c6 + c7
'

fit <- sem(model, data = subset, cluster = "ID")

