>   VisExec =~  zTRAILBr + ZUDSBENTC + zTRAILAr + ZUDSVERTN
>   Attn =~ ZDIGFORCT + ZDIGBACCT + extraIndicator
>   Lang =~ ZVEG + ZANIMALS + ZMINTTOTS
>   Mem =~ ZCRAFTVRS + ZCRAFTDVR + ZUDSBENTD
>   G ~~ 0*VisExec
