 bos1_2 ~ i1*1
 bos2_2 ~ i2*1
 bos3_2 ~ i3*1
 bos4_2 ~ i4*1
 bos5_2 ~ i5*1
 bos6_2 ~ i6*1

 # unique variances and covariances
 bos1_0 ~~ bos1_0
 bos2_0 ~~ bos2_0
 bos3_0 ~~ bos3_0
 bos4_0 ~~ bos4_0
 bos5_0 ~~ bos5_0
 bos6_0 ~~ bos6_0
 bos1_1 ~~ bos1_1
