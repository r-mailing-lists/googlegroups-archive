co2.model<-'

# measurement model

co2=~y1

total=~y2+y3+y4+y5+y6

struct=~y7+y8+y9+y10

tech=~y11

# regressions

co2~total+struct+tech

total~struct+tech

struct~tech

# residual covariances

y2~~y3+y4+y5+y6+y7+y8+y9+y10+y11

y3 ~~ y4+y7

y5 ~~ y7+y8+y9

y6 ~~ y7+y8+y9+y11

y7~~y8

y8~~y11

y10~~y11'

fit <- bsem(co2.model, data=x,

