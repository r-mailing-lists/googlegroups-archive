.29,  .35,  .16,  1.00, .59, .47,
.33,  .32,  .19,  .59,   1.00, .46,
.25,  .33,  .18,  .47,   .46,  1.00), nrow=6, byrow=T)

colnames(corm) <- rownames(corm)  <- c("French","English","History","Arithmetic","Algebra","Geometry")
corm

mod <-  "F1=~ French+English+History
         F2=~ Arithmetic+Algebra+Geometry"
res <- lavaan::cfa(mod, sample.cov=corm, sample.nobs=220, std.lv <http://std.lv>=T, correlation=T)
print(res)

