I do not know - sorry. However, there are still several typos in your syntax:

MGSEM_boot _fit <- sem(modmediated_lv2, data_clean, group = "provt",

                             ordered = "TRT_Ad ",

                            se = "bootstrap", bootstrap = 5000, estimator = "DWLS",

                            group.equal = "loadings")

                             verbose = TRUE)

Actually, you should not get any results at all because an object name cannot contain spaces.. The model and the bootstrap runs without problems (using simulated data):

# Some data
pop.model.g1 <- "
inter_latent =~ 1 * img1 + 1 * img2 + 1 * img3
totanxscore ~ 0.3 * inter_latent
TRT_Ad ~ 0.4 * inter_latent + 0.2 * totanxscore
"
pop.model.g2 <- "
inter_latent =~ 1 * img1 + 1 * img2 + 1 * img3
totanxscore ~ 0.3 * inter_latent
TRT_Ad ~ 0.2 * inter_latent + 0.2 * totanxscore
"
n <- c(200, 200)
data_clean <- cbind(
  provt = c(rep(1, n[1]), rep(2, n[2])),

  rbind(
    simulateData(pop.model.g1, sample.nobs = n[1], empirical = TRUE),

    simulateData(pop.model.g1, sample.nobs = n[2], empirical = TRUE)
  )
)

# Quick and dirty ....
data_clean$TRT_Ad <- sapply(data_clean$TRT_Ad, function(x, TRT_Ad) {
  if(x > median(TRT_Ad)) 1 else 0
}, data_clean$TRT_Ad)

modmediated_lv2 <- "
inter_latent =~ img1 + img2 + img3
totanxscore ~ c(a1,a2) * inter_latent
TRT_Ad ~ inter_latent + c(b1,b2) * totanxscore

a1b1 := a1 * b1

a2b2 := a2 * b2
modmed := a2 - a1
"

MGSEM_boot_fit <- sem(
  modmediated_lv2,
  data_clean,
  group = "provt",
  ordered = "TRT_Ad",
  se = "bootstrap",

  bootstrap = 50,
  estimator = "DWLS",
  group.equal = "loadings",
  verbose = TRUE
)

parameterEstimates(MGSEM_boot_fit, boot.ci.type = "bca.simple")

I would look at the grouping variable. Looks like something is wrong there.

