 INT =~ INT_1 + INT_2 + INT_3

#Regression
ATT ~  c(a, a1)*IC + c(d,d1)*PC + c(f,f1)*Stigma
INT ~ c(b,b1)*ATT + c(h,h1)*SN + c(i,i1)*PBC + c(c, c1)*IC + c(e,e1)*PC + c(g,g1)*Stigma

#Mediation Indirect effect gr1
IC_ATT_INT1 := a*i
PC_ATT_INT1 := d*i
STG_ATT_INT1 := f*i
#Mediation Indirect effect gr2
IC_ATT_INT2 := a1*i1
PC_ATT_INT2 := d1*i1
STG_ATT_INT2 := f1*i1

#Mediation total effect gr 1

IC_ATT_INT1_TOT1 := a*i + c
PC_ATT_INT1_TOT1 := d*i + e
STG_ATT_INT1_TOT1 := f*i + g

#Mediation total effect gr 2

