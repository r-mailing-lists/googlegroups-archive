PC_ATT_INT2_TOT2 := d1*i1 + e1
STG_ATT_INT2_TOT2 := f1*i1 + g1

#Moderators
mod.ATT.IC := a1 - a
mod.ATT.PC := d1 - d
mod.ATT.STG := f1 - f
mod.INT.ATT := b1 - b
mod.INT.PBC := i1-i

'

fit_SEM <- sem(Model_SEM, data = df_cleaned1,  meanstructure=T, estimator="MLR", group = "residence", group.partial = c("IC =~  Q19_3","PC =~  Q19_4 ", "PC =~  Q19_5",  "Stigma =~  Q19_7", "Stigma =~  Q19_9", "SN =~   SN_1",   "SN =~   SN_2 ", " PBC =~ PBC1_1 ", "PBC =~ PBC2_1"))

