'

fit.model1 <- lavaan(analysismodel1, data = i, int.ov.free = TRUE, estimator = "ML")
fitMeasures(fit.model1, fit.measures = c("chisq", "pvalue"))
}

out <- sapply(data.sim, fit.model1)
out

