    #regressions
    M ~ a*X1 + b*X2 + c*X3 + d*X4
    y ~ a1*X1 + b1*X2 + c1*X3 + d1*X4 + e*M + t*W+ mw*MxW

#conditional indirect effects

ae0 := a *  e              # W==0
ae1 := a * (e +   mw) # W==1
