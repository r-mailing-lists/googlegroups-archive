pmh_t3 =~ a1*pmh10_1_t3+ a2*pmh10_2_t3+ a3*pmh10_3_t3+ a4*pmh10_4_t3+  a5*pmh10_5_t3+ a6*pmh10_6_t3+ a7*pmh10_8_t3+ a8*pmh10_9_t3+a9*pmh10_10_t3
pmh10_1_t3~~pmh10_2_t3
pmh_t4 =~ a1*pmh10_1_t4+ a2*pmh10_2_t4+ a3*pmh10_3_t4+ a4*pmh10_4_t4+ a5*pmh10_5_t4+a6*pmh10_6_t4+ a7*pmh10_8_t4+ a8*pmh10_9_t4+ a9*pmh10_10_t4
