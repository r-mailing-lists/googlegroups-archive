> The imp$imputations is not the way to get imputed data. The complete

> function, instead, is used to get the imputed data in mice. See the

> following code for an example:

>

>

> model.syntax <- '

>    # intercept and slope with fixed coefficients

>      i =~ 1*t1 + 1*t2 + 1*t3 + 1*t4

>      s =~ 0*t1 + 1*t2 + 2*t3 + 3*t4

>

>    # regressions

>      i ~ x1 + x2

>      s ~ x1 + x2

> '

>

> # Note: This is used to impose missing data in the Demo.growth data

> library(simsem)

> temp <- Demo.growth

> temp[,paste0("t", 1:4)] <- imposeMissing(temp[,paste0("t", 1:4)],

> pmMCAR=0.2)

>

>

> imp <- mice(temp,m=5,print=F)

>

> imputedData <- NULL

> for(i in 1:5) {

> imputedData[[i]] <- complete(x=imp, action=i, include=FALSE)

> }

>

> out <- runMI(model.syntax, data=imputedData, fun="growth")

>

