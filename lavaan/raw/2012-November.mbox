Hi Yves,

the fitMeasures "rmsea.ci.lower.scaled" and "rmsea.ci.upper.scaled" give an error with a categorical DV and parameter constraints; this also seems to break anova() and summary(fit, fit.measures=TRUE):

library(lavaan)
n <- 300
x <- rnorm(n)
y <- rnorm(n)
z1 <- sample(0:1, n, replace=TRUE)    # binary outcome as integer
z2 <- factor(z1, ordered=TRUE)        # binary outcome as factor
df <- data.frame(x, y, z1, z2)

# Basic model: works ...
m1 <- "
z2 ~ b1*x + b2*y
"

# Constrained model: works as well ...
m2 <- "
z2 ~ b1*x + b2*y
b1==b2
"
s1 <- sem(m1, data=df, ordered="z2")
s2 <- sem(m2, data=df, ordered="z2")
summary(s1)
summary(s2)

fitMeasures(s1)
fitMeasures(s2)
fitMeasures(s2, names(fitMeasures(s1))[1:23])    # works

## This gives errors:
fitMeasures(s2, c("rmsea.ci.lower.scaled", "rmsea.ci.upper.scaled"))
summary(s2, fit.measures=TRUE)
anova(s1, s2)

Best,
Felix

