model23 <-'
# inner model regressions
z_risk_final ~ b*edad_1314 + bb*edad_1517 + c*a_sexo_kid + f*z_opport_all + s*z_skills_suma + y1*z_active_couse + z1*z_restrictive_suma
z_opport_all ~ a1*max_educ + b1*edad_1314 + bb1*edad_1517 + c2*a_sexo_kid + d1*internet_r + s1*z_skills_suma + y2*z_active_couse + z2*z_restrictive_suma
