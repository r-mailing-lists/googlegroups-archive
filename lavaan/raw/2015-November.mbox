pmlc1 ~ 0*1
pbkf2 ~ 0*1
pckf2 ~ 0*1
as4 ~ 0*1
vbs1 ~ 0*1
per4 ~ 0*1
hybr ~ 0*1
pbkf2.hybr ~ 0*1
pmlc1.hybr ~ 0*1
pckf2.hybr ~ 0*1

## estimate latent means
perf ~ NA*1
mlc ~ NA*1
bkf ~ NA*1
ckf ~ NA*1
adpt ~ NA*1
vbs ~ NA*1
per ~ NA*1
hyb ~ NA*1
