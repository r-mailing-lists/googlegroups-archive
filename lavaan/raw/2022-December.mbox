Dear all,

Sorry for reactivating this thread (and for re-posting, I had copied the wrong syntax), but I was just searching for definition variables and came across this post. From my understanding, lavaan allows for multi-group models and for specifying group-specific parameter constraints (e.g., fixing loadings to different values in different groups). I just realized that, in most cases, models with definition variables are just that: Multi-group models with some parameters being fixed to group-specific values. So, I was wondering if I could trick lavaan into setting up a latent growth curve model with subject-specific slope-loadings by making use of the multi-group implementation of lavaan. Unfortunately, lavaan throws an error because the sub-groups all have N=1 in this approach. Is it possible to override the check in lav_samplestats_from_data which resulted in the error? If I understood it correctly, this would allow for some definition variables in lavaan.

Here is my syntax which outlines the basic idea:

````
#### simulate a latent growth curve model with subject-specific times ####
set.seed(123)
library(lavaan)
#### Population parameters ####
intercept_mu <- 0
intercept_sigma <- 1
slope_mu <- .3
slope_sigma <- 1

#### data set ####
N <- 50
intercepts <- rnorm(n = N,
mean = intercept_mu,
sd = intercept_sigma)
slopes <- rnorm(n = N,
mean = slope_mu,
sd = slope_sigma)
times <- matrix(seq(0,5,1),
nrow = N,
ncol = 6,
byrow = TRUE) +
cbind(0,matrix(round(runif(n = N*5, min = -.2,max = .2),2),
nrow = N,
ncol = 5,
byrow = TRUE)) # we add some jitter to make the times person-specific

lgcData <- matrix(NA, nrow = N, ncol = ncol(times), dimnames = list(NULL, paste0("x", 0:5)))

for(i in 1:N){
lgcData[i,] <- intercepts[i] + times[i,]* slopes[i] + rnorm(ncol(lgcData),0,.3)
}
lgcData <- as.data.frame(lgcData)
lgcData$id <- 1:nrow(lgcData)

#### Setting up the multi-group model ####

model <- paste0(
"
int =~ 1*x0 + 1*x1 + 1*x2 + 1*x3 + 1*x4 + 1*x5
slope =~ c(", paste0(times[,1], collapse = ",") ,")*x0 +
c(", paste0(times[,2], collapse = ",") ,")*x1 +
c(", paste0(times[,3], collapse = ",") ,")*x2 +
c(", paste0(times[,4], collapse = ",") ,")*x3 +
c(", paste0(times[,5], collapse = ",") ,")*x4 +
c(", paste0(times[,6], collapse = ",") ,")*x5
int ~ c(", paste0(rep("intMean", nrow(times)), collapse = ",") ,")*1
slope ~ c(", paste0(rep("slopeMean", nrow(times)), collapse = ",") ,")*1
int ~~ c(", paste0(rep("intVar", nrow(times)), collapse = ",") ,")*int + c(", paste0(rep("0", nrow(times)), collapse = ",") ,")*slope
slope ~~ c(", paste0(rep("slopeVar", nrow(times)), collapse = ",") ,")*slope

x0 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x0
x1 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x1
x2 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x2
x3 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x3
x4 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x4
x5 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x5

x0 ~ 0*1
x1 ~ 0*1
x2 ~ 0*1
x3 ~ 0*1
x4 ~ 0*1
x5 ~ 0*1
"
)

# inspect model:
cat(model)

#### Fit model ####
# Note: this results in an error because there is only one subject
# in each sub-model
fit <- lavaan(model = model,
data = lgcData,
group = "id",
missing = "ml")
summary(fit)

#### Same example, but using only two groups: ####
# The following demonstrates the idea with a working model
#### data set ####
times <- matrix(seq(0,5,1),
nrow = 2,
ncol = 6,
byrow = TRUE) +
cbind(0,matrix(round(runif(n = 2*5, min = -.2,max = .2),2),
nrow = 2,
ncol = 5,
byrow = TRUE)) # we add some jitter to make the times person-specific

lgcData <- matrix(NA,
nrow = N,
ncol = ncol(times),
dimnames = list(NULL, paste0("x", 0:5)))

groups <- sample(1:2, N, replace = TRUE)

for(i in 1:N){
lgcData[i,] <- intercepts[i] + times[groups[i],] * slopes[i] + rnorm(ncol(times),0,.3)
}
lgcData <- as.data.frame(lgcData)
lgcData$group <- groups

#### Setting up the multi-group model ####

model <- paste0(
"
int =~ 1*x0 + 1*x1 + 1*x2 + 1*x3 + 1*x4 + 1*x5
slope =~ c(", paste0(times[,1], collapse = ",") ,")*x0 +
c(", paste0(times[,2], collapse = ",") ,")*x1 +
c(", paste0(times[,3], collapse = ",") ,")*x2 +
c(", paste0(times[,4], collapse = ",") ,")*x3 +
c(", paste0(times[,5], collapse = ",") ,")*x4 +
c(", paste0(times[,6], collapse = ",") ,")*x5
int ~ c(", paste0(rep("intMean", nrow(times)), collapse = ",") ,")*1
slope ~ c(", paste0(rep("slopeMean", nrow(times)), collapse = ",") ,")*1
int ~~ c(", paste0(rep("intVar", nrow(times)), collapse = ",") ,")*int + c(", paste0(rep("0", nrow(times)), collapse = ",") ,")*slope
slope ~~ c(", paste0(rep("slopeVar", nrow(times)), collapse = ",") ,")*slope

x0 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x0
x1 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x1
x2 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x2
x3 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x3
x4 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x4
x5 ~~ c(", paste0(rep("v", nrow(times)), collapse = ",") ,")*x5

x0 ~ 0*1
x1 ~ 0*1
x2 ~ 0*1
x3 ~ 0*1
x4 ~ 0*1
x5 ~ 0*1
"
)

# inspect model:
cat(model)

#### Fit model ####
fit <- lavaan(model = model,
data = lgcData,
group = "group",
missing = "ml")
coef(fit)
````
Best,
Jannik

