model3.2formative <- '
# measurement model

pfinstress =~ pa20 + pa58
pfinstress ~ 1*pa56 + pa57c + pa57d + pa57f

w1cohesion =~ NA*cohesion1 + cohesion2 + cohesion3 + cohesion4
w1alc =~ NA*h1to15 + h1to16 + h1to17 + h1to18
w3alc =~ w3alc1 + w3alc2 + w3ex1 + w3ex2
w4alc =~ w4alc1 + w4alc2 + w4ex1 + w4ex2

w3fin =~ h3gh1 + h3gh10

w3fin ~ 1*w3strain + w3access + w3income

w4fin =~ h4gh1 + h4gh2
w4fin ~ 1*w4strain + w4ladder + w4income
w3parenting =~ w3m_enjoy + w3m_warm + w3m_close
pa61_lat =~ pa61
pa62_lat =~ pa62
age1_lat =~ age1
h3mr3_a_lat =~ h3mr3_a
h3lm7_lat =~ h3lm7
age3_lat =~ age3
h4lm11_lat =~ h4lm11
age4_lat =~ age4
# regressions
w3parenting ~ w1cohesion + pfinstress
w3alc ~ w1alc + w1cohesion + pfinstress
w3fin ~ pfinstress + w1alc
w4alc ~ w3alc + w3fin + w3parenting
w4fin ~ w3alc + w3fin + w3parenting
# residual correlations
w3strain ~~ w4strain
w3income ~~ w4income
h1to15 ~~ w3alc1
w3alc1 ~~ w4alc1
h1to16 ~~ w3alc2
w3alc2 ~~ w4alc2
h1to17 ~~ w3ex1
w3ex1 ~~ w4ex1
h1to18 ~~ w3ex2
w3ex2 ~~ w4ex2
w1alc ~~ pfinstress + w1cohesion + pa61_lat + pa62_lat + age1_lat
pfinstress ~~ w1cohesion + pa61_lat + pa62_lat
w3alc ~~ w3fin + h3mr3_a_lat + h3lm7_lat + age3_lat
w3fin ~~ h3mr3_a_lat + h3lm7_lat + age3_lat
w3parenting ~~ w3fin + w3alc + h3mr3_a_lat + h3lm7_lat + age3_lat
w4alc ~~ w4fin + h4lm11_lat + age4_lat
w4fin ~~ h4lm11_lat + age4_lat
w1alc ~~ 1*w1alc
w1cohesion ~~ 1*w1cohesion

pfinstress ~~ 0*pfinstress
w3fin ~~ 0*w3fin
w4fin ~~ 0*w4fin
'

