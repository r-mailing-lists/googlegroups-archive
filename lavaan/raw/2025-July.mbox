#>     x3                0.699    0.162    4.330    0.000
#>     x4                0.323    0.150    2.152    0.031
#>   f2 =~
#>     x5                0.510    0.141    3.607    0.000
#>     x6                0.524    0.146    3.587    0.000
#>     x7                0.528    0.147    3.601    0.000
#>     x8                0.425    0.132    3.217    0.001
#>   f3 =~
#>     x9                0.929    0.137    6.773    0.000
