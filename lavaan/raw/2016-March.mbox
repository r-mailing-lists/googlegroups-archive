GShpVal =~ G_BrdShpVl_1 + G_BrdShpVl_2 + G_BrdShpVl_3 + G_BrdShpVl_4 + G_BrdShpVl_5
GAtt =~ G_Att_1 + G_Att_2 + G_Att_3
GPI  =~ G_PI_1 + G_PI_2 + G_PI_3
#regressions
GBrandEq ~ d*GShpVal
GAtt ~ e*GShpVal
GPI ~ f*GShpVal
GShpVal ~ c*COMPQUAL
COMPQUAL ~ a*COSO
GBrandEq ~ CMB
GAtt ~ CMB
GPI ~ CMB
GBrandEq ~ Product
GAtt~Product
GPI ~ Product
ind1 := a*c
ind2 := c*d
ind3 := a*c*d
ind4 := c*e
ind5 := a*c*e
ind6 := c*f
ind7 := a*c*f'

