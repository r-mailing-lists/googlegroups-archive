           elt_erwart ~~ z_gut_bez_job + z_prestige_job +                   z_intress_job + z_arblos + z_zielwissen
               z_freunde ~~ elt_erwart
               '
> model_fit <- sem(data = sato_daten, model = strukturmodell, mimic = "Mplus", ordered = c("intention", "wberuf_kat", "zeitpräf", "elt_erwart"), estimator = "WLSMV")

summary(model_fit, fit.measures = TRUE, rsquare = TRUE, standardized = TRUE)

