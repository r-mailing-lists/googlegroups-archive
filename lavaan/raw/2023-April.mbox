           z_zielwissen ~ hisei_10 + gewiss + extra + vertrag +             offen + neuro + z_abinote_uv

           wberuf_kat ~ hisei_10 + gewiss + extra + vertrag +               offen + neuro + z_zielwissen

           zeitpräf ~ hisei_10 + gewiss + extra + vertrag +                 offen + neuro

           z_freunde ~ hisei_10

           elt_erwart ~ hisei_10 + migration

           # Kovarianzen
