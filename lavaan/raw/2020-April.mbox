    T3_PERMA_2 ~ nu.p2*1

    T4_PERMA_11 ~ 0*1

    T4_PERMA_13 ~ nu.p13*1

    T4_PERMA_2 ~ nu.p2*1

# first-order factor means (first-order factor means set to 0)

    mean1 ~ 0*1

    mean2 ~ 0*1

    mean3 ~ 0*1

    mean4 ~ 0*1

# second-order growth factors

    mean.b0 =~ 1*mean1 + 1*mean2 + 1*mean3 + 1*mean4

    mean.b1 =~ 0*mean1 + mean2 + mean3 + 1*mean4

# second-order factor means and variances (no constraints)

    mean.b0 ~ start(7.7)*1

    mean.b1 ~ 1

    mean.b0 ~~ mean.b0

    mean.b1 ~~ mean.b1

# first- and second-order factors covariation (all fixed to 0)

    mean1 ~~ 0*mean2

    mean1 ~~ 0*mean3

    mean1 ~~ 0*mean4

    mean2 ~~ 0*mean3

    mean2 ~~ 0*mean4

    mean3 ~~ 0*mean4

    mean.b0 ~~ 0*mean1 + 0*mean2 + 0*mean3 + 0*mean4

    mean.b1 ~~ 0*mean1 + 0*mean2 + 0*mean3 + 0*mean4

# UNIDIMENSIONAL FACTOR, “REL”

    rel1 =~ 1 * T1_EPOCH_10 +

            lambda.ep1 * T1_EPOCH_1 +

            lambda.ep14 * T1_EPOCH_14 +

            lambda.ep16 * T1_EPOCH_16

    rel2 =~ 1 * T2_EPOCH_10 +

            lambda.ep1 * T2_EPOCH_1 +

            lambda.ep14 * T2_EPOCH_14 +

            lambda.ep16 * T2_EPOCH_16

    rel3 =~ 1 * T3_EPOCH_10 +

            lambda.ep1 * T3_EPOCH_1 +

            lambda.ep14 * T3_EPOCH_14 +

            lambda.ep16 * T3_EPOCH_16

    rel4 =~ 1 * T4_EPOCH_10 +

            lambda.ep1 * T4_EPOCH_1 +

            lambda.ep14 * T4_EPOCH_14 +

            lambda.ep16 * T4_EPOCH_16

# first-order factor variances (equality constraints, named psi)

    rel1 ~~ psi.rel*rel1

    rel2 ~~ psi.rel*rel2

    rel3 ~~ psi.rel*rel3

    rel4 ~~ psi.rel*rel4

# item residual variances (constrained to equality across time)

    T1_EPOCH_1 ~~ theta.ep1 * T1_EPOCH_1

    T1_EPOCH_10 ~~ theta.ep10 * T1_EPOCH_10

    T1_EPOCH_14 ~~ theta.ep14 * T1_EPOCH_14

    T1_EPOCH_16 ~~ theta.ep16 * T1_EPOCH_16

    T2_EPOCH_1 ~~ theta.ep1 * T2_EPOCH_1

    T2_EPOCH_10 ~~ theta.ep10 * T2_EPOCH_10

    T2_EPOCH_14 ~~ theta.ep14 * T2_EPOCH_14

    T2_EPOCH_16 ~~ theta.ep16 * T2_EPOCH_16

    T3_EPOCH_1 ~~ theta.ep1 * T3_EPOCH_1

    T3_EPOCH_10 ~~ theta.ep10 * T3_EPOCH_10

    T3_EPOCH_14 ~~ theta.ep14 * T3_EPOCH_14

    T3_EPOCH_16 ~~ theta.ep16 * T3_EPOCH_16

    T4_EPOCH_1 ~~ theta.ep1 * T4_EPOCH_1

    T4_EPOCH_10 ~~ theta.ep10 * T4_EPOCH_10

    T4_EPOCH_14 ~~ theta.ep14 * T4_EPOCH_14

    T4_EPOCH_16 ~~ theta.ep16 * T4_EPOCH_16

# item residual covariances (all fixed to 0)

    T1_EPOCH_10 ~~ 0*T2_EPOCH_10 + 0*T3_EPOCH_10 + 0*T4_EPOCH_10

    T2_EPOCH_10 ~~ 0*T3_EPOCH_10 + 0*T4_EPOCH_10

    T3_EPOCH_10 ~~ 0*T4_EPOCH_10

    T1_EPOCH_1 ~~ 0*T2_EPOCH_1 + 0*T3_EPOCH_1 + 0*T4_EPOCH_1

    T2_EPOCH_1 ~~ 0*T3_EPOCH_1 + 0*T4_EPOCH_1

    T3_EPOCH_1 ~~ 0*T4_EPOCH_1

    T1_EPOCH_14 ~~ 0*T2_EPOCH_14 + 0*T3_EPOCH_14 + 0*T4_EPOCH_14

    T2_EPOCH_14 ~~ 0*T3_EPOCH_14 + 0*T4_EPOCH_14

    T3_EPOCH_14 ~~ 0*T4_EPOCH_14

    T1_EPOCH_16 ~~ 0*T2_EPOCH_16 + 0*T3_EPOCH_16 + 0*T4_EPOCH_16

    T2_EPOCH_16 ~~ 0*T3_EPOCH_16 + 0*T4_EPOCH_16

    T3_EPOCH_16 ~~ 0*T4_EPOCH_16

# item intercepts (first item intercept fixed to 0, remaining item intercepts constrained to equality)

    T1_EPOCH_10 ~ 0*1

    T1_EPOCH_1 ~ nu.e1*1

    T1_EPOCH_14 ~ nu.e14*1

    T1_EPOCH_16 ~ nu.e16*1

    T2_EPOCH_10 ~ 0*1

    T2_EPOCH_1 ~ nu.e1*1

    T2_EPOCH_14 ~ nu.e14*1

    T2_EPOCH_16 ~ nu.e16*1

    T3_EPOCH_10 ~ 0*1

    T3_EPOCH_1 ~ nu.e1*1

    T3_EPOCH_14 ~ nu.e14*1

    T3_EPOCH_16 ~ nu.e16*1

    T4_EPOCH_10 ~ 0*1

    T4_EPOCH_1 ~ nu.e1*1

    T4_EPOCH_14 ~ nu.e14*1

    T4_EPOCH_16 ~ nu.e16*1

# first-order factor means (first-order factor means set to 0)

    rel1 ~ 0*1

    rel2 ~ 0*1

    rel3 ~ 0*1

    rel4 ~ 0*1

# second-order growth factors

    rel.b0 =~ 1*rel1 + 1*rel2 + 1*rel3 + 1*rel4

    rel.b1 =~ 0*rel1 + rel2 + rel3 + 1*rel4

# second-order factor means and variances (no constraints)

    rel.b0 ~ start(7.52)*1

    rel.b1 ~ 1

    rel.b0 ~~ rel.b0

    rel.b1 ~~ rel.b1

# first- and second-order factors covariation (all fixed to 0)

    rel1 ~~ 0*rel2

    rel1 ~~ 0*rel3

    rel1 ~~ 0*rel4

    rel2 ~~ 0*rel3

    rel2 ~~ 0*rel4

    rel3 ~~ 0*rel4

    rel.b0 ~~ 0*rel1 + 0*rel2 + 0*rel3 + 0*rel4

    rel.b1 ~~ 0*rel1 + 0*rel2 + 0*rel3 + 0*rel4

# correlate slopes

top.b1 ~~ rel.b1

top.b1 ~~ mean.b1

# correlate intercepts

top.b0 ~~ rel.b0

top.b0 ~~ mean.b0

