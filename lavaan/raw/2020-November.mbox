PScum.score.12 ~ a2*LnF.income.6  +  b2*Age.months.6  + c2*Breastfed.6  + d2*ChildHealth.6  + e2*FS.score.6  + f2*MotherHealth.6  + g2*PScum.score.6  + h2*Stunted.6  +
                                   k2*zha.12 + j2*LnPCExp.6
PScum.score.24 ~ a2*LnF.income.18 +  b2*Age.months.18 + c2*Breastfed.18 + d2*ChildHealth.18 + e2*FS.score.18 + f2*MotherHealth.18 + g2*PScum.score.18 + h2*Stunted.18 +
                                   k2*zha.24 + j2*LnPCExp.18

# Pre-determined variables

PScum.score.12 ~~ ChildHealth.18 + MotherHealth.18 + PScum.score.18

# FISHING INCOME TO COMMUNICATION CONTROLLING FOR ZHA

# Regressions

COMcum.score.12 ~ a3*LnF.income.6  +  b3*Age.months.6  + c3*Breastfed.6  + d3*ChildHealth.6  + e3*FS.score.6  + f3*MotherHealth.6  + g3*COMcum.score.6  + h3*Stunted.6  +
                                      k3*zha.12 + j3*LnPCExp.6
