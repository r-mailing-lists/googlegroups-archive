 y = matrix(0,nobs,3)  #Null matrix

 for (k in 1:m){

  #first outcome for each subject
  ui1=exp(mu[k])/(1+exp(mu[k]))
  y[nn[k],1]=rbinom(1,1,ui1)

  #first time point for each subject
  y[nn[k],2] = rexp(1)

  for (j in 2:ndesign[k]){
   #one step prior outcome
   yjmin1 = y[nn[k] - 1 + j - 1,1]

   #current time point
