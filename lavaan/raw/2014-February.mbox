       y[nn[k],3]=k
    y[nn[k]-1+j,3]=k
     }
 }

 colnames(y)=c('outcome','time','subject')

###########################################################
###          Log-Likelihood Function                    ###
###########################################################
ff1 = rep(0,m);ff2 = rep(0,m); #null data

 hdev<- function(parm){
  for (k in 1:m){
   #first outcome for each subject
   ui1 = exp((xmatrix %*% as.vector(t(parm[2:8])))[k])/
   (1+exp((xmatrix %*% as.vector(t(parm[2:8])))[k]))
   ff1[k]=y[nn[k],1]*log(ui1/(1-ui1))+log(1-ui1)
