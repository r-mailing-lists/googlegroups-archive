    contrasts = list(fact1 = "contr.sum", fact2='contr.sum'))

 #generate design matrix for cont vars with bivariate normal
 cov = matrix(c(1,0.5,0.5,1),p) #correlation between two conts
 rcov = sqrt(cov)

 #create two bivariate normal vars
 e = rcov %*% matrix(rnorm(p * m),p,m)
 e = t(e)

 #theta is multiplied to calculate relation between cat vars
