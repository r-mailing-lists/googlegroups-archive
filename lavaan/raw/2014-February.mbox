################################################################

 if (num == 1) n1 = 10
 if (num == 1) n2 = 10
 if (num == 2) n1 = 5
 if (num == 2) n2 = 3
 if (num == 3) n1 = 10
 if (num == 3) n2 = 5
 if (num == 4) n1 = 20
 if (num == 4) n2 = 6

 ndesign = matrix(c(rep(n1,m/2),rep(n2,m/2)),byrow=T)
