   #current outcome from bernoulli
   uij=exp(mu[k]+tj * parm[10]+yjmin1 * parm[9])/
    (1+exp(mu[k]+tj * parm[10]+yjmin1 * parm[9]))
   y[nn[k] - 1 + j,1]=rbinom(1,1,as.numeric(uij))
   } # j loops
 } # k loops

 for (k in 1:m){
