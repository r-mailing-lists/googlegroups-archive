              Internal =~     MHLCIntA2 + MHLCIntA4 + MHLCIntA5 + MHLCIntA6 +
                              MHLCIntB2 + MHLCIntB4 + MHLCIntB6 +

                              RSHLOCAct4+ RSHLOCAct5 + RSHLOCAct6

              PowOth =~       MHLCPowOthA1 +

                              MHLCPowOthB4 + MHLCPowOthB6

      #Covarying Factors
        General ~~  0*Religiousness + 0*GeneralGHLC + 0*Active + 0*Passive + 0*Internal + 0*PowOth
        Religiousness~~0*GeneralGHLC + 0*Active + 0*Passive + 0*Internal + 0*PowOth + 0*Internal + 0*PowOth

        GeneralGHLC~~ 0*Active + 0*Passive+ 0*Internal + 0*PowOth

        Active ~~ Passive + 0*Internal + 0*PowOth
        Passive ~~ 0*Internal + 0*PowOth
        Internal ~~ PowOth
  '

    fitFFRGHLCMHLC7 <- runMI(modelFFRGHLCMHLC7, impcallist, fun = 'lavaan',

                             ordered = c("FFRBel1", "FFRBel3",
                                         "FFRSupBel1", "FFRSupBel2", "FFRSupBel3", "FFRSupBel4",
                                         "FFRRelPrac1", "FFRRelPrac2", "FFRRelPrac3",
                                         "FFRRelForm1", "FFRRelForm2", "FFRRelForm3",
                                         "GHControl1", "GHControl2", "GHControl3", "GHControl4", "GHControl5", "GHControl6",
                                         "MHLCGod1", "MHLCGod2", "MHLCGod3", "MHLCGod4", "MHLCGod5", "MHLCGod6",
                                         "RSHLOCAct1", "RSHLOCAct2", "RSHLOCAct3", "RSHLOCAct4", "RSHLOCAct5", "RSHLOCAct6", "RSHLOCAct7", "RSHLOCAct8", "RSHLOCAct9", "RSHLOCAct10", "RSHLOCAct11",
                                         "RSHLOCPas1", "RSHLOCPas2", "RSHLOCPas3", "RSHLOCPas4", "RSHLOCPas5", "RSHLOCPas6", "RSHLOCPas7", "RSHLOCPas8", "RSHLOCPas9", "RSHLOCPas10", "RSHLOCPas11", "RSHLOCPas12", "RSHLOCPas13",
                                         "MHLCIntA1","MHLCIntA2","MHLCIntA3","MHLCIntA4","MHLCIntA5","MHLCIntA6",
                                         "MHLCIntB1","MHLCIntB2","MHLCIntB3","MHLCIntB4","MHLCIntB5","MHLCIntB6",
                                         "MHLCPowOthA1","MHLCPowOthA2","MHLCPowOthA3","MHLCPowOthA4","MHLCPowOthA5","MHLCPowOthA6",
                                         "MHLCPowOthB1","MHLCPowOthB2","MHLCPowOthB3","MHLCPowOthB4","MHLCPowOthB5","MHLCPowOthB6"),
                             effect.coding = TRUE, auto.fix.first = FALSE, auto.fix.single = TRUE,
                             auto.var = TRUE, auto.cov.lv.x = TRUE, auto.cov.y = TRUE, auto.th <http://auto.th> = TRUE,
                             auto.delta = TRUE, warn = TRUE, optim.method = "BFGS", parallel = "snow", ncpus = 9)

    summary(fitFFRGHLCMHLC7)
    fitmeasures(fitFFRGHLCMHLC7, c("chisq.scaled", "df.scaled", "pvalue.scaled", "cfi", "tli", "rmsea", "rmsea.ci.lower", "rmsea.ci.upper", "rmsea.pvalue", "srmr"))

