# 9  9   y ~1        0     1    0     NA   1         .p9. 0.956  0.956 0.000

But, if you set the model in this way it works.

my.mod <- '
z ~ x + y
x ~~ 0*y
x ~1*1
y ~1*1
x ~~ 1*x
y ~~ 1*y
'
