))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L4:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*4
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L5:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*5
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L6:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*6
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L7:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*7
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L8:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*8
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L9:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*9
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L10:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*10
))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
