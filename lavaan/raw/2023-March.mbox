))/(1+(((ns/n0)-1)/((ns/n0)*(astar/a)+1))*exp(-(a+astar)*1));
L14:=ns*(1-(((((ns/n0)-1)/((ns/n0)*(astar/a)+1))*astar)/a)*exp(-(a+astar)*14
