M ~ a*X
Y ~ b*M + X

M ~~ M
Y ~~ Y

i := a* b
"

simOutput_1 <- sim(
  nRep = 100,
  model = fitModel,
  n = 50, generate = simModel,
  lavaanfun = "lavaan",
  se = "standard"
