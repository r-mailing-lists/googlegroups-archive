Sheila,
Is this what you want?

RC.mod.sim <- '
x11~~1*x11
x12~~1*x12
x13~~1*x13
x21~~1*x21
x22~~1*x22
x23~~1*x23
y1~~.5*y1
y2~~.5*y2
y3~~.5*y3
y1~1*x11+1*x12+1*x13
y2~1*x21+1*x22+1*x23+1*y1
y3~1*y1+1*y2
y1~~.25*y2
y2~~.25*y3
y1~~.25*y3'

RC.mod.est <- '
y1~~y1
y2~~y2
y3~~y3
y1~x11+x12+x13
y2~x21+x22+x23+y1
y3~y1+y2
y1~~y2
y2~~y3
y1~~y3'

RC.df <- simulateData(model=RC.mod.sim)
RC.fit <- lavaan(model=RC.mod.est, data=RC.df)
inspect(RC.fit, 'free')
summary(RC.fit)

Keith
