Higher.Order <- ' Lower.Order.1=~ Item_1 + Item_2 + Item_3 + Item_4
                            Lower.Order.2=~ Item_5 + Item_6 + Item_7 + Item_8

                           Higher.Order =~ V2*Lower.Order.1 + V2*Lower.Order.2

    ## Constrain Variance
                          Higher.Order ~~ 1*Higher.Order
'

Cheers,

Conal

