Rico,
The issue appears to be sample specific.  Your model ran as expected for me using simulated data.  Perhaps the parameter estimate covariance matrix would shed some light?

lavInspect(fit, what='vcov')

Here is my test run:

require(lavaan)

simMod <- '
G =~ .4*i1 + .4*i2 + .4*i3 + .4*i4 + .4*i5 + .4*i6 + .4*i7 + .4*i8 + .4*i9 + .4*i10 + .4*i11 + .4*i12 + .4*i13 +
.4*i14
S1 =~ .4*i1 + .4*i2 + .4*i3 + .4*i4 + .4*i5 + .4*i6 + .4*i7
S2 =~ .4*i8 + .4*i9 + .4*i10 + .4*i11 + .4*i12 + .4*i13 + .4*i14
G ~~ 1*G
S1 ~~ 1*S1
S2 ~~ 1*S2
'

myDat <- simulateData(simMod, sample.nobs=1000)
myBreaks <- c(-Inf, -1, 0, 1, Inf)
myDatCat <- apply(X=myDat, MARGIN=2, FUN=findInterval, vec=myBreaks)
summary(myDatCat)

mod <- '
G =~ i1 + i2 + i3 + i4 + i5 + i6 + i7 + i8 + i9 + i10 + i11 + i12 + i13 +
i14
S1 =~ i1 + i2 + i3 + i4 + i5 + i6 + i7
S2 =~ i8 + i9 + i10 + i11 + i12 + i13 + i14
'

fit <- cfa(model=mod, data=myDatCat,

ordered=names(data),
estimator="WLSMV",
parameterization='theta',
se="robust.sem",
std.lv=T,
orthogonal=T
)

summary(fit)

