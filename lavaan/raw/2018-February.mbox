Hello all,

I'm trying to do multigroup SEM with lavaan to find measurement invariance group but I'm having trouble. I have script data
#Data grup dengan parameter sama
sdd<-round(runif(1,1200,2500))
set.seed(sdd)
modeldata <- '
X =~ 1.2*x1 + 1.5*x2+1.1*x3+7*x4
Y =~ 1.5*y1 + 5*y2 +1.3*y3+1.2*y4
Z =~ 0.9*z1 + 0.8*z2 + 0.85*z3+1.6*z4

Z ~ 0.65*X +0.75*Y
Y~ 0.8*X
'

# Membangkitkan Data
sdd<-round(runif(1,1200,2500))
set.seed(sdd)
data<-simulateData(modeldata, sample.nobs=250)
GrupA<-rep(c("G1","G2"),each=125)
dataset1<-cbind(GrupA,data)

#Analisis Data
fit.model <- '
  X =~ x1 + x2 + x3 + x4
  Y =~ y1 + y2 + y3 + y4
  Z =~ z1 + z2 + z3 + z4

  Z ~ X + Y
  Y ~ X
  '

#Analisis SEM dengan Metode Maximum Likelihod (ML)
fit1<-sem(model=fit.model,data=dataset1)
summary(fit1,estimate=TRUE,fit.measures=TRUE,standardized=TRUE)

##invariance GRUP A
sdd<-round(runif(1,1200,2500))
set.seed(sdd)
fit1 <- cfa(fit.model,
           data = dataset1,
           group = "GrupA",
     group.equal = "loadings")
summary(fit1)
measurementInvariance(fit.model,data = dataset1, strict=FALSE,group = "GrupA", method = "satorra.bentler.2001")

