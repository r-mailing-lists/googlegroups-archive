Ah... it was just the manner of specification that didn't lead to a nonidentification warning!

Compare these two:

> require(lavaan)
>
>
>
> cmat <- matrix(scan(),5,5)
>
>  1.00 0.49 0.28 0.56 0.21
>
>  0.49 1.00 0.28 0.56 0.14
>
>  0.28 0.28 1.00 0.32 0.03
>
>  0.56 0.56 0.32 1.00 0.16
>
>  0.21 0.14 0.03 0.16 1.00
>
>
>
> colnames(cmat)<-c("y1","y2","y3","y4","x")
>
>
>
> mymodel1<-'
>
>           f1 =~ y1+y2+y3+y4
>
>           f1 ~ x
>
>           y1+y2+y3+y4 ~ x
>
>           '
>
>
>
> lavaan(mymodel1,sample.cov=cmat,sample.nobs=500,auto.fix.first=TRUE,auto.var=TRUE)
>
>
>
> mymodel2<-'
>
>           f1 =~ l1*y1+y2+y3+y4
>
>           f1 ~ x
>
>           y1+y2+y3+y4 ~ x
>
>
>
>           l1 == 1
>
>           '
>
>
>
> lavaan(mymodel2,sample.cov=cmat,sample.nobs=500,auto.fix.first=FALSE,auto.var=TRUE)
>
>
>
>

