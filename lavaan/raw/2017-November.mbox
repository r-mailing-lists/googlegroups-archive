Kai,
For what it is worth, the surprising (to us anyway) behavior appears to be localized to the auto.var = TRUE parameter.  If you do that the inconvenient way, then the surprising behavior does not occur.  Model 1 and 3 are now the same and differ from Model 2, and all three produce the same independence model.

HS_model_vars_regr <- '

  visual =~ x1 + x2 + x3
  textual =~ x4 + x5 + x6
  visual ~ x8 + x9

  x1 ~~ x1
  x2 ~~ x2
  x3 ~~ x3
  x4 ~~ x4
  x5 ~~ x5
  x6 ~~ x6
  x8 ~~ x8
  x9 ~~ x9

  visual ~~ visual
  textual ~~ textual
'

HS_model_vars_regr_cov <- '

  visual  =~ x1 + x2 + x3
  textual =~ x4 + x5 + x6
  visual ~ x8 + x9
  x8 ~~ x9

  x1 ~~ x1
  x2 ~~ x2
  x3 ~~ x3
  x4 ~~ x4
  x5 ~~ x5
  x6 ~~ x6
  x8 ~~ x8
  x9 ~~ x9

  visual ~~ visual
  textual ~~ textual
'

HS_model_vars_regr_nocov <- '

  visual  =~ x1 + x2 + x3
  textual =~ x4 + x5 + x6
  visual ~ x8 + x9
  x8 ~~ 0*x9

  x1 ~~ x1
  x2 ~~ x2
  x3 ~~ x3
  x4 ~~ x4
  x5 ~~ x5
  x6 ~~ x6
  x8 ~~ x8
  x9 ~~ x9

  visual ~~ visual
  textual ~~ textual
'

fitlav_vars_regr <- lavaan(HS_model_vars_regr, data=HolzingerSwineford1939, fixed.x=FALSE, auto.fix.first = TRUE)
fitlav_vars_regr_cov <- lavaan(HS_model_vars_regr_cov, data=HolzingerSwineford1939, fixed.x=FALSE, auto.fix.first = TRUE)
fitlav_vars_regr_nocov <- lavaan(HS_model_vars_regr_nocov, data=HolzingerSwineford1939, fixed.x=FALSE, auto.fix.first = TRUE)

lavInspect(fitlav_vars_regr, what='free')$psi
lavInspect(fitlav_vars_regr_cov, what='free')$psi
lavInspect(fitlav_vars_regr_nocov, what='free')$psi

as.data.frame(lav_partable_independence(fitlav_vars_regr))
as.data.frame(lav_partable_independence(fitlav_vars_regr_cov))
as.data.frame(lav_partable_independence(fitlav_vars_regr_nocov))

fitMeasures(fitlav_vars_regr, fit.measures=c('chisq', 'df'))
fitMeasures(fitlav_vars_regr_cov, fit.measures=c('chisq', 'df'))
fitMeasures(fitlav_vars_regr_nocov, fit.measures=c('chisq', 'df'))

