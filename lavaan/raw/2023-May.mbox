> > > > > #> 5 -1.0080350  0.79803321  0.02724673
> > > > > #> 6 -2.1795875 -0.10557664 -0.60519642
> > > > > mod <-
> > > > > "
> > > > > x =~ x1 + x2 + x3
> > > > > m =~ x4 + x5 + x6
> > > > > y =~ x7 + x8 + x9
