> > > > > n <- 10000
> > > > > set.seed(8570614)
> > > > > x <- rnorm(n)
> > > > > m <- .3 * x + sqrt(1 - .3^2) * rnorm(n)
> > > > > y <- .4 * m + sqrt(1 - .4^2) * rnorm(n)
> > > > > es <- MASS::mvrnorm(n, rep(0, 9), diag(9))
> > > > > tmp1 <- rep(.8, 3)
> > > > > tmp2 <- rep(0, 3)
