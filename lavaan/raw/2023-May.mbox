> > fy <- .5 * fx + .4 * x1 + rnorm(n, 0, sqrt(1 - .5^2 - .4^2))
> > fy1 <- .7 * fy + rnorm(n, 0, .51)
> > fy2 <- .7 * fy + rnorm(n, 0, .51)
> > fy3 <- .7 * fy + rnorm(n, 0, .51)
