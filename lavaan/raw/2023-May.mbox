         cSS2ss := cp + c3 * 2
         cSS1 := cp + c1c3 * 1
         cSS2 := cp + c1c3 * 2

         # indirect and total effects

         a1b1 := a1 * b1
         total := cp + a1b1'

# With bootstrapping

