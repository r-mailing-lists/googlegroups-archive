The sample code is as follows:

library(car)

IndependentVariableA <- data.frame(Mydata[c("Item1", "Item2" , "Item3" , "Item4")])
IndependentVariableB <- data.frame(Mydata[c("Item5" , "Item6" , "Item7")])
IndependentVariableC <- data.frame(Mydata[c("Item8" , "Item9" , "Item10")])

