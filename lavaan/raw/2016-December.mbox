mod1 = "f =~  I1 +I2+ I4 +I6 +I9+ I11+ I12+ I3+ I5+ I7+ I8+ I14"
mod2 = "f1 =~ I1 +I2 +I4+ I6+ I9+ I11 +I12; f2 =~ I3 +I5+ I7+ I8+ I14"
