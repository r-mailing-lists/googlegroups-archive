f1.alternative = sem(mod1.alternative, data=mysample, ordered=colnames(mysample), std.lv <http://std.lv>=T)

lavTestLRT(f1.alternative, f2)
lavTestLRT(f1.alternative, f2, method="satorra.bentler.2010")

