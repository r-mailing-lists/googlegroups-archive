> Beta <- PT$est[PT$lhs == "synchrony" & PT$op == "~"]

> Beta <- c(PT$est[PT$lhs == "synchrony" & PT$op == "~1"], Beta)
> data$pred.sync <- cbind(1, as.matrix(data[xNames])) %*% Beta # predicted values

