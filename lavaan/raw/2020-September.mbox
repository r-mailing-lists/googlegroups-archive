> > dx =~ 1*x_2
> > x_2 ~ 0*1
> > x_2 ~~ 0*x_2
> >
> > dx ~ c(c_p,c_s,c_r)*1
> > x_1 ~ c(i_p,i_s,i_r)*1
> > dx ~~ dx
> > x_1 ~~ x_1
> > dx ~ x_1
> > '
> >
