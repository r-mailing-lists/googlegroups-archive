Hi Everyone,

I a social scientist using a large dataset, trying to apply a weight variable called "W1PARENT" (that I did not make) to all of the variables in my model. I am trying to do a similar command as  the SPSS command WEIGHT BY [weight].

I am trying to use the lavaan.survey package to apply my weight variable, as per this website: https://statistics.ohlsen-web.de/sem-with-lavaan/

When I run the code below, it gives me the error : Error in eval(parse(text = sprintf("%s == '%s'", lavInspect(lavaan.fit,  :  object 'X1SEX' not found

I'm assuming this has something to do with my group analysis.

However, even when I take the group analysis out, it gives me the following error: Error in UseMethod("svyvar", design) : no applicable method for 'svyvar' applied to an object of class "character"

I have been working on this for awhile and can't figure it out. Thank you so much for your help!!

R LAVAAN SYNTAX
--------------
# Load in required libraries
library(lavaan)
library(psych)
library(foreign)
library(lavaan.survey)
library(survey)

# Set working directory laptop
[removed]

svy.df<-svydesign(id=~STU_ID,
                  weights=~W1PARENT,
                  data=mydata)
model <- '
# measurement model
StudentMATHidentity_T1x =~ S1MPERSON1 + S1MPERSON2
StudentMATHidentity_T2x =~ S2MPERSON1 + S2MPERSON2
StudentMATHidentity_T4x =~ S4MPERSON1 + S4MPERSON2

#regressions
S1MTHCOMP ~ c(b10, b11)* P1MTHCOMP + c(b20, b21)* M1MTHCOMP + c(b30, b31)* X2TXMQUINT + c(b70, b71)* S1M8GRADE
StudentMATHidentity_T1x ~ c(b50, b51)* S1MTHCOMP + c(b60, b61)* P1MTHCOMP + c(b40, b41)* X2TXMQUINT + c(b210, b211)* S1M8GRADE + c(b430, b431)* X1FAMINCOME
S2MTHCOMP ~ c(b190, b191)* P1MTHCOMP + c(b200, b201)* X2TXMQUINT + c(b130, b131)* S1MTHCOMP + c(b140, b141)* StudentMATHidentity_T1x
StudentMATHidentity_T2x ~ c(b220, b221)* S1MTHCOMP + c(b230, b231)* P1MTHCOMP + c(b240, b241)* X2TXMQUINT + c(b150, b151)* S2MTHCOMP + c(b160, b161)* StudentMATHidentity_T1x
StudentMATHidentity_T4x ~ c(b340, b341)* StudentMATHidentity_T2x + c(b350, b351)* S2MTHCOMP + c(b360, b361)* X2TXMQUINT

#Group Differences [have removed most of these for brevity]
diffb1 := b10 - b11
diffb2 := b20 - b21

'
#Model Fit
fit <- sem(model, data = mydata, group = "X1SEX", ordered=c("X1FAMINCOME","S4MPERSON1", "S4MPERSON2", "S1M8GRADE", "S1MTHCOMP", "P1MTHCOMP", "M1MTHCOMP", "N1MTHCOMP", "X2TXMQUINT", "S1MPERSON1", "S1MPERSON2", "S1MENJOYING", "S1MWASTE", "S1MBORING", "S1MUSELIFE", "S1MUSECLG", "S1MUSEJOB", "S1MTESTS", "S1MTEXTBOOK", "S1MSKILLS", "S1MASSEXCL",  "S1MASSEXCL", "S2MPERSON1", "S2MPERSON2", "S2MENJOYING", "S2MWASTE", "S2MBORING", "S2MUSELIFE", "S2MUSECLG", "S2MUSEJOB", "S2MTESTS", "S2MTEXTBOOK", "S2MSKILLS", "S2MASSEXCL", "S2MTHCOMP"))
summary(fit, fit.measures = T, rsq = T)
standardizedsolution(fit)
parameterEstimates(fit, ci =T, level = .95)
modindices(fit, sort. = TRUE)

#Trying to run my SEM model through the weight variable
survey.fit <-lavaan.survey(fit,
                           survey.design = "svy.df",
                           estimator="MLMV")
summary(survey.fit,
        fit.measures=TRUE,
        standardized=TRUE,
        rsquare=TRUE)

