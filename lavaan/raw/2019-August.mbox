#Estimation of missing data structure
a<-sample(1:547, 547, replace=F, set.seed(289))
a
amothers<-a[2:547]
amothers
afathers <- a[1:506]
afathers
b<-sample(a, 442, replace=F, set.seed(9234))
b1<-sample(548:596, 49, replace=F, set.seed(444))
b2<-c(b,b1)
b2
bmothers<-b2[7:491]
bmothers
bfathers<-b2[1:299]
bfathers
c<-b2[31:443]
c
c1<-sample(587:632, 46, replace=F, set.seed(444))
c2<-c(c,c1)
c2
cmothers<-c2[6:456]
cmothers
cfathers<-c2[1:357]
cfathers
c3<-c2[3:354]
c4<-c2[358:441]
c5<-c2[c(457,458,459)]
cadolescent<-c(c3,c4,c5)
cadolescent
covariates<-1:710

#creating missing data matrix that will be used in MC simulation
d_matrix=matrix(c(TRUE),nrow = 710, ncol = 30)
d_matrix[amothers,1:4]<-FALSE
d_matrix[bmothers, 5:8]<-FALSE
d_matrix[cmothers, 9:12]<-FALSE
d_matrix[afathers, 13:16]<-FALSE
d_matrix[bfathers, 17:20]<-FALSE
d_matrix[cfathers, 21:24]<-FALSE
d_matrix[cadolescent, 25:27]<-FALSE
d_matrix[covariates, 28:30]<-FALSE
colSums(d_matrix)
View(d_matrix)
d_matrix
missingness<-miss(logical=d_matrix, m=0)
missingness

#add non-normality to some variables
dist<-bindDist(skewness = c((-3.0), (-0.8), (-1.0),(-0.77), (-3.0), (-0.8), (-1.0), (-0.77), (-3.0), (-0.8), (-1.0), (-0.77),
                            (-3.0), (-0.8), (-1.0), (-0.77), (-3.0), (-0.8), (-1.0), (-0.77),(-3.0), (-0.8), (-1.0), (-0.77),
                            0, 0, 0, 0, 0, 0),
               kurtosis = c(20, 4, 5, 3, 20, 4, 5, 3, 20, 4, 5, 3, 20, 4, 5, 3, 20, 4, 5, 3, 20, 4, 5, 3, 0, 0, 0, 0, 0, 0))

AUTanalysis.POPCHILDHOOD.CHILDHOOD <-sim(nRep = 1000, model=AUTmodel.CHILDHOOD, n =710,
                                         generate= AUTmodelPOP.CHILDHOOD, lavaanfun = "sem", indDist = dist,  seed=565, std.lv <http://std.lv>=T, cilevel=0.90, miss=missingness, estimator="MLR")

AUTanalysis.POPCHILDHOOD.STABILITY <- sim(nRep = 1000,
                                          model=AUTmodel.STABILITY, n = 710,
                                          generate= AUTmodelPOP.CHILDHOOD, lavaanfun = "sem", indDist = dist,  seed=565, std.lv <http://std.lv>=T, cilevel=0.90, miss=missingness, estimator="MLR")

#Mean rmsea=0.021, CFI =0.982, SRMR=0.042
summary(AUTanalysis.POPCHILDHOOD.CHILDHOOD) #converged replications 1000
#RMSEA<0.06, CFI>0.95, and SRMR<0.08 in 95 % of replications
getCutoff(AUTanalysis.POPCHILDHOOD.CHILDHOOD, alpha=0.05)
getCutoff(AUTanalysis.POPCHILDHOOD.CHILDHOOD, alpha=0.95)

#Mean rmsea=0.027, CFI =0.968, SRMR=0.057
summary(AUTanalysis.POPCHILDHOOD.STABILITY) #converged replications 1000
#RMSEA<0.06, CFI>0.95, and SRMR<0.08 in 95 % of replications
getCutoff(AUTanalysis.POPCHILDHOOD.STABILITY, alpha=0.05)
getCutoff(AUTanalysis.POPCHILDHOOD.STABILITY, alpha=0.95)

#Model comparison
anova(AUTanalysis.POPCHILDHOOD.CHILDHOOD, AUTanalysis.POPCHILDHOOD.STABILITY) #scaled x2 difference test value 72.083

#defining critical values a=0.05 for scaled x2 difference test based on df differences between the models.
qchisq((1-0.05), df=12)
#df 12 WHOLE CHILDHOOD VS STABILITY MODEL
cutoff1 <- c(chisq.scaled =21.026)
#power 1.000
getPowerFitNested(AUTanalysis.POPCHILDHOOD.STABILITY, AUTanalysis.POPCHILDHOOD.CHILDHOOD, cutoff1)

