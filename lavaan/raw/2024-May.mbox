You can’t ask lavaan to estimate residual variance of manifest variables when they are ordinal.

Get it off and lavaan is going to work.
# Specify Parameters for Simulation ---- populationSize <- 100000 itemLoading <- .7 standardThreshold1 <- 0.5 standardThreshold2 <- 1 standardThreshold3 <- 1.5 nonInvariantThreshold1 <- 0 nonInvariantThreshold2 <- 0.5 nonInvariantThreshold3 <- 1 mySeed <- 52242 # Specify Population Model ---- populationModel <- paste( ' # Specify measurement model factor loadings dep =~ ', itemLoading, '*v1 + ', itemLoading, '*v2 + ', itemLoading, '*v3 + ', itemLoading, '*v4 + ', itemLoading, '*v5 # Fix latent mean to zero dep ~ 0*1 # Fix latent variance to one dep ~~ 1*dep # Specify thresholds of manifest variables v1 | (', standardThreshold1, ')*t1 + (', standardThreshold2, ')*t2 + (', standardThreshold3, ')*t3 v2 | (', standardThreshold1, ')*t1 + (', standardThreshold2, ')*t2 + (', standardThreshold3, ')*t3 v3 | (', standardThreshold1, ')*t1 + (', standardThreshold2, ')*t2 + (', standardThreshold3, ')*t3 v4 | (', nonInvariantThreshold1, ')*t1 + (', nonInvariantThreshold2, ')*t2 + (', nonInvariantThreshold3, ')*t3 v5 | (', nonInvariantThreshold1, ')*t1 + (', nonInvariantThreshold2, ')*t2 + (', nonInvariantThreshold3, ')*t3 ', sep = "") # Generate Population Data ---- populationData <- simulateData( populationModel, sample.nobs = populationSize, seed = mySeed) # Specify Analysis Model ---- analysisModel <- ' # Specify measurement model factor loadings dep =~ NA*v1 + NA*v2 + NA*v3 + NA*v4 + NA*v5 # Fix latent mean to zero dep ~ 0*1 # Fix latent variance to one dep ~~ 1*dep # Specify thresholds of manifest variables v1 | NA*t1 + NA*t2 + NA*t3 v2 | NA*t1 + NA*t2 + NA*t3 v3 | NA*t1 + NA*t2 + NA*t3 v4 | NA*t1 + NA*t2 + NA*t3 v5 | NA*t1 + NA*t2 + NA*t3 ' # Run Model on Generated Population Data ---- analysisModel_fitted <- lavaan( analysisModel, data = populationData, ordered = paste0("v", 1:5), missing = "pairwise", estimator = "WLSMV", parameterization = "theta") print(lavaan::summary(analysisModel_fitted))

Best,
Yago
