n><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">shade_seek </span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">1</span> <i><span style=\"color:#60a0b0\"># shade seeking?</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">burrow </span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">0</span> <i><span style=\"color:#60a0b0\"># can it burrow?</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">climb</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">\r\n&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">0</span> <i><span style=\"color:#60a0b0\"># can it climb to thermoregulate?</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">nocturn </span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">0</span> <i><span style=\"color:#60a0b0\"># nocturnal\r\nactivity</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">crepus</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">\r\n&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">0</span> <i><span style=\"color:#60a0b0\"># crepuscular activity</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">diurn</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\">\r\n&lt;-<span style=\"color:#4070a0\"> </span><span style=\"color:#40a070\">1</span> <i><span style=\"color:#60a0b0\"># diurnal activity</span></i></span><span style=\"font-size:10.0pt;line-height:107%;font-family:Consolas;color:#333333;background:#f7f7f7\"><br>\r\n</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif;color:#c45911\">minshades</span><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\"> &lt;-<span style=\"color:#4070a0\"> </span><b><span style=\"color:#007020\">rep</span></b>(<span style=\"color:#40a070\">0, 10</span>) <i><span style=\"color:#60a0b0\"># min available shade?<br>\r\n</span></i><span style=\"color:#c45911\">maxshades</span> &lt;-<span style=\"color:#4070a0\"> </span>micro<span style=\"color:#666666\">$</span>MAXSHADES <i><span style=\"color:#60a0b0\"># max\r\navailable shade</span></i></span><br></div><div><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\"><i><span style=\"color:#60a0b0\"><br></span></i></span></div><div><span style=\"font-size:12.0pt;line-height:107%;font-family:&quot;Times New Roman&quot;,serif\"><span style=\"font-size:12pt;line-height:107%\">ecto\r\n&lt;-<span style=\"color:#4070a0\"> </span><b><span style=\"color:#007020\">ectotherm</span></b>(<span style=\"color:#902000\">Ww_g =</span> Ww_g, <span style=\"color:#902000\">alpha_max\r\n=</span> alpha_max, <span style=\"color:#902000\">alpha_min =</span> alpha_min, <span style=\"color:#902000\">pct_wet =</span> pct_wet, <span style=\"color:#902000\">T_F_max\r\n=</span> T_F_max, <span style=\"color:#902000\">T_F_min =</span> T_F_min, <span style=\"color:#902000\">T_B_min =</span> T_B_min, <span style=\"color:#902000\">T_RB_min\r\n=</span> T_RB_min, <span style=\"color:#902000\">CT_max =</span> CT_max, <span style=\"color:#902000\">CT_min =</span> CT_min, <span style=\"color:#902000\">T_pref\r\n=</span> T_pref, <span style=\"color:#902000\">mindepth =</span> mindepth, <span style=\"color:#902000\">maxdepth =</span> maxdepth, <span style=\"color:#902000\">shade_seek\r\n=</span> shade_seek, <span style=\"color:#902000\">burrow =</span> burrow, <span style=\"color:#902000\">climb =</span> climb, <span style=\"color:#902000\">nocturn\r\n=</span> nocturn, <span style=\"color:#902000\">diurn =</span> diurn, <span style=\"color:#902000\">crepus =</span> crepus, maxshades = maxshades, minshades\r\n= minshades)</span><span style=\"font-size:11.0pt;line-height:107%;font-family:&quot;Calibri&quot;,sans-serif\"> <span><i><span style=\"color:#60a0b0\"># </span></i></span><i>Phaulacridium</i>\r\n<i>vittatum (the wingless grasshopper) only include necessary variables as\r\nspecified above.</i></span><i><span style=\"color:#60a0b0\"><br></span></i></span></div></div>"
