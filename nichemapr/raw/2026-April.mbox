        TC = TC, TC_MAX = TC_MAX, TC_MIN = TC_MIN,
        SHAPE_B = SHAPE_B,SHAPE_B_MAX = SHAPE_B_MAX,
        FATPCT = FATPCT, SUBQFAT = SUBQFAT,
        TORPOR = 1,
