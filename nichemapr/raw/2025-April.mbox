rainhr <- rep(-1,nrow(micro$metout))
elev <- as.numeric(micro$elev)
longitude <- as.numeric(micro$longlat[1])
latitude <- as.numeric(micro$longlat[2])
ecto <- ectotherm(Ww_g = Ww_g,
                  shape = shape,
                  shape_b = shape_b,
                  live = live,
                  postur = postur,
                  alpha_max = alpha_max,
                  alpha_min = alpha_min,
                  T_F_min = T_F_min,
                  T_F_max = T_F_max,
                  T_pref = T_pref,
                  T_B_min = T_B_min,
                  T_RB_min = T_RB_min,
                  CT_max = CT_max,
                  CT_min = CT_min,
                  diurn = diurn,
                  nocturn = nocturn,
                  crepus = crepus,
                  shade_seek = shade_seek,
                  burrow = burrow,
                  climb = climb,
                  pct_wet = pct_wet,
                  warmsig = warmsig,
                  shdburrow = shdburrow,
                  mindepth = mindepth,
                  maxdepth = maxdepth,
                  nyears = nyears,
                  minshades = minshades,
                  maxshades = maxshades,
                  alpha_sub = alpha_sub,
                  DEP = DEP,
                  metout = metout,
                  shadmet = shadmet,
                  soil = soil,
                  shadsoil = shadsoil,
                  soilmoist = soilmoist,
                  shadmoist = shadmoist,
                  humid = humid,
                  shadhumid = shadhumid,
                  soilpot = soilpot,
                  shadpot = shadpot,
                  rainfall = rainfall,
                  rainhr = rainhr,
                  elev = elev,
                  longitude = longitude,
                  latitude = latitude)

#prelim plotting

#probably won't be using this first plot
metout <- as.data.frame(micro$metout)
dates <- micro$dates
environ <- as.data.frame(ecto$environ)
ymax <- 5 * round(max(environ$TC[(24*12+1):(24*24)]) / 5)+5
ymin <- 5 * round(min(environ$TC[(24*12+1):(24*24)]) / 5)
months <- c("January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December")
monchoice <- which(months == 'January')
subs <- which(trunc(dates) - 12 + 1 == monchoice)
TC <- environ$TC[subs]
acthrs <- environ$ACT[subs]
baskforage <- acthrs
acthrs[acthrs !=2] <- 0
acthr <- sum(acthrs)/2

plot(TC ~ seq(0, 23), ylab = 'Body temperature (°C)', xaxt = 'n', xlab = "Hour of day", col = 'black', ylim = c(ymin, ymax), type = "l", main = paste0(round(micro$longlat[2], 1), '° lat, ', round(micro$longlat[1], 1), '° lon, ', round(micro$elev, 1), 'm elevation in ', 'January'), cex = 1.5)
axis(side = 1, at = seq(0, 24), labels = seq(0, 24))

abline(16, 0, lty = 2, col = 'blue')

zens <- metout$ZEN[subs]
abline(v = which(zens < 90)[1] - 1.5, lty = 2, col = 'grey')
abline(v = which(zens < 90)[length(which(zens < 90))] - 0.5, lty = 2, col = 'grey')
text(which(zens < 90)[1] - 1.5, ymin + 2, labels = 'Sunrise', srt = 90, col = 'grey')
text(which(zens < 90)[length(which(zens < 90))] - 0.5, ymin + 2, labels = 'Sunset', col = 'grey', srt = 90)
state <- 'alive'
if(state == "alive"){
  points(seq(0, 23)[baskforage == 1], TC[baskforage == 1],  pch = 16, col = 'light blue')
  points(seq(0, 23)[baskforage == 2], TC[baskforage == 2], pch = 16, col = 'orange')
  par(xpd=TRUE)
  legend(1, ymin - (ymax - ymin)*0.2, c('Foraging'), pch = 16, cex = 1, col = c('orange', 'light blue'), horiz = TRUE)
  par(xpd=FALSE)
}
text(1, c(16 + 1), c('min forage'), col = c('blue'), cex = 1)

# activity plot, more useful
par(mar = c(5, 4, 4, 5) + 0.1)
environ <- as.data.frame(ecto$environ)
environ2 <- environ[(12 * 24 + 1):(12 * 24 + 12 * 24), ]
environ2$ACT[environ2$ACT != 2] <- 0
environ2$ACT[environ2$ACT == 2] <- 1
acthrs <- aggregate(environ2$ACT, by = list(environ2$DAY), FUN = sum)
daymon <- c(31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
yearact <- sum(acthrs$x * daymon)
# seasonal activity plot (dark blue = night, light blue = basking, orange = foraging)
forage <- subset(environ, ACT == 2)
bask <- subset(environ, ACT == 1)
night <- subset(metout, ZEN == 90)
with(night, plot(TIME / 60 ~ DOY, ylab = "Hour of day", xlab = " ", xaxt = 'n', pch = 15, cex = 2, col = 'dark blue', main = paste0('')))
# nighttime hours
state <- 'alive'
if(state == "alive"){
  with(forage, points(TIME ~ DOY, pch = 15, cex = 2, col = 'orange')) # foraging Tbs
  with(bask, points(TIME ~ DOY, pch = 15, cex = 2, col = 'light blue')) # basking Tbs
  axis(side = 1, at=c(1, 32, 60, 91, 121, 152, 182, 213, 244, 274, 305, 335), labels = c('J', 'F', 'M', 'A', 'M', 'J', 'J', 'A', 'S', 'O', 'N', 'D'))
}

par(xpd=TRUE)
legend(1, -6, c('Night', 'Foraging'), pch = 15, cex = 1, col = c('dark blue', 'orange'), horiz = TRUE)
par(xpd=FALSE)

###can temperature be added to the plot?###

environ$TA <- as.numeric(environ$TA)
mean_TA <- aggregate(TA ~ DOY, data = environ, FUN = mean)
# temperature axis limits
TA_min_plot <- -5
TA_max_plot <- 17

# Rescale temperature to match 0–24 y-axis for plotting
rescaled_TA <- (mean_TA$TA - TA_min_plot) / (TA_max_plot - TA_min_plot) * 24
rescaled_TA[mean_TA$TA < TA_min_plot] <- NA
rescaled_TA[mean_TA$TA > TA_max_plot] <- NA

# Add temperature line
lines(mean_TA$DOY, rescaled_TA, col = 'red', lwd = 2)

# Add right-side y-axis for temperature (-5 to 17°C mapped to 0–24 hours)
axis_ticks <- pretty(c(TA_min_plot, TA_max_plot))
axis_vals <- (axis_ticks - TA_min_plot) / (TA_max_plot - TA_min_plot) * 24
axis(side = 4, at = axis_vals, labels = round(axis_ticks, 1))
mtext("Mean daily air temperature (°C)", side = 4, line = 3)

