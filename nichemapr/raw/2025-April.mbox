                      SpecHeat = SpecHeat, windfac = windfac, soilgrids = soilgrids,
                      Usrhyt = Usrhyt, clearsky = clearsky, slope = slope,
                      aspect = aspect, REFL = REFL, hori = hori, minshade = minshade,
                      maxshade = maxshade, loc = c(lon, lat), runshade = 1, run.gads = 1,
                      snowmodel = 1, BulkDensity =  BulkDensity, cap = cap,
                      snowtemp = 1.5, snowdens = 0.375, densfun = c(0.5979, 0.2178, 0.001, 0.0038),
                      snowmelt = 1, undercatch = 1, rainmelt = 0.0125, rainfrac = 0.5,
                      snowcond = 0, intercept = max(maxshade) / 100 * 0.3, grasshade = 0, nyears=nyears,elev=elev,timeinterval = timeinterval)

# ectotherm
Ww_g <- 0.01
shape <- 2
shape_b <- 3
alpha_max <- 0.85
alpha_min <- 0.85
T_F_min <- 15.75
T_F_max <- 38.82
T_pref <- 27
T_B_min <- 15.75
T_RB_min <- 15.75
CT_max <- 47
CT_min <- -0.2
diurn <- 1
nocturn <- 0
crepus <- 0
pct_wet <- 0.1
warmsig <- 0
shade_seek <- 1
burrow <- 0
live <- 1
postur <- 1
climb <- 0
shdburrow <- 0
