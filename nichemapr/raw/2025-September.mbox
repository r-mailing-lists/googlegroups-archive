> > > T_air <- rasterize(points, r, field = "T_air")
> > > T_soil0cm <- rasterize(points, r, field = "T_soil0cm")
> > > T_soil5cm <- rasterize(points, r, field = "T_soil5cm")
> > > T_b <- rasterize(points, r, field = "T_b")
