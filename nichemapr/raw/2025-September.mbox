                         PANT_MAX = 10    #default = 10, #Bartholomew, G. A., Lasiewski, R. C., & Crawford, E. C. (1968). Patterns of panting and gular flutter in cormorants, pelicans, owls, and doves. The Condor, 70(1), 31-34.

