     1,
     "<div dir=\"ltr\">Hola Abigail,<div><br></div><div>Para ponerle labels a los municipios también puedes usar la latitud y longitud de la cabecera de cada uno de los municipios que se encuentra en el data.frame df_mxmunicipio<br><div><br></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><pre style=\"box-sizing:border-box;overflow:auto;padding:9.5px;line-height:1.42857;word-break:break-all;background-color:rgb(245,245,245);border-width:1px;border-style:solid;border-color:rgb(204,204,204);border-radius:4px;font-variant-numeric:normal;font-variant-east-asian:normal\"><code style=\"box-sizing:border-box;background-color:transparent;border-radius:0px\"><span style=\"box-sizing:border-box\"><font color=\"#000000\"><span style=\"white-space:pre-wrap\"><b><span style=\"color:#000\">library</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;mxmaps&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span></b></span></font><span style=\"color:#000\">library</span></span><span style=\"color:#660\">(</span><span style=\"color:rgb(221,17,68);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#080\">&quot;ggrepel&quot;</span></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>df_mxmunicipio$value </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">  df_mxmunicipio$indigenous </span><span style=\"color:#660\">/</span><span style=\"color:#000\"> df_mxmunicipio$pop </span><span style=\"color:#660\">*</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#066\">100</span></span><span style=\"color:#000\"><br>chih </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> subset</span><span style=\"color:#660\">(</span><span style=\"color:#000\">df_mxmunicipio</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> state_name </span><span style=\"color:#660\">%</span><span style=\"color:rgb(153,0,0);font-size:inherit;white-space:pre-wrap;box-sizing:border-box;font-weight:bold\"><span style=\"color:#008\">in</span></span><span style=\"color:#660\">%</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:rgb(221,17,68);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#080\">&quot;Chihuahua&quot;</span></span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>p </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> mxmunicipio_choropleth</span><span style=\"color:#660\">(</span><span style=\"color:#000\">df_mxmunicipio</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> num_colors </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#066\">1</span></span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                       zoom </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> chih$region</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                       title </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(221,17,68);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#080\">&quot;Percentage of the population that self-identifies\\nas indigenous in Chihuahua&quot;</span></span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                       show_states </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(153,0,115);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#000\">FALSE</span></span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>                       legend </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(221,17,68);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#080\">&quot;%&quot;</span></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>labels </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> chih<br>labels$group </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> </span><span style=\"color:rgb(153,0,115);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#000\">NA</span></span><span style=\"color:#000\"><br>labels </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> subset</span><span style=\"color:#660\">(</span><span style=\"color:#000\">labels</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> pop </span><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#066\">1e05</span></span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>p </span><span style=\"color:#660\">+</span><span style=\"color:#000\"><br>  geom_text_repel</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> labels</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                  aes</span><span style=\"color:#660\">(</span><span style=\"color:#008\">long</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> lat</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> label </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> municipio_name</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>                  nudge_x </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#660\">.</span><span style=\"color:#066\">1</span></span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>                  nudge_y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#660\">.</span><span style=\"color:#066\">7</span></span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">+</span><span style=\"color:#000\"><br>  geom_point</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> labels</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> <br>             aes</span><span style=\"color:#660\">(</span><span style=\"color:#008\">long</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> lat</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>             color </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(221,17,68);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#080\">&quot;#d6604d&quot;</span></span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>             size </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:rgb(0,153,153);font-size:inherit;white-space:pre-wrap;box-sizing:border-box\"><span style=\"color:#066\">1</span></span><span style=\"color:#660\">)</span></code></pre></div></code></div><br><br></div></div></div>"
    ]
   ]
  }
 ]
