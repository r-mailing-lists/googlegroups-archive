   "subject": "Re: [R-Ecology] Escala de riqueza em um raster",
   "parts": [
    [
     1,
     "<div dir=\"ltr\"><div class=\"gmail_default\"><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">Oi Maraísa.</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">Você tem algum exemplo?</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">Veja se isso ajuda:</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">##</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">library(raster)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">data(volcano)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">r &lt;- raster(volcano)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">x11()</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">par(mfrow=c(1,2))</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">plot(r)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">breakpoints &lt;- seq(80,200,length.out=20)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">colors &lt;- grDevices::colorRampPalette(c(&quot;blue&quot;, &quot;red&quot;, &#39;black&#39;))( 20)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">plot(r,breaks=breakpoints,col=colors)</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">##</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\"><br></font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">Abraços,</font></div><div class=\"gmail_default\"><font face=\"verdana, sans-serif\">Luciano</font></div></div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
