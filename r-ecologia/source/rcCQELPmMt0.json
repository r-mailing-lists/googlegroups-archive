     1,
     "\r\n\r\n\r\n<div><div dir=\"ltr\">\r\n<font face=\"Courier New\">Olá Gudryan,</font><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">Fausto Nomura e sua orientada de doc. Núbia Marques (ambos da Eco Evol, UFG) trabalham com morfometria. Não sei ao certo se é a geométrica.</font></div><div><font face=\"Courier New\"> </font></div><div><font face=\"Courier New\">Segue contato: <a href data-email-masked rel=\"nofollow\">faust...@gmail.com</a></font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">Abç </font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\">Diogo</font></div><div><br><br><div><b style=\"font-family:&#39;Courier New&#39;;font-size:10pt\">--</b></div><div><b style=\"font-family:&#39;Courier New&#39;\">Diogo S.M. Samia</b></div><div><font face=\"Courier New\" style=\"font-size:10pt\">PhD Candidate - </font><span style=\"font-size:10pt;font-family:&#39;Courier New&#39;\">Ecology and Evolution</span></div><div><span style=\"font-family:&#39;Courier New&#39;;font-size:10pt\">Laboratory of Theoretical Ecology and Synthesis</span></div><div><div><font face=\"Courier New\">Federal University of Goiás - Brazil</font></div><div><font face=\"Courier New\"><br></font></div><div><font face=\"Courier New\"><br></font></div></div><br><br><div><div></div><hr>From: <a href data-email-masked rel=\"nofollow\">gud...@gmail.com</a><br>Date: Fri, 29 Mar 2013 09:50:31 -0300<br>Subject: Re: [R-Ecology] geomorph<br>To: <a href data-email-masked rel=\"nofollow\">r-eco...@googlegroups.com</a></div></div></div></div>"
