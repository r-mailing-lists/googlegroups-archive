## Veja se é isso mesmo:

coor <- cbind(long = c(0, 0, 0, 100, -100),
                 lat = c(0, 60, -60, 0, 0))
rownames(coor) <- c('A', 'B', 'C', 'D', 'E')
plot(coor, t='n')
text(coor, rownames(coor), cex=2)
r1 <- maptools::gzAzimuth(coor[2:5,], coor[1,])
r1

