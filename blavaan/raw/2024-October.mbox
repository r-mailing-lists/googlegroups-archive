And the codes in the help:

model <- '

# latent variable definitions

ind60 =~ x1 + x2 + x3

dem60 =~ y1 + a*y2 + b*y3 + c*y4

dem65 =~ y5 + a*y6 + b*y7 + c*y8

# regressions

dem60 ~ ind60

dem65 ~ ind60 + dem60

# residual correlations

y1 ~~ y5

y2 ~~ y4 + y6

y3 ~~ y7

y4 ~~ y8

y6 ~~ y8

'

fit <- bsem(model, data = PoliticalDemocracy, dp = dpriors(nu =
"normal(5,10)", lambda = "normal(1,.5)"))

summary(fit)

