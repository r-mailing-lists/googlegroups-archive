model <- '

# Başkalarıyla etkileşim içinde olma

Giriskenlik=~Gir1+Gir2+Gir3+Gir4+Gir5+Gir6+Gir7+Gir8

Sosyallik =~ Sos1 + Sos2 + Sos3 + Sos4+ Sos5+ Sos6+ Sos7+Sos8

Enerji =~ En1 + En2 + En3 + En4+ En5+ En6+ En7+ En8

# regressions

Giriskenlik ~ Sosyallik

Enerji ~ Sosyallik

Giriskenlik ~ Enerji

‘

fit<-bsem(model, data=bayessdb,

          auto.var=TRUE, auto.fix.first=TRUE,

          auto.cov.lv.x=TRUE)

summary(fit)

coef(fit)

fitMeasures(fit)

summary(blavFitIndices(fit, pD="dic"))

fitMeasures(fit)

Bu şekilde yazdığımda uyum indekslerine ulaşabiliyorum ancak faktör skorlarına ulaşamıyorum. Sizin söylediğiniz gibi yaptım. Kodu Şu şekilde yazdım

null.model <- '
  Hg1 ~~ Hg1
  Hg2 ~~ Hg2
  Hg3 ~~ Hg3
  Hg4 ~~ Hg4
  Hg5 ~~ Hg5
  Hg6 ~~ Hg6
  Hg7 ~~ Hg7
  Hg8~~ Hg8
  Mer1 ~~ Mer1
  Mer2 ~~ Mer2
  Mer3 ~~ Mer3
  Mer4 ~~ Mer4
  Mer5 ~~ Mer5
  Mer6 ~~ Mer6
  Mer7 ~~ Mer7
  Mer8~~ Mer8
  Yar1 ~~ Yar1
  Yar2 ~~ Yar2
  Yar3 ~~ Yar3
  Yar4 ~~ Yar4
  Yar5 ~~ Yar5
  Yar6 ~~ Yar6
  Yar7 ~~ Yar7
  Yar8 ~~ Yar8
 '
fa.model <- '
# Acik Fikirlilik
Hosgoru=~Hg1+Hg2+Hg3+Hg4+Hg5+Hg6+Hg7+Hg8
Merak =~ Mer1 + Mer2 + Mer3 + Mer4+ Mer5+ Mer6+ Mer7+Mer8
Yaraticilik =~ Yar1 + Yar2 + Yar3 + Yar4+ Yar5+ Yar6+ Yar7+ Yar8
Hosgoru ~ Merak
Yaraticilik ~ Merak
Hosgoru ~ Yaraticilik
'

## fit models ----
null.fit <- bcfa(null.model, data=bayessdb)
fa.fit <- bcfa(fa.model, data=bayessdb, save.lvs= T, std.lv <http://std.lv>=TRUE) #standardizes the latent variables

fa.fit.postCIs <- blavFitIndices(fa.fit, baseline.model = null.fit)

