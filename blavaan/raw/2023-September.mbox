F1 =~ 1*brief_gec_2

#Near specification
#Set up latent change for near and covariances of latent variables
NC =~ 0*N0 + 0*N1
N1 ~~ N1
N0 ~~ N0
NC ~~ NC

#Set up model ie latent regressions
N1 ~ 1*N0
N1 ~ 1*NC

#Set up Means
N0 ~ 0*1
NC ~ 1
N1 ~ 0*1

osari_ssrt_60ms_1 ~ 1
osari_ssrt_60ms_2 ~ 1
ant_conflict_1 ~ 1
ant_conflict_2 ~ 1
##No need to tell lavaan to keep the intercepts equal, as this will be done when fitting the model

#variances
osari_ssrt_60ms_1 ~~ Vosari*osari_ssrt_60ms_1
osari_ssrt_60ms_2 ~~  Vosari*osari_ssrt_60ms_2
