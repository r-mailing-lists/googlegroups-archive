Dear Mauricio,
Here the full code:

ModelBSEM2 <- 'INTENTION =~ INTENT1_T1 + INTENT2_T1 + INTENT3_T1

AFFPOS =~  AFFPOS1_T1 + AFFPOS2_T1 + AFFPOS3_T1

AFFNEG =~  AFFNEG1_T1 + AFFNEG2_T1 + AFFNEG3_T1

PHYOUT =~ OUT_PHY1_T1 + OUT_PHY2_T1 + OUT_PHY3_T1 + OUT_PHY4_T1

SOCOUT =~  OUT_SOC1_T1 + OUT_SOC2_T1 + OUT_SOC3_T1 + OUT_SOC4_T1

SELFEXPECT =~ OUT_SELF1_T1 + OUT_SELF2_T1 + OUT_SELF3_T1+ OUT_SELF4_T1

AFFATT =~ ATTAFF1_T1 + ATTAFF2_T1 + ATTAFF3_T1 + ATTAFF4_T1

COGNITATT =~ ATTSTR1_T1 + ATTSTR2_T1 + ATTSTR3_T1 + ATTSTR4_T1

AFFPOS ~ PHYOUT + SOCOUT + SELFEXPECT

AFFNEG ~ PHYOUT + SOCOUT + SELFEXPECT

AFFATT ~ PHYOUT + SOCOUT + SELFEXPECT

COGNITATT ~ PHYOUT + SOCOUT + SELFEXPECT

INTENTION ~  PHYOUT + AFFPOS + AFFNEG + AFFATT + COGNITATT + FREQ'

fitBSEM2 <- bsem(ModelBSEM2, group = "EFFICACY_CAT1", data=BSEM, dp=dpriors(nu="normal(5,10)") )

summary(fitBSEM2)

ML <- blavFitIndices(fitBSEM2)

ML

summary(ML, prob=.95,central.tendency = c("mean","median"))

 ##############

##### modification indices

##############

discFUN_mi <- list(

  mod.ind_mi = function(object){

    temp <- modificationindices(object,free.remove = F)

    mods <- temp$mi

    names(mods) <- paste0(temp$lhs,temp$op,temp$rhs,temp$group)

    return(mods)

  },mod.ind_epc = function(object){

    temp <- modificationindices(object,free.remove = F)

    epc <- temp$epc

    names(epc) <- paste0(temp$lhs,temp$op,temp$rhs,temp$group)

    return(epc )

  },mod.ind_sepc.all = function(object){

    temp <- modificationindices(object,free.remove = F)

    sepc.all <- temp$sepc.all

    names(sepc.all) <- paste0(temp$lhs,temp$op,temp$rhs,temp$group)

    return(sepc.all )

  }

)

## PPMC for each

out_mi <- ppmc(fitBSEM2, thin = 5, discFUN = discFUN_mi)

summary(out_mi, prob=.9, discFUN = "mod.ind_mi",

        sort.by <http://sort.by> = "EAP", decreasing=T)

summary(out_mi, prob=.9, discFUN = "mod.ind_mi",

        sort.by <http://sort.by> = "Median", decreasing=T)

summary(out_mi, prob=.9, discFUN = "mod.ind_epc",

        sort.by <http://sort.by> = "EAP", decreasing=T)

summary(out_mi, prob=.9, discFUN = "mod.ind_sepc.all",

        sort.by <http://sort.by> = "EAP", decreasing=T)

summary(out_mi, prob=.9, discFUN = "mod.ind_mi",

        sort.by <http://sort.by> = "EAP", decreasing=T)

