Dear all,

I would like to fit the following model, and I would like to have feedback about the procedure and syntax which I used, especially in terms of parameters, fit measures I need to implement. This is my model and syntax:

ModelBSEM2 <- 'INTENTION =~ INTENT1_T1 + INTENT2_T1 + INTENT3_T1
AFFPOS =~  AFFPOS1_T1 + AFFPOS2_T1 + AFFPOS3_T1
AFFNEG =~  AFFNEG1_T1 + AFFNEG2_T1 + AFFNEG3_T1
PHYOUT =~ OUT_PHY2_T1 + OUT_PHY2_T1 + OUT_PHY2_T1 + OUT_PHY2_T1
SOCOUT =~  OUT_SOC1_T1 + OUT_SOC2_T1 + OUT_SOC3_T1 + OUT_SOC4_T1
SELFEXPECT =~ OUT_SELF1_T1 + OUT_SELF2_T1 + OUT_SELF3_T1+ OUT_SELF4_T1
AFFATT =~ ATTAFF1_T1 + ATTAFF2_T1 + ATTAFF3_T1 + ATTAFF4_T1
COGNITATT =~ ATTSTR1_T1 + ATTSTR2_T1 + ATTSTR3_T1 + ATTSTR4_T1

AFFPOS ~ PHYOUT + SOCOUT + SELFEXPECT
AFFNEG ~ PHYOUT + SOCOUT + SELFEXPECT
AFFATT ~ PHYOUT + SOCOUT + SELFEXPECT
COGNITATT ~ PHYOUT + SOCOUT + SELFEXPECT
INTENTION ~  PHYOUT + AFFPOS + AFFNEG + AFFATT + COGNITATT + FREQ'

BSEM$EFFICACY_CAT1
fitBSEM2 <- bsem(ModelBSEM2, group = "EFFICACY_CAT1", data=BSEM, dp=dpriors(nu="normal(5,10)") )
summary(fitBSEM2)

