Below is my code:
fit.RICLPMConstraintsEnjMap <- '
RIEnj ~ a1*Manip1 + a2*Manip2

# direct Mapect
RIMap ~ c11*Manip1 + c12*Manip2

# add Manip (use Manip0 as reference)
preMap ~ f1*Manip1 + f2*Manip2
preEnj ~ e1*Manip1 + e2*Manip2

# add covariates z1
# 1b) Regression of random intercepts on time-invariant predictor z1
RIEnj ~ preEnj

RIMap ~ preMap

# Residual variance and covariance z1
preEnj ~~ preEnj

preMap ~~ preMap
preEnj ~~ preMap

# Create between components (random intercepts)
RIEnj =~ 1*Enj1+1*Enj2+1*Enj3+1*Enj4+1*Enj5+1*Enj6+1*Enj7+1*Enj8+1*Enj9+1*Enj10+1*Enj11+1*Enj12+1*Enj13

