wEnj5 ~~ rvEnj5*wEnj5
wEnj6 ~~ rvEnj6*wEnj6
wEnj7 ~~ rvEnj7*wEnj7
wEnj8 ~~ rvEnj8*wEnj8
wEnj9 ~~ rvEnj9*wEnj9
wEnj10 ~~ rvEnj10*wEnj10
wEnj11 ~~ rvEnj11*wEnj11
wEnj12 ~~ rvEnj12*wEnj12
wEnj13 ~~ rvEnj13*wEnj13

wMap2 ~~ rvMap2*wMap2
wMap3 ~~ rvMap3*wMap3
wMap4 ~~ rvMap4*wMap4
wMap5 ~~ rvMap5*wMap5
wMap6 ~~ rvMap6*wMap6
wMap7 ~~ rvMap7*wMap7
wMap8 ~~ rvMap8*wMap8
wMap9 ~~ rvMap9*wMap9
wMap10 ~~ rvMap10*wMap10
wMap11 ~~ rvMap11*wMap11
wMap12 ~~ rvMap12*wMap12
wMap13 ~~ rvMap13*wMap13

# Compute corEnjation of within-components at each wave
cor2 := b*d + a*d*cor1 + rcov2
cor3 := b*d + a*d*cor2 + rcov3
cor4 := b*d + a*d*cor3 + rcov4
cor5 := b*d + a*d*cor4 + rcov5
cor6 := b*d + a*d*cor5 + rcov6
cor7 := b*d + a*d*cor6 + rcov7
cor8 := b*d + a*d*cor7+ rcov8
cor9 := b*d + a*d*cor8 + rcov9
cor10 := b*d + a*d*cor9 + rcov10
cor11 := b*d + a*d*cor10 + rcov11
cor12 := b*d + a*d*cor11 + rcov12
cor13 := b*d + a*d*cor12 + rcov13

# Contrain residual variances of within-components such that variance of each
# within-component equals 1
rvEnj2 == 1 - (a*a + b*b + 2*a*b*cor1)
rvEnj3 == 1 - (a*a + b*b + 2*a*b*cor2)
rvEnj4 == 1 - (a*a + b*b + 2*a*b*cor3)
rvEnj5 == 1 - (a*a + b*b + 2*a*b*cor4)
rvEnj6 == 1 - (a*a + b*b + 2*a*b*cor5)
rvEnj7 == 1 - (a*a + b*b + 2*a*b*cor6)
rvEnj8 == 1 - (a*a + b*b + 2*a*b*cor7)
rvEnj9 == 1 - (a*a + b*b + 2*a*b*cor8)
rvEnj10 == 1 - (a*a + b*b + 2*a*b*cor9)
rvEnj11 == 1 - (a*a + b*b + 2*a*b*cor10)
rvEnj12 == 1 - (a*a + b*b + 2*a*b*cor11)
rvEnj13 == 1 - (a*a + b*b + 2*a*b*cor12)

rvMap2 == 1 - (d*d)
rvMap3 == 1 - (d*d)
rvMap4 == 1 - (d*d)
rvMap5 == 1 - (d*d)
rvMap6 == 1 - (d*d)
rvMap7 == 1 - (d*d)
rvMap8 == 1 - (d*d)
rvMap9 == 1 - (d*d)
rvMap10 == 1 - (d*d)
rvMap11 == 1 - (d*d)
rvMap12 == 1 - (d*d)
rvMap13 == 1 - (d*d)
'
fit.RICLPMConstraintsEnjMap <- blavaan(fit.RICLPMConstraintsEnjMap, data=dat,target = "stan",   meanstructure = T, # add the intercepts or means of the observed variables
                                       fixed.x = TRUE,int.ov.free = T,
                                       n.chains = 2, burnin = 200, sample = 2000, bcontrol = list(cores = 4), mcmcfile = TRUE)
summary(fit.RICLPMConstraintsEnjMap)

Best,
Yuan

