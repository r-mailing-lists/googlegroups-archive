> > > > > > > library('poppr')
> > > > > > > data('Pram')
> > > > > > > poppr.amova(Pram, ~YEAR) # within individual calculation
> > > > > > >
> > > > > > > ##  No missing values detected.
> > > > > > > ##
> > > > > > > ## $call
> > > > > > > ## ade4::amova(samples = xtab, distances = xdist, structures = xstruct)
> > > > > > > ##
> > > > > > > ## $results
> > > > > > > ##                               Df    Sum Sq   Mean Sq
> > > > > > > ## Between YEAR                  15  101.0174 6.7344930
