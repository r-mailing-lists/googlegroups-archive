     "<div dir=\"ltr\"><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">devtools</span><span style=\"color:#660\">::</span><span style=\"color:#000\">source_gist</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;</span><a href=\"https://gist.github.com/zkamvar/b64078a0d04d2452c905\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://gist.github.com/zkamvar/b64078a0d04d2452c905&amp;source=gmail&amp;ust=1792480953638000&amp;usg=AOvVaw1louttR2iPtqIH5D7wnPPe\"><span style=\"color:#080\">https://gist.github.com/zkamvar/b64078a0d04d2452c905</span></a><span style=\"color:#080\">&quot;</span><span style=\"color:#660\">,</span></div></code></div></div>"
