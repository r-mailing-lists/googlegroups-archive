tstMap<-raster(x,nrows=N, ncols=N,vals=0)

setColors(tstMap, n=3) <- c("green","red")

tstMap[c(1,10,100)]<-1
tstMap[40:120]<-2
Plot(tstMap,new=TRUE, legendRange=0:2)

