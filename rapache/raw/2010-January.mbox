Here's a better way to fail:

handler <- function(){
    setContentType('text/html')

    mem.limits(vsize=50*1024*1024)
    cat("<h1>BigMem Test</h1>")
    if (!is.null(GET$N)){
        cat("<p>N=",GET$N,"</p>")
        cat("<pre>")

        x <- try(rnorm(as.integer(GET$N)))
        if (!inherits(x,'try-error')){

            str(x)
            cat("</pre>")
            cat("object size says ",object.size(x)/1024/1024," Mb")

        } else {
            cat("too big an object!</pre>")
        }
    }
    OK
}

Jeff

