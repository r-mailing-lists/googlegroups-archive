    [
     3,
     "<div><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\">\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">Hello again,<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">I have implemented now simple HTML site with a textarea as my “Console”<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">To send the data to R, I tried out (among other):<u></u><u></u></p><p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">\r\n\r\n<br></p><p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"></p><p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><font face=\"courier new, monospace\">$.post(&quot;/R/test.R&quot;, $(&quot;#terminal&quot;).val(),\r\nfunction(data) {<u></u><u></u></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><font face=\"courier new, monospace\">    $(&quot;#result&quot;).html(data);<u></u><u></u></font></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><font face=\"courier new, monospace\">});</font><u></u><u></u></p><p></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">#result is a normal div. <u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">Unfortunately I don’t get any result.<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">I have seen that, Gergely uses RHTML. I want to avoid this format. Only\r\n.R or .html file. <u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">Does anyone know how I could send the terminal data into a File that RApache\r\ncould interpret?<u></u><u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\"><u></u> <u></u></p>\r\n\r\n<p class=\"MsoNormal\" style=\"margin-bottom:0cm;margin-bottom:.0001pt;line-height:normal\">Cheers,<u></u><u></u></p></blockquote></div></div>"
