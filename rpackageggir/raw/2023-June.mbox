  includedaycrit = 1, #min hrs of wear in a day needed
  #M5L5res = 10, # resolution of L5 and M5 analysis in minutes (default: 10 minutes
  winhr = 5, #Vector of window size(s) (unit: hours) of L5 and M5 analysis (default = 5 hours)
  qlevels = c(), #quantiles, set to () if you do not want quantiles
  qwindow=c(5,24), #how to segment the day for day-segment specific analysis; If value =c(5,24)variables will be calculated over the window 0-5, 5-24 and 0-24
  L5M5window = c(5,24),
  ilevels = (c(0,50,150,500,8000)), #acceleration values (metric ENMO) # Values based on Hildebrand & Sanders et al (Van Horn), 2019
