Hi,

I am experiencing the same issue (using GGIR Version 2.9.4). For me, the error appears in Part 2. I have tried it with different files and get the same error message each time. See below for my code and the error message. Here is a link  <https://drive.google.com/file/d/1N36UtXTGp_dLFRwxJ1CbZtGOfcUxsGUx/view?usp=sharing>to a sample file

library(remotes)
remotes::install_github("wadpac/GGIR")
remotes::install_github("wadpac/GGIR", ref = "master")

#  Current Working Directories --------------------------------------------
shell.input <- "R:/Sweeney_Research/TEAM ActiGraph Data/RAW CSV Zipped/Cohort 2/Post/test"
shell.output <- "R:/Sweeney_Research/TEAM ActiGraph Data/Post-Process/Cohort 2/Post"

# Processing Shell Script -------------------------------------------------

# Set number of files in the directory
f1 = as.numeric(length(list.files(shell.input)));f1

g.shell.GGIR(
  #general parameters#
  mode=c(1,2),
  datadir=shell.input,
  outputdir=shell.output,
  f0=1,
  f1=f1,
  #overwrite=FALSE, #Overwrite previously generated milestone data by this function for this particular dataset.  If FALSE then it will skip the previously processed files (default =FALSE)
  do.imp=FALSE, #Whether to impute missing value
  idloc=2, #id location (1=file header, 2 = file name)
  print.filename=TRUE,
  storefolderstructure=FALSE,
  #-------------------------------
  #Part 1 parameters
  #-------------------------------
  # Key functions: reading file, auto-calibration, and extracting features
  windowsizes = c(1,900,3600), #epoch length and non-wear detection window 900 and 3600 are default
  do.cal=TRUE, #apply autocalibration (recommended)
  do.enmo = TRUE, # if TRUE (default), calculate metric ENMO with negative values rounded to zero
  chunksize=1,#specificy the size of chunks to be loaded as fraction of a 24 hour period, e.g.  0.5 equals 12 hour chunks. The default is 1(24 hrs).
  printsummary=TRUE,
  #-------------------------------
  # Part 2 parameters:
  #-------------------------------
  #Key functions: non-wear, auto-calibration, non-wear detection resolution, non-wear detection eval window
  strategy = 1, # Value = 1 means select data based on hrs.del.start,hrs.del.end, and maxdur.
  #ndayswindow=7, #only relevant when strategy = 3
  hrs.del.start = 0, #only relevant when strategy =2, how many hrs need to be ignored at beginning of measurement?
  hrs.del.end = 0, #only relevant when strategy =2, how many hrs need to be ignored at end of measurement?
