  do.anglez = TRUE, #default is true

  do.neishabouricounts = TRUE,

  part5_agg2_60sec = FALSE,

  printsummary=FALSE,

  # Part 2 – data quality and descriptives
  strategy = 1,

  maxdur = 0,
  max_calendar_days = 0,

  hrs.del.start = 0, #only needed for strategy 1
  hrs.del.end = 0, #only needed for strategy 1

