     loglocation = ""
     relyonguider = TRUE,
     do.visual = TRUE,
HASPT.algo = c("NotWorn"),
 HASIB.algo = "NotWorn",
 HASPT.ignore.invalid = NA,

If anyone has any advice I would very much appreciate it.

Many thanks,
Regards,
