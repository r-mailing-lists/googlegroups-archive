     hrs.del.start = 1,
     hrs.del.end = 1,
     maxdur = 0,
     includedaycrit = 16,
     M5L5res = 10,
     winhr = c(5,10),
     qwindow = c(0,24),
     mvpathreshold = c(100,120),
     #-------------------------------
     # Part 3 parameters:
     #-------------------------------
     timethreshold = 5,
     anglethreshold = 5,
     ignorenonwear = TRUE,
     #-------------------------------
     # Part 4 parameters:
     #-------------------------------
     excludefirstlast = FALSE,
     includenightcrit = 16,
     nnights = 14,
     loglocation = "E:/mystudy/sleepdiary/sleeplog.csv",
     outliers.only = FALSE,
     relyonguider = FALSE,
     colid = 1,
     coln1 = 2,
     do.visual = TRUE,
