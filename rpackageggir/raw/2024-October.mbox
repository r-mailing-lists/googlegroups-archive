             do.anglez=TRUE,
             chunksize=1,
             printsummary=TRUE,

             # Part 2 parameters:
             strategy = 1,
             maxdur = 20,
             includedaycrit = 6,
             M5L5res = 10,
             winhr = c(5,10),
             qwindow=c(0,8,21,24),
             ilevels = c(),
             iglevels = TRUE,
             mvpathreshold =c(69.1),
             bout.metric = 4,
             closedbout=FALSE,
             params_247=TRUE,
             epochvalues2csv=TRUE,

             # Part 3 parameters:
             do.part3.pdf=TRUE,
             anglethreshold=5,
             timethreshold= 5,
             ignorenonwear = FALSE,

             # Part 4 parameters:
             excludefirstlast = FALSE,
             includenightcrit = 6,
             do.visual = TRUE,
             HASIB.algo="ColeKripke1992",
             sleepwindowType="SPT",
