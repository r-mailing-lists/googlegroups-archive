boutcriter.in <http://boutcriter.in> = 0.9, boutcriter.lig = 0.9, boutcriter.mvpa = 0.9,

boutdur.in <http://boutdur.in> = c(30), boutdur.lig = c(30), boutdur.mvpa = c(1, 10, 30),

includedaycrit.part5 = 2/3,

