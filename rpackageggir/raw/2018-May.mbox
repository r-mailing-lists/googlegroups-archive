             excludefirstlast.part5 = TRUE,
             threshold.lig = c(50),
             threshold.mod = c(100),
             threshold.vig = c(400),
             boutcriter = 0.8,
             boutcriter.in <http://boutcriter.in> = 0.9,
             boutcriter.lig = 0.8,
             boutcriter.mvpa = 0.8,
             boutdur.in <http://boutdur.in> = c(10,20,30),
             boutdur.lig = c(1,5,10),
             boutdur.mvpa = c(1,5,10),
