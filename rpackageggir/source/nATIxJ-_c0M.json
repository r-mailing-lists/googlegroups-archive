:italic\">#=====================</span></a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(144,32,0)\">def.noc.sleep =</span> <span style=\"color:rgb(64,160,112)\">1</span>,</a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(144,32,0)\">outliers.only =</span> <span style=\"color:rgb(0,112,32)\">TRUE</span>,</a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(144,32,0)\">criterror =</span> <span style=\"color:rgb(64,160,112)\">4</span>,</a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(144,32,0)\">do.visual =</span> <span style=\"color:rgb(0,112,32)\">TRUE</span>,</a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(96,160,176);font-style:italic\">#=====================</span></a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(96,160,176);font-style:italic\"># Part 5</span></a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(96,160,176);font-style:italic\">#=====================</span></a>\r\n<a style=\"color:inherit;display:inline-block;line-height:1.25;text-decoration:inherit\" rel=\"nofollow\">             <span style=\"color:rgb(144,32,0)\">threshold.lig =</span> <span style=\"color:rgb(0,112,32);font-weight:bold\">c</span>(<span style=\"color:rgb(64,160,112)\">30</span>), <span style=\"color:rgb(144,32,0)\">threshold.mod =</span> <span style=\"color:rgb(0,112,32);font-weight:bold\">c</