ont-family:Calibri;color:black\"><font size=\"2\"> </font></span></p>\r\n  </td>\r\n  <td width=\"231\" style=\"width:173pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;unicode-bidi:embed;vertical-align:bottom;word-break:normal\"></p>\r\n  </td>\r\n  <td width=\"261\" style=\"width:196pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;unicode-bidi:embed;vertical-align:bottom;word-break:normal\"></p>\r\n  </td>\r\n </tr>\r\n <tr height=\"33\" style=\"height:24.92pt\">\r\n  <td height=\"33\" width=\"304\" style=\"height:24.92pt;width:228pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;unicode-bidi:embed;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">2014-10-26T02:00:00+0200</font></span></p>\r\n  </td>\r\n  <td width=\"231\" style=\"width:173pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;unicode-bidi:embed;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">0.006182916</font></span></p>\r\n  </td>\r\n  <td width=\"261\" style=\"width:196pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;unicode-bidi:embed;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">30.91934763</font></span></p>\r\n  </td>\r\n </tr>\r\n</tbody></table><br></div><div>I am trying to figure out how I should remove the duplicate lines. This line is not as same as the record at 1:00 and 3:00.</div><div>In brief, the data has one hour duplicate inputs from 2:00-3:00am (which might be 12:00-1:00am in Europe</div><div><br></div><div>Thanks</div><div>Best,</div><div>Wei</div></div>\r\n\r\n<p></p></blockquote></div>"
