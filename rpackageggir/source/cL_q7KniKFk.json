;width:228pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">2014-10-26T02:00:00+0100</font></span></p>\r\n  </td>\r\n  <td width=\"231\" style=\"width:173pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">0.004504047</font></span></p>\r\n  </td>\r\n  <td width=\"261\" style=\"width:196pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">10.67929374</font></span></p>\r\n  </td>\r\n </tr>\r\n <tr height=\"27\" style=\"height:20.6pt\">\r\n  <td height=\"27\" width=\"304\" style=\"height:20.6pt;width:228pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\"> </font></span></p>\r\n  </td>\r\n  <td width=\"231\" style=\"width:173pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;vertical-align:bottom;word-break:normal\"></p>\r\n  </td>\r\n  <td width=\"261\" style=\"width:196pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;vertical-align:bottom;word-break:normal\"></p>\r\n  </td>\r\n </tr>\r\n <tr height=\"33\" style=\"height:24.92pt\">\r\n  <td height=\"33\" width=\"304\" style=\"height:24.92pt;width:228pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">2014-10-26T02:00:00+0200</font></span></p>\r\n  </td>\r\n  <td width=\"231\" style=\"width:173pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">0.006182916</font></span></p>\r\n  </td>\r\n  <td width=\"261\" style=\"width:196pt\">\r\n  <p style=\"margin-top:0pt;margin-bottom:0pt;margin-left:0in;text-align:right;direction:ltr;vertical-align:bottom;word-break:normal\"><span style=\"font-family:Calibri;color:black\"><font size=\"2\">30.91934763</font></span></p>\r\n  </td>\r\n </tr>\r\n</tbody></table><br></div><div>I am trying to figure out how I should remove the duplicate lines. This line is not as same as the record at 1:00 and 3:00.</div><div>In brief, the data has one hour duplicate inputs from 2:00-3:00am (which might be 12:00-1:00am in Europe</div><div><br></div><div>Thanks</div><div>Best,</div><div>Wei</div></div>\r\n\r\n<p></p>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;R package GGIR&quot; group.<br>\r\nTo unsubscribe from this group and stop receiving emails from it, send an email to <a rel=\"nofollow\">RpackageGGIR...@googlegroups.com</a>.<br>\r\nTo post to this group, send email to <a rel=\"nofollow\">Rpacka...@googlegroups.com</a>.<br>\r\nVisit this group at <a href=\"https://groups.google.com/group/RpackageGGIR\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/group/RpackageGGIR&amp;source=gmail&amp;ust=1792491410585000&amp;usg=AOvVaw3xrZKpof0cmoXE2bJv-3MF\">https://groups.google.com/group/RpackageGGIR</a>.<br>\r\nTo view this discussion on the web, visit <a href=\"https://groups.google.com/d/msgid/RpackageGGIR/eecea811-a1d9-4b1d-9141-732c21a75fb8%40googlegroups.com?utm_medium=email&amp;utm_source=footer\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/d/msgid/RpackageGGIR/eecea811-a1d9-4b1d-9141-732c21a75fb8%2540goog