-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\"><br></span></span></div><div><span style=\"font-family:&quot;Lucida Console&quot;,monospace;font-size:13.3333px;outline:none;border:none;word-break:break-all;margin:0px;line-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\">Any thought would be greatly appreciated. </span></span></div><div><span style=\"font-family:&quot;Lucida Console&quot;,monospace;font-size:13.3333px;outline:none;border:none;word-break:break-all;margin:0px;line-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\"><br></span></span></div><div><span style=\"font-family:&quot;Lucida Console&quot;,monospace;font-size:13.3333px;outline:none;border:none;word-break:break-all;margin:0px;line-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\">thanks </span></span></div><div><span style=\"font-family:&quot;Lucida Console&quot;,monospace;font-size:13.3333px;outline:none;border:none;word-break:break-all;margin:0px;line-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\"><br></span></span></div><div><span style=\"font-family:&quot;Lucida Console&quot;,monospace;font-size:13.3333px;outline:none;border:none;word-break:break-all;margin:0px;line-height:1.2\" role=\"document\" aria-label=\"Console Output\"><span style=\"outline:none\" role=\"document\">James\r\n\r\n<font color=\"#000000\">\r\n\r\n\r\n</font></span></span></div>\r\n\r\n<p></p></blockquote></div>"
