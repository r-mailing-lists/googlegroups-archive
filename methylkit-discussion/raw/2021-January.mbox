> > > >       context = x@context,
> > > >       treatment=x@treatment,
> > > >       coverage.index=x...@coverage.index,
> > > >       numCs.index=x...@numCs.index,
> > > >       numTs.index=x...@numTs.index,
> > > >       destranded=x@destranded,
> > > >       resolution =x@resolution)
> > > > }
> > > > ```
> > > >
> > > > ```
> > > > data("methylKit")
