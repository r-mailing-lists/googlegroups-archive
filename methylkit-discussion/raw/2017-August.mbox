                           hi.count=NULL, hi.perc=99.9, save.db = F)
myobj.fu <- unite(myobj.f, destrand=TRUE, save.db = TRUE,
                  db.dir = "test_DB")

## Does not work!
re <- methRead(location = "test_DB/test1_test2_ctrl1_ctrl2.txt.bgz",
               sample.id=list("test1","test2","ctrl1","ctrl2"),
               assembly="hg18",treatment=c(1,1,0,0),
               dbtype = "tabix")

