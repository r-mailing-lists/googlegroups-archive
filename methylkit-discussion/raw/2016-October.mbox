Hi,

I am new to using methylkit and am wondering is there a way to read in multiple assembly files. Below, is the code I used and the error I get:

file.list=list( "~/reads/trimmed_New_9-4_1_R1_bismark_bt2_pe.bismark.cov",
                 "~/reads/trimmed_New_9-4_2_R1_bismark_bt2_pe.bismark.cov",
                "~/reads/trimmed_New_9-4_3_R1_bismark_bt2_pe.bismark.cov",
                "~/reads/trimmed_SWS484_1_R1_bismark_bt2_pe.bismark.cov",
                                 "~/reads/trimmed_SWS484_2_R1_bismark_bt2_pe.bismark.cov",
                                 "~/reads/trimmed_SWS484_3_R1_bismark_bt2_pe.bismark.cov")

myobj=methRead( file.list,
                 pipeline="bismarkCoverage", sample.id=list("New_9_4_1","New_9_4_2","New_9_4_3","SWS484_1","SWS484_2","SWS484_3"),assembly=c("~/new94/new94.consensus.fasta","~/new94/new94.consensus.fasta","~/new94/new94.consensus.fasta","~/sws484/sws484.consensus.fasta","~/sws484/sws484.consensus.fasta","~/sws484/sws484.consensus.fasta"),treatment=c(1,1,1,0,0,0))

meth=unite(myobj, destrand=FALSE)

However, when I try to unite the objects I get the following error:
Error in vapply(object, function(x) x@assembly, FUN.VALUE = "character") :
  values must be length 1,
 but FUN(X[[1]]) result is length 6

Any help you can provide is greatly appreciated,
Muna

