prom.diff=myDiff[ann.mat[,1]==1,]
df1=getData(prom.diff)
write.table(df1,file="filename.txt",sep="\t",quote=FALSE,
row.names=FALSE)

# check the help pages to get more info
help(getData)
help(write.table)

