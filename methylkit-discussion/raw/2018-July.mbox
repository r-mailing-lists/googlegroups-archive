> myobj=methRead(file.list.sample.id <http://file.list.sample.id>=list("j","k","a","b","c"),assembly='rn6',treatment=c(1,1,0,0,0))
> meth=unite(myobj, destrand=FALSE)
> meth.min=unite(myobj.min.per.group=3L)
