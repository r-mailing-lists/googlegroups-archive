r=\"#000000\" size=\"3\">0</font></td>\r\n  <td style=\"border-width:0px 0.5pt 0.5pt 0px;border-style:none solid solid none;border-color:black windowtext windowtext black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\">0</font></td>\r\n  <td style=\"border-width:0px 0.5pt 0.5pt 0px;border-style:none solid solid none;border-color:black windowtext windowtext black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\">-15.129</font></td>\r\n </tr>\r\n\r\n</tbody></colgroup></table></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;width:48pt;background-color:transparent\" width=\"64\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n </tr>\r\n <tr style=\"height:15pt\" height=\"20\">\r\n  <td style=\"border:0px black;height:15pt;background-color:transparent\" height=\"20\"><font face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\">0</font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\">0</font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"></td>\r\n </tr>\r\n <tr style=\"height:15pt\" height=\"20\">\r\n  <td style=\"border:0px black;height:15pt;background-color:transparent\" height=\"20\"><font face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\">0</font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\">0</font></td>\r\n  <td style=\"border:0px black;background-color:transparent\" align=\"right\"><font color=\"#000000\" size=\"3\" face=\"Calibri\"></font></td>\r\n </tr>\r\n\r\n</tbody></colgroup></table></div><div> </div><div>Given the small differentially methylation difference between the treated and control group, the p and q value looks a little suspicious as I expect a little more variation between groups.</div><div> </div><div>My questions are:</div><div>(1) Is it normal to have a p and q value of zero? </div><div>(2) How is regional analysis calculated? My current understanding is that the counts for Cs (methylated) and Ts (unmethylated) are summed across regions and a logistic regression is performed between stress and control groups. Is my understanding of it correct?  </div><div> </div><div>Thanks</div><div> </div></div>"
    ]
   ]
