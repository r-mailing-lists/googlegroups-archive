le=\"width:22pt\" width=\"29\">ctl4</td>\r\n  <td style=\"width:22pt\" width=\"29\">ctl5</td>\r\n  <td style=\"width:22pt\" width=\"29\">ctl6</td>\r\n </tr>\r\n <tr style=\"height:14.4pt\" height=\"19\">\r\n  <td style=\"height:14.4pt\" height=\"19\">chr1_821401_821401</td>\r\n  <td>90</td>\r\n  <td>10</td>\r\n  <td>NA</td>\r\n  <td>NA</td>\r\n  <td>100</td>\r\n  <td>NA</td>\r\n  <td>80</td>\r\n  <td>96</td>\r\n  <td>91</td>\r\n  <td>69</td>\r\n  <td>58</td>\r\n  <td>0</td>\r\n </tr>\r\n</tbody></table><br><br><br>\r\n <table width=\"555\" cellspacing=\"0\" cellpadding=\"0\" border=\"0\"><colgroup><col style=\"width:101pt\" width=\"135\">\r\n <col style=\"width:31pt\" width=\"41\" span=\"6\">\r\n <col style=\"width:22pt\" width=\"29\" span=\"6\">\r\n </colgroup><tbody><tr style=\"height:14.4pt\" height=\"19\">\r\n  <td style=\"height:14.4pt;width:101pt\" width=\"135\" height=\"19\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:31pt\" width=\"41\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n  <td style=\"width:22pt\" width=\"29\"><br></td>\r\n </tr>\r\n <tr style=\"height:14.4pt\" height=\"19\">\r\n  <td style=\"height:14.4pt\" height=\"19\"><br></td>\r\n  <td align=\"right\"><br></td>\r\n  <td align=\"right\"><br></td>\r\n  <td><br></td>\r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n  \r\n </tr>\r\n</tbody></table></div>"
