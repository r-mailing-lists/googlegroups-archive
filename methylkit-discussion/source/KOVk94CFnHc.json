     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div style=\"font-family:Calibri,Arial,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0);background-color:rgb(255,255,255)\">\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\nplz I&#39;m trying to perform the differential methylation analysis using the methylkit but I got this error:</p>\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\n<span style=\"color:rgb(237,92,87)\"><b>Trying to process: /path/to/bam/test.sorted.bam Using htslib. Error: Unexpected cigar: M</b></span></p>\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\nPlz can anyone help?</p>\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\n<strong style=\"margin:0px;font-weight:bold\">R script:</strong></p>\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\n<strong style=\"margin:0px;font-weight:bold\"></strong></p>\r\n<pre style=\"margin:0px 0px calc(1.5em);font-weight:400;width:auto;max-height:600px;overflow:auto\"><code style=\"margin:0px\">processBismarkAln<span style=\"margin:0px;font-size:13px\">(</span>\n  location <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">&quot;test.sorted.bam&quot;</span><span style=\"margin:0px;font-size:13px\">,</span>\n  <a href=\"http://sample.id\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://sample.id&amp;source=gmail&amp;ust=1793230846578000&amp;usg=AOvVaw0-wSGbz7a9J4QZjRzO4Nm8\">sample.id</a> <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">&quot;NULL&quot;</span><span style=\"margin:0px;font-size:13px\">,</span>\n  assembly <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">&quot;susScr11&quot;</span><span style=\"margin:0px;font-size:13px\">,</span>\n  save.folder <span style=\"margin:0px;font-size:13px\">=</span> getwd<span style=\"margin:0px;font-size:13px\">(</span><span style=\"margin:0px;font-size:13px\">)</span><span style=\"margin:0px;font-size:13px\">,</span>\n  save.context <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">c</span><span style=\"margin:0px;font-size:13px\">(</span><span style=\"margin:0px;font-size:13px\">&quot;CpG&quot;</span><span style=\"margin:0px;font-size:13px\">)</span><span style=\"margin:0px;font-size:13px\">,</span>\n  read.context <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">&quot;CpG&quot;</span><span style=\"margin:0px;font-size:13px\">,</span>\n  nolap <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">FALSE</span><span style=\"margin:0px;font-size:13px\">,</span>\n  mincov <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">10</span><span style=\"margin:0px;font-size:13px\">,</span>\n  minqual <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">20</span><span style=\"margin:0px;font-size:13px\">,</span>\n  phred64 <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">FALSE</span><span style=\"margin:0px;font-size:13px\">,</span>\n  treatment <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">NULL</span><span style=\"margin:0px;font-size:13px\">,</span>\n  save.db <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">FALSE</span><span style=\"margin:0px;font-size:13px\">,</span>\n  verbose <span style=\"margin:0px;font-size:13px\">=</span> <span style=\"margin:0px;font-size:13px\">1</span><span style=\"margin:0px;font-size:13px\">)</span></code></pre>\r\n<br>\r\n\r\n<p></p>\r\n<p style=\"margin:0px 0px 1.1em;font-family:-apple-system,&quot;system-ui&quot;,&quot;Segoe UI Adjusted&quot;,&quot;Segoe UI&quot;,&quot;Liberation Sans&quot;,sans-serif;font-size:15px;clear:both;color:rgb(35,38,41);text-align:left;background-color:rgb(255,255,255)\">\r\n<strong style=\"margin:0px;font-weight:bold\"><br>\r\n</strong></p>\r\n<br>\r\n</div>\r\n</div>\r\n\r\n"
