"color:#008\">ref</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> </span><span style=\"color:#008\">ref</span><span style=\"color:#660\">[,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">10</span><span style=\"color:#660\">])</span><span style=\"color:#000\"> </span><span style=\"color:#660\">:</span><span style=\"color:#000\"> invalid </span><span style=\"color:#080\">&#39;times&#39;</span><span style=\"color:#000\"> argument<br></span><span style=\"color:#606\">In</span><span style=\"color:#000\"> addition</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Warning</span><span style=\"color:#000\"> message</span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">In</span><span style=\"color:#000\"> </span><span style=\"color:#080\">`[.data.frame`</span><span style=\"color:#660\">(</span><span style=\"color:#008\">ref</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> rep</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\">nrow</span><span style=\"color:#660\">(</span><span style=\"color:#008\">ref</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> </span><span style=\"color:#008\">ref</span><span style=\"color:#660\">[,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">10</span><span style=\"color:#660\">]),</span><span style=\"color:#000\"> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br>  </span><span style=\"color:#606\">NAs</span><span style=\"color:#000\"> introduced </span><span style=\"color:#008\">by</span><span style=\"color:#000\"> coercion<br><br></span></div></code></div><div><br><br></div><div><br></div><div>the BED file was created from the gtf file downloaded from Ensembl Fungi