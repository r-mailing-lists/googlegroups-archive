a(0,0,0,0.298039);text-align:right;white-space:nowrap;vertical-align:top;border-style:solid;border-color:rgb(238,238,238);border-width:0px 1px 0px 0px\"></td><td style=\"padding:0px 10px;line-height:20px;vertical-align:top;overflow:visible;font-family:Consolas,&#39;Liberation Mono&#39;,Menlo,Courier,monospace;font-size:12px;word-wrap:normal;white-space:pre\">      <span style=\"color:rgb(237,106,67)\">my.ind</span><span style=\"color:rgb(167,29,93)\">=</span><span>coverage.ind</span>[<span>object</span><span style=\"color:rgb(167,29,93)\">@</span><span>treatment</span><span style=\"color:rgb(167,29,93)\">==</span><span>i</span>]</td></tr><tr><td style=\"padding:0px 10px;width:50px;min-width:50px;font-family:Consolas,&#39;Liberation Mono&#39;,Menlo,Courier,monospace;font-size:12px;line-height:20px;color:rgba(0,0,0,0.298039);text-align:right;white-space:nowrap;vertical-align:top;border-style:solid;border-color:rgb(238,238,238);border-width:0px 1px 0px 0px\"></td><td style=\"padding:0px 10px;line-height:20px;vertical-align:top;overflow:visible;font-family:Consolas,&#39;Liberation Mono&#39;,Menlo,Courier,monospace;font-size:12px;word-wrap:normal;white-space:pre\">      <span style=\"color:rgb(237,106,67)\">ldat</span> <span style=\"color:rgb(167,29,93)\">=</span> <span style=\"color:rgb(167,29,93)\">!</span><a href=\"http://is.na\" rel=\"nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://is.na&amp;source=gmail&amp;ust=1793233164554000&amp;usg=AOvVaw3Ig41XW6mQBVsw7B79D8HB\">is.na</a>(<span>df</span>[,<span>my.ind</span>,<span style=\"color:rgb(237,106,67)\">with</span><span style=\"color:rgb(167,29,93)\">=</span><span style=\"color:rgb(0,134,179)\">FALSE</span>])</td></tr><tr><td style=\"padding:0px 10px;width:50px;min-width:50px;font-family:Consolas,&#39;Liberation Mono&#39;,Menlo,Courier,monospace;font-size:12px;line-height:20px;color:rgba(0,0,0,0.298039);text-align:right;white-space:nowrap;vertical-align:top;border-sty