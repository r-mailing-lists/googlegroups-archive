#Predefine the env
input = list()
    input$data = mtcars
    input$variables = c("mpg","cyl","disp")

#Embedded function
string_gen <- function(input,rowid)
{
    do.call(paste,
    lapply(input$variables,function(var){
     paste(var,': ',input$data[rowid,which(colnames(input$data) == var)],'<br>',sep="")
})
    )

}

tooltip_info <- function(x=NULL) {
    if(is.null(x)) return(NULL)
key = x["keys"][[1]]

string_gen(input=input, rowid=key)

}

mtcars$keys <- seq(1, nrow(mtcars))
    ggvis(mtcars,
   props(
    x= ~mpg,
    y=~qsec,
    fill=~as.factor(cyl),
    key := ~keys)) + layer_point()+
tooltip(tooltip_info)

