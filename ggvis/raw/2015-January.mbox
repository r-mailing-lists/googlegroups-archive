#simulated data
rs<-abs(rnorm(50, mean= 25, sd = 10))
#cut creates a factor and you can tell it where to cut, store this in your data.frame as a new column
cut(rs, breaks = c(10, 20, 30, 40, 50))

#then fill your paths according to this factor

ggvis() %>%
  layer_paths(data = activemap, x = ~long, y = ~lat,
              strokeOpacity := 0.75, stroke = ~score, strokeWidth := 3,

              fill = ~factor(cut), fillOpacity := 0.3) %>%

  scale_numeric("stroke", range = c("lightgrey", "blue")) %>%
  scale_numeric("fill", range = c("lightgrey", "blue"))

I haven't really used ggvis much so this might not work, this is just based upon what I've done in ggplot2.

