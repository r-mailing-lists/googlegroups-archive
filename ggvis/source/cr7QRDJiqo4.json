ier new, monospace\">  layer_points()</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\">choices &lt;- c(&quot;y1&quot;, &quot;y2&quot;)</font></div><div><font face=\"courier new, monospace\">choices_name &lt;- c(y1 = <a href=\"http://as.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://as.name&amp;source=gmail&amp;ust=1792484961058000&amp;usg=AOvVaw1UmczUq37FABVMfpvgfB-1\">as.name</a>(&quot;y1&quot;), y2 = <a href=\"http://as.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://as.name&amp;source=gmail&amp;ust=1792484961058000&amp;usg=AOvVaw1UmczUq37FABVMfpvgfB-1\">as.name</a>(&quot;y2&quot;))</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"># what is the right way to get this to work?</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"># error</font></div><div><font face=\"courier new, monospace\">df %&gt;% </font></div><div><font face=\"courier new, monospace\">  ggvis(x = ~x, y = <a href=\"http://as.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://as.name&amp;source=gmail&amp;ust=1792484961058000&amp;usg=AOvVaw1UmczUq37FABVMfpvgfB-1\">as.name</a>(input_select(choices))) %&gt;%</font></div><div><font face=\"courier new, monospace\">  layer_points()</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"># error</font></div><div><font face=\"courier new, monospace\">df %&gt;% </font></div><div><font face=\"courier new, monospace\">  ggvis(x = ~x, y = input_select(<a href=\"http://as.name\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://as.name&amp;source=gmail&amp;ust=1792484961058000&amp;usg=AOvVaw1UmczUq37FABVMfpvgfB-1\">as.name</a>(choices))) %&gt;%</font></div><div><font face=\"courier new, monospace\">  layer_points()</font></div><div><font face=\"courier new, monospace\"><br></font></div><div><font face=\"courier new, monospace\"># error</font></div><div><font face=\"courier new, monospace\">df %&gt;% </font></div><div><font face=\"courier new, monospace\">  ggvis(x = ~x, y = input_select(choices_name)) %&gt;%</font></div><div><font face=\"courier new, monospace\">  layer_points()</font></div></div></div></blockquote></div></div>"
