pan style=\"color:#000\"><br>   ggvis</span><span style=\"color:#660\">(</span><span style=\"color:#000\">x </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">~</span><span style=\"color:#606\">Value</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> y </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#660\">~</span><span style=\"color:#606\">Subject</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>   layer_points</span><span style=\"color:#660\">()</span></div></code></div><div><br></div></div><p style=\"text-align:center;clear:both\"><a href=\"https://lh6.googleusercontent.com/-Ml_dpercFZc/VNP_WGy62jI/AAAAAAAAAJs/ivUBLie1-3Q/s1600/linebreak_eg.png\" style=\"margin-left:1em;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh6.googleusercontent.com/-Ml_dpercFZc/VNP_WGy62jI/AAAAAAAAAJs/ivUBLie1-3Q/s1600/linebreak_eg.png&amp;source=gmail&amp;ust=1792484522430000&amp;usg=AOvVaw1qz0iK_pQC28tEGcgS-j7L\"><img src=\"https://lh6.googleusercontent.com/-Ml_dpercFZc/VNP_WGy62jI/AAAAAAAAAJs/ivUBLie1-3Q/s320/linebreak_eg.png\" border=\"0\" width=\"320\" height=\"155\"></a></p><span><font color=\"#888888\"><div><br><div><br></div><div><br></div></div></font></span></div></blockquote></div></div>"
