lor:rgb(48,51,54)\">))</span></code></pre><p style=\"font-size:15px;clear:both;color:rgb(36,39,41);font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif\"><br></p><p style=\"font-size:15px;clear:both;color:rgb(36,39,41);font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif\">The above code creates the information needed for the vector loadings, which is then passed to the code below:</p><pre style=\"padding:5px;width:auto;max-height:600px;overflow:auto;font-family:Consolas,Menlo,Monaco,&quot;Lucida Console&quot;,&quot;Liberation Mono&quot;,&quot;DejaVu Sans Mono&quot;,&quot;Bitstream Vera Sans Mono&quot;,&quot;Courier New&quot;,monospace,sans-serif;background-color:rgb(239,240,241);color:rgb(57,51,24);word-wrap:normal\"><code style=\"font-family:Consolas,Menlo,Monaco,&quot;Lucida Console&quot;,&quot;Liberation Mono&quot;,&quot;DejaVu Sans Mono&quot;,&quot;Bitstream Vera Sans Mono&quot;,&quot;Courier New&quot;,monospace,sans-serif;white-space:inherit\"><span style=\"color:rgb(48,51,54)\">g </span><span style=\"color:rgb(48,51,54)\">&lt;-</span><span style=\"color:rgb(48,51,54)\"> g </span><span style=\"color:rgb(48,51,54)\">+</span><span style=\"color:rgb(48,51,54)\"> geom_segment</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">data </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> df.v</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> aes</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">x </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">0</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> y </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> </span><span style=\"color:rgb(125,39,39)\">0</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> xend </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> xvar</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> yend </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> yvar</span><span style=\"color:rgb(48,51,54)\">),</span><span style=\"color:rgb(48,51,54)\"> \r\narrow </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> arrow</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(48,51,54)\">length </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> unit</span><span style=\"color:rgb(48,51,54)\">(</span><span style=\"color:rgb(125,39,39)\">1</span><span style=\"color:rgb(48,51,54)\">/</span><span style=\"color:rgb(125,39,39)\">2</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(125,39,39)\">&quot;picas&quot;</span><span style=\"color:rgb(48,51,54)\">)),</span><span style=\"color:rgb(48,51,54)\"> \r\ncolor </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> color</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> linetype </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> linetype</span><span style=\"color:rgb(48,51,54)\">,</span><span style=\"color:rgb(48,51,54)\"> alpha </span><span style=\"color:rgb(48,51,54)\">=</span><span style=\"color:rgb(48,51,54)\"> alpha_arrow</span><span style=\"color:rgb(48,51,54)\">)</span></code></pre><p style=\"font-size:15px;clear:both;color:rgb(36,39,41);font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif\"><br></p><p style=\"font-size:15px;clear:both;color:rgb(36,39,41);font-family:Arial,&quot;Helvetica Neue&quot;,Helvetica,sans-serif\">However, I keep coming back to the same brick wall of not being able to create individual segments. Intuitively, it should be 