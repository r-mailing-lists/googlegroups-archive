     1,
     "<div style=\"word-wrap:break-word;line-break:after-white-space\"><div><div><blockquote type=\"cite\"><div><div style=\"font-family:Helvetica;font-size:12px;font-style:normal;font-variant-caps:normal;font-weight:normal;letter-spacing:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;text-decoration:none\"><div><div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:&quot;Times New Roman&quot;,serif\">Clayton<u></u><u></u></div><div><div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:&quot;Times New Roman&quot;,serif\"><u></u> <u></u></div></div><div><div style=\"margin:0in 0in 0.0001pt;font-size:12pt;font-family:&quot;Times New Roman&quot;,serif\"><span>&lt;image001.png&gt;</span><u></u><u></u></div></div></div></div></div></blockquote></div></div></div>"
