> > > > > > >
> > > > > > >                         K = 44,
> > > > > > >
> > > > > > >                         ntraps = 21,
> > > > > > >
> > > > > > >                         tdf.sep = "/")
> > > > > > >
> > > > > > >
> > > > > > >
> > > > > > > ocelot.sf <- ocelot.dat$scrFrame
> > > > > > >
> > > > > > > ocelot.ss <- make.ssDF(ocelot.sf, buffer = 2500, res = 250)
> > > > > > >
> > > > > > >
