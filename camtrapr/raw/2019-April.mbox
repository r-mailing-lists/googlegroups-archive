 - attr(*, "dimnames")=List of 2
  ..$ : chr [1:7] "Station01_session1" "Station01_session2" "Station18_session1" "Station21_session1" ...
  ..$ : chr [1:191] "2016-05-10" "2016-05-11" "2016-05-12" "2016-05-13" ...

