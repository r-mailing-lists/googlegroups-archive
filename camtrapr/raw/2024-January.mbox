                  stationCol = "Camera_Station",
                  cameraCol = "Camera_ID",
                  camerasIndependent = FALSE,
                  recordDateTimeCol = "DateTime",
                  recordDateTimeFormat = "ymd hms",
                  removeDuplicateRecords = TRUE,
                  writecsv = FALSE,
                  timeZone = "Brazil/East",

