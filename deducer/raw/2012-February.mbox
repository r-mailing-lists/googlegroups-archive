I accidentally hit submit to early.  Here's a possible fix.

if( length(dataset)==1)
{
dataset$Variable_Name <- sort(dataset, by=~ Variable_Name)
}
else
{
dataset<-sort(dataset, by=~ Variable_Name)

}

