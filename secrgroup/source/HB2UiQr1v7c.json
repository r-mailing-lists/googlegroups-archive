dding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\">0.58<u></u><u></u></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"156\" rowspan=\"5\" valign=\"top\" style=\"width:116.85pt;border:solid windowtext 1.0pt;border-top:none;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\">Secr.fit<u></u><u></u></p>\r\n</td>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.85pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\"><span style=\"color:black\">0.932615</span><u></u><u></u></p>\r\n</td>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.85pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\"><span style=\"color:black\">0.346818</span><u></u><u></u></p>\r\n</td>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.9pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\"><span style=\"color:black\">0.766296</span><u></u><u></u></p>\r\n</td>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.9pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\"><span style=\"color:black\">1.113114</span><u></u><u></u></p>\r\n</td>\r\n</tr>\r\n<tr>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.85pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 5.4pt\">\r\n<p class=\"MsoNormal\"><span style=\"color:black\">0.29744</span><u></u><u></u></p>\r\n</td>\r\n<td width=\"156\" valign=\"bottom\" style=\"width:116.85pt;border-top:none;border-left:none;border-bottom:solid windowtext 1.0pt;border-right:solid windowtext 1.0pt;padding:0cm 5.4pt 0cm 