    [
     1,
     "<div lang=\"EN-AU\" link=\"blue\" vlink=\"purple\"><div><div>\r\n<div style=\"border:none;border-top:solid #e1e1e1 1.0pt;padding:3.0pt 0cm 0cm 0cm\">\r\n<p class=\"MsoNormal\"><b><span lang=\"EN-US\">From:</span></b><span lang=\"EN-US\"> <a href data-email-masked rel=\"nofollow\">secr...@googlegroups.com</a> &lt;<a href data-email-masked rel=\"nofollow\">secr...@googlegroups.com</a>&gt;\r\n<b>On Behalf Of </b>Murray Efford<br>\r\n<b>Sent:</b> Friday, 4 October 2019 9:46 AM<br>\r\n<b>To:</b> secr &lt;<a href data-email-masked rel=\"nofollow\">secr...@googlegroups.com</a>&gt;<br>\r\n<b>Subject:</b> Re: moving.fit and intervals<u></u><u></u></span></p>\r\n</div>\r\n</div>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;color:#721c24;border:none windowtext 1.0pt;padding:0cm;background:#f8d7da\">[External Email] This email was sent from outside the department – be cautious, particularly with links and attachments.</span><u></u><u></u></p>\r\n</div>\r\n<div></div></div></div>"
