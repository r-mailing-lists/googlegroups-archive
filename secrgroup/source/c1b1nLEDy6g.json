</td>\r\n  <td>logit</td>\r\n  <td align=\"right\">3.87E-03</td>\r\n  <td align=\"right\">1.22E-03</td>\r\n  <td align=\"right\">2.09E-03</td>\r\n  <td align=\"right\">7.15E-03</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">sigma</td>\r\n  <td>log</td>\r\n  <td align=\"right\">4.07E+03</td>\r\n  <td align=\"right\">5.95E+02</td>\r\n  <td align=\"right\">3.07E+03</td>\r\n  <td align=\"right\">5.42E+03</td>\r\n </tr></tbody></table><br></div><div><b><u>Best fit female models:</u></b></div><div><br></div><div>T.f=secr.fit(males,g0~T,mask=f.mask,method = &#39;Nelder-Mead&#39;,detectfn=2,CL=F)<br></div><div><br></div><div><table width=\"378\" style=\"width:284pt;border-collapse:collapse\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n <colgroup><col width=\"59\" style=\"width:44pt\">\r\n <col width=\"41\" style=\"width:31pt\">\r\n <col width=\"78\" style=\"width:59pt\">\r\n <col width=\"80\" style=\"width:60pt\">\r\n <col width=\"60\" style=\"width:45pt\" span=\"2\">\r\n </colgroup><tbody><tr height=\"20\" style=\"height:15pt\">\r\n  <td width=\"59\" height=\"20\" style=\"width:44pt;height:15pt\"></td>\r\n  <td width=\"41\" style=\"width:31pt\">link</td>\r\n  <td width=\"78\" style=\"width:59pt\">estimate</td>\r\n  <td width=\"80\" style=\"width:60pt\">SE.estimate</td>\r\n  <td width=\"60\" style=\"width:45pt\">lcl</td>\r\n  <td width=\"60\" style=\"width:45pt\">ucl</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">D</td>\r\n  <td>log</td>\r\n  <td align=\"right\">1.72E-03</td>\r\n  <td align=\"right\">3.42E-04</td>\r\n  <td align=\"right\">1.17E-03</td>\r\n  <td align=\"right\">2.53E-03</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">g0</td>\r\n  <td>logit</td>\r\n  <td align=\"right\">1.15E-02</td>\r\n  <td align=\"right\">4.22E-03</td>\r\n  <td align=\"right\">5.55E-03</td>\r\n  <td align=\"right\">2.35E-02</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">sigma</td>\r\n  <td>log</td>\r\n  <td align=\"right\">2.29E+03</td>\r\n  <td align=\"right\">4.24E+02</td>\r\n  <td align=\"right\">1.60E+03</td>\r\n  <td align=\"right\">3.28E+03</td>\r\n </tr></tbody></table><br></div><div><br></div><div>b2.f=secr.fit(males,list(g0~b,sigma~b),mask=f.mask,method = &#39;Nelder-Mead&#39;,detectfn=2,CL=F)<br></div><div><table width=\"378\" style=\"width:284pt;border-collapse:collapse\" border=\"0\" cellspacing=\"0\" cellpadding=\"0\">\r\n <colgroup><col width=\"59\" style=\"width:44pt\">\r\n <col width=\"41\" style=\"width:31pt\">\r\n <col width=\"78\" style=\"width:59pt\">\r\n <col width=\"80\" style=\"width:60pt\">\r\n <col width=\"60\" style=\"width:45pt\" span=\"2\">\r\n </colgroup><tbody><tr height=\"20\" style=\"height:15pt\">\r\n  <td width=\"59\" height=\"20\" style=\"width:44pt;height:15pt\"></td>\r\n  <td width=\"41\" style=\"width:31pt\">link</td>\r\n  <td width=\"78\" style=\"width:59pt\">estimate</td>\r\n  <td width=\"80\" style=\"width:60pt\">SE.estimate</td>\r\n  <td width=\"60\" style=\"width:45pt\">lcl</td>\r\n  <td width=\"60\" style=\"width:45pt\">ucl</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">D</td>\r\n  <td>log</td>\r\n  <td align=\"right\">1.41E-03</td>\r\n  <td align=\"right\">2.64E-04</td>\r\n  <td align=\"right\">9.80E-04</td>\r\n  <td align=\"right\">2.03E-03</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">g0</td>\r\n  <td>logit</td>\r\n  <td align=\"right\">2.35E-02</td>\r\n  <td align=\"right\">1.02E-02</td>\r\n  <td align=\"right\">1.00E-02</td>\r\n  <td align=\"right\">5.42E-02</td>\r\n </tr>\r\n <tr height=\"20\" style=\"height:15pt\">\r\n  <td height=\"20\" style=\"height:15pt\">sigma</td>\r\n  <td>log</td>\r\n  <td align=\"right\">1.50E+03</td>\r\n  <td align=\"right\">3.26E+02</td>\r\n  <td align=\"right\">9.87E+02</td>\r\n  <td align=\"right\">2.29E+03</td>\r\n </tr></tbody></table><br></div><div><b><u>Combined sexes model:</u></b></div><div><b><u><br></u></b></div><div>sex.b=secr.fit(bears,g0~g,mask=bear.mask,groups=&quot;V5&quot;,method = &#39;Nelder-Mead&#39;,detectfn=2,CL=F)<br></div><div><b><u><br></u></b></div><div><div>session = 1, g = F </div><div>       link     estimate  SE.estimate          lcl          ucl</div><div>D       log 2.504522e-03 2.928712e-04 1.993085e-03 3.147198e-03</div><div>g0    logit 2.446481e-02 4.347052e-03 1.724662e-02 3.459767e-02</div><div>sigma   log 1.223774e+03 9.552229e+01 1.050415e+03 1.425743e+03</div><div><br></div><div> session = 1, g = M </div><div>       link     estimate  SE.estimate          lcl          ucl</div><div>D       log 2.504522e-03 2.928712e-04 1.993085e-03 3.147198e-03</div><div>g0    logit 1.506439e-02 3.613065e-03 9.400824e-03 2.405714e-02</div><div>sigma   log 1.223774e+03 9.552229e+01 1.050415e+03 1.425743e+03</div><div><br></div><div><br></div><div style=\"font-weight:bold;text-decoration:underline\"><br></div></div></div></blockquote></div>"
