For example:
# retrieve capthist object from fitted model
CH <- DaytimeSECR_DiffOcc$capthist
# use covariate for first trap, assuming all traps the same
timedf <- lapply(covariates(traps(CH)), function(x)
    data.frame(daynight = unlist(x[1,])=='day'))
secr.fit(CH, model=list(D~session, g0~daynight), timecov = timedf, verify=FALSE)

