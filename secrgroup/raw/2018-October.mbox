#2           45 45 28 26  2  0.84    0.066         0.588          0.444       2004.231 1138.928   0.165     1.032         0.624      0.596          0.0092
#3           39 39 26 22  2  1.59    0.066         0.588          0.138       2004.231 1138.928   0.161     0.726         0.570      0.562          0.0091
#4           32 32 22 15  2  2.91    0.066         0.588          0.244       2004.231 1138.928   0.064     0.832         0.810      0.270          0.0057
#5           23 23 17  0   0  3.92    0.066           NA               NA         2004.231       NA       0.078     NA             0.707       NA             0.0048

