> scen_reg_leo = make.scenarios(noccasions = 1, D = D_val,
+                                 lambda0 = lam0_val , sigma = sig_val,
+                                 detectfn = 14, recapfactor = 1, popindex = 1,
+                                 detindex = 1, fitindex = 1)

> sim_reg_leo = run.scenarios(nrepl = 1, scenarios = scen_reg_leo, trapset = reg_grid, fit = TRUE, fit.args = list(detectfn = "HHN"), pop.args = poplist)

Error in (function (f, p, ..., hessian = FALSE, typsize = rep(1, length(p)),  :
