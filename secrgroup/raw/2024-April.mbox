[11,]    2    2    2    2    2    2    2    2    2
[12,]    2    2    2    2    2    2    2    2    2

# ~bk
openCR.design(ch, models = list(lambda0 = ~bk), type = 'PLBsecrf')$PIA[1,6,,,]
      [,1] [,2] [,3] [,4] [,5] [,6] [,7] [,8] [,9]
