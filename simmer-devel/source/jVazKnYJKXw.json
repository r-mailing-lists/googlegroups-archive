i <span style=\"color:rgb(51,51,51);font-weight:bold\">in</span> seq(until/steps, until, until/steps)) {\r\n    run(.env, until=i)\r\n    message(paste0(<span style=\"color:rgb(0,128,128)\">100</span>*i/until, <span style=\"color:rgb(221,17,68)\">&quot;%&quot;</span>))\r\n  }\r\n  .env\r\n}\r\n</code></pre>\r\n<p style=\"margin:0px 0px 1.2em!important\">I suppose it’s not difficult to capture that output with Shiny to show a nice progress bar.</p>\r\n<p style=\"margin:0px 0px 1.2em!important\">Regards,</p>\r\n<div title=\"MDH:PGRpdiBjbGFzcz0iZ21haWxfZXh0cmEiPjxkaXYgY2xhc3M9ImdtYWlsX3F1b3RlIj48YmxvY2tx\r\ndW90ZSBjbGFzcz0iZ21haWxfcXVvdGUiIHN0eWxlPSJtYXJnaW46IDBweCAwcHggMHB4IDAuOGV4\r\nOyBib3JkZXItbGVmdDogMXB4IHNvbGlkIHJnYigyMDQsIDIwNCwgMjA0KTsgcGFkZGluZy1sZWZ0\r\nOiAxZXg7Ij48ZGl2IGRpcj0ibHRyIj48ZGl2PlRoaXMgbWFrZXMgbWUgdGhpbmssIHBlcmhhcHMg\r\nd2Ugc2hvdWxkIGFkZCBhIHNob3djYXNlIHBhZ2UgdG8gPGEgaHJlZj0iaHR0cDovL3Itc2ltbWVy\r\nLm9yZyIgdGFyZ2V0PSJfYmxhbmsiPnItc2ltbWVyLm9yZzwvYT4/PGJyPjwvZGl2PjwvZGl2Pjwv\r\nYmxvY2txdW90ZT48ZGl2Pjxicj48L2Rpdj48ZGl2PisxLiBJZiBTaGF3biBhbmQgaGlzIHRlYW0g\r\nYWdyZWUsIGFuZCBhcyBzb29uIGFzIHRoZXkgY29uc2lkZXIgaXQgY29tcGxldGUgYW5kIHdhbnQg\r\ndG8gcHVibGljaXplIGl0LCBJJ2xsIGJlIG1vcmUgdGhhbiBoYXBweSB0byBhZGQgaXQgaW4gYSBu\r\nZXcgc2hvd2Nhc2UgcGFnZS48L2Rpdj48ZGl2Pjxicj48L2Rpdj48ZGl2PkJUVywgQFNoYXduLCB0\r\ncnkgdGhpcyBhcyBhIHN1YnN0aXR1dGUgb2YgcnVuKCk6PC9kaXY+PGRpdj48YnI+PC9kaXY+PGRp\r\ndj5gYGByPC9kaXY+PGRpdj48ZGl2PnJ1bl93aXRoX3Byb2dyZXNzICZsdDstIGZ1bmN0aW9uKC5l\r\nbnYsIHVudGlsPTEwMDAsIHN0ZXBzPTEwKSB7PC9kaXY+PGRpdj4mbmJzcDsgZm9yIChpIGluIHNl\r\ncSh1bnRpbC9zdGVwcywgdW50aWwsIHVudGlsL3N0ZXBzKSkgezwvZGl2PjxkaXY+Jm5ic3A7ICZu\r\nYnNwOyBydW4oLmVudiwgdW50aWw9aSk8L2Rpdj48ZGl2PiZuYnNwOyAmbmJzcDsgbWVzc2FnZShw\r\nYXN0ZTAoMTAwKmkvdW50aWwsICIlIikpPC9kaXY+PGRpdj4mbmJzcDsgfTwvZGl2PjxkaXY+Jm5i\r\nc3A7IC5lbnY8L2Rpdj48ZGl2Pn08L2Rpdj48L2Rpdj48ZGl2PmBgYDxicj48L2Rpdj48L2Rpdj48\r\nZGl2Pjxicj48L2Rpdj48ZGl2Pkkgc3VwcG9zZSBpdCdzIG5vdCBkaWZmaWN1bHQgdG8gY2FwdHVy\r\nZSB0aGF0IG91dHB1dCB3aXRoIFNo