     "<div dir=\"ltr\"><div>Hello,</div><div><span style=\"color:#000\">In the example below, patient requires three resources  before timeout. If  &#39;bed&#39; becomes unavailable, and therefore timeout cannot occur, can patientB seize &#39;nurse&#39; which is currently seized by patient?</span></div><div><span style=\"color:#000\"><br>a_traj</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> trajectory</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  seize</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)%&gt;%</span><span style=\"color:#000\"><br>  timeout</span><span style=\"color:#660\">(</span><span style=\"color:#066\">30</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  release</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>b_traj</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> trajectory</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  seize</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  timeout</span><span style=\"color:#660\">(</span><span style=\"color:#066\">10</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  release</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  <br>new_traj</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">trajectory</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;traj&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  seize</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;doctor&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  seize</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  seize</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  timeout</span><span style=\"color:#660\">(</span><span style=\"color:#066\">10</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  release</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;doctor&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  release</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>  release</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br><br>env</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\">lapply</span><span style=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">function</span><span style=\"color:#660\">(</span><span style=\"color:#000\">i</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>  simmer</span><span style=\"color:#660\">()</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    add_resource</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;doctor&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    add_resource</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    add_resource</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    <br>    add_generator</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;patientA&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> a_traj</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> at</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    add_generator</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;patient&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> new_traj</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> at</span><span style=\"color:#660\">(</span><span style=\"color:#066\">5</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    add_generator</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;patientB&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> b_traj</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> at</span><span style=\"color:#660\">(</span><span style=\"color:#066\">10</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">%&gt;%</span><span style=\"color:#000\"><br>    run</span><span style=\"color:#660\">(</span><span style=\"color:#066\">30</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> <br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br><br>resources</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> get_mon_resources</span><span style=\"color:#660\">(</span><span style=\"color:#000\">env</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>arrivals</span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> get_mon_arrivals</span><span style=\"color:#660\">(</span><span style=\"color:#000\">env</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> per_resource </span><span style=\"color:#660\">=</span><span style=\"color:#000\">TRUE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>plot</span><span style=\"color:#660\">(</span><span style=\"color:#000\">resources</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> metric </span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;usage&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;doctor&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;nurse&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;bed&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\">items</span><span style=\"color:#660\">=</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;queue&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;server&quot;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> steps </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> TRUE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>         <br>         <br></span></div><div><div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code></code></div><br><br></div><div><br></div></div>"
