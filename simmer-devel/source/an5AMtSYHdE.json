   "parts": [
    [
     1,
     "<div dir=\"ltr\">Experts !<div><br></div><div>after moving priority from seize() to add_generator(), I am no longer able to change priority in a branch. please advise.</div><div>As an example, kindly check </div><div><br></div><div><pre style=\"padding:16px;font-family:Consolas,&quot;Liberation Mono&quot;,Menlo,Courier,monospace;font-size:11.9px;font-stretch:normal;line-height:1.45;word-wrap:normal;overflow:auto;border-radius:3px\"><font color=\"#0000ff\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"> branch(function() sample(c(1,2),size=1,replace=T,prob=c(0.2,0.8)), merge=c(T, T),</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                            create_trajectory(&quot;relapse&quot;) %&gt;%</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                            seize(&quot;bed&quot;, amount = 1, priority = 1) %&gt;%</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                            seize(&quot;relapse&quot;, amount = 1, priority = 1) %&gt;%</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                            timeout(function() rnorm(1, 40, 2)) %&gt;%</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                            release(&quot;bed&quot;, 1)</span><br style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">                                             </span><span style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\">  ,</span></font><div style=\"font-family:arial,sans-serif;font-size:small;line-height:normal;white-space:normal\"><font color=\"#0000ff\"><br><span style=\"background-color:rgb(247,247,247)\">                                             create_trajectory(&quot;relapse_out&quot;) %&gt;%</span><br><span style=\"background-color:rgb(247,247,247)\">                                             </span><span style=\"background-color:rgb(255,255,0)\">seize(&quot;bed&quot;, amount = 1, priority = 9) %&gt;%</span><br><span style=\"background-color:rgb(247,247,247)\">                                             seize(&quot;relapse_out&quot;, amount = 1, priority = 1)  %&gt;%</span><br><span style=\"background-color:rgb(247,247,247)\">                                            </span><span style=\"background-color:rgb(255,255,0)\"> timeout(function() rnorm(1, 10, 2)) %&gt;%</span><br><span style=\"background-color:rgb(247,247,247)\">                                             release(&quot;bed&quot;, 1)</span><span style=\"background-color:rgb(247,247,247)\"></span><span style=\"background-color:rgb(247,247,247)\"></span><br><span style=\"background-color:rgb(247,247,247)\">                                             </span><br><span style=\"background-color:rgb(247,247,247)\">                                      )</span></font></div></pre></div></div>"
    ]
