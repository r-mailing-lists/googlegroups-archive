   "subject": "Re: [simmer-devel] Updating simulation attributes using a function",
   "parts": [
    [
     1,
     "<div dir=\"auto\">From the examples:<div dir=\"auto\"><br></div><div dir=\"auto\"><span style=\"color:rgb(136,136,136);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"># more than one assignment at once</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">\r\n</span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">set_attribute</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"><a href=\"https://www.rdocumentation.org/packages/base/topics/c\" style=\"background-color:transparent;color:rgb(55,95,132)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/base/topics/c&amp;source=gmail&amp;ust=1792467520428000&amp;usg=AOvVaw0VkCcPHBMyfDjG_Xf9s0Xv\">c</a></span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"color:rgb(3,106,7);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">&quot;my_key&quot;</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">, </span><span style=\"color:rgb(3,106,7);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">&quot;other_key&quot;</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">), </span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"><a href=\"https://www.rdocumentation.org/packages/base/topics/c\" style=\"background-color:transparent;color:rgb(55,95,132)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/base/topics/c&amp;source=gmail&amp;ust=1792467520428000&amp;usg=AOvVaw0VkCcPHBMyfDjG_Xf9s0Xv\">c</a></span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"color:rgb(21,20,181);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">5</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">, </span><span style=\"color:rgb(21,20,181);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">64</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">))</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">\r\n\r\n</span><span style=\"color:rgb(136,136,136);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"># assignment using a function</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">\r\n</span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">set_attribute</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"color:rgb(3,106,7);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">&quot;independent_key&quot;</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">, </span><span style=\"color:rgb(38,77,102);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">function</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">() </span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"><a href=\"https://www.rdocumentation.org/packages/stats/topics/Uniform\" style=\"background-color:transparent;color:rgb(55,95,132)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/stats/topics/Uniform&amp;source=gmail&amp;ust=1792467520428000&amp;usg=AOvVaw2J9HjeGms7j0smEPgP1Dyc\">runif</a></span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"color:rgb(21,20,181);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">1</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">))</span><br></div><div dir=\"auto\"><br></div><div dir=\"auto\">Therefore,</div><div dir=\"auto\"><br></div><div dir=\"auto\"><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">set_attribute</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"><a href=\"https://www.rdocumentation.org/packages/base/topics/c\" style=\"background-color:transparent;color:rgb(55,95,132)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/base/topics/c&amp;source=gmail&amp;ust=1792467520428000&amp;usg=AOvVaw0VkCcPHBMyfDjG_Xf9s0Xv\">c</a></span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">(</span><span style=\"color:rgb(3,106,7);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">&quot;a&quot;</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">, </span><span style=\"color:rgb(3,106,7);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">&quot;b&quot;</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">), function() {</span></div><div dir=\"auto\"><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">  a &lt;- expr</span></div><div dir=\"auto\"><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">  c(a, a - 100)</span></div><div dir=\"auto\"><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">}</span><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\">)</span></div><div dir=\"auto\"><span style=\"color:rgb(51,51,51);font-family:menlo,monaco,consolas,&quot;courier new&quot;,monospace;font-size:14px;white-space:pre;background-color:rgb(248,248,248)\"><br></span></div><div dir=\"auto\"><span style=\"font-family:sans-serif\">Iñaki</span></div></div><br><div class=\"gmail_quote\"></div>"
