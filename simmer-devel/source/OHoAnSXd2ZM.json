, monospace\">  set_attribute(&quot;aTimeDAPTInitialized&quot;, function(attrs)</font></div><div><font face=\"courier new, monospace\">  {</font></div></span><div><font face=\"courier new, monospace\">    if(inputs$vDrugs$vClopidogrel) copulaDraw[attrs[[&quot;aDrawNo&quot;]],2] else inputs$vHorizon*365+1</font></div><span><div><font face=\"courier new, monospace\">  }) %&gt;%</font></div><div><font face=\"courier new, monospace\">  set_attribute(&quot;aStartStatin&quot;, function(attrs)</font></div><div><font face=\"courier new, monospace\">  {</font></div></span><div><font face=\"courier new, monospace\">    if(inputs$vDrugs$vSimvastatin) copulaDraw[attrs[[&quot;aDrawNo&quot;]],3] else inputs$vHorizon*365+1</font></div><div><font face=\"courier new, monospace\">  }) </font></div><div><font face=\"courier new, monospace\">}</font></div></div></blockquote></div></div>"
    ],
