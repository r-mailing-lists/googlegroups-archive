{
 "thread": "OHoAnSXd2ZM",
 "subject": "How to draw and set attributes from a vector",
 "messages_listed": 4,
 "last_activity": "2017-06-03T13:36:28Z",
 "messages": [
  {
   "id": "deWosEcGCwAJ",
   "from": "Shawn Garbett",
