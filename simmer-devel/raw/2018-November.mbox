Hello,
In the example below, patient requires three resources  before timeout. If  'bed' becomes unavailable, and therefore timeout cannot occur, can patientB seize 'nurse' which is currently seized by patient?

a_traj<- trajectory() %>%
  seize("bed", 1)%>%
  timeout(30) %>%
  release("bed", 1)

b_traj<- trajectory() %>%
  seize("nurse", 1) %>%
  timeout(10) %>%
  release("nurse", 1)

new_traj<-trajectory("traj") %>%
  seize("doctor", 1) %>%
  seize("nurse", 1) %>%
  seize("bed", 1) %>%
  timeout(10) %>%
  release("doctor", 1) %>%
  release("nurse", 1) %>%
  release("bed", 1)

env<-lapply(1:1, function(i) {
  simmer() %>%
    add_resource("doctor", 1) %>%
    add_resource("nurse", 1) %>%
    add_resource("bed", 1) %>%

    add_generator("patientA", a_traj, at(0) ) %>%
    add_generator("patient", new_traj, at(5) ) %>%
    add_generator("patientB", b_traj, at(10) ) %>%
    run(30)
})

resources<- get_mon_resources(env)
arrivals<- get_mon_arrivals(env, per_resource =TRUE)
plot(resources, metric ="usage", c( "doctor", "nurse", "bed"),items=c("queue", "server"), steps = TRUE)

