  set_attribute(c("start", "delay"), function() {
    left <- sum(get_attribute(envs, c("start", "delay"))) - now(envs)
    delay <- left
    c(now(envs), delay)
  })%>%
  timeout_from_attribute("delay")

trj_2.2 <- trajectory()%>%
  seize("resrc2")%>%
  send("sgnl")%>%
  timeout(TIME_OUT_2)%>%

  release("resrc2")%>%
  send("sgnl")

trj_2 <- trajectory()%>%
  seize("resrc")%>%

  set_attribute(c("start","delay","multiplier"), function()
    c(now(envs), rexp(1, b), 1))%>%

  trap("sgnl", handlr)%>%
  send("sgnl")%>%
  untrap("sgnl") %>%
  release("resrc")%>%

