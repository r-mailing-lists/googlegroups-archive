  simmer("bank") %>%
  add_resource("counter", 1) %>%
  add_generator("Customer", customer, function() {c(c(0, rep(0, 10-1)),rexp(1,1/10))})

bank %>% run(until = 1000)

arrivalsmonitor <- get_mon_arrivals(bank)

