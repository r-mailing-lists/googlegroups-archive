Ok, so much easier:

# this is what you want
t <- rep(cumsum(c(0, rexp(4, 1/10))), each=10)
t

# then use at()

bank <-
  simmer("bank") %>%
  add_resource("counter", 1) %>%

  add_generator("Customer", customer, at(t))

Iñaki

