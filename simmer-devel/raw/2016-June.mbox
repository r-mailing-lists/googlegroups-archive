#> 18    9      1     0      1   server           1
#> 19    9      0     0      0   server           1
#> 20  100      0     0      0   server           1

set.seed(393939)
env <-
  simmer() %>%
  add_resource("server", capacity = schedule3) %>%
  add_generator("Arrival", arrival, at(1:9))
env %>% run(until = 12)
#> simmer environment: anonymous | now: 12 | next: 12
#> { Resource: server | monitored: 1 | server status: 0(Inf) | queue status: 9(Inf) }
#> { Generator: Arrival | monitored: 1 | n_generated: 9 }
env %>% get_mon_resources
#>    time server queue system resource replication
#> 1     1      0     1      1   server           1
#> 2     2      0     2      2   server           1
#> 3     3      0     2      2   server           1
