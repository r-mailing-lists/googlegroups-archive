Oh, it actually seems that other convenience functions for generators might also cause this problem. I tried with when_activated(), haven't tried with others yet.

This example works:

simulate2 <- function() {
  env <- simmer(mon=monitor_csv())

  activ<-trajectory("activator") %>%
    activate("dummy")

  env <- env %>%

    add_generator("activator", activ, function() {1}) %>%
    add_generator("dummy", trajectory(), function() {1}) %>%

    run(5) %>%
    wrap()
  env
}

for (i in 1:2000)
  env <- simulate2()

But not this one:

simulate3 <- function() {
  env <- simmer(mon=monitor_csv())

  activ<-trajectory("activator") %>%
    activate("dummy")

  env <- env %>%

    add_generator("activator", activ, function() {1}) %>%
    add_generator("dummy", trajectory(), when_activated(n=function() {1})) %>%

    run(5) %>%
    wrap()
  env
}

for (i in 1:2000)
  env <- simulate3()

