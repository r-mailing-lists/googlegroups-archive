I had one more clarification with the token based approach. I tried the code that you listed (with additional log information) for a slightly different arrival pattern. The code and output is below. I was expecting the customer22 will select counter 2 which is the first available (since customer21 finishes in counter2 at time 11 whereas customer 11 finishes at counter1 at time 20). But customer22 seems to have selected counter 1. When you have some time, is it possible to check why this might be happening?

library(simmer)

servicetime1 <- 10
servicetime2 <- 5

customer1 <- trajectory() %>%
    log_("Cust 1 in") %>%

    set_capacity("token", 1) %>%

    log_(function() {paste0("Number of tokens ", get_capacity(env, "token"))}) %>%

    seize("counter1") %>%
    log_("started in counter1") %>%
    timeout(function() servicetime1) %>%
    release("counter1") %>%

    log_("released counter1") %>%

    set_capacity("token", function() {
        if (get_queue_count(env, "counter1"))
            1
        else 2

    }) %>%
    log_(function() paste0("Number of tokens ", get_capacity(env, "token")))

customer2 <- trajectory() %>%
    log_("cust 2 in") %>%

    log_(function() paste0("Number of tokens ", get_capacity(env, "token"))) %>%

    seize("token") %>%

    log_("got 1 token") %>%

    select(paste0("counter", 1:2), "first-available") %>%
    log_(function() paste0("selected ", get_selected(env))) %>%
    seize_selected() %>%
    log_("got the resource") %>%
    timeout(function() {
        if (get_selected(env) == "counter1")
            servicetime1
        else servicetime2
    }) %>%
    release_selected() %>%

    log_("released resource") %>%
    release("token") %>%
    log_("released token")

env <- simmer()

env %>%

    add_resource("token", 2) %>%

    add_resource("counter1") %>%
    add_resource("counter2") %>%

    add_generator("customer1", customer1, at(0, 8)) %>%

    add_generator("customer2", customer2, at(1, 3, 5)) %>%
    run()

