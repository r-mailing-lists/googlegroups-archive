> > > > > > > >>>>   branch(option=function() ifelse(get_available(env,'doctor')==0 | get_available(env,'nurse')==0,1,0),
> > > > > > > >>>>          continue=TRUE,
> > > > > > > >>>>          trajectory() %>% log_(function() paste0(now(env),": Doctor and Nurse not available")) %>% release('bed',1) %>% timeout(1) %>% rollback(5,Inf)) %>%
