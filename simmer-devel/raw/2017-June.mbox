Here's what I'd like to do:

function(traj, inputs)
{
  load("copula_objects.RData")

  traj %>%
  set_attribute("copula", function(attrs)
  {
    rMvdc(1, myMvd)[1,]
  }) %>%
  set_attribute("aTimeToStartWarfarin", function(attrs)
  {
    if(inputs$vDrugs$vWarfarin)    attrs[["copula"]][1] else inputs$vHorizon*365+1
  }) %>%
  set_attribute("aTimeDAPTInitialized", function(attrs)
  {
    if(inputs$vDrugs$vClopidogrel) attrs[["copula"]][2] else inputs$vHorizon*365+1
  }) %>%
  set_attribute("aStartStatin", function(attrs)
  {
    if(inputs$vDrugs$vSimvastatin) attrs[["copula"]][3] else inputs$vHorizon*365+1
  })
}

But of course this doesn't work because rMvdc is a vector. How can this be solved?

