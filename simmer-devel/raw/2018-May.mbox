Thanks for your reply Inaki - that example I gave you never actually entered the branch because the mod="+" doesn't work for me...

Please run this code and let me know what you think:

rm(list = ls())

library(simmer)
library(simmer.plot)
#library(simmer.bricks)
library(dplyr)

# closure function for the overall simulation index/start time of each gallon
initialize <- function(start){
  a <- start
  function() {
    a <<- a + 1
    return(c(now(gallon_line),a-1))
  }
}
# init global variable
init <- initialize(0)

b_index <- function(start){
  l <- start
  function() {
    l <<- l + 1
    return(l)
  }
}

b_num        <- b_index(0)
batch_nums   <- c(10, 20, 30)
batch_speeds <- c(1, 2, 3)
batches      <- c()

for (i in (1:length(batch_nums))){
  batches[i] <- sum(batch_nums[1:i])
}

gallon_line <- simmer()

gallon <-
  trajectory('Gallon path') %>%
  log_('gallon arrived\n') %>%

  set_attribute(c('start_time','index'), function() init()) %>%
  log_(function() toString(paste0('Index #', get_attribute(gallon_line,'index'), '\n'))) %>%

  branch( function() (get_attribute(gallon_line, 'index') %in% batches)
        , continue = T
        , trajectory() %>%
            set_attribute('batch_number', function() b_num()) %>%
            log_(function() toString(paste0('Batch #', get_attribute(gallon_line,'batch_number'), ' finished: ', batch_nums[get_attribute(gallon_line,'batch_number')], '\n'))) %>%

            set_source('gallon_', function() batch_speeds[get_attribute(gallon_line,'batch_number')]) %>%
            deactivate('gallon_') %>%
            timeout(10) %>%
            activate('gallon_')

        ) %>%
  log_('gallon finished\n')

gallon_line %>%

  add_generator('gallon_', gallon, function() .025, mon = 2)

gallon_line %>%
  run(until = 50)

