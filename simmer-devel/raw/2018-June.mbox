>
> Much simpler: use the "from(start_time, dist)" convenience function:
>
> library(simmer)
>
> env <- simmer("Patient Enrollment")
>
> patient <- trajectory() %>%
>   log_("patient enrolled")
>
> env <- env %>%
>   add_generator("patient_A", patient, from(1, function() rexp(1, 2))) %>%
>   add_generator("patient_B", patient, from(10, function() rexp(1, 1))) %>%
>   add_generator("patient_C", patient, from(20, function() rexp(1, 5))) %>%
>   run(30)
>
> Iñaki

