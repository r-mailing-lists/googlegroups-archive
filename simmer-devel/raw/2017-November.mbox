Let me illustrate this with a toy example:

library(simmer)

master_traj <- trajectory() %>%
  activate("slave")

slave_traj <- trajectory() %>%
  log_("hello!")

simmer() %>%
  add_generator("master", master_traj, function() rexp(1, 1)) %>%
  add_generator("slave", slave_traj, at(0)) %>%
  run(10)

