Hi sorry,

here is the full code:

newdp_env<-simmer("newdp")

signal<-"new batch arrived"

Signaler_1<-trajectory()%>%
  timeout(60)%>%

  send(signal)

processing<-trajectory()%>%
  branch(function()get_attribute(env,"attribute1")<70,
         continue=TRUE,
         trajectory()%>%
           trap(signal)%>%
           log_("waiting for new batch")%>%
           wait()%>%
           untrap(signal)

  )%>%
  timeout(20)

t.pathAt<-create_trajectory("pathA")%>%

  seize("resource_1")%>%
  log_("Enters resource1")%>%
  timeout(60)%>%
  release("resource_1")%>%
  log_("Leaves resource1")%>%

  batch(20,timeout=0,permanent=FALSE)%>%
  seize("resource_2")%>%
  log_("enters resource2")%>%
  timeout(60)%>%
  release("resource/_2")%>%
  log_("Leaves resource2")%>%

  seize("resource_3")%>%
  log_("Enters resource3")%>%

  set_attribute("attribute1", function()
    sample(50:99,1))%>%
  log_(function()
    paste0(get_attribute(env, "attribute1"), "% attribute1"))%>%
  join(processing)%>%

  release("resource_3")%>%
  log_("Leaves resource3")

newdp_env%>%
  add_resource("resource_1",capacity=20)%>%
  add_resource("resource_2",1)%>%
  add_resource("resource_3", capacity=inf)%>%
  add_generator("unit_initial", t.pathA, at(rep(0,20)))%>%
  add_generator("unit", t.pathA, function() rexp(1, 5), mon=2)%>%
  run(400)

Thanks

Shereen

