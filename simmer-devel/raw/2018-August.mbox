This works for me:

library(simmer.plot)
library(DiagrammeRsvg)
library(rsvg)

x <- trajectory() %>%
  seize("res", 1) %>%
  timeout(1) %>%
  release("res", 1) %>%
  rollback(3)

p <- plot(x)
svg <- charToRaw(export_svg(p))
rsvg_png(svg, "out.png", width=2000)

