      timeout(2) %>%
      release("Pick_M_2",1) ,

    trajectory() %>% ## Trajectory for "Pick_M_3"

      seize("Pick_M_3",1)%>%
      log_("selected Pick_M_3") %>%
      timeout(3) %>%
      release("Pick_M_3",1) ,

    trajectory() %>% ## Trajectory for "Pick_M_4"

      seize("Pick_M_4",1)%>%
      log_("selected Pick_M_4") %>%
      timeout(4) %>%
      release("Pick_M_4",1) ,

  )

env %>%

  add_resource("Pick_M_1", 1) %>%   # timeout = 1 min
  add_resource("Pick_M_2", 1) %>%   # timeout = 2 min
  add_resource("Pick_M_3", 1) %>%   # timeout = 3 min
  add_resource("Pick_M_4", 1) %>%   # timeout = 4 min

  add_generator("customer", c1, at(rep(0,25))) %>%

  run(50)

