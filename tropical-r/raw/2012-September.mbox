Does this work?

HydroID <- c(1, 2, 3, 4, 5, 6)
NextDownID <- c(5, 6, 7, 8, 9, 10)
df <- data.frame(HydroID, NextDownID)

df$HydroID[!(df$HydroID %in% df$NextDownID)]

