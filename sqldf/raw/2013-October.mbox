date1 <- as.integer(as.POSIXct("2013-09-12 20:19:11"))
date2 <- as.integer(as.POSIXct("2013-09-13 18:58:00"))

sequences_subset <- sqldf("SELECT * FROM sequences WHERE time >= 1379031551 AND time <= 1379113080")
sequences_subset

