That is easy to deal with: simply add another layer of sink() to
redirect output as well (I only redirected messages)

msg = file('messages.txt', open='wt')

sink(msg, append = TRUE, type = 'message')
sink('messages.txt', append = TRUE, type = 'output')

message('whatever...')

library(knitr)
knit(text = '
     <<setup>>=
     #hook_msg = function(x, options)
     knit_hooks$set(message = function(x, options) {message(x); NULL},
     warning = function(x, options) {warning(x); NULL})
     @
     <<test>>=
     1+1
     message("hello...")
     warning("howdy!!!")
     @
     ')

warning('I am done now.')

sink()

sink(type='message')

Regards,
Yihui
