   "parts": [
    [
     1,
     "<div dir=\"ltr\">Here&#39;s partial output of my sessionInfo():<div style=\"background-color:rgb(250,250,250);border-color:rgb(187,187,187);border-style:solid;border-width:1px\"><code><div><span style=\"color:#660\">&gt;</span><span style=\"color:#000\"> sessionInfo</span><span style=\"color:#660\">()</span><span style=\"color:#000\"><br>R version </span><span style=\"color:#066\">3.4</span><span style=\"color:#660\">.</span><span style=\"color:#066\">1</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#066\">2017</span><span style=\"color:#660\">-</span><span style=\"color:#066\">06</span><span style=\"color:#660\">-</span><span style=\"color:#066\">30</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Platform</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> x86_64</span><span style=\"color:#660\">-</span><span style=\"color:#000\">apple</span><span style=\"color:#660\">-</span><span style=\"color:#000\">darwin15</span><span style=\"color:#660\">.</span><span style=\"color:#066\">6.0</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#066\">64</span><span style=\"color:#660\">-</span><span style=\"color:#000\">bit</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Running</span><span style=\"color:#000\"> under</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> macOS </span><span style=\"color:#606\">Sierra</span><span style=\"color:#000\"> </span><span style=\"color:#066\">10.12</span><span style=\"color:#660\">.</span><span style=\"color:#066\">6</span><span style=\"color:#000\"><br><br><br>attached </span><span style=\"color:#008\">base</span><span style=\"color:#000\"> packages</span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> stats     graphics  grDevices utils     datasets  methods   </span><span style=\"color:#008\">base</span><span style=\"color:#000\">     <br><br><br>other attached packages</span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> rmarkdown_1</span><span style=\"color:#660\">.</span><span style=\"color:#066\">11</span><span style=\"color:#000\"> knitr_1</span><span style=\"color:#660\">.</span><span style=\"color:#066\">21</span><span style=\"color:#000\">    <br><br></span></div></code></div><div><br><br></div></div>"
