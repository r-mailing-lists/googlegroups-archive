tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Issue Type:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <img src=\"https://groups.google.com/group/sparkr-dev/attach/189fc8a2f9b45912/?part=0.2&amp;view=1\" height=\"16\" width=\"16\" border=\"0\" align=\"absmiddle\" alt=\"New Feature\" style=\"vertical-align:text-bottom\"> New Feature \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Assignee:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <a rel=\"shivaram nofollow\" href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=shivaram\" style=\"color:#3b73af;color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Dshivaram&amp;source=gmail&amp;ust=1793241084670000&amp;usg=AOvVaw2YU6pq24NXbPsvVBmww5Dk\">Shivaram Venkataraman</a> \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Components:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\">\r\n                                             Internals \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Created:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\">\r\n                                             21/Jan/15 3:14 PM \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Priority:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <img src=\"https://groups.google.com/group/sparkr-dev/attach/189fc8a2f9b45912/?part=0.1&amp;view=1\" height=\"16\" width=\"16\" border=\"0\" align=\"absmiddle\" alt=\"Major\" style=\"vertical-align:text-bottom\"> Major \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Reporter:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <a rel=\"shivaram nofollow\" href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=shivaram\" style=\"color:#3b73af;color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Dshivaram&amp;source=gmail&amp;ust=1793241084670000&amp;usg=AOvVaw2YU6pq24NXbPsvVBmww5Dk\">Shivaram Venkataraman</a> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff;padding-top:5px;padding-bottom:10px\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> \r\n                                    <tr> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;padding:0 0 10px 0\"> \r\n                                            <p style=\"margin-top:0;margin-bottom:10px;margin:10px 0 0 0\">This issue is to track the development of a new bridge from R to Java to be used on the SparkR driver side. This new bridge will replace the rJava dependency in SparkR and has a number of advantages including</p> \r\n                                            <ul type=\"square\"> \r\n                                                <li>\r\n                                                    Support for using an existing JVM as the backend: This is required for integration with spark-submit where the R process is not launched first, but is forked from an existing JVM which will be the driver Java process.\r\n                                                </li> \r\n                                            </ul> \r\n                                            <ul type=\"square\"> \r\n                                                <li>\r\n                                                    Ease of Installation: SparkR no longer has any required dependencies and only needs a java binary to exist in the runtime path.\r\n                                                </li> \r\n                                            </ul> \r\n                                            <ul type=\"square\"> \r\n                                                <li>\r\n                                                    Serialization / Deserialization: As a part of this we will also develop a set of serialization, deserialization routines that work in both R and Java.\r\n                                                </li> \r\n                                            </ul> \r\n                                            <p style=\"margin-top:0;margin-bottom:10px;margin:10px 0 0 0\">More details can be found in <a href=\"https://docs.google.com/document/d/1hscJX3VAp3GW2h24GvUIP1UXfcq8gmxTqml1dcDuL6I/edit#\" rel=\"nofollow\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://docs.google.com/document/d/1hscJX3VAp3GW2h24GvUIP1UXfcq8gmxTqml1dcDuL6I/edit%23&amp;source=gmail&amp;ust=1793241084670000&amp;usg=AOvVaw1E7SgFLaykdtzpmo6Hq-zl\">https://docs.google.com/document/d/1hscJX3VAp3GW2h24GvUIP1UXfcq8gmxTqml1dcDuL6I/edit#</a></p> \r\n                                            <p style=\"margin-top:0;margin-bottom:10px;margin:10px 0 0 0\">This is joint work with <a href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=sunrui\" rel=\"sunrui nofollow\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Dsunrui&amp;source=gmail&amp;ust=1793241084670000&amp;usg=AOvVaw3HxxQYuHiNdhC4eKq4v8OH\">Sun Rui</a></p> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> \r\n                                    <tr> \r\n                                        <td valign=\"middle\" style=\"padding:0px;border-collapse:collapse;padding:10px 0 10px 24px;vertical-align:middle;padding-left:0\"> \r\n                                            <table align=\"left\" style=\"border-collapse:collapse\"> \r\n                                                <tr> \r\n                                                    <td style=\"padding:0px;border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px;vertical-align:middle\"> <a href=\"https://sparkr.atlassian.net/browse/SPARKR-177#add-comment\" title=\"Add Comment\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https: