   "parts": [
    [
     1,
     "<u></u> \r\n \r\n     \r\n         \r\n          \r\n         \r\n     \r\n    <div style=\"color:#333;font-family:Arial,sans-serif;font-size:14px;line-height:1.429\"> \r\n        <table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#f5f5f5;border-collapse:collapse\"> \r\n             \r\n            <tr> \r\n                <td style=\"padding:0px;border-collapse:collapse;padding:10px 20px\"> \r\n                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse:collapse\"> \r\n                        <tr> \r\n                            <td valign=\"top\" style=\"padding:0px;border-collapse:collapse;vertical-align:top;width:32px;padding-right:8px\"> <img src=\"https://ci6.googleusercontent.com/proxy/57ThWCDXXPAr1IdgbhDgqn_6lFgJuIsdcy6U88uM9ns0uTNiachwX2As05UMGQNZa4ZaDkv16QX6BNr93HbDNRSBywLSwIKm1SJ_6qyBLwqzqPj-QL1FfNizZFHSOyxv=s0-d-e1-ft#https://secure.gravatar.com/avatar/d412a0fb294e3e07cdbc53908059d5b4?d=mm&amp;s=48\" height=\"32\" width=\"32\" border=\"0\" style=\"border-radius:3px;vertical-align:top\"> \r\n                            </td> \r\n                            <td valign=\"middle\" style=\"padding:0px;border-collapse:collapse;vertical-align:middle;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> <a rel=\"shivaram nofollow\" href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=shivaram\" style=\"color:#3b73af;color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Dshivaram&amp;source=gmail&amp;ust=1793240880783000&amp;usg=AOvVaw3RBUawm2YETDKe0HYX4iiD\">Shivaram Venkataraman</a> <strong>commented</strong> on <a href=\"https://sparkr.atlassian.net/browse/SPARKR-218\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/browse/SPARKR-218&amp;source=gmail&amp;ust=1793240880783000&amp;usg=AOvVaw1vyv3_XNidnvcpici1Pspe\"><img src=\"https://groups.google.com/group/sparkr-dev/attach/b9bc779f0a689c8c/?part=0.1&amp;view=1\" height=\"16\" width=\"16\" border=\"0\" align=\"absmiddle\" alt=\"Bug\"> SPARKR-218</a> \r\n                            </td> \r\n                        </tr> \r\n                    </table> \r\n                </td> \r\n            </tr> \r\n            <tr> \r\n                <td style=\"padding:0px;border-collapse:collapse;padding:0 20px\"> \r\n                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;border-spacing:0;border-collapse:separate\"> \r\n                        <tr> \r\n                             \r\n                            <td style=\"padding:0px;border-collapse:collapse;color:#fff;padding:0 15px 0 16px;height:15px;background-color:#fff;border-left:1px solid #ccc;border-top:1px solid #ccc;border-right:1px solid #ccc;border-bottom:0;border-top-right-radius:5px;border-top-left-radius:5px;height:10px;line-height:10px;padding:0 15px 0 16px\">\r\n                                 \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse\"> \r\n                                    <tr> \r\n                                        <td style=\"vertical-align:top;padding:0px;border-collapse:collapse;padding-right:5px;font-size:20px;line-height:30px\"> <span style=\"font-family:Arial,sans-serif;padding:0;font-size:20px;line-height:30px;vertical-align:middle\"> <a href=\"https://sparkr.atlassian.net/browse/SPARKR-218\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/browse/SPARKR-218&amp;source=gmail&amp;ust=1793240880783000&amp;usg=AOvVaw1vyv3_XNidnvcpici1Pspe\">Re: Remote Dependencies Documentation</a> </span> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff;border-bottom:none;padding-bottom:0\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> \r\n                                    <tr> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;padding:0 0 10px 0\"> \r\n                                            <p style=\"margin:10px 0 0 0\">SparkR uses SBT/Maven to build the necessary Java dependencies. Unfortunately its not very easy to use maven in a offline setting (some threads like <span>[1]</span> may be useful) but there are couple of workarounds that you could use</p> \r\n                                            <ul type=\"square\"> \r\n                                                <li>\r\n                                                    You could ask Maven to make its connections go through a proxy server if you have a setup that allows for that <span>[2]</span>\r\n                                                </li> \r\n                                                <li>\r\n                                                    Or you could clone the SparkR repository on any machine which has internet access, build a self-contained binary package as a tar.gz and distribute that to your servers. To do that you can run something like \r\n                                                    <div style=\"border-width:1px;border:1px solid #ccc;background:#f5f5f5;font-size:12px;line-height:1.333;font-family:monospace;border:1px solid #ccc;border-radius:3px 3px 3px 3px;margin:9px 0\">\r\n                                                        <div style=\"padding:9px 12px\"> \r\n                                                            <pre style=\"margin:10px 0 0 0;max-height:30em;overflow:auto;white-space:pre-wrap;word-wrap:normal\">\r\ncd SparkR-pkg\r\nR CMD INSTALL --build pkg\r\n</pre> \r\n                                                        </div>\r\n                                                    </div>\r\n                                                </li> \r\n                                            </ul> \r\n                                            <p style=\"margin:10px 0 0 0\">and this should produce a file named SparkR_0.1.tgz – The only things you need to ensure is that you build this on a machine with the same architecture and R version as the target server</p> \r\n                                            <p style=\"margin:10px 0 0 0\"><span>[1]</span> <a href=\"http://stackoverflow.com/questions/7233328/how-do-i-configure-maven-for-offline-development\" rel=\"nofollow\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://stackoverflow.com/questions/7233328/how-do-i-configure-maven-for-offline-development&amp;source=gmail&amp;ust=1793240880783000&amp;usg=AOvVaw129nnrktTBd8GPu8JKgMwF\">http://stackoverflow.com/questions/7233328/how-do-i-configure-maven-for-offline-development</a><br> <span>[2]</span> <a href=\"http://maven.apache.org/guides/mini/guide-proxies.html\" rel=\"nofollow\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://maven.apache.org/guides/mini/guide-proxies.html&amp;source=gmail&amp;ust=1793240880783000&amp;usg=AOvVaw3LhDLFN1tmZ2vpKGTyTlE1\">http://maven.apache.org/guides/mini/guide-proxies.html</a></p> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr></table></td></tr></table></div>"
    ],
