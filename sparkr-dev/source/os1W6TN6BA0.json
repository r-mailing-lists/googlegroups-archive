     "<u></u> \r\n \r\n     \r\n         \r\n          \r\n         \r\n     \r\n    <div style=\"color:#333;font-family:Arial,sans-serif;font-size:14px;line-height:1.429\"> \r\n        <table cellpadding=\"0\" cellspacing=\"0\" width=\"100%\" style=\"border-collapse:collapse;background-color:#f5f5f5;border-collapse:collapse\"> \r\n             \r\n            <tr> \r\n                <td style=\"padding:0px;border-collapse:collapse;padding:10px 20px\"> \r\n                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" style=\"border-collapse:collapse\"> \r\n                        <tr> \r\n                            <td valign=\"top\" style=\"padding:0px;border-collapse:collapse;vertical-align:top;width:32px;padding-right:8px\"> <img src=\"https://ci6.googleusercontent.com/proxy/4jRig_vW84ecqaD7_ey-sFa3QQkOib5YLYt0-1piokrgZwbToqMSSnH1rwSwV9xDFaX-uH7AySyzO096Q2Obk4T1SItUxn2dXI_PcW31KdN8cnmsBAOGzPjwDSTLvmO_=s0-d-e1-ft#https://secure.gravatar.com/avatar/dc19c0038b42d5d8109bf050335c13ab?d=mm&amp;s=48\" height=\"32\" width=\"32\" border=\"0\" style=\"border-radius:3px;vertical-align:top\"> \r\n                            </td> \r\n                            <td valign=\"middle\" style=\"padding:0px;border-collapse:collapse;vertical-align:middle;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> <a rel=\"davies nofollow\" href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=davies\" style=\"color:#3b73af;color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Ddavies&amp;source=gmail&amp;ust=1793240713962000&amp;usg=AOvVaw0_ZZW-s71w7Ee7Hbu7zZp5\">Davies</a> <strong>commented</strong> on <a href=\"https://sparkr.atlassian.net/browse/SPARKR-216\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/browse/SPARKR-216&amp;source=gmail&amp;ust=1793240713962000&amp;usg=AOvVaw1pvWinuAPp0wegEw_3ghOT\"><img src=\"https://groups.google.com/group/sparkr-dev/attach/b83ce55ce40e2784/?part=0.1&amp;view=1\" height=\"16\" width=\"16\" border=\"0\" align=\"absmiddle\" alt=\"New Feature\"> SPARKR-216</a> \r\n                            </td> \r\n                        </tr> \r\n                    </table> \r\n                </td> \r\n            </tr> \r\n            <tr> \r\n                <td style=\"padding:0px;border-collapse:collapse;padding:0 20px\"> \r\n                    <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;border-spacing:0;border-collapse:separate\"> \r\n                        <tr> \r\n                             \r\n                            <td style=\"padding:0px;border-collapse:collapse;color:#fff;padding:0 15px 0 16px;height:15px;background-color:#fff;border-left:1px solid #ccc;border-top:1px solid #ccc;border-right:1px solid #ccc;border-bottom:0;border-top-right-radius:5px;border-top-left-radius:5px;height:10px;line-height:10px;padding:0 15px 0 16px\">\r\n                                 \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse\"> \r\n                                    <tr> \r\n                                        <td style=\"vertical-align:top;padding:0px;border-collapse:collapse;padding-right:5px;font-size:20px;line-height:30px\"> <span style=\"font-family:Arial,sans-serif;padding:0;font-size:20px;line-height:30px;vertical-align:middle\"> <a href=\"https://sparkr.atlassian.net/browse/SPARKR-216\" style=\"color:#3b73af;text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/browse/SPARKR-216&amp;source=gmail&amp;ust=1793240713962000&amp;usg=AOvVaw1pvWinuAPp0wegEw_3ghOT\">Re: SparkR Style guide</a> </span> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff;border-bottom:none;padding-bottom:0\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> \r\n                                    <tr> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;padding:0 0 10px 0\"> \r\n                                            <p style=\"margin:10px 0 0 0\">We could have a R style guide based on the one from google <span>[1]</span>, and adjust some of them with the conversation in Spark:<br> 1. Line Length: maximum 100 characters<br> 2. no limit on function name (API should be similar as in other languages)<br> 3. Allow S4 objects/methods</p> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr></table></td></tr></table></div>"
