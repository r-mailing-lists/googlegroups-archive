nt:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <img src=\"https://groups.google.com/group/sparkr-dev/attach/cac2d70ff683a0d8/?part=0.3&amp;view=1\" height=\"16\" width=\"16\" border=\"0\" align=\"absmiddle\" alt=\"Minor\" style=\"vertical-align:text-bottom\"> Minor \r\n                                        </td> \r\n                                    </tr> \r\n                                    <tr> \r\n                                        <th style=\"color:#707070;font:normal 14px/20px Arial,sans-serif;text-align:left;vertical-align:top;padding:2px 0\">\r\n                                            Reporter:\r\n                                        </th> \r\n                                        <td style=\"padding:0px;border-collapse:collapse;font:normal 14px/20px Arial,sans-serif;padding:2px 0 2px 5px;vertical-align:top\"> <a rel=\"shivaram nofollow\" href=\"https://sparkr.atlassian.net/secure/ViewProfile.jspa?name=shivaram\" style=\"color:#3b73af;color:#3b73af;text-decoration:none\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://sparkr.atlassian.net/secure/ViewProfile.jspa?name%3Dshivaram&amp;source=gmail&amp;ust=1793240757192000&amp;usg=AOvVaw3R3YoE9jswyqVGYxuQZPe3\">Shivaram Venkataraman</a> \r\n                                        </td> \r\n                                    </tr> \r\n                                </table> \r\n                            </td> \r\n                        </tr> \r\n                        <tr> \r\n                            <td style=\"padding:0px;border-collapse:collapse;border-left:1px solid #ccc;border-right:1px solid #ccc;border-top:0;border-bottom:0;padding:0 15px 0 16px;background-color:#fff\"> \r\n                                <table cellspacing=\"0\" cellpadding=\"0\" border=\"0\" width=\"100%\" style=\"border-collapse:collapse;font-family:Arial,sans-serif;font-size:14px;line-height:20px\"> \r\n                           