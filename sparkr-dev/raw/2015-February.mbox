USE_MAVEN=1 USE_YARN=1 SPARK_HADOOP_VERSION=2.5.0-cdh5.3.1 SPARK_VERSION = 1.2.1 SPARK_YARN_VERSION=2.5.0-cdh5.3.1 ./install-dev.sh

