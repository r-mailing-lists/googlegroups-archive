,0)\"> </span><span style=\"color:rgb(136,0,0)\"># system.time: used to compare the processing time using loop and parallel </span><span style=\"color:rgb(0,0,0)\"><br>EX</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(102,0,102)\">Table</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(102,0,102)\">Loop</span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\">NULL <br></span><span style=\"color:rgb(0,0,136)\">for</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">i </span><span style=\"color:rgb(0,0,136)\">in</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">:</span><span style=\"color:rgb(0,0,0)\">length</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">pics</span><span style=\"color:rgb(102,102,0)\">)){</span><span style=\"color:rgb(0,0,0)\"> <br>  EX</span><span style=\"color:rgb(102,102,0)\">.</span><span style=\"color:rgb(0,0,0)\">L1</span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\">stack</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">paste</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,136,0)\">&quot;./images/&quot;</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\">pics</span><span style=\"color:rgb(102,102,0)\">[</span><span style=\"color:rgb(0,0,0)\">i</span><span style=\"color:rgb(102,102,0)\">],</span><span style=\"color:rgb(0,0,0)\">sep </span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,136,0)\">&quot;&quot;</span><span style=\"color:rgb(102,102,0)\">))</span><span style=\"color:rgb(0,0,0)\"> <br>  plotRGB</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">EX</span><span style=\"color:rgb(102,1