lor:#000\"> </span><span style=\"color:#008\">local</span><span style=\"color:#000\"> repositories specified<br></span><span style=\"color:#606\">In</span><span style=\"color:#000\"> addition</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Warning</span><span style=\"color:#000\"> messages</span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">In</span><span style=\"color:#000\"> readLines</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br>  incomplete </span><span style=\"color:#008\">final</span><span style=\"color:#000\"> line found on </span><span style=\"color:#080\">&#39;/home/harlan/Development/risk-model-report/risk-model-report.Rmd&#39;</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">2</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">In</span><span style=\"color:#000\"> FUN</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;data.table&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Rcmdr&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;pscl&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;pkg&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;rmarkdown&quot;</span><span style=\"color:#660\">)[[</span><span style=\"color:#066\">5L</span><span style=\"color:#660\">]],</span><span style=\"color:#000\">  </span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br>  </span><span style=\"color:#606\">Package</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;pkg&#39;</span><span style=\"color:#000\"> </span><span style=\"color:#008\">not</span><span style=\"color:#000\"> available </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> repository </span><span style=\"color:#008\">or</span><span style=\"color:#000\"> locally<br></span><span style=\"color:#066\">3</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">In</span><span style=\"color:#000\"> FUN</span><span style=\"color:#660\">(</span><span style=\"color:#000\">c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;data.table&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Rcmdr&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;pscl&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;pkg&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;rmarkdown&quot;</span><span style=\"color:#660\">)[[</span><span style=\"color:#066\">5L</span><span style=\"color:#660\">]],</span><span style=\"color:#000\">  </span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br>  </span><span style=\"color:#606\">Package</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;rmarkdown&#39;</span><span style=\"color:#000\"> </span><span style=\"color:#008\">not</span><span style=\"color:#000\"> available </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> repository </span><span style=\"color:#008\">or</span><span style=\"color:#000\"> locally</span></div></code></div><div><