    [
     1,
     "<div dir=\"ltr\"><span style=\"font-family:arial,sans-serif;font-size:12.8px\">Hi,</span><div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br></div><div style=\"font-family:arial,sans-serif;font-size:12.8px\">I&#39;d like to know if is it possible to run this package using binary trait in a non Bayesian threshold animal mixed model?</div><div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br></div><div style=\"font-family:arial,sans-serif;font-size:12.8px\">Thank you,</div><div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br></div><div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br></div><div style=\"font-family:arial,sans-serif;font-size:12.8px\">Fernando Brito</div></div>"
    ]
   ]
  },
  {
   "id": "gtgZ9KEfAgAJ",
   "from": "Facundo Muñoz",
   "author": "8dbb28b015bb7762",
   "date": "2015-09-17T06:51:39Z",
   "subject": "Re: [breedR] Threshold animal mixed model",
   "parts": [
    [
     1,
     "\r\n  \r\n    \r\n  \r\n  <div text=\"#000000\" bgcolor=\"#FFFFFF\">\r\n    Hi Fernando,<br>\r\n    <br>\r\n    not for the moment, sorry.<br>\r\n    <br>\r\n    We have only implemented the interface to the REML programs for\r\n    quantitative response variables.<br>\r\n    <br>\r\n    Nonetheless, if you are familiar with the BLUPF90 suit of programs,\r\n    you could use breedR to simplify the creation of the parameter, data\r\n    and other files, and then manually perform the relevant changes to\r\n    fit your threshold model.<br>\r\n    <br>\r\n    ƒacu.-<br>\r\n    <br>\r\n    <br>\r\n    <div>El 16/09/15 a las 20:05, Fernando Brito\r\n      escribió:<br>\r\n    </div>\r\n    <blockquote type=\"cite\"></blockquote></div>"
    ],
    [
     3,
     "<div text=\"#000000\" bgcolor=\"#FFFFFF\"><blockquote type=\"cite\">\r\n      <div dir=\"ltr\"><span style=\"font-family:arial,sans-serif;font-size:12.8px\">Hi,</span>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br>\r\n        </div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\">I&#39;d\r\n          like to know if is it possible to run this package using\r\n          binary trait in a non Bayesian threshold animal mixed model?</div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br>\r\n        </div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\">Thank\r\n          you,</div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br>\r\n        </div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\"><br>\r\n        </div>\r\n        <div style=\"font-family:arial,sans-serif;font-size:12.8px\">Fernando\r\n          Brito</div>\r\n      </div></blockquote></div>"
