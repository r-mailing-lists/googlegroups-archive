> ttGROW <- truthTable(data=Setdata, outcome = "GROW",
>                       conditions = "FINBIG, SUBS, FFF, PERS, BUSINESS, EO",
>                      incl.cut=0.79, n.cut = 2, sort.by <http://sort.by>="incl, n", complete=TRUE, show.cases=TRUE, dcc=TRUE)
