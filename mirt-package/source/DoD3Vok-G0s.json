(102,102,0)\">),</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">20</span><span style=\"color:rgb(102,102,0)\">),</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">1</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> cumsum</span><span style=\"color:rgb(102,102,0)\">))</span><span style=\"color:rgb(0,0,0)\"><br>diffs </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(102,102,0)\">-(</span><span style=\"color:rgb(0,0,0)\">diffs </span><span style=\"color:rgb(102,102,0)\">-</span><span style=\"color:rgb(0,0,0)\"> rowMeans</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">diffs</span><span style=\"color:rgb(102,102,0)\">))</span><span style=\"color:rgb(0,0,0)\"><br>d </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> diffs </span><span style=\"color:rgb(102,102,0)\">+</span><span style=\"color:rgb(0,0,0)\"> rnorm</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,102,102)\">20</span><span style=\"color:rgb(102,102,0)\">)</span><span style=\"color:rgb(0,0,0)\"><br><br><br>dat </span><span style=\"color:rgb(102,102,0)\">&lt;-</span><span style=\"color:rgb(0,0,0)\"> simdata</span><span style=\"color:rgb(102,102,0)\">(</span><span style=\"color:rgb(0,0,0)\">a</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> d</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,102,102)\">500</span><span style=\"color:rgb(102,102,0)\">,</span><span style=\"color:rgb(0,0,0)\"> itemtype </span><span style=\"color:rgb(102,102,0)\">=</span><span style=\"color:rgb(0,0,0)\"> </span><span style=\"color:rgb(0,136,0)\">&#39;graded&#39;</span><span style=\"color:rgb(102,102,0)\">)</span></div></code></div><div><br></div><div><br></div><div>What I&#39;m not understanding about the example is that when I run a mirt model and look at the item trace plots it looks like the thresholds are sampled heavily at the tails (see example). In the process of applied work, you might conclude that the middle categories of the rating scale do not distinguish adequately for these items. I&#39;m stuck on what the next interim step would be, using this approach, to enforce more separation between the categories and more peaked probability curves?</div><div><br></div><div>Thanks for any insights</div><p style=\"text-align:center;clear:both\"><img src=\"https://groups.google.com/group/mirt-package/attach/133571ff5891/OCCs.png?part=0.1&amp;view=1\" alt=\"OCCs.png\" width=\"320\" height=\"168\" style=\"margin-left:1em;margin-right:1em\"></p><div><br></div></div>\r\n\r\n<p></p></blockquote></div>"
