     "<div dir=\"ltr\"><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div><div class=\"gmail_quote\">On Mon, Apr 24, 2017 at 10:50 PM, Yingbin Zhang <span dir=\"ltr\">&lt;<a rel=\"nofollow\">yingbi...@gmail.com</a>&gt;</span> wrote:<br></div></div></blockquote></div>"
