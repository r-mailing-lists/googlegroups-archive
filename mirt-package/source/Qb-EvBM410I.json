 ((parameters$item == paste0(&quot;Q&quot;,i)) &amp; (parameters$name == &quot;g&quot;)),]$est &lt;- FALSE<br>}<br><br>mod_mt &lt;- mirt( data=mt_ef5_scored_filtered[,-c(13)], <br>                model=models, <br>                itemtype=&#39;3PL&#39;,<br>                technical=list(NCYCLES=10000),<br>                pars = parameters) <br><br>coef(mod_mt,simplify=TRUE,IRTpars = TRUE)<br>profic_mt_raw = fscores(mod_mt) #estimativas das proficiÃªncias individuais<br><br></div><div><div class=\"gmail_default\" style=\"font-size:small\">Looking forward to hearing from you,</div><div class=\"gmail_default\" style=\"font-size:small\"><br></div><div class=\"gmail_default\" style=\"font-size:small\">Hugo</div><br></div>-- <br><div dir=\"ltr\"><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div dir=\"ltr\"><div dir=\"ltr\"><div dir=\"ltr\"><div dir=\"ltr\"><div><br></div><div><br><table width=\"100%\" border=\"0\" cellpadding=\"0\" style=\"color:rgb(0,0,0);font-family:&quot;Times New Roman&quot;;font-size:medium\"><tbody><tr><td align=\"left\" valign=\"middle\" width=\"10\"><p style=\"margin-right:10px;font-family:Helvetica,Arial,sans-serif;font-size:12px;line-height:14px\"><a href=\"http://www.adaptativa.com.br/\" style=\"text-decoration:none\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.adaptativa.com.br/&amp;source=gmail&amp;ust=1792472378904000&amp;usg=AOvVaw3qvYCWltLq0d9be--mCj5E\"><img src=\"https://ci4.googleusercontent.com/proxy/FE2I4wjFnN2cAFKRmI3TKMszOlSp21wnNu4SqBeCJZBTRvT_FvrlgmwCaxvFTesKdXjysxxb7nvH4if6T_hi884vh3N59BHtgm3-wqx9bgkcnTo-Jw1Bg01c1Tk3qGCKYDUC3lEyIIXfgYCyCshNyEk3Ee8Wg4ibOcS9FfxhtyTI=s0-d-e1-ft#https://htmlsigs.s3.amazonaws.com/logos/files/000/177/391/landscape/adaptativa_256px80pxL_72dpi_SEM_SLOGAN.jpg\" alt=\"Adaptativa\" border=\"0\" height=\"62\" width=\"200\"></a></p></td><td align=\"left\"><p style=\"font-family:Helvetica,Arial,sans-serif;l