    [
     1,
     "<div dir=\"ltr\">Not currently no, but this issue is less likely to occur with the MHRM due to the stochastic nature of the algorithm. BFGS and L-BFGS-B are supported though.<div class=\"gmail_extra\"><br clear=\"all\"><div><div data-smartmail=\"gmail_signature\"><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><span style=\"font-size:12.8px\">Phil</span><br></div></div></div></div></div></div></div></div>\r\n<br><div class=\"gmail_quote\"></div></div></div>"
    ],
    [
     3,
