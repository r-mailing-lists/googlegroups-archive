=1792472658163000&amp;usg=AOvVaw1r7nmBwYxexsWPFL-Jx8CL\">apply</a></span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit;color:rgb(0,0,255)\"><a href=\"https://rdrr.io/r/base/matrix.html\" style=\"box-sizing:inherit;background:0px 0px;color:rgb(65,131,196)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://rdrr.io/r/base/matrix.html&amp;source=gmail&amp;ust=1792472658163000&amp;usg=AOvVaw1VifoW-_9Lba1VtrApDeEZ\">matrix</a></span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit;color:rgb(0,0,255)\"><a href=\"https://rdrr.io/r/stats/Uniform.html\" style=\"box-sizing:inherit;background:0px 0px;color:rgb(65,131,196)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://rdrr.io/r/stats/Uniform.html&amp;source=gmail&amp;ust=1792472658163000&amp;usg=AOvVaw2LdbM9DPVdAFHOgBThVU4o\">runif</a></span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit;color:rgb(102,102,102)\">20</span><span style=\"box-sizing:inherit;color:rgb(102,102,102)\">*</span><span style=\"box-sizing:inherit;color:rgb(102,102,102)\">4</span><span style=\"box-sizing:inherit\">,</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">.3</span><span style=\"box-sizing:inherit\">,</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">1</span><span style=\"box-sizing:inherit\">),</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">20</span><span style=\"box-sizing:inherit\">),</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">1</span><span style=\"box-sizing:inherit\">,</span> <span style=\"box-sizing:inherit\"><a href=\"https://rdrr.io/r/base/cumsum.html\" style=\"box-sizing:inherit;background:0px 0px;color:rgb(65,131,196)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://rdrr.io/r/base/cumsum.html&amp;source=gmail&amp;ust=1792472658163000&amp;usg=AOvVaw2LZWG8oD5Klp1hWzQGrASQ\">cumsum</a></span><span style=\"box-sizing:inherit\">))</span>\r\n<span style=\"box-sizing:inherit\">diffs</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">&lt;-</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">-</span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit\">diffs</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">-</span> <span style=\"box-sizing:inherit;color:rgb(0,0,255)\"><a href=\"https://rdrr.io/r/base/colSums.html\" style=\"box-sizing:inherit;background:0px 0px;color:rgb(65,131,196)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://rdrr.io/r/base/colSums.html&amp;source=gmail&amp;ust=1792472658163000&amp;usg=AOvVaw0s6PqaTnXMfgqceKQOm3z0\">rowMeans</a></span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit\">diffs</span><span style=\"box-sizing:inherit\">))</span>\r\n<span style=\"box-sizing:inherit\">d</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">&lt;-</span> <span style=\"box-sizing:inherit\">diffs</span> <span style=\"box-sizing:inherit;color:rgb(102,102,102)\">+</span> <span style=\"box-sizing:inherit;color:rgb(0,0,255)\"><a href=\"https://rdrr.io/r/stats/Normal.html\" style=\"box-sizing:inherit;background:0px 0px;color:rgb(65,131,196)\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://rdrr.io/r/stats/Normal.html&amp;source=gmail&amp;ust=1792472658163000&amp;usg=AOvVaw1MciqZSHv55Ry38N6iO2H_\">rnorm</a></span><span style=\"box-sizing:inherit\">(</span><span style=\"box-sizing:inherit;color:rgb(102,102,102)\">20</span><span style=\"box-sizing:inherit\">)</span></pre></div></div>\r\n\r\n<p></p></blockquote></div>"
