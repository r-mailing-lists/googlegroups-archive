     1,
     "<p style=\"padding:0px;margin:0px;word-break:break-word;font-size:16px;color:rgb(17,17,17);font-family:-apple-system,Roboto,SegoeUI,&quot;Segoe UI&quot;,&quot;Helvetica Neue&quot;,Helvetica,&quot;Microsoft YaHei&quot;,&quot;Meiryo UI&quot;,Meiryo,&quot;Arial Unicode MS&quot;,sans-serif\">Dear Dr. Chalmers,</p><p style=\"padding:0px;margin:12px 0px 0px;word-break:break-word;font-size:16px;color:rgb(17,17,17);font-family:-apple-system,Roboto,SegoeUI,&quot;Segoe UI&quot;,&quot;Helvetica Neue&quot;,Helvetica,&quot;Microsoft YaHei&quot;,&quot;Meiryo UI&quot;,Meiryo,&quot;Arial Unicode MS&quot;,sans-serif\">Thank you for your exceptional work and support. I have developed a Computerized Adaptive Test (CAT) that ensures content balance. Prior to implementing the CAT, I propose administering a linear exam to students. This exam will include items from each content area, with specific constraints on parameters (a) and (b). Based on the theta values obtained from this linear exam, the actual CAT will proceed, maintaining content area balance.</p><p style=\"padding:0px;margin:12px 0px 0px;word-break:break-word;font-size:16px;color:rgb(17,17,17);font-family:-apple-system,Roboto,SegoeUI,&quot;Segoe UI&quot;,&quot;Helvetica Neue&quot;,Helvetica,&quot;Microsoft YaHei&quot;,&quot;Meiryo UI&quot;,Meiryo,&quot;Arial Unicode MS&quot;,sans-serif\">Could you advise on the best method to initialize theta for the CAT code and remove the items selected for the initial linear exam from the item bank?</p><div style=\"color:rgb(0,0,0);font-family:Consolas,&quot;Courier New&quot;,monospace;line-height:19px;white-space:pre\"><br><br><div><span style=\"color:rgb(0,16,128)\">test_properties</span> &lt;- <span style=\"color:rgb(121,94,38)\">data.frame</span>(<span style=\"color:rgb(0,16,128)\">content</span>=<span style=\"color:rgb(121,94,38)\">rep</span>(<span style=\"color:rgb(121,94,38)\">c</span>(<span style=\"color:rgb(163,21,21)\">&#39;ContentArea1&#39;</span>, <span style=\"color:rgb(163,21,21)\">&#39;ContentArea2&#39;</span>, <span style=\"color:rgb(163,21,21)\">&#39;ContentArea3&#39;</span>,<span style=\"color:rgb(163,21,21)\">&#39;ContentArea4&#39;</span>,<span style=\"color:rgb(163,21,21)\">&#39;ContentArea5&#39;</span>), </div><div>                                          <span style=\"color:rgb(0,16,128)\">times</span>=<span style=\"color:rgb(9,134,88)\">60</span>),<span style=\"color:rgb(0,16,128)\">skills</span>=<span style=\"color:rgb(121,94,38)\">rep</span>(<span style=\"color:rgb(121,94,38)\">c</span>(<span style=\"color:rgb(163,21,21)\">&#39;Skill1&#39;</span>, <span style=\"color:rgb(163,21,21)\">&#39;Skill2&#39;</span>, <span style=\"color:rgb(163,21,21)\">&#39;Skill3&#39;</span>), <span style=\"color:rgb(0,16,128)\">times</span> = <span style=\"color:rgb(9,134,88)\">100</span>))  </div><div><span style=\"color:rgb(121,94,38)\">head</span>(<span style=\"color:rgb(0,16,128)\">test_properties</span>)</div><div><span style=\"color:rgb(0,16,128)\">test_properties</span></div><div><span style=\"color:rgb(0,128,0)\"># Create the item bank as a data frame</span></div><div><span style=\"color:rgb(0,128,0)\"># constraint generating function</span></div><div><span style=\"color:rgb(121,94,38)\">constr_fun</span> &lt;- <span style=\"color:rgb(175,0,219)\">function</span>(<span style=\"color:rgb(0,16,128)\">person</span>, <span style=\"color:rgb(0,16,128)\">test</span>, <span style=\"color:rgb(0,16,128)\">design</span>) {</div><div>  <span style=\"color:rgb(0,16,128)\">mo</span> &lt;- <span style=\"color:rgb(0,16,128)\">extract.mirtCAT</span>(<span style=\"color:rgb(0,16,128)\">test</span>, <span style=\"color:rgb(163,21,21)\">&#39;mo&#39;</span>)</div><div>  <span style=\"color:rgb(0,128,0)\"># Get the number of items from the test object</span></div><div>  <span style=\"color:rgb(0,16,128)\">nitems</span> &lt;- <span style=\"color:rgb(0,16,128)\">extract.mirt</span>(<span style=\"color:rgb(0,16,128)\">mo</span>, <span style=\"color:rgb(163,21,21)\">&#39;nitems&#39;</span>)</div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Access the content labels (assuming they&#39;re stored in tp$content or similar)</span></div><div>  <span style=\"color:rgb(0,16,128)\">tp</span> &lt;- <span style=\"color:rgb(0,16,128)\">extract.mirtCAT</span>(<span style=\"color:rgb(0,16,128)\">design</span>, <span style=\"color:rgb(163,21,21)\">&#39;test_properties&#39;</span>)  <span style=\"color:rgb(0,128,0)\"># Assuming the test object contains a &#39;tp&#39; element with content info</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span> &lt;- <span style=\"color:rgb(121,94,38)\">matrix</span>(<span style=\"color:rgb(9,134,88)\">0</span>, <span style=\"color:rgb(0,16,128)\">nrow</span> = <span style=\"color:rgb(9,134,88)\">14</span>, <span style=\"color:rgb(0,16,128)\">ncol</span> = <span style=\"color:rgb(0,16,128)\">nitems</span>)  <span style=\"color:rgb(0,128,0)\"># 5 content areas with min/max + 1 total</span></div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Add constraints based on content labels</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">1</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea1&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Min items from ContentArea1</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">2</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea1&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Max items from ContentArea1</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">3</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea2&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Min items from ContentArea2</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">4</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea2&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Max items from ContentArea2</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea3&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Min items from ContentArea3</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">6</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea3&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Max items from ContentArea3</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">7</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea4&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Min items from ContentArea4</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">8</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea4&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Max items from ContentArea4</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">9</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea5&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># Min items from ContentArea5</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">10</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">content</span> == <span style=\"color:rgb(163,21,21)\">&#39;ContentArea5&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span> <span style=\"color:rgb(0,128,0)\"># Max items from ContentArea5</span></div><div>  </div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">11</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">skill</span> == <span style=\"color:rgb(163,21,21)\">&#39;Skill1&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">12</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">skill</span> == <span style=\"color:rgb(163,21,21)\">&#39;Skill2&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">13</span>, <span style=\"color:rgb(0,16,128)\">tp</span><span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">skill</span> == <span style=\"color:rgb(163,21,21)\">&#39;Skill3&#39;</span>] &lt;- <span style=\"color:rgb(9,134,88)\">1</span></div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Constraint for total number of items (row 11)</span></div><div>  <span style=\"color:rgb(0,16,128)\">lhs</span>[<span style=\"color:rgb(9,134,88)\">14</span>, ] &lt;- <span style=\"color:rgb(9,134,88)\">1</span>  <span style=\"color:rgb(0,128,0)\"># All items contribute to the total number of items</span></div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Specify the relationship direction for each constraint</span></div><div>  <span style=\"color:rgb(0,16,128)\">dirs</span> &lt;- <span style=\"color:rgb(121,94,38)\">c</span>(<span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>,  <span style=\"color:rgb(0,128,0)\"># Min and max for ContentArea1</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>,  <span style=\"color:rgb(0,128,0)\"># Min and max for ContentArea2</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>,  <span style=\"color:rgb(0,128,0)\"># Min and max for ContentArea3</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>,  <span style=\"color:rgb(0,128,0)\"># Min and max for ContentArea4</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>,  <span style=\"color:rgb(0,128,0)\"># Min and max for ContentArea5</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>,<span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>,<span style=\"color:rgb(163,21,21)\">&quot;&gt;=&quot;</span>, <span style=\"color:rgb(0,128,0)\"># Min for each skill</span></div><div>            <span style=\"color:rgb(163,21,21)\">&quot;&lt;=&quot;</span>)        <span style=\"color:rgb(0,128,0)\"># Total number of items</span></div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Specify the right-hand side (RHS) of the constraints</span></div><div>  <span style=\"color:rgb(0,16,128)\">rhs</span> &lt;- <span style=\"color:rgb(121,94,38)\">c</span>(<span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(9,134,88)\">15</span>,  <span style=\"color:rgb(0,128,0)\"># Min 5, max 15 for ContentArea1</span></div><div>           <span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(9,134,88)\">15</span>,  <span style=\"color:rgb(0,128,0)\"># Min 5, max 15 for ContentArea2</span></div><div>           <span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(9,134,88)\">15</span>,  <span style=\"color:rgb(0,128,0)\"># Min 5, max 15 for ContentArea3</span></div><div>           <span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(9,134,88)\">15</span>,  <span style=\"color:rgb(0,128,0)\"># Min 5, max 15 for ContentArea4</span></div><div>           <span style=\"color:rgb(9,134,88)\">5</span>, <span style=\"color:rgb(9,134,88)\">15</span>,</div><div>           <span style=\"color:rgb(9,134,88)\">5</span>,<span style=\"color:rgb(9,134,88)\">5</span>,<span style=\"color:rgb(9,134,88)\">5</span>,<span style=\"color:rgb(0,128,0)\"># Min 5, max 15 for ContentArea5</span></div><div>           <span style=\"color:rgb(9,134,88)\">40</span>)     <span style=\"color:rgb(0,128,0)\"># Total items &lt;= 20</span></div><div>  </div><div>  <span style=\"color:rgb(0,128,0)\"># Return the constraints as a data frame</span></div><div>  <span style=\"color:rgb(0,16,128)\">constraints</span> &lt;- <span style=\"color:rgb(121,94,38)\">data.frame</span>(<span style=\"color:rgb(0,16,128)\">lhs</span>, <span style=\"color:rgb(0,16,128)\">dirs</span>, <span style=\"color:rgb(0,16,128)\">rhs</span>)</div><div>  <span style=\"color:rgb(0,16,128)\">constraints</span></div><div>}</div><br><br><div><span style=\"color:rgb(0,128,0)\"># next item selection function</span></div><div><span style=\"color:rgb(121,94,38)\">customNextItem</span> &lt;- <span style=\"color:rgb(175,0,219)\">function</span>(<span style=\"color:rgb(0,16,128)\">person</span>, <span style=\"color:rgb(0,16,128)\">design</span>, <span style=\"color:rgb(0,16,128)\">test</span>){</div><div>  <span style=\"color:rgb(0,16,128)\">objective</span> &lt;- <span style=\"color:rgb(0,16,128)\">computeCriteria</span>(<span style=\"color:rgb(0,16,128)\">person</span>=<span style=\"color:rgb(0,16,128)\">person</span>, <span style=\"color:rgb(0,16,128)\">design</span>=<span style=\"color:rgb(0,16,128)\">design</span>, <span style=\"color:rgb(0,16,128)\">test</span>=<span style=\"color:rgb(0,16,128)\">test</span>,</div><div>                               <span style=\"color:rgb(0,16,128)\">criteria</span> = <span style=\"color:rgb(163,21,21)\">&#39;MI&#39;</span>) </div><div>  <span style=\"color:rgb(0,16,128)\">item</span> &lt;- <span style=\"color:rgb(0,16,128)\">findNextItem</span>(<span style=\"color:rgb(0,16,128)\">person</span>=<span style=\"color:rgb(0,16,128)\">person</span>, <span style=\"color:rgb(0,16,128)\">design</span>=<span style=\"color:rgb(0,16,128)\">design</span>, <span style=\"color:rgb(0,16,128)\">test</span>=<span style=\"color:rgb(0,16,128)\">test</span>,</div><div>                       <span style=\"color:rgb(0,16,128)\">objective</span>=<span style=\"color:rgb(0,16,128)\">objective</span>)</div><div>  <span style=\"color:rgb(0,16,128)\">item</span></div><div>}</div><div><span style=\"color:rgb(0,16,128)\">design</span> &lt;- <span style=\"color:rgb(0,0,255)\">list</span>(</div><div>  <span style=\"color:rgb(0,16,128)\">customNextItem</span>=<span style=\"color:rgb(0,16,128)\">customNextItem</span>,  <span style=\"color:rgb(0,16,128)\">constr_fun</span>=<span style=\"color:rgb(0,16,128)\">constr_fun</span>, </div><div>  <span style=\"color:rgb(0,16,128)\">test_properties</span>=<span style=\"color:rgb(0,16,128)\">test_properties</span>,</div><div>  <span style=\"color:rgb(0,128,0)\"># Stopping rule based on the change in theta estimates</span></div><div>  <span style=\"color:rgb(0,16,128)\">min_items</span> = <span style=\"color:rgb(9,134,88)\">30</span>,  <span style=\"color:rgb(0,128,0)\"># Minimum number of items to be administered</span></div><div>  <span style=\"color:rgb(0,16,128)\">max_items</span> = <span style=\"color:rgb(9,134,88)\">40</span>, <span style=\"color:rgb(0,16,128)\">min_SEM</span> = <span style=\"color:rgb(9,134,88)\">0.3</span></div><div>)</div><br><br><br><div><span style=\"color:rgb(0,128,0)\"># Run the CAT simulation with the preCAT block</span></div><div><span style=\"color:rgb(0,16,128)\">result</span> &lt;- <span style=\"color:rgb(0,16,128)\">mirtCAT</span>(<span style=\"color:rgb(0,16,128)\">mo</span>=<span style=\"color:rgb(0,16,128)\">mod</span>,  <span style=\"color:rgb(0,16,128)\">local_pattern</span> = <span style=\"color:rgb(0,16,128)\">response_patterns</span>, </div><div>                  <span style=\"color:rgb(0,16,128)\">design</span> = <span style=\"color:rgb(0,16,128)\">design</span>,  <span style=\"color:rgb(0,16,128)\">method</span> = <span style=\"color:rgb(163,21,21)\">&#39;MAP&#39;</span>,  <span style=\"color:rgb(0,128,0)\"># Maximum a posteriori estimation</span></div><div>                  <span style=\"color:rgb(0,16,128)\">criteria</span> = <span style=\"color:rgb(163,21,21)\">&#39;MI&#39;</span>,  <span style=\"color:rgb(0,128,0)\"># Maximum information criteria</span></div><div>                  <span style=\"color:rgb(0,16,128)\">progress</span> = <span style=\"color:rgb(0,0,255)\">TRUE</span>,</div><div>                  )</div><br><div><span style=\"color:rgb(121,94,38)\">plot</span>(<span style=\"color:rgb(0,16,128)\">result</span>[[<span style=\"color:rgb(9,134,88)\">1</span>]])</div><div>(<span style=\"color:rgb(0,16,128)\">items</span> &lt;- <span style=\"color:rgb(121,94,38)\">summary</span>(<span style=\"color:rgb(0,16,128)\">result</span>[[<span style=\"color:rgb(9,134,88)\">1</span>]])<span style=\"color:rgb(0,0,255)\">$</span><span style=\"color:rgb(0,16,128)\">items_answered</span>)</div><div><span style=\"color:rgb(121,94,38)\">head</span>(<span style=\"color:rgb(0,16,128)\">test_properties</span>[<span style=\"color:rgb(0,16,128)\">items</span>, ]) <span style=\"color:rgb(0,128,0)\">#items answered</span></div><div><span style=\"color:rgb(121,94,38)\">plot</span>(<span style=\"color:rgb(0,16,128)\">result</span>[[<span style=\"color:rgb(9,134,88)\">3</span>]])</div><div><span style=\"color:rgb(121,94,38)\">table</span>(<span style=\"color:rgb(0,16,128)\">test_properties</span>[<span style=\"color:rgb(0,16,128)\">items</span>, <span style=\"color:rgb(9,134,88)\">1</span><span style=\"color:rgb(0,0,255)\">:</span><span style=\"color:rgb(9,134,88)\">2</span>])</div><br></div>"
    ]
