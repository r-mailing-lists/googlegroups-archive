;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,    <u></u><u></u></p><p>                                           &#39;2PL&#39;,      &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,           &#39;gpcmIRT&#39;,          &#39;2PL&#39;,     &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,         <u></u><u></u></p><p>                                           &#39;gpcmIRT&#39;,            &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,                &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,    <u></u><u></u></p><p>                                           &#39;2PL&#39;,      &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;2PL&#39;,                &#39;2PL&#39;,     &#39;2PL&#39;,     &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,         <u></u><u></u></p><p>                                           &#39;gpcmIRT&#39;,            &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,                &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;gpcmIRT&#39;,          &#39;2PL&#39;,     &#39;2PL&#39;), method = &#39;EM&#39;,<u></u><u></u></p><p>                              accelerate = &#39;none&#39;, dentype = &quot;Gaussian&quot;, SE = TRUE, SE.type = &#39;sandwich&#39;, TOL= .0001, technical = list(removeEmptyRows=TRUE, NCYCLES = 2000), verbose = TRUE, pars = &#39;values&#39;)<u></u><u></u></p><p><u></u> <u></u></p><p>&gt; head(final_model_pars, n = 16)<u></u><u></u></p><p><u></u> <u></u></p><p>   group               item class name parnum    value lbound ubound   est prior.type prior_1 prior_2<u></u><u></u></p><p>1      1      M8A2C2_Scored  dich   a1      1 0.851000   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>2      1      M8A2C2_Scored  dich    d      2 1.877140   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>3      1      M8A2C2_Scored  dich    g      3 0.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>4      1      M8A2C2_Scored  dich    u      4 1.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>5      1      M8A4B3_Scored  dich   a1      5 0.851000   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>6      1      M8A4B3_Scored  dich    d      6 1.645896   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>7      1      M8A4B3_Scored  dich    g      7 0.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>8      1      M8A4B3_Scored  dich    u      8 1.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>9      1    M8A7B8C9_Scored  dich   a1      9 0.851000   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>10     1    M8A7B8C9_Scored  dich    d     10 1.276580   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>11     1    M8A7B8C9_Scored  dich    g     11 0.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>12     1    M8A7B8C9_Scored  dich    u     12 1.000000      0      1 FALSE       none     NaN     NaN<u></u><u></u></p><p>13     1 M8A17B17C15_Scored  dich   a1     13 0.851000   -Inf    Inf  TRUE       none     NaN     NaN<u></u><u></u></p><p>14     1 M8A17B17C15_Scored  dich    d     14 0.511954   