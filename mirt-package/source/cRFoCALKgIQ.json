   "parts": [
    [
     1,
     "<div dir=\"ltr\">pars = &#39;values&#39; returns the data.frame of starting values, not the final values after estimation. So unless the model converged instantly you would expect these to differ.<div><br clear=\"all\"><div><div dir=\"ltr\" class=\"gmail_signature\" data-smartmail=\"gmail_signature\"><div dir=\"ltr\"><div>Phil</div></div></div></div><br></div></div><br><div class=\"gmail_quote\"></div>"
    ],
