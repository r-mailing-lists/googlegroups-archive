\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#066\">1</span><span style=\"color:#660\">,</span><span style=\"color:#000\">NA</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> method</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;ML&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#606\">Error</span><span style=\"color:#000\"> </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#080\">`rownames&lt;-`</span><span style=\"color:#660\">(</span><span style=\"color:#080\">`*tmp*`</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> value </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> c</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Item.1&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Item.2&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;Item.3&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\">  </span><span style=\"color:#660\">:</span><span style=\"color:#000\"> <br>  length of </span><span style=\"color:#080\">&#39;dimnames&#39;</span><span style=\"color:#000\"> </span><span style=\"color:#660\">[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"> </span><span style=\"color:#008\">not</span><span style=\"color:#000\"> equal to array extent</span></div></code></div><div><br></div></div><div><br></div><div>same happens for 3 dimensional models<br><br><div></div></div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\