     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div class=\"gmail_quote\"><div dir=\"ltr\">On Tue, Aug 21, 2018 at 2:50 PM Dev Dalal &lt;<a href data-email-masked rel=\"nofollow\">dev....@gmail.com</a>&gt; wrote:<br></div></div></blockquote></div></div>"
