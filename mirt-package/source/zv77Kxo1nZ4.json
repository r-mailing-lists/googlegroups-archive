ght:14.4pt\">\r\n  <td height=\"19\" style=\"height:14.4pt\">\r\n  <div>e5</div>\r\n  </td>\r\n  <td align=\"right\">-0.324</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">0.799</td>\r\n  <td align=\"right\">0.743</td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.4pt\">\r\n  <td height=\"19\" style=\"height:14.4pt\">\r\n  <div>e6</div>\r\n  </td>\r\n  <td align=\"right\">-0.22</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">0</td>\r\n  <td align=\"right\">0.921</td>\r\n  <td align=\"right\">0.897</td>\r\n </tr></tbody></table><br></div><div>When I run fscores on the object [BiFactorScores &lt;- fscores(BiFactor, method=&quot;MAP&quot;, QMC=TRUE)], the output reports the factors as &quot;F1,&quot; &quot;F2,&quot; &quot;F3,&quot; and &quot;F4.&quot;</div><div><br></div><div><table border=\"0\" cellpadding=\"0\" cellspacing=\"0\" width=\"320\" style=\"border-collapse:collapse;width:240pt\">\r\n <colgroup><col width=\"64\" span=\"5\" style=\"width:48pt\">\r\n </colgroup><tbody><tr height=\"19\" style=\"height:14.4pt\">\r\n  <td height=\"19\" colspan=\"3\" width=\"192\" style=\"height:14.4pt;width:144pt\"><span>&gt;\r\n  head(BiFactorScores)</span></td>\r\n  <td width=\"64\" style=\"width:48pt\"></td>\r\n  <td width=\"64\" style=\"width:48pt\"></td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.4pt\">\r\n  <td height=\"19\" style=\"height:14.4pt\"> </td>\r\n  <td>        F1</td>\r\n  <td>          F2</td>\r\n  <td>        F3</td>\r\n  <td>         F4</td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.4pt\">\r\n  <td height=\"19\" style=\"height:14.4pt\">[1,]</td>\r\n  <td align=\"right\">-1.35854</td>\r\n  <td align=\"right\">0.211742</td>\r\n  <td align=\"right\">-0.91225</td>\r\n  <td align=\"right\">0.304294</td>\r\n </tr>\r\n <tr height=\"19\" style=\"height:14.4pt\">\r\n  <td height=\"19\" style=\"height:14.4pt\">[2,]</td>\r\n  <td align=\"right\">-0.86391</td>\r\n  <td align=\"right\">-0.90708