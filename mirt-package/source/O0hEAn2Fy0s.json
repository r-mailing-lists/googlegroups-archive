    [
     1,
     "<div dir=\"ltr\">Thanks, Will. BTW the discrete logical in this code is in reference to whether mirt() or mdirt() was initially called as in indicates whether the latent variables are continuous (IRT) or discrete (e.g., latent class), not MG estimation. Cheers.<div><br clear=\"all\"><div><div dir=\"ltr\" class=\"gmail_signature\" data-smartmail=\"gmail_signature\"><div dir=\"ltr\"><div>Phil</div></div></div></div><br></div></div><br><div class=\"gmail_quote\"></div>"
    ],
