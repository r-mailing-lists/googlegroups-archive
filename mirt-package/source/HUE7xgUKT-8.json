    [
     1,
     "<div dir=\"ltr\">There is no parameter &#39;d&#39; in a graded response model, so only the slopes are being compared. Perhaps you mean c(&#39;a1&#39;, &#39;d1&#39;, &#39;d2&#39;, &#39;d3&#39;,...)?</div><div class=\"gmail_extra\"><br clear=\"all\"><div><div class=\"gmail_signature\" data-smartmail=\"gmail_signature\"><div dir=\"ltr\"><div><div dir=\"ltr\"><div><div dir=\"ltr\"><div><span style=\"font-size:12.8px\">Phil</span><br></div></div></div></div></div></div></div></div>\r\n<br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">On Thu, Aug 24, 2017 at 6:31 AM,  <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">ber...@terluin.net</a>&gt;</span> wrote:<br></div></div>"
    ],
