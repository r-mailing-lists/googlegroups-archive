#IIF Plotting function (basically just a wrapper for itemplot)
IIFplot <- function(x){
  png(file = paste(model.name <http://model.name>, " ", names(irtdata)[[x]], " IIF.png", sep=""),
      width = 600, height = 600)
  print(itemplot(model, x, type = "info",
                 main = paste("IIF for ", names(irtdata)[[x]], sep = ""),
                 scales = list(x = list(at = seq(min(Theta), max(Theta), 1))),
                 xlim = c(min(Theta),max(Theta)),
                 ylim = c(0, infomax), col = steelblue))
  dev.off()
}
#If you want to get the IIF for a single item use IIFplot(n). E.g., IIFplot(2)
#saves the IIF for item 2.

#ICC Plotting function (basically just a wrapper for itemplot)
ICCplot <- function(x){
  png(file = paste(model.name <http://model.name>, " ", names(irtdata)[[x]], " ICC.png", sep=""),
      width = 600, height = 600)
  print(itemplot(model, x, type = "trace",
                 main = paste("ICC for ", names(irtdata)[[x]], sep = ""),
                 scales = list(x = list(at = seq(min(Theta), max(Theta), 1))),
                 xlim = c(min(Theta), max(Theta))))
  dev.off()
}
#If you want to get the ICC for a single item use ICCplot(n). E.g., ICCplot(2)
#saves the ICC for item 2.

#use mapply to run the functions across all items.
mapply(IIFplot, seq(1, nitems, 1))
mapply(ICCplot, seq(1, nitems, 1))

