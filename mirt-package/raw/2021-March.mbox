Message-ID: <bkW-1WDEAgk.mQMgvdfyBgAJ@mirt-package.groups.google.com>
In-Reply-To: <bkW-1WDEAgk.HvMjqd7lBgAJ@mirt-package.groups.google.com>
References: <bkW-1WDEAgk.Rm6_7DbiBgAJ@mirt-package.groups.google.com> <bkW-1WDEAgk.HvMjqd7lBgAJ@mirt-package.groups.google.com>
Archived-At: <https://groups.google.com/g/mirt-package/c/bkW-1WDEAgk/m/mQMgvdfyBgAJ>
MIME-Version: 1.0
Content-Type: text/plain; charset="utf-8"
Content-Transfer-Encoding: 8bit

I solved the problem.  The issue is inconsistency between the integration grid used in the EM algorithm and my assumed prior distribution.  If I adjust the theta_lim to more sensible values, I recover the data generating parameters (code below).  This is in a weird space between user error and a bug.  I should have been more responsible about the integration grid.  On the other hand it might be good to print a warning message if the user specified a mean and variance for latent ability that has a lot of mass outside of the default integration region.

## figuring out how to map mirt() 2PL item parameters to traditional IRT

## parameters when the latent variable distribution is set to a given mean and

## variance

set.seed(2322)

options(width=120)

library(mirt)

N       <- 500000

J       <- 10

mu      <- 5

sigmasq <- 2^2

theta   <- rnorm(N, mean=mu, sd=sqrt(sigmasq))

## J items with difficulties across ability range, and equal discriminations

a <- rep(1 / sqrt(sigmasq), J)

b <- seq(from = mu - 2*sqrt(sigmasq), to = mu + 2*sqrt(sigmasq), length=J)

X <- t(sapply(theta, function(x){ as.integer(runif(J) < (1 / (1 + exp(-a*(x - b))))) }))

colnames(X) <- paste0("it",1:J)

print(cbind(a=a,b=b))

print(apply(X, 2, mean))

p  <- mirt(X, 1, itemtype="2PL", pars="values")

## fix ability mean and variance at known population values

wh  <- which(p$name %in% c("MEAN_1","COV_11"))

p$est[wh]   <- FALSE

p$value[wh] <- c(mu, sigmasq)

print(p)

m1 <- mirt(X, 1, itemtype="2PL", pars=p)

print(coef(m1))

## bad parameter estimates.  The issue is that the default theta_lim of (-6,6)

## does not sufficiently cover the range of theta under the specified N(5, 2^2)

## ability distribution

print(m1@Options$theta_lim)

## run with more sensible grid:

m2 <- mirt(X, 1, itemtype="2PL", pars=p, technical=list(theta_lim = c(-2,12)))

print(tmp <- coef(m2))

tmp <- do.call("rbind",tmp[grep("it", names(tmp))])[,c("a1","d")]

print(cbind(truth = a, est = tmp[,"a1"]))

print(cbind(truth = b, est = -tmp[,"d"]/tmp[,"a1"]))

