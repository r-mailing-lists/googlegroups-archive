                         invariance=c('Dis16', 'Dis17', 'Dis18', 'free_means', 'free_variance'))

dif1 <- DIF(MGmodel, c('a', "d1", "d2", "d3", "d4"), scheme = 'add_sequential',  p.adjust = 'BH', seq_stat = .01)

I then tried to get an output for dif1 (adjuted p-values to report in manuscript), and I got the following output:
