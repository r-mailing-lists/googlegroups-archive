>
> library(mirt)
> mod <- mirt(Science, 1)
> fscores(mod, full.scores = FALSE)
> newdata <- rbind(c(1,1,1,1), c(1,4,3,2))
> fscores(mod, response.pattern = newdata)
>
> HTH.

>
> Phil
