> > } else if(type == 'bimodal'){
> > Theta <- matrix(scale(c(rnorm(N/2, -1.5), rnorm(N/2, 1.5))))
> > }
> > dat <- simdata(a, d, N, itemtype = 'dich', Theta=Theta)
> > if(all(apply(dat, 2, function(x) length(unique(x))) == 2L)) break
> > }
> > dat
> > }
