> >     ret <- c(cor=mean(sapply(results, function(x) round(cor(x[,1], x[,2]), 5))),
> >              bias=mean(sapply(results, function(x) round(bias(x[,1], x[,2]), 5))),
> >              RMSE=mean(sapply(results, function(x) round(RMSE(x[,1], x[,2]), 5))))
> >     ret
> > }
