library(mirt)
mod <- mirt(Science, 1) #original
logLik(mod)

Science2 <- simdata(model = mod, N = 1000) #newdata generated from estparamters

sv <- mod2values(mod)
sv$est <- FALSE #fix starting values to last model
mod2 <- mirt(Science2, 1, pars = sv)
logLik(mod2)

Phil

