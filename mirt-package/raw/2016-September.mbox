pattern[14 * 4 + 3, 'value'] = 0.108
pattern[14 * 4 + 1, 'est'] = FALSE
pattern[14 * 4 + 2, 'est'] = FALSE
pattern[14 * 4 + 3, 'est'] = FALSE

myObj = mirt(myData, 1, pars = pattern)
coefs = coef(myObj, simplify=TRUE, IRTpars=TRUE)

