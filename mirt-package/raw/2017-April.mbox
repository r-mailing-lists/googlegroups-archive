> > > > > > > > > > >             start.vals$parnum[start.vals$name == paste0('d',j) & (start.vals$item %in% itemnames[pick + i]) & start.vals$est]
> > > > > > > > > > >     }
> > > > > > > > > > >
> > > > > > > > > > >     constraints[[paste0('Time.', i)]] <- wrmconstr[pick + i]
> > > > > > > > > > >
> > > > > > > > > > > }
> > > > > > > > > > >
> > > > > > > > > > > ### Test of bifactor model
