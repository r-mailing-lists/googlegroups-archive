I'm sending a reproducible example with the data file attached (data_N448.csv)

I wanted to assess three versions of a CRT cognitive measure, the original 3-item measure and two longer versions - an 8-item version and 11-item version applying item response theory analyses (a two-parameter logistic model), to see whether the longer versions are appropriate for participants with both lower and higher levels of the latent trait.
All the items are binary with no missing values.
Sample size is 448.

#importing data
df.NA.zaCRT3 <- read_csv("data_N448.csv")
df.NA.zaCRT3 <- df.NA.zaCRT3[,-1]

psych::describe(df.NA.zaCRT3)
#Checking for missing values -> none are missing
colSums(is.na <http://is.na>(df.NA.zaCRT3))

#selecting items and forming 3 data frames:
podaci.CRT.rec <- as.data.frame(dplyr::select(df.NA.zaCRT3, CRT1:CRT11)) #data frame with all the 11 items
podaci.CRT8.rec <- as.data.frame(dplyr::select(df.NA.zaCRT3, CRT1:CRT3, CRT5:CRT8,CRT11)) #data frame with 8 items
podaci.CRT3.rec <- as.data.frame(dplyr::select(df.NA.zaCRT3, CRT1:CRT3)) # df s prve3 CRT #data frame with 3 original items

##------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------

#11-items 2PL model:
fit.crt11.2pl <- mirt(podaci.CRT.rec, model = 1, calcNull = T,  SE = T)

#Model fit:
round(M2(fit.crt11.2pl, na.rm = T), 3)
#        M2 df     p RMSEA RMSEA_5 RMSEA_95 SRMSR   TLI   CFI
#stats 51.2 44 0.212 0.019       0    0.038 0.035 0.997 0.998

print(fit.crt11.2pl)
#Log-likelihood = -2477.082
#Estimated parameters: 22
#AIC = 4998.164; AICc = 5000.545
#BIC = 5088.469; SABIC = 5018.65
#G2 (2025) = 625.93, p = 1
#RMSEA = 0, CFI = 0, TLI = -7.732

#item fit
itemfit(fit.crt11.2pl, c('S_X2','X2')) #both S_X2 and X2 iako 'X2' je pretty much useless given inflated Type I error rates
#item     X2 df.X2 RMSEA.X2  p.X2  S_X2 df.S_X2 RMSEA.S_X2 p.S_X2
#    item     X2 df.X2 RMSEA.X2  p.X2   S_X2 df.S_X2 RMSEA.S_X2 p.S_X2
#1   CRT1  4.637     4    0.019 0.327  3.545       6      0.000  0.738
#2   CRT2 14.845     8    0.044 0.062  2.266       7      0.000  0.944
#3   CRT3 13.021     6    0.051 0.043  9.065       7      0.026  0.248
#4   CRT4 11.185     7    0.037 0.131  8.734       7      0.024  0.272
#5   CRT5  4.318     7    0.000 0.743  3.000       6      0.000  0.809
#6   CRT6 20.307     4    0.095 0.000  9.796       6      0.038  0.134
#7   CRT7  9.273     6    0.035 0.159  3.541       6      0.000  0.739
#8   CRT8 33.621     7    0.092 0.000 13.685       8      0.040  0.090
#9   CRT9 16.186     8    0.048 0.040  5.449       8      0.000  0.709
#10 CRT10  7.547     8    0.000 0.479  7.629       8      0.000  0.471
#11 CRT11 11.529     6    0.045 0.073  9.724       7      0.030  0.205

##------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------

#8-items 2PL model:
fit.crt8.2pl <- mirt(podaci.CRT8.rec, model = 1, calcNull = T,  SE = T)
mirt(podaci.CRT8.rec, model = 1, calcNull = T,  SE = T)

#Moled fit:
round(M2(fit.crt8.2pl, na.rm = T), 3)
#          M2 df     p RMSEA RMSEA_5 RMSEA_95 SRMSR   TLI CFI
#stats 18.184 20 0.575     0       0    0.037 0.025 1.001   1

print(fit.crt8.2pl)
#Log-likelihood = -1804.773
#Estimated parameters: 16
#AIC = 3641.546; AICc = 3642.809
#BIC = 3707.223; SABIC = 3656.446
#G2 (239) = 183.86, p = 0.9967
#RMSEA = 0, CFI = 1, TLI = 1.065

#item fit
itemfit(fit.crt8.2pl, c('S_X2','X2')) #both S_X2 and X2 iako 'X2' je pretty much useless given inflated Type I error rates
#item     X2 df.X2 RMSEA.X2  p.X2  S_X2 df.S_X2 RMSEA.S_X2 p.S_X2
#1  CRT1  4.935     3    0.038 0.177 4.229       4      0.011  0.376
#2  CRT2 32.248     8    0.082 0.000 3.453       5      0.000  0.631
#3  CRT3  8.952     6    0.033 0.176 3.234       4      0.000  0.519
#4  CRT5  7.373     7    0.011 0.391 3.752       4      0.000  0.441
#5  CRT6 43.604     4    0.149 0.000 2.855       4      0.000  0.582
#6  CRT7 14.191     6    0.055 0.028 4.561       4      0.018  0.335
#7  CRT8 33.816     7    0.093 0.000 8.211       5      0.038  0.145
#8 CRT11 12.145     6    0.048 0.059 8.733       4      0.051  0.068

#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------

#3-items 2PL model:

fit.crt3.2pl <- mirt(podaci.CRT3.rec, model = 1, calcNull = T,  SE = T)

#Model fit:
round(M2(fit.crt3.2pl, na.rm = T), 3)
#Error: M2() statistic cannot be calculated due to too few degrees of freedom

fit.crt3.2pl @Fit
#$G2
#[1] 0.0004630958
print(fit.crt3.2pl) #get fit indices
#Log-likelihood = -800.701
#Estimated parameters: 6
#AIC = 1613.402; AICc = 1613.593
#BIC = 1638.031; SABIC = 1618.989
#G2 (1) = 0, p = 0.9828
#RMSEA = 0, CFI = 1, TLI = 1.016

#item fit - > S_X2 cannot be computed:
itemfit(fit.crt3.2pl, c('S_X2','X2')) #both S_X2 and X2 iako 'X2' je pretty much useless given inflated Type I error rates
#  item      X2 df.X2 RMSEA.X2 p.X2 S_X2 df.S_X2 RMSEA.S_X2 p.S_X2
#1 CRT1  30.442     5    0.107    0  NaN       0        NaN    NaN
#2 CRT2 136.747     8    0.190    0  NaN       0        NaN    NaN
#3 CRT3  18.092     2    0.134    0  NaN       0        NaN    NaN

# Computing X2* -> bootstrapping -> estimates differ each time
itemfit(fit.crt3.2pl, c('X2*'))
#  item X2_star p.X2_star
#1 CRT1   0.031     0.789
#2 CRT2   0.056     0.909
#3 CRT3   0.016     0.783

# item X2_star p.X2_star
#1 CRT1   0.031     0.832
#2 CRT2   0.056     0.924
#3 CRT3   0.016     0.753

#to get the degrees of freedom - calculating the scaled X2* and scaled degrees of freedom:
itemfit(fit.crt3.2pl, na.rm = T, fit_stats = "X2*_df" )
#  item X2_star_scaled df.X2_star_scaled RMSEA.X2_star_scaled p.X2_star_scaled
#1 CRT1          0.958             0.475                0.048            0.151
#2 CRT2          0.781             0.292                0.061            0.109
#3 CRT3          0.818            -0.124                  NaN              NaN

#  item X2_star_scaled df.X2_star_scaled RMSEA.X2_star_scaled p.X2_star_scaled
#1 CRT1          0.858             0.180                0.092            0.061
#2 CRT2          0.840             0.419                0.047            0.149
#3 CRT3          1.062             0.514                0.049            0.150

#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------
#------------------------------------------------------------------------------------------------------
#Comparing the 3 models

#Test information functions of the three models
plot(fit.crt11.2pl, type = "info", col.line ="blue") +
  as.layer(plot(fit.crt8.2pl, type = "info", col.line ="red")) +
  as.layer(plot(fit.crt3.2pl, type = "info", col.line ="black"))

#Area under the curve:
 areainfo(fit.crt8.2pl, theta_lim = c(-10,10))
#LowerBound UpperBound     Info TotalInfo Proportion nitems
#-10         10 18.33564  18.33564          1      8
 areainfo(fit.crt11.2pl, theta_lim = c(-10,10))
#LowerBound UpperBound     Info TotalInfo Proportion nitems
#-10         10 22.63839  22.63839          1     11
 areainfo(fit.crt3.2pl, theta_lim = c(-10,10))
#LowerBound UpperBound     Info TotalInfo Proportion nitems
#-10         10 7.983275  7.983275          1      3

#Finding  the Theta where there is the highest amount of  information

testinfo(fit.crt11.2pl, fscores(fit.crt11.2pl)) %>%
   cbind(fscores(fit.crt11.2pl)) %>%
   data.frame() %>%
   `colnames<-`(c("Info", "Theta")) %>%
   filter(Info == max(Info))

 #      Info     Theta
 #1 11.93011 0.1401821

testinfo(fit.crt8.2pl , fscores(fit.crt8.2pl)) %>%
  cbind(fscores(fit.crt8.2pl)) %>%
  data.frame() %>%
  `colnames<-`(c("Info", "Theta")) %>%
  filter(Info == max(Info))

#      Info     Theta
#1 10.59596 0.1576335

testinfo(fit.crt3.2pl, fscores(fit.crt3.2pl)) %>%
