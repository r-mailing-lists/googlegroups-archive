> > >     }
> > >
> > >     constraints[[paste0('Time.', i)]] <- wrmconstr[pick + i]
> > >
> > > }
> > >
> > > ### Test of bifactor model
> > > s1.rm.fit <- bfactor(s1, itemloadings, s1.rm.fact, constrain = constraints, optimizer = "nlminb")
