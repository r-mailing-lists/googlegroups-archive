map.keys<-lapply(data,"[[",1)
map.values<-lapply(data,"[[",2)

wordcount= function(map.keys, map.values){
  keys <- unlist(strsplit(unlist(map.values), split=' '))
  value <- 1
  lapply(keys, FUN=paste, value=value)
}

wordcount(map.keys,map.values)

