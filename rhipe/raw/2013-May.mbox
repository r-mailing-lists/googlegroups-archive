  for(x in map.values)
    rhcollect(NULL,paste(sample(1:100,1), paste(sample(letters,3),collapse=""), paste(sample(letters,36,replace=TRUE),collapse=""),
                         runif(1),runif(1),runif(1),runif(1),xtime,sep=",",collapse=","))
