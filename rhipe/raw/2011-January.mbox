Here's the code I used.

map <- expression({
  h <- do.call("rbind",map.values)
  d <- h[h$carrier=='WN',,drop=FALSE]
  if(nrow(d)>0){
    e <- split(d,list(d$year,d$month,d$mday))
    lapply(e,function(r){
      k <- as.vector(unlist(r[1,c("year","month","mday")]))  ## remove
attributes
      rhcollect(k, r)
    })
  }
})
reduce <- expression(
    pre = { collec <- NULL },
    reduce = {
      collec <- rbind(collec, do.call("rbind",reduce.values))
      collec <- collec[order(collec$depart),]
    },
    post = {
      rhcollect(k, collec)
    }
    )

mapred <- list(rhipe_map_buff_size=10,mapred.job.tracker='local')
z <-
rhmr(map=map,reduce=reduce,combiner=TRUE,inout=c("sequence","map")
          ,ifolder="/airline/blocks/",ofolder="/airline/southwest"
          ,mapred=mapred)
rhex(z)

