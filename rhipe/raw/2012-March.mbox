Hello,

Piet, I spoke too soon. To get the mean, use the following code

Some notes,

1. the mapred options
            mapred.reduce.tasks=1
             ,io.sort.mb = 1
             ,rhipe_map_buff_size=100
             ,rhipe_reduce_buff_size=100

are purely for this example to force a few reduce tasks and force a combiner.

map <- expression({
  tryCatch({
    rows <- do.call('rbind',strsplit(unlist(map.values)," +"))
    apply(rows[,c(4,2,9,10)], 1, function(r){
      nv <- as.numeric(r[2:4])
      for(i in seq_along(nv)){

        rhcollect(list(r[1],col.id <http://col.id>=i), c(count=1, sum=nv[i], max=nv[i],min=nv[i]))

      }
    })
  },error=function(e){
    rhstatus(sprintf("ERROR: Read : %s", e$message))
    rhcounter("R_ERRORS",as.character(e), 1)
  })
})

reduce <- expression(
    pre={
      counts <- 0 ; sums <- 0; mins <- Inf;maxs <- -Inf;
      getName <- function(lst,nm) unlist(lapply(lst,function(j) j[[nm]]))
    }
    ,reduce={
      counts <- counts + sum(getName(reduce.values,"count") )
      sums   <- sums   + sum(getName(reduce.values,"sum") )
      maxs   <- max( c(maxs,getName(reduce.values,"max")) )
      mins   <- min( c(mins,getName(reduce.values,"min")) )
    }
    ,post={

      ## If this is being called in a combiner, the falling predicate
      ## is FALSE. If true it means no more values for the current key
      if(.rhipe.current.state == "reduce")
        rhcollect(reduce.key, c(sums/counts,max=maxs,min=mins))
      else
        rhcollect(reduce.key, c(count=counts, sum=sums,max=maxs,min=mins))

      }
    )

z <- rhmr(map=map,reduce=reduce, combine=TRUE
          ,ifolder = "/user/sguha/tmp/foo.txt"
          ,ofolder = "/user/sguha/tmp/tmp.txt"
          ,inout   = c("text","text")
          ,zips    = "/user/sguha/Rfolder.tar.gz"

          ,mapred=list(mapred.reduce.tasks=1,
             io.sort.mb = 1
             ,rhipe_map_buff_size=100
             ,rhipe_reduce_buff_size=100
             ,mapred.textoutputformat.separator = " ")
          )
rhstatus(rhex(z,async=TRUE),mon.sec=5)

