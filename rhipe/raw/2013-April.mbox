I have one more question regarding getting data from hbase i.e inoutformat for mapreduce
I set rowkey rows=list("1448484683776","2547996311552"), and colspec is null

So if you see the code in RHCrashReportTableInputFormat.java [RhipeHbaseMozilla] .
if you define colspec= null, then startrowkey and endrowkey is not set, we ignore that part.
So, if we send rows=null or  rows=list("1448484683776","2547996311552"), then we get same output.
I think we need to define some logic like if rows!=null then setStartrowkey and setEndRowkey.

Could you please check your this function

public void setConf(Configuration conf) {
        this.conf = conf;

        String tableName = conf.get(INPUT_TABLE);
        try {
            setHTable(new HTable(HBaseConfiguration.create(conf), tableName));
        } catch (Exception e) {
            LOG.error(StringUtils.stringifyException(e));
        }

        Scan[] scans = null;
        LOG.info("DEBUG: D1 ");
        if (conf.get(RHIPE_COLSPEC) != null) {
            try {
                DateFormat formatter = new SimpleDateFormat(conf.get("rhipe.hbase.dateformat"));
                String[] cols = conf.get(RHIPE_COLSPEC).split(",");
                ArrayList<Pair<String,String>> l = new ArrayList<Pair<String,String>>(cols.length);
                String ss1  = new String(org.apache.commons.codec.binary.Base64.decodeBase64(conf.get("rhipe.hbase.rowlim.start")));
                String ss2  = new String(org.apache.commons.codec.binary.Base64.decodeBase64(conf.get("rhipe.hbase.rowlim.end")));
                Date d1 = (Date)formatter.parse(ss1);
                Date d2 = (Date)formatter.parse(ss2);
                LOG.info("DEBUG: D1="+d1+" D2="+d2);
                Calendar c1=Calendar.getInstance(),c2=Calendar.getInstance();
                c1.setTime(d1);c2.setTime(d2);
                for(int i=0;i < cols.length;i++) {
                String[] x = cols[i].split(":");
                l.add(new Pair<String,String>(x[0],x[1]));
                }
                String[] x = conf.get("rhipe.hbase.mozilla.cacheblocks").split(":");
                if( conf.get("rhipe.hbase.mozilla.prefix")!=null && conf.get("rhipe.hbase.mozilla.prefix").equals("byteprefix")){
                LOG.info("Using the byteprefix scanner");
                scans = Util.generateBytePrefixScans(c1,c2,
                                conf.get("rhipe.hbase.dateformat"),
                                    l,
                                    Integer.parseInt(x[0]),
                                    Integer.parseInt(x[1]) == 1? true: false);
                LOG.info("Dateformat"+conf.get("rhipe.hbase.dateformat")+" c1="+c1+" c2="+c2+" lengthscan="+scans.length);

                }else{
                LOG.info("Using the hexprefix scanner");
                scans = Util.generateHexPrefixScans(c1,c2,
                                conf.get("rhipe.hbase.dateformat"),
                                    l,
                                    Integer.parseInt(x[0]),
                                    Integer.parseInt(x[1]) == 1? true: false);
                }
            } catch (ParseException e) {
                e.printStackTrace();
                LOG.error("An error occurred.", e);
            }
        } else {
            scans = new Scan[] { new Scan() };
        }

        setScans(scans);

    }

