Hmm unfortunately google groups breaks R code lines.  So here is a
gist:
https://gist.github.com/1604934

Don't forget to use zips argument after making your archive.  For
example,
    library(Rhipe)
    rhinit()
    rhoptions(runner="sh ./RhipeLib/rhipe.C.sh <http://rhipe.C.sh>")
    a = list()
    a$ofolder =  "/wsc/jrounds/garbage/lapplytest"
    a$inout = c("lapply", "sequence")
    a$jobname = a$ofolder
    a$N = 10

    a$map = expression({
        for(i in seq_along(map.values)){
            rhcollect(runif(1),runif(100))
        }

    })
    a$zips="/wsc/jrounds/RhipeLib.tar.gz"
    mr = do.call("rhmr",a)
    ex = rhex(mr)

