If you wait till 0.73 and a few weeks, there will be docs for reading from Hbase.
E.g. this reads the data:json column from Hbase. Keys and values are always raw bytes.

code <- rhmap({
  library(RJSONIO)
  p <- fromJSON(rawToChar(r[[ "data:json" ]])

})
fext <- rhwatch(map        = code
                ,reduce    = summer,
                ,input     = hbaseif(table="metrics" ,colspec="data:json")
                ,debug     = 'count'
                ,param     = list(beginningOflastMonth = Sys.Date()-45))

