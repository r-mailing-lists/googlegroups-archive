First-way:

#setup
setup<- expression({
reduce={
library(biganalytics)
library(biglm)
library(bigmemory)
}
})

second:

setup<- expression({
library(biganalytics)
library(biglm)
library(bigmemory)
})

Third way:

#Setup
setup<- expression({
map=expression({
home.Rlib <- "/usr/lib/R/lib"
invisible(.libPaths(c(home.Rlib,.libPaths())))
