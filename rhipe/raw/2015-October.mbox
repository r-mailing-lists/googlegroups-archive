map = expression({
  for(i in seq_along(map.values)){
   v = map.values[[i]]
   k = map.keys[[i]]
 v = analytics$append.proportion(v)
 v = analytics$append.check_analytics_possible(v)
 silent=FALSE
 if(!v$analytics_possible)
   next
 e = NULL
 ret = try({gc()},silent=TRUE)
 e = new.env()
 e$v = v
 v = NULL
 for(foo in analytics){
   try({
       e$v = foo(e$v)
   }, silent=silent)

 }

 #return(v)
 v = e$v
 collect(k,v)
  }
})

