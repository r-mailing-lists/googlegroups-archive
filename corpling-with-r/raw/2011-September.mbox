>
>
> for (i in seq(all.matches)) {
>
>         cat(file=output.file, append=T,
>         all.matches[max(0, i-100):max(0, i-1)],
>         "\t",
>         all.matches[i],
>         "\t",
>         all.matches[(i+1):min(i+100, length(all.matches)+1)],
>         "\n")
>         }
