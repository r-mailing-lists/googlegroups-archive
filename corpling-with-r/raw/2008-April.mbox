Content-Transfer-Encoding: 8bit

# if you're data are in the form of a vector
a.vector<-c("1234.", "2345.", "3435.", "4343.")
gsub("\\.", "", a.vector)

# if you're data are in the form of a factor
a.factor<-factor(a.vector)
levels(a.factor)<-gsub("\\.", "", a.vector)
a.factor

