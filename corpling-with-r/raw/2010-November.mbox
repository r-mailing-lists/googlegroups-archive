rm(list=ls(all=TRUE))
bnc.files <- dir("/home/stgries/Corpora/BNCwe_SGML", full.names=TRUE)
all.squirrels <- character()

start.time <- date()
for (bnc.file in bnc.files) {
   cat(basename(bnc.file), "\n")
   current.corpus.file <- scan(bnc.file, what=character(0), sep="\n",
quiet=TRUE)
   current.sentences <- grep("<s n=", current.corpus.file, perl=TRUE,
value=TRUE)
   current.squirrels <- exact.matches("<w N[^>]+>squirrels?",
current.sentences)[[4]]
   if (length(current.squirrels)>0) { all.squirrels <-
append(all.squirrels, current.squirrels) }
}
end.time <- date()
cat("Start time:", start.time, "\nEnd time:", end.time, "\n")

