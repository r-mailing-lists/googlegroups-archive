You can transform list to data.frame, then use write.csv once.

t <- list(c("@", "@", "@", "_o:I222p30601.SBH06", "Markup(samp)", "-" , "-", "-"),
          c("Wj",  "wj",  "wj",  "wij" ,"404", "-" ,  "-" ,  "-"  ))
t
df <- data.frame(matrix(unlist(t), nrow=length(t), byrow=T),
                 stringsAsFactors=FALSE)
df

