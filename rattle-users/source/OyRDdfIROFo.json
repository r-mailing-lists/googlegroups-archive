MILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font></font></span> </pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font>Other plots are coming out OK.</font></span></pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font></font></span> </pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font>Thanks for the help.</font></span></pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font></font></span> </pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font>Regards</font></span></pre><pre style=\"BORDER-BOTTOM-STYLE:none;LINE-HEIGHT:1.2;BORDER-RIGHT-STYLE:none;MARGIN:0px;OUTLINE-STYLE:none;FONT-FAMILY:&#39;Lucida Console&#39;;WHITE-SPACE:pre-wrap!important;BORDER-TOP-STYLE:none;BORDER-LEFT-STYLE:none\">\r\n\r\n<span><font>Dr S Muralidharan</font></span></pre></span></div><span><font color=\"#888888\">\r\n\r\n<p></p>\r\n\r\n-- <br>\r\nYou received this message because you are subscribed to the Google Groups &quot;rattle-users&quot; group.<br>\r\nTo view