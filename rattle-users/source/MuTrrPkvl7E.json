olor:#660\">)</span><span style=\"color:#000\"><br> </span><span style=\"color:#066\">3</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#606\">RGtk2</span><span style=\"color:#660\">::</span><span style=\"color:#000\">gtkMainIterationDo</span><span style=\"color:#660\">(</span><span style=\"color:#000\">blocking </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> FALSE</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br> </span><span style=\"color:#066\">4</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> updateFilenameFilters</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;data_filechooserbutton&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;CSV&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br> </span><span style=\"color:#066\">5</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> rattle</span><span style=\"color:#660\">()</span><span style=\"color:#000\"><br><br></span><span style=\"color:#606\">Possible</span><span style=\"color:#000\"> actions</span><span style=\"color:#660\">:</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> abort </span><span style=\"color:#660\">(</span><span style=\"color:#008\">with</span><span style=\"color:#000\"> core </span><span style=\"color:#008\">dump</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#008\">if</span><span style=\"color:#000\"> enabled</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">2</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> normal R </span><span style=\"color:#008\">exit</span><span style=\"color:#000\"><br></span><span style=\"color:#066\">3</span><span 