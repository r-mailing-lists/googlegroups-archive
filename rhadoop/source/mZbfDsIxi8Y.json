     1,
     "<span style=\"font-family:verdana,sans-serif\">Here it goes.<br><br>&gt; hb.new.table(&quot;testmatrix&quot;, &quot;name&quot;, &quot;value&quot;);</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">[1] TRUE</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">&gt; mata &lt;- matrix(data = 1, nrow = 10, ncol = 6, byrow = FALSE, dimnames = NULL);</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">&gt; mata</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">      [,1] [,2] [,3] [,4] [,5] [,6]</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [1,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [2,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [3,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [4,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [5,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [6,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [7,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [8,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"> [9,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">[10,]    1    1    1    1    1    1</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">&gt; hb.insert(&quot;testmatrix&quot;, list(1, c(&quot;name&quot;, &quot;value&quot;), list(&quot;mata&quot;, mata)))</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Error in row[[2]] : subscript out of bounds</span><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Thanks and regards,</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Souvik.</span>"
