a,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">hb.new.table(&quot;data&quot;, &quot;base&quot;);</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">hb.insert(&quot;data&quot;,list( list(1,c(&quot;base:Name&quot;, &quot;base:Value&quot;), list(&quot;name1&quot;, &quot;value1&quot;))))</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">rows&lt;-hb.scan(&quot;data&quot;,start=1,<u></u>colspec=c(&quot;base&quot;))</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">readval &lt;- rows$get()</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">for ( i in 1:length(readval) ) {</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    # this is to print the Name and corresponding value</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Name = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[1]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Value = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[2]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">}</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">==============================<u></u>=========</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">When I do the above it prints the Name and Value just fine.</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">[1] &quot;Name = &quot;</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">[1] &quot;name1&quot;</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">[1] &quot;Value = &quot;</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">[1] &quot;value1&quot;</span><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">******************************<u></u>******************************<u></u>*</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">But what I was trying to do is to access the HBase output by Column Name.</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">I need this because I might have different no of Columns of each row and depending on the name of the Column the order gets changed.</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Let me insert another row in the same table.</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Here I will store 3 columns in the columnfamily named &quot;base&quot;.</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">==============================<u></u>=========</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">hb.insert(&quot;data&quot;,list( list(2,c(&quot;base:Name&quot;, &quot;base:Value&quot;, &quot;base:Desc&quot;), list(&quot;name1&quot;, &quot;value1&quot;, &quot;This is a description&quot;))))</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">==============================<u></u>=========</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Now the above code will not print the correct Name and Value.</span><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">What I was trying to have is somewhat to access like this. ( The below code doesn&#39;t work, I have mentioned just to give a feel )</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">==============================<u></u>=========</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">\r\nfor ( i in 1:length(readval) ) {</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    # this is to print the Name and corresponding value</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Name = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[&quot;<u></u>base:Name&quot;]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Value = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[&quot;<u></u>base:Value&quot;]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">}</span><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\"># OR May be like this </span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">for ( i in 1:length(readval) ) {</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    # this is to print the Name and corresponding value</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Name = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[&quot;<u></u>Name&quot;]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">    print(&quot;Value = &quot;)</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">    print(readval[[i]][[3]][[&quot;<u></u>Value&quot;]]);</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">}</span><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">==============================<u></u>=========</span><br style=\"font-family:verdana,sans-serif\">\r\n<br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Thanking you.</span><br style=\"font-family:verdana,sans-serif\"><br style=\"font-family:verdana,sans-serif\"><span style=\"font-family:verdana,sans-serif\">Regards,</span><br style=\"font-family:verdana,sans-serif\">\r\n<span style=\"font-family:verdana,sans-serif\">Souvik.</span><br style=\"font-family:verdana,sans-serif\"></blockquote></div></div></div>\r\n\r\n<p></p></blockquote></div>"
