   "parts": [
    [
     1,
     "<div dir=\"ltr\">The default format is &quot;native&quot;. from.dfs has not ability to detect the format of files it is supposed to read. Please provide the format argument and read the manual for make.input.format. This specific case appears to be some variant of csv.<div>\r\n\r\n<br></div><div><br></div><div>Antonio</div></div><div class=\"gmail_extra\"><br><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
