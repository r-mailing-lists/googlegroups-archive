Here's my  R code:
map <- function(k,v) {
    fields <- unlist(strsplit(v, ","))
    kv_map = keyval(fields[1],fields[3])
    rmr.str(kv_map)
    return(kv_map)
}
mapreduce(
  input = "test_stock.txt",
  input.format = "text",
  map = map,
