csvFormat = make.input.format("csv", sep = ",",stringsAsFactors=FALSE,mode="text")
from.dfs(
  mapreduce(
    to.dfs(mtcars),
    map =
      function(k, v) keyval(v[, c('carb', 'cyl')], v[, c('carb', 'cyl', 'mpg')]),
    reduce =
      function(k, vv) if(nrow(vv) > 0) {c.vv = ddply(vv, .(carb, cyl), transform, count = NROW(piece));
                                        result = aggregate.data.frame(c.vv, by = c.vv[, c("carb", "cyl")],  mean)
                                        keyval(k,result[,c("mpg","count")])
      }
#     ,output.format = make.output.format("csv",quote=FALSE,sep=",",mode="text")
