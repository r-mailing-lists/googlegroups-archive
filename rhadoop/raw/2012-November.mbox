mapreduce(input = rel.dfs,
map = function(k,v) {
for (u in 1:n){
for (v1 in 1:n){

node_u <- v[[u]][1]
node_v <- v[[v1]][1]

node_r_u <- v[[u]][-1]
node_r_v <- v[[v1]][-1]

if (node_u == node_v) {next} else {s_uv=0.0}

for (n_u in node_r_u){

for (n_v in node_r_v){
keyval(c(n_u, n_v), s_uv)
}
}

}
}
},
reduce = function(keypairneighbours, s_uv) {
