The original code is:

s <- function(rel, s_df, s_df_old){

n <- length(rel)
r <- 0.9
s_uv <- 0
nodes <- c()

for (node in 1:n){
nodes <- c(nodes,rel[[node]][1])
}
#browser()
for(iter in 1:niter){
if(converged(s_df,s_df_old)){break}
s_df_old <- s_df
for (u in 1:n){
for (v in 1:n){

node_u <- rel[[u]][1]
node_v <- rel[[v]][1]

node_r_u <- rel[[u]][-1]
node_r_v <- rel[[v]][-1]

if (node_u == node_v) {next} else {s_uv=0.0}

for (n_u in node_r_u){

for (n_v in node_r_v){
s_uv = s_uv + s_df_old[as.character(n_u),as.character(n_v)]
}

s_df[u,v] = r * s_uv / (length(node_r_u)*length(node_r_v))

}

}
}
iter <- iter + 1
}
return (s_df)
}

