    keys = c()
    vals = c()
    lines=unlist(strsplit(x = text, split = "\n"))
    for (i in 1:length(lines)) {
      tokens=unlist(strsplit(x = lines[i], split = pattern))
      # line format: tag, value, timestamp, quality
      keys = c(keys,tokens[3])
      vals = c(vals,paste(tokens[1],tokens[2],sep=":"));
    }
    keyval(keys,vals)
  }

  createVectors.reduce = function(index, value) {
    keyval(index, paste(value,sep=pattern));
  }

  mapreduce(
    input = input ,
    input.format = "text",
    map = createVectors.map,
    reduce = createVectors.reduce
  )
}

I invoke it as:
