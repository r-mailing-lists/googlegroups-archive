hcp<-system("/usr/bin/hadoop classpath", intern=TRUE)
        hcp_filelist<-""
        if (length(hcp) > 0) {
               hcp<-strsplit(gsub("\\*","",hcp), ":")
               hcp_filelist<-hcp[[1]]
        }
hadoop.CP <- c(hcp_filelist,unlist(lapply(hcp_filelist, function(x) list.files(x, full.names=TRUE,pattern="jar$",recursive=FALSE))))
haddop.CP

