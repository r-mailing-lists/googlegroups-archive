se<-to.dfs(X)
y<-c(6,4,4,2,7,4,7,9,9)
y<- as.matrix(y,2)

Sum = function(.,YY){
  keyval(1,list(Reduce('+',YY)))
}

XtX =
  values(from.dfs(
    mapreduce(
      input = se,
      map=
        function(.,Xi){

          Xi = Xi[,-1]
          head(Xi,4)
          keyval(1,list(t(Xi)%*% Xi))
        },
      reduce = Sum ,
      combine = TRUE)))[[1]]

solve(XtX)
XtY =
  values(from.dfs(
    mapreduce(
      input = se,
      map=
        function(.,Xi){
          yi = y[Xi[,1],]

          Xi = Xi[,-1]

          keyval(1,list(t(Xi)%*%yi))
        },

      reduce = Sum ,

      combine = TRUE)))[[1]]
solve(XtX,XtY)

