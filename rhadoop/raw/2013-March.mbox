map <- function(k,v) {

# input is an edge list, gets both from an to columns of nodes

fields <- unlist(strsplit(v, "\t"))

# get unique nodes from both columns

nodes <- unique(c(fields[1],fields[2]))

#for each unique node scrolls from an to column to check for neighbors for that specific node

for (l in nodes){
    if( any(aux<-which(fields[1]==l)))

    {my_v=fields[2][aux]}else if(any(aux1<-which(fields[2]==l))){my_v=fields[1][aux1]}
    keyval(l,my_v)

  }
}

