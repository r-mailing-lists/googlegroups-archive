     1,
     "<u></u>\r\n\r\n\r\n\r\n<div style=\"PADDING-RIGHT:10px;PADDING-LEFT:10px;PADDING-TOP:15px\" bgcolor=\"#ffffff\" name=\"Compose message area\">\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">今天</span><span lang=\"EN-US\">QQ</span><span style=\"FONT-FAMILY:宋体\">群中解决了如下几个问题：</span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">458235037 \r\nQ</span><span style=\"FONT-FAMILY:宋体\">：</span> \r\n</p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font face=\"宋体\">       </font><font color=\"#ff0000\"><span style=\"FONT-FAMILY:宋体\">请问下，</span><span lang=\"EN-US\">R</span><span style=\"FONT-FAMILY:宋体\">里求积分怎么求啊？</span></font><span lang=\"EN-US\"> </span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">数理统计</span><span lang=\"EN-US\">  A</span><span style=\"FONT-FAMILY:宋体\">：</span><span lang=\"EN-US\"> </span></p>\r\n<blockquote dir=\"ltr\" style=\"MARGIN-RIGHT:0px\">\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">   \r\n  <font color=\"#0000ff\">?integrate</font></span></p>\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#0000ff\"><span lang=\"EN-US\">    </span><span style=\"FONT-FAMILY:宋体\">如：我们要计算</span><span lang=\"EN-US\">sin( x )</span><span style=\"FONT-FAMILY:宋体\">在</span><span lang=\"EN-US\">[0,pi]</span><span style=\"FONT-FAMILY:宋体\">上的积分，可以使用：</span></font></p>\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"><font color=\"#0000ff\">    \r\n  &gt; integrate(&quot;sin&quot;,0,pi)<br>    \r\n  2 with absolute error &lt; 2.2e-14</font></span></p></blockquote>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">Grace/mn-</span><span style=\"FONT-FAMILY:宋体\">统计</span><span lang=\"EN-US\">(184264391) Q</span><span style=\"FONT-FAMILY:宋体\">：</span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">   <font face=\"宋体\">    \r\n</font></span><span style=\"FONT-FAMILY:宋体\"><font color=\"#ff0000\">如何化正态密度函数图，画出两个分位数之间的区域？</font></span><span lang=\"EN-US\"> </span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">useR</span><span style=\"FONT-FAMILY:宋体\">！</span><span lang=\"EN-US\">-</span><span style=\"FONT-FAMILY:宋体\">经济</span><span lang=\"EN-US\">(361540002) A</span><span style=\"FONT-FAMILY:宋体\">：</span></p>\r\n<blockquote dir=\"ltr\" style=\"MARGIN-RIGHT:0px\">\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#0000ff\"><span style=\"FONT-FAMILY:宋体\">很简单，用</span><span lang=\"EN-US\">polygon()</span><span style=\"FONT-FAMILY:宋体\">上色就可以了：</span></font><span lang=\"EN-US\"><br><font color=\"#0000ff\">x = seq(-3, 3, length = 100)<br>plot(x, dnorm(x), type = &quot;n&quot;)<br>polygon(c(x[1], x[1:80], x[80]), c(0, dnorm(x[1:80]), 0), col =&quot;gray&quot;, border = NA)</font></span></p>\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#0000ff\"><span lang=\"EN-US\">lines(x, dnorm(x))<br></span><span style=\"FONT-FAMILY:宋体\">关键是你要想清楚多边形的顶点坐标都在什么位置（比如为什么要用</span><span lang=\"EN-US\">c()</span><span style=\"FONT-FAMILY:宋体\">连接首尾的数据）。</span></font><span lang=\"EN-US\"><br></span><font color=\"#0000ff\"><span style=\"FONT-FAMILY:宋体\">另：人眼看见的</span><span lang=\"EN-US\">&quot;</span><span style=\"FONT-FAMILY:宋体\">光滑</span><span lang=\"EN-US\">&quot;</span><span style=\"FONT-FAMILY:宋体\">的东西在计算机里面其实都不是光滑的，例如圆也是多边形。</span></font></p>\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\"></span> </p></blockquote>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">蝇子</span><span lang=\"EN-US\">/ka(330284791) Q</span><span style=\"FONT-FAMILY:宋体\">：</span></p>\r\n<blockquote dir=\"ltr\" style=\"MARGIN-RIGHT:0px\">\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#ff0000\"><span style=\"FONT-FAMILY:宋体\">请问下</span><span lang=\"EN-US\">function</span><span style=\"FONT-FAMILY:宋体\">（）中是不是只能得到最后一个结果啊？</span></font></p></blockquote>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\">R-project+DM(174474141) A</span><span style=\"FONT-FAMILY:宋体\">：</span></p>\r\n<blockquote dir=\"ltr\" style=\"MARGIN-RIGHT:0px\">\r\n  <p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#0000ff\"><span style=\"FONT-FAMILY:宋体\">你可以把你结果放到</span><span lang=\"EN-US\">list</span><span style=\"FONT-FAMILY:宋体\">里面，然后取出来</span><span lang=\"EN-US\"> </span></font></p></blockquote>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"></span> </p>\r\n<h1 class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">没有解决的问题：</span></h1>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">南京</span><span lang=\"EN-US\">-</span><span style=\"FONT-FAMILY:宋体\">大浪淘沙</span><span lang=\"EN-US\">(80678826)</span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#ff0000\"><span style=\"FONT-FAMILY:宋体\">谁做过</span><span lang=\"EN-US\">BOOTSTRAP</span><span style=\"FONT-FAMILY:宋体\">，有没有可能和</span><span lang=\"EN-US\">MC</span><span style=\"FONT-FAMILY:宋体\">结合？</span></font></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span lang=\"EN-US\"><br> </span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><span style=\"FONT-FAMILY:宋体\">蝇子</span><span lang=\"EN-US\">/ka(330284791)</span></p>\r\n<p class=\"MsoNormal\" style=\"MARGIN:0cm 0cm 0pt\"><font color=\"#ff0000\"><span lang=\"EN-US\">text</span><span style=\"FONT-FAMILY:宋体\">（）中可以通过</span><span lang=\"EN-US\">label</span><span style=\"FONT-FAMILY:宋体\">对点说明。可是我要在点上加横纵坐标怎么办呢</span><span lang=\"EN-US\"> </span></font></p>\r\n<p><font face=\"宋体\" size=\"4\"></font> </p></div>\r\n"
    ]
