Hi,

So I didn't have any luck reproducing your error. Can you make sure you're on the latest version of Garnett (v0.1.3; there's one bug I fixed a bit ago that could be related). Here's the code that I ran - obviously I didn't get any results with the fake data but it ran without error. Compare this to what you have gene name-wise and see if there are any differences.

library(rtracklayer)
library(org.Hs.eg.db)

gtf <- rtracklayer::readGFF("~/Downloads/gencode.v29.annotation.gtf")
load("~/Downloads/hsPBMC")

# make fake cds object with empty matrix

fdata <- data.frame(gene=gtf$gene_name, gene_id = gtf$gene_id)
fdata <- fdata[!duplicated(fdata$gene),]
row.names(fdata) <- fdata$gene

pdata <- data.frame(cell = paste0("cell", 1:100))
row.names(pdata) <- pdata$cell

expr <- matrix(data = 0, nrow = nrow(fdata), ncol=100)

pd <- new("AnnotatedDataFrame", data = pdata)
fd <- new("AnnotatedDataFrame", data = fdata)

Patient1_cds_obj <- newCellDataSet(expr,

                             phenoData = pd, featureData = fd)

Patient1_cds_obj <- estimateSizeFactors(Patient1_cds_obj)

Patient1_cds_obj <- classify_cells(Patient1_cds_obj, hsPBMC,
                                   db = org.Hs.eg.db,
                                   #cluster_extend = TRUE, # not doing cluster-extended bc not real cells
                                   cds_gene_id_type = "SYMBOL")
