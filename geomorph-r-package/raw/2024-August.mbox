> Here are two of many possible ways to do this, using the geomorph::pupfish data as an example.
>
> > library(geomorph)
> > data("pupfish") # data already have GPA performed
> >
> > group <- interaction(pupfish$Pop, pupfish$Sex)
> >
> > # method 1 (produces 4 shapes, means for groups)
> >
> > subsets <- coords.subset(pupfish$coords, group)
> >
> > means <- lapply(subsets, mshape)
> > means <- simplify2array(means)
> >
> > # method 2 (produces a matrix with 4 rows of means)
> >
> > fit <- procD.lm(coords ~ group + 0, data = pupfish,
> +                 print.progress = 0, iter = 0)
> > means2 <- coef(fit)
> >
