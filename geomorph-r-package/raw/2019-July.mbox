#Total     69 0.044885

#repeatability
((rep13f1$MS[1]-rep13f1$MS[2])/2)/(rep13f1$MS[2] + (rep13f1$MS[1]-rep13f1$MS[2])/2)  #0.195

##comparing reps
ANOVA5 <- procD.lm(shape ~ rep, iter=10000, data=My.df2) #
rep13f2<- ANOVA5$aov.table

#> rep13f2
#          Df       SS         MS     Rsq      F      Z Pr(>F)
#rep        1 0.001301 0.00130099 0.02898 2.0298 1.6778  0.043 *
#Residuals 68 0.043584 0.00064094 0.97102
#Total     69 0.044885

#repeatability
((rep13f2$MS[1]-rep13f2$MS[2])/2)/(rep13f2$MS[2] + (rep13f2$MS[1]-rep13f2$MS[2])/2)  #0.3398911

##comparing individuals:rep interaction
ANOVA6 <- procD.lm(shape ~ ID:rep, iter=10000, data=My.df2) #
rep13f3<- ANOVA6$aov.table
#>  rep13f3
#          Df       SS   MS Rsq  F Z Pr(>F)
#ID:rep    69 0.044885    0   1  0    0.615
#Residuals  0 0.000000 -Inf   0
