Greetings,

I have been browsing the updated manual, the posts in this group and the wiki and I have been unable to replicate repeatability measures that I had originally derived in another program.
Attached is my data file (.csv) and a plot after data import and procrustes analysis that makes me question the result that I am getting.
I have 35 individuals that were digitized twice.

#read in table F13 test
F13r_test<- read.table("Field mosquito 13 repeatability.csv",header=TRUE,row.names=1,
                       sep=",",stringsAsFactors = FALSE)
#data file has 35 individuals (all female) digitized twice (rep=1 or 2)
#specimens listed as Id_rep# ie. APR 011_1, APR 011_2
F13r_testm<- data.matrix(F13r_test[,1:26]) # make matrix
F13_r_3D1<- arrayspecs(F13r_testm, 13,2) # make 3d array
F13r_gpa<- gpagen(F13_r_3D1)  # Procrustes analysis
F13_r_plot<-rotate.coords(F13r_gpa, "flipY")
plot(F13_r_plot) #see attached, don't see any outliers

#break up specimen names into just ID and rep
#followed this tutorial- https://www.r-bloggers.com/tips-tricks-5-extracting-classifiers-using-substring/
F13_r_cat<-strsplit(dimnames(F13_repeat_3D) [[3]], "_")
F13_r_classifiers <- matrix(unlist(F13_r_cat), ncol=2, byrow=T)  #reads list into matrix
F13_r_classifiers <- cbind(dimnames(F13_repeat_3D)[[3]], F13_r_classifiers) # adds the specimen ID to the first column of the table
colnames(F13_r_classifiers) <- c("Imageinfo", "ID","rep") #rename the column headings
F13_r_classifiers <- as.data.frame(F13_r_classifiers)   #converts to data frame so can index using $

F13_r_ind1<-as.factor(F13_r_classifiers$ID) #  35 levels of this [1] APR 011 APR 019 APR 029 APR 040...
F13_r_rep1<-as.factor(F13_r_classifiers$rep) # 2 levels of 1s and 2s
F13r_shape<-F13r_gpa$coords

#followed the suggestion to make a gemorph data frame from here https://groups.google.com/forum/#!searchin/geomorph-r-package/geomorph.data.frame$20shape$3Dshape%7Csort:date/geomorph-r-package/H52DlThxb-c/zhdX6XWrAQAJ

My.df2 <- geomorph.data.frame(shape = F13r_shape, ind=F13_r_ind1, rep=F13_r_rep1)

##comparing individuals
ANOVA4 <- procD.lm(shape ~ ind, iter=10000, data=My.df2) #
rep13f1<- ANOVA4$aov.table

#> rep13f1
