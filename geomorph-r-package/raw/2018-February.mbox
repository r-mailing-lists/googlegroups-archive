> pxRaw <- predict(lm(XScoresRaw ~ pcRaw))
> pyRaw <- predict(lm(YScoresRaw ~ pcRaw))
> pxmaxRaw <- max(pxRaw)
> pxminRaw <- min(pxRaw)
> pymaxRaw <- max(pyRaw)
> pyminRaw <- min(pyRaw)
> if (length(dim(A1)) == 3) {
