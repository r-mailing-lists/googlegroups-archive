flip.pca <- gm.prcomp(flipperratios.gpa$coords)
summary(flip.pca)
gps <- as.factor(c(rep("Plio.", 22), rep("Ples.", 19)))
plot(flip.pca, main = "PCA", pch = 21, cex = 1, cex.lab = 1.5, font.lab = 1, bg = gps, legend("topleft", pch = 21, pt.bg <http://pt.bg> = unique(gps), legend = levels(gps)))

I hope you can help, thanks!

