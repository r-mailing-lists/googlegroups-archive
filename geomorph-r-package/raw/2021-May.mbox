> > > > >
> > > > >       ind <- Map(function(x) as.factor(rep(x,k,each = k, length=p*k)), ind)
> > > > >
> > > > >       rm(.Random.seed, envir=globalenv())
> > > > >
> > > > >       ind
> > > > >
> > > > > }
> > > > >
> > > > >
