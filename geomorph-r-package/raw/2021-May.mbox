> > > > >
> > > > >     if(seed == "random") seed = sample(1:iter,1) else
> > > > >
> > > > >       if(!is.numeric(seed)) seed = iter
> > > > >
> > > > >       set.seed(seed)
> > > > >
> > > > >       p <- length(g)
> > > > >
