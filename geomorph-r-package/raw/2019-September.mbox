> fit.full.PM <http://fit.full.pm/> <- procD.lm(coords ~ PM, data=gdf, iter=9999)
> PW.PM <http://pw.pm/> <- pairwise(fit.full.PM <http://fit.full.pm/>, groups=PM, covariate=NULL)
> summary(PW.PM <http://pw.pm/>, test.type="dist", confidence=0.95, stat.table=T)
