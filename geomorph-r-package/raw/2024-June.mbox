ecology<- read.csv("Ecology_Merin&Laura.csv", header = TRUE, row.names=1)shape.test <- treedata(phy = Tree, data = two.d.array(shape), warnings = TRUE)
data.matched <- treedata(phy = Tree, data = ecology, warnings= FALSE)
elev <- as.factor(data.matched$data); names(elev) <- row.names(data.matched$data)
gdf <- geomorph.data.frame(shape=shape, shape = shape,elev = elev, Tree = Tree$`'Merin_figtree'`)
#Phylomorphospace - PCA with phylogeny
#Estimated ancestral states projected to the plot
plot.pca <- gm.prcomp(shape,phy= Tree) ### R IS CRASHING###
plot(plot.pca,phylo = TRUE, pch=21, bg=gdf$elev, cex=2, phylo.par = list(tip.labels = FALSE, node.labels = FALSE) )summary(plot.pca)

