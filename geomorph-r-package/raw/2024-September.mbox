[1] "geomorph.data.frame"

$names
[1] "species.x" "morfo.x"   "coords"    "Csize"

$class
[1] "geomorph.data.frame"

fit1 <- procD.lm(coords ~ species.x*morfo.x,
                 data = gdf, iter = 999, turbo = TRUE,
                 RRPP = FALSE, print.progress = FALSE)
Error in .local(x, ...) : unused argument (order = 0)
######################################################
