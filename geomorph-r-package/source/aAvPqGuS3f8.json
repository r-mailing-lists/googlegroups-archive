   "parts": [
    [
     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"blue\" vlink=\"purple\">\r\n<div>\r\n<p class=\"MsoNormal\"><a name=\"m_-9083750703713100861__MailEndCompose\" rel=\"nofollow\"><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">Richie,\r\n<u></u><u></u></span></a></p>\r\n<p class=\"MsoNormal\"><span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\"><u></u> <u></u></span></span></p>\r\n<p class=\"MsoNormal\"><span><span style=\"font-size:11.0pt;font-family:&quot;Calibri&quot;,sans-serif;color:#1f497d\">The DA matrix is 53 x 2 x 2 because you have 2 specimens of 53 landmarks each of 2D data. The 2 specimens are the mean\r\n shape of each side. <u></u><u></u></span></span></p></div></div>"
    ],
