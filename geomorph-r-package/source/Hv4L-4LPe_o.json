     1,
     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nFolks,</div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nWe are happy to announce that the next iteration of our workshop &#39;Geometric Morphometrics in R&#39; will take place in June 2027 in Barcelona Spain.</div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nRegistration is free, though space is limited.  Please see the following webpage for more details and application instructions:\r\n<a href=\"https://urldefense.com/v3/__https://geomorphr.github.io/GMcourse/__;!!D9dNQwwGXtA!XdIeFHnyuUg9IM0xjZAvEt76y45fYxlJjJbRLu42gQAZPjgT7zmeOvCPG3x-Bf6JAUZI8Gq1qvqA_P8rxBukyyRg$\" title=\"https://urldefense.com/v3/__https://geomorphr.github.io/GMcourse/__;!!D9dNQwwGXtA!XdIeFHnyuUg9IM0xjZAvEt76y45fYxlJjJbRLu42gQAZPjgT7zmeOvCPG3x-Bf6JAUZI8Gq1qvqA_P8rxBukyyRg$\" style=\"margin:0px\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://urldefense.com/v3/__https://geomorphr.github.io/GMcourse/__;!!D9dNQwwGXtA!XdIeFHnyuUg9IM0xjZAvEt76y45fYxlJjJbRLu42gQAZPjgT7zmeOvCPG3x-Bf6JAUZI8Gq1qvqA_P8rxBukyyRg$&amp;source=gmail&amp;ust=1795079087464000&amp;usg=AOvVaw3EQlDOCD25057UUxCDldo8\">\r\nhttps://geomorphr.github.io/GMcourse/</a>. </div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div style=\"text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nFinal selection of participants will be made after the closing date (January 15, 2027).</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nPlease spread the word to those who might be interested!</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div style=\"direction:ltr;text-align:left;text-indent:0px;background-color:rgb(255,255,255);margin:0px;font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif,serif,EmojiFont;font-size:12pt;color:rgb(0,0,0)\">\r\nDean and Mike (on behalf of the geomorph team)</div>\r\n<div style=\"font-family:Aptos,Aptos_EmbeddedFont,Aptos_MSFontService,Calibri,Helvetica,sans-serif;font-size:12pt;color:rgb(0,0,0)\">\r\n<br>\r\n</div>\r\n<div>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n<span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:black\">Dr. Dean C. Adams</span></p>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n<span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:black\">Distinguished Professor</span></p>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n<span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:black\">Director, Ecology and Evolutionary Biology Graduate Program</span></p>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n<span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:black\">Department of Ecology, Evolution, and Organismal Biology</span></p>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n<span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:black\">Iowa State University</span></p>\r\n<p style=\"margin:0in\"><span style=\"font-family:&quot;Courier New&quot;;font-size:10pt;color:rgb(0,0,0)\"><a href=\"https://dean-adams.org/\" style=\"margin-top:0px;margin-bottom:0px\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://dean-adams.org/&amp;source=gmail&amp;ust=1795079087464000&amp;usg=AOvVaw1lGJvh5og25z8GUd7M431D\">https://dean-adams.org/</a></span></p>\r\n<p style=\"margin:0in;font-family:Aptos,sans-serif;font-size:12pt\">\r\n </p>\r\n</div>\r\n</div>\r\n\r\n"
