     "<div dir=\"ltr\">It worked, thank you so much for your help.<div>Best,</div><div>Mihajlo</div></div><br><div class=\"gmail_quote\"></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><div dir=\"ltr\" class=\"gmail_attr\">On Thu, Aug 15, 2024 at 9:06 PM Mike Collyer &lt;<a href data-email-masked rel=\"nofollow\">mlco...@gmail.com</a>&gt; wrote:<br></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0px 0px 0px 0.8ex;border-left:1px solid rgb(204,204,204);padding-left:1ex\"><div>Mihajlo,<div><br></div><div>Here are two of many possible ways to do this, using the geomorph::pupfish data as an example.</div><div><br></div><div><div>&gt; library(geomorph)</div><div>&gt; data(&quot;pupfish&quot;) # data already have GPA performed</div><div>&gt; </div><div>&gt; group &lt;- interaction(pupfish$Pop, pupfish$Sex)</div><div>&gt; </div><div>&gt; # method 1 (produces 4 shapes, means for groups)</div><div>&gt; </div><div>&gt; subsets &lt;- coords.subset(pupfish$coords, group)</div><div>&gt; </div><div>&gt; means &lt;- lapply(subsets, mshape)</div><div>&gt; means &lt;- simplify2array(means)</div><div>&gt; </div><div>&gt; # method 2 (produces a matrix with 4 rows of means)</div><div>&gt; </div><div>&gt; fit &lt;- procD.lm(coords ~ group + 0, data = pupfish, </div><div>+                 print.progress = 0, iter = 0)</div><div>&gt; means2 &lt;- coef(fit)</div><div>&gt; </div><div>&gt; # consistency (make matrix into 3d array)</div><div>&gt; </div><div>&gt; means3 &lt;- arrayspecs(means2, p = 56, k = 2)</div><div>&gt;</div><div><div>&gt; dim(means)</div><div>[1] 56  2  4</div><div>&gt; dim(means2)</div><div>[1]   4 112</div><div>&gt; dim(means3)</div><div>[1] 56  2  4</div></div><div>&gt; </div><div>&gt; # Look at first mean from all methods</div><div>&gt; means[,,1]</div><div>              [,1]          [,2]</div><div> [1,] -0.036294242 -0.0679443538</div><div> [2,] -0.039057429 -0.0371420901</div><div> [3,]  0.099048079 -0.0661928367</div><div> [4,] -0.175052108  0.0004715517</div><div> [5,]  0.040550735  0.0536580991</div><div> [6,]  0.165215338  0.0273059678</div><div> [7,]  0.229413406  0.0209667222</div><div> [8,]  0.229474512 -0.0456403969</div><div> [9,]  0.140600252 -0.0516313039</div><div>[10,] -0.132042793 -0.0005377255</div><div>[11,] -0.161025824  0.0098325777</div><div>[12,] -0.148521