igatures:normal;font-variant-caps:normal;letter-spacing:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;text-decoration-style:initial;text-decoration-color:initial\"><span style=\"color:rgb(0,0,255)\">Arguments</span></h3><table summary=\"R argblock\" style=\"background:rgba(0,0,0,0) none repeat scroll 0% 0%!important;font-family:sans-serif;font-size:13.3333px;font-style:normal;font-variant-ligatures:normal;font-variant-caps:normal;font-weight:400;letter-spacing:normal;text-align:start;text-indent:0px;text-transform:none;white-space:normal;word-spacing:0px;text-decoration-style:initial;text-decoration-color:initial\"><tbody><tr valign=\"top\"><td style=\"font-family:sans-serif;font-size:10pt;min-width:24px;padding-right:12px;border-color:rgb(102,102,102)!important\"><span style=\"color:rgb(0,0,255)\"><code>x</code></span></td><td style=\"font-family:sans-serif;font-size:10pt;border-color:rgb(102,102,102)!important\"><p style=\"margin-top:0px;margin-bottom:6px\"><span style=\"color:rgb(0,0,255)\">An object of class<span> </span><code style=\"background:rgba(0,0,0,0) none repeat scroll 0% 0%\"><a href=\"http://127.0.0.1:26699/help/library/geomorph/help/gm.prcomp\" rel=\"noreferrer nofollow\" target=\"_blank\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://127.0.0.1:26699/help/library/geomorph/help/gm.prcomp&amp;source=gmail&amp;ust=1792484395605000&amp;usg=AOvVaw3qnUVCIXZVxOhziv0iunVK\">gm.prcomp</a></code></span></p></td></tr><tr valign=\"top\"><td style=\"font-family:sans-serif;font-size:10pt;min-width:24px;padding-right:12px;border-color:rgb(102,102,102)!important\"><span style=\"color:rgb(0,0,255)\"><code>axis1</code></span></td><td style=\"font-family:sans-serif;font-size:10pt;border-color:rgb(102,102,102)!important\"><p style=\"margin-top:0px;margin-bottom:6px\"><span style=\"color:rgb(0,0,255)\">A value indicating which PC axis should be displayed as the X-axis (default = PC1)</span></p></