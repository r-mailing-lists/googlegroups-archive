     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"#0563C1\" vlink=\"#954F72\">\r\n<div>\r\n<p class=\"MsoNormal\">Folks, <u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\">I have a PhD position available in my lab to study morphometrics and macroevolution, beginning Fall 2025. Those interested in empirical work on vertebrates or analytical theory will be considered. Please contact me directly for more information.<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><br>\r\nBest, <u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\">Dean<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\"><span style=\"color:#1f497d\">Dr. Dean C. Adams<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"color:#1f497d\">Distinguished Professor of Evolutionary Biology<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"color:#1f497d\">Department of Ecology, Evolution, and Organismal Biology<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"color:#1f497d\">Iowa State University<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"color:black\"><a href=\"https://faculty.sites.iastate.edu/dcadams/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://faculty.sites.iastate.edu/dcadams/&amp;source=gmail&amp;ust=1792483293611000&amp;usg=AOvVaw0MKoifKp4qpDWrWXAqDBBO\"><span style=\"color:#0563c1\">https://faculty.sites.iastate.edu/dcadams/</span></a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"color:#1f497d\">phone: <a href=\"tel:(515)%20294-3834\" value=\"+15152943834\" target=\"_blank\" rel=\"nofollow\">515-294-3834</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n</div>\r\n</div>\r\n\r\n"
