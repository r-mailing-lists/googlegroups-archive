/span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>      sendmail</span><span style=\"color:#660\">(</span><span style=\"color:#008\">from</span><span style=\"color:#000\"> </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&lt;<a href data-email-masked rel=\"nofollow\">te...@gmail.com</a>&gt;&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>               to </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&quot;&lt;test2@g</span><span style=\"color:#080\"><a href=\"http://mail.com\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://mail.com&amp;source=gmail&amp;ust=1792360923265000&amp;usg=AOvVaw0sd5m-NUSwq1knS4L2UUIp\">mail.com</a>&gt;&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"><br>               subject </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> isolate</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input$subject</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> <br>               msg </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> mime_part</span><span style=\"color:#660\">(</span><span style=\"color:#000\">mtcars</span><span style=\"color:#660\">),</span><span style=\"color:#000\">  </span><span style=\"color:#800\">##</span><span style=\"color:#000\"><br>               control</span><span style=\"color:#660\">=</span><span style=\"color:#000\">list</span><span style=\"color:#660\">(</span><span style=\"color:#000\">smtpServer</span><span style=\"color:#660\">=</span><span style=\"color:#080\">&quot;<a href=\"http://ASPMX.L.GOOGLE.COM\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://ASPMX.L.GOOGLE.COM&amp;source=gmail&amp;ust=1792360923265000&amp;usg=AOvVaw1YrNrAoTU