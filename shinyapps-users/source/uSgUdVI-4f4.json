-serif;background-color:rgb(255,255,255)\">---</span><br style=\"font-family:Arial,Helvetica,sans-serif;background-color:rgb(255,255,255)\"><div style=\"background-color:rgb(255,255,255)\">header-includes:</div><div style=\"background-color:rgb(255,255,255)\">- \\usepackage{polyglossia}</div><div style=\"background-color:rgb(255,255,255)\">- \\usepackage{fontspec}</div><div style=\"background-color:rgb(255,255,255)\">- \\usepackage{fancyhdr}</div><div style=\"background-color:rgb(255,255,255)\">- \\usepackage{bidi}</div><div style=\"background-color:rgb(255,255,255)\">- \\setmainlanguage{arabic}</div><div style=\"background-color:rgb(255,255,255)\">- \\newfontfamily{\\arabicfont}{Myriad Arabic}</div><div style=\"background-color:rgb(255,255,255)\">- \\usepackage{graphicx}</div><div style=\"background-color:rgb(255,255,255)\">- \\pagestyle{fancy}</div><div style=\"background-color:rgb(255,255,255)\">- \\setlength\\headheight{28pt}</div><div style=\"background-color:rgb(255,255,255)\">- \\fancyhead[L,CE]{\\includegraphics[width=1cm]{AMN-logo.png}}</div><div style=\"background-color:rgb(255,255,255)\">- \\fancyfoot[L,CE]{`r format(Sys.time(), &#39;%d %B %Y&#39;)`}<br><span style=\"font-family:Arial,Helvetica,sans-serif\">output: </span></div><div style=\"background-color:rgb(255,255,255)\">    pdf_document:</div><div style=\"background-color:rgb(255,255,255)\">      highlight: tango</div><div style=\"background-color:rgb(255,255,255)\">      keep_tex: yes</div><div style=\"background-color:rgb(255,255,255)\">      latex_engine: xelatex</div><div style=\"background-color:rgb(255,255,255)\">classoption: article</div><div style=\"background-color:rgb(255,255,255)\">papersize: A4</div><div style=\"background-color:rgb(255,255,255)\">fontsize: 10pt</div><div style=\"background-color:rgb(255,255,255)\">geometry: margin=0.9in</div><div style=\"background-color:rgb(255,255,255)\">linestretch: 1.15</div><div style=\"background-color:rgb(255,255,255)\">---</div></div></code></di