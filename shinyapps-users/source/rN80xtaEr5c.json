yle=\"color:#066\">100</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> runif</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> main</span><span style=\"color:#660\">=</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;Counter:&quot;</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> vals$counter</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>\r\n\r\n  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>  <br>  loop </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> observe</span><span style=\"color:#660\">({</span><span style=\"color:#000\"><br>\r\n\r\n    </span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">i </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">10000</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>\r\n\r\n      x </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> runif</span><span style=\"color:#660\">(</span><span style=\"color:#066\">100</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>\r\n\r\n    <br>    isolate</span><span style=\"color:#660\">({</span><span style=\"color:#000\">vals$counter </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> vals$counter </span><span style=\"color:#660\">+</span><span style=\"color:#000\"> </span><span style=\"color:#066\">1</span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br>\r\n\r\n    <br>    </span><span style=\"color:#008\">if</span><span style=\"color:#000\"> </span><span style=\"color:#660\">(</span><span style=\"color:#000\">isolate</span><span style=\"color:#660\">(</span><span style=\"color:#000\">vals$counter</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">&lt;</span><span style=\"color:#000\"> </span><span style=\"color:#066\">100</span><span style=\"color:#660\">)</span><span style=\"color:#000\"> </span><span style=\"color:#660\">{</span><span style=\"color:#000\"><br>\r\n\r\n      invalidateLater</span><span style=\"color:#660\">(</span><span style=\"color:#066\">0</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> session</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>\r\n\r\n    </span><span style=\"color:#660\">}</span><span style=\"color:#000\"><br>  </span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">})</span><span style=\"color:#000\"><br><br></span></div>\r\n\r\n</code></div><div><br><br></div><div><b>ui.R</b></div><div><br></div><div style=\"border:1px solid rgb(187,187,187);word-wrap:break-word;background-color:rgb(250,250,250)\"><code><div><span style=\"color:#000\">shinyUI</span><span style=\"color:#660\">(</span><span style=\"color:#000\">fluidPage</span><span style=\"color:#660\">(</span><span style=\"color:#000\"><br>\r\n\r\n  plotOutput</span><span style=\"color:#660\">(</span><span style=\"color:#080\">&quot;graph&quot;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>\r\n\r\n<br></span></div></code></div><div><br><br></div><div>I&#39;ve hosted this at <a href=\"http://shinyapps.io\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://shinyapps.io&amp;source=gmail&amp;ust=1792365167168000&amp;usg=AOvVaw0Kok_FtqYH8i4J6_TwEgN5\">shinyapps.io</a>, here&#39;s the URL: <a href=\"https://todd.shinyapps.io/testing-plot-flicker/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://todd.shinyapps.io/testing-plot-flicker/&amp;source=gmail&amp;ust=1792365167168000&amp;usg=AOvVaw2A63L5YYeMnp2GJnRVk82g\">https://todd.shinyapps.io/testing-plot-flicker/</a></div>\r\n\r\n<div><br></div><div>Note that the counter in the title of the plot should increment by 1 every time the plot renders. However, if you watch the counter go, a lot of the time it will jump by 2, 3, or 4, I&#39;ve even seen as high as 8 on occasion. Why aren&#39;t all of those plots getting rendered? Is there a way I can tell shiny to wait for the plot to be rendered on the client before re-executing the loop? I would be willing to increase total runtime in exchange for a guarantee that all plots will be rendered</div>\r\n\r\n<div><br></div><div>Thanks,</div><div>Todd</div></div></div></div></div>"
