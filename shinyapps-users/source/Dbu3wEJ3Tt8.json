   "parts": [
    [
     1,
     "<div dir=\"ltr\">Is it possible to add external dependencies (ie non-R executables like <a href=\"http://phantomjs.org/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://phantomjs.org/&amp;source=gmail&amp;ust=1792362766733000&amp;usg=AOvVaw1N-ukOghlv6-OBl_Lacd5H\">phantomJS</a> (needed for r package webshot) or <a href=\"http://www.freedesktop.org/wiki/Software/Xft/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.freedesktop.org/wiki/Software/Xft/&amp;source=gmail&amp;ust=1792362766733000&amp;usg=AOvVaw0wwwsQNCvPZoUUZxcTPrZK\">Xft</a> (needed for r package devEMF) to a <a href=\"http://shinyapps.io\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://shinyapps.io&amp;source=gmail&amp;ust=1792362766733000&amp;usg=AOvVaw3C0mH4BFuhZpcamK2-bqk6\">shinyapps.io</a> app?<div><br></div><div><br><div><div><br></div><div><br></div></div></div></div>"
    ]
   ]
  },
