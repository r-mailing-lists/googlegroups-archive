      geom_line(data= data2(), aes(x = "Provider", ymax = "res", ymin = "0"))+
      geom_hline(yintercept = 0)+
      theme_light()+
      scale_color_manual("red", "black")+
      ggtitle("Variation from Average Optimization")+
     theme(plot.title = element_text(size = 22, hjust = .5, family = "serif"))+
     theme(plot.subtitle = element_text(size = 18, hjust = .5, family = "serif"))
  })
}
