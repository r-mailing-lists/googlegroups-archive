library(shiny)
library(rjson)
library(dplyr)

shinyServer(
  function(input, output, session) {

      wc_click <- reactive({
        a <- input$clickedValue
        print(a)
      })

      data <- reactive({
        val <- wc_click()
        if(!is.null(val))
        {
        filesdata <-filter(filesdata,Components==val)
        }
      })

      output$results <- renderTable({
        data()
      })
  }
)

