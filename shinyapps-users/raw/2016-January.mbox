## ui.R
library(rCharts)
shinyUI(
  fluidPage(
  headerPanel("rCharts: Export issue"),
  helpText("Export options work locally and on shiny-server but fails to work on shinyapps.io <http://shinyapps.io>."),
  tags$br(),
    showOutput("myChart", "highcharts"),
    tags$br(),
    #includeMarkdown("info.md")
    verbatimTextOutput("display")
))

## server.r
library(rCharts)
shinyServer(function(input, output) {
  output$myChart <- renderChart({
    data(iris)
    is <- iris[c(1:10,51:60,101:110),]
    is$Species <- factor(as.character(is$Species))
    p1 <- rCharts::hPlot(x="Species", y="Sepal.Length", data = is, color = "Species", type = 'bar')
    p1$addParams(dom = 'myChart')
    p1$exporting(enabled=T,
                buttons=list(
                  contextButton = list(
                    align = 'left',
                    verticalAlign = 'top'
                  )
                ))
    p1$chart(zoomType='x',
            height=500,
            width=800)
    return(p1)
  })

  output$display <- renderText({
    paste0(capture.output(sessionInfo()),"\n")
  })
})

