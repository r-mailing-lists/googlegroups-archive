app = shinyApp(

ui =

fluidPage(
mainPanel(

rglwidgetOutput( 'plot3D' )

) # end main pan

) # end flu pag

, # ,

server=function(input,output,session){

output$plot3D = renderRglwidget ( {

# this works in plain RGui and the IDE alone (without shiny ...) with just library(rgl);

plot3d( x=xx[,1],y=xx[,11] , response, type="s", size=1.60, col='grey1',

xlab='djia',ylab='brazil', zlab='ConAgra' )

rglwidget( )

} # end chunk

) # end renderRgl

} # end server

) # end app

runApp(app)

when run in the RStudio IDE

I get this:

Error in gregexpr(calltext, singleline, fixed = TRUE) :

regular expression is invalid UTF-8 (repeatedly)

On the browser I get this:

JavaScript Alert: 0:3; 'highP': precision is not supported in fragment shader

I suspect this has something to do with webGL but I can't prove it.

