    infile <-  Infile()[[4]]
    panelist <- as.character(infile[1, -1])  # panelist

    barplot(x,horiz=T,col=clr,col.axis="#574c4c",names.arg = panelist,xlim=c(0,1),cex.axis=1.25)
    abline(v=c(0.4,0.6,0.8),col=c("firebrick1","orange1","limegreen"),lwd=3,lty=2)

  })

}

