library(shiny)
library(XLConnect)
# library(readxl)
# library(xlsx)

# Define UI for application that draws a histogram
ui <- fluidPage(

  # Application title
  # br(),
  tags$body(style="background-color:white;"),
  h1("Panelist Index",style="color:#A4A4A4"),

  # Sidebar with a slider input for number of bins
  sidebarLayout(
    div( sidebarPanel(
      h3("Data Upload"),
      fileInput("data.file", "Choose Data File"),

      h3("Discrimination Index"),
      textInput("DIS.upper", "Upper Bound (default=0.5)"),
      textInput("DIS.target", "Target (default=0.01)"),

      h3("Repeatability Index"),
      textInput("REP.upper", "Upper Bound (default=9)"),
      textInput("REP.target", "Target (default=1)"),

      h3("Agreement Index"),
      textInput("AGR.target", "Target (default=0.95)"),
      textInput("AGR.lower", "Lower Bound (default=0.5)"),

      h3("Download the outputs"),
      textInput("savefile1", "File Name"),
      downloadButton("downloadtable1", "Save Data Table to .xlsx")
      ,style="color:#6E6E6E"
      ,br()
      # ,img(width=200, height=100,src='Capture.png')
    )),

    # Show a plot of the generated distribution
    mainPanel(

      div(
        fluidRow(
          column(8,tableOutput("contents")),
          column(4,img(width=200, height=100,src='CaptureW.png')),
          column(8,plotOutput("plot")),
          style="color:#574c4c "
        )
      )
    )
  )
)

# Define server logic required to draw a histogram
server <- function(input, output) {

  #Geometric Mean
  gm_mean = function(x, na.rm=TRUE){
    x[x==0] <- 10^(-2)
    exp(sum(log(x), na.rm=T) / length(x))
  }
  Infile <- reactive({
    inFile <- input$data.file

    if (is.null(inFile))
      return(NULL)
    else{
      wb = loadWorkbook(inFile$datapath)
      sheet.names <- getSheets(wb)
      l <- vector("list")
      for(i in 1:length(sheet.names)){
        l[[i]] <- readWorksheet(wb, sheet = sheet.names[i])
      }
      names(l) <- sheet.names
      return(l)}
  })
  ## Discrimination Index ##
  DIS.index.panel <- reactive({
    infile <-  Infile()[[2]]
    dim <- dim(infile)
    data.raw <- infile[2:(dim[1]-1), (-1)]
    panelist <- as.character(infile[1, -1])  # panelist
    attribute <- as.character(infile[2:(dim[1]-1), 1])  # attribute

    data <- matrix(NA, nrow(data.raw), ncol(data.raw))
    for(i in 1:nrow(data)){
      for(j in 1:ncol(data)){
