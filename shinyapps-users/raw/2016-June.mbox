# a model, and simply using the transformations, as when scoring a dataset.

building <- TRUE
scoring  <- ! building

# A pre-defined value is used to reset the random seed so that results are repeatable.

seed <- 42

# Load the data.

library(RCurl)
x <- getURL("https://rawgit.com/JimmyWilde/UWDemo/master/DataSourceMockUp.csv")
crs$dataset <- read.csv(text = x)

