e=\"color:#660\">(</span><span style=\"color:#066\">1</span><span style=\"color:#660\">:</span><span style=\"color:#066\">22</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> sep </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&#39;</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br></span><span style=\"color:#008\">for</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file </span><span style=\"color:#008\">in</span><span style=\"color:#000\"> files</span><span style=\"color:#660\">){</span><span style=\"color:#000\"><br>  sample </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> strsplit</span><span style=\"color:#660\">(</span><span style=\"color:#000\">file</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;\\\\.&#39;</span><span style=\"color:#660\">)[[</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]][</span><span style=\"color:#066\">1</span><span style=\"color:#660\">]</span><span style=\"color:#000\"><br>  dir</span><span style=\"color:#660\">.</span><span style=\"color:#000\">create</span><span style=\"color:#660\">(</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">output_dir</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sample</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sep </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&#39;</span><span style=\"color:#660\">))</span><span style=\"color:#000\"><br>  data </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sequenza</span><span style=\"color:#660\">.</span><span style=\"color:#000\">extract</span><span style=\"color:#660\">(</span><span style=\"color:#000\">paste</span><span style=\"color:#660\">(</span><span style=\"color:#000\">input_dir</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> file</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sep </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> </span><span style=\"color:#080\">&#39;&#39;</span><span style=\"color:#660\">),</span><span style=\"color:#000\"> chromosome</span><span style=\"color:#660\">.</span><span style=\"color:#000\">list </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> chromosome_list</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">cp </span><span style=\"color:#660\">&lt;-</span><span style=\"color:#000\"> sequenza</span><span style=\"color:#660\">.</span><span style=\"color:#000\">fit</span><span style=\"color:#660\">(</span><span style=\"color:#000\">data</span><span style=\"color:#660\">)</span><span style=\"color:#000\"><br>  sequenza</span><span style=\"color:#660\">.</span><span style=\"color:#000\">results</span><span style=\"color:#660\">(</span><span style=\"color:#000\">sequenza</span><span style=\"color:#660\">.</span><span style=\"color:#000\">extract </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> cp</span><span style=\"color:#660\">.</span><span style=\"color:#000\">table </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> data</span><span style=\"color:#660\">.</span><span style=\"color:#000\">cp</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> sample</span><span style=\"color:#660\">.</span><span style=\"color:#000\">id </span><span style=\"color:#660\">=</span><span style=\"color:#000\"> sample</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> chromosome</span><span style=\"color:#660\">.</span><span style=\"color:#000\">list </span><span style=\"color:#