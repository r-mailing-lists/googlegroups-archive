ly:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">0.159435766490344</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">0.975186126715064</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">4645</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">0.230308828067809</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">2</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">1</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">1</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">\t</span><span style=\"font-variant-ligatures:no-common-ligatures;background-color:rgba(0,0,0,0.72);color:rgb(244,244,244);font-family:Monaco;font-size:10px\">-6.73331440122957</span><br></div><div>\r\n<p><span>chr1<span>\t</span>1246303<span>\t</span>26900735<span>\t</span>0.498947424983779<span>\t</span>699<span>\t</span>0.0804295503438109<span>\t</span>0.917306455048607<span>\t</span>86098<span>\t</span>0.304506586454427<span>\t</span>2<span>\t</span>1<span>\t</span>1<span>\t</span>-7.14993565738541</span></p>\r\n<p><span>chr1<span>\t</span>27058036<span>\t</span>120529750<span>\t</span>0.498943251975809<span>\t</span>856<span>\t</span>0.0923180731643665<span>\t</span>0.971394449604164<span>\t</span>157433<span>\t</span>0.351126068942888<span>\t</span>2<span>\t</span>1<span>\t</span>1<span>\t</span>-6.74630131709021</span></p></div><div><br></div><div>As you can see, there is only one segment being called in SampleA, while there are 3 in SampleB (even though they have exactly the same CN &quot;genotypes&quot; for A and B allele) for the same genomic interval.</div><div><br></div><div>Since I&#39;m trying to compare the results in all samples,  I would like to ask whether there is an option to get the A- and B-allele CN for the same genomic windows? In other words, can you pre-define your genomic windows of interest and then call the CN genotypes on them?</div><div><br></div><div>Thanks in advance,</div><div>Joao</div><div> </div><div> </div></div>"
