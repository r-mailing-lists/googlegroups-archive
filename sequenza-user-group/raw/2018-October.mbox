Hello ...

Do you see anything wrong with this pipeline?

samtools faidx ./Hg38.fa
sequenza-utils gc_wiggle -f ./Hg38.fa -w50 | gzip > hg38.gc50Base.txt.gz
sequenza-utils bam2seqz -gc hg38.gc50Base.txt.gz -n MCB1_sorted.bam -t MCB2b_sorted.bam --fasta ./Hg38.fa | gzip > out.seqz.gz
sequenza-utils seqz_binning -w 50 -s out.seqz.gz | gzip > out.small.seqz.gz

