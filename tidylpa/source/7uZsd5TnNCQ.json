     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"EN-US\" link=\"#0563C1\" vlink=\"#954F72\">\r\n<div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">Hi everyone,<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">First, if you have posted a question to the mailing list over the past few months and have not yet received a response, I apologize – please look for one soon. One reason for the delay is that we have been\r\n working on a major revision to tidyLPA. That major revision resulted in a new version—version 1.0.0—which is now available on GitHub.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">You can read about the new version here:\r\n<a href=\"https://data-edu.github.io/tidyLPA/index.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://data-edu.github.io/tidyLPA/index.html&amp;source=gmail&amp;ust=1792496107005000&amp;usg=AOvVaw1PW57kNtwAs0UKD8wlOFr_\">https://data-edu.github.io/tidyLPA/index.html</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">You can also read more about the changes and the rationale for making them here:\r\n<a href=\"https://data-edu.github.io/tidyLPA/articles/introduction-to-major-changes.html\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://data-edu.github.io/tidyLPA/articles/introduction-to-major-changes.html&amp;source=gmail&amp;ust=1792496107005000&amp;usg=AOvVaw37--u9QXGcpmo9CKKr5yx1\">\r\nhttps://data-edu.github.io/tidyLPA/articles/introduction-to-major-changes.html</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">We would welcome any feedback on the new version before we submit it to CRAN. It can be installed using the devtools package, i.e.:<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<div style=\"border:solid #eeeeee 1.0pt;padding:7.0pt 7.0pt 7.0pt 7.0pt;background:#f8f8f8;margin-left:.5in;margin-right:0in\">\r\n<pre style=\"margin-bottom:7.5pt;background:#f8f8f8;border:none;padding:0in\"><span><span style=\"font-family:Menlo;color:#264d66\"><a href=\"https://www.rdocumentation.org/packages/utils/topics/install.packages\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/utils/topics/install.packages&amp;source=gmail&amp;ust=1792496107005000&amp;usg=AOvVaw1YuzzlL1ZVw7dmTeenrbx_\"><span style=\"color:#23527c\">install.packages</span></a></span></span><code><span style=\"font-family:Menlo;color:#333333\">(</span></code><span><span style=\"font-family:Menlo;color:#036a07\">&quot;devtools&quot;</span></span><code><span style=\"font-family:Menlo;color:#333333\">)<u></u><u></u></span></code></pre>\r\n<pre style=\"margin-bottom:7.5pt;background:#f8f8f8;border:none;padding:0in\"><code><span style=\"font-family:Menlo;color:#333333\">devtools</span></code><span><span style=\"font-family:Menlo;color:#333333\">::</span></span><span><span style=\"font-family:Menlo;color:#264d66\"><a href=\"https://www.rdocumentation.org/packages/devtools/topics/reexports\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://www.rdocumentation.org/packages/devtools/topics/reexports&amp;source=gmail&amp;ust=1792496107005000&amp;usg=AOvVaw0mpyIKsqJE8IYVS0eehFYk\"><span style=\"color:#375f84\">install_github</span></a></span></span><code><span style=\"font-family:Menlo;color:#333333\">(</span></code><span><span style=\"font-family:Menlo;color:#036a07\">&quot;data-edu/tidyLPA&quot;</span></span><code><span style=\"font-family:Menlo;color:#333333\">)</span></code><span style=\"font-family:Menlo;color:#333333\"><u></u><u></u></span></pre>\r\n</div>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">Thank you for your interest in the tidyLPA package. Please do not hesitate to reach out with any questions—about the update or anything else—and we’ll try to respond more quickly than we have.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\">Josh<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:11.0pt\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;font-family:Times;color:black\">-- <br>\r\n</span><span style=\"font-size:8.0pt;color:black\"><img border=\"0\" width=\"300\" height=\"65\" style=\"width:3.125in;min-height:.677in\" src=\"https://groups.google.com/group/tidylpa/attach/6733af2c468b5/image001.gif?part=0.1&amp;view=1\" alt=\"http://images.utk.edu/images/interface/ut-emailsignature.gif\"></span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:8.0pt;color:black\"> </span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><b><span style=\"font-size:10.5pt;font-family:Helvetica;color:#58595b\"><a href=\"http://joshuamrosenberg.com/\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://joshuamrosenberg.com/&amp;source=gmail&amp;ust=1792496107005000&amp;usg=AOvVaw3Bz6OOpmQoMlAr3qhAnHHH\"><span style=\"color:#0563c1\">Joshua M. Rosenberg, Ph.D.</span></a></span></b><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\">Assistant Professor, STEM Education</span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\"> </span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\">Dept. of Theory and Practice in Teacher Education</span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\">The University of Tennessee, Knoxville</span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\">420 Claxton, 1122 Volunteer Boulevard, Knoxville, TN 37996</span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\"> </span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\"><a href=\"tel:(865)%20974-5973\" value=\"+18659745973\" target=\"_blank\" rel=\"nofollow\">(865) 974-5973</a></span><span style=\"color:black\"><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span style=\"font-size:9.0pt;font-family:Helvetica;color:#58595b\"><a href data-email-masked rel=\"nofollow\"><span style=\"color:#954f72\">jmros...@utk.edu</span></a></span><u></u><u></u></p>\r\n</div>\r\n</div>\r\n\r\n"
