      epsilon1.cat <http://epsilon1.cat>[t] ~ dnorm(0, tau.s)
    logit(s2.cat <http://s2.cat>[t]) <- suv2.cat <http://suv2.cat> + epsilon2.cat <http://epsilon2.cat>[t]
      epsilon2.cat <http://epsilon2.cat>[t] ~ dnorm(0, tau.s)
    logit(s1.oth[t]) <- suv1.oth + epsilon1.oth[t]
      epsilon1.oth[t] ~ dnorm(0, tau.s)
    logit(s2.oth[t]) <- suv2.oth + epsilon2.oth[t]
      epsilon2.oth[t] ~ dnorm(0, tau.s)
    logit(p1.cat <http://p1.cat>[t]) <- rec1.cat <http://rec1.cat>[recap[t]] + gamma1.cat <http://gamma1.cat>[recap[t]]
      gamma1.cat <http://gamma1.cat>[t] ~ dnorm(0, tau.p)
    logit(p2.cat <http://p2.cat>[t]) <- rec2.cat <http://rec2.cat>[recap[t]] + gamma2.cat <http://gamma2.cat>[recap[t]]
      gamma2.cat <http://gamma2.cat>[t] ~ dnorm(0, tau.p)
    logit(p1.oth[t]) <- rec1.oth + gamma1.oth[t]
      gamma1.oth[t] ~ dnorm(0, tau.p)
    logit(p2.oth[t]) <- rec2.oth + gamma2.oth[t]
      gamma2.oth[t] ~ dnorm(0, tau.p)
    logit(r[t]) <- recov + delta[t]
      delta[t] ~ dnorm(0, tau.r)
    F[t] <- mean.F
  }

for (i in 2:(n.occasions-1)){
 rec1.cat <http://rec1.cat>[i] <- logit(mean1.p.cat <http://mean1.p.cat>)
 rec2.cat <http://rec2.cat>[i] <- logit(mean2.p.cat <http://mean2.p.cat>)
}

suv1.cat <http://suv1.cat> <- logit(mean1.suv.cat <http://mean1.suv.cat>)
suv2.cat <http://suv2.cat> <- logit(mean2.suv.cat <http://mean2.suv.cat>)
suv1.oth <- logit(mean1.suv.oth)
suv2.oth <- logit(mean2.suv.oth)
rec1.cat <http://rec1.cat>[1] <- 0                 #First two occasions on CAT set to 0
rec2.cat <http://rec2.cat>[1] <- 0 #First two occasions on OTH set to 0 rec1.oth <- logit(mean1.p.oth)
rec2.oth <- logit(mean2.p.oth)
recov <- logit(mean.recov)
mean1.suv.cat <http://mean1.suv.cat> ~ dunif(0, 1)
mean1.suv.oth ~ dunif(0, 1)
mean2.suv.cat <http://mean2.suv.cat> ~ dunif(0, 1)
mean2.suv.oth ~ dunif(0, 1)
