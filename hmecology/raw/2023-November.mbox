inits <- function(){list(mean1.suv.cat <http://mean1.suv.cat>=runif(1, 0, 1))}

parameters <- c("mean1.suv.cat <http://mean1.suv.cat>", "mean2.suv.cat <http://mean2.suv.cat>", "mean1.suv.oth", "mean2.suv.oth",
                "mean1.p.cat <http://mean1.p.cat>", "mean2.p.cat <http://mean2.p.cat>", "mean1.p.oth", "mean2.p.oth",
                "s1.cat <http://s1.cat>","s1.oth","p1.cat <http://p1.cat>","p1.oth",
                "s2.cat <http://s2.cat>","s2.oth","p2.cat <http://p2.cat>","p2.oth","mean.recov", "r", "psiC", "psiO")

