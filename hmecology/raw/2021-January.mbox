To everyone who replied: thank you very much for your help, I sincerely appreciate it!

I am struggling with one last issue. The model below runs, but now psiB is no longer a function of drainage area (DA).
Occupancy of species B should be a consequence of the presence/absence of species A, and  DA. I tried various
lines of code, but to no avail.

I apologize for the stream of questions but I am still very new to JAGs syntax. Any help would be great! Code is
below, data is attached.

####Bayesian Hierarchical Models using JAGS (Two-Species Occupany Models)

data<-read.csv("GD_RD_usfs.csv", header = T, row.names = "Site")

#Subset data by National Forests
HSNF_dat<- subset(data, data$Forest == "Holly Springs")

#Convert intergers > 0 to 1
HSNF_occ<-ifelse(HSNF_dat[,1:8]>0,1,0)

# Separate the two detection histories
DHA <- as.matrix(HSNF_occ[, 1:4])
DHB <- as.matrix(HSNF_occ[, 5:8])

#Aggregate detection data
yA <- rowSums(DHA)
yB <- rowSums(DHB)

nSites <- nrow(HSNF_dat)
zA <- ifelse(yA > 0, 1, NA)
zB <- ifelse(yB > 0, 1, NA)

#Site Covariates
library(robustHD)
DA<- as.numeric(standardize(HSNF_dat$DA))

#observation covariates
Depth_obs<- standardize(HSNF_dat[,22:25])
Velocity_obs<- standardize(HSNF_dat[,26:29])
Substrate_obs<- standardize(HSNF_dat[,30:33])

##2 Species Model With Interaction and Site Covariate
#data

jagsData <- list(DHA = DHA, DHB = DHB, n = 4, nSites = nSites,

                 zA = zA, zB = zB, Depth = Depth_obs, Velocity = Velocity_obs,
                 Substrate = Substrate_obs, DA = DA)

require(jagsUI)
#Model
sink("2sps_Int.txt")
cat("model{
  # Likelihood
  for(i in 1:nSites) {
     # Ecological model
     logit(psiA[i]) <- A0 + aDA * DA[i]

     zA[i] ~ dbern(psiA[i])
     zB[i] ~ dbern(psiB[zA[i] + 1])

     # Observation model

     for(j in 1:n) {

      logit(pA[i, j]) <- a0 + aDepth * Depth[i, j] + aVelocity * Velocity[i, j] +
      aSubstrate * Substrate[i, j]
      logit(pB[i, j]) <- b0 + bDepth * Depth[i, j] + bVelocity * Velocity[i, j] +
      bSubstrate * Substrate[i, j]

      DHA[i, j] ~ dbern(pA[i, j] * zA[i])
      DHB[i, j] ~ dbern(pB[i, j] * zB[i])
     }
  }

  # Priors
  # Priors
  psiB[1] ~ dunif(0, 1)
  psiB[2] ~ dunif(0, 1)
  A0 ~ dunif(-5, 5)

  a0 ~ dunif(-5, 5)
  b0 ~ dunif(-5, 5)
  aDA ~ dunif(-5, 5)

  aDepth ~dunif(-5,5)
  bDepth ~ dunif(-5,5)
  aVelocity ~dunif(-5,5)
  bVelocity ~ dunif(-5,5)
  aSubstrate ~dunif(-5,5)
  bSubstrate ~ dunif(-5,5)
}
",fill=TRUE)
sink()

#Parameters Estimated
wanted <- c( "psiB", "a0","b0", "A0", "aDA", "aDepth","bDepth", "aVelocity", "bVelocity",

             "aSubstrate", "bSubstrate")

#Run Model
out1 <- jags(jagsData, NULL, wanted, model="2sps_Int.txt",
             n.chains=3, n.burnin = 5000, n.adapt=1000, n.iter=10000,
             parallel=TRUE)

