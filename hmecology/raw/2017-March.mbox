Sorry, this is actually pretty straightforward with the modavgPred function:

newdata <- data.frame(Biomasa = seq(-2,2,0.1),Rios=0,Cabmun=0,Elevacion=0,
                      Carreteras = 0, Habitat = factor("VA",levels=c("VA","VC")))
pred <- modavgPred(Cand.models,as.character(1:7),newdata)
pred$high <- pred$mod.avg.pred + 1.96*pred$uncond.se <http://uncond.se>
pred$low <- pred$mod.avg.pred - 1.96*pred$uncond.se <http://uncond.se>

plot(newdata$Biomasa,pred$mod.avg.pred,type="l",
     ylim=c(0,1),ylab="Probability",xlab="Biomasa")
lines(newdata$Biomasa,pred$high,lty=2)
lines(newdata$Biomasa,pred$low,lty=2)
points(data$Biomasa,data$Estado,pch=16)

