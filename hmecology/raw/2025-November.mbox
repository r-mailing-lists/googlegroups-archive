> > > >         Nobs = Nobs,
> > > >         nListTypes = length(levels(as.factor(list_type_vector)))
> > > >       )
> > > >
> > > >
> > > >       cat(file = "dynocc_random_effects_fixed.txt", "
> > > > model {
