>
>
>
>         logit(p[i,j,k]) <- lp[k] + beta1[k]*Ju[i,j] + beta2[k]*Hr[i,j] + beta3[k]*Rd[i]
>
>         mup[i,j,k] <- z[i,k] * p[i,j,k]
>
>        Y[i,j,k] ~ dbern(mup[i,j,k])
>
>
>
>     #Note: Y is a huge 3D array with dimensions: 529 sites x 651 replicates x 556 species
>
>           }
>
>        }
>
>     }
>
>
>
