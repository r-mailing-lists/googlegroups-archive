>
>     for(k in 1:nspec){             # Loop over species
>
>        logit(psi[k]) <- lpsi[k]
>
>        for (i in 1:npen) {            # Loop over sites
>
>        z[i,k] ~ dbern(psi[k])
>
>       }
>
>     }
>
>
>
