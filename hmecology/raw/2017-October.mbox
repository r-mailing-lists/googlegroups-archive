>
>     tau.beta1 <- pow(sd.beta1, -2)
>
>     sd.beta1 ~ dunif(0,5)
>
>
>
>     mu.beta2 ~ dnorm(0, 0.1)      # Hr - Survey duration
>
>     tau.beta2 <- pow(sd.beta2, -2)
>
>     sd.beta2 ~ dunif(0,5)
>
>
>
>     mu.beta3 ~ dnorm(0, 0.1)      # Rd - Road density
>
