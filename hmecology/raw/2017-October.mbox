mean.p1 ~ dunif(0,1)
mean.p2 ~ dunif(0,1)
mean.p3 ~ dunif(0,1)

for (t in 1: (n.occasions-1)){
marr1[t,1:n.occasions] ~ dmulti(pr1[t,], r1[t])
marr2[t,1:n.occasions] ~ dmulti(pr2[t,], r2[t])
marr3[t,1:n.occasions] ~ dmulti(pr3[t,], r3[t])
}

for (t in 1:(n.occasions-1)){
r1[t] <- sum(marr1[t,])
r2[t] <- sum(marr2[t,])
r3[t] <- sum(marr3[t,])
}

## Main diagonal
for (t in 1:(n.occasions-1)){
q1[t] <- 1-p1[t]
q2[t] <- 1-p2[t]
q3[t] <- 1-p3[t]
pr1[t,t]<- phi1[t]*p1[t]
pr2[t,t] <- phi2[t]*p2[t]
pr3[t,t] <- phi3[t]*p3[t]
}
# Above main diagonal

## For ages 1 and 2
### First cell after main (t+1)

for (t in 1:(n.occasions-2)){

  pr1[t,t+1] <- phi1[t]*q1[t]*phi2[t+1]*p2[t+1]

  pr2[t,t+1] <- phi2[t]*q2[t]*phi3[t+1]*p3[t+1]

}

### Rest of the cells for those ages

for (t in 1: (n.occasions-3)){

  for (j in (t+2):(n.occasions-1)){

pr1[t,j] <- phi1[t]*q1[t]*phi2[t+1]*q2[t+1]*prod(phi3[(t+2):j])* prod(q3[(t+1):(j-1)])*prod(p3[(t+2):j])

pr2[t,j] <- phi2[t]*q2[t]*prod(phi3[(t+1):j])* prod(q3[t:(j-1)])*prod(p3[(t+1):j])
  }
}

# For age 3
for (t in 1:(n.occasions-1)){
  for (j in (t+1):(n.occasions-1)){
    pr3[t,j] <- prod(phi3[t:j])* prod(q3[t:(j-1)])* p3[j]
  }
}

# Below main diagonal
for (t in 1: (n.occasions-1)){
for (j in 1:(t-1)){
pr1[t,j] <- 0
pr2[t,j] <- 0
pr3[t,j] <- 0
}
}
## Last column: prob of non-recapture
for (t in 1:(n.occasions-1)){
pr1[t,n.occasions] <- 1-sum(pr1[t,1:(n.occasions-1)])
pr2[t,n.occasions] <- 1-sum(pr2[t,1:(n.occasions-1)])
pr3[t,n.occasions] <- 1-sum(pr3[t,1:(n.occasions-1)])
}
}

I would appreciate any help, thank you!

Blanca

