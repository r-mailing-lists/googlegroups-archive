    yaug[i,j,t,k] ~ dbern(w[k] * z[i,t,k] * p[i,j,t,k])

    logit(p[i,j,t,k]) <- alpha.lp[t,k] +

    beta.lp[1,k] * bait[i,t] + beta.lp[2,k] * effort[i,j,t]

    }

    }

    }

    }

    # Derived parameters (note multiplication with w)

    # Number of occupied sites

    for(k in 1:M){

