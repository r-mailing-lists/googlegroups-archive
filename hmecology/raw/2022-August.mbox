    for(i in 1:nsites){

    for(t in 1:nyears){

    for(k in 1:M){

    tmp[i,t,k] <- w[k] * z[i,t,k]

    }

    Nspec[i,t] <- sum(tmp[i,t,]) # Species richness per site and year

    }

    }

    }

