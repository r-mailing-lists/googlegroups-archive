  beta4K ~ dnorm(0, 0.1)
  beta5K ~ dnorm(0, 0.1)
  beta6K ~ dnorm(0, 0.1)
  beta7K ~ dnorm(0, 0.1)
  beta8K ~ dnorm(0, 0.1)
  beta9K ~ dnorm(0, 0.1)

  alpha1K ~ dnorm(0, 0.1)
  alpha2K ~ dnorm(0, 0.1)

  tauK ~ dgamma(0.1, 0.1) # Excess-Poisson variation (precision)
  sigmaK <- sqrt(1 / tauK)

  # Likelihood for BKTR ('dominant')
  # Ecological model
  for (i in 1:nsites){

   for (s in 1:11){           ##for 1 in 11 streams
    NK[i,s] ~ dpois(lambdaK[i,s])
    etaK[i,s] ~ dnorm(0, tauK)
    log(lambdaK[i,s]) <- beta0K + beta1K * dist_ms[i,s] + beta2K * water_temp[i,s] + beta3K * elev[i,s] + beta4K * pool[i,s] +
    beta5K * riffle[i,s] + beta6K * depth_avg[i,s] + beta7K * lwd[i,s] + beta8K * timber_area[i,s] + beta9K * rip_area[i,s]  +
    etaK[i,s]

    # Observation model
    for (j in 1:nreps){

      CK[i,s,j] ~ dbin(pK[i,s,j], NK[i,s])
      logit(pK[i,s,j]) <- alpha0K + alpha1K * SECONDS[i,s,j] + alpha2K * WET_WIDTH[i,s,j]

    }
  }
  }

  # Model for Bull Trout (BLTR): the 'subordinate' sp.
  # Priors for intercepts and coefficients

  mean.lambdaL ~ dunif(0, 55)
  beta0L <- log(mean.lambdaL)
  beta1L ~ dnorm(0, 0.1)
  beta2L ~ dnorm(0, 0.1)
  beta3L ~ dnorm(0, 0.1)
  beta4L ~ dnorm(0, 0.1)
  beta5L ~ dnorm(0, 0.1)
  beta6L ~ dnorm(0, 0.1)
  beta7L ~ dnorm(0, 0.1)
  beta8L ~ dnorm(0, 0.1)
  beta9L ~ dnorm(0, 0.1)

  alpha0L <- logit(mean.pL)
  mean.pL ~ dunif(0,1)
  alpha1L ~ dnorm(0, 0.1)
  alpha2L ~ dnorm(0, 0.1)

  gamma0 ~ dnorm(0, 0.1) # These are the 'interaction coefficients' !
  gamma1 ~ dnorm(0, 0.1)
  gamma2 ~ dnorm(0, 0.1)
  gamma3 ~ dnorm(0, 0.1)
  gamma4 ~ dnorm(0, 0.1)
  gamma5 ~ dnorm(0, 0.1)
  gamma6 ~ dnorm(0, 0.1)
  gamma7 ~ dnorm(0, 0.1)
  gamma8 ~ dnorm(0, 0.1)
  gamma9 ~ dnorm(0, 0.1)

  tauL ~ dgamma(0.1,0.1) # Excess-Poisson variation (precision)
  sigmaL <- sqrt(1 / tauL)

  # Likelihood for BLTR ('subordinate')
  # Ecological model
  for (i in 1:nsites){

   for (s in 1:11){
    NL[i.s] ~ dpois(lambdaL[i,s])
    etaL[i,s] ~ dnorm(0, tauL)
    lambdaL[i,s] <- exp(beta0L + beta1L * dist_ms[i,s] + beta2L * water_temp[i,s] + beta3L * elev[i,s] + beta4L * pool[i,s] + beta5L * riffle[i,s] +
    beta6L * depth_avg[i,s] + beta7L * lwd[i,s] + beta8L * timber_area[i,s] + beta9L * rip_area[i,s] + gamma0 * NK[i,s] + gamma1 * dist_ms[i,s] * NK[i,s] +
    gamma2 * water_temp[i,s] * NK[i,s] + gamma3 * elev[i,s] * NK[i,s] + gamma4 * pool[i,s] * NK[i,s] + gamma5 * riffle[i,s] * NK[i,s] + gamma6 * depth_avg[i,s] * NK[i,s] +
    gamma7 * lwd[i,s] * NK[i,s] + gamma8 * timber_area[i,s] * NK[i,s] + gamma9 * rip_area[i,s] * NK[i,s] + etaL[i,s])

    # Observation model
    for (j in 1:nreps){

      CL[i,s,j] ~ dbin(pL[i,s,j], NL[i,s])
      logit(pL[i,s,j]) <- alpha0L + alpha1L * SECONDS[i,s,j] + alpha2L * WET_WIDTH[i,s,j]
    }
    }
  }
}
")

