> > > > > > > > > > > correl2[i] <- rnorm(1, st$estimate, diff(st$conf.int <https://urldefense.com/v3/__http://conf.int__;!!Mak6IKo!LfmsrVLw8EkRhRv0oOQvl5UTKSsrO0GebbqEFvWb3RH0WcqcBResPMkb14Gl7Of9yQqhYwkqymzrzsIZSmQa-jmD$>)/1.96/2)
