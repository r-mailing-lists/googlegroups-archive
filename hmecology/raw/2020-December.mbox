Hi all, and a thousand thanks to those who sent me some private feedback.

In case anybody is interested or finds themselves in the same trouble, I finally found the way to model my case correctly. Basically, a simple yet optimal way appears to be to parameterize the age effect in the transitions.

sink("bontr3.jags")

cat("
    model{
    #Priors and constraints
    for(i in 1:nind){
    for(t in f[i]:(n.occasions-1)){
    phi[i,t] <- surv[ages[i,t]]
    p[i,t] <- recap[ages[i,t]]
    r[i,t] <- mean.r
    }#t
    }#i
    for(u in 1:5){
    surv[u] ~ dunif(0,1)
    recap[u] ~ dunif(0,1)
    }
    mean.r ~ dunif(0,1)

    #Gamma priors for recruitment (Dirichlet)
     for (r in 1:3){
     for (age in 1:5){
     a[r,age] ~ dgamma(1,1) #Hyperprior
     psiR[r,age] <- a[r,age]/sum(a[,age])

     }
     }
    #Define state-transition and observation matrices
    for(i in 1:nind){
    for(t in f[i]:(n.occasions-1)){
    #State transition matrix

    ps[1,i,t,1] <- phi[i,t]*psiR[1,ages[i,t]] #Not Recruiting
    ps[1,i,t,2] <- phi[i,t]*psiR[2,ages[i,t]] #Recruitment A
    ps[1,i,t,3] <- phi[i,t]*psiR[3,ages[i,t]] #Recruitment B
    ps[1,i,t,4] <- (1-phi[i,t])*(psiR[1,ages[i,t]])*r[i,t]
    ps[1,i,t,5] <- ((1-phi[i,t])*psiR[2,ages[i,t]]*r[i,t]) + ((1-phi[i,t])*psiR[3,ages[i,t]]*r[i,t])

    ps[1,i,t,6] <- 0
    ps[2,i,t,1] <- 0
    ps[2,i,t,2] <- phi[i,t]
    ps[2,i,t,3] <- 0
    ps[2,i,t,4] <- 0
    ps[2,i,t,5] <- (1-phi[i,t])*r[i,t]
    ps[2,i,t,6] <- 0
    ps[3,i,t,1] <- 0
    ps[3,i,t,2] <- 0
    ps[3,i,t,3] <- phi[i,t]
    ps[3,i,t,4] <- 0
    ps[3,i,t,5] <- (1-phi[i,t])*r[i,t]
    ps[3,i,t,6] <- 0
    ps[4,i,t,1] <- 0
    ps[4,i,t,2] <- 0
    ps[4,i,t,3] <- 0
    ps[4,i,t,4] <- 0
    ps[4,i,t,5] <- 0
    ps[4,i,t,6] <- 1
    ps[5,i,t,1] <- 0
    ps[5,i,t,2] <- 0
    ps[5,i,t,3] <- 0
    ps[5,i,t,4] <- 0
    ps[5,i,t,5] <- 0
    ps[5,i,t,6] <- 1
    ps[6,i,t,1] <- 0
    ps[6,i,t,2] <- 0
    ps[6,i,t,3] <- 0
    ps[6,i,t,4] <- 0
    ps[6,i,t,5] <- 0
    ps[6,i,t,6] <- 1
    #Observation probabilities
    po[1,i,t,1] <- p[i,t]
    po[1,i,t,2] <- 0
    po[1,i,t,3] <- 0
    po[1,i,t,4] <- 0
    po[1,i,t,5] <- 0
    po[1,i,t,6] <- 1-p[i,t]
    po[2,i,t,1] <- 0
    po[2,i,t,2] <- p[i,t]
    po[2,i,t,3] <- 0
    po[2,i,t,4] <- 0
    po[2,i,t,5] <- 0
    po[2,i,t,6] <- 1-p[i,t]
    po[3,i,t,1] <- 0
    po[3,i,t,2] <- 0
    po[3,i,t,3] <- p[i,t]
    po[3,i,t,4] <- 0
    po[3,i,t,5] <- 0
    po[3,i,t,6] <- 1-p[i,t]
    po[4,i,t,1] <- 0
    po[4,i,t,2] <- 0
    po[4,i,t,3] <- 0
    po[4,i,t,4] <- 1
    po[4,i,t,5] <- 0
    po[4,i,t,6] <- 0
    po[5,i,t,1] <- 0
    po[5,i,t,2] <- 0
    po[5,i,t,3] <- 0
    po[5,i,t,4] <- 0
    po[5,i,t,5] <- 1
    po[5,i,t,6] <- 0
    po[6,i,t,1] <- 0
    po[6,i,t,2] <- 0
    po[6,i,t,3] <- 0
    po[6,i,t,4] <- 0
    po[6,i,t,5] <- 0
    po[6,i,t,6] <- 1
      }#t
    }#i
    # Likelihood
    for (i in 1:nind){
    # Define latent state at first capture
    z[i,f[i]] <- y[i,f[i]]
    for (t in (f[i]+1):n.occasions){
    # State process: draw S(t) given S(t-1)
    z[i,t] ~ dcat(ps[z[i,t-1], i, t-1,])
    # Observation process: draw O(t) given S(t)
    y[i,t] ~ dcat(po[z[i,t], i, t-1,])
} #t
} #i
}
    ",fill=TRUE)

