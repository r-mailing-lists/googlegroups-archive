     1,
     "\r\n\r\n\r\n\r\n\r\n<div dir=\"ltr\">\r\n<div></div>\r\n<hr style=\"display:inline-block;width:98%\">\r\n<div dir=\"ltr\"><font style=\"font-size:11pt\" face=\"Calibri, sans-serif\" color=\"#000000\"><b>From:</b> <a href data-email-masked rel=\"nofollow\">unma...@googlegroups.com</a> &lt;<a href data-email-masked rel=\"nofollow\">unma...@googlegroups.com</a>&gt; on behalf of Chris Sutherland &lt;<a href data-email-masked rel=\"nofollow\">chris...@gmail.com</a>&gt;<br>\r\n<b>Sent:</b> Thursday, February 17, 2022 11:27<br>\r\n<b>Subject:</b> [unmarked] MSc in Statistical Ecology at University of St Andrews, UK</font>\r\n<div> </div>\r\n</div>\r\n<div></div></div>"
