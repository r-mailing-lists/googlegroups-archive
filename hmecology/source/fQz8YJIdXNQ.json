     "<div class=\"gmail_extra\"><div class=\"gmail_quote\"><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><div dir=\"ltr\">Sorry, this is actually pretty straightforward with the <span style=\"font-family:courier new,monospace\">modavgPred</span> function:<br><br><span style=\"font-family:courier new,monospace\">newdata &lt;- data.frame(Biomasa = seq(-2,2,0.1),Rios=0,Cabmun=0,Elevacion=0,<br>                      Carreteras = 0, Habitat = factor(&quot;VA&quot;,levels=c(&quot;VA&quot;,&quot;VC&quot;)))<br>pred &lt;- modavgPred(Cand.models,as.character(1:7),newdata)<br>pred$high &lt;- pred$mod.avg.pred + 1.96*pred$<a href=\"http://uncond.se\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://uncond.se&amp;source=gmail&amp;ust=1792494860923000&amp;usg=AOvVaw2NkkOxtMLGf62GrgeJbtrY\">uncond.se</a><br>pred$low &lt;- pred$mod.avg.pred - 1.96*pred$<a href=\"http://uncond.se\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://uncond.se&amp;source=gmail&amp;ust=1792494860923000&amp;usg=AOvVaw2NkkOxtMLGf62GrgeJbtrY\">uncond.se</a><br><br>plot(newdata$Biomasa,pred$mod.avg.pred,type=&quot;l&quot;,<br>     ylim=c(0,1),ylab=&quot;Probability&quot;,xlab=&quot;Biomasa&quot;)<br>lines(newdata$Biomasa,pred$high,lty=2)<br>lines(newdata$Biomasa,pred$low,lty=2)<br>points(data$Biomasa,data$Estado,pch=16)<br><br></span><p style=\"text-align:center;clear:both\"><a href=\"https://lh3.googleusercontent.com/-6_ytCK--Q-4/WNperE3u4YI/AAAAAAAAAfQ/j4GhG0LujSsXH4xxgyFyAqXtYQo2_TDtgCLcB/s1600/biomasa_pumas.png\" style=\"clear:left;margin-bottom:1em;float:left;margin-right:1em\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://lh3.googleusercontent.com/-6_ytCK--Q-4/WNperE3u4YI/AAAAAAAAAfQ/j4GhG0LujSsXH4xxgyFyAqXtYQo2_TDtgCLcB/s1600/biomasa_pumas.png&amp;source=gmail&amp;u