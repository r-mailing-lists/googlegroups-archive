     1,
     "\r\n\r\n\r\n\r\n\r\n\r\n<div lang=\"DE-CH\" link=\"#0563C1\" vlink=\"#954F72\" style=\"word-wrap:break-word\">\r\n<div>\r\n<p class=\"MsoNormal\">Dear all,<u></u><u></u></p>\r\n<p class=\"MsoNormal\"><u></u> <u></u></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">we plan to teach a workshop on integrated population models (IPMs) just before the International Statistical Ecology Conference (ISEC) in Capetown, South Africa, this summer, see here:\r\n<a href=\"http://www.phidot.org/forum/viewtopic.php?f=8&amp;t=4279&amp;sid=699ff7770126995efa14a635e8428000\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=http://www.phidot.org/forum/viewtopic.php?f%3D8%26t%3D4279%26sid%3D699ff7770126995efa14a635e8428000&amp;source=gmail&amp;ust=1792493677981000&amp;usg=AOvVaw38sQ2QJQNsK_ObiYKJsAbb\">\r\nhttp://www.phidot.org/forum/viewtopic.php?f=8&amp;t=4279&amp;sid=699ff7770126995efa14a635e8428000</a><u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">We’re brutally short in sign-ups so far </span>\r\n<span lang=\"EN-US\" style=\"font-family:&quot;Segoe UI Emoji&quot;,sans-serif\">☹</span><span lang=\"EN-US\"> This is a unique chance for you to kick-start your fitting of IPMs and it would be great if you could attend.<u></u><u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\"><u></u> <u></u></span></p>\r\n<p class=\"MsoNormal\"><span lang=\"EN-US\">Thanks and best regards  --- Marc<u></u><u></u></span></p>\r\n</div>\r\n</div>\r\n\r\n"
    ]
   ]
