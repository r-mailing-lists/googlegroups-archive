GUESS <- lapply(turtle.trj, function(b) ctmm.guess(b, CTMM = ctmm(error = 10),  interactive=FALSE))
FITS <- lapply(1:length(turtle.trj), function(i) ctmm.select(turtle.trj[[i]],GUESS[[i]], verbose=T,  trace = TRUE, cores = 2))

