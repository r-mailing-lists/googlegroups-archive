>
> #Fit models for both seasonal periods simultaneously
> GUESS <- lapply(CLEFT[1:2], function(b) ctmm.guess(b,interactive=FALSE) )
> FITS <- lapply(1:2, function(i) ctmm.fit(tortoises[[i]],GUESS[[i]]) )
> names(FITS) <- names(CLEFT[1:2])
>
> #Gaussian overlap between both seasonal periods
> overlap(FITS)
>
> #AKDE overlap between both seasonal periods create aligned UDs
> UDS <- akde(CLEFT[1:2],FITS, weights=TRUE)
> plot(UDS)
>
> #Evaluate overlap
> overlap(UDS)
>
> #Average home ranges
> x <- mean(UDS, weights=TRUE)
>
> #Plot and summary statistics
> plot(tortoise173.16, UD=x)
>
> summary(x)
