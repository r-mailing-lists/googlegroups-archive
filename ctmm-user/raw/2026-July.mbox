> >
> >                                  format="%d-%m-%Y %H:%M",
> >
> >                                  tz="Asia/Kolkata")  # adjust timezone if needed
> >
> > #Rename the columns to Match ctmm
> >
> > colnames(mat_csv) <- c("individual.local.identifier",
> >
> >                        "timestamp",
> >
> >                        "location.lat",
