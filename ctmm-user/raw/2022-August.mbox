L58_akde<-akde(L58, L58_fit, SP=SP1_spdf, SP.in=T,weights=T, grid=2,debias = T, smooth=T)
writeShapefile(L58_akde, ".",level.UD=0.95, level=0.95, "L58", overwrite=T)

