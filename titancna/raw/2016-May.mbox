Note that the workaround is buggy as well, since the original column is returned instead of x <- suppressWarnings(mapSeqlevels(as.character(x), genomeStyle, drop = FALSE)[1,]). Here is a fixed version (removed the parameter x of setGenomeStyle2):

setGenomeStyle2 <- function(data, genomeStyle = "NCBI", species = "Homo_sapiens") {
  if (!genomeStyle %in% seqlevelsStyle(as.character(data[, 1]))) {
    data[, 1] <- suppressWarnings(mapSeqlevels(as.character(data[, 1]), genomeStyle, drop = FALSE)[1,])

  }
  autoSexMChr <- extractSeqlevelsByGroup(species = species, style = genomeStyle, group = "all")

  data <- data[data[, 1] %in% autoSexMChr, ]
  return(data)
}

