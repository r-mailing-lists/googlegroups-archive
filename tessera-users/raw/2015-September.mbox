pf1.byMissionVar = function(x) {
    mission = getSplitVars(x)$Mission
    var = getSplitVars(x)$variable
    ggplot(data = melt(x, id.vars = c("Year", "Month", "dt")),
            aes(x = dt, y = value)) +
        geom_line() +
        geom_smooth(method = "loess") +
        theme_bw() +
        labs(x = "", y = var, title = mission) +
