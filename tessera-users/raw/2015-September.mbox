cf1.byMissionVar = function(x) {
    x = x[order(x$Year, x$Month),]
    x$index = 1:nrow(x)
    if(any(x$Year > 2012)) {
        slopeAll = coef(lm(value ~ index, x))[2]
        slope2013 = coef(lm(value ~ index, x[x$Year > 2012,]))[2]
    } else {
        slopeAll = NA
        slope2013 = NA
    }
    list(
