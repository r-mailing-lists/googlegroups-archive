   "parts": [
    [
     1,
     "<div dir=\"ltr\">If you want to use the GET function from the httr package, then you can refer to it as httr::GET(...).<div>And of course you need to put httr in Imports in the DESCRIPTION file.</div><div><br></div><div>Gabor</div></div><div class=\"gmail_extra\"><br><div class=\"gmail_quote\"></div></div>"
    ],
    [
     3,
     "<div class=\"gmail_extra\"><div class=\"gmail_quote\">On Sun, Jul 5, 2015 at 2:33 PM, Ayala Allon <span dir=\"ltr\">&lt;<a href data-email-masked rel=\"nofollow\">ayala...@gmail.com</a>&gt;</span> wrote:<br></div></div>"
    ],
    [
     3,
