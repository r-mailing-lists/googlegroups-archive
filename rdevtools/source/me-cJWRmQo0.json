     "<div dir=\"ltr\"><div><blockquote class=\"gmail_quote\" style=\"margin:0;margin-left:0.8ex;border-left:1px #ccc solid;padding-left:1ex\"><div><blockquote class=\"gmail_quote\" style=\"margin:0 0 0 .8ex;border-left:1px #ccc solid;padding-left:1ex\"><br>\r\n\r\nFor more options, visit <a href=\"https://groups.google.com/groups/opt_out\" target=\"_blank\" rel=\"nofollow\" data-saferedirecturl=\"https://www.google.com/url?hl=en-US&amp;q=https://groups.google.com/groups/opt_out&amp;source=gmail&amp;ust=1792490087285000&amp;usg=AOvVaw3JwMzCfGrr-1khX_8pe_Y9\">https://groups.google.com/groups/opt_out</a>.<br>\r\n</blockquote></div></blockquote></div></div>"
    ],
    [
