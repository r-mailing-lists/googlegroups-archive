e=\"color:#000\">library</span><span style=\"color:#660\">/</span><span style=\"color:#000\">xgboost</span><span style=\"color:#660\">/</span><span style=\"color:#000\">libs</span><span style=\"color:#660\">/</span><span style=\"color:#000\">xgboost</span><span style=\"color:#660\">.</span><span style=\"color:#000\">so</span><span style=\"color:#660\">,</span><span style=\"color:#000\"> </span><span style=\"color:#066\">6</span><span style=\"color:#660\">):</span><span style=\"color:#000\"> </span><span style=\"color:#606\">Symbol</span><span style=\"color:#000\"> </span><span style=\"color:#008\">not</span><span style=\"color:#000\"> found</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> _GOMP_atomic_end<br>  </span><span style=\"color:#606\">Referenced</span><span style=\"color:#000\"> </span><span style=\"color:#008\">from</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> </span><span style=\"color:#080\">/Library/</span><span style=\"color:#606\">Frameworks</span><span style=\"color:#660\">/</span><span style=\"color:#000\">R</span><span style=\"color:#660\">.</span><span style=\"color:#000\">framework</span><span style=\"color:#660\">/</span><span style=\"color:#606\">Versions</span><span style=\"color:#660\">/</span><span style=\"color:#066\">3.1</span><span style=\"color:#660\">/</span><span style=\"color:#606\">Resources</span><span style=\"color:#660\">/</span><span style=\"color:#000\">library</span><span style=\"color:#660\">/</span><span style=\"color:#000\">xgboost</span><span style=\"color:#660\">/</span><span style=\"color:#000\">libs</span><span style=\"color:#660\">/</span><span style=\"color:#000\">xgboost</span><span style=\"color:#660\">.</span><span style=\"color:#000\">so<br>  </span><span style=\"color:#606\">Expected</span><span style=\"color:#000\"> </span><span style=\"color:#008\">in</span><span style=\"color:#660\">:</span><span style=\"color:#000\"> flat </span><span style=\"color:#008\">namespace</